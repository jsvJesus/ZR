class DCURSOR_LIMITS:
    global_max_pitch = 85.0
    global_min_pitch = -65.0
    node_max_pitch = 75.0
    node_min_pitch = -60.0
    max_yaw = 85.0

    @classmethod
    def get_max_yaw(cls):
        return math.radians(cls.max_yaw)

    @classmethod
    def get_min_yaw(cls):
        min_yaw = getattr(cls, 'min_yaw', -cls.max_yaw)
        return math.radians(min_yaw)


class DCURSOR_FPS_LIMITS(DCURSOR_LIMITS):
    global_max_pitch = 88.0
    max_yaw = 85.0
    node_max_pitch = 75.0
    node_min_pitch = -60.0


