# Embedded file name: ./client/rainSystem.py
import rainConstant
import BigWorld
import fader_object
import utils_bw

class RainSystem(object):
    """docstring for RainSystem"""
    outside_shell = -1
    _sound_volume = 1.0

    def __init__(self, sound_callback = None):
        self.sound_callback = sound_callback
        self.thunder_params = {}

    def attachToRain(self):
        BigWorld.getRain().pDebugPython = self.onRainRender

    def sound_volume(self, val, fade = True):
        if self._sound_volume != val:
            self._sound_volume = val
            if self.sound_callback:
                self.sound_callback(self._sound_volume, fade)

    def onRainRender(self, ammount, outside_shell):
        if self.outside_shell != outside_shell:
            self.outside_shell = outside_shell
        if not outside_shell:
            self.sound_volume(1.0)
            return rainConstant.alpha_rain_shell
        p = BigWorld.player()
        if not p:
            return 0
        if p.is_camera_in_water():
            self.sound_volume(rainConstant.rain_volume_under_water, fade=False)
            p.set_in_rain(False)
            return rainConstant.alpha_under_water
        cam = BigWorld.camera()
        p_col = utils_bw.collideIgnoreNoVisible(p.spaceID, p.position + (0, 100, 0), p.position + (0, 1, 0))[0]
        cam_col = utils_bw.collideIgnoreNoVisible(p.spaceID, cam.position + (0, 100, 0), cam.position + (0, 0.01, 0))[0]
        if p_col:
            p.set_in_rain(False)
        else:
            p.set_in_rain(True)
        if p_col and cam_col:
            self.sound_volume(rainConstant.rain_volume_camera_and_palyer_roof)
            return rainConstant.alpha_rain_camera_and_palyer_roof
        if p_col or cam_col:
            self.sound_volume(rainConstant.rain_volume_player_roof)
            return rainConstant.alpha_rain_player_roof
        self.sound_volume(1.0)
        return rainConstant.alpha_rain_default

    def destroy(self):
        self.sound_callback = None
        rain = BigWorld.getRain()
        if rain and rain.pDebugPython == self.onRainRender:
            rain.pDebugPython = None
        return