# Embedded file name: ./client/csBombZone.py
import BigWorld
import Math
import Pixie
import random
import ItemsUtils
import time
import GUI

class csBombZone(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)

    def onEnterWorld(self, prereqs):
        self.model = BigWorld.Model('')
        self.testModel = BigWorld.Model('models/Test/cylinder_1m.model')
        self.addModel(self.testModel)
        text = GUI.Text(self.ZoneName)
        text.explicitSize = True
        text.size = (0, 0.4)
        text.colour = (255, 205, 149, 245)
        text.filterType = 'LINEAR'
        text.verticalAnchor = 'BOTTOM'
        text.position = (0, 1, 0)
        atch = GUI.Attachment()
        atch.component = text
        atch.faceCamera = True
        self.text_atch = atch
        self.textGui = text
        self.testModel.root.attach(atch)
        self.moveRadiusTestModel()

    def moveRadiusTestModel(self):
        self.testModel.position = self.position
        self.testModel.scale = (self.radius, 1.0, self.radius)

    def set_radius(self, old):
        self.moveRadiusTestModel()