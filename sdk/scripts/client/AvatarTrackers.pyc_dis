def ignoreError(foo):

    def bar(*w, **kw):
        try:
            return foo(*w, **kw)
        except:
            print '\n\n' + '----------'
            print 'foo:', foo
            print 'arg:', (w, kw)
            traceback.print_stack()
            print '-----'
            traceback.print_exc()
            print '----------\n\n'

    return bar


def isTackerInit(foo):

    @ignoreError
    def wraper(self, *w, **kw):
        if self.isDestroyed:
            return
        if not self._tracker_is_init:
            return
        return foo(self, *w, **kw)

    return wraper


