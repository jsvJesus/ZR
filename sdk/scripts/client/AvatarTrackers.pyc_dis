                self.test_nodeInfo_gunrw = None
                self.torso_nodeinfo = None
                self.head_nodeInfo = None
                self.gunnodeInfo = None
                self._leftFreeHandProvider = None
                self._rightFreeHandProvider = None
                self.tracker_torso = None
                self.torsoProvider_entity = None
                self.weaponProvider_entity = None
                self.headProvider_entity = None
                self.headProvider_cam_dcursor = None
                self.headProvider_cam_self = None
                self.headProvider_serverLook = None
                self.headProvider_to_target = None
                if self.model:
                    self.model.GUNR = None
                    self.model.weaponback = None
                    self.model.weaponback2 = None
                    self.model.Pistol = None
                    self.model.belly = None
                    self.model.Lhand = None
                    self.model.Rhand = None
                    self.model.backpack = None
                    if hasattr(self.model, 'torso'):
                        self.model.torso = None
                    if hasattr(self.model, 'tracker_arm_left'):
                        self.model.tracker_arm_left = None
                    if hasattr(self.model, 'tracker_arm_right'):
                        self.model.tracker_arm_right = None
                    if hasattr(self.model, 'tracker_gun_mover'):
                        self.model.tracker_gun_mover = None
                    if hasattr(self.model, 'tracker_gun'):
                        self.model.tracker_gun = None
                    if hasattr(self.model, 'tracker_head'):
                        self.model.tracker_head = None
                weapon_slots = getattr(self, 'weapon_slots', {})
