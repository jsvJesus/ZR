    def foundActionType(self, action_name):
        if not action_name:
            return ''
        action_name = action_name.lower()
        if 'stop' in action_name:
            return ''
        if 'slope' in action_name:
            return ''
        action_keys = action_name.split('_')
        if len(action_keys) != 4:
            return ''
        act, info, pose, state = action_keys
        tranf_stay_act = {'idle': 'idle',
         'walk': 'walk',
         'run': 'run',
         'sprint': 'sprint',
         'turn': 'idle',
         'slope': 'run'}
        if act not in tranf_stay_act:
            return ''
        if pose == 'crouch':
            if act == 'idle':
                return 'crouch_idle'
            if act == 'run':
                return 'crouch_run'
            return 'crouch_walk'
        if pose == 'crawl':
            if act == 'idle':
                return 'crawl_idle'
            return 'crawl_walk'
        if pose == 'stay':
            return tranf_stay_act[act]
        print 'foundActionType:: error for', repr(action_name)
        return ''

    def modelMatchNotifier(self, action_name):
        prev_fix_action_sprint = self._is_fix_action_sprint
        self._is_fix_action_sprint = action_name == 'run_meleeFixSprint_stay_unarmed'
        new_type = self.foundActionType(action_name)
        fix_change = prev_fix_action_sprint != self._is_fix_action_sprint
        if new_type and (new_type != self._last_action_type or fix_change):
            prev_type = self._last_action_type
            self._last_action_type = new_type
            self.setDirectionProviderParam()
            self._check_tired()
            self.onChangePrimaryAction(self._last_action_type)
            if self.active_transform:
                self.onChangePrimaryActionForTransf(prev_type, new_type)

    def onChangePrimaryAction(self, action_name):
        pass

    __start_sprint = 0
    __tired_end_timer_id = 0

    @ignoreError
    def _check_tired(self):
        SPRINT_TIME = 5.0
        TIRED_AFTER_SPRINT_TIME = 7.0
        t = time.time()

        def _endtired():
            if self.isDestroyed:
                return
            self.__tired_end_timer_id = 0
            self.setTiredCapsAfterSprint(False)

        if self._last_action_type == 'sprint':
            self.__start_sprint = t
        elif self.__start_sprint:
            if t - self.__start_sprint > SPRINT_TIME:
                if self.__tired_end_timer_id:
                    BigWorld.cancelCallback(self.__tired_end_timer_id)
                self.__tired_end_timer_id = BigWorld.callback(TIRED_AFTER_SPRINT_TIME, _endtired)
                self.setTiredCapsAfterSprint(True)
            self.__start_sprint = 0

    def getLastActionType(self):
        return self._last_action_type

    def isSprintPlayed(self):
        return self._is_fix_action_sprint or self._last_action_type == 'sprint'

    def getTrackerKey(self):
        return self._getTrackerKey()

    def getGlobalTrackerKey(self):
        key = self._getTrackerKey()
        return ('tracker_global', key[1], key[2])

    def _getTrackerKey(self):
        status_names = {Constants.WEAPON_BORED: 'bored',
         Constants.WEAPON_INCOMABAT: 'incombat',
         Constants.WEAPON_SNIPING: 'aim'}
        weaponStatus = self.weaponStatus
        action_type = self._last_action_type
        if self.weaponStatus != Constants.WEAPON_BORED:
            if self._last_action_type == 'sprint':
                action_type = 'run'
        status_name = status_names[weaponStatus]
        return ('tracker', status_name, action_type)

