    def prerequisites(self):
        compose_data = StalkerModel.compose_player_model_list(self)
        self._prereqs_model_key = compose_data['models']
        models_list = [self._prereqs_model_key]
        for slot_name in self.ActiveWeaponSet2.keys():
            models_list.extend(ClWeapon.get_all_models_path(self, slot_name))

        for hair_slot in EST.get_face_slots():
            if hair_slot in compose_data['hidden_slots']:
                continue
            item_type = EST.get_slot_data(self, hair_slot)['itemType']
            if item_type:
                hair_texture = ItemsCatalog.GetItemParam(item_type).get('Substrate')
                models_list.append(hair_texture)

        return models_list

    def get_base_model_from_prereqs(self):
        if not self.prereqs:
            return
        elif self._prereqs_model_key in self.prereqs.failedIDs:
            print '---------------'
            print 'ERROR LOAD MODEL', self._prereqs_model_key
            print self, self.id, self.position
            traceback.print_stack()
            return
        else:
            try:
                result = self.prereqs[self._prereqs_model_key]
                self.prereqs = None
                return result
            except:
                print '---------------'
                print self, self.id, self.position
                print 'key:', repr(self._prereqs_model_key)
                print 'failedIDs:', self.prereqs.failedIDs
                print 'keys:', self.prereqs.keys()
                traceback.print_stack()

            return

