    def torsoRecoil(self, launcher = None):
        if not self.torso_nodeinfo:
            return
        param, item_override_param = self.getRecoilAndSpreadParam()
        if launcher and item_override_param:
            param = item_override_param
        recoil_mul, recoil_speed_mul = recoil_and_spread_table.getRecoilTorsoCoef(self)
        step_yaw0, step_yaw1, min_yaw, max_yaw = param.get('torso_recoil_addYaw_LIM', (0, 0, 0, 0))
        step_pitch0, step_pitch1, min_pitch, max_pitch = param.get('torso_recoil_addPitch_LIM', (0, 0, 0, 0))
        add_yaw = recoil_mul * random.uniform(step_yaw0, step_yaw1)
        add_pitch = recoil_mul * random.uniform(step_pitch0, step_pitch1)
        add_yaw = self.torso_nodeinfo.recoilYaw + math.radians(add_yaw)
        add_pitch = self.torso_nodeinfo.recoilPitch + math.radians(add_pitch)
        self.torso_nodeinfo.recoilYaw = clamp(add_yaw, math.radians(min_yaw) * recoil_mul, math.radians(max_yaw) * recoil_mul)
        self.torso_nodeinfo.recoilPitch = clamp(add_pitch, math.radians(min_pitch) * recoil_mul, math.radians(max_pitch) * recoil_mul)
        self.torso_nodeinfo.recoilYawSpeed = param['torso_recoil_addYawSpeed'] * 0.01 * recoil_speed_mul
        self.torso_nodeinfo.recoilPitchSpeed = param['torso_recoil_addPitchSpeed'] * 0.01 * recoil_speed_mul

    def AM_errorStringNotifier(self, string):
        msg = unicode(string)
        caps = '    caps:\n'
        for cap_id in self.model.motors[0].matchCaps:
            caps += '%s: %s\n' % (cap_id, AnimationCaps.getCapNameById(cap_id))

        msg += '     ' + caps
        print '-----'
        print msg.encode('utf-8')
        if BigWorld.isConsumer() and getattr(BigWorld.player(), 'clientAccessLevel', 0) < 3:
            return
        if self == BigWorld.player():
            self.putMessage(CHANNEL_CONSTS.NEWS, msg)
        else:
            name = self.name
            self.putMessage(CHANNEL_CONSTS.NEWS, u'%s:  %s' % (name, msg))

