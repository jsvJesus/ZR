    @isTackerInit
    def createDiffDirProviders(self):
        self.torsoProvider_entity = BigWorld.EntityDirProvider(self, 1, 0)
        self.weaponProvider_entity = self.torsoProvider_entity
        self.headProvider_entity = self.torsoProvider_entity
        self.headProvider_cam_dcursor = self.torsoProvider_entity
        self.headProvider_cam_self = self.torsoProvider_entity
        self.headProvider_serverLook = Math.Matrix()
        self.headProvider_to_target = None
        if BigWorld.player() == self:
            self.torsoProvider_entity.playerAvatarMode = 1
            self.torsoProvider_entity.playerAvatarModeSwitchSpeed = 0.1
            self.headProvider_cam_self = BigWorld.DiffDirProvider(self.model.node('Head'), self.AvatarCam.invViewMatrix)
            self.headProvider_cam_dcursor = BigWorld.dcursor().matrixYawFree
            self.headProvider_special = BigWorld.DiffDirProvider(self.model.node('Head'), self.model.node('Spine3'))
            if not self._headLArovider:
                self._headLArovider = tmp_head_la_provider.HeadLArovider(self)
            self._headLArovider.attach(self.headProvider_special)
            self._headLArovider.reset()
            BWPersonality.GUICore.targettingGUI.update()
        self.nodeInfoL.pProviderElbowTargert = self.model.node('HP_GUNR_LIMIT')
        self.nodeInfoR.pProviderElbowTargert = self.model.node('HP_GUNR_LIMIT')
        if self.test_nodeInfo_gunrw:
            self.test_nodeInfo_gunrw.vecAddPosGun = (0, 0, 0)
            self.test_nodeInfo_gunrw.weponRoll = 0
        if self.active_weapon_model:
            self.active_weapon_model.node('HP_barrel').disableDrawInReflection = True
            self.active_weapon_model.node('HP_AIMSYS').disableDrawInReflection = True
            self.gunnodeInfo.barrelProvider = self.active_weapon_model.node('HP_barrel')
            self.gunnodeInfo.sysProvider = self.active_weapon_model.node('HP_AIMSYS')
            if not hasattr(self.active_weapon_model, 'test_tracker_gunrw'):
                self._createTestTrackerGUN()
            elif not self.test_tracker_gunrw or not self.test_nodeInfo_gunrw or self.test_tracker_gunrw != self.active_weapon_model.test_tracker_gunrw or self.test_nodeInfo_gunrw != self.active_weapon_model.test_tracker_gunrw.nodeInfo:
                tnode = self.active_weapon_model.test_tracker_gunrw.nodeInfo
                if tnode and tnode.__class__.__name__ != 'BaseNodeInfo':
                    self.test_tracker_gunrw = self.active_weapon_model.test_tracker_gunrw
                    self.test_nodeInfo_gunrw = self.test_tracker_gunrw.nodeInfo
                else:
                    self._createTestTrackerGUN()
        if not self.active_weapon_model:
            self.GUNMover_nodeInfo.GunNode = None
            self.test_nodeInfo_gunrw = None
            self.test_tracker_gunrw = None
        self.updateModelRotateMod()
        if BigWorld.player() == self:
            self.model.motors[0].rotateFootByCollideSlide = False
        return

    def updateModelRotateMod(self):
        if not self.model:
            return
        body_twist = player_speed_settings.MODEL_SMOOTH.STAY_BODY_TWIST
        body_twist_lim_speed = player_speed_settings.MODEL_SMOOTH.STAY_BODY_TWIST_LIM_SPEED
        body_twist_lim_value = player_speed_settings.MODEL_SMOOTH.STAY_BODY_TWIST_LIM_VALUE
        foot_twist = player_speed_settings.MODEL_SMOOTH.STAY_FOOT_TWIST
        foot_twist_lim_speed = player_speed_settings.MODEL_SMOOTH.STAY_FOOT_TWIST_LIM_SPEED
        foot_twist_lim_value = player_speed_settings.MODEL_SMOOTH.STAY_FOOT_TWIST_LIM_VALUE
        rememberlastFootTwist = player_speed_settings.MODEL_SMOOTH.STAY_REMEMBER_LAST_FOOT_TWIST
        if self.IsAvatarCrawling():
            body_twist = player_speed_settings.MODEL_SMOOTH.CRAWL_BODY_TWIST
            body_twist_lim_speed = player_speed_settings.MODEL_SMOOTH.CRAWL_BODY_TWIST_LIM_SPEED
            body_twist_lim_value = player_speed_settings.MODEL_SMOOTH.CRAWL_BODY_TWIST_LIM_VALUE
            foot_twist = player_speed_settings.MODEL_SMOOTH.CRAWL_FOOT_TWIST
            foot_twist_lim_speed = player_speed_settings.MODEL_SMOOTH.CRAWL_FOOT_TWIST_LIM_SPEED
            foot_twist_lim_value = player_speed_settings.MODEL_SMOOTH.CRAWL_FOOT_TWIST_LIM_VALUE
            rememberlastFootTwist = player_speed_settings.MODEL_SMOOTH.CRAWL_REMEMBER_LAST_FOOT_TWIST
        if self.active_transform:
            body_twist = self.active_transform.getparam('body_twist') or body_twist
        amatcher = self.model.motors[0]
        amatcher.bodyTwistSpeed = body_twist
        amatcher.bodyTwistrLlenMin = body_twist_lim_speed[0]
        amatcher.bodyTwistrLlenMax = body_twist_lim_speed[1]
        amatcher.bodyTwistrLlenMinVal = body_twist_lim_value[0]
        amatcher.bodyTwistrLlenMaxVal = body_twist_lim_value[1]
        amatcher.footTwistSpeed = foot_twist
        amatcher.footTwistrLlenMin = foot_twist_lim_speed[0]
        amatcher.footTwistrLlenMax = foot_twist_lim_speed[1]
        amatcher.footTwistrLlenMinVal = foot_twist_lim_value[0]
        amatcher.footTwistrLlenMaxVal = foot_twist_lim_value[1]
        self.rememberlastFootTwist(rememberlastFootTwist)

    @isTackerInit
    def updateCrawlMode(self, old = None):
        if self.IsAvatarCrawling() or self.dead:
            self.xTorso.resetHipsDir()
            self.ENABLE_MovingActionMather = False
        else:
            self.ENABLE_MovingActionMather = self.USE_MovingActionMather
        self.xTorso.setCrawlMode(self.crouching_or_crawling, self.dead)
        self.torso_nodeinfo.setCrawlMode(self.crouching_or_crawling, self.dead)

    def getTrackerParam(self):
        return self._get_tracker_param()

    def hasCapWeaponRightHand(self):
        if self.weaponStatus != Constants.WEAPON_BORED:
            return False
        if not self.active_weapon:
            return False
        item_param, item_override_param = self.active_weapon.getParamsAndOverrideParamsWeapon()
        to_attach_weapon = item_param['tracker']['bored']['sprint'].get('to_attach_weapon')
        return to_attach_weapon == 'Right'

    def _get_tracker_param(self):
        """\xd0\x98\xd0\xb7\xd0\xb2\xd0\xbb\xd0\xb5\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba \xd1\x82\xd1\x80\xd0\xb5\xd0\xba\xd0\xb5\xd1\x80\xd0\xb0 \xd0\xbf\xd0\xbe \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd1\x83
        \xd0\xb2\xd0\xbe\xd0\xb7\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb5\xd0\xb3\xd0\xbe \xd1\x81\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe\xd1\x8f\xd0\xbd\xd0\xb8\xd1\x8f, \xd0\xb4\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3 \xd0\xbe\xd1\x82 \xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0\xd1\x82\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0
        """
        if self.transform_weapon and self.transform_weapon.trackerOverrideItemType:
            item_param = ItemsCatalog.GetItemParam(self.transform_weapon.trackerOverrideItemType)
            item_override_param = None
        elif self.active_weapon and not self.active_melee:
            item_param, item_override_param = self.active_weapon.getParamsAndOverrideParamsWeapon()
        else:
            item_param = ItemsCatalog.GetUnarmedParam()
            item_override_param = None
        tracker_key = self._getTrackerKey()
        for key in tracker_key:
            item_param = item_param[key]

        if item_override_param:
            for key in tracker_key:
                item_override_param = item_override_param[key]

        return (item_param, item_override_param or item_param)

    def getRecoilAndSpreadMult(self):
        tracker_key = self._getTrackerKey()
        return recoil_and_spread_table.REC_SPR_MULT_BY_STATE[tracker_key]

    def getRecoilAndSpreadParam(self):
        if self.active_weapon:
            item_param, item_override_param = self.active_weapon.getParamsAndOverrideParamsWeapon()
        else:
            item_param = ItemsCatalog.GetUnarmedParam()
            item_override_param = item_param
        return (item_param['recoil_and_spread'], item_override_param['recoil_and_spread'])

    def _get_global_tracker_param(self):
        """\xd0\x98\xd0\xb7\xd0\xb2\xd0\xbb\xd0\xb5\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb3\xd0\xbb\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba \xd1\x82\xd1\x80\xd0\xb5\xd0\xba\xd0\xb5\xd1\x80\xd0\xb0 \xd0\xbf\xd0\xbe \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd1\x83"""
        item_param = ItemsCatalog.tracker_global_data
        tracker_key = self.getGlobalTrackerKey()
        for key in tracker_key:
            try:
                item_param = item_param[key]
            except:
                print self, 'tracker_key:', tracker_key, 'key:', key
                raise

        return item_param

    def getActiveWeaponParam(self):
        return self.__get_param_weapon()

    def __get_param_weapon(self):
        complexItemType = self.getActiveWeaponItemType()
        if complexItemType:
            param = ItemsCatalog.GetItemParam(complexItemType)
        else:
            param = ItemsCatalog.GetUnarmedParam()
        return param

    def canAttachWeaponBelly(self):
        if self.belly_weapon:
            return False
        param = self.__get_param_weapon()
        if param and param['GunType'] in [0, ItemsCatalog.PISTOL, ItemsCatalog.REVOLVER]:
            return False
        return True

    __hand_free_prov_active = False
    __hand_free_prov_complete = False
    __hand_free_anim_active = False
    __hand_free_anim_complete = True
    hand_to_bored_to_free_delay = 0.1
    hand_from_bored_to_anim_delay = 0.05

    def onCahngeTrakerKey(self, tracker_key, weapon_type):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x80\xd1\x83\xd0\xba [\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f<->\xd1\x80\xd1\x83\xd0\xba\xd0\xb8 \xd0\xba \xd0\xb7\xd0\xb5\xd0\xbc\xd0\xbb\xd0\xb5] \xd0\xbe\xd1\x82 \xd1\x81\xd0\xbe\xd1\x81\xd1\x82\xd1\x8f\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x82\xd1\x80\xd0\xb5\xd0\xba\xd0\xb5\xd1\x80\xd0\xb0"""
        self.updateModelRotateMod()
        HandControl.onChangeTrackerStatus(self)

    def updateHandToWeaponOffset(self, tr_param = None, tr_param_override = None):
        if not tr_param or not tr_param_override:
            tr_param, tr_param_override = self._get_tracker_param()
        if self.left_weapon_prov:
            self.left_weapon_prov.add_position = tuple(tr_param_override['hand_L_weapon_add_pos'])
            self.left_weapon_prov.add_rotation = tuple(tr_param_override['hand_L_weapon_add_rotate'])
        if self.right_weapon_prov:
            self.right_weapon_prov.add_position = tuple(tr_param['hand_R_weapon_add_pos'])
            self.right_weapon_prov.add_rotation = tuple(tr_param['hand_R_weapon_add_rotate'])

    def updateCameraPosition(self):
        pass

    def getCameraImpSettings(self):
        return None

    def _headHitLimitYawCallBack(self, side):
        return
        cling_by_turn = self.tracker_head.cling_by_turn
        if not self.lookingaround:
            self.tracker_head.cling_by_turn = 0
            return
        if not side and not cling_by_turn:
            return
        if side and cling_by_turn:
            return
        if not cling_by_turn and side:
            self.tracker_head.cling_by_turn = side
            return
        self.tracker_head.cling_by_turn = 0

    def updateSmoothEnable(self):
        if self != BigWorld.player():
            return
        smooth = self.lookingaround
        if self.lookingaround_smooth and not self.IsAvatarSniping():
            smooth = True
        if self.tracker_torso:
            self.tracker_torso.smooth_rotate = smooth
        if self.tracker_gun:
            self.tracker_gun.smooth_rotate = smooth
        if self.tracker_head:
            self.tracker_head.smooth_rotate = smooth

    def updateHeadAddYPR(self, tr_global_param = None):
        if not tr_global_param:
            tr_global_param = self._get_global_tracker_param()
        mod_add_ypr = 1.0
        if not self._tmp_look_to_cam_diasable:
            if self.lookingaround or self.head_look_cam or self.__head_from_server:
                mod_add_ypr = 0.0
        self.head_nodeInfo.addYaw = mod_add_ypr * tr_global_param['head_AddYaw']
        self.head_nodeInfo.addPitch = mod_add_ypr * tr_global_param['head_AddPitch']
        self.head_nodeInfo.addRoll = mod_add_ypr * tr_global_param['head_AddRoll']

    def updateTorsoHeadProvider(self):
        self.head_look_cam = False
        self._torso_disbale_by_lookaround = False
        if not self.tracker_torso:
            return
        if not self.tracker_head:
            return
        if self != BigWorld.player():
            self.tracker_torso.directionProvider = self.torsoProvider_entity
            if self.__head_from_server:
                self.tracker_head.directionProvider = self.headProvider_serverLook
                if self.heli_weapon:
                    self.tracker_torso.directionProvider = self.headProvider_serverLook
            elif self.headProvider_to_target:
                self.tracker_head.directionProvider = self.headProvider_to_target
            else:
                self.tracker_head.directionProvider = self.headProvider_entity
            return
        self.tracker_torso.dirToZeroOnLimit = False

        def set_head_dir_prov(prov):
            if self._tmp_look_to_cam_diasable:
                self.tracker_head.directionProvider = self.headProvider_entity
                return False
            self.tracker_head.directionProvider = prov
            return True

        if self.dead:
            self.tracker_torso.directionProvider = self.torsoProvider_entity
            set_head_dir_prov(self.headProvider_entity)
            self.updateHeadAddYPR()
            return
        tr_global_param = self._get_global_tracker_param()
        if self.lookingaround:
            self.tracker_torso.directionProvider = self.torsoProvider_entity
            if set_head_dir_prov(self.headProvider_special) and tr_global_param.get('head_blendFaktor', 0.0) > 0.1:
                self.head_look_cam = True
        elif self._inAir or self._after_jump_landing_state:
            self.tracker_torso.directionProvider = self.torsoProvider_entity
            set_head_dir_prov(self.headProvider_entity)
        elif self.active_weapon and self.weaponStatus == Constants.WEAPON_BORED:
            self.tracker_torso.directionProvider = self.torsoProvider_entity
            set_head_dir_prov(self.headProvider_cam_dcursor)
        else:
            self.tracker_torso.directionProvider = self.torsoProvider_entity
            set_head_dir_prov(self.headProvider_cam_dcursor)
        self.updateHeadAddYPR(tr_global_param)

    def changeFootsScaleFix(self, enable = False):
        if not getattr(self, 'fniLeft', None) or not getattr(self, 'fniRight', None):
            return
        else:
            matrixFixfoot = Matrix()
            matrixFixfoot.setScale(self.model.scale)
            self.fniLeft.fixScaleEnable = enable
            self.fniRight.fixScaleEnable = enable
            self.fniRight.fixScaleMatrix = matrixFixfoot
            self.fniLeft.fixScaleMatrix = matrixFixfoot
            self.foots[0].setFixScaleMatrix(matrixFixfoot if enable else None)
            self.foots[1].setFixScaleMatrix(matrixFixfoot if enable else None)
            return

    def updateTorsoFlags(self):
        tr_global_param = self._get_global_tracker_param()
        if not self.torso_nodeinfo:
            return
        self.torso_nodeinfo.modelRollMouseWeight = player_speed_settings.MODEl_ROLL.MOUSE_WEIGHT
        self.torso_nodeinfo.modelRollWASDWeight = player_speed_settings.MODEl_ROLL.WASD_WEIGHT
        self.torso_nodeinfo.modelRollMinSpeed = player_speed_settings.MODEl_ROLL.MIN_SPEED
        self.torso_nodeinfo.modelRollMaxSpeed = player_speed_settings.MODEl_ROLL.MAX_SPEED
        self.torso_nodeinfo.modelRollMaxAngle = player_speed_settings.MODEl_ROLL.MAX_ANGLE
        self.torso_nodeinfo.modelRollSmoothStep = player_speed_settings.MODEl_ROLL.SMOOTH_STEP
        self.torso_nodeinfo.modelRollSmoothPorog = player_speed_settings.MODEl_ROLL.SMOOTH_POROG
        self.torso_nodeinfo.modelRollSmoothStepBack = player_speed_settings.MODEl_ROLL.SMOOTH_STEP_BACK
        self.torso_nodeinfo.modelRollSmoothPorogBack = player_speed_settings.MODEl_ROLL.SMOOTH_POROG_BACK
        self.torso_nodeinfo.isFPSMode = self.isFPSmode()
        self.torso_nodeinfo.isEntityInAir = self._inAir
        self.torso_nodeinfo.isEntityIgnoreGravityAnimations = self._ignorGravityAnimation
        self.torso_nodeinfo.isEntityPhysicsIsJump = self.physicsIsJump()
        self.torso_nodeinfo.entityHipsOffsetByRotate = tr_global_param['hips_offset_by_rotate']
        self.torso_nodeinfo.entityLegRotateInside = tr_global_param['leg_rotate_inside']
        self.torso_nodeinfo.entityLegRotateOutside = tr_global_param['leg_rotate_outside']
        self.torso_nodeinfo.entityFootRotateLimit = tr_global_param['foot_rotate_limit']

    def updateGunProvider(self):
        if self.lookingaround:
            prov = self.weaponProvider_entity
        elif self.isFPSmode() and (self.IsAvatarSniping() or self.heli_weapon):
            self.torso_nodeinfo.addYawSecondary = 0.0
            prov = self.AvatarCam.invViewMatrix
        elif self.heli_weapon:
            prov = self.torsoProvider_entity
            if self is not BigWorld.player():
                prov = self.headProvider_serverLook
        else:
            prov = self.weaponProvider_entity
        self.tracker_gun.directionProvider = prov

    ENABLE_WEAPON_COLLIDE = True

    @isTackerInit
    def setDirectionProviderParam(self, old = None, force = False):
        try:
            if BWPersonality.GUICore.dbg_window and self == BigWorld.player():
                text = 'NONE'
                text = '/'.join(self._getTrackerKey()[1:])
                text = text + '  [%s]' % self.getActiveWeaponItemType()
                BWPersonality.GUICore.dbg_window.updateModeTracker(self, text)
        except:
            print 'AvatarTrackers -> caption BWPersonality.GUICore.dbg_window error [%r]' % text

        self.updateSmoothEnable()
        self.updateTorsoHeadProvider()
        self.updateGunProvider()
        tracker_key = self._getTrackerKey()
        complexItemType = self.getActiveWeaponItemType()
        if self.active_melee:
            complexItemType = 0
        if not force:
            if self.__last_complexItemType == complexItemType and self.__last_tracker_key == tracker_key:
                return
        self.onCahngeTrakerKey(tracker_key, complexItemType)
        self.sendWTonAvatarChangeWeaponStatus()
        self.__last_tracker_key = tracker_key
        self.__last_complexItemType = complexItemType
        param = self.__get_param_weapon()
        tr_param, tr_param_override = self._get_tracker_param()
        tr_global_param = self._get_global_tracker_param()
        if self == BigWorld.player():
            self.updateCameraPosition()
        self.update_turn_states()
        self.updateHandToWeaponOffset(tr_param, tr_param_override)
        self._leg_rotate_inside = tr_global_param['leg_rotate_inside']
        self._leg_rotate_outside = tr_global_param['leg_rotate_outside']
        self._foot_rotate_limit = tr_global_param['foot_rotate_limit']
        self._hips_offset_by_rotate = tr_global_param['hips_offset_by_rotate']
        self._update_weapon_limits(tr_param)
        self.nodeInfoL.angleRollMin = tr_param_override['hand_L_angleRoll'][0]
        self.nodeInfoL.angleRollMax = tr_param_override['hand_L_angleRoll'][1]
        self.nodeInfoL.angleRollStep = tr_param_override['hand_angleRollStep']
        self.nodeInfoL.angleRollPorog = tr_param_override['hand_angleRollPorog']
        self.nodeInfoR.angleRollMin = tr_param['hand_R_angleRoll'][0]
        self.nodeInfoR.angleRollMax = tr_param['hand_R_angleRoll'][1]
        self.nodeInfoR.angleRollStep = tr_param['hand_angleRollStep']
        self.nodeInfoR.angleRollPorog = tr_param['hand_angleRollPorog']
        self.gunnodeInfo.bulletSpreadGrad = param['gun_bulletSpreadGrad']
        self.gunnodeInfo.debugBlend2Step = param.get('speed_gun_limits', 5.9)
        self.tracker_gun.rotateInWS = self.weaponStatus != Constants.WEAPON_BORED
        self.tracker_gun.accelerationStep = 0.22046
        self.tracker_gun.accelerationPorog = 0.035
        self.head_nodeInfo.minYaw = tr_global_param['head_yaw'][0]
        self.head_nodeInfo.maxYaw = tr_global_param['head_yaw'][1]
        self.head_nodeInfo.minPitch = tr_global_param['head_pitch'][0]
        self.head_nodeInfo.maxPitch = tr_global_param['head_pitch'][1]
        self.updateHeadAddYPR(tr_global_param)
        self.tracker_head.accelerationStep = tr_global_param['head_accelerationStep']
        self.tracker_head.accelerationPorog = tr_global_param['head_accelerationPorog']
        try:
            for node, yaw, pitch, roll in tr_global_param['head_weight']:
                self.head_nodeInfo.setWeightNode(node, pitch, yaw, roll)

        except:
            print '\nERROR FOR', self
            print self.model.sources if self.model else 'NO MODEL'
            traceback.print_stack()
            traceback.print_exc()

        self.torso_nodeinfo.minYaw = 0.0 if self.dead else tr_global_param['torso_yaw'][0]
        self.torso_nodeinfo.maxYaw = 0.0 if self.dead else tr_global_param['torso_yaw'][1]
        self.torso_nodeinfo.minPitch = 0.0 if self.dead else tr_global_param['torso_pitch'][0]
        self.torso_nodeinfo.maxPitch = 0.0 if self.dead else tr_global_param['torso_pitch'][1]
        self.torso_nodeinfo.addYaw = 0.0 if self.dead else tr_param['torso_add_yaw']
        self.torso_nodeinfo.addPitch = 0.0 if self.dead else tr_param['torso_add_pitch']
        deadzone = tr_global_param.get('torso_deadzone_enable', 0)
        self.tracker_torso.deadzone_enable = deadzone
        if deadzone:
            self.tracker_torso.deadzone_yaw_weights = tr_global_param.get('torso_deadzone_yaw_weights', [])
            self.tracker_torso.deadzone_pitch_weights = tr_global_param.get('torso_deadzone_pitch_weights', [])
        self.tracker_torso.accelerationStep = tr_global_param['torso_accelerationStep']
        self.tracker_torso.accelerationPorog = tr_global_param['torso_accelerationPorog']
        hvats = {'left': tr_param_override['hand_actionHvatL'],
         'right': tr_param['hand_actionHvatR']}
        if hvats['left'] and hvats['left'] == hvats['right']:
            print 'WARNING actionHvatL = actionHvatR', hvats, self.active_weapon, self
            hvats['right'] = ''
            hvats['left'] = ''
        for hand, new_action in hvats.items():
            if self._hvat_actions[hand]['name'] == new_action:
                continue
            prev_action = self._hvat_actions[hand]['name']
            prev_played = self._hvat_actions[hand]['played']
            self._hvat_actions[hand]['name'] = new_action
            self._hvat_actions[hand]['played'] = False
            if prev_action and prev_played:
                self._clear_saved_action(prev_action)
                try:
                    self.model.action(prev_action).stop()
                except:
                    self.__show_tracker_error('ERROR stop hvat action, model:%s, action:%s' % (self, repr(prev_action)))

        self.updateHandHvatAnimation()
        try:
            for node_name, yaw, pitch, roll in tr_global_param['torso_weight']:
                self.torso_nodeinfo.setWeightNode(node_name, pitch, yaw, roll)

        except:
            traceback.print_exc()

        self.torso_nodeinfo.blendFaktorFoot = tr_global_param['foot_blendFaktor']
        self.updateTorsoRoll()
        self.updateBlendNodeByImpacting()
        if getattr(self, '_pygunRWnode', None):
            self.updateSpreadActiveWeapon()
            self._pygunRWnode.onUpdatedWeaponStatus(self.weaponStatus)
            if self.active_weapon:
                self._pygunnode.weapon_motion_sens = param['recoil_and_spread'].get('weapon_motion_sens', 0.5)
        self.onChangeWeaponStatus()
        self.updateTorsoFlags()
        return

    def updateSpreadActiveWeapon(self):
        if getattr(self, '_pygunRWnode', None):
            self._pygunRWnode.updateSpread()
            self._pygunnode.updateSpread()
        return

    _is_weapon_collide = False

    @isTackerInit
    def _update_weapon_limits(self, tr_param = None):
        if not tr_param:
            tr_param, tr_param_override = self._get_tracker_param()

        def get_key(key):
            if self._is_weapon_collide and self.active_weapon:
                return key + '_coll'
            return key

        if self.gunnodeInfo:
            gun_yaw = tr_param[get_key('gun_yaw_limits')]
            gun_pitch = tr_param[get_key('gun_pitch')]
            self.gunnodeInfo.minYaw = gun_yaw[0]
            self.gunnodeInfo.maxYaw = gun_yaw[1]
            self.gunnodeInfo.minPitch = gun_pitch[0]
            self.gunnodeInfo.maxPitch = gun_pitch[1]
        if self.GUNMover_nodeInfo:
            self.GUNMover_nodeInfo.vecAddPos = tuple(tr_param[get_key('GUNPOS')])
            if self.weaponStatus == Constants.WEAPON_BORED and self.belly_weapon and not self._is_weapon_collide and self._last_action_type == 'idle' and tr_param.get('to_attach_weapon') == 'Track':
                self.GUNMover_nodeInfo.vecAddPos = tuple(tr_param['GUNPOS']) + Vector3(0, 0, 0.05)
        if self.test_nodeInfo_gunrw:
            self.test_nodeInfo_gunrw.vecAddPosGun = tuple(tr_param[get_key('GUNRWPOS')])
            self.test_nodeInfo_gunrw.weponRoll = tr_param[get_key('GUNRWROLL')]

    @isTackerInit
    def onEndToSatyCrouchAnimPlay(self):
        HandControl.onEndToSatyCrouchAnimPlay(self)
        self.updateBlendNodeByImpacting(True)

    @isTackerInit
    def onStartToSatyCrouchAnimPlay(self, *w, **kw):
        HandControl.onStartToSatyCrouchAnimPlay(self, *w, **kw)
        self.updateBlendNodeByImpacting(True)

    @ignoreError
    def replayHandHvatAnimation(self):
        for hand in self._hvat_actions:
            self._hvat_actions[hand]['played'] = False

        self.updateHandHvatAnimation()

    @ignoreError
    def updateHandHvatAnimation(self):
        for hand in self._hvat_actions:
            if not self._hvat_actions[hand]['name']:
                continue
            if self._hvat_actions[hand]['played'] != self._hvat_actions[hand]['lock']:
                continue
            try:
                action_name = self._hvat_actions[hand]['name']
                act = self.model.action(action_name)
                if not self._hvat_actions[hand]['played']:
                    self._hvat_actions[hand]['played'] = True
                    act()
                else:
                    self._hvat_actions[hand]['played'] = False
                    act.stop()
            except:
                self.__show_tracker_error('ERROR %s L hvat action:%s' % (self, repr(action_name)))

    def lockHandHvatAnimation(self, left = True, right = True, update = True):
        if self.isDestroyed:
            return
        if getattr(self, '_unlock_hvat_cid', 0):
            BigWorld.cancelCallback(self._unlock_hvat_cid)
            self._unlock_hvat_cid = 0
        if left:
            self._hvat_actions['left']['lock'] = True
        if right:
            self._hvat_actions['right']['lock'] = True
        if update:
            self.updateHandHvatAnimation()

    @isTackerInit
    def unLockHandHvatAnimation(self, left = True, right = True, update = True):
        if getattr(self, '_slope', 0):
            return
        if left:
            self._hvat_actions['left']['lock'] = False
        if right:
            self._hvat_actions['right']['lock'] = False
        if update:
            self.updateHandHvatAnimation()

    @isTackerInit
    def updateBlendNodeByImpacting(self, only_factor = False):
        """
        \xd0\xb2\xd0\xba\xd0\xbb-\xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb \xd1\x82\xd1\x80\xd0\xb5\xd0\xba\xd0\xb5\xd1\x80\xd1\x8b \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xb0\xd1\x8e\xd1\x82 \xd1\x81\xd0\xbf\xd0\xb5\xd1\x86 \xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8(\xd0\xb2\xd0\xb5\xd1\x80\xd1\x82 \xd0\xbb\xd0\xb5\xd1\x81\xd0\xb5\xd0\xbd\xd0\xba\xd0\xb0 \xd0\xb8 \xd1\x82\xd0\xbf)
        """
        if not only_factor:
            self.onCahngeTrakerKey(self._getTrackerKey(), None)
        head_factor = 1.0
        torso_factor = 1.0
        foot_factor = 1.0
        speed_off = False
        if self.isImpactingPlayed():
            head_factor = 0.0
            torso_factor = 0.0
            foot_factor = 0.0
            speed_off = True
            if self.isVerticalLadderPlayed():
                head_factor = 0.0001
                torso_factor = 0.0001
            if self.isImpactingPlayedHeadFree():
                head_factor = 1.0
        if self.isGetupAnimationPlayed():
            head_factor = 0
        if self.isUseItemAnimationPlayed():
            if self._todo_useanim_lock_head:
                head_factor = 0
            if self._todo_useanim_lock_torso:
                torso_factor = 0
            if self._todo_useanim_lock_foot:
                foot_factor = 0
        if self._playing_animation_loot:
            head_factor = 0
            torso_factor = 0
        if self._interact_action_callback:
            head_factor = 0
            torso_factor = 0
        if self.isRelaodWeaponProgress:
            head_factor = head_factor * 0.01
            torso_factor = torso_factor * 0.5
        if self.isPutOnOffWeaponProgress:
            head_factor = head_factor * 0.01
        if self.isEquipWeaponProgress:
            head_factor = head_factor * 0.8
            torso_factor = torso_factor * 0.95
        if self.isToStayCrouchAnimPlayed:
            torso_factor = 0.0001
            foot_factor = 0.0001
        if self.dead:
            head_factor = 0
            torso_factor = 0
        if self.lookingaround and self._torso_disbale_by_lookaround:
            torso_factor = 0.0
        if self.isJump():
            head_factor = 0
        tr_param, tr_param_override = self._get_tracker_param()
        tr_global_param = self._get_global_tracker_param()
        self.head_nodeInfo.blendFaktor = tr_global_param['head_blendFaktor'] * head_factor
        self.torso_nodeinfo.blendFaktor = tr_param['spine_blendFaktor'] * torso_factor
        self.torso_nodeinfo.blendFaktorFoot = tr_global_param['foot_blendFaktor'] * foot_factor
        if speed_off:
            self.torso_nodeinfo.blendFaktorCurrFoot = tr_global_param['foot_blendFaktor'] * foot_factor
            if not torso_factor:
                self.torso_nodeinfo.blendFaktorCurr = 0
            if not head_factor:
                self.head_nodeInfo.blendFaktorCurr = 0
        return

    def isImpactingPlayed(self):
        return False

    def isImpactingPlayedHeadFree(self):
        return False

    _todo_useanim_lock_head = False
    _todo_useanim_lock_torso = False
    _todo_useanim_lock_foot = False

    def isUseItemAnimationPlayed(self):
        return False

    def isFPSmode(self):
        return False

    def isInsideShell(self):
        return True

    def _createScaleBones(self):
        if not self.active_transform:
            return
        bones = self.active_transform.getScaleBones()
        if not bones:
            return
        scale_tracker = BigWorld.Tracker()
        scale_tracker.testTick = False
        scale_tracker.fashionEraID = 0
        scale_tracker.maxLod = tracker_lod_settings.tracker_torso_lod
        scale_tracker.directionProvider = Matrix()
        self.model.scale_tracker = scale_tracker
        for node_name, scale in bones.items():
            n = BigWorld.BoneScale(self.model, str(node_name))
            scale_tracker.addAdditionalNode(n)
            n.scale = float(scale)

    def _createScaleBonesPost(self):
        if not self.active_transform:
            return
        bones = self.active_transform.getScaleBonesPost()
        if not bones:
            return
        scale_tracker = BigWorld.Tracker()
        scale_tracker.testTick = False
        scale_tracker.fashionEraID = 10
        scale_tracker.maxLod = tracker_lod_settings.tracker_torso_lod
        scale_tracker.directionProvider = Matrix()
        self.model.scale_tracker_post = scale_tracker
        for node_name, scale in bones.items():
            n = BigWorld.BoneScale(self.model, str(node_name))
            scale_tracker.addAdditionalNode(n)
            n.scale = float(scale)

