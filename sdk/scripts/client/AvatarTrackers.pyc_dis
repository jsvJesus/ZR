    @ignoreError
    def createTrakers(self, only_gun = False):
        if only_gun:
            self._createTrackerGun()
            return
        else:
            self._tracker_is_init = False
            if not getattr(self, 'npcSuit', False):
                self.add_collider()
            if not self.enable_tracker:
                if self.active_transform:
                    self._createScaleBones()
                    self._createScaleBonesPost()
                return
            if self.active_transform:
                self._createScaleBones()
                if self.active_transform.isCustomModel:
                    return
            self._createTrackerTorso()
            self._createTrackerGunMover()
            self._createTrackerLeftArm()
            self._createTrackerRightArm()
            self._createTrackerHead()
            self._createTrackerGun()
            self._hand_blend_prov_complete = True
            self.foots = [foot_tmp.Foot('Left', 'Lstep', self), foot_tmp.Foot('Right', 'Rstep', self)]
            self.xTorso = foot_tmp.TorsoX(self)
            if getattr(self, 'fniLeft', None):
                self.fniLeft.pTorso = None
            if getattr(self, 'fniRight', None):
                self.fniRight.pTorso = None
            self.fniLeft = BigWorld.FootNodeInfo(self.model, 'Hips', 'Pelvis', 'LeftUpLeg', 'LeftLeg', 'LeftFoot')
            self.torso_nodeinfo.leftFootNodeInfo = self.fniLeft
            self.fniLeft.pTorso = self.torso_nodeinfo
            self.fniLeft.isLeft = True
            self.fniLeft.maxWorkingDistanceToCamera = tracker_lod_settings.tracker_foot_lod
            self.fniRight = BigWorld.FootNodeInfo(self.model, 'Hips', 'Pelvis', 'RightUpLeg', 'RightLeg', 'RightFoot')
            self.torso_nodeinfo.rightFootNodeInfo = self.fniRight
            self.fniRight.pTorso = self.torso_nodeinfo
            self.fniRight.isLeft = False
            self.fniRight.maxWorkingDistanceToCamera = tracker_lod_settings.tracker_foot_lod
            self.fniLeft.pCallBackTestPython = self.foots[0].call
            self.fniRight.pCallBackTestPython = self.foots[1].call
            self.torso_nodeinfo.postTrackedTorsoCallback = self.xTorso.postTrackedTorsoCallback
            self.torso_nodeinfo.pCallBackTickPython = self.xTorso.onTick
            self.torso_nodeinfo.rightLeftHands = (self.nodeInfoL, self.nodeInfoR)
            self.model.motors[0].matchNotifier = self.modelMatchNotifier
            self.model.motors[0].errorStringNotifier = self.AM_errorStringNotifier
            self.model.motors[0].matchNotifierLodDistance = 100.0
            self._tracker_is_init = True
            self.updateCrawlMode()
            self.onCreateTrackers()
            HandControl.onCreateTrackers(self)
            if self.enable_tracker and not self.is_old_npc:
                try:
                    import spring_fabric
                    spring_fabric.applyToEntity(self)
                    if self.isHeadExist():
                        EyesController.create_controller(self).start()
                except:
                    print '----------'
                    print self
                    traceback.print_exc()

            isCustomModel = False
            if self.active_transform and self.active_transform.isCustomModel:
                isCustomModel = True
            if not isCustomModel and self.isHeadExist():
                face_controller = FaceController.create_controller(self, justOnePythonDraw=self.just_one_face_draw)
                StalkerModel.apply_face(self, face_controller)
            if self.active_transform:
                self._createScaleBonesPost()
            return

