    @ignoreError
    def clearAvatarGuns(self):
        if getattr(self, 'npcSuit', False):
            return
        else:
            if self.model:
                self.model.GUNR = None
                self.model.weaponback = None
                self.model.weaponback2 = None
                self.model.Pistol = None
                self.model.belly = None
                self.model.Lhand = None
                self.model.Rhand = None
                self.setActiveWeaponModel(None)
                self.active_weapon = None
                self.belly_weapon = None
            weapon_slots = getattr(self, 'weapon_slots', {})
            for w in weapon_slots.values():
                w.destroyWeapon()

            self.weapon_slots = {}
            if self.heli_weapon:
                self.heli_weapon.destroy()
            self.heli_weapon = None
            return

    @ignoreError
    def _debugClearAvatarGuns(self):
        self.model.GUNR = None
        self.model.weaponback = None
        self.model.weaponback2 = None
        self.model.Pistol = None
        self.model.belly = None
        self.model.Lhand = None
        self.model.Rhand = None
        self.setActiveWeaponModel(None)
        self.active_weapon = None
        self.belly_weapon = None
        self.hand_cotrol_wait_tmp = False
        self._HandControl__isEquipProgress = False
        self._HandControl__reload_weapon_progress = False
        self._HandControl__reload_weapon_osn_anmation = False
        for old_weapon in self.weapon_slots.values():
            old_weapon.destroyWeapon()

        self.weapon_slots = {}
        self._prev_weapon_slots = {}
        return

    @ignoreError
    def setAvatarGuns(self):
        try:
            self.model.GUNR = None
            self.model.weaponback = None
            self.model.weaponback2 = None
            self.model.Pistol = None
            self.model.belly = None
            self.model.Lhand = None
            self.model.Rhand = None
        except AttributeError as err:
            print 'setAvatarGuns clear nodes:', err, self

        if self.heli_weapon:
            self.heli_weapon.destroy()
        self.heli_weapon = None
        self.setActiveWeaponModel(None)
        self.active_weapon = None
        self.belly_weapon = None
        self.hand_cotrol_wait_tmp = False
        self._HandControl__isEquipProgress = False
        self._HandControl__reload_weapon_progress = False
        self._HandControl__reload_weapon_osn_anmation = False
        if self.active_transform and self.active_transform.isCustomModel:
            return
        else:
            self.weapon_slots = {}
            for slot_name in nodebyslot.keys():
                slot = self.ActiveWeaponSet2[slot_name]
                if not slot['itemID']:
                    continue
                self.makeWeaponAndAttach(slot_name)

            self._prev_weapon_slots = {}
            self.UpdateWeaponIcon()
            self.sendWTonAvatarChangeWeapon()
            return

    def need_hide_weapon(self):
        return self.active_transform and self.active_transform.getparam('hide_weapon')

    def makeWeaponFromSlot(self, slot, slot_name = None):
        import clweapon
        weapon = clweapon.create_clinet_weapon(parent_entity=self, slot=slot)
        weapon.holster_node_name = nodebyslot[slot_name]
        if slot_name:
            weapon.slot_name = slot_name
        return weapon

    def makeWeaponAndAttach(self, slot_name):
        need_to_belly = False
        old_weapon = None
        try:
            prev_weapon_slots = getattr(self, '_prev_weapon_slots', {})
            if slot_name in prev_weapon_slots:
                old_weapon = prev_weapon_slots.pop(slot_name)
                if old_weapon.holster_node_name:
                    setattr(self.model, old_weapon.holster_node_name, None)
                if self.active_weapon == old_weapon:
                    self.model.Lhand = None
                    self.model.Rhand = None
                    self._weapon_to_attached = None
                if old_weapon.isBelly:
                    need_to_belly = True
                    self.model.belly = None
                if self.belly_weapon == old_weapon:
                    self.belly_weapon = None
                old_weapon.destroyWeapon()
        except:
            print self, 'slot_name', slot_name
            traceback.print_exc()

        if self.need_hide_weapon():
            return
        else:
            slot = self.ActiveWeaponSet2[slot_name]
            try:
                weapon = self.makeWeaponFromSlot(slot, slot_name)
                weapon.holster_node_name = nodebyslot[slot_name]
                weapon.isBelly = False
                if self.BellyItemID == weapon.getItemID():
                    weapon.isBelly = True
                    self.belly_weapon = weapon
                if old_weapon and old_weapon.shooting_mode != weapon.shooting_mode:
                    weapon.set_shooting_mode(old_weapon.shooting_mode)
                self.weapon_slots[slot_name] = weapon
                model = weapon.getModel()
                if weapon.getItemID() == self.ActiveItemID and not weapon.isBelly:
                    self.model.GUNR = model
                    self.active_weapon = weapon
                    self.setActiveWeaponModel(model, weapon)
                    to_attach = self.getNodeNameActiveWeaponAttached()
                    if to_attach:
                        copy_model = weapon.createCopyModelWeapon()
                        setattr(self.model, to_attach, copy_model)
                        weapon.setVisibleModel(copy_model)
                    if need_to_belly:
                        belly_model = weapon.createCopyModelWeapon()
                        setattr(self.model, 'belly', belly_model)
                        weapon.setVisibleModel(belly_model)
                        weapon.isBelly = True
                elif weapon.isBelly:
                    belly_model = weapon.createCopyModelWeapon()
                    setattr(self.model, 'belly', belly_model)
                    weapon.setVisibleModel(belly_model)
                else:
                    setattr(self.model, nodebyslot[slot_name], model)
            except:
                print self
                print self.position, BWPersonality.spaceName(self.spaceID)
                print 'slot_name', slot_name
                print 'slot', dict(slot)
                traceback.print_exc()
                if self.ActiveItemID == self.ActiveWeaponSet2[slot_name]['itemID']:
                    self.ActiveItemID = 0
                print

            if self == BigWorld.player():
                self.applyWeaponSettings(weapon)
            return

    def get_firing_point(self):
        """ \xd1\x82\xd0\xbe\xd1\x87\xd0\xba\xd0\xb0 \xd0\xb8\xd0\xb7 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb9 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd1\x81\xd1\x82\xd1\x80\xd0\xb5\xd0\xbb\xd1\x8f\xd1\x82\xd1\x8c
                sys_point - ???
                barrel_point - \xd1\x82\xd0\xbe\xd1\x87\xd0\xba\xd0\xb0 \xd0\xb8\xd0\xb7 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb9 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd1\x81\xd1\x82\xd1\x80\xd0\xb5\xd0\xbb\xd1\x8f\xd1\x82\xd1\x8c
                direction - \xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb8\xd0\xb7 \xd1\x82\xd0\xbe\xd1\x87\xd0\xba\xd0\xb8
        """
        if self.active_weapon_model and self.active_weapon_model.node('HP_AIMSYS').isActualCoords and self.active_weapon_model.node('HP_barrel').isActualCoords:
            sys_point_matrix = Matrix(self.active_weapon_model.node('HP_AIMSYS'))
            direction = sys_point_matrix.applyToAxis(2)
            sys_point = sys_point_matrix.translation
            barrel_point_matrix = Matrix(self.active_weapon_model.node('HP_barrel'))
            barrel_point = barrel_point_matrix.translation
            if self.IsAvatarSniping() and (self.isFPSmode() or self != BigWorld.player()):
                cam_node = self.active_weapon.getCameraNode()
                if cam_node:
                    m_wi = Matrix(barrel_point_matrix)
                    m_wi.invert()
                    cam_loc = m_wi.applyPoint(Matrix(cam_node).translation)
                    barrel_point = barrel_point_matrix.applyPoint(Vector3(cam_loc.x, cam_loc.y, 0))
        else:
            direction = Vector3()
            direction_model = Vector3()
            direction.setPitchYaw(self.pitch, self.yaw)
            if getattr(self, '_pygunRWnode', None):
                add_rec = self._pygunnode.getCurrentRecoilYPR()
                add_rec_w = self._pygunRWnode.getCurrentRecoilYPR()
                direction.setPitchYaw(self.pitch + add_rec.y + add_rec_w.y, self.yaw + add_rec.x + add_rec_w.x)
            direction_model.setPitchYaw(0, self.yaw)
            if self.IsAvatarCrawling():
                sys_point = self.position + (0, 0.15, 0)
                barrel_point = sys_point + direction_model * 0.2
            elif self.IsAvatarCrouched():
                sys_point = self.position + (0, 0.8, 0)
                barrel_point = sys_point + direction_model * 0.6
            else:
                sys_point = self.position + (0, 1.2, 0)
                barrel_point = sys_point + direction_model * 0.6
        return (sys_point, barrel_point, direction)

    def getMaxBulletSpread(self, shot_number = 0):
        bullet_spread = self.active_weapon.getBulletSpread(shot_number=shot_number)
        if getattr(self, '_pygunnode', None):
            if not self.isFPSmode():
                bullet_spread += self._pygunnode.getCurrentRecoilCircle()
        return bullet_spread

    def getPlayerFireResult(self, shot_number = 0):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3 \xd0\xbd\xd0\xb0\xd1\x85\xd0\xbe\xd0\xb6\xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd1\x80\xd1\x83\xd0\xb6\xd0\xb8\xd1\x8f \xd0\xb2 \xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb5 \xd0\xb8 \xd0\xb2\xd0\xb5\xd0\xba\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b \xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbf\xd1\x83\xd0\xbb\xd1\x8c """
        if not self.active_weapon:
            return
        if not self.active_weapon_model:
            return
        if not self.active_weapon_model.visible:
            return
        sys_point, barrel_point, direction = self.get_firing_point()
        weapon_in_water = bool(BigWorld.waterCollide(barrel_point, barrel_point))
        wall_collision = BigWorld.naturalCollideIgnoreFlags(sys_point, barrel_point, PORTALS_DEPTH_COLLIDE, IGNORE_MATERIAL)
        if wall_collision and wall_collision[0]:
            return (weapon_in_water, [])
        shot_directions = []
        if self.offline_mode:
            self.active_weapon.getAmmoType = lambda *e: 601
        bullet_spread = self.getMaxBulletSpread(shot_number=shot_number)
        for i in xrange(self.active_weapon.getNumberOfBullet()):
            bullet_vector = random_vector(direction, bullet_spread)
            shot_directions.append(bullet_vector)

        return (weapon_in_water, shot_directions)

    def drawPlayerFire(self, weapon_in_water, isBrust = False, weapon_in_shell = False, shot_number = 1, time_per_shot = 0):
        self.active_weapon.shoot(weapon_in_water, weapon_in_shell, isBrust=isBrust, shot_number=shot_number)
        self.playAnimationAfterFire()
        if getattr(self, '_pygunRWnode', None):
            self._pygunRWnode.onFire(isBrust=isBrust, shot_number=shot_number, time_per_shot=time_per_shot)
            self._pygunnode.onFire(isBrust=isBrust, shot_number=shot_number, time_per_shot=time_per_shot)
        self.torsoRecoil()
        return

    numberOfbullet = 1

    @isTackerInit
    def playerFire(self, isBrust = False, shot_number = 1):
        raise

    def tmpsetYP(self):
        return
        gunYaw, gunPitch = self.tracker_gun.yaw, self.tracker_gun.pitch
        matrGR_Limit = Math.Matrix(self.model.node('HP_GUNR_LIMIT'))
        toyaw = gunYaw - matrGR_Limit.yaw
        potich = gunPitch - matrGR_Limit.pitch
        if toyaw > math.pi:
            toyaw = toyaw - math.pi * 2
        if toyaw < -math.pi:
            toyaw = toyaw + math.pi * 2
        maxy, miny = toyaw + 0, toyaw - 0
        maxp, minp = potich + 0, potich - 0
        self.gunnodeInfo.test_SetLimitPY(maxp, minp, maxy, miny)

    def is_sloping(self):
        return bool(self._slope)

    def is_sloping_and_caps(self):
        return self._slope and self._slope_caps

    def slopeNotifer(self, status):
        self._slope = status
        self.UpdateAvatarAnimationCaps()
        if self is BigWorld.player():
            self.try_reset_falling_velocity()
        if self._slope and self._weapon_to_attached != 'Track':
            self.lockHandHvatAnimation(left=1, right=0, update=True)
        else:
            self._unlock_hvat_cid = BigWorld.callback(self.delay_unlock_hvat_after_slope, partial(self.unLockHandHvatAnimation, 1, 0, True))

    def ladderNotifer(self, isladder):
        self._isladder = isladder
        self.UpdateAvatarAnimationCaps()

    def changeVisibleAttachModel(self, slot_type):
        if not self.model:
            return
        if self.need_hide_weapon():
            return
        import ClothAttachSlotsConfig as CASC
        node_name = CASC.get_slot_model_node_name(slot_type)
        try:
            node = self.model.node(node_name)
        except Exception:
            print 'ERROR changeVisibleAttachModel', slot_type, node_name
            return

        for attachment in node.attachments:
            node.detach(attachment)

        if not self.EquippedVisibleAttaches[slot_type]:
            return
        item_param = ItemsCatalog.GetItemParam(self.EquippedVisibleAttaches[slot_type])
        if not item_param:
            return
        model_list = item_param.get('ModelNames', {}).values()
        if not model_list:
            return
        model_list_copy = list(model_list)

        def on_load(model):
            if self.isDestroyed:
                return
            if not self.model:
                return
            if not model:
                print 'changeVisibleAttachModel:error load model', repr(model_list), self
                return
            self.model.node(node_name).attach(model)

        model_list_copy.append(on_load)
        BigWorld.fetchModel(*model_list_copy)

    def clearPistolHolster(self):
        if self.model and self._model_pistol_holster:
            try:
                self.model.node('HP_Pistol').detach(self._model_pistol_holster)
            except:
                traceback.print_exc()

        self._model_pistol_holster = None
        return

    def updatePistolHolster(self, prereqs = None):
        if not self.havePistolHolster():
            return self.clearPistolHolster()
        if self._model_pistol_holster:
            return
        if prereqs and prereqs.has_key(PISTOL_HOLSTER_PATH):
            self._onLoadPistolHolster(prereqs)
        else:
            ResourceLoader.asyncLoad([(ResourceLoader.MODEL, PISTOL_HOLSTER_PATH)], self._onLoadPistolHolster)

    def havePistol(self):
        """
        \xd0\xb5\xd1\x81\xd1\x82\xd1\x8c \xd0\xbb\xd0\xb8 \xd1\x83 \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f \xd0\xbf\xd0\xb8\xd1\x81\xd1\x82\xd0\xbe\xd0\xbb\xd0\xb5\xd1\x82
        """
        if self.need_hide_weapon():
            return False
        return bool(self.ActiveWeaponSet2['SecondarySlot']['itemID'])

    def havePistolHolster(self):
        if self.need_hide_weapon():
            return False
        itemType = self.ActiveWeaponSet2['SecondarySlot']['itemType']
        if not itemType:
            return False
        return ItemsCatalog[itemType].get('pistolHolsterVisible', True)

    def _onLoadPistolHolster(self, prereqs):
        if self.isDestroyed:
            return
        if not self.model:
            return
        if not self.havePistolHolster():
            return
        if self._model_pistol_holster:
            self.clearPistolHolster()
        self._model_pistol_holster = prereqs[PISTOL_HOLSTER_PATH]
        try:
            self._model_pistol_holster.origin('HP_Pistol')
            self.model.node('HP_Pistol').attach(self._model_pistol_holster)
        except:
            traceback.print_exc()

