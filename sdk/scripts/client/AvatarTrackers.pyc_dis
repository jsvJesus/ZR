    @ignoreError
    def onPreModelChange(self):
        if self.model:
            self.__saved_action_queue = ResMgr.DataSection('saved_action_queue')
            self.__saved_action_responses = ResMgr.ActionResponceState()
            self.model.saveActionQueue(self.__saved_action_queue, self.__saved_action_responses)
            self.__saved_yaw = self.model.yaw
            self.__saved_hands = {}
            if getattr(self, 'nodeInfoL', None):
                self.__saved_hands['left'] = dict(angleRollForce=self.nodeInfoL.angleRollForce, angleRoll=self.nodeInfoL.angleRoll)
                self.__saved_hands['right'] = dict(angleRollForce=self.nodeInfoR.angleRollForce, angleRoll=self.nodeInfoR.angleRoll)
            self.__last_data_trackers = {}

            def saveState(tracker):
                ds = ResMgr.DataSection('saved_tracker')
                tracker.saveState(ds)
                return ds

            if getattr(self, 'tracker_torso', None) and self.tracker_torso.nodeInfo:
                self.__last_data_trackers['tracker_torso'] = saveState(self.tracker_torso)
            if getattr(self, 'tracker_head', None) and self.tracker_head.nodeInfo:
                self.__last_data_trackers['tracker_head'] = saveState(self.tracker_head)
            if getattr(self, 'tracker_gun', None) and self.tracker_gun.nodeInfo:
                self.__last_data_trackers['tracker_gun'] = saveState(self.tracker_gun)
            if getattr(self, 'tracker_gun_mover', None) and self.tracker_gun_mover.nodeInfo:
                self.__last_data_trackers['tracker_gun_mover'] = saveState(self.tracker_gun_mover)
            if getattr(self, 'active_weapon_model', None) and getattr(self.active_weapon_model, 'test_tracker_gunrw', None):
                self.__last_data_trackers['test_tracker_gunrw'] = saveState(self.active_weapon_model.test_tracker_gunrw)
            if self.xTorso:
                self.__last_xtorso_data = self.xTorso.getSaveState()
            HandControl.onPreModelChangeHand(self)
        return

    @ignoreError
    def onPostModelChange(self):
        if getattr(self, 'transformationID', None):
            self.__saved_action_queue = None
            self.__last_data_trackers = None
        if getattr(self, 'inject_repostmodel_crutch', False):
            self.__saved_action_queue = None
            self.__last_data_trackers = None
            self._last_action_type = 'idle'
            self.SetWeaponStatus(Constants.WEAPON_INCOMABAT)
        self.__saved_action_queue = self.check_visor(self.__saved_action_queue)
        self.__saved_action_queue = self.check_gasmask_filter(self.__saved_action_queue)
        self.__saved_action_queue = self._clear_lod_animations(self.__saved_action_queue)
        self.__saved_action_queue = self.check_saved_animations(self.__saved_action_queue)
        if self.model and self.__saved_action_queue:
            self.model.restoreActionQueue(self.__saved_action_queue, self.__saved_action_responses)
            if self.__saved_yaw is not None:
                self.model.yaw = self.__saved_yaw
            if self.__last_data_trackers:
                if getattr(self, 'torso_nodeinfo', None) and self.__last_data_trackers.get('tracker_torso'):
                    self.tracker_torso.restoreState(self.__last_data_trackers['tracker_torso'])
                    self.torso_nodeinfo.restoreNodeState(self.__last_data_trackers['tracker_torso'])
                if getattr(self, 'tracker_head', None) and self.__last_data_trackers.get('tracker_head'):
                    self.tracker_head.restoreState(self.__last_data_trackers['tracker_head'])
                    self.head_nodeInfo.restoreNodeState(self.__last_data_trackers['tracker_head'])
                if getattr(self, 'tracker_gun', None) and self.__last_data_trackers.get('tracker_gun'):
                    self.tracker_gun.restoreState(self.__last_data_trackers['tracker_gun'])
                    self.tracker_gun.nodeInfo.restoreNodeState(self.__last_data_trackers['tracker_gun'])
                if getattr(self, 'tracker_gun_mover', None) and self.__last_data_trackers.get('tracker_gun_mover'):
                    self.tracker_gun_mover.restoreState(self.__last_data_trackers['tracker_gun_mover'])
                    self.tracker_gun_mover.nodeInfo.restoreNodeState(self.__last_data_trackers['tracker_gun_mover'])
                if getattr(self, 'active_weapon_model', None) and self.__last_data_trackers.get('test_tracker_gunrw'):
                    self.active_weapon_model.test_tracker_gunrw.restoreState(self.__last_data_trackers['test_tracker_gunrw'])
                    self.active_weapon_model.test_tracker_gunrw.nodeInfo.restoreNodeState(self.__last_data_trackers['test_tracker_gunrw'])
            if self.__saved_hands:
                if getattr(self, 'nodeInfoL', None):
                    self.nodeInfoL.angleRollForce = self.__saved_hands['left']['angleRollForce']
                    self.nodeInfoR.angleRollForce = self.__saved_hands['right']['angleRollForce']
                    self.nodeInfoL.angleRoll = self.__saved_hands['left']['angleRoll']
                    self.nodeInfoR.angleRoll = self.__saved_hands['right']['angleRoll']
            if self.__last_xtorso_data and self.xTorso:
                self.xTorso.restoreState(self.__last_xtorso_data)
            HandControl.onPostModelChangeHand(self)
        self.__last_data_trackers = None
        self.__saved_action_queue = None
        self.__saved_action_responses = None
        self.__last_xtorso_data = None
        self.__saved_hands = None
        self.__saved_yaw = None
        self.right_hand_model_sound_node = None
        self.updateModelRotateMod()
        StalkerModel.update_tuck(self)
        StalkerModel.update_filter_mask(self)
        return

    _orig_serverLook = None
    __head_from_server = False
    __head_from_server_timer = 0

    @isTackerInit
    def onChangedServerHeadDirection(self, head_direction):
        """
                \xd0\xbd\xd0\xb0\xd0\xb1\xd0\xbb\xd1\x8e\xd0\xb4\xd0\xb0\xd0\xb5\xd0\xbc\xd1\x8b\xd0\xb9 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80 \xd0\xb2\xd0\xba\xd0\xbb\\\xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb lookAround
        """

        def autoStopServerHead():
            if self.isDestroyed:
                return
            self.__head_from_server_timer = 0
            self.__head_from_server = False
            self.tracker_head.directionProvider = self.headProvider_entity

        if self.__head_from_server_timer:
            BigWorld.cancelCallback(self.__head_from_server_timer)
            self.__head_from_server_timer = 0
        if head_direction.x < -50:
            self.__head_from_server = False
            self.tracker_head.directionProvider = self.headProvider_entity
        else:
            if not self.__head_from_server:
                self.headProvider_serverLook = Matrix()
                self._orig_serverLook = None
                if self.transport_seat and not BigWorld.entities.get(self.transport_seat):
                    return
                self.__head_from_server = True
                if self.in_helicopter or self.is_gunpoint:
                    self.headProvider_serverLook = Math.MatrixProduct()
                    self._orig_serverLook = Matrix()
                    self._orig_serverLook.setRotateYPR((head_direction.x, head_direction.y, 0))
                    if self.is_gunpoint:
                        self.headProvider_serverLook.a = self._orig_serverLook
                        self.headProvider_serverLook.b = Matrix()
                    else:
                        self.headProvider_serverLook.a = self._orig_serverLook
                        self.headProvider_serverLook.b = BigWorld.entities[self.transport_seat].matrix
                    self.updateGunProvider()
                    self.updateTorsoHeadProvider()
                self.tracker_head.directionProvider = self.headProvider_serverLook
            if self._orig_serverLook:
                self._orig_serverLook.setRotateYPR((head_direction.x, head_direction.y, 0))
            else:
                self.headProvider_serverLook.setRotateYPR((head_direction.x, head_direction.y, 0))
            self.__head_from_server_timer = BigWorld.callback(60, autoStopServerHead)
        return

    torso_roll_value = 0

    @ignoreError
    def updateTorsoRoll(self):
        self.torso_nodeinfo.addRoll = self.torso_roll_value
        self.updateCameraPosition()
        self.update_turn_states()

    def weaponStatusUpdated(self, old = None):
        self.UpdateAvatarAnimationCaps()
        self.setDirectionProviderParam()
        if old is None:
            return
        elif old == self.weaponStatus:
            return
        else:
            self.updateBreathHolding(False)
            states = set([old, self.weaponStatus])
            if states.issubset([Constants.WEAPON_SNIPING, Constants.WEAPON_INCOMABAT]):
                return
            sounds.playSound('guns/weapon_shift', self)
            return

    def updateBreathHolding(*e):
        pass

    _hand_wepon_providers_recreted = True

    @ignoreError
    def attachHandToWeaponTMP(self, weapon_model = None, weapon = None):
        if not self.active_weapon_model:
            print
            print 'not self.active_weapon_model!!'
            traceback.print_stack()
            print
            return
        else:
            if not weapon:
                weapon = self.active_weapon
                self._hand_wepon_providers_recreted = True
                pWeapon_hilt_provider = self.active_weapon_model.node('HP_Lhand')
                pWeapon_gunrw_provider = self.active_weapon_model.node('HP_GUNRW')
                enable_adhering = 1
                self.left_weapon_prov = BigWorld.HandToWeaponProvider(self.model, pWeapon_hilt_provider, pWeapon_gunrw_provider, enable_adhering)
                pWeapon_hilt_provider = self.active_weapon_model.node('HP_Rhand')
                self.right_weapon_prov = BigWorld.HandToWeaponProvider(self.model, pWeapon_hilt_provider, pWeapon_gunrw_provider, enable_adhering)
                if weapon and weapon._custom_hilt:
                    weapon.attachHandToCustomHilt(self.left_weapon_prov, self.right_weapon_prov)
                if getattr(self, 'nodeInfoR', None):
                    self.nodeInfoR.rotateHand = True
                self.nodeInfoL.rotateHand = getattr(self, 'nodeInfoL', None) and True
            self.updateHandToWeaponOffset()
            self.onCreateHandToWeaponProvider()
            return

