    def _clear_lod_animations(self, section):
        if section is None:
            return
        else:
            for name, action in section.items():
                if name == 'action' and action['name'].asString.startswith('LOD_'):
                    section.deleteSection(action)
                elif name == 'action' and action['name'].asString.startswith('use_stone'):
                    section.deleteSection(action)

            return section

    def _clear_saved_action(self, action_name):
        """
        \xd0\x95\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xba\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb9-\xd1\x82\xd0\xbe \xd1\x8d\xd0\xba\xd1\x88\xd0\xb5\xd0\xbd \xd0\xb1\xd1\x83\xd0\xb4\xd0\xb5\xd1\x82 \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x91\xd0\xbd, \xd1\x82\xd0\xbe \xd0\xba\xd0\xbe\xd0\xbb\xd0\xbb\xd0\xb1\xd0\xb5\xd0\xba \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x8d\xd1\x82\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x8d\xd0\xba\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xbd\xd0\xb5 \xd0\xb1\xd1\x83\xd0\xb4\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbe\xd1\x81\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f
        """
        if self.__saved_action_queue is None:
            return
        else:
            for name, action in self.__saved_action_queue.items():
                if name == 'action' and action['name'].asString == action_name:
                    self.__saved_action_queue.deleteSection(action)

            return

    def check_visor(self, section):
        """ \xd0\xb2\xd0\xbe\xd1\x81\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c (\xd1\x83\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd1\x8c) \xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xb1\xd1\x80\xd0\xb0\xd0\xbb\xd0\xbe """
        need_visor = EST.is_mode_on(self, EST.MODE_VISOR)
        visor_action = None
        if section is not None:
            for name, action in section.items():
                if name == 'action' and action['name'].asString == VISOR_OPEN_LOOP_ACTION:
                    visor_action = action
                    break

        if need_visor and not visor_action:
            if section is None:
                section = ResMgr.DataSection('saved_action_queue')
                visor_action = section.createSection('action')
                visor_action.writeString('name', 'Vladov_kostyl')
            visor_action = section.createSection('action')
            visor_action.writeString('name', VISOR_OPEN_LOOP_ACTION)
            visor_action.writeFloat('finish', -1)
            visor_action.writeInt('firstFrame', -1)
            visor_action.writeInt('lastFrame', -1)
            visor_action.writeInt('frameRate', -1)
            visor_action.writeFloat('passed', 100)
            visor_action.writeFloat('played', 100)
            visor_action.writeFloat('lastPlayed', 100)
            visor_action.writeBool('promoteMotion', False)
        elif not need_visor and visor_action:
            section.deleteSection(visor_action)
        return section

