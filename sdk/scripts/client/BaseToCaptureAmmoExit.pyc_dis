import json
import ResMgr
import Constants
import BigWorld
import traceback
import ItemsUtils
import BWPersonality
from Localization import lc
from functools import partial
from ItemHolder import ItemHolder
from Helpers.Caps import CAP_INTERACT
from soGUI.soInworldMarkers import soInworldMarker

class BaseToCaptureAmmoExit(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._model_path = 'models/buildings/doors/door_germo/door_germo_close.model'
        self.model = None
        self.targetCaps = [CAP_INTERACT]
        self.name = lc('GUI.IngameMenu.exit')
        self.scale = 1
        return

    def prerequisites(self):
        if self._model_path:
            return [self._model_path]
        return []

    def onEnterWorld(self, prereqs):
        if self._model_path:
            scale = self.scale
            self.model = prereqs[self._model_path]
            self.model.isObstacle = True
            self.model.visible = True
            self.model.scale = (scale, scale, scale)
            self.model.newScaleTest = (scale, scale, scale)

    def onLeaveWorld(self):
        self.model = None
        return

    def interact(self, player):
        player.cell.capture_spawn_random()

    def get_target_mark(self, distance):
        if self.get_interaction_dist() >= distance:
            return soInworldMarker.MARKER_USE
        else:
            return None

    def get_interaction_dist(self):
        return Constants.INTERACTION_DISTANCE

    def get_hightlight(self, distance):
        if distance > 15:
            return None
        else:
            return True