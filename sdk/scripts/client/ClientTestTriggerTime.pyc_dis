# Embedded file name: ./client/ClientTestTriggerTime.py
import BigWorld
import Math
from ClientLightManager import lmanager
import client_lights.light
from client_lights.light import STATE_UND, STATE_OFF, STATE_ON

class ClientTestTriggerTime(BigWorld.Entity):
    """" client/ClientTestTriggerTime """

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._hundle_timer = 0
        self.state = STATE_UND

    def onEnterWorld(self, prereqs):
        self.model = BigWorld.Model('')
        lmanager.createLights(self.targetNodes, self, STATE_UND, self.onLoadUDO)

    def onLoadUDO(self):
        self.initTimer()

    def initTimer(self):
        if not self.game_time_diap:
            print self, self.position
            raise ValueError('Empty game_time_diap')
        tfrom, tto = self.game_time_diap.split('-')
        self.tfrom = self._stime2int(tfrom)
        self.tto = self._stime2int(tto)
        if self.tfrom == self.tto:
            print self, self.position
            raise ValueError('eq game_time_diap %s' % self.game_time_diap)
        self._update()

    def _update(self):
        self._hundle_timer = BigWorld.callback(1.5, self._update)
        cur_time = self._stime2int(BigWorld.timeOfDay())
        state = STATE_ON
        if self.tfrom < self.tto:
            if cur_time < self.tfrom or cur_time > self.tto:
                state = STATE_OFF
        else:
            state = STATE_OFF
            if cur_time > self.tfrom or cur_time < self.tto:
                state = STATE_ON
        self.setState(state)

    def _stime2int(self, stime):
        h, m = stime.split(':')
        h, m = map(str.strip, (h, m))
        h, m = map(int, (h, m))
        return h * 60 + m

    def setState(self, new_state):
        if new_state == self.state:
            return
        self.state = new_state
        lmanager.setState(self.targetNodes, new_state, self.id)

    def onLeaveWorld(self):
        BigWorld.cancelCallback(self._hundle_timer)
        lmanager.destroyLights([ udo.guid for udo in self.targetNodes ])
        self.model = None
        return