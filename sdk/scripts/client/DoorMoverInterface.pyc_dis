# Embedded file name: ./client/DoorMoverInterface.py
from door_mover_object import *

class DoorMoverInterface:

    def __init__(self):
        self.door_mover = DoorMover(self.on_end)

    def play_animation(self, reverse = False, to_static = None):
        if not self.state_poses:
            return
        self._play_animation_by_speed(reverse, to_static)

    def on_end(self):
        pass

    def _stop_animation_by_speed(self):
        if self._loop_cid:
            BigWorld.cancelCallback(self._loop_cid)
            self._loop_cid = 0

    def _play_animation_by_speed(self, reverse = False, to_static = None):
        self._stop_animation_by_speed()
        door_states = self.door_mover.get_door_states(self)
        door_params = self.door_params if hasattr(self, 'door_params') else {}
        self.door_mover.set_mover_data(door_states, door_params)
        if to_static:
            self.door_mover.stop()
        elif reverse:
            self.door_mover.backplay()
        else:
            self.door_mover.play()
        self._move_loop()

    def _to_stop(self):
        if not self.door_mover.is_play:
            return True

    _loop_cid = 0

    def _move_loop(self):
        if self.isDestroyed:
            return
        if self._to_stop():
            print '[WARNING] stop loop', self
            return
        matrix = self.door_mover.update_move_tick()
        if not matrix:
            print '[WARNING] stop loop. not matrix', self
            return
        scale_matrix = Matrix()
        scale_matrix.setScale((self.scale, self.scale, self.scale))
        matrix.preMultiply(scale_matrix)
        self.door_model.setWorldTransform(matrix)
        self._loop_cid = BigWorld.callback(LOOP_INTERVAL, self._move_loop)