# Embedded file name: ./client/CueModelUtills.py
import BigWorld
import ResMgr
from utils import Singlton
import json
CUE_CONFIG_PATH = 'scripts/common/data/cue_model_config.json'

class CueModelUtills(Singlton):
    cue_data = {}
    cue_data_1 = {}

    def initialization(self):
        self.load_cue_data()

    def load_cue_data(self):
        try:
            if self.cue_data:
                return
            py_data_section = ResMgr.openSection(CUE_CONFIG_PATH)
            self.cue_data = json.loads(py_data_section.asBinary, encoding='utf-8')
        except:
            print 'error file:', repr(CUE_CONFIG_PATH)

    def get_cue_data(self, model_name, cue_name = None):
        if not self.cue_data:
            return self.load_cue_data()
        elif not self.cue_data:
            return None
        else:
            if cue_name:
                try:
                    return self.cue_data.get(model_name)[cue_name]
                except KeyError as e:
                    print 'MODEL_CUE_ERROR:: model:[{0}] has no cue:[{1}] in config:[{2}]'.format(model_name, cue_name, CUE_CONFIG_PATH)
                    return None

            return self.cue_data.get(model_name)