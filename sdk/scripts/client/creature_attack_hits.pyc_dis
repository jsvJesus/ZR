# Embedded file name: ./client/creature_attack_hits.py
import FX
import traceback
import BigWorld
from functools import partial
from Math import Matrix, Vector3

class CreatureAttackHits:

    def __init__(self):
        pass

    def initAttackTransportCues(self, transport_hit_sfx):
        if not self.model:
            return
        for cue_name, conf in transport_hit_sfx.items():
            try:
                self.model.cue(str(cue_name), partial(self._onCueHit, cue_name, conf))
            except:
                print 'ERROR create cue %r' % cue_name, self, self.model.sources
                traceback.print_exc()

    def clearCueHits(self, transport_hit_sfx):
        if not self.model:
            return
        else:
            for cue_name in transport_hit_sfx:
                try:
                    self.model.cue(cue_name, None)
                except:
                    print 'ERROR clear cue %r' % cue_name, self, self.model.sources
                    traceback.print_exc()

            return

    def _onCueHit(self, cue_name, conf):
        if not self.attack_active_target_id:
            return
        viktim = BigWorld.entity(self.attack_active_target_id)
        if viktim.__class__.__name__ != 'Tank':
            return
        for node_name in conf['nodes']:
            tmp_model = BigWorld.Model('')
            tmp_model.position = self._gePositionHitTransport(node_name)
            self.addModel(tmp_model)
            BigWorld.callback(10.0, partial(self.__clear_tmp_model, tmp_model))
            sfx_path = str(conf['sfx'])
            FX.bufferedOneShotEffect(sfx_path, tmp_model)

    def _gePositionHitTransport(self, node_name):
        node = self.model.node(node_name)
        pos = Matrix(node).translation
        if not pos:
            return self.position
        v = Vector3()
        v.setPitchYaw(0, self.yaw)
        dist = 2.5
        res = BigWorld.collide(self.spaceID, pos, pos + v * dist)
        if res:
            pos = res[0]
        return pos

    def __clear_tmp_model(self, tmp_model):
        if self.isDestroyed:
            return
        self.delModel(tmp_model)