def switchConsolePython():
    if BigWorld.getWatcher('Debug/activeConsole') == 'Python':
        BigWorld.setWatcher('Debug/activeConsole', '')
    else:
        BigWorld.setWatcher('Debug/activeConsole', 'Python')


