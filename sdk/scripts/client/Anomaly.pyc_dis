def set_debug_mode(status):
    global DEBUG
    DEBUG = status
    for e in BigWorld.entities.values():
        if isinstance(e, Anomaly):
            e._update_debug_text()
            if DEBUG:
                e._show_debug()
            else:
                e._hide_debug()


_QUEST_ANOMALITES = []

class Anomaly(BigWorld.Entity, AnomalyCommon, Damager, RadiationSource, PostProcessZoneInterface):
    """\xd0\xa1\xd1\x83\xd1\x89\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c-\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbb\xd0\xb8\xd1\x8f \xd0\xbd\xd0\xb0 \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb5."""
