    @if_not_destroyed
    def drawBoxPickup(self, box_type, box_status):
        if not self.model:
            return
        else:
            anim_name = BoxStatus.get_anim_by_type(box_type)
            self.playAnimation(getattr(self.model, anim_name, None))
            self.pushTrackerLockByName('drawBoxPickup', 'Belly-Belly2-PistolHolster', lock_track_head=True, print_error=False)

            def onLoadModel(prereqs):
                if self.isDestroyed:
                    return
                self._using_attach_model = prereqs.produce(0)
