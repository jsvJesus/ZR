class UsingItemAnimation:

    def __init__(self):
        self._playing_animation_item = False
        self.__dealyed_timer = 0
        self._need_enable_look = False
        self._in_hand_model_left = None
        self._in_hand_model_right = None
        self._using_item_action_name = ''
        self._playing_animation_device = False
        self._playing_animation_loot = False
        self._playing_animation_loot_cam_pos = False
        self.__current_action = None
        self._anim_callback_id = None
        self._anim_on_cancel_callback = None
        self._anim_action_in = None
        self._anim_action_loop = None
        self._anim_action_out = None
        self._using_attach_model = None
        self._usingItemSound = None
        self.__tmp_time = time.time()
        return

    def onPostModelChange(self):
        self.popTrackerLock('drawStartThrowGrenade')
        self.is_throwing = False

    def _playLoopedUseItemSound(self, sound_path, delay = 0.0):
        self._stopLoopedUseItemSound()
        self._usingItemSound = sounds.getSound(sound_path, model=self.model)
        if not self._usingItemSound:
            return

        def play():
            if self.isDestroyed:
                return
            if not self._usingItemSound:
                return
            self._usingItemSound.play()
            self._sound_dealy_id = 0

        self._sound_dealy_id = BigWorld.callback(delay, play)

    def _stopLoopedUseItemSound(self):
        if getattr(self, '_sound_dealy_id', None):
            BigWorld.cancelCallback(self._sound_dealy_id)
        self._sound_dealy_id = 0
        if self._usingItemSound:
            self._usingItemSound.stop()
            self._usingItemSound.releaseSound()
        self._usingItemSound = None
        return

    @property
    def item_animation(self):
        return self._playing_animation_item

    @if_not_destroyed
    def drawUsingItemAnimation(self, item_type, duration, on_target = False):
        if not self.model:
            return
        else:
            itemParam = ItemsCatalog.GetItemParam(item_type)
            if not itemParam:
                return
            if hasattr(self, 'usingGesture') and not self.isSitting():
                self.stopAnimation()
            hands = itemParam.get('Action_model_in_hands', False)
            self.model.ThrowRight = None
            self.model.ThrowLeft = None
            self._in_hand_model_left = None
            self._in_hand_model_right = None
            self._using_item_action_name = ''
            self.__wait_models = {}
            self.__tmp_time = time.time()

            def onLoaModelInHand(var_name, _model_path, model, fetch_id):
                if self.isDestroyed:
                    return
                if not model:
                    print '\ndrawUsingItemAnimation ERRORO LOAD MODEL', _model_path, self
                    traceback.print_exc()
                if not self.__wait_models:
                    return
                setattr(self, var_name, model)
                del self.__wait_models[var_name]
                if not self.__wait_models:
                    self._continueDrawUsingItemAnimation(item_type, duration, on_target)

            if hands:
                if LEFT_HAND in hands and hands.get(LEFT_HAND):
                    _model = hands.get(LEFT_HAND)
                    self.__wait_models['_in_hand_model_left'] = BigWorld.fetchModelWithID(_model, partial(onLoaModelInHand, '_in_hand_model_left', _model))
                if RIGHT_HAND in hands and hands.get(RIGHT_HAND):
                    _model = hands.get(RIGHT_HAND)
                    self.__wait_models['_in_hand_model_right'] = BigWorld.fetchModelWithID(_model, partial(onLoaModelInHand, '_in_hand_model_right', _model))
            if not self.__wait_models:
                self._continueDrawUsingItemAnimation(item_type, duration, on_target)
            return

    @if_not_destroyed
    def _continueDrawUsingItemAnimation(self, item_type, duration, on_target = False):
        if not self.model:
            return
        else:
            itemParam = ItemsCatalog.GetItemParam(item_type)
            if on_target:
                action_name = itemParam.get('Action_anim_action_on_target', None)
            else:
                action_name = itemParam.get('Action_anim_action', None)
            if not action_name and ItemsCatalog.EFFECTS_RECIPE in itemParam.get('Effect', []):
                action_name = ['use_craft_in', 'use_craft_loop', 'use_craft_out']
            _blocked = itemParam.get('Action_movement_block', False)
            if _blocked:
                self.setControlLockByEffect(Constants.ControlLockTypes.USE_ITEM, duration)
            action = None
            if action_name and isinstance(action_name, list):
                self._using_item_action_name = action_name[1]
                self.playListAnimations(action_name, duration, self.stopUsingItemAnimation)
            else:
                if action_name and hasattr(self.model, action_name):
                    action = getattr(self.model, action_name, None)
                if action:
                    self._using_item_action_name = action_name
                    self.playAnimation(action, duration, self.stopUsingItemAnimation, stretch=True, on_cancel_callback=self.stopUsingItemAnimation)
                else:
                    self.stopUsingItemAnimation()
                    return
                if action_name and not action:
                    print 'ERROR Play animation', action_name, 'using item', item_type, self
            if self._using_item_action_name:
                self.pushTrackerLockByName('drawUsingItemAnimation', 'Belly-Belly2-PistolHolster', lock_track_head=True, print_error=False)
            self._playing_animation_item = True
            self.flashlight_suspend()
            return

    @if_not_destroyed
    def stopUsingItemAnimation(self):
        self.removeControlLockByEffect(Constants.ControlLockTypes.USE_ITEM)
        self.stopAnimation()
        self.setUsingItem(False)
        self.__wait_models = {}
        self._playing_animation_item = False
        self._in_hand_model_left = None
        self._in_hand_model_right = None
        self._using_item_action_name = ''
        if self._using_attach_model:
            try:
                self.model.node('HP_Lhand').detach(self._using_attach_model)
            except:
                print '\nerror for', self, self.model, self._using_attach_model
                print self._using_attach_model.inWorld, self._using_attach_model.sources
                traceback.print_exc()

            self._using_attach_model = None
        self.popTrackerLock('drawUsingItemAnimation')
        if not self.model:
            return
        else:
            self.model.ThrowRight = None
            self.model.ThrowLeft = None
            if self.is_dead():
                return
            if self.usingGesture and not self.isSitting():
                self.playAnimationByIDInList(self.usingGesture)
            else:
                self.CancelAction(0)
                self.onUseAnyHandActionEnd()
                self.returnModelToDefault()
            return

    @property
    def binoculars_animation(self):
        return self._playing_animation_device

    def _onBinocularIn(self, *e):
        self.onBinocularsActivate(True)

    def _onBinocularOut(self, *e):
        self.popTrackerLock('BINOCULAR')
        self.onBinocularsAnimation(False)
        self.model.ThrowLeft = None
        self.model.cue('ItemToHand', None)
        self.model.cue('onThrowItem', None)
        self._playing_animation_device = False
        return

    def _drawBinocularsAnimationStart(self):
        self._playing_animation_device = True
        self.onBinocularsAnimation(True)
        self.pushTrackerLockByName('BINOCULAR', weapon_to='Belly-Belly2-PistolHolster', lock_track_head=True)
        if not self.model:
            return

        def onItemToHand(*e):
            self.model.ThrowLeft.visible = True

        def onThrowItem(*e):
            if self.model.ThrowLeft:
                self.model.ThrowLeft.visible = False

        self.model.cue('ItemToHand', onItemToHand)
        self.model.cue('onThrowItem', onThrowItem)

        def on_load(prereqs):
            if self.isDestroyed:
                return
            if not self.binoculing:
                return
            model = prereqs.produce(0)
            try:
                self.model.ThrowLeft = model
                self.model.use_binocular_in(0, self._onBinocularIn, False, -1, -1, 60).use_binocular_loop()
                self.model.ThrowLeft.visible = False
            except:
                print self, repr(DeviceModelPath[BINOCULARS])
                traceback.print_exc()

        utils_async.load_model(DeviceModelPath[BINOCULARS], on_load)

    @if_not_destroyed
    def _drawBinocularsAnimationStop(self):
        if self.isDestroyed:
            return
        if not self.model:
            self._playing_animation_device = False
            return
        self.onBinocularsActivate(False)
        self.model.use_binocular_out(0, self._onBinocularOut)

    def setBinocularsAnimation(self, value):
        if self.isDestroyed:
            return
        if value:
            self._drawBinocularsAnimationStart()
        else:
            self._drawBinocularsAnimationStop()
        self.onBinocularsAction(value)

