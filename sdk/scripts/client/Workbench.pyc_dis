# Embedded file name: ./client/Workbench.py
import BigWorld
import Math
from Helpers.Caps import CAP_OPEN_WORKBENCH
import WorkbenchUtil
from rep_utils import Bonus

class Workbench(BigWorld.Entity):
    """" client/Workbench """

    def __init__(self):
        self.height = 1.0
        self.name = ''
        BigWorld.Entity.__init__(self)
        self.targetCaps = [CAP_OPEN_WORKBENCH]

    def prerequisites(self):
        return [WorkbenchUtil.get_model_path(self.workbenchType)]

    def onLoadModel(self, model):
        if self.isDestroyed:
            return

    def onEnterWorld(self, prereqs):
        modelname = WorkbenchUtil.get_model_path(self.workbenchType)
        self.model = prereqs[modelname]
        self.model.isObstacle = True
        self.height = Math.Matrix(self.model.bounds).get(1, 1)
        self.name = WorkbenchUtil.get_local_name(self.workbenchType)
        self.targetFullBounds = True

    def check_clan_id_dynamic1(self, result):
        raise NotImplementedError

    def can_use_personal(self, callback):
        if self.group_id:

            def got_bonus(rep_id, bonus_id, result):
                callback(result)

            BigWorld.player().get_repbonus_dynamic1 = got_bonus
            BigWorld.player().base.get_repbonus_dynamic0(Bonus.Workbench, self.group_id)
        else:

            def got_clan_id(result):
                callback(result)

            self.check_clan_id_dynamic1 = got_clan_id
            BigWorld.player().cell.check_clan_id_dynamic0(self.id)

    def get_sound(self):
        return WorkbenchUtil.get_sound(self.workbenchType)

    def onLeaveWorld(self):
        self.model = None
        return