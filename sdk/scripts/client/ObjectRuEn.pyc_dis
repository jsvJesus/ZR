# Embedded file name: ./client/ObjectRuEn.py
import BigWorld
import Localization

class ObjectRuEn(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.filter = BigWorld.NoneFilter()

    @property
    def current_model(self):
        if Localization.get_global_language() == 'russian':
            return self.model_ru
        return self.model_en

    def prerequisites(self):
        return [self.current_model]

    def onEnterWorld(self, prereqs):
        self.model = prereqs[self.current_model]
        self.model.isObstacle = self.isObstacle

    def onLeaveWorld(self):
        self.model = None
        return