# Embedded file name: ./client/Bullets/EnviroCollision.py
from Items import ItemsCatalog
import BigWorld
import SFXer
from Math import Vector3
from SfxCatalog import RICOCHET_INTERACTION as RI
from SfxCatalog import PIERCE_INTERACTION as PI
from SfxCatalog import Mat, IGNORE_SFX_MATERIAL
from BWBallistic import SfxType
DEBUG_DIST = False

def set_debug_dist(value):
    global DEBUG_DIST
    DEBUG_DIST = value
    if not DEBUG_DIST:
        gi = BigWorld.getGeometricInstance()
        if getattr(BigWorld, '_enviro_collision_lineid', 0):
            gi.remove(BigWorld._enviro_collision_lineid)


def _world_interaction_reflect_sfx(point, tri, material, ammoID, entity):
    ammo_params = ItemsCatalog.GetItemParam(ammoID)
    category_name = ammo_params.get('HitSfxCategory') or 'Default'
    category = RI.get(category_name) or RI['Default']
    _, sfx_name = category.get(material) or category.get(Mat.Default) or ('Default', 'sfx/hits/default.xml')
    SFXer.Reflect(entity, point, tri, sfx_name)


def _world_interaction_pierce_sfx(material, triangle, point, entity):
    pierce_data = PI.get(material)
    if not pierce_data:
        return
    sfx_name = pierce_data[1]
    SFXer.Pierce(entity, sfx_name, triangle, point)


def _world_interaction_stuck_sfx(point, triangle, material, entity, ammoID):
    SFXer.Ricochet(entity, None, point, triangle, material, ammoID)
    return


def onEnviroCollision(tri, triNormal, material, point, sfxType, ammoID, entity):
    if DEBUG_DIST:
        _start_height = 1.48
        p0 = entity.position + Vector3(0, _start_height, 0)
        dist = p0.flatDistTo(point)
        msg = u'Bullet flight projection length={0:.2f} m. h={1:.2f} m.'.format(dist, point.y)
        BigWorld.player().systemMsgChat(msg)
        print '[DEBUG] %s ammo_type=%s point=%s' % (msg, ammoID, point)
        gi = BigWorld.getGeometricInstance()
        if getattr(BigWorld, '_enviro_collision_lineid', 0):
            gi.remove(BigWorld._enviro_collision_lineid)
        BigWorld._enviro_collision_lineid = gi.addLine(p0, point, (1, 1, 0, 1))
    if material == IGNORE_SFX_MATERIAL:
        return
    if sfxType == SfxType.REFLECT:
        _world_interaction_reflect_sfx(point, tri, material, ammoID, entity)
    elif sfxType == SfxType.PIERCE:
        _world_interaction_pierce_sfx(material, tri, point, entity)
    elif sfxType == SfxType.STUCK:
        _world_interaction_stuck_sfx(point, tri, material, entity, ammoID)


def onWaterCollision(waterPoint):
    BigWorld.player().drawWaterFire(waterPoint)