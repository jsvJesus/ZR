# Embedded file name: ./client/turn_avatar.py
import traceback
import new_turn

class TurnAvatar(object):
    turn_enabled = True
    _is_injured = True
    usingGesture = 0
    gesture_played_out = False
    npcSuit = None
    _new_turn = None
    control_locked = False
    lookingaround = False
    lookingaround_smooth = False

    def update_turn_states(self):
        """
        Method to update C++ turn object
        """
        if not self.model:
            return
        stopTurn = False
        footTwist = False
        if self.isImpactingPlayed() or self._draw_pickup:
            footTwist = True
            stopTurn = True
        if self.lookingaround:
            stopTurn = True
        if self.isToStayCrouchAnimPlayed:
            stopTurn = True
        if self.lookingaround_smooth:
            stopTurn = True
        if self._playing_animation_loot:
            stopTurn = True
        if self._interact_action_callback:
            stopTurn = True
        if self.control_locked:
            stopTurn = True
        if self.gesture_played_out:
            stopTurn = True
        if self.usingGesture and getattr(self, 'gesture_block_moving', True):
            stopTurn = True
        if self.dead:
            stopTurn = True
        if self.hoisting_flag:
            stopTurn = True
        if self.isGetupAnimationPlayed():
            stopTurn = True
        if self.is_interaction:
            stopTurn = True
            footTwist = True
        if self._new_turn:
            self._new_turn.lockYaw(stopTurn)
            self._new_turn.setState(self.IsAvatarBored(), self.IsAvatarCrouched(), footTwist)
            self._new_turn.setLookingAround(self.lookingaround)
            self._new_turn.setTorsoRollValue(self.torso_roll_value)

    def start_loop_turn(self):
        self.stop_loop_turn()
        if self.active_transform and self.active_transform.isCustomModel:
            return
        if self.transport_seat:
            return
        if self.model and not self.npcSuit:
            self._new_turn = new_turn.CppNewTurn(self)
            self.update_turn_states()

    def stop_loop_turn(self):
        if self._new_turn:
            self._new_turn.destroy()
            self._new_turn = None
        return

    def clearDebugLabels(self):
        pass

    def resetFootTwist(self):
        if self.isDestroyed:
            return
        if not self.model:
            return
        try:
            self.model.motors[0].resetFootTwist()
        except:
            traceback.print_exc()