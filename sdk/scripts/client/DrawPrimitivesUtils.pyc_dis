class PlayerPrimitives:

    def __init__(self):
        self.coroutine = None
        self.models = []
        return

    def add_primitive(self, p_type, size):
        if not size.isdigit():
            return False
        if p_type in ('0', 'sphere'):
            model_path = 'models/bolvan/helpers/test_sphere_wire.model'
        elif p_type in ('1', 'box'):
            model_path = 'models/bolvan/helpers/test_box_wire.model'
        else:
            return False
        model = BigWorld.Model(model_path)
        size = int(size)
        model.scale = (size, size, size)
        self.models.append(model)
        BigWorld.addModel(model)
        return True

    def run(self):
        if self.coroutine:
            return
        self.coroutine = self._run_coroutine()
        self.coroutine.run()

    @BWMemberCoroutine
    def _run_coroutine(self):
        while self.coroutine:
            position = BigWorld.player().position
            for m in self.models:
                m.position = position

            yield BWWaitForPeriod(0)

    def stop(self):
        if not self.coroutine:
            return
        else:
            self.coroutine.stop()
            self.coroutine = None
            map(BigWorld.delModel, self.models)
            self.models = []
            return


class SphereDrawer:
    """ \xd1\x80\xd0\xb8\xd1\x81\xd1\x83\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbe\xd1\x80\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x82\xd1\x8b """

    def __init__(self, capacity, scale):
        self.capacity = capacity
        self.scale = scale
        self.models = []
        self.remove_callback = BigWorld.callback(10.0, self.clear)

    def draw(self, position, scale = None, vector = None):
        BigWorld.cancelCallback(self.remove_callback)
        self.remove_callback = BigWorld.callback(10.0, self.clear)
        from functools import partial
        BigWorld.callback(0, partial(self._draw, position, scale, vector))

    def _draw(self, position, scale, vector):
        if len(self.models) >= self.capacity:
            BigWorld.delModel(self.models[0])
            del self.models[0]
        model = BigWorld.Model('models/bolvan/sphere.model')
        model.position = position
        if not scale:
            scale = self.scale
            model.newScaleTest = (scale, scale, scale)
            BigWorld.addModel(model)
            vector and gi.addLine(position, position + vector, (1, 1, 0, 1), True)
        self.models.append(model)

    def clear(self):
        try:
            map(BigWorld.delModel, self.models)
        except:
            import traceback
            traceback.print_exc()
        finally:
            self.models = []


def get_box_points(color = (1, 0, 0, 1)):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xb5\xd1\x80\xd1\x88\xd0\xb8\xd0\xbd\xd1\x8b \xd0\xba\xd1\x83\xd0\xb1\xd0\xb0 \xd0\xb2 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb5:
            Tuple of tuple(Vector3, Vector4) - verticles tuple of (pos, vertex_colour)
            \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0\xd1\x85 \xd1\x82\xd0\xb8\xd0\xbf\xd0\xb0 addWorldMesh \xd0\xb8 \xd0\xbf\xd1\x80.
    """
    return (((-0.5, -0.5, -0.5), color), ((-0.5, 0.5, -0.5), color), ((0.5, -0.5, -0.5), color))