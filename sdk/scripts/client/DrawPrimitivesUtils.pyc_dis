def draw_cilinder(position, radius, height, color = RED_COLOR, holder = gi, alwaysdraw = True):
    prev_result = None
    for i in xrange(5):
        internal_height = height * i / 4.0
        result = draw_circle_xz(position + (0, internal_height, 0), radius, color, holder=holder, alwaysdraw=alwaysdraw)
        if prev_result:
            for i in xrange(len(result)):
                holder.addLine(result[i], prev_result[i], color, alwaysdraw)

        prev_result = result

    return


