def draw_circle_xz(position, radius, color = RED_COLOR, holder = gi, alwaysdraw = True):
    result = []
    for i in xrange(8):
        pos1 = position + vertices_xz[i] * radius
        pos2 = position + vertices_xz[i - 1] * radius
        holder.addLine(pos1, pos2, color, alwaysdraw)
        result.append(pos1)

    return result


def draw_circle_xy(position, radius, color = RED_COLOR):
    result = []
    for i in xrange(8):
        pos1 = position + vertices_xy[i] * radius
        pos2 = position + vertices_xy[i - 1] * radius
        gi.addLine(pos1, pos2, color, True)
        result.append(pos1)

    return result


