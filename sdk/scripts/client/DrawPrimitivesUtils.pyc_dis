def draw_sphere(position, radius, color = RED_COLOR, holder = gi, alwaysdraw = True):
    lines_ids = []
    prev_result = None
    for i in xrange(1, 8):
        internal_radius = vertices_xy16[i].x * radius
        height = vertices_xy16[i].y * radius
        result = draw_circle_xz(position + (0, height, 0), internal_radius, color, holder=holder, alwaysdraw=alwaysdraw)
        if prev_result:
            for i in xrange(len(result)):
                lines_ids.append(holder.addLine(result[i], prev_result[i], color, alwaysdraw))

        prev_result = result

    return lines_ids


def draw_ray(position, direction, color = RED_COLOR, holder = gi):
    d = Vector3(direction)
    d.normalise()
    position2 = position + d * 10.0
    return holder.addLine(position, position2, color, True)


def draw_cone(pos, yaw, angle, near_plane, far_plane, disp, direction, color = RED_COLOR, holder = gi, alwaysdraw = True):
    lines_ids = []
    scale_matrix = Matrix()
    tan = math.tan(angle * 0.5)
    scale_matrix.setScale((far_plane * tan, far_plane, far_plane * tan))
    near_scale_matrix = Matrix()
    near_scale_matrix.setScale((near_plane * tan, near_plane, near_plane * tan))
    result_matrix = Matrix()
    near_result_matrix = Matrix()
    result_matrix.postMultiply(scale_matrix)
    near_result_matrix.postMultiply(near_scale_matrix)
    rotate_matrix = Matrix()
    rotate_matrix.setRotateYPR((yaw, 0, 0))
    disp = rotate_matrix.applyPoint(Vector3(disp))
    rotate_matrix2 = Matrix()
    rotate_matrix2.setRotateYPR((direction.yaw, direction.pitch + math.pi * 0.5, 0))
    origin_point = pos + disp
    translate_matrix = Matrix()
    translate_matrix.setTranslate(origin_point)
    result_matrix.postMultiply(rotate_matrix2)
    near_result_matrix.postMultiply(rotate_matrix2)
    result_matrix.postMultiply(translate_matrix)
    near_result_matrix.postMultiply(translate_matrix)
    vertices = [ result_matrix.applyPoint(vertex) for vertex in vertices_cone[:-8] ]
    vertices.extend([ near_result_matrix.applyPoint(vertex) for vertex in vertices_cone[-8:] ])
    for step in xrange(0, len(cone_indices), 2):
        p1 = vertices[cone_indices[step]]
        p2 = vertices[cone_indices[step + 1]]
        lines_ids.append(holder.addLine(p1, p2, color, alwaysdraw))

    return lines_ids


def DrawBBox(box, point, direction, color = None, holder = gi):
    transform = Matrix(box.worldTransform)

    def get_vector(vect):
        return transform.applyVector(vect)

    point00 = get_vector(Vector3(box.minBounds[0], box.minBounds[1], box.minBounds[2])) + transform.translation
    point01 = get_vector(Vector3(box.minBounds[0], box.minBounds[1], box.maxBounds[2])) + transform.translation
    point02 = get_vector(Vector3(box.minBounds[0], box.maxBounds[1], box.minBounds[2])) + transform.translation
    point03 = get_vector(Vector3(box.minBounds[0], box.maxBounds[1], box.maxBounds[2])) + transform.translation
    point10 = get_vector(Vector3(box.maxBounds[0], box.minBounds[1], box.minBounds[2])) + transform.translation
    point11 = get_vector(Vector3(box.maxBounds[0], box.maxBounds[1], box.minBounds[2])) + transform.translation
    point12 = get_vector(Vector3(box.maxBounds[0], box.minBounds[1], box.maxBounds[2])) + transform.translation
    point13 = get_vector(Vector3(box.maxBounds[0], box.maxBounds[1], box.maxBounds[2])) + transform.translation
    if not color:
        color = (random.random(),
         random.random(),
         random.random(),
         1)
    draw_line(point00, point10, color, holder=holder)
    draw_line(point01, point12, color, holder=holder)
    draw_line(point02, point11, color, holder=holder)
    draw_line(point03, point13, color, holder=holder)
    draw_line(point00, point01, color, holder=holder)
    draw_line(point03, point02, color, holder=holder)
    draw_line(point02, point00, color, holder=holder)
    draw_line(point03, point01, color, holder=holder)
    draw_line(point10, point11, color, holder=holder)
    draw_line(point13, point12, color, holder=holder)
    draw_line(point12, point10, color, holder=holder)
    draw_line(point13, point11, color, holder=holder)


