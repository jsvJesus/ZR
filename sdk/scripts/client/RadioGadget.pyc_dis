# Embedded file name: ./client/RadioGadget.py
from GadgetDevice import GadgetDevice
import ItemsUtils
import sounds_manager as sounds
from Items import ItemsCatalog
from Localization import lc
import ChatChannelConfig
CHANNEL_CONSTS = ChatChannelConfig.ChannelConsts()

class RadioGadget(GadgetDevice):
    SERVER_LOAD = 40

    def __init__(self, parent):
        GadgetDevice.__init__(self, parent)
        self.sounds_path = ''

    def switch(self, item_id, play_sound = True):
        if self._parent.is_dead():
            return
        item = ItemsUtils.GetComplexItemByID(self._parent, item_id)
        if not ItemsCatalog.GetItemParam(item['complexItemType']):
            item_subtype = {}.get('SubType')
            item_subtype == ItemsCatalog.RADIO_RECEIVER and not self._parent.have_radio_targent() and self._parent.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Inventory.client.NO_RADIO_TARGENT'))
            return
        self.update_sounds_path(item_id)
        GadgetDevice.switch(self, item_id, play_sound)

    def update_sounds_path(self, item_id = 0):
        if not item_id and not self._item:
            return
        if item_id:
            item = ItemsUtils.GetComplexItemByID(self._parent, item_id)
        else:
            item = self._item
        if not item:
            return
        self.sounds_path = ItemsCatalog.GetItemParam(item['complexItemType']).get('SoundsPath', '')
        if self.sounds_path:
            self.SOUND_SWITCH_ON = self.sounds_path + 'turn_on'
            self.SOUND_SWITCH_OFF = self.sounds_path + 'turn_off'

    def startUseRadio(self):
        if not self.is_working():
            return False
        if self.sounds_path:
            sounds.playSound(self.sounds_path + 'start')
        return True

    def stopUseRadio(self):
        if not self.is_working():
            return False
        if self.sounds_path:
            sounds.playSound(self.sounds_path + 'end')
        return True

    def work_start(self, *args, **kargs):
        GadgetDevice.work_start(self, *args, **kargs)
        self._parent.on_radio_switch(True)

    def work_stop(self, *args, **kargs):
        GadgetDevice.work_stop(self, *args, **kargs)
        self._parent.on_radio_switch(False)