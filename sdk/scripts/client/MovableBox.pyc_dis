# Embedded file name: ./client/MovableBox.py
import utils_bw
import BigWorld
import Constants
from Localization import lc
from BoxStatus import BoxStatus
from Helpers.Caps import CAP_INTERACT
from math_bw import get_triangle_normal
from soGUI.soInworldMarkers import soInworldMarker

class MovableBox(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._model_path = BoxStatus.get_model_by_type(self.box_type, 0)
        self.name = lc(BoxStatus.get_name_by_type(self.box_type))
        self.model = None
        self.callback_id = None
        self.targetCaps = []
        return

    def prerequisites(self):
        if self._model_path:
            return [self._model_path]
        return []

    def onEnterWorld(self, prereqs):
        if self._model_path:
            self.model = prereqs[self._model_path]
            self.model.scale = self.get_scale()
            self.model.newScaleTest = self.get_scale()
        self.setObstacle(self.visible)

    def get_scale(self):
        return (self.scale, self.scale, self.scale)

    def get_height(self):
        minB, maxB = self.model.getMinMaxbounds
        return (minB[1] + maxB[1]) * self.scale

    def can_interact(self):
        if not self.model:
            return False
        height = self.get_height()
        collision = utils_bw.collide(self.spaceID, self.position + (0, height + 0.1, 0), self.position)
        if collision:
            point, tri, _ = collision
            normal = get_triangle_normal(tri)
            if normal[1] < -0.1:
                return False
        return True

    def setObstacle(self, value):
        if self.model:
            self.model.isObstacle = value
            self.model.visible = value
        self.update_targetCaps()

    def onLeaveWorld(self):
        self.model = None
        return

    def update_targetCaps(self):
        self.targetCaps = [CAP_INTERACT] if self.visible else []

    def interact(self, player):
        if not self.can_interact():
            return
        player.pickup_box(self)

    def get_target_mark(self, distance):
        if not self.can_interact():
            return None
        elif self.visible and self.get_hightlight(distance):
            return soInworldMarker.MARKER_USE
        else:
            return None

    def get_hightlight(self, distance):
        if not self.can_interact():
            return None
        elif not self.visible or distance > self.get_interaction_dist():
            return None
        else:
            return True

    def get_interaction_dist(self):
        return 9

    def set_visible(self, old_value):
        self.setObstacle(self.visible)