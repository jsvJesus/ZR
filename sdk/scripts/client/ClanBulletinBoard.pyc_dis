# Embedded file name: ./client/ClanBulletinBoard.py
import BWPersonality
import BigWorld
import Math
from Localization import lc
from Helpers.Caps import CAP_INTERACT

class ClanBulletinBoard(BigWorld.Entity):
    """" client/BulletinBoard """
    DEFAULT_MODEL = 'models/entities/information_board_grouping/information_board_grouping_lod1.model'

    def __init__(self):
        self.height = 2.47
        BigWorld.Entity.__init__(self)
        self.targetCaps = [CAP_INTERACT]
        self.name = lc('soBulletinBoard.clanEntityName')

    def onLoadModel(self, model):
        if self.isDestroyed:
            return
        self.model = model
        if self.model:
            self.model.isObstacle = True
        self.height = Math.Matrix(self.model.bounds).get(1, 1) if model else 1.0

    def onEnterWorld(self, prereqs):
        BigWorld.fetchModel(self.DEFAULT_MODEL, self.onLoadModel)
        self.targetFullBounds = True

    def onLeaveWorld(self):
        self.model = None
        return

    def interact(self, player):
        BWPersonality.GUICore.clans_win.show()