# Embedded file name: ./client/Helpers/Autoquester.py
import ChatChannelConfig
import QuesterConsts
import BigWorld
import ResMgr
import json
import utils
import os
import BWPersonality
import time
from Math import Vector3
CHANNEL_CONSTS = ChatChannelConfig.ChannelConsts()
from Helpers.BWCoroutine import BWCoroutine, BWMemberCoroutine, BWWaitForCoroutine, BWWaitForCondition, BWCoroutineTimeoutException, BWWaitForPeriod
import ItemsUtils
import Quest
import Helpers.Caps

class Autoquester:
    instance = None
    internal_file_name = 'scripts/client/data/questtest.json'

    @staticmethod
    def start_debug(config_name):
        if Autoquester.instance:
            Autoquester.show_error(u'\u041f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0430\u044f \u043e\u0442\u043b\u0430\u0434\u043a\u0430 \u0435\u0449\u0451 \u043d\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0435\u043d\u0430')
            return
        Autoquester(config_name)

    @staticmethod
    def show_message(text):
        BigWorld.player().putMessage(CHANNEL_CONSTS.SYSTEM, text)

    @staticmethod
    def show_error(text, stop_execution = True):
        if Autoquester.instance and stop_execution:
            Autoquester.instance.stop_execution = stop_execution
        if Autoquester.instance:
            Autoquester.instance.error_list.append(text)
        text = u"<font color='#ff0000'>{0}</font>".format(text)
        Autoquester.show_message(text)

    @staticmethod
    def show_warning(text):
        text = u"<font color='#ffff00'>[Warning] {0}</font>".format(text)
        Autoquester.show_message(text)

    @staticmethod
    def show_report(text):
        text = u"<font color='#03a5cb'>{0}</font>".format(text)
        Autoquester.show_message(text)

    def __init__(self, config_name):
        dir_path = os.path.join(utils.stalker_path(), 'usercontent/debug')
        file_name = 'questtest.json'
        dst_path = os.path.join(dir_path, file_name)
        if os.path.exists(dst_path):
            f = open(dst_path)
            try:
                json_text = json.load(f)
            except:
                Autoquester.show_error(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u044c \u0444\u0430\u0439\u043b \u0432 json')
                return

            f.close()
        else:
            ResMgr.purge(Autoquester.internal_file_name)
            source = ResMgr.openSection(Autoquester.internal_file_name)
            try:
                json_text = json.loads(source.asBinary)
            except:
                Autoquester.show_error(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u044c \u0444\u0430\u0439\u043b \u0432 json')
                return

        if not json_text.has_key(config_name):
            Autoquester.show_error(u'\u041d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u0430 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f ' + config_name)
            return
        Autoquester.instance = self
        self.stop_execution = False
        self.error_list = []
        Autoquester.start(self, json_text[config_name]).run()

    @BWCoroutine
    def start(self, events_list):
        """ \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba \xd1\x82\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f """
        start_time = time.time()
        Autoquester.show_message(u'\u041e\u0442\u043b\u0430\u0434\u043a\u0430 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0430')
        for event in events_list:
            yield BWWaitForCoroutine(self.start_event(self, event))
            if self.stop_execution:
                break

        Autoquester.show_report(u'\u041e\u0442\u043b\u0430\u0434\u043a\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0430, \u0432\u0440\u0435\u043c\u044f \u043e\u0442\u043b\u0430\u0434\u043a\u0438 {0} \u0441\u0435\u043a'.format(int(time.time() - start_time)))
        if self.error_list:
            Autoquester.show_report(u'\u0411\u044b\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0438:')
            errors = list(self.error_list)
            for error in errors:
                Autoquester.show_error(error, False)

        else:
            Autoquester.show_report(u'\u041e\u0448\u0438\u0431\u043e\u043a \u043d\u0435 \u0431\u044b\u043b\u043e')
        Autoquester.instance = None
        return

    @BWCoroutine
    def start_event(self, event):
        """ \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba \xd0\xbe\xd1\x82\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f """
        processed = True
        if isinstance(event, dict):
            if 'start_dialog' in event:
                yield BWWaitForCoroutine(self.start_dialog(event['start_dialog']))
            elif 'start_dialog_trigger' in event:
                yield BWWaitForCoroutine(self.start_dialog_trigger(event['start_dialog_trigger']))
            elif 'wait_for_period' in event:
                yield BWWaitForPeriod(event['wait_for_period'])
            elif 'teleport' in event:
                yield BWWaitForCoroutine(self.teleport(self, event['teleport']))
            elif 'reputation' in event:
                yield BWWaitForCoroutine(self.reputation(self, event['reputation']))
            elif 'ef' in event:
                yield BWWaitForCoroutine(self.effect(self, event['ef']))
            elif 'karma' in event:
                yield BWWaitForCoroutine(self.karma(self, event['karma']))
            elif 'item' in event:
                yield BWWaitForCoroutine(self.get_item(self, event['item']))
            elif 'check_quest_status' in event:
                yield BWWaitForCoroutine(self.check_quest_status(self, event['check_quest_status']))
            elif 'questget' in event:
                yield BWWaitForCoroutine(self.questget(self, event['questget']))
            elif 'questcancel' in event:
                yield BWWaitForCoroutine(self.questcancel(self, event['questcancel']))
            elif 'questfail' in event:
                yield BWWaitForCoroutine(self.questfail(self, event['questfail']))
            elif 'questcomplete' in event:
                yield BWWaitForCoroutine(self.questcomplete(self, event['questcomplete']))
            elif 'hungry' in event:
                yield BWWaitForCoroutine(self.hungry(self, event['hungry']))
            elif 'thirst' in event:
                yield BWWaitForCoroutine(self.thirst(self, event['thirst']))
            elif 'cycle' in event:
                yield BWWaitForCoroutine(self.cycle(self, event['cycle'], event['count']))
            elif 'activate_trigger' in event:
                yield BWWaitForCoroutine(self.activate_trigger(self, event['activate_trigger']))
            elif 'run_console_command' in event:
                BWPersonality.GUICore.chatConsole.run_command(event['run_console_command'])
                yield BWWaitForPeriod(0.1)
            else:
                processed = False
        elif type(event) in [str, unicode]:
            yield BWWaitForCoroutine(self.click_replica(event))
        elif isinstance(event, list):
            if len(event) == 1 and event[0] == 'close_dialog':
                yield BWWaitForCoroutine(self.close_dialog(self))
            if len(event) == 1 and event[0] == 'wipeplayer':
                yield BWWaitForCoroutine(self.wipeplayer(self))
            else:
                processed = False
        else:
            processed = False
        if not processed:
            Autoquester.show_error(u'unsupported command: ' + unicode(event), False)

    @BWCoroutine
    def activate_trigger(self, trigger_name):
        trigger_name = unicode(trigger_name)
        from TriggerObject import TriggerObject
        trigger = [None]

        def filter_trigger():
            trigger[0] = filter(lambda t: isinstance(t, TriggerObject) and t.name == trigger_name, BigWorld.entities.values())
            return bool(trigger[0])

        try:
            yield BWWaitForCondition(filter_trigger, 3.0, 0.5)
        except BWCoroutineTimeoutException:
            Autoquester.show_error(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0442\u044c \u0442\u0440\u0438\u0433\u0433\u0435\u0440')
            return

        trigger = trigger[0][0]
        if Helpers.Caps.CAP_CAN_USE not in trigger.targetCaps:
            Autoquester.show_error(u'\u041d\u0435\u043b\u044c\u0437\u044f \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0442\u0440\u0438\u0433\u0433\u0435\u0440')
            return
        else:
            trigger.cell.activate()
            return

    @BWCoroutine
    def cycle(self, commands, repeat_count):
        for _ in xrange(repeat_count):
            for command in commands:
                yield BWWaitForCoroutine(self.start_event(self, command))

    @BWCoroutine
    def thirst(self, value):
        BWPersonality.GUICore.chatConsole.run_command('thirst ' + str(value))
        try:
            yield BWWaitForCondition(lambda : abs(BigWorld.player().thirst - value) < 0.05, 3.0, 0.5)
        except BWCoroutineTimeoutException:
            Autoquester.show_error(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0436\u0430\u0436\u0434\u0443')
            return

