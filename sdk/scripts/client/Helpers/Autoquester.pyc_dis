    def hungry(self, value):
        BWPersonality.GUICore.chatConsole.run_command('hungry ' + str(value))
        try:
            yield BWWaitForCondition(lambda : abs(BigWorld.player().hungry - value) < 0.05, 3.0, 0.5)
        except BWCoroutineTimeoutException:
            Autoquester.show_error(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0433\u043e\u043b\u043e\u0434')
            return

    @BWCoroutine
    def wipeplayer(self):
        BWPersonality.GUICore.chatConsole.run_command('wipemeplease')

        def player_wiped():
            p = BigWorld.player()
            if p.CarryingItems:
                return False
            if list(p.client_quests.get_all()):
                return False
            if BWPersonality.GUICore.inventoryDataSection['money'][0]:
                return False
            return True

        try:
            yield BWWaitForCondition(player_wiped, 3.0, 0.5)
        except BWCoroutineTimeoutException:
            Autoquester.show_error(u'\u0412\u0430\u0439\u043f \u0438\u0433\u0440\u043e\u043a\u0430 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0441\u044f')
            return

    @BWCoroutine
    def questcomplete(self, value):
        BWPersonality.GUICore.chatConsole.run_command('questcomplete ' + str(value))
        try:
            yield BWWaitForCondition(lambda : int(value) in self.p.client_quests.get_closed(), 3.0, 0.5)
        except BWCoroutineTimeoutException:
            Autoquester.show_warning(u'\u041e\u0431\u0440\u0430\u0442\u043d\u043e\u0439 \u0441\u0432\u044f\u0437\u0438 \u043e\u0442 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u043a\u0432\u0435\u0441\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043e\u0448\u0438\u0431\u043a\u0430.')
            return

    @BWCoroutine
    def questfail(self, value):
        BWPersonality.GUICore.chatConsole.run_command('questfail ' + str(value))
        try:
            yield BWWaitForCondition(lambda : int(value) in self.p.client_quests.get_failed(), 3.0, 0.5)
        except BWCoroutineTimeoutException:
            Autoquester.show_warning(u'\u041e\u0431\u0440\u0430\u0442\u043d\u043e\u0439 \u0441\u0432\u044f\u0437\u0438 \u043e\u0442 \u043f\u0440\u043e\u0432\u0430\u043b\u0430 \u043a\u0432\u0435\u0441\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043e\u0448\u0438\u0431\u043a\u0430.')
            return

    @BWCoroutine
    def questcancel(self, value):
        BWPersonality.GUICore.chatConsole.run_command('questcancel ' + str(value))
        was_in_journal = int(value) in self.p.client_quests.get_opened()
        error = False
        if was_in_journal:
            try:
                yield BWWaitForCondition(lambda : int(value) not in self.p.client_quests.get_opened(), 3.0, 0.5)
            except BWCoroutineTimeoutException:
                error = True

        else:
            yield BWWaitForPeriod(3.0)
            error = True
        if error:
            Autoquester.show_warning(u'\u041e\u0431\u0440\u0430\u0442\u043d\u043e\u0439 \u0441\u0432\u044f\u0437\u0438 \u043e\u0442 \u043e\u0442\u043c\u0435\u043d\u044b \u043a\u0432\u0435\u0441\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043e\u0448\u0438\u0431\u043a\u0430.')

    @BWCoroutine
    def questget(self, value):
