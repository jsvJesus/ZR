# Embedded file name: ./client/Helpers/AvatarModelAlign.py
from Math import Matrix
import BigWorld
ALIGN_COEF = 0.9
ALIGN_MIN = 0.0053
CHECK_PERIOD = 2.0
FIX_PERIOD = 0.01

class AvatarModelAlign:
    _align_timer = 0

    def onEnterWorld(self, *e):
        if self._align_timer:
            BigWorld.cancelCallback(self._align_timer)
        self._align_timer = BigWorld.callback(1.0, self._align_vertical_model)

    def onLeaveWorld(self, *e):
        if self._align_timer:
            BigWorld.cancelCallback(self._align_timer)
            self._align_timer = 0

    def _align_vertical_model(self):
        delay = CHECK_PERIOD
        if self.model:
            cur_matr = Matrix(self.model.matrix)
            fix_matr = Matrix()
            pitch = cur_matr.pitch * ALIGN_COEF
            roll = cur_matr.roll * ALIGN_COEF
            if abs(roll) < ALIGN_MIN and abs(pitch) < ALIGN_MIN:
                pitch = roll = 0.0
            else:
                delay = FIX_PERIOD
            fix_matr.setRotateYPR((cur_matr.yaw, pitch, roll))
            if cur_matr.scale[0] < 0.95 or cur_matr.scale[0] > 1.05:
                mc = Matrix()
                mc.setScale(cur_matr.scale)
                fix_matr.preMultiply(mc)
            fix_matr.translation = cur_matr.translation
            self.model.setWorldTransform(fix_matr)
        self._align_timer = BigWorld.callback(delay, self._align_vertical_model)