KEY_ALIAS_CONTROL = (Keys.KEY_LCONTROL, Keys.KEY_RCONTROL)
KEY_ALIAS_ALT = (Keys.KEY_LALT, Keys.KEY_RALT)
KEY_ALIAS_SHIFT = (Keys.KEY_LSHIFT, Keys.KEY_RSHIFT)
KEY_ALIAS_WINDOWS = (Keys.KEY_LWIN, Keys.KEY_RWIN)
keyAliases = {'CONTROL': KEY_ALIAS_CONTROL,
 'ALT': KEY_ALIAS_ALT,
 'SHIFT': KEY_ALIAS_SHIFT,
 'WINDOWS': KEY_ALIAS_WINDOWS,
 'CTRL': KEY_ALIAS_CONTROL,
 '-': (Keys.KEY_MINUS,),
 '=': (Keys.KEY_EQUALS,),
 '~': (Keys.KEY_GRAVE,),
 '>': (Keys.KEY_PERIOD,),
 '<': (Keys.KEY_COMMA,),
 '/': (Keys.KEY_SLASH,),
 '[': (Keys.KEY_LBRACKET,),
 ']': (Keys.KEY_RBRACKET,),
 ';': (Keys.KEY_SEMICOLON,),
 "'": (Keys.KEY_APOSTROPHE,),
 '\\': (Keys.KEY_BACKSLASH,)}
key_names = {'MOUSE0': 'LEFTMOUSE',
 'MOUSE2': 'MIDDLEMOUSE',
 'LCONTROL': 'CTRL',
 'RCONTROL': 'CTRL',
 'CONTROL': 'CTRL',
 'LALT': 'ALT',
 'RALT': 'ALT',
 'LSHIFT': 'SHIFT',
 'RSHIFT': 'SHIFT',
 'LWIN': 'WINDOWS',
 'RWIN': 'WINDOWS',
 'GRAVE': '~',
 'MINUS': '-',
 'EQUALS': '=',
 'PERIOD': '>',
 'COMMA': '<',
 'SLASH': '/',
 'LBRACKET': '[',
 'RBRACKET': ']',
 'SEMICOLON': ';',
 'APOSTROPHE': "'",
 'BACKSLASH': '\\'}

def _stringToKey(key):
    if key in keyAliases:
        return keyAliases[key]
    else:
        return BigWorld.stringToKey(key)


def _keyToString(key):
    try:
        key_name = _reverseKeysLookup[key]
        return key_names.get(key_name, key_name)
    except KeyError:
        return ''


def _isKeyDown(key):
    if type(key) is tuple:
        for k in key:
            if BigWorld.isKeyDown(k):
                return True

    else:
        return BigWorld.isKeyDown(key)


def _keyInKeyList(key, keyList):
    for k in keyList:
        if type(k) is tuple:
            return _keyInKeyList(key, k)
        if k == key:
            return True

    return False


def BWKeyBindingAction(actionName, *args, **kargs):

    def addActionName(actionName, actionFunction):
        if not hasattr(actionFunction, '_BWKeyBindingActionNames'):
            actionFunction._BWKeyBindingActionNames = []
        actionFunction._BWKeyBindingActionNames += [(actionName, args, kargs)]
        return actionFunction

    return partial(addActionName, actionName)


class BWActionHandler(object):

    def __init__(self):
        self.setupActionList()

    def setupActionList(self):
        entityClass = self.__class__
        self.actionFunctions = {}
        for name, function in entityClass.__dict__.items():
            actionNames = hasattr(function, '_BWKeyBindingActionNames') and function._BWKeyBindingActionNames
            if not callable(function):
                raise AssertionError
                function = getattr(self, name)
                for actionName, args, kargs in actionNames:
                    self.actionFunctions[actionName] = partial(getattr(self, name), *args, **kargs)


class BWKeyBindings():

    def __init__(self):
        self.actionsByBinding = {}
        self.actionsByName = {}
        self.handlers = []
        self.human_friendly_names = {}
        self.__hook_handler = None
        self._getFriendlyNames()
        return

    def _getFriendlyNames(self):
        ds = ResMgr.openSection('scripts/client/data/actions_display_names.xml')
        for actionDS in ds.values():
            self.human_friendly_names[actionDS._internal_name.asString] = lc(actionDS._display_name.asString)

    def readInDefaultKeyBindings(self, dataSection):
        self.actionsByName = {}
        for index, actionDataSection in enumerate(dataSection.values()):
            actionBinding = _ActionBinding()
            actionBinding.readFromDataSection(actionDataSection)
            actionName = actionBinding.actionName
            displayName = actionName.encode('utf-8')
            if self.human_friendly_names.has_key(actionName):
                displayName = self.human_friendly_names[actionName]
            actionBinding.displayName = displayName
            actionBinding.number = index
            self.actionsByName[actionName] = actionBinding

    def JSON_readInPreferenceKeyBindings(self, jDict):
        for actionName, bindingstr in jDict.iteritems():
            actionBinding = _ActionBinding()
            actionBinding.readFromJSON(actionName, bindingstr)
            if self.actionsByName.has_key(actionName):
                self.actionsByName[actionName].addPreferenceKeyBindings(actionBinding)

    def readInPreferenceKeyBindings(self, dataSection):
        for actionDataSection in dataSection.values():
            actionBinding = _ActionBinding()
            actionBinding.readFromDataSection(actionDataSection)
            actionName = actionBinding.actionName
            actionKeys = ((),)
            if len(actionBinding.bindings) > 0:
                actionKeys = actionBinding.bindings[0]
            if self.actionsByName.has_key(actionName):
                self.actionsByName[actionName].addPreferenceKeyBindings(actionBinding)

    def JSON_getKeyBindingsDict(self):
        d = {}
        for action_name, action in self.actionsByName.items():
            string = action.getBindingString()
            if string is not None:
                d[action_name] = string

        return d

    def writePreferenceKeyBindings(self, dataSection):
        dataSection.deleteSection('keyBindings')
        dataSection.createSection('keyBindings')
        keyBindingsSection = dataSection._keyBindings
        for action in self.actionsByName.values():
            action.writePreferenceKeyBindings(keyBindingsSection)

    def addHandler(self, handler):
        if handler not in self.handlers:
            self.handlers.append(handler)

    def removeHandler(self, handler):
        if handler in self.handlers:
            self.handlers.remove(handler)

    def buildBindList(self):
        self.actionsByBinding = {}
        for action in self.actionsByName.values():
            for binding in action.getBindings():
                if not self.actionsByBinding.has_key(binding):
                    self.actionsByBinding[binding] = []
                self.actionsByBinding[binding] += [action.actionName]

        self.bindList = []
        for downKeys, actionNames in self.actionsByBinding.items():
            notDownLists = []
            for otherDownKeys, otherActionNames in self.actionsByBinding.items():
                if actionNames != otherActionNames:
                    containedEntirely = 1
                    for key in downKeys:
                        containedEntirely = containedEntirely and key in otherDownKeys

                    if containedEntirely:
                        notDownList = []
                        for otherKey in otherDownKeys:
                            if otherKey not in downKeys:
                                notDownList.append(otherKey)

                        notDownLists.append(notDownList)

            for actionName in actionNames:
                if len(downKeys) > 1:
                    self.bindList.insert(0, (downKeys, notDownLists, actionName))
                else:
                    self.bindList.append((downKeys, notDownLists, actionName))

        for entity in self.handlers:
            if getattr(entity, 'onBindCallback', None):
                entity.onBindCallback(self)

        return

    def printBindList(self):
        bindListByName = {}
        for downKeys, notDownKeysList, actionName in self.bindList:
            if bindListByName.has_key(actionName):
                bindListByName[actionName] += [(downKeys, notDownKeysList)]
            else:
                bindListByName[actionName] = [(downKeys, notDownKeysList)]

        actionNames = sorted(bindListByName.keys())
        for actionName in actionNames:
            for downKeys, notDownKeysList in bindListByName[actionName]:
                print actionName, ':',
                for downKey in downKeys:
                    print _keyToString(downKey),

                if len(notDownKeysList) > 0:
                    if len(notDownKeysList) == 1:
                        print 'but not',
                        for notDownKey in notDownKeysList[0]:
                            print _keyToString(notDownKey),

                    else:
                        print 'but not any of {',
                        for notDownKeys in notDownKeysList:
                            print '[',
                            for notDownKey in notDownKeys:
                                print _keyToString(notDownKey),

                            print ']',

                        print '}',
                print

    def getKeyBindForAction(self, action):
        key_str = ''
        use_key = 'no use_key'
        try:
            use_key = self.getBindingsForAction(action)
            if use_key:
                list_key = list(use_key[0])
                list_key.sort()
                for index, key in enumerate(list_key):
                    if index:
                        key_str = ' + ' + key_str
                    key_str = self.checkKeyCode(key) + key_str

        except:
            print 'getKeyBindForAction', repr(use_key)
            traceback.print_exc()

        return key_str

    def checkKeyCode(self, keys):
        if isinstance(keys, tuple):
            use_key = keys[0]
        elif isinstance(keys, int):
            use_key = keys
        key_code_string = BigWorld.keyToString(use_key)
        return key_names.get(key_code_string, key_code_string)

    def getBindingsForAction(self, actionName):
        if self.actionsByName.has_key(actionName):
            return self.actionsByName[actionName].getBindings()
        else:
            return []

    def parse_actions_and_replace(self, text, colorise = False):
        """ \xd0\xbf\xd0\xb0\xd1\x80\xd1\x81\xd0\xb8\xd1\x82 \xd1\x8d\xd0\xba\xd1\x88\xd0\xb5\xd0\xbd\xd1\x8b \xd0\xb2 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5 {actionname} \xd0\xb8 \xd0\xb7\xd0\xb0\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb8\xd1\x85 \xd0\xb1\xd0\xb0\xd0\xb9\xd0\xbd\xd0\xb4\xd0\xb0\xd0\xbd\xd1\x83\xd1\x82\xd1\x8b\xd0\xbc\xd0\xb8 \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x88\xd0\xb0\xd0\xbc\xd0\xb8 """
        try:
            found_subs = re.findall('\\{\\S*?\\}', text)
            for sub in found_subs:
                sub_content = sub[1:-1]
                action = self.actionsByName.get(sub_content)
                if not action:
                    continue
                insertion = self.getKeyBindForAction(sub_content)
                if colorise:
                    insertion = cc.active_xml + insertion + '<basecolor>'
                text = text.replace(sub, insertion)

        except:
            traceback.print_stack()
            traceback.print_exc()

        return text

    def getBrKeyNameBindingsByActionName(self, actionName):
        FIRST_KEY = 0
        keys = [ k[FIRST_KEY] for k in self.getBindingsForAction(actionName) ]
        if keys:
            text = '[{0}]'.format(', '.join(map(_keyToString, keys)))
            return text
        else:
            return ''

    def isDownBrKeyByActionName(self, actionName):
        FIRST_KEY = 0
        keys = [ k[FIRST_KEY] for k in self.getBindingsForAction(actionName) ]
        if keys:
            return all([ _isKeyDown(key) for key in keys ])

    def addBindingForAction(self, actionName, binding):
        binding = tuple(sorted(binding))
        if actionName not in self.actionsByName:
            ERROR_MSG("Action '%s' is unknown" % (actionName,))
            return
        action = self.actionsByName[actionName]
        bindings = action.getBindings()
        if binding in bindings:
            ERROR_MSG("Action '%s' already has the binding %s" % (actionName, binding))
            return
        return action.addBinding(binding)

    def removeBindingForAction(self, actionName, binding):
        binding = tuple(sorted(binding))
        if actionName not in self.actionsByName:
            ERROR_MSG("Action '%s' is unknown" % (actionName,))
            return
        action = self.actionsByName[actionName]
        bindings = action.getBindings()
        if binding not in bindings:
            ERROR_MSG("Action '%s' does not have the binding %s" % (actionName, binding))
            return
        return self.actionsByName[actionName].removeBinding(binding)

    def callActionByName(self, actionName, *args, **kargs):
        for entity in reversed(self.handlers):
            if entity.actionFunctions.has_key(actionName):
                ret = entity.actionFunctions[actionName](True, *args, **kargs)
                if ret != False:
                    break

    def callActionForKeyState(self, key, event):
        for downKeys, upKeySets, actionName in self.bindList:
            if _keyInKeyList(key, downKeys):
                okayToGo = 1
                for downKey in downKeys:
                    okayToGo = okayToGo and _isKeyDown(downKey)

                if okayToGo:
                    for upKeys in upKeySets:
                        allDown = True
                        for upKey in upKeys:
                            allDown = allDown and _isKeyDown(upKey)

                        okayToGo = okayToGo and not allDown

                if self._hook(actionName, okayToGo, event):
                    continue
                for entity in reversed(self.handlers):
                    if entity.actionFunctions.has_key(actionName):
                        ret = entity.actionFunctions[actionName](okayToGo, event)
                        if ret and len(downKeys) > 1 and okayToGo:
                            return
                        if ret != False:
                            break

    def _hook(self, actionName, okayToGo, event):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82 \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd0\xb9 action"""
        if self.__hook_handler:
            return self.__hook_handler.actionHook(actionName, okayToGo, event)

    def registerHook(self, handler):
        self.__hook_handler = handler

    def updateHook(self, handler):
        if self.__hook_handler:
            if self.__hook_handler.id == handler.id:
                self.registerHook(handler)
                return True
        return False

    def unregisterHook(self, handler):
        if self.__hook_handler == handler:
            self.clearHook()
            return True
        return False

    def clearHook(self):
        self.__hook_handler = None
        return

    def getActionForKeyState(self, key):
        for downKeys, upKeySets, actionName in self.bindList:
            if _keyInKeyList(key, downKeys):
                okayToGo = 1
                for downKey in downKeys:
                    okayToGo = okayToGo and _isKeyDown(downKey)

                if okayToGo:
                    for upKeys in upKeySets:
                        allDown = True
                        for upKey in upKeys:
                            allDown = allDown and _isKeyDown(upKey)

                        okayToGo = okayToGo and not allDown

                if okayToGo:
                    return actionName


class _ActionBinding():

    def __init__(self):
        self.actionName = ''
        self.displayName = u''
        self.bindings = ()
        self.defaultBindings = ()
        self.number = 0

    def readFromDataSection(self, dataSection):
        self.actionName = dataSection._name.asString
        if not dataSection.has_key('keys'):
            return
        keys = dataSection._keys.asString.split()
        keys = [ _stringToKey(key) for key in keys ]
        if 0 in keys:
            ERROR_MSG("Action '%s' is bound to one or more invalid keys" % (self.actionName,))
        if len(keys) > 0:
            self.bindings += (tuple(sorted(keys)),)
        self.defaultBindings = self.bindings

    def readFromJSON(self, actionName, keyString):
        self.actionName = actionName
        keys = keyString.split()
        keys = [ _stringToKey(key) for key in keys ]
        if 0 in keys:
            ERROR_MSG("Action '%s' is bound to one or more invalid keys %r %r" % (self.actionName, keyString, keys))
        if len(keys) > 0:
            self.bindings += (tuple(sorted(keys)),)
        self.defaultBindings = self.bindings

    def addPreferenceKeyBindings(self, preferenceBindings):
        if not self.actionName == preferenceBindings.actionName:
            raise AssertionError
            newBindings = sorted(preferenceBindings.getBindings())
            self.bindings = newBindings != sorted(self.defaultBindings) and tuple(newBindings)

    def getBindingString(self):
        if not len(self.bindings):
            return ''
        bind = self.bindings[0]
        default_bind = self.defaultBindings[0]
        if bind != default_bind:
            return ' '.join((_reverseKeysLookup[key] for key in self.bindings[0]))

    def writePreferenceKeyBindings(self, dataSection):
        if sorted(self.bindings) != sorted(self.defaultBindings):
            newDataSection = dataSection.createSection('action')
            newDataSection.writeString('name', self.actionName)
            for binding in self.bindings:
                bindingString = ''
                for key in binding:
                    bindingString += _reverseKeysLookup[key] + ' '

                newDataSection.writeStrings('keys', (bindingString.strip(),))

    def addBinding(self, binding):
        raise binding not in self.bindings or AssertionError
        self.bindings += (tuple(binding),)

    def removeBinding(self, binding):
        raise binding in self.bindings or AssertionError
        newBindings = list(self.bindings)
        newBindings.remove(binding)
        self.bindings = tuple(newBindings)

    def getBindings(self):
        return self.bindings


_reverseKeysLookup = {}

def _buildReverseKeysLookup():
    preferredSynonyms = ('NONE', 'LEFTMOUSE', 'RIGHTMOUSE', 'MIDDLEMOUSE')
    for name in preferredSynonyms:
        value = BigWorld.stringToKey(name)
        if value != 0 or name == 'NONE':
            _reverseKeysLookup[value] = name
        else:
            TRACE_MSG('Synonym "%s" is missing from BigWorlds key list' % (name,))

    for name in Keys.__dict__.keys():
        value = BigWorld.stringToKey(name[4:])
        if value == 0:
            continue
        if _reverseKeysLookup.has_key(value):
            if _reverseKeysLookup[value] not in preferredSynonyms:
                TRACE_MSG('Unexpected synonym for "%s": "%s"' % (_reverseKeysLookup[value], BigWorld.keyToString(value)))
        else:
            _reverseKeysLookup[value] = BigWorld.keyToString(value)

    for aliasName, aliasKeys in keyAliases.iteritems():
        _reverseKeysLookup[aliasKeys] = aliasName

    _reverseKeysLookup[312] = '~'


_buildReverseKeysLookup()