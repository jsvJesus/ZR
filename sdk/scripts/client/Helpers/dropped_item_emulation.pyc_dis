# Embedded file name: ./client/Helpers/dropped_item_emulation.py
import traceback
import ItemsUtils
import ResourceLoader
import utils_async
from Items import ItemsCatalog

class DroppedItemEmulation(object):
    """\xd0\x98\xd0\xbc\xd0\xb8\xd1\x82\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbd\xd0\xb5\xd1\x88\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xb2\xd0\xb8\xd0\xb4 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0, \xd0\xbf\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb6\xd0\xb4\xd1\x91\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xb0\xd0\xbd\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xb9"""

    def __init__(self, item_type, master, callback = None):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        self.item_type = item_type
        self.master = master
        self.model = None
        self.particles = None
        self.empty_model = None
        self.callback = callback
        self._create_model()
        return

    def get_model(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0."""
        return self.model

    def start_animation(self):
        """\xd0\x97\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0."""
        particle_name = self._getParticleName()
        if not particle_name:
            print particle_name, 'ERROR::failed to load particle_name'
            return

        def on_load(prereqs):
            if not self.master:
                return
            if self.master.isDestroyed:
                return
            self.empty_model = prereqs.produce(0)
            self.empty_model.position = self.model.position
            self.particles = prereqs.produce(1)
            try:
                self.master.model.root.attach(self.empty_model)
                self.empty_model.root.attach(self.particles)
                self.particles.force()
            except KeyError:
                print 'Error init dropped item, item type: {0}, particle name: {1}'.format(self.item_type, particle_name)
                traceback.print_stack()

            try:
                self.model.idle()
            except AttributeError:
                pass

        resource_list = ((ResourceLoader.MODEL, 'models/misc/particles/helper_attach.model'), (ResourceLoader.PARTICLE, particle_name))
        ResourceLoader.asyncLoad(resource_list, on_load)

    def stop_animation(self):
        """\xd0\x9e\xd1\x82\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb2\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x8d\xd1\x84\xd1\x84\xd0\xb5\xd0\xba\xd1\x82\xd1\x8b \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0."""
        if self.particles:
            self.particles.clear()
        try:
            if self.empty_model and self.particles:
                self.empty_model.root.detach(self.particles)
        except:
            traceback.print_exc()

        try:
            if self.empty_model:
                self.master.model.root.detach(self.empty_model)
        except:
            traceback.print_exc()

        try:
            if self.model:
                self.master.model.root.detach(self.model)
        except:
            traceback.print_exc()

        self.model = None
        self.empty_model = None
        self.particles = None
        self.master = None
        return

    def _create_model(self):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0."""

        def on_load(prereqs):
            if not self.master:
                return
            if self.master.isDestroyed:
                return
            self.model = prereqs.produce(0)
            self.model.position = self.master.position - (0, 0.1, 0)
            item_class = ItemsCatalog.GetItemClass(self.item_type)
            if item_class in [ItemsCatalog.ARTIFACT]:
                self.model.isObstacle = True
            if self.callback:
                self.callback(self.model)

        model_name = self._getModelName()
        self.name = ItemsUtils.GetItemName(self.item_type)
        if isinstance(model_name, list):
            utils_async.load_model_from_list(model_name, on_load)
        else:
            utils_async.load_model(model_name, on_load)

    def _getModelName(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x83\xd1\x82\xd1\x8c \xd0\xb4\xd0\xbe \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb8."""
        item_params = ItemsCatalog.GetItemParam(self.item_type)
        if item_params.has_key('OnFlorModel'):
            item_model = item_params['OnFlorModel']
        else:
            item_model = self._getModelNameByNamesDict(item_params['ModelNames'].values())
        return item_model

    def _getParticleName(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x83\xd1\x82\xd1\x8c \xd0\xb4\xd0\xbe \xd0\xbf\xd0\xb0\xd1\x80\xd1\x82\xd0\xb8\xd0\xba\xd0\xbb\xd0\xb5\xd0\xb9."""
        item_params = ItemsCatalog.GetItemParam(self.item_type)
        if item_params.has_key('ParticleName'):
            ps = item_params['ParticleName']
        else:
            ps = 'particles/item_light.xml'
        return ps

    def _getModelNameByNamesDict(self, names_dict):
        """????"""
        if names_dict:
            if len(names_dict) == 1:
                return names_dict[0]
            else:
                return names_dict
        else:
            return None
        return None