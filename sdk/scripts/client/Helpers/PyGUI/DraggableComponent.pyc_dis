        xoffset - \xd0\xba\xd0\xb0\xd0\xba\xd1\x83\xd1\x8e \xd0\xb4\xd0\xbe\xd0\xbb\xd1\x8e \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd1\x81\xd0\xbf\xd1\x80\xd1\x8f\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb7\xd0\xb0 \xd0\xba\xd1\x80\xd0\xb0\xd0\xb9 \xd0\xbf\xd0\xbe \xd0\xbe\xd1\x81\xd0\xb8 X,
        xoffset - \xd0\xba\xd0\xb0\xd0\xba\xd1\x83\xd1\x8e \xd0\xb4\xd0\xbe\xd0\xbb\xd1\x8e \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd1\x81\xd0\xbf\xd1\x80\xd1\x8f\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb7\xd0\xb0 \xd0\xba\xd1\x80\xd0\xb0\xd0\xb9 \xd0\xbf\xd0\xbe \xd0\xbe\xd1\x81\xd0\xb8 Y
                (1 - \xd0\xb2\xd0\xb5\xd1\x81\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82, 0 - \xd0\xbd\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x8f \xd1\x81\xd0\xb4\xd0\xb2\xd0\xb8\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c \xd0\xb7\xd0\xb0 \xd0\xba\xd1\x80\xd0\xb0\xd0\xb9).
        """
        self.horzDrag = horzDrag
        self.vertDrag = vertDrag
        self.restrictToParent = restrictToParent
        self.component.focus = True
        self.component.moveFocus = True
        self.component.crossFocus = True
        self.component.mouseButtonFocus = True
        self.component.moveFocus = True
        self.onBeginDrag = lambda : None
        self.onEndDrag = lambda : None
        self.onDragging = lambda : None
        xoffset = abs(xoffset)
        yoffset = abs(yoffset)
        self._xoffset = xoffset if xoffset <= 1 else 1
        self._yoffset = yoffset if yoffset <= 1 else 1

    def handleMouseButtonEvent(self, comp, event):
        key = event.key
        down = event.isKeyDown()
        if key in (Keys.KEY_LEFTMOUSE, Keys.KEY_MIDDLEMOUSE) and (self.horzDrag or self.vertDrag):
            if down:
                self.startDragging()
            elif dragManager.isDragging():
                self.stopDragging()
        return True

    def onSave(self, dataSection):
        dataSection.writeBool('horzDrag', self.horzDrag)
        dataSection.writeBool('vertDrag', self.vertDrag)
        dataSection.writeBool('restrictToParent', self.restrictToParent)

    def onLoad(self, dataSection):
        self.horzDrag = dataSection.readBool('horzDrag')
        self.vertDrag = dataSection.readBool('vertDrag')
        self.restrictToParent = dataSection.readBool('restrictToParent')

    def startDragging(self):
        dragManager.startDragging(self.component, self.horzDrag, self.vertDrag, self.restrictToParent, self._xoffset, self._yoffset)

    def stopDragging(self):
        dragManager.stopDragging()
        self.onBound()

    def restrictPosition(self):
        dragManager.restrictHorizontally(self._xoffset, self.component)
        dragManager.restrictVertically(self._yoffset, self.component)


def _horzAnchorOffset(component):
    if component.horizontalAnchor == 'LEFT':
        return 0
    if component.horizontalAnchor == 'CENTER':
        return component.width / 2.0
    if component.horizontalAnchor == 'RIGHT':
        return component.width


def _vertAnchorOffset(component):
    if component.verticalAnchor == 'TOP':
        return 0
    if component.verticalAnchor == 'CENTER':
        return component.height / 2.0
    if component.verticalAnchor == 'BOTTOM':
        return component.height


class ComponentDragManager:

    def __init__(self):
        self.component = None
        self.offset = (0, 0)
        self.horzDrag = False
        self.vertDrag = False
        self.restrictToParent = False
        self.xoffset = 0
        self.yoffset = 0
        return

    def isDragging(self):
        return self.component is not None

    def startDragging(self, component, horzDrag, vertDrag, restrictToParent, xoffset = 0, yoffset = 0):
        self.xoffset = xoffset
        self.yoffset = yoffset
        if self.component:
            print 'WARNING: startDragging called again without first calling stop!'
            self.stopDragging()
        self.horzDrag = horzDrag
        self.vertDrag = vertDrag
        self.restrictToParent = restrictToParent
        cpos = Utils.absoluteClipPosition(component)
        mpos = GUI.mcursor().position
        self.offset = Math.Vector2(mpos.x - cpos.x, mpos.y - cpos.y)
        if hasattr(component.script, 'dragProxy'):
            if component.script.dragProxy:
                self.component = component.script.dragProxy
                self.component.script = component.script
            else:
                self.component = None
                return
        else:
            self.component = component
        if restrictToParent:
            self.restrictHorizontally(self.xoffset)
            self.restrictVertically(self.yoffset)
        if hasattr(self.component.script, 'onBeginDrag'):
            self.component.script.onBeginDrag()
        return

    def stopDragging(self):
        if not self.component:
            print 'WARNING: stopDragging called without any component currently being dragged!'
        if self.component is not None:
            if hasattr(self.component.script, 'onEndDrag'):
                self.component.script.onEndDrag()
            Utils.roundComponentPos(self)
        self.component = None
        return

    def handleKeyEvent(self, down, key, mods):
        if key in (Keys.KEY_LEFTMOUSE, Keys.KEY_MIDDLEMOUSE) and not down and self.isDragging():
            if self.component.script:
                self.component.script.stopDragging()
            return True
        return False

    def handleMouseEvent(self, event):
        if self.component is None:
            return False
        elif not BigWorld.isKeyDown(Keys.KEY_LEFTMOUSE) and not BigWorld.isKeyDown(Keys.KEY_MIDDLEMOUSE) and self.isDragging():
            if self.component.script:
                self.component.script.stopDragging()
            return True
        else:
            if self.component.parent is None:
                self.offset = Math.Vector2(0, 0)
            mpos = GUI.mcursor().position
            cpos = Math.Vector2(mpos[0] - self.offset.x, mpos[1] - self.offset.y)
            nrp = Utils.nearestRelativeParent(self.component)
            while nrp is not None:
                nrpPos = Utils.legacyPosition(nrp)
                cpos.x = cpos.x - nrpPos.x
                cpos.y = cpos.y - nrpPos.y
                nrp = Utils.nearestRelativeParent(nrp)

            startPos = tuple(self.component.position)
            if self.horzDrag:
                horzMode = self.component.horizontalPositionMode
                self.component.horizontalPositionMode = 'LEGACY'
                self.component.position.x = cpos.x
                self.component.horizontalPositionMode = horzMode
                if self.restrictToParent:
                    self.restrictHorizontally(self.xoffset)
            if self.vertDrag:
                vertMode = self.component.verticalPositionMode
                self.component.verticalPositionMode = 'LEGACY'
                self.component.position.y = cpos.y
                self.component.verticalPositionMode = vertMode
                if self.restrictToParent:
                    self.restrictVertically(self.yoffset)
            draggedHorz = self.component.position.x != startPos[0]
            draggedVert = self.component.position.y != startPos[1]
            if not draggedHorz:
                dragged = draggedVert
                dragged and hasattr(self.component.script, 'onDragging') and self.component.script.onDragging()
                Utils.roundComponentPos(self)
            return True

    def restrictHorizontally(self, offset = 0, component = None):
        """\xd0\x9d\xd0\xb5 \xd0\xb4\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x82\xd0\xb0\xd1\x81\xd0\xba\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8c\xd1\x88\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 \xd1\x83\xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xb9 \xd0\xbf\xd0\xbe \xd0\xb3\xd0\xbe\xd1\x80\xd0\xb8\xd0\xb7\xd0\xbe\xd0\xbd\xd1\x82\xd0\xb0\xd0\xbb\xd0\xb8."""
        if not component:
            comp = self.component
            return comp is None and None
        else:
            horzMode = comp.horizontalPositionMode
            widthMode = comp.widthMode
            restricted = False
            comp.horizontalPositionMode = 'PIXEL'
            comp.widthMode = 'PIXEL'
            old_position = comp.position
            x, y, z = comp.position
            sW, _sH = BigWorld.screenSize()
            right_x_restrict = sW + offset * comp.width
            left_x_restrict = 0 - offset * comp.width
            x = get_coner_in_pixels(comp)['corner'][0]
            x = min(right_x_restrict - comp.width, max(left_x_restrict, x))
            comp.position = (x + _horzAnchorOffset(comp), y, z)
            if comp.position != old_position:
                restricted = True
            comp.horizontalPositionMode = horzMode
            comp.widthMode = widthMode
            return restricted

    def restrictVertically(self, offset = 0, component = None):
        """\xd0\x9d\xd0\xb5 \xd0\xb4\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x82\xd0\xb0\xd1\x81\xd0\xba\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8c\xd1\x88\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 \xd1\x83\xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xb9 \xd0\xbf\xd0\xbe \xd0\xb2\xd0\xb5\xd1\x80\xd1\x82\xd0\xb8\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8."""
        if not component:
            comp = self.component
            return comp is None and None
        else:
            vertMode = comp.verticalPositionMode
            heightMode = comp.heightMode
            restricted = False
            comp.verticalPositionMode = 'PIXEL'
            comp.heightMode = 'PIXEL'
            x, y, z = old_position = comp.position
            if comp.parent:
                parent_mode = comp.parent.heightMode
                comp.parent.heightMode = 'PIXEL'
                parent_height = comp.parent.height
                comp.parent.heightMode = parent_mode
            else:
                parent_height = BigWorld.screenHeight()
            bottom_y_restrict = parent_height + offset * comp.height
            top_y_restrict = 0 - offset * comp.height
            y = get_coner_in_pixels(comp)['corner'][1]
            y = min(bottom_y_restrict - comp.height, max(top_y_restrict, y))
            comp.position = (x, y + _vertAnchorOffset(comp), z)
            if comp.position != old_position:
                restricted = True
            comp.verticalPositionMode = vertMode
            comp.heightMode = heightMode
            return restricted


dragManager = ComponentDragManager()