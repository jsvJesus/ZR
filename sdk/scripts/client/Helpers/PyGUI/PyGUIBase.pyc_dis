    def onLoad(self, dataSection):
        if dataSection.has_key('toolTipInfo'):
            import ToolTip
            self.toolTipInfo = ToolTip.ToolTipInfo()
            self.toolTipInfo.onLoad(dataSection._toolTipInfo)

    def onSave(self, dataSection):
        if hasattr(self, 'toolTipInfo') and self.toolTipInfo is not None:
            toolTipInfoSection = dataSection.createSection('toolTipInfo')
            self.toolTipInfo.onSave(toolTipInfoSection)
        return

    def onBound(self):
        for name, child in self.component.children:
            if not child.script:
                child.script = PyGUIBase(child)
            raise isinstance(child.script, PyGUIBase) or AssertionError

        roundComponentPos(self)
        self._bindEvents(self.__class__)

    def _bindEvents(self, cls):
        for name, function in cls.__dict__.iteritems():
            if hasattr(function, '_PyGUIEventHandler'):
                for componentName, eventName, args, kargs in function._PyGUIEventHandler:
                    if not callable(function):
                        raise AssertionError
                        component = self.component
                        for name in componentName.split('.'):
                            component = getattr(component, name, None)
                            if component is None:
                                break

                        component is None and ERROR_MSG("PyGUIEvent: '%s' has no component named '%s'." % (str(self), componentName))
                        continue
                    function = getattr(self, function.__name__)
                    setattr(component.script, eventName, partial(function, *args, **kargs))

        for base in cls.__bases__:
            self._bindEvents(base)

        return

    def clearAllChildren(self, component):
        for name, child in component.children:
            if len(child.children) > 0:
                self.clearAllChildren(child)
                child.textureName = ''
                child.script = None
                component.delChild(child)
            else:
                child.textureName = ''
                child.script = None
                component.delChild(child)

        return

    def _unloadself(self):
        if self.component:
            self.component.textureName = ''
            self.component.script = None
            self.component = None
            self.eventHandler = None
        return


def get_layer(component):
    from soGUI.soGUILayer import soGUILayer
    if isinstance(component.script, soGUILayer):
        return component.script
    if component.parent:
        return get_layer(component.parent)


def get_component_size(component, mode = 'PIXEL'):
    prev_mode = (component.widthMode, component.heightMode)
    component.widthMode, component.heightMode = mode, mode
    width, height = component.width, component.height
    component.widthMode, component.heightMode = prev_mode
    return (width, height)


class DragWin(PyGUIBase, DraggableComponent):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True)
        component.script = self

    def is_visible(self):
        return self.component.visible

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)


class Interceptor(PyGUIBase):
    """ \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd1\x81\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f \xd0\xbc\xd1\x8b\xd1\x88\xd0\xb8 \xd0\xb8 \xd0\xbd\xd0\xb8\xd0\xba\xd0\xbe\xd0\xbc\xd1\x83 \xd0\xbd\xd0\xb5 \xd0\xbe\xd1\x82\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82
            \xd0\xbb\xd0\xb8\xd0\xb1\xd0\xbe \xd0\xbe\xd1\x82\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82 proxy
    """

    def __init__(self, component, intercept_buttons = True, intercept_moving = True, interscept_keys = False):
        PyGUIBase.__init__(self, component)
        self._proxy = None
        component.script = self
        self._intercept_buttons = intercept_buttons
        self._intercept_moving = intercept_moving
        self._intercept_keys = interscept_keys
        self.change_interseption()
        return

    def set_behaviours(self, behaviours):
        PyGUIBase.set_behaviours(self, behaviours)
        if WinBehaviour.need_intercept_buttons(self._behaviours):
            self.component.mouseButtonFocus = True
        if WinBehaviour.need_intercept_move(self._behaviours):
            self.component.dropFocus = True
            self.component.dragFocus = True
            self.component.crossFocus = True
            self.component.moveFocus = True
        if WinBehaviour.need_intersept_down(self._behaviours):
            self.component.focus = True

    def change_interseption(self, **kargs):
        """ \xd1\x82\xd0\xb5 \xd0\xb6\xd0\xb5, \xd1\x87\xd1\x82\xd0\xbe \xd0\xb2 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80\xd0\xb5 """
        self._intercept_buttons = kargs.get('intercept_buttons', self._intercept_buttons)
        self._intercept_moving = kargs.get('intercept_moving', self._intercept_moving)
        self._intercept_keys = kargs.get('interscept_keys', self._intercept_keys)
        self.component.mouseButtonFocus = self._intercept_buttons
        self.component.dropFocus = self._intercept_moving
        self.component.dragFocus = self._intercept_moving
        self.component.crossFocus = self._intercept_moving
        self.component.moveFocus = self._intercept_moving
        self.component.focus = self._intercept_keys

    def set_proxy(self, proxy):
        self._proxy = proxy

    def handleMouseButtonEvent(self, component, event):
        if self._intercept_buttons:
            if self._proxy:
                return self._proxy.handleMouseButtonEvent(component, event)
            return True
        if WinBehaviour.need_intercept_buttons(self._behaviours):
            return True
        return False

    def handleMouseEvent(self, component, event):
        if self._intercept_moving:
            if self._proxy:
                return self._proxy.handleMouseEvent(component, event)
            return True
        if WinBehaviour.need_intercept_move(self._behaviours):
            return True
        return False

    def handleKeyEvent(self, event):
        if self._intercept_keys:
            if event.key == KEY_SYSRQ and not event.modifiers:
                return False
            if self._proxy:
                return self._proxy.handleKeyEvent(event)
            return True
        if event.isKeyDown() and WinBehaviour.need_intersept_down(self._behaviours):
            return True
        return False