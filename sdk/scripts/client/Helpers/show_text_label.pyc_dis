# Embedded file name: ./client/Helpers/show_text_label.py
import BigWorld
import GUI
import Math
import traceback

def addText_Safe(position_or_matrix, text = u'txt', text_size = 0.1, pos_offset = (0, 0, 0)):
    if position_or_matrix.__class__.__name__ in ('Matrix',):
        position_or_matrix = Math.Matrix(position_or_matrix).translation
    BigWorld.callback(0, lambda : _onTick(lambda : addText(position_or_matrix, text=text, text_size=text_size, pos_offset=pos_offset)))


def resetAllText_Safe():
    player = BigWorld.player()
    if not player:
        return
    player.text_label_obj_safe_must_clear = True
    BigWorld.callback(0, lambda : _onTick(lambda : 0))


def _onTick(foo):
    player = BigWorld.player()
    if not player:
        return
    if hasattr(player, 'text_label_obj_safe_must_clear'):
        if player.text_label_obj_safe_must_clear:
            resetAllText()
    player.text_label_obj_safe_must_clear = False
    foo()


def resetAllText():
    player = BigWorld.player()
    if not player:
        return
    if not hasattr(player, 'list_text_label_obj'):
        player.list_text_label_obj = []
    for x in player.list_text_label_obj:
        x.destroy()

    player.list_text_label_obj = []


def addText(position_or_matrix, text = u'txt', text_size = 0.1, pos_offset = (0, 0, 0)):
    if position_or_matrix.__class__.__name__ in ('Matrix',):
        position_or_matrix = Math.Matrix(position_or_matrix).translation
    player = BigWorld.player()
    if not player:
        return
    if not hasattr(player, 'list_text_label_obj'):
        player.list_text_label_obj = []
    x = WorldText(position_or_matrix, text=text, text_size=text_size, pos_offset=pos_offset)
    player.list_text_label_obj.append(x)
    return x


class WorldText(object):
    """docstring for ClassName"""

    def __init__(self, position, text = u'txt', text_size = 0.1, pos_offset = (0, 0, 0)):
        self.position = Math.Vector3(position)
        self.text = text
        self.pos_offset = Math.Vector3(pos_offset)
        self.text_size = text_size
        self.model = BigWorld.Model('')
        self.model.position = self.position
        BigWorld.player().addModel(self.model)
        self.createText()

    def destroy(self):
        try:
            BigWorld.player().delModel(self.model)
        except:
            traceback.print_exc()

    def createText(self):
        getExplicitSize = lambda text, text_size: (round(len(text), 2) / 4 * text_size, text_size)
        self.model.visibleAttachments = True
        textnode = GUI.Text(self.text)
        textnode.explicitSize = True
        textnode.multiline = True
        textnode.size = getExplicitSize(self.text, self.text_size)
        textnode.colour = (255, 205, 149, 245)
        textnode.filterType = 'LINEAR'
        textnode.verticalAnchor = 'BOTTOM'
        textnode.position = (0, 0, 0)
        atch = GUI.Attachment()
        atch.component = textnode
        atch.faceCamera = True
        self.model.root.attach(atch)
        self.textnode = textnode


class AttachText(object):

    def __init__(self, bw_node, text = u'txt', text_size = 0.1, pos_offset = (0, 0, 0), fk = False):
        self.bw_node = bw_node
        self.text = text
        self.pos_offset = Math.Vector3(pos_offset)
        self.text_size = text_size
        self.fk = fk
        self.createText()

    def destroy(self):
        try:
            self.bw_node.detach(self.atch)
        except:
            traceback.print_exc()

        self.atch = None
        self.textnode = None
        self.bw_node = None
        return

    def createText(self):
        getExplicitSize = lambda text, text_size: (round(len(text), 2) / 4 * text_size, text_size)
        textnode = GUI.Text(self.text)
        textnode.explicitSize = True
        textnode.multiline = True
        textnode.size = getExplicitSize(self.text, self.text_size)
        textnode.colour = (255, 205, 149, 245)
        textnode.filterType = 'LINEAR'
        textnode.verticalAnchor = 'BOTTOM'
        textnode.position = self.pos_offset
        atch = GUI.Attachment()
        atch.component = textnode
        atch.faceCamera = self.fk
        self.bw_node.attach(atch)
        self.textnode = textnode
        self.atch = atch