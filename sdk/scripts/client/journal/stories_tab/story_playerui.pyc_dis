    def _on_player_event(self, event_type, data):
        self._update_content()

    def _on_play_click(self):
        self._player.add_listener(self._on_player_event)
        if self._player.State == StateType.Pause and self._story_id and self._story_id == self._player.story_id:
            self._player.unpause()
        else:
            self._player.play(self._story_id)

    def _on_repeat_click(self):
        self._player.stop()
        self._player.add_listener(self._on_player_event)
        self._player.play(self._story_id)

    def _on_pause_click(self):
        self._player.pause()

    def set_story_id(self, story_id):
        self._story_id = story_id
        self._player.remove_listener(self._on_player_event)
        if self._story_id and self._story_id == self._player.story_id:
            self._player.add_listener(self._on_player_event)
        self._update_content()

    def stop_background_tasks(self):
        self._player.stop()

    def get_running_story(self):
        return self._player.State == StateType.Play and self._player.story_id or None

    def _update_content(self):
        has_sound = bool(self._story_id and STORIES_DATA[self._story_id].get('Sound'))
        if not has_sound:
            self.component.visible = False
            return
        else:

            def calc_time():
                if not self._player.Ratio:
                    ratio = 0.0
                    time_text = None
                    time_remain = max(0, math.ceil(self._player.RemainTime or 0.0))
                    mins = int(time_remain / 60.0)
                    secs = int(time_remain - mins * 60.0)
                    time_text = (mins or secs) and u'{0:02d}:{1:02d}'.format(mins, secs)
                return (ratio, time_text)

            pip_alpha = 0.0
            time_text = None
            ratio = 1
            repeate_enabled = False
            self.component.visible = True
            if self._story_id and self._story_id == self._player.story_id:
                if self._player.State == StateType.Stopped:
                    self._player.remove_listener(self._on_player_event)
                    self._play_comp.visible = True
                    self._pause_comp.visible = False
                elif self._player.State == StateType.Pause:
                    self._play_comp.visible = True
                    self._pause_comp.visible = False
                    ratio, time_text = calc_time()
                    repeate_enabled = True
                elif self._player.State == StateType.Play:
                    self._play_comp.visible = False
                    self._pause_comp.visible = True
                    ratio, time_text = calc_time()
                    alpha = math.sin(self._player.twinkle_time * 5.0)
                    pip_alpha = alpha * alpha * 255
                    repeate_enabled = True
            else:
                self._play_comp.visible = True
                self._pause_comp.visible = False
            self._text.text = time_text or u'--:--'
            self._pip.colour[3] = pip_alpha
            self._filler.width = ratio * 2
            self._repeat_btn.enabled = repeate_enabled
            return