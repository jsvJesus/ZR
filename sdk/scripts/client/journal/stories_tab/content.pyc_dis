        comp.width, comp.height = self.component.width, 80
        comp.position = (0, self.component.height, 0.1)
        self._cut_container.addChild(comp)
        self._story_player = StoryPlayerUi(comp)
        self._item_data = None
        self._cur_listen_quest = None
        self._mode = Mode.Cut
        return

    def set_item_data(self, item_data):
        if not item_data:
            self.component.visible = False
        if self._item_data:
            if self._item_data._unique_id == (item_data and item_data._unique_id):
                return
            self._mode = Mode.Cut
            if self._item_data:
                self._item_data.del_callback_listener(self._on_itemdata_event)
            self._item_data = item_data
            self._item_data and self._item_data.add_callback_listener(self._on_itemdata_event)
        self._update_content()

    def update_item_data(self):
        self._update_content()

    def on_show(self):
        BWPersonality.GUICore.addListener('hlinkEvent', self._hlink_event)

    def on_hide(self):
        self._listen_quest(None)
        BWPersonality.GUICore.removeListener('hlinkEvent', self._hlink_event)
        self._story_renderer.set_story_id(None)
        self._story_player.set_story_id(None)
        return

    def _on_itemdata_event(self, event_type, data):
        if event_type == IdET.OnStoryindexChanged:
            self._update_content()

    def _hlink_event(self, event, data):
        if event != HyperLink.EVENT_CLICK:
            return
        value, interface_id = data
        if interface_id == self.LINK_INTERFACE_ID:
            self._item_data.story_index += int(value)
        elif interface_id == self.DETAILS_INTERFACE_ID:
            if self._mode == Mode.Cut:
                self._mode = Mode.Full
            elif self._mode == Mode.Full:
                self._mode = Mode.Cut
            self._update_content()

    def _update_content(self):
        self._quest_btn.component.visible = False
        if not self._item_data:
            self.component.visible = False
            return
        else:
            self.component.visible = True
            self._prev_link.component.visible = False
            self._prev_link_br.visible = False
            self._next_link.component.visible = False
            self._next_link_br.visible = False
            self._index_text.visible = False
            self._text_comp.visible = False
            self._not_found_text.visible = False
            has_story = True
            show_story_id = None
            if self._item_data.is_group:
                stories_count = self._item_data.stories_count
                if stories_count > 0:
                    story_index = self._item_data.story_index
                    group_story_id = self._item_data.group_story_id
                    if group_story_id not in self._user.get_active_stories():
                        has_story = False
                    show_story_id = group_story_id
                    self._index_text.visible = True
                    self._index_text.text = u'\u2116{0}/{1}'.format(story_index + 1, stories_count)
                    if story_index > 0:
                        t = lc('GUI.QuestLog.PREV_STORY') + u' \u2116{0}'.format(story_index)
                        text = u'<alignment=left><hlink={0};{1}>'.format(t, -1)
                        self._prev_link.setText(text, immidiate=True)
                        self._prev_link.component.visible = True
                        self._prev_link_br.visible = True
                    if story_index < stories_count - 1:
                        t = lc('GUI.QuestLog.NEXT_STORY') + u' \u2116{0}'.format(story_index + 2)
                        text = u'<alignment=right><hlink={0};{1}>'.format(t, 1)
                        self._next_link.setText(text, immidiate=True)
                        self._next_link.component.visible = True
                        self._next_link_br.visible = True
            else:
                show_story_id = self._item_data.story_id
            if has_story:
                self._story_renderer.set_story_id(show_story_id)
                self._story_player.set_story_id(show_story_id)
                if self._mode == Mode.Cut:
                    self._cut_container.visible = True
                    self._full_comp.visible = False
                    self._text_comp.visible = True
                    if self._story_player.component.visible:
                        desc_text = self._desc_text1
                        hide_text = self._desc_text5
                    else:
                        desc_text = self._desc_text5
                        hide_text = self._desc_text1
                    desc_text.component.visible = True
                    hide_text.component.visible = False
                    desc_text.setText(cc.active_xml + self._font_prefix + self._item_data.description, immidiate=True)
                    children = desc_text.component.textRendererPlane.children
                    if len(children) < len(desc_text.hMap) and children:
                        last_comp = children[-1][1]
                        last_comp.text = last_comp.text[:-3] + u'...'
                elif self._mode == Mode.Full:
                    self._cut_container.visible = False
                    self._full_comp.visible = True
                    self._desc_full.setText(cc.inactive_xml + self._font_prefix + self._item_data.description, immidiate=True)
                else:
                    raise RuntimeError
            else:
                self._not_found_text.visible = True
                self._story_renderer.set_story_id(None)
                self._story_player.set_story_id(None)
            self._item_data.set_story_read(show_story_id)
            quest_id = None
            if show_story_id:
                if not STORIES_DATA[show_story_id].get('OpenQuest'):
                    quest_id = None
                    self._quest_btn.component.visible = quest_id and True
                    self._quest_btn.setDisabledState(True)
            self._listen_quest(quest_id)
            return

    def _listen_quest(self, quest_id):
        if quest_id == self._cur_listen_quest:
            return
        if self._cur_listen_quest:
            self._user.unregister_quest_listener(self)
        self._cur_listen_quest = quest_id
        if self._cur_listen_quest:
            self._user.register_quest_listener(self, [self._cur_listen_quest])

    def on_quest_state_changed(self, quest_id, state):
        if quest_id != self._cur_listen_quest:
            return
        self._quest_btn.setDisabledState(state not in (Quest.STATE_ABSENT, Quest.STATE_FAILED))

    def stop_background_tasks(self):
        self._story_player.stop_background_tasks()

    def get_running_story(self):
        return self._story_player.get_running_story()

    def _on_quest_click(self):
        if self._item_data.is_group:
            story_id = self._item_data.group_story_id
        else:
            story_id = self._item_data.story_id
        self._user.request_story_quest0(story_id)
        self._quest_btn.setDisabledState(True)

    def get_shown_group_story(self):
        if not self._item_data:
            return None
        elif not self._item_data.is_group:
            return None
        else:
            return self._item_data.group_story_id

    @property
    def _user(self):
        return BigWorld.player()