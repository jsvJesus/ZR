# Embedded file name: ./client/journal/stories_tab/story_player.py
import BigWorld
from StoriesListenerCommon import STORIES_DATA
import sounds_manager
from utils import Listenable

class EventType:
    OnStateChanged, OnTimeChanged = range(2)


class StateType:
    Stopped, Play, Pause = range(3)


class StoryPlayer(Listenable):

    def __init__(self):
        Listenable.__init__(self)
        self._tick_handler = None
        self._sound = None
        self._story_id = None
        self._state = None
        self.twinkle_time = 0
        self.State = StateType.Stopped
        self._play_time = None
        return

    def play(self, story_id):
        self.stop()
        self._story_id = story_id
        if not self._story_id:
            return
        else:
            sound_name = story_id and STORIES_DATA[story_id].get('Sound') or None
            self._sound = sounds_manager.playSound(sound_name)
            self._sound.set_end_callback(self._sound_ended)
            self._start_tick()
            self.State = StateType.Play
            return

    def pause(self):
        self._stop_tick()
        self._sound.paused = True
        self.State = StateType.Pause

    def unpause(self):
        self._start_tick()
        self._sound.paused = False
        self.State = StateType.Play

    def stop(self):
        self.State = StateType.Stopped
        self._story_id = None
        self.PlayTime = None
        self._stop_tick()
        if self._sound:
            self._sound.stop()
            self._sound.set_end_callback(None)
            self._sound = None
        return

    def _sound_ended(self):
        self.stop()

    def _tick(self):
        if self.PlayTime is None:
            self.PlayTime = 0.0
        self.PlayTime += BigWorld.getTimeDelta()
        self.twinkle_time += BigWorld.getTimeDelta()
        self._tick_handler = None
        self._tick_handler = BigWorld.callback(0, self._tick)
        return

    def _start_tick(self):
        self._stop_tick()
        self._tick_handler = BigWorld.callback(0, self._tick)

    def _stop_tick(self):
        if self._tick_handler:
            BigWorld.cancelCallback(self._tick_handler)
            self._tick_handler = None
        return

    @property
    def PlayTime(self):
        return self._play_time

    @PlayTime.setter
    def PlayTime(self, value):
        if value == self._play_time:
            return
        self._play_time = value
        self.notify_listeners(EventType.OnTimeChanged)

    @property
    def RemainTime(self):
        if self._sound is None or self.PlayTime is None:
            return
        else:
            return self._sound.duration - self.PlayTime

    @property
    def Ratio(self):
        if self._sound is None or self.PlayTime is None:
            return
        else:
            return self.PlayTime / self._sound.duration

    @property
    def story_id(self):
        return self._story_id

    @property
    def State(self):
        return self._state

    @State.setter
    def State(self, value):
        if self._state == value:
            return
        else:
            prev_state = self._state
            self._state = value
            self.notify_listeners(EventType.OnStateChanged)
            self.twinkle_time = 0.0
            if self._state == StateType.Play:
                sounds_manager.playSound('ui/audionotes/play')
            elif prev_state not in (None, StateType.Pause):
                sounds_manager.playSound('ui/audionotes/stop')
            return