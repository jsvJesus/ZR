# Embedded file name: ./client/journal/stories_tab/stories_view.py
from view_comp import ViewComp, EventType as VcET
from journal.common_view.view import View

class EventType:
    OnItemClick, = xrange(1)


class StoriesView(View):

    def __init__(self, data_provider, callback_listener, component):
        View.__init__(self, data_provider, callback_listener, ViewComp, component)

    def _on_itemcomp_event(self, event_type, data):
        if event_type == VcET.OnClick:
            item_comp = data
            item_data = item_comp._item_data
            data_id = item_data.group_id if item_data.is_group else item_data.story_id
            data = {'unique_id': item_data._unique_id,
             'story_id': item_data.story_id,
             'data_id': data_id,
             'is_group': item_data.is_group}
            self._callback_listener(EventType.OnItemClick, data)

    def on_show(self, restore_state = None):
        View.on_show(self)
        if restore_state:
            height = restore_state.get('position')
            height and self._move_comp_items(height)

    def get_state(self):
        if not self._visible_items:
            return 0
        unique_id = self._visible_items[0]._item_data._unique_id
        index = self._dp._index_by_unique_id(unique_id)
        top_border = self._top_visible_border
        return {'position': -ViewComp.evaluate_height() * index + top_border}