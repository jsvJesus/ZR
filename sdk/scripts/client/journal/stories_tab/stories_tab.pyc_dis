# Embedded file name: ./client/journal/stories_tab/stories_tab.py
import BigWorld
import GUI
from Localization import lc
from journal.tab import Tab
from stories_view import StoriesView, EventType as ViewET
from stor_data_provider import StorDataProvider
from journal.sort_filter import SortFilter, EventType as SfET
from Quest import SortMode as SM
from soGUI.soTextField import soTextField3
import colorCodes as cc
from content import Content
from soGUI.soButton import soButton

class StoriesTab(Tab):

    def __init__(self, component):
        Tab.__init__(self, lc('GUI.QuestLog.DIARY_TAB_LABEL'), component)
        self._story_id_show_trigger = None
        comp = GUI.Frame2('soGUI/frame/con_frame_2.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.width, comp.height = (854, 526)
        comp.position = (3, 3, 1.1)
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (286, 520)
        comp.position = (6, 6, 0.5)
        self.component.addChild(comp, 'view')
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (853, 7, 0.4)
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (559, 518)
        self.component.addChild(comp, 'content_holder')
        comp = GUI.Frame2('soGUI/frame/con_frame_rounded.dds')
        comp.materialFX = 'BLEND'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.9)
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        self.component.content_holder.addChild(comp, 'frame')
        comp = GUI.Window()
        tf = soTextField3(comp, 300, 200, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.position = (0, -0.2, 0.9)
        comp.visible = False
        self.component.content_holder.addChild(comp)
        self._intro_comp = comp
        tf.setText(cc.inactive_xml + u'<font=RobotoCondensedRegular_20.font><alignment=center>' + lc('GUI.QuestLog.STOR_INTRO'), immidiate=True)
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.8)
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.content_holder.width, self.component.content_holder.height
        self.component.content_holder.addChild(comp, 'content')
        comp = GUI.Window()
        quest_btn = soButton(comp)
        quest_btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.width, comp.height = (160, 28)
        comp.position = (293, self.component.height - 8, 0.2)
        comp.label.text = lc('GUI.QuestLog.GET_QUEST')
        self.component.addChild(comp, 'quest_button')
        quest_btn.onBound()
        self._sort_filter = SortFilter(self.component, self, False, False, False)
        self._dp = StorDataProvider()
        self._view = StoriesView(self._dp, self._on_view_event, self.component.view)
        self._content = Content(self.component.content_holder.content, quest_btn)
        return

    def _on_view_event(self, event_type, data):
        if event_type == ViewET.OnItemClick:
            self._dp.set_selection(data['unique_id'])
            selected_item = self._dp.get_item(data['unique_id'])
            self._content.set_item_data(selected_item)
            self._intro_comp.visible = False

    def wants_show_priority(self):
        return bool(self._content.get_running_story() or BigWorld.player().peek_last_unseen_story())

    def is_playing_audio(self):
        return bool(self._content.get_running_story())

    def stop_background_tasks(self):
        self._content.stop_background_tasks()

    def on_sortfilter_event(self, event_type):
        if event_type == SfET.OnModeChanged:
            self._dp.set_sort_reverse(self._sort_filter._sort_mode == SM.TitleUp)
            self._content.set_item_data(self._dp.find_first_selection())

    def force_story(self, story_id):
        self._story_id_show_trigger = story_id

    def on_show(self):
        view_state = self._view.get_state()
        self._dp.clear()
        self._view.on_show(view_state)
        selected_item = self._dp.find_first_selection()
        if not self._content.get_running_story():
            if not self._story_id_show_trigger:
                story_id = BigWorld.player().pop_last_unseen_story()
                self._story_id_show_trigger = None
                if story_id:
                    running_item = self._dp._find_item_by_story_id(story_id)
                    if running_item:
                        selected_item.selected = selected_item and False
                    running_item.selected = True
                    if running_item.is_group:
                        for i, s_id in enumerate(BigWorld.player().get_group_stories(running_item.group_id)):
                            if s_id == story_id:
                                running_item.story_index = i
                                break

                    selected_item = running_item
            selected_item and self._content.set_item_data(selected_item)
            self._intro_comp.visible = False
        else:
            self._content.set_item_data(None)
            self._intro_comp.visible = True
        self._content.on_show()
        return

    def on_hide(self):
        self._view.on_hide()
        self._content.on_hide()
        self._content.set_item_data(None)
        return

    def on_got_new_stories(self, stor_ids):
        had_stories = bool(self._dp._data)
        self._dp.insert_new_stories(stor_ids)
        if not had_stories:
            selected_item = self._dp._data[0]
            self._dp.set_selection(selected_item._unique_id)
            self._content.set_item_data(selected_item)
            self._intro_comp.visible = False
        if self._content.get_shown_group_story() in stor_ids:
            self._content.update_item_data()

    def on_stories_wiped(self):
        self._dp.clear()