import BigWorld
import GUI
from soGUI.soButton import soButton
from stor_data_provider import IdET

class EventType:
    EmptyVisible, OnClick = xrange(2)


class ViewComp:
    bar_width = 17
    line_height = 20

    def __init__(self, component):
        self.component = component
        comp = GUI.Window()
        self._btn = soButton(comp)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.horizontalPositionMode = 'PIXEL'
        comp.label.horizontalAnchor = 'LEFT'
        comp.label.position[0] = 8
        comp.width, comp.height = self.component.width, ViewComp.line_height
        comp.position = (0, 0, 0.6)
        self._btn.onClick = self._on_click
        self._btn.setVisualState('normal')
        self._btn.onBound()
        self.component.addChild(comp, 'btn')
        comp = GUI.Simple('soGUI/GUIs/unscalable/event_circle.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (2, 0, 0.1)
        comp.materialFX = 'BLEND'
        comp.visible = False
        self.component.addChild(comp, 'pip')

    def _initialize(self, item_data, callback_listener):
        self._callback_listener = callback_listener
        self._item_data = item_data
        self._item_data.add_callback_listener(self._on_item_data_event)
        self._update_visual()

    def _on_click(self):
        self._callback_listener(EventType.OnClick, self)

    def _update_visual(self):
        if self._item_data.is_group:
            self._btn.initVSC('soGUI/elements/storyGroupListElement.xml')
        else:
            self._btn.initVSC('soGUI/elements/storyListElement.xml')
        if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and BigWorld.player().isAdminAccess():
            text = self._item_data.debug_text
        else:
            text = self._item_data.name
        self.component.btn.label.text = text
        toggled = self._item_data.selected
        self.component.btn.script.buttonActive = toggled
        self.component.btn.script.setToggleState(toggled)
        self.component.pip.visible = self._item_data.has_unread()

    def _on_item_data_event(self, event_type, data):
        if event_type in (IdET.OnSelectedChanged, IdET.OnReadChanged):
            self._update_visual()

    def on_destroy(self):
        self._item_data.del_callback_listener(self._on_item_data_event)
        self._callback_listener = None
        self._item_data = None
        return

    @staticmethod
    def get_component(item_data, callback_listener):
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = 270, ViewComp.evaluate_height()
        view_comp = ViewComp(comp)
        view_comp._initialize(item_data, callback_listener)
        return view_comp

    @staticmethod
    def evaluate_height():
        return ViewComp.line_height