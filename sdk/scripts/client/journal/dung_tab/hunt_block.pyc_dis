class LineEventType:
    OnTrackClick, OnUntrackClick, OnSpaceClick = range(3)


class Line:
    interface_id = 'journal.dungtab.huntblock'

    def __init__(self, component, listener):
        self._component = component
        self._listener = listener
        self._component.script = self
        self._next_click_time = 0
        self._click_handler = None
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (0, 0, 0)
        comp.colour = cc.active_rgba
        self._component.addChild(comp, 'name')
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (380, 0, 0)
        comp.colour = cc.active_rgba
        self._component.addChild(comp, 'online')
        tf = soTextField3(GUI.Window(), 300, 20, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        tf.INTERFACE_ID = Line.interface_id
        comp = tf.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (440, 0, 0)
        self._component.addChild(comp, 'space')
        comp = GUI.Window()
        y_pos = 0
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.width, comp.height = (22, 15)
        comp.position = (self._component.width - 60, y_pos, 0.5)
        btn = PaintButton(comp, visual_state='soGUI/frame/paint/eye_closed_toggle.xml')
        btn.do_reposition()
        btn.on_down = self._on_track_click
        self._component.addChild(comp)
        self.track_btn = btn
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.width, comp.height = (22, 15)
        comp.position = (self._component.width - 60, y_pos, 0.5)
        btn = PaintButton(comp, visual_state='soGUI/frame/paint/eye_toggle.xml')
        btn.do_reposition()
        btn.on_down = self._on_untrack_click
        self._component.addChild(comp)
        self.untrack_btn = btn
        return

    def _check_click_time(self, foo):
        """ \xd0\xb7\xd0\xb0\xd1\x89\xd0\xb8\xd1\x82\xd0\xb0 \xd0\xbe\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xba\xd0\xbb\xd0\xb8\xd0\xba\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f """
        if self._click_handler:
            BigWorld.cancelCallback(self._click_handler)
            self._click_handler = None
        if BigWorld.time() < self._next_click_time:
            self._click_handler = BigWorld.callback(BigWorld.time() - self._next_click_time + 0.1, foo)
            return False
        else:
            self._next_click_time = BigWorld.time() + 1
            return True

    def _on_untrack_click(self):
        data = {'wanted': self._data['name']}
        self.untrack_btn.component.visible = False
        self.track_btn.component.visible = True
        if self._check_click_time(self._on_untrack_click):
            self._listener(LineEventType.OnUntrackClick, data)

    def _on_track_click(self):
        data = {'wanted': self._data['name']}
        self.untrack_btn.component.visible = True
        self.track_btn.component.visible = False
        if self._check_click_time(self._on_track_click):
            self._listener(LineEventType.OnTrackClick, data)

    def update_buttons_availability(self, tracked_name):
        if self._click_handler:
            BigWorld.cancelCallback(self._click_handler)
            self._click_handler = None
        if tracked_name and self._data['name'] == tracked_name:
            self.untrack_btn.component.visible = True
            self.track_btn.component.visible = False
        else:
            self.untrack_btn.component.visible = False
            self.track_btn.component.visible = True
        return

    def set_data(self, data):
        self._data = data
        self._component.name.text = self._data['name']
        if self._data['is_online']:
            self._component.online.colour = cc.green_rgba
            self._component.online.text = lc('GUI.QuestLog.Events.Online')
        else:
            self._component.online.colour = cc.red_rgba
            self._component.online.text = lc('GUI.QuestLog.Events.Offline')
        if self._data['space_id']:
            space_name = space_utils.get_short_space_name_by_id(self._data['space_id'])
            space_name = space_utils.getLokalizedSpaceNameByName(space_name)
            if self._data['space_id'] in BigWorld.player().visited_spaces:
                self._component.space.script.setText(u'<hlink={0};{1}><font=RobotoCondensedRegular_16.font><alignment=center>'.format(space_name, self._data['name']), immidiate=True)
            else:
                self._component.space.script.setText(cc.inactive_xml + u'<font=RobotoCondensedRegular_16.font><alignment=center>' + space_name, immidiate=True)
            self._component.space.visible = True
        else:
            self._component.space.visible = False

    def on_hide(self):
        if self._click_handler:
            BigWorld.cancelCallback(self._click_handler)
            self._click_handler = None
        return


class HuntBlock:

    def __init__(self, start_index, component, listener):
        self._component = component
        self._start_index = start_index
        self._listener = listener
        comp = GUI.Text(lc('GUI.QuestLog.Events.HuntUnavailable'))
        comp.colour = cc.inactive_rgba
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (10, get_height(self._start_index), 0.5)
        self._component.addChild(comp, 'header')
        comp = GUI.Text(lc('GUI.QuestLog.Events.Trace'))
        comp.colour = cc.active_rgba
        comp.visible = False
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.position = (780, get_height(self._start_index), 0.5)
        self._component.addChild(comp, 'header2')
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.width, comp.height = (848, 20)
        comp.position = (6, 0, 0.5)
        comp.materialFX = 'BLEND'
        comp.colour[3] = 20
        self._component.addChild(comp, 'stripe')
        comp = GUI.Simple(u'')
        self._component.addChild(comp, 'lines')

    def update_start_index(self, index):
        self._start_index = index
        self._component.header.position.y = get_height(self._start_index)
        self._component.header2.position.y = self._component.header.position.y
        self._component.stripe.position.y = get_height(self._start_index) - 1

    def on_show(self):
        BigWorld.player().getWantedPosition()
        BWPersonality.GUICore.addListener('hlinkEvent', self._hlink_event)

    def on_hide(self):
        BWPersonality.GUICore.removeListener('hlinkEvent', self._hlink_event)
        for _, comp in self._component.lines.children:
            comp.script.on_hide()

    def _hlink_event(self, event, data):
        if event != HyperLink.EVENT_CLICK:
            return
        data, interface_id = data
        if interface_id == Line.interface_id:
            for _, comp in self._component.lines.children:
                if comp.script._data['name'] == data:
                    space_name = BWPersonality.game.get_space_name_advanced(comp.script._data['space_id'])
                    notify_data = {'space': space_name,
                     'position': comp.script._data['position'],
                     'wanted': comp.script._data['name']}
                    self._listener(LineEventType.OnSpaceClick, notify_data)
                    break

    def on_got_hunt3(self, data):
        if data:
            self._component.header.colour = cc.active_rgba
            self._component.header.text = lc('GUI.QuestLog.Events.Hunt')
            self._component.header2.visible = True
        else:
            self._component.header.colour = cc.inactive_rgba
            self._component.header.text = lc('GUI.QuestLog.Events.HuntUnavailable')
            self._component.header2.visible = False
        while len(self._component.lines.children) < len(data):
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = (820, 20)
            Line(comp, self._on_line_event)
            self._component.lines.addChild(comp)

        for _, comp in self._component.lines.children:
            comp.visible = False

        for i, h_data in enumerate(data):
            comp = self._component.lines.children[i][1]
            comp.script.set_data(h_data)
            comp.position = (20, get_height(self._start_index + i + 1), 0.5)
            comp.visible = True

    def _on_line_event(self, event_type, data):
        self._listener(event_type, data)

    def update_buttons_availability(self, tracked_name):
        for _, comp in self._component.lines.children:
            comp.script.update_buttons_availability(tracked_name)

    def on_hunt_notification_got4(self, space_name, position):
        for _, comp in self._component.lines.children:
            wanted_name = comp.script._data['name']
            if BigWorld.player().tracked_wanted == wanted_name:
                space_id = space_name and space_utils.get_space_id_by_name(space_name[7:])
                new_data = dict(comp.script._data)
                new_data['is_online'] = bool(space_id)
                new_data['space_id'] = space_id
                comp.script.set_data(new_data)