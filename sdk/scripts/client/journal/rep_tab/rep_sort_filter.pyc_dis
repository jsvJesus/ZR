# Embedded file name: ./client/journal/rep_tab/rep_sort_filter.py
import rep_utils
import GUI
import space_utils
from soGUI.soCheckBox import soCheckBox
import soGUI
import colorCodes as CC
from Localization import lc
from journal.sort_filter import SortFilter

class RepSortFilter(SortFilter):

    def __init__(self, component, listener):
        SortFilter.__init__(self, component, listener, False, True, True)

    def create_content(self):
        left_pos = 16
        comp = GUI.Text(lc('GUI.QuestLog.rep_filter'))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.position = (left_pos, 8, 0.5)
        self.component.filter_content.addChild(comp)
        y_disp = 20
        max_height = 50
        comp = GUI.Text(lc('GUI.QuestLog.rep_filter0'))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.position = (left_pos, max_height - 6, 0.5)
        comp.colour = CC.inactive_rgba
        self.component.filter_content.addChild(comp)

        def create_base_checkbox(x, y, text, feature):
            cb = soCheckBox(GUI.Window(), soGUI.CheckBoxPropsStructure(labelText=text, labelColour=CC.inactive_rgba))
            cb.setActive()
            comp = cb.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.materialFX = 'BLEND'
            comp.position = (x, y, 0.5)
            cb.onStateChange = self._on_checkbox
            cb.disableLabelColour = (255, 0, 0, 255)
            cb.feature = feature
            self.component.filter_content.addChild(comp)
            cb.onBound()
            return cb

        self._feature_checks = []
        self._local_cb = create_base_checkbox(left_pos, max_height + y_disp * 1, lc('GUI.QuestLog.local_groups'), rep_utils.Feature.Geographical)
        self._feature_checks.append(self._local_cb)
        cb = create_base_checkbox(left_pos, max_height + y_disp * 2, lc('GUI.QuestLog.policy_groups'), rep_utils.Feature.Political)
        self._feature_checks.append(cb)
        x_disp = 250
        max_height = 132
        height = max_height + y_disp
        min_height = 480
        comp = GUI.Text(lc('GUI.QuestLog.rep_filter1'))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.position = (left_pos, max_height - 6, 0.5)
        comp.colour = CC.inactive_rgba
        self.component.filter_content.addChild(comp)
        self._space_checks = []

        def create_space_checkbox(x, y, text, space_id):
            cb = soCheckBox(GUI.Window(), soGUI.CheckBoxPropsStructure(labelText=text, labelColour=CC.inactive_rgba))
            cb.setActive()
            comp = cb.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.materialFX = 'BLEND'
            comp.position = (x, y, 0.5)
            self.component.filter_content.addChild(comp)
            cb.onStateChange = self._on_checkbox
            cb.disableLabelColour = (80, 80, 80, 255)
            cb.space_id = space_id
            cb.onBound()
            self._space_checks.append(cb)
            return cb

        for space_id, space_name in space_utils.get_all_spaces():
            if space_name in space_utils.test_dev_spaces:
                continue
            create_space_checkbox(left_pos, height, space_utils.getLokalizedSpaceNameByName(space_name), space_id)
            height += y_disp
            if height > min_height:
                height = max_height + y_disp
                left_pos += x_disp

        self._update_local_checkboxes_availability()

    def _on_checkbox(self):
        self.notify_mode_changed()
        self._update_local_checkboxes_availability()

    def _on_select_all_click(self):
        for cb in self._space_checks:
            cb.setActive()

        self.notify_mode_changed()
        self._update_local_checkboxes_availability()

    def _on_deselect_all_click(self):
        for cb in self._space_checks:
            cb.setInactive()

        self.notify_mode_changed()
        self._update_local_checkboxes_availability()

    def _update_local_checkboxes_availability(self):
        available = self._local_cb.isChecked()
        if available:
            count = 0
            for cb in self._space_checks:
                if cb.isChecked():
                    count += 1
                cb.enable()

            self._select_all_btn.setDisabledState(False or count == len(self._space_checks))
            self._deselect_all_btn.setDisabledState(False or count == 0)
        else:
            self._select_all_btn.setDisabledState(True)
            self._deselect_all_btn.setDisabledState(True)
            for cb in self._space_checks:
                cb.disable()

    @property
    def mode(self):
        spaces = set()
        for ch in self._space_checks:
            if ch.isChecked():
                spaces.add(ch.space_id)

        features = set()
        for ch in self._feature_checks:
            if ch.isChecked():
                features.add(ch.feature)

        return {'sort': self._sort_mode,
         'space_filter': rep_utils.pack_int_set(spaces),
         'feature_filter': rep_utils.pack_int_set(features)}