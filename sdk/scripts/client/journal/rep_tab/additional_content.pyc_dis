# Embedded file name: ./client/journal/rep_tab/additional_content.py
import colorCodes as cc
import rep_utils
import GUI
from ui.button import Button
from Localization import lc
from additional_reptab_view import AdditionalReptabView
from soGUI.soTextField import soTextField3
from show_hide_group import ShowHideGroup
from rep_data_provider import IdET
from knowledge import knowledge_parser as kp

class AdditionalContent(ShowHideGroup):

    def __init__(self, component, toggle_handler, tab_events_handler, empty_additionals_handler):
        ShowHideGroup.__init__(self)
        self.component = component
        self._empty_additionals_handler = empty_additionals_handler
        self.component.isClip = False
        btn = Button(self.component, 'back_button', frame=True)
        btn.set_visual('soGUI/frame/buttons/linkbutton.json')
        btn.set_image('soGUI/frame/left_arrow.dds')
        pivot = (1, 0)
        clip_pos = (1, 1)
        pixel_pos = (0, 5)
        btn.transform.set_base_resolution(None)
        btn.on_click = toggle_handler
        btn.set_text(lc('GUI.QuestLog.BACK_BTN'))
        btn.set_font_unscalable()
        string_width = btn.text.get_string_width()
        image_width = btn.image.component.width
        size = (string_width + image_width + 6, 35)
        btn.transform.set_pixel_mode(pivot, clip_pos, size, pixel_pos=pixel_pos)
        tf = soTextField3(GUI.Window(), self.component.width - 40, 210, textWidth=-1, hScroll=False, vScroll=True, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        comp = tf.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (20, 10, 0.5)
        comp.width, comp.height = self.component.width, 128
        self.component.addChild(comp, 'description')
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.position = (1, self.component.height - 1, 0.4)
        self.component.addChild(comp, 'tabview')
        comp.width, comp.height = self.component.width - 2, 240
        self._tabview = AdditionalReptabView(comp, tab_events_handler)
        return

    @property
    def visible(self):
        return self.component.visible

    def on_show(self):
        ShowHideGroup.on_show(self)
        self._tabview.on_show()

    def on_hide(self):
        ShowHideGroup.on_hide(self)
        self._tabview.on_hide()

    def _on_item_event(self, event_type, data):
        if event_type == IdET.OnKnowledgeChanged:
            item_data = data
            self._generate_text(item_data)

    def on_group_changed(self, item_data, old_item_data):
        if old_item_data:
            old_item_data.del_callback_listener(self._on_item_event)
        if item_data:
            item_data.add_callback_listener(self._on_item_event)
            self._generate_text(item_data)
            if item_data.knowledge is None:
                self._empty_additionals_handler(item_data.rep_id)
        return

    def _generate_text(self, item_data):
        if not item_data:
            self.component.description.script.setText(u'', immidiate=True)
            return
        description = rep_utils.get_desc(item_data.rep_id)
        text = cc.inactive_xml + description
        if item_data.knowledge:
            knowledge_text = kp.compile_knowledge_additional_description(kp.get_group_additionals(item_data.rep_id), item_data.knowledge)
            if knowledge_text:
                text += '\n\n' + knowledge_text
        self.component.description.script.setText(text, immidiate=True)

    def set_group(self, item_data):
        ShowHideGroup.set_group(self, item_data)
        self._tabview.set_group(item_data)