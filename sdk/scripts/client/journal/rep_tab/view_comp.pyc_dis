    def _initialize(self, item_data, callback_listener):
        self._callback_listener = callback_listener
        self._item_data = item_data
        self._item_data.add_callback_listener(self._on_item_data_event)
        self._update_visual()

    def _on_item_data_event(self, event_type, data):
        if event_type in (IdET.OnSelectedChanged, IdET.OnValuesChanged):
            self._update_visual()

    def _on_click(self):
        self._callback_listener(EventType.OnClick, self)

    def _update_visual(self):
        loading = not self._item_data.has_value
        btn = self.component.btn
        if loading:
            self.component.load_pips.visible = True
            self._callback_listener(EventType.EmptyVisible, self)
            self.component.pic.visible = False
        else:
            self.component.load_pips.visible = False
            btn.label.text = rep_utils.get_name(self.rep_id)
            if BigWorld.player().is_admin_and_f2():
                self.component.btn.label.text += ' (id: {0} )'.format(self.rep_id)
            if self._item_data.is_fav:
                btn.script.initVSC('soGUI/elements/repListLementFav.xml')
            else:
                btn.script.initVSC('soGUI/elements/repListLement.xml')
            btn.script.setVisualState('normal')
            btn.script.onBound()
            self.component.line.filler.width = rep_utils.convert_rep_value_to_scale_ratio(self._item_data.value)
            texture_name = None
            if rep_utils.is_group_political(self.rep_id):
                texture_name = 'soGUI/frame/journal/rep_polit.dds'
            elif rep_utils.is_group_geographical(self.rep_id):
                texture_name = 'soGUI/frame/journal/rep_local.dds'
            if texture_name and texture_name not in ViewComp._texture_cache:
                ViewComp._texture_cache[texture_name] = BigWorld.PyTextureProvider(texture_name)
            if texture_name:
                self.component.pic.visible = True
                self.component.pic.texture = ViewComp._texture_cache[texture_name]
            else:
                self.component.pic.visible = False
        for comp in self._hide_list:
            comp.visible = not loading

        toggled = self._item_data.selected
        btn.script.buttonActive = toggled
        btn.script.setToggleState(toggled)
        return

    def on_destroy(self):
        self._callback_listener = None
        self._item_data.del_callback_listener(self._on_item_data_event)
        self._item_data = None
        _comps_pool.append(self)
        return

    @property
    def rep_id(self):
        return self._item_data and self._item_data.rep_id

    @staticmethod
    def get_component(item_data, callback_listener):
        if _comps_pool:
            view_comp = _comps_pool.pop()
        else:
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = 270, ViewComp.evaluate_height()
            view_comp = ViewComp(comp)
        view_comp._initialize(item_data, callback_listener)
        return view_comp

    @staticmethod
    def evaluate_height():
        return 40


_comps_pool = []