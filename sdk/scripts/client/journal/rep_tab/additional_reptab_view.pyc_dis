# Embedded file name: ./client/journal/rep_tab/additional_reptab_view.py
import BWPersonality
from Localization import lc
from rep_tab_view import RepTabView, EventType
from journal.tab import Tab
from show_hide_group import ShowHideGroup
from rep_data_provider import IdET
import Quest
from soGUI.soTextField import soTextField3
import GUI
import AdditionalNPCParameters as AP
from NPCs import NPCs
from soGUI.soHyperLinkComponent import soHyperLinkComponent as HyperLink
import rep_utils

class MembersTab(Tab, ShowHideGroup):
    INTERFACE_ID = 'reptab_addcontent_memberstab_interface_id'

    def __init__(self, component, events_handler):
        Tab.__init__(self, lc('GUI.QuestLog.reptab_members'), component)
        ShowHideGroup.__init__(self)
        self._events_handler = events_handler
        tf = soTextField3(GUI.Window(), self.component.width - 19, self.component.height, textWidth=-1, hScroll=False, vScroll=True, hideScroll=True, borderWidth=0, vOffset=8, hOffset=0, textureless=1)
        tf.INTERFACE_ID = self.INTERFACE_ID
        comp = tf.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (19, 0, 0.5)
        self.component.addChild(comp, 'description')

    def _hlink_event(self, event, data):
        if event != HyperLink.EVENT_CLICK:
            return
        data, interface_id = data
        if interface_id == self.INTERFACE_ID:
            data = {'npc_name': data}
            self._events_handler(EventType.OnMemberClick, data)

    def on_show(self):
        Tab.on_show(self)
        ShowHideGroup.on_show(self)
        BWPersonality.GUICore.addListener('hlinkEvent', self._hlink_event)

    def on_hide(self):
        Tab.on_hide(self)
        ShowHideGroup.on_hide(self)
        BWPersonality.GUICore.removeListener('hlinkEvent', self._hlink_event)

    def _on_itemdata_event(self, event_type, data):
        if event_type == IdET.OnMembersChanged:
            mode = data['mode']
            if mode == Quest.MEMBERS_REP:
                self._update_content()

    def on_group_changed(self, item_data, old_item_data):
        if old_item_data:
            old_item_data.del_callback_listener(self._on_itemdata_event)
        if item_data:
            item_data.add_callback_listener(self._on_itemdata_event)
        if self.item_data and self.item_data.members is None:
            data = {'id': self.item_data.rep_id}
            self._events_handler(EventType.MembersEmptyVisible, data)
        self._update_content()
        return

    def _update_content(self):
        text = u'<font=RobotoCondensedRegular_16.font>'
        if self.item_data and self.item_data.members:
            for npc_id in self.item_data.members:
                name = AP.get_npc_name_by_id(npc_id)
                local_name = NPCs.getName(name)
                text += u'<hlink={0};{1}>\n'.format(local_name, name)

            if text:
                text = text[:-1]
        self.component.description.script.setText(text, immidiate=True)


class EnemibesTab(Tab, ShowHideGroup):
    INTERFACE_ID = 'reptab_addcontent_enemiesstab_interface_id'

    def __init__(self, component, events_handler):
        Tab.__init__(self, lc('GUI.QuestLog.reptab_enemies'), component)
        ShowHideGroup.__init__(self)
        self._events_handler = events_handler
        tf = soTextField3(GUI.Window(), self.component.width - 19, self.component.height, textWidth=-1, hScroll=False, vScroll=True, hideScroll=True, borderWidth=0, vOffset=8, hOffset=0, textureless=1)
        tf.INTERFACE_ID = self.INTERFACE_ID
        comp = tf.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (19, 0, 0.5)
        self.component.addChild(comp, 'description')

    def _hlink_event(self, event, data):
        if event != HyperLink.EVENT_CLICK:
            return
        data, interface_id = data
        if interface_id == self.INTERFACE_ID:
            data = {'gr_id': int(data)}
            self._events_handler(EventType.OnMemberClick, data)

    def on_show(self):
        Tab.on_show(self)
        ShowHideGroup.on_show(self)
        BWPersonality.GUICore.addListener('hlinkEvent', self._hlink_event)

    def on_hide(self):
        Tab.on_hide(self)
        ShowHideGroup.on_hide(self)
        BWPersonality.GUICore.removeListener('hlinkEvent', self._hlink_event)

    def _on_itemdata_event(self, event_type, data):
        if event_type == IdET.OnMembersChanged:
            mode = data['mode']
            if mode == Quest.ENEMIES_REP:
                self._update_content()

    def on_group_changed(self, item_data, old_item_data):
        if old_item_data:
            old_item_data.del_callback_listener(self._on_itemdata_event)
        if item_data:
            item_data.add_callback_listener(self._on_itemdata_event)
        if self.item_data and self.item_data.enemies is None:
            data = {'id': self.item_data.rep_id}
            self._events_handler(EventType.EnemiesEmptyVisible, data)
        self._update_content()
        return

    def _update_content(self):
        text = u'<font=RobotoCondensedRegular_16.font>'
        if self.item_data and self.item_data.enemies:
            for gr_id in self.item_data.enemies:
                local_name = rep_utils.get_name(gr_id)
                text += u'<hlink={0};{1}>\n'.format(local_name, gr_id)

            if text:
                text = text[:-1]
        self.component.description.script.setText(text, immidiate=True)


class AdditionalReptabView(RepTabView):

    def __init__(self, component, events_handler):
        RepTabView.__init__(self, component, [MembersTab, EnemibesTab], events_handler)

    def set_group(self, item_data):
        for tab in self._tabs:
            tab.set_group(item_data)