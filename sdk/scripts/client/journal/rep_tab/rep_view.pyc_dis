# Embedded file name: ./client/journal/rep_tab/rep_view.py
from view_comp import ViewComp, EventType as VcET
from journal.common_view.view import View

class EventType:
    OnEmptyItemVisible, OnItemClick = xrange(2)


class RepView(View):

    def __init__(self, data_provider, callback_listener, component):
        View.__init__(self, data_provider, callback_listener, ViewComp, component)

    def insert_forward_number(self):
        """ \xd0\xbe\xd1\x82\xd1\x81\xd1\x82\xd1\x83\xd0\xbf \xd1\x81\xd0\xb2\xd0\xb5\xd1\x80\xd1\x85\xd1\x83 \xd0\xb8 \xd1\x81\xd0\xbd\xd0\xb8\xd0\xb7\xd1\x83, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb2\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd1\x82\xd1\x8c \xd0\xb2 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd1\x83 """
        return 5

    def _on_itemcomp_event(self, event_type, data):
        if event_type == VcET.EmptyVisible:
            item_comp = data
            data = {'unique_id': item_comp._item_data._unique_id}
            self._callback_listener(EventType.OnEmptyItemVisible, data)
        elif event_type == VcET.OnClick:
            item_comp = data
            data = {'unique_id': item_comp._item_data._unique_id,
             'group_id': item_comp._item_data.rep_id}
            self._callback_listener(EventType.OnItemClick, data)

    def try_select_group(self, group_id):
        for item_comp in self._visible_items:
            if item_comp.rep_id == group_id:
                data = {'unique_id': item_comp._item_data._unique_id,
                 'group_id': item_comp._item_data.rep_id}
                self._callback_listener(EventType.OnItemClick, data)
                return True

        return False