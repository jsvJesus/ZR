# Embedded file name: ./client/journal/rep_tab/content.py
import BigWorld
import GUI
from base_content import BaseContent
from additional_content import AdditionalContent
from Localization import lc
import rep_utils
import colorCodes as cc
from show_hide_group import ShowHideGroup
from rep_data_provider import IdET

class Content(ShowHideGroup):

    def __init__(self, component, tab_events_handler, empty_acquaintance_handler, empty_additionals_handler):
        ShowHideGroup.__init__(self)
        self.component = component
        self.component.isClip = False
        self.component.visible = False
        comp = GUI.Frame2('soGUI/frame/con_frame_rounded.dds')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.9)
        comp.materialFX = 'SOLID'
        comp.width, comp.height = self.component.width, self.component.height
        self.component.addChild(comp, 'frame')
        comp = GUI.Text()
        comp.font = 'RobotoCondensedRegular_20.font'
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.position = (16, 32, 0.9)
        comp.width, comp.height = (2, 40)
        self.component.addChild(comp, 'title')
        comp = GUI.Text()
        comp.colourFormatting = True
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.position = (self.component.width - 16, 32, 0.9)
        comp.width, comp.height = (2, 40)
        self.component.addChild(comp, 'points')
        comp = GUI.Window()
        comp.visible = True
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width, self.component.height - 40
        comp.position = (0, self.component.height, 0.8)
        self.component.addChild(comp, 'base_comp')
        self._base_content = BaseContent(comp, self._toggle_pages, tab_events_handler, empty_acquaintance_handler)
        comp = GUI.Window()
        comp.visible = False
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width, self.component.height - 40
        comp.position = (0, self.component.height, 0.8)
        self.component.addChild(comp, 'additional_comp')
        self._additional_content = AdditionalContent(comp, self._toggle_pages, tab_events_handler, empty_additionals_handler)

    def _toggle_pages(self):
        active_content = self._get_active_content()
        inactive_content = self._get_inactvie_content()
        active_content.on_hide()
        active_content.component.visible = False
        inactive_content.on_show()
        inactive_content.component.visible = True

    def on_show(self):
        ShowHideGroup.on_show(self)
        self._get_active_content().on_show()

    def on_hide(self):
        ShowHideGroup.on_hide(self)
        self._get_active_content().on_hide()

    def set_group(self, item_data):
        ShowHideGroup.set_group(self, item_data)
        self._base_content.set_group(self._item_data)
        self._additional_content.set_group(self._item_data)

    def on_group_changed(self, item_data, old_item_data):
        if old_item_data:
            old_item_data.del_callback_listener(self._on_itemdata_event)
        if item_data:
            item_data.add_callback_listener(self._on_itemdata_event)
        self._update_visual()

    def _update_visual(self):
        self.component.visible = bool(self.item_data)
        if self.component.visible:
            self.component.title.text = rep_utils.get_name(self.item_data.rep_id)
            if BigWorld.player().is_admin_and_f2():
                self.component.title.text += ' (id: {0} )'.format(self.item_data.rep_id)
            self.component.points.text = cc.inactive_hex + lc('GUI.QuestLog.REP_TAB_POINTS') + u' ' + cc.active_hex + str(self.item_data.points)

    def _on_itemdata_event(self, event_type, data):
        if event_type == IdET.OnValuesChanged:
            self._update_visual()
        self._base_content.on_item_data_event(event_type, data)

    def _get_active_content(self):
        if self._base_content.visible:
            if not not self._additional_content.visible:
                raise AssertionError
                return self._base_content
            return self._additional_content.visible and self._additional_content
        raise RuntimeError

    def _get_inactvie_content(self):
        if self._base_content.visible:
            if not not self._additional_content.visible:
                raise AssertionError
                return self._additional_content
            return self._additional_content.visible and self._base_content
        raise RuntimeError

    @property
    def selected_rep_id(self):
        return self.item_data and self.item_data.rep_id