# Embedded file name: ./client/journal/rep_tab/server.py
import BigWorld

class EventType:
    OnDataLoaded, OnQuestsLoaded, OnMembersLoaded, OnDataChanged, OnQuestStateChanged, OnKnowledgeGot, OnAcquaintedGot = xrange(7)


class Server:

    def __init__(self, callback_listener):
        self._callback_listener = callback_listener

    def on_show(self):
        self._user.on_rep_event = self.on_rep_event
        self._user.base.subscribe_all_rep_events(True)
        self._user.subscribe_all_quests_changes((self._on_quest_state_event, None), self)
        return

    def on_hide(self):
        self._user.base.subscribe_all_rep_events(False)
        self._user.unsubscribe_all_quests_changes(self)

    def _on_quest_state_event(self, quest_id, prev_state, state):
        data = {'quest_id': quest_id,
         'prev_state': prev_state,
         'state': state}
        self._callback_listener(EventType.OnQuestStateChanged, data)

    def on_rep_event(self, event_type, rep_data):
        data = {'event_type': event_type,
         'rep_data': rep_data}
        self._callback_listener(EventType.OnDataChanged, data)

    def load_data(self, context_ids, unique_id, sort_filter, fav_list):
        self._user.load_rep_data2 = self.load_rep_data2
        self._user.base.load_rep_data1(context_ids, unique_id, sort_filter, fav_list)

    def load_rep_data2(self, rep_data, unique_id):
        data = {'unique_id': unique_id,
         'group_data': [ (r_data if r_data['id'] else None) for r_data in rep_data ]}
        self._callback_listener(EventType.OnDataLoaded, data)
        return

    def load_rep_members2(self, npc_ids, rep_id, mode):
        data = {'npc_ids': npc_ids,
         'rep_id': rep_id,
         'mode': mode}
        self._callback_listener(EventType.OnMembersLoaded, data)

    def load_rep_quests2(self, quest_ids, rep_id, mode, data):
        data = {'quest_ids': quest_ids,
         'rep_id': rep_id,
         'mode': mode,
         'data': data}
        self._callback_listener(EventType.OnQuestsLoaded, data)

    def load_additional_knowledge(self, rep_id):
        self._user.base.load_group_additionals0(rep_id)
        self._user.load_group_additionals1 = self.load_group_additionals1

    def load_group_additionals1(self, gr_id, bitint):
        data = {'group_id': gr_id,
         'knowledge': bitint}
        self._callback_listener(EventType.OnKnowledgeGot, data)

    def load_aquaintance(self, rep_id):
        self._user.base.load_aquaintance0(rep_id)
        self._user.load_aquaintance1 = self.load_aquaintance1

    def load_aquaintance1(self, gr_id, acquainted):
        data = {'group_id': gr_id,
         'acquainted': acquainted}
        self._callback_listener(EventType.OnAcquaintedGot, data)

    def load_quests(self, rep_id, mode):
        self._user.load_rep_quests2 = self.load_rep_quests2
        self._user.base.load_rep_quests1(rep_id, mode)

    def load_members(self, rep_id, mode):
        self._user.load_rep_members2 = self.load_rep_members2
        self._user.base.load_rep_members1(rep_id, mode)

