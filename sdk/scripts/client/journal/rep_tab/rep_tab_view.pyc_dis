# Embedded file name: ./client/journal/rep_tab/rep_tab_view.py
from journal.tab_view import TabView
import GUI

class EventType:
    CurQuestsEmptyVisible, AvailableQuestsEmptyVisible, MembersEmptyVisible, EnemiesEmptyVisible, OnQuestClick, OnMemberClick = xrange(6)


class RepTabView(TabView):

    def __init__(self, component, classes, events_hanlder):
        self._classes = classes
        self._events_hanlder = events_hanlder
        TabView.__init__(self, component)

    def create_tabs(self):

        def create_tab_component():
            component = self.create_tab_component()
            comp = GUI.Frame2('soGUI/frame/frame_connection.dds')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
            comp.width, comp.height = (2, 2)
            comp.position = (0, 0, 1)
            comp.materialFX = 'BLEND'
            component.addChild(comp, 'frame')
            return component

        tabs = []
        for tab_class in self._classes:
            tabs.append(tab_class(create_tab_component(), self._events_hanlder))

        return tabs

    def button_width(self):
        return 150

    def left_margin(self):
        return 12