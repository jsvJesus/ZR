# Embedded file name: ./client/journal/rep_tab/base_content.py
import BWPersonality
import math_bw
from soGUI.soTextField import soTextField3
from Localization import lc
import GUI
import rep_utils
import colorCodes as cc
from events_group import EventsGroup
from soGUI.soHyperLinkComponent import soHyperLinkComponent as HyperLink
from base_reptab_view import BaseReptabView
from show_hide_group import ShowHideGroup
from rep_data_provider import IdET

class BaseContent(ShowHideGroup):
    INTERFACE_ID = 'rep_tab_basecontent_interface_id'

    def __init__(self, component, toggle_handler, tab_handler, empty_acquaintance_handler):
        ShowHideGroup.__init__(self)
        self._toggle_handler = toggle_handler
        self.component = component
        comp = GUI.Window('soGUI/frame/journal/rep_scale.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.position = (0, 30, 0.5)
        self.component.addChild(comp, 'scale')
        comp = GUI.Window('soGUI/frame/journal/rainbow.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.materialFX = 'SOLID'
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.position = (0, 1, 0.9)
        self.component.scale.addChild(comp, 'rainbow')
        comp.widthMode = 'PIXEL'
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.colour = (16, 16, 16, 255)
        comp.materialFX = 'SOLID'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
        comp.width, comp.height = (2, 2)
        comp.position = (1, 0, 0.5)
        self.component.scale.rainbow.addChild(comp, 'filler')
        left = self.component.width * 0.5 - self.component.scale.rainbow.width * 0.5
        right = self.component.width * 0.5 + self.component.scale.rainbow.width * 0.5
        count = len(rep_utils.groups_scale_data)
        self._text_values = []
        for i, value in enumerate(rep_utils.groups_scale_data):
            ratio = float(i) / (count - 1)
            x_pos = math_bw.lerp(left, right, ratio)
            comp = GUI.Text(str(value))
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.position = (x_pos, 50, 0.8)
            comp.font = 'RobotoCondensedRegular_12.font'
            self.component.addChild(comp)
            self._text_values.append(comp)

        comp = GUI.Text()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (200, 8, 0.8)
        comp.font = 'RobotoCondensedRegular_12.font'
        self.component.addChild(comp, 'cur_value')
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (1, 13)
        comp.position = (200, 28, 0.8)
        self.component.addChild(comp, 'risk')
        self.component.addChild(GUI.Simple(''), 'events_container')
        tf = soTextField3(GUI.Window(), self.component.width - 40, 128, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, autosize=True, hOffset=0, textureless=1)
        comp = tf.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (20, 110, 0.5)
        comp.width, comp.height = self.component.width, 128
        self.component.addChild(comp, 'description')
        comp = GUI.Window()
        tf = soTextField3(comp, 200, 36, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        tf.INTERFACE_ID = self.INTERFACE_ID
        tf.setText(u'<font=RobotoCondensedRegular_16.font><alignment=right><hlink={0};>'.format(lc('GUI.QuestLog.DETAILS')))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (326, 220, 0.5)
        self.component.addChild(comp, 'collapse')
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.position = (1, self.component.height - 1, 0.5)
        self.component.addChild(comp, 'tabview')
        comp.width, comp.height = self.component.width - 2, 240
        self._tabview = BaseReptabView(comp, tab_handler)
        self._empty_acquaintance_handler = empty_acquaintance_handler

    def set_group(self, item_data):
        ShowHideGroup.set_group(self, item_data)
        self._tabview.set_group(item_data)

    def on_item_data_event(self, event_type, data):
        if event_type == IdET.OnValuesChanged:
            self._update_scale()
        elif event_type == IdET.OnAcquaintedChanged:
            self._update_content()

    def _update_scale(self):
        self.component.scale.rainbow.filler.width = rep_utils.convert_rep_value_to_scale_ratio(self._item_data.value)
        left = (self.component.width - self.component.scale.rainbow.width) * 0.5
        right = (self.component.width + self.component.scale.rainbow.width) * 0.5
        ratio = 1.0 - self.component.scale.rainbow.filler.width * 0.5
        x_pos = math_bw.lerp(left, right, ratio)
        if x_pos == right:
            x_pos += 1
        self.component.cur_value.position[0] = x_pos
        self.component.cur_value.text = str(self._item_data.value)
        self.component.risk.position[0] = x_pos

    def _update_content(self):
        description = rep_utils.get_desc(self._item_data.rep_id)
        max_len = 200
        if len(description) > max_len:
            description = description[:max_len - 3] + '...'
        if self._item_data.acquainted is True:
            text = description
        elif self._item_data.acquainted is None:
            self._empty_acquaintance_handler(self._item_data.rep_id)
            text = u''
        elif self._item_data.acquainted is False:
            text = lc('GUI.QuestLog.UnknownGroupDescription')
        self.component.description.script.setText(cc.inactive_xml + text, immidiate=True)
        self.component.collapse.position[1] = self.component.description.position[1] + self.component.description.height
        left = (self.component.width - self.component.scale.rainbow.width) * 0.5
        right = (self.component.width + self.component.scale.rainbow.width) * 0.5
        for _, comp in self.component.events_container.children:
            _event_comps_pool.append(comp)
            self.component.events_container.delChild(comp)

        for text_comp in self._text_values:
            text_comp.colour = cc.inactive_rgba

        for event_value, events_data in rep_utils.get_group_events(self._item_data.rep_id).items():
            text_index = rep_utils.groups_scale_data.index(event_value)
            self._text_values[text_index].colour = cc.active_rgba
            ratio = 1.0 - rep_utils.convert_rep_value_to_scale_ratio(event_value) * 0.5
            x_pos = math_bw.lerp(left, right, ratio)
            if _event_comps_pool:
                eg = _event_comps_pool.pop().script
            else:
                eg = EventsGroup()
            eg.initialize([ e_id for e_id, _ in events_data ])
            eg.component.position = (x_pos, 74, 0.5)
            self.component.events_container.addChild(eg.component)

        self._update_scale()
        return

    def on_group_changed(self, item_data, old_item_data):
        if not item_data:
            return
        self._item_data = item_data
        self._update_content()

    def on_show(self):
        ShowHideGroup.on_show(self)
        self._tabview.on_show()
        BWPersonality.GUICore.addListener('hlinkEvent', self._hlink_event)

    def on_hide(self):
        ShowHideGroup.on_hide(self)
        self._tabview.on_hide()
        BWPersonality.GUICore.removeListener('hlinkEvent', self._hlink_event)

    def _hlink_event(self, event, data):
        if event != HyperLink.EVENT_CLICK:
            return
        data, interface_id = data
        if interface_id == self.INTERFACE_ID:
            self._toggle_handler()

    @property
    def visible(self):
        return self.component.visible


_event_comps_pool = []