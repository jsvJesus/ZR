# Embedded file name: ./client/journal/journal_tab_view.py
import BigWorld
from quests_tab2.quests_tab2 import QuestsTab2
from stories_tab.stories_tab import StoriesTab
from relation_tab.relation_tab import RelationsTab
from dung_tab.dung_tab import DungTab
from tab_view import TabView
from rep_tab.rep_tab import RepTab
import BWPersonality
import space_utils

class JournalTabView(TabView):
    QuestTabIndex, RelTabIndex, RepTabIndex, DungTabIndex, StoriesTabIndex = xrange(5)

    def __init__(self, component):
        TabView.__init__(self, component)

    def create_tabs(self):
        self._relation_tab = RelationsTab(self.create_tab_component())
        self._relation_tab.on_quest_click = self._on_show_quest
        self._relation_tab.on_group_click = self.show_reptab
        self._quests_tab2 = QuestsTab2(self.create_tab_component())
        self._quests_tab2.on_npc_click_callback = self._on_npc_click
        self._quests_tab2.on_map_click_callback = self._on_map_click
        self._rep_tab = RepTab(self.create_tab_component())
        self._rep_tab.on_quest_callback = self._on_show_quest
        self._rep_tab.on_npc_click_callback = self._on_npc_click
        self._rep_tab.on_group_click_callback = self._on_group_click
        self._dung_tab = DungTab(self.create_tab_component())
        self._dung_tab.on_show_wanted_click = self._on_show_wanted
        self._stor_tab = StoriesTab(self.create_tab_component())
        return [self._quests_tab2,
         self._relation_tab,
         self._rep_tab,
         self._dung_tab,
         self._stor_tab]

    def on_show(self, tab_index):
        if tab_index is None:
            for i, tab in enumerate(self._tabs):
                if tab.wants_show_priority():
                    tab_index = i
                    break

        TabView.on_show(self, tab_index)
        return

    def _on_show_quest(self, quest_id):
        self._quests_tab2.force_quest(quest_id)
        self._show_tab(JournalTabView.QuestTabIndex)

    def on_change_owner(self):
        self._quests_tab2.force_quest(None)
        self._rep_tab.force_group(None)
        return

    def show_reptab(self, group_id):
        self._rep_tab.force_group(group_id)
        self._show_tab(JournalTabView.RepTabIndex)

    def mark_quest_status(self, quest_id, status):
        self._quests_tab2.mark_quest_status(quest_id, status)

    def _on_map_click(self, space_name):
        BWPersonality.GUICore.show_space_on_world_map('spaces/' + space_name)

    def _on_show_wanted(self, space_name, position):
        if not (space_name and space_utils.get_space_id_by_name(space_name[7:])):
            space_id = 0
            space_id in BigWorld.player().visited_spaces and BWPersonality.GUICore.show_position_on_world_map(space_name, position)

    def _on_npc_click(self, npc_name):
        self._relation_tab.force_npc(npc_name)
        self._show_tab(JournalTabView.RelTabIndex)

    def _on_group_click(self, gr_id):
        if self._current_tab_index == JournalTabView.RepTabIndex:
            self._show_tab(None)
            self._rep_tab.force_group(gr_id)
            self._show_tab(self._last_visible_tab_index)
        else:
            self._rep_tab.force_group(gr_id)
            self._show_tab(JournalTabView.RepTabIndex)
        return

    def stop_background_tasks(self):
        for tab in self._tabs:
            tab.stop_background_tasks()

    def on_knowledge_npc_event3(self, event_type, npc_id):
        self._relation_tab.on_knowledge_npc_event4(event_type, npc_id)

    def dungeons_data_updated4(self, quests_data):
        self._dung_tab.dungeons_data_updated5(quests_data)

    def got_events_data5(self, quests_data):
        self._dung_tab.got_events_data6(quests_data)

    def on_got_new_stories(self, stor_ids):
        if self._current_tab_index == JournalTabView.StoriesTabIndex:
            self._stor_tab.on_got_new_stories(stor_ids)
        elif stor_ids and not self._stor_tab.is_playing_audio():
            self._stor_tab.force_story(stor_ids[-1])
            self._show_tab(JournalTabView.StoriesTabIndex)

    def on_stories_wiped(self):
        if self._current_tab_index == JournalTabView.StoriesTabIndex:
            self._stor_tab.on_stories_wiped()

    def on_got_hunt1(self, data):
        if self._current_tab_index == JournalTabView.DungTabIndex:
            self._dung_tab.on_got_hunt2(data)

    def get_selected_quest_id(self):
        if self._current_tab_index != JournalTabView.QuestTabIndex:
            return None
        else:
            return self._quests_tab2.get_selected_quest_id()

    def on_hunt_notification_got2(self, space_name, position):
        dung_visible = self._current_tab_index == JournalTabView.DungTabIndex
        self._dung_tab.on_hunt_notification_got3(space_name, position, dung_visible)