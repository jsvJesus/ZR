# Embedded file name: ./client/journal/tab_view.py
from functools import partial
import GUI
from soGUI.soButton import soButton, soButtonWFT

class TabView:

    def __init__(self, component):
        self.component = component
        self._tab_button_height = 21
        self._tabs = self.create_tabs()
        self._apply_tabs()
        self._current_tab_index = None
        self._last_visible_tab_index = 0
        return

    def on_show(self, tab_index = None):
        if tab_index is None:
            tab_index = self._last_visible_tab_index
        self._show_tab(tab_index)
        return

    def on_hide(self):
        self._show_tab(None)
        for tab in self._tabs:
            tab.on_view_hide()

        return

    def button_width(self):
        """ None - \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb8\xd1\x82 \xd0\xb0\xd0\xb2\xd1\x82\xd0\xbe\xd0\xbc\xd0\xb0\xd1\x82\xd0\xbe\xd0\xbc """
        return None

    def left_margin(self):
        return 0

    def create_tabs(self):
        raise NotImplementedError

    def _apply_tabs(self):
        button_width = self.button_width() or float(self.component.width - self.left_margin()) / len(self._tabs)
        self._buttons = []
        for i, tab in enumerate(self._tabs):
            comp = GUI.Window()
            btn = soButtonWFT(comp)
            btn.buttonStyle = soButton.TOGGLEBUTTON_STYLE
            btn.initVSC('soGUI/elements/tab_2.xml')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.width, comp.height = button_width, self._tab_button_height
            comp.position = (i * button_width + self.left_margin(), 0, 0.2)
            comp.label.text = tab.caption
            self.component.addChild(comp, 'tab' + str(i))
            btn.onClick = partial(self._show_tab, i)
            btn.setVisualState('normal')
            btn.onBound()
            self._buttons.append(btn)

    def create_tab_component(self):
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.width, comp.height = self.component.width, self.component.height - self._tab_button_height
        comp.position = (0, -1, 0.3)
        self.component.addChild(comp)
        comp.visible = False
        return comp

    def _show_tab(self, index):
        if self._current_tab_index == index:
            if self._current_tab_index is not None:
                self._buttons[self._current_tab_index].setVisualState('active')
                self._buttons[self._current_tab_index].buttonActive = True
            return
        else:
            for button in self._buttons:
                button.setVisualState('normal')
                button.buttonActive = False

            if self._current_tab_index is not None:
                self._tabs[self._current_tab_index].on_hide()
                self._tabs[self._current_tab_index].component.visible = False
            self._current_tab_index = index
            if self._current_tab_index is not None:
                self._tabs[self._current_tab_index].component.visible = True
                self._tabs[self._current_tab_index].on_show()
                self._last_visible_tab_index = index
                self._buttons[self._current_tab_index].setVisualState('active')
                self._buttons[self._current_tab_index].buttonActive = True
            return