# Embedded file name: ./client/journal/common_view/data_provider.py


class EventType:
    OnClear, OnDataReplaced, OnItemChanged, OnItemInserted, OnDataRemoved = xrange(5)


class DataProvider(object):

    def __init__(self):
        self._callback_listener = None
        return

    def set_callback_listener(self, callback_listener):
        self._callback_listener = callback_listener

    def _index_by_unique_id(self, unique_id):
        return next((i for i, item_data in enumerate(self._data) if item_data._unique_id == unique_id), None)

    def get_next(self, unique_id):
        index = self._index_by_unique_id(unique_id)
        if index is not None and index < len(self._data) - 1:
            return self._data[index + 1]
        else:
            return

    def get_prev(self, unique_id):
        index = self._index_by_unique_id(unique_id)
        if index is not None and index > 0:
            return self._data[index - 1]
        else:
            return

    def get_item(self, unique_id):
        return self._data[self._index_by_unique_id(unique_id)]

    def set_selection(self, unique_id):
        for i, item_data in enumerate(self._data):
            if item_data._unique_id == unique_id:
                if not item_data.selected:
                    item_data.selected = True
                    data = {'unique_id': unique_id}
                    if self._callback_listener:
                        self._callback_listener(EventType.OnItemChanged, data)
            elif item_data.selected:
                item_data.selected = False
                data = {'unique_id': unique_id}
                if self._callback_listener:
                    self._callback_listener(EventType.OnItemChanged, data)

    def find_first_selection(self):
        return next((d for d in self._data if d.selected), None)

    def _delete_item_data(self, index):
        item_data = self._data[index]
        item_data.on_destroy()
        del self._data[index]
        return item_data