# Embedded file name: ./client/journal/scroll_view/scroll_view.py
import GUI
from scroll_bar import ScrollBar
from Helpers.PyGUI.PyGUIBase import Interceptor

class ScrollView(Interceptor):

    def __init__(self, component):
        Interceptor.__init__(self, component)
        self._bar = None
        self.component.script = self
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.width, comp.height = self.component.width - ScrollBar.default_width, 0
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'content')
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = ScrollBar.default_width, self.component.height
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.position = (self.component.width, 0, 0.5)
        self.component.addChild(comp, 'bar')
        self._bar = ScrollBar(comp, self)
        self._update_content_position()
        self.on_bottom_overflow_callback = lambda : None
        return

    def set_content_height(self, height):
        self.component.content.height = height
        self._bar.content_size_changed()

    def _update_content_position(self):
        delta = self.get_scroll_content_height() - self.get_scroll_visual_height()
        prev_pos = self.component.content.position[1]
        if delta <= 0:
            self.component.content.position[1] = 0
        else:
            self.component.content.position[1] = -delta * self._bar.factor
        if prev_pos != self.component.content.position[1]:
            self.on_content_position_changed()

    def on_content_position_changed(self):
        pass

    def calc_visual_rect(self):
        top = -self.component.content.position[1]
        bottom = top + min(self.get_scroll_visual_height(), self.get_scroll_content_height())
        return (top, bottom)

    def handleMouseEvent(self, component, event):
        if event.dz:
            scroll_height = self.get_scroll_content_height()
            if scroll_height > 0:
                delta = -event.dz / 10.0 / scroll_height
                self._bar.change_factor(delta)
        return Interceptor.handleMouseEvent(self, component, event)

    def get_scroll_content_height(self):
        return self.component.content.height

    def get_scroll_visual_height(self):
        return self.component.height

    def on_scroll_factor_changed(self):
        if self._bar:
            self._update_content_position()

    def on_bottom_overflow(self):
        return self.on_bottom_overflow_callback()