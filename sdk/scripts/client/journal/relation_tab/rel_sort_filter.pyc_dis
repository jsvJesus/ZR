# Embedded file name: ./client/journal/relation_tab/rel_sort_filter.py
import GUI
from Localization import lc
from journal.sort_filter import SortFilter
import colorCodes as CC
from soGUI.soCheckBox import soCheckBox
import soGUI
import space_utils

class RelSortFilter(SortFilter):

    def __init__(self, component, listener):
        SortFilter.__init__(self, component, listener, False, True, True)
        left_pos = 16
        max_height = 50
        y_disp = 20
        comp = GUI.Text(lc('GUI.QuestLog.rep_filter'))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.position = (left_pos, 8, 0.5)
        self.component.filter_content.addChild(comp)
        comp = GUI.Text(lc('GUI.QuestLog.rep_filter1'))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.position = (left_pos, max_height - 6, 0.5)
        comp.colour = CC.inactive_rgba
        self.component.filter_content.addChild(comp)
        self._space_checks = []

        def create_space_checkbox(x, y, text, space_name):
            cb = soCheckBox(GUI.Window(), soGUI.CheckBoxPropsStructure(labelText=text, labelColour=CC.inactive_rgba))
            cb.setActive()
            comp = cb.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.materialFX = 'BLEND'
            comp.position = (x, y, 0.5)
            self.component.filter_content.addChild(comp)
            cb.onStateChange = self._on_checkbox
            cb.disableLabelColour = (80, 80, 80, 255)
            cb.space_name = space_name
            cb.onBound()
            self._space_checks.append(cb)
            return cb

        x_disp = 250
        height = max_height + y_disp
        min_height = 480
        for _, space_name in space_utils.get_all_spaces():
            if space_name in space_utils.test_dev_spaces:
                continue
            create_space_checkbox(left_pos, height, space_utils.getLokalizedSpaceNameByName(space_name), space_name)
            height += y_disp
            if height > min_height:
                height = max_height + y_disp
                left_pos += x_disp

        self._update_buttons()

    def _on_select_all_click(self):
        for cb in self._space_checks:
            cb.setActive()

        self.notify_mode_changed()
        self._update_buttons()

    def _on_deselect_all_click(self):
        for cb in self._space_checks:
            cb.setInactive()

        self.notify_mode_changed()
        self._update_buttons()

    def _update_buttons(self):
        count = 0
        for cb in self._space_checks:
            if cb.isChecked():
                count += 1

        self._select_all_btn.setDisabledState(False or count == len(self._space_checks))
        self._deselect_all_btn.setDisabledState(False or count == 0)

    def _on_checkbox(self):
        self.notify_mode_changed()
        self._update_buttons()

    @property
    def mode(self):
        spaces = set()
        for ch in self._space_checks:
            if ch.isChecked():
                spaces.add(ch.space_name)

        return {'sort': self._sort_mode,
         'filter': spaces}