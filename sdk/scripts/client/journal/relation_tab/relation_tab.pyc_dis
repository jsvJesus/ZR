class ListOptimized(soList_optimized):

    def apply_single_element(self, i, elem):
        style = 'soGUI/elements/listRelElement.xml'
        npc_id = self.attachments[self.indexes[elem]].get('npc_id')
        if npc_id is not None:
            element = self.elemComps[i].component.script
            if element and BigWorld.player().is_npc_favorite(npc_id):
                style = 'soGUI/elements/listRelElementFav.xml'
        element.initVSC(style)
        soList_optimized.apply_single_element(self, i, elem)
        return


class RelationsTab(Tab):

    def __init__(self, component):
        Tab.__init__(self, lc('GUI.QuestLog.REL_QUESTS_TAB_LABEL'), component)
        self._component = self.component
        self._hide_filter_on_select_change = True
        self._pending = False
        self._setup()
        self._npc_data = []
        self._card.disable()
        self._loaded_name = None
        self._sort_filter = RelSortFilter(self.component, self)
        self.on_quest_click = lambda q_id: None
        self.on_group_click = lambda gr_id: None
        self._card.on_need_spec = self._on_need_spec
        self._card.on_radio_click = lambda npc_id: self._data_provider.on_radio_click(npc_id)
        self._card.on_group_click = lambda gr_id: self.on_group_click(gr_id)
        return

    def _setup(self):
        comp = GUI.Frame2('soGUI/frame/con_frame_2.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
