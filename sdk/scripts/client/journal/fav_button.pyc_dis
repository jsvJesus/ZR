# Embedded file name: ./client/journal/fav_button.py
import GUI
from soGUI.soButton import soButton
from Localization import lc

class FavState:
    Fav, Defav, Disable = xrange(3)


class FavButton(soButton):

    def __init__(self, state_provider):
        comp = GUI.Window()
        self._state_provider = state_provider
        soButton.__init__(self, comp)
        self.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.width, comp.height = (120, 28)
        self.onClick = self._on_click
        self.onBound()
        self.click_callback = lambda : None
        self.fav_on_text = lc('GUI.QuestLog.FAVON')
        self.fav_off_text = lc('GUI.QuestLog.FAVOFF')

    def update(self):
        state = self._state_provider()
        if state == FavState.Fav:
            self.component.label.text = self.fav_on_text
            self.setDisabledState(False)
        elif state == FavState.Defav:
            self.component.label.text = self.fav_off_text
            self.setDisabledState(False)
        elif state == FavState.Disable:
            self.component.label.text = self.fav_on_text
            self.setDisabledState(True)
        else:
            raise RuntimeError

    def _on_click(self):
        self.click_callback()