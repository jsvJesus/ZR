# Embedded file name: ./client/journal/quests_tab2/taken_amount.py
import Quest
import QuestDispatcher as qd
import Constants
import colorCodes as cc

class TakenAmount(object):

    def __init__(self, text_comp):
        self._text_comp = text_comp
        self._taken_amount = 0
        self._update_text()

    def _update_text(self):
        self._text_comp.text = u'{0}/{1}'.format(self._taken_amount, Constants.QUESTS_LIMIT)
        self._text_comp.colour = cc.active_rgba if self._taken_amount < Constants.QUESTS_LIMIT else cc.red_rgba

    def on_quest_state_event(self, quest_id, prev_state, state):
        if qd.is_subquest(quest_id) or not qd.show_in_journal(quest_id) or qd.is_quest_plot(quest_id):
            return
        taken_states = (Quest.STATE_OPENED, Quest.STATE_ONTEST)
        if state in taken_states and prev_state not in taken_states:
            self.taken_amount += 1
        if state not in taken_states and prev_state in taken_states:
            self.taken_amount -= 1

    @property
    def taken_amount(self):
        return self._taken_amount

    @taken_amount.setter
    def taken_amount(self, value):
        potential_value = max(0, value)
        if self._taken_amount == potential_value:
            return
        self._taken_amount = potential_value
        self._update_text()