    def set_quest(self, quest, known_groups):
        q_id = quest['id']
        quest = qd.getQuestOnID(qd.getRootID(q_id))
        reward = quest['Reward']
        credits, expirience, personal, clanpoints = (reward['Credits'],
         reward['Expirience'],
         qd.get_tradpoints_reward(q_id),
         qd.get_clanpoints_reward(q_id))
        self.component.credits.text = unicode(credits)
        self.component.expirience.text = unicode(expirience)
        if personal:
            group_id, value = personal.items()[0]
            if group_id in known_groups['known']:
                group_name = rep_utils.get_name(group_id)
                sign = '+' if value > 0 else ''
                self.component.personal.text = u'{0} {1}{2}'.format(group_name, sign, value)
            else:
                self.component.personal.text = lc('GUI.QuestLog.Content.RewardUnknown')
        else:
            self.component.personal.text = lc('GUI.QuestLog.Content.RewardNoPersonal')
        reputation = []
        for key, value in reward.get('Reputation2', {}).items():
            if not rep_utils.is_group_hidden(key):
                reputation.append((key, value))

        text_gui = self.component.rep_container.text
        pos_y = text_gui.position[1]
        show_container = False
        enemies_data = defaultdict(list)
        for i in range(0, len(known_groups['enemies']), 2):
            gr_id = known_groups['enemies'][i]
            en_id = known_groups['enemies'][i + 1]
            enemies_data[gr_id].append(en_id)

        if reputation:
            if not known_groups['known']:
                known_groups = []
                text = u''
                enemies = defaultdict(int)
                for gr_id, value in reputation:
                    if value > 0:
                        for enemy_id in rep_utils.get_group_enemies(gr_id):
                            if gr_id not in enemies_data:
                                continue
                            if enemy_id in enemies_data[gr_id]:
                                enemies[enemy_id] += value

                    show_container = True
                    group_name = rep_utils.get_name(gr_id)
                    if value < 0:
                        text += u'{0}{1} {2}{3}\n'.format(CC.inactive_hex, group_name, '\\cff0000ff;', value)
                    else:
                        text += u'{0}{1} {2}{3}\n'.format(CC.inactive_hex, group_name, '\\c00ff00ff;+', value)

                for gr_id, value in enemies.items():
                    show_container = True
                    group_name = rep_utils.get_name(gr_id)
                    text += u'{0}{1} {2}{3}\n'.format(CC.inactive_hex, group_name, '\\cff0000ff;', -value)

                text = text.strip()
                text_gui.text = text
                pos_y += text_gui.height
            self.component.rep_container.visible = show_container
            if clanpoints and BigWorld.player().clanID:
                self.component.clanpoints.position[1] = pos_y
                self.component.clanpoints.text = u'{0} {1}'.format(lc('GUI.QuestLog.Content.ClanPoints'), clanpoints)
                self.component.clanpoints.visible = True
                pos_y += 16
            else:
                self.component.clanpoints.visible = False
            for child_name, child in self.component.items_container.children:
                child.script.send_to_pool()
                self.component.items_container.delChild(child_name)

            items, bb_names = reward['Items'], reward['blackBoxes']
            items_per_row = 6
            (items or bb_names) and pos_y += 16
        max_pos_y = pos_y
        bb_data = []
        for bb_name in bb_names:
            for group in BlackBox.readBoxInfo(bb_name)['groups']:
                bb_data.append(group)

        for i, item in enumerate(chain(items, bb_data)):
            row, column = i / items_per_row, i % items_per_row
            if i >= len(items):
                block = BlackBlock.get_block()
            else:
                block = ItemBlock.get_block()
                block.apply_item(item)
            y = pos_y + row * 78
            block.component.position = (column * 78, y, 0.5)
            self.component.items_container.addChild(block.component)
            max_pos_y = max(max_pos_y, block.component.position[1] + block.component.height)

        self.component.height = max_pos_y