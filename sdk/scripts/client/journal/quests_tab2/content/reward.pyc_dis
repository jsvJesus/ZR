class ItemBlock(Interceptor):
    pool = []

    def __init__(self, component):
        Interceptor.__init__(self, component)
        self.component = component
        self._item = None
        return

    def send_to_pool(self):
        ItemBlock.pool.append(self)

    def apply_item(self, item):
        count, item_type = item['count'], item['itemType']
        self._item = item
        icon_name = ItemsUtils.GetIconName(None, item_type=item_type) or 'nottexture.dds'
        self.component.icon.texture = BWPersonality.GUICore.get_icon_from_cache(icon_name)
        self.component.count.text = unicode(count)
        self.component.count.visible = count > 1
        return

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip()
        return Interceptor.handleMouseLeaveEvent(self, comp)

    def handleMouseEnterEvent(self, comp):
        text = cc.tf3_regular_text_color + u'???'
        if self._item:
            from Inventory import Inventory
            fake_item = ItemsUtils.CreateFakeItem(self._item['itemType'])
            try:
                ItemsUtils.SetItemNumber(fake_item, self._item['count'])
            except:
                pass

            text = Inventory.GetItemString(fake_item)
            BWPersonality.GUICore.showToolTip(cc.tf3_regular_text_color + text)
        return Interceptor.handleMouseEnterEvent(self, comp)

    @staticmethod
    def get_block():
        if ItemBlock.pool:
            return ItemBlock.pool.pop()
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (64, 64)
        component = comp
        comp = GUI.Frame2('soGUI/items/cell.dds')
        comp.materialFX = 'SOLID'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 1)
        component.addChild(comp, 'frame')
        comp = GUI.Simple('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
