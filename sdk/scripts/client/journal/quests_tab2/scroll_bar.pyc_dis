# Embedded file name: ./client/journal/quests_tab2/scroll_bar.py
import Keys
import BigWorld
import math_bw
from Helpers.PyGUI.PyGUIBase import Interceptor
import GUI
from soGUI.soButton import soButton
from Helpers.PyGUI import Utils

class EventType:
    OnMoveFactor, OnMovePos = xrange(2)


class ScrollBar(Interceptor):
    default_width = 16

    def __init__(self, component, handler, handle_height = 32):
        Interceptor.__init__(self, component)
        self._drag_tick_controller = None
        self.component.script = self
        self._handle_height = handle_height
        self._button_height = 16
        self._factor = None
        self._handler = handler
        self._drag_tick_controller = None
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/scroll_bar_1_up.xml')
        btn.setVisualState('normal')
        btn.soundControlName = 'ArrowBtn'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.width, comp.height = self.component.width, self._button_height
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.1)
        btn.onClick = self._on_up_click
        self.component.addChild(comp, 'btn_up')
        btn.onBound()
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/scroll_bar_1_down.xml')
        btn.setVisualState('normal')
        btn.soundControlName = 'ArrowBtn'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.materialFX = 'BLEND'
        comp.width, comp.height = self.component.width, self._button_height
        comp.position = (0, self.component.height, 0.1)
        btn.onClick = self._on_down_click
        self.component.addChild(comp, 'btn_down')
        btn.onBound()
        comp = GUI.Window('soGUI/elements/scroll_bar_1_slider')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.materialFX = 'BLEND'
        comp.colour = (255, 255, 255, 150)
        comp.width, comp.height = 16, self._handle_height
        comp.position = (0, 0, 0.1)
        self.component.addChild(comp, 'handle')
        return

    def set_factor(self, factor):
        disabled = factor is None
        self.component.handle.visible = not disabled
        self.component.btn_up.script.setDisabledState(disabled)
        self.component.btn_down.script.setDisabledState(disabled)
        if not disabled:
            factor = math_bw.clamp(factor)
            self._factor = factor
            comp = self.component.handle
            step = self._button_height + self._handle_height * 0.5
            comp.position[1] = (self.component.height - 2 * step) * factor + step
        return

    def _on_down_click(self):
        self._handler.on_bar_event(EventType.OnMovePos, -20)

    def _on_up_click(self):
        self._handler.on_bar_event(EventType.OnMovePos, 20)

    def _drag_tick(self):
        if not BigWorld.isKeyDown(Keys.KEY_LEFTMOUSE):
            self._stop_tick()
            return
        if not Utils.is_visible_in_hierarchy(self.component):
            self._stop_tick()
            return
        pos = GUI.mcursor().position
        height = self.component.screenToLocal((pos[0], pos[1]))[1]
        step = self._button_height
        ratio = float(height - step) / (self.component.height - 2 * step)
        ratio = math_bw.clamp(ratio)
        step = self._button_height + self._handle_height * 0.5
        ratio = math_bw.clamp(float(height - step) / (self.component.height - 2 * step))
        stop_tick_request = self._handler.on_bar_event(EventType.OnMoveFactor, ratio)
        if not stop_tick_request:
            self._drag_tick_controller = BigWorld.callback(0, self._drag_tick)

    def _stop_tick(self):
        if self._drag_tick_controller:
            BigWorld.cancelCallback(self._drag_tick_controller)
        self._drag_tick_controller = None
        return

    def handleMouseButtonEvent(self, component, event):
        self._stop_tick()
        if not event.isRepeatedEvent() and event.isKeyDown() and event.key == Keys.KEY_LEFTMOUSE:
            self._drag_tick()
        return Interceptor.handleMouseButtonEvent(self, component, event)

    def handleMouseEvent(self, component, event):
        was_ticking = bool(self._drag_tick_controller)
        self._stop_tick()
        if BigWorld.isKeyDown(Keys.KEY_LEFTMOUSE) and was_ticking:
            self._drag_tick()
        return Interceptor.handleMouseEvent(self, component, event)