            component.isClip = False
        return component

    def on_destroy(self):
        for _, child in self.component.subs.children:
            child.btn.script.onClick = lambda : None
            _sub_comps_pool.append(child)
            self.component.subs.delChild(child)

        self._inited = False
        self._callback_listener = None
        self._item_data.set_callback_listener(None)
        self._item_data = None
        _comps_pool.append(self)
        return

    @staticmethod
    def evaluate_height(item_data):
        height = ViewComp.line_height
        if item_data._expanded:
            if not item_data._subs:
                height += ViewComp.empty_height
            else:
                height += len(item_data._subs) * ViewComp.line_height
        return height

    @staticmethod
    def get_component(width, item_data, event_handler):
        if _comps_pool:
            view_comp = _comps_pool.pop()
        else:
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = width, 0
            view_comp = ViewComp(comp)
        view_comp.initialize(item_data, event_handler)
        return view_comp

    @staticmethod
    def is_fav(quest_id):
        return BigWorld.player()._quests_tracker.is_tracking(quest_id)


_comps_pool = []
