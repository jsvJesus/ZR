    def initialize(self, item_data, callback_listener):
        self._callback_listener = callback_listener
        self._item_data = item_data
        self._item_data.set_callback_listener(self._on_item_data_event)
        self._update_visual()
        self._inited = True
        if self._item_data._q_id is None:
            self._callback_listener(EventType.EmptyVisible, self)
        return

    def _on_item_data_event(self, event_type, data):
        if event_type in (IdET.OnExpandedChanged,
         IdET.OnSubsChanged,
         IdET.OnSelectedChanged,
         IdET.OnReadChanged):
            self._update_visual()

    def _check_dbl_click(self):
        prev_last_click_time = self._last_click_time
        self._last_click_time = BigWorld.time()
        if self._last_click_time - prev_last_click_time < 0.5:
            return True
        return False

    def _on_click(self):
        if self._check_dbl_click():
            quest_id = self._item_data._q_id
            if quest_id:
                has_chapters = bool(qd.get_chapters(quest_id))
                if has_chapters:
                    if self._item_data.expanded:
                        self._on_up_click()
                    else:
                        self._on_down_click()
        else:
            self._callback_listener(EventType.OnClick, self)

    def _on_sub_click(self, sub_id):
        if self._check_dbl_click():
            return
        data = {'comp': self,
         'sub_id': sub_id}
        self._callback_listener(EventType.OnSubClick, data)

    def _on_up_click(self):
        self._callback_listener(EventType.OnUpClick, self)

    def _on_down_click(self):
        self._callback_listener(EventType.OnDownClick, self)

    def _update_visual(self):
        self.component.load_pips.visible = False
        self.component.btn_up.visible = False
        self.component.btn_down.visible = False
        self.component.subs.visible = False
        self.component.btn.frame.visible = False
        self.component.pip.visible = False
        self.component.pip_changed.visible = False
        height = ViewComp.line_height
        for _, child in self.component.subs.children:
            child.btn.script.onClick = lambda : None
            _sub_comps_pool.append(child)
            self.component.subs.delChild(child)

        quest_id = self._item_data._q_id
        if quest_id:
            priority = qd.get_priority(quest_id)
            self.component.priority.visible = True
            self.component.priority.textureName = 'soGUI/frame/journal/priorities_pics/cast{0}.dds'.format(priority)
            self.component.btn.label.elideText(qd.getQuestTitleByID(quest_id), 220)
            self.component.btn.visible = True
            btn = self.component.btn.script
            if ViewComp.is_fav(quest_id):
                btn.initVSC('soGUI/elements/questTitleListFav.xml')
            else:
                btn.initVSC('soGUI/elements/questTitleListElement.xml')
            btn.setVisualState('normal')
            btn.onBound()
            if self._item_data.selection:
                toggled = self._item_data.selection == quest_id
                self.component.btn.script.buttonActive = toggled
                self.component.btn.script.setToggleState(toggled)
                has_chapters = bool(qd.get_chapters(quest_id))
                if has_chapters:
                    self.component.btn.frame.visible = True
                    if self._item_data.expanded:
                        self.component.btn_up.visible = True
                        if self._item_data._subs is None:
                            height += ViewComp.empty_height
                            self._callback_listener(EventType.EmptySubsVisible, self)
                        elif not self._item_data._subs:
                            height += ViewComp.empty_height
                        else:
                            pos_y = 0
                            for sub_id in self._item_data._subs:
                                comp = self._create_sub_comp()
                                comp.position = (-1, pos_y, 0.5)
                                comp.btn.label.elideText(qd.getQuestTitleByID(sub_id), 206)
                                comp.btn.script.onClick = partial(self._on_sub_click, sub_id)
                                if self._item_data.selection:
                                    toggled = self._item_data.selection == sub_id
                                    comp.btn.script.buttonActive = toggled
                                    comp.btn.script.setToggleState(toggled)
                                    btn = comp.btn.script
                                    if ViewComp.is_fav(sub_id):
                                        btn.initVSC('soGUI/elements/questListFav.xml')
                                    else:
                                        btn.initVSC('soGUI/elements/questListElement.xml')
                                    read_status = self._item_data.get_read_status(sub_id)
                                    comp.pip.visible = False
                                    comp.pip_changed.visible = False
                                    if read_status == ReadStatus.New:
                                        comp.pip.visible = True
                                    comp.pip_changed.visible = read_status == ReadStatus.Changed and True
                                btn.setVisualState('normal')
                                btn.onBound()
                                self.component.subs.addChild(comp)
                                pos_y += ViewComp.line_height

                            self.component.subs.visible = True
                            self.component.subs.height = pos_y
                            height += self.component.subs.height
                    else:
                        self.component.btn_down.visible = True
                        if self._item_data._subs is None:
                            BigWorld.callback(0, self._on_down_click)
                read_status = self._item_data.get_read_status()
                if read_status == ReadStatus.New:
                    self.component.pip.visible = True
                elif read_status == ReadStatus.Changed:
                    self.component.pip_changed.visible = True
            else:
                self.component.btn.visible = False
                self.component.load_pips.visible = True
                self.component.priority.visible = False
            if self.component.height != height:
                self.component.height = height
                self._inited and self._callback_listener(EventType.HeightChanged, self)
        return

