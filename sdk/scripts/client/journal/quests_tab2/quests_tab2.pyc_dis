    def _on_quests_tracker_event(self, event_type, data):
        if event_type == QuestTrackerET.OnStopTrack:
            self._fav_button.update()
        self._view.on_quests_tracker_event(event_type, data)

    def _get_fav_state(self):
        quest_data = self._content.get_quest_data()
        if not quest_data:
            return FavState.Disable
        quest_state, quest_id = quest_data['state'], quest_data['id']
        if not quest_id or quest_state not in (Quest.STATE_OPENED, Quest.STATE_ONTEST):
            return FavState.Disable
        elif self._quests_tracker.is_tracking(quest_id):
            return FavState.Defav
        elif qd.is_marked_as_chapter(quest_data['id']):
            return FavState.Disable
        elif self._quests_tracker.can_track_more():
            return FavState.Fav
        else:
            return FavState.Disable

    def _on_fav_click(self):
        quest_data = self._content.get_quest_data()
        if not quest_data:
            return
        quest_state, quest_id = quest_data['state'], quest_data['id']
        if not quest_id:
            return
        if quest_state not in (Quest.STATE_OPENED, Quest.STATE_ONTEST):
            return
        if quest_id != self._dp.find_first_selection():
            return
        if self._quests_tracker.is_tracking(quest_id):
            self._quests_tracker.stop_track(quest_id)
        else:
            self._quests_tracker.start_track(quest_id)
        self._fav_button.update()

    def mark_quest_status(self, quest_id, status):
        self._dp.mark_read_status(quest_id, status)

    def _on_content_event(self, event_type, data):
        if event_type == ContentET.OnNameClick:
            self.on_npc_click_callback(data)
        elif event_type == ContentET.OnMapClick:
            self.on_map_click_callback(data)
        elif event_type == ContentET.IgnoreState:
            self._last_visible_quest_id = None
            self._show_last_quest_if_needed()
        elif event_type == ContentET.OnQuestDataChanged:
            self._fav_button.update()
            if self._content.selected_quest_id:
                BigWorld.player().mark_quest_as_read(self._content.selected_quest_id)
        return

    def on_sortfilter_event(self, event_type):
        if event_type == SfET.OnModeChanged:
            self._last_visible_quest_id = self._content.selected_quest_id
            self._dp.clear()
            self._server.cancel_all_requests()
        elif event_type == SfET.OnVisibleChanged:
            self._update_content_filter_visibility()

    def _update_content_filter_visibility(self):
        self.component.content_holder.visible = not self._sort_filter.visible

    def force_quest(self, quest_id):
        self._last_visible_quest_id = quest_id

    def on_show(self):
        self._quests_tracker.add_listener(self._on_quests_tracker_event)
        BigWorld.player().subscribe_all_quests_changes((self._on_quest_state_event, self._on_quest_internal_event), self)
        self._dp.clear()
        self._view.on_show()
        self._content.set_quest_id(self._last_visible_quest_id, ignore_state=False)
        self._content.on_show()
        self._update_content_filter_visibility()
        self._fav_button.update()

    def on_hide(self):
        self._quests_tracker.remove_listener(self._on_quests_tracker_event)
        self._server.cancel_all_requests()
        self._view.on_hide()
        self._content.on_hide()
        self._last_visible_quest_id = self._content.selected_quest_id
        BigWorld.player().unsubscribe_all_quests_changes(self)

    def _on_quest_state_event(self, quest_id, prev_state, state):
        self._server.on_quest_state_event(quest_id, prev_state, state, self._sort_filter.mode)
        self._content.on_quest_state_event(quest_id, prev_state, state)
        self._taken_amount.on_quest_state_event(quest_id, prev_state, state)

    def _on_quest_internal_event(self, quest_id, int_data):
        self._content.on_quest_internal_event(quest_id, int_data)

    def _on_view_event(self, event_type, data):
        if event_type == ViewET.OnEmptyItemVisible:
            unique_id = data['unique_id']
            context_ids = self._dp.get_item_context(unique_id)
            if context_ids == (0, 0) and self._last_visible_quest_id:
                context_ids = (self._last_visible_quest_id, self._last_visible_quest_id)
            self._server.load_data(context_ids, unique_id, self._sort_filter.mode)
        if event_type == ViewET.OnEmptySubsVisible:
            unique_id, quest_id = data['unique_id'], data['quest_id']
            self._server.load_subs(quest_id, unique_id, self._sort_filter.mode)
        elif event_type == ViewET.OnExpandClick:
            unique_id = data['unique_id']
            self._dp.set_item_expanded(unique_id, True)
        elif event_type == ViewET.OnCollapseClick:
            unique_id = data['unique_id']
            self._dp.set_item_expanded(unique_id, False)
        elif event_type == ViewET.OnItemClick:
            unique_id, quest_id = data['unique_id'], data['quest_id']
            self._dp.set_selection(unique_id, quest_id)
            self._last_visible_quest_id = quest_id
            self._content.set_quest_id(quest_id)
            self._sort_filter.switch_off()
            self._fav_button.update()

    def _on_server_event(self, event_type, data):
        self._intro_comp.visible = False
        if event_type == ServerET.OnDataLoaded:
            unique_id, chapters, taken_amount = data['unique_id'], data['chapters'], data['taken_amount']
            self._dp.replace_empty_data(unique_id, chapters, self._last_visible_quest_id)
            self._taken_amount.taken_amount = taken_amount
            self._fav_button.update()
        elif event_type == ServerET.OnSubsLoaded:
            unique_id, sub_ids = data['unique_id'], data['sub_ids']
            self._dp.set_subs_data(unique_id, sub_ids)
        elif event_type == ServerET.OnVisibleChanged:
            quest_id, visible, main_visible = data['quest_id'], data['visible'], data['main_visible']
            if qd.is_subquest(quest_id):
                return
            sort_filter = self._sort_filter.mode
            sort_mode = sort_filter['sort']

            def sort_title_up_comparator(q_id1, q_id2):
                p1 = qd.get_priority(q_id1)
                p2 = qd.get_priority(q_id2)
                if p1 == p2:
                    return qd.getQuestTitleByID(q_id1) < qd.getQuestTitleByID(q_id2)
                else:
                    return p1 < p2

            def sort_title_down_comparator(q_id1, q_id2):
                p1 = qd.get_priority(q_id1)
                p2 = qd.get_priority(q_id2)
                if p1 == p2:
                    return qd.getQuestTitleByID(q_id1) > qd.getQuestTitleByID(q_id2)
                else:
                    return p1 < p2

            def sort_time_up_comparator(q_id1, q_id2):
                p1 = qd.get_priority(q_id1)
                p2 = qd.get_priority(q_id2)
                if p1 == p2:
                    return False
                else:
                    return p1 < p2

            def sort_time_down_comparator(q_id1, q_id2):
                p1 = qd.get_priority(q_id1)
                p2 = qd.get_priority(q_id2)
                if p1 == p2:
                    return True
                else:
                    return p1 < p2

            if sort_mode == SM.TitleUp:
                comparator = sort_title_up_comparator
            elif sort_mode == SM.TitleDown:
                comparator = sort_title_down_comparator
            elif sort_mode == SM.TimeUp:
                comparator = sort_time_up_comparator
            elif sort_mode == SM.TimeDown:
                comparator = sort_time_down_comparator
            else:
                raise NotImplementedError
            undefined_deletion = [None]

            def insert_sub(main_quest_id, quest_id):
                main_index = self._dp.get_index_by_quest_id(main_quest_id)
                if main_index is None:
                    return False
                else:
                    main_item = self._dp._data[main_index]
                    index = None
                    if main_item._subs is None:
                        return True
                    if quest_id in main_item._subs:
                        return True
                    for i, sub_id in enumerate(main_item._subs):
                        if comparator(quest_id, sub_id):
                            index = i
                            break
                    else:
                        index = len(main_item._subs)

                    if index is not None:
                        self._dp.insert_sub(main_index, index, quest_id)
                    return True

            def insert_chapter(quest_id):
                index = None
                for i, item_data in enumerate(self._dp._data):
                    if item_data._q_id is None:
                        continue
                    if item_data._q_id == quest_id:
                        return
                    if comparator(item_data._q_id, quest_id) and index is None:
                        index = i

                if index is None:
                    if self._dp._data:
                        if self._dp._data[-1]._q_id:
                            index = len(self._dp._data)
                    else:
                        index = 0
                if index is not None:
                    self._dp.insert_data(index, quest_id)
                return

            def remove_chapter(quest_id):
                main_index = self._dp.get_index_by_quest_id(quest_id)
                if main_index is None:
                    return
                else:
                    main_item = self._dp._data[main_index]
                    if main_item._subs:
                        return
                    if main_item._subs is not None:
                        self._dp.remove_quest_id(quest_id)
                    else:
                        undefined_deletion[0] = quest_id
                    return

            def remove_sub(main_quest_id, quest_id):
                main_index = self._dp.get_index_by_quest_id(main_quest_id)
                if main_index is not None:
                    main_item = self._dp._data[main_index]
                    if main_item._subs and quest_id in main_item._subs:
                        self._dp.remove_sub(main_index, quest_id)
                    if not main_item._subs:
                        undefined_deletion[0] = main_quest_id
                return

            main_quest_id = qd.get_main(quest_id)
            if visible:
                if main_quest_id:
                    if not insert_sub(main_quest_id, quest_id):
                        insert_chapter(main_quest_id)
                else:
                    insert_chapter(quest_id)
            elif main_quest_id:
                remove_sub(main_quest_id, quest_id)
            else:
                remove_chapter(quest_id)
            if undefined_deletion[0]:
                if not main_visible:
                    self._dp.remove_quest_id(undefined_deletion[0])
        self._show_last_quest_if_needed()
        return

    def _show_last_quest_if_needed(self):
        if not self.get_selected_quest_id() and not self._last_visible_quest_id:
            if self._dp._data:
                if self._dp._data[0]:
                    unique_id, quest_id = self._dp._data[0]._unique_id, self._dp._data[0]._q_id
                    if quest_id:
                        self._dp.set_selection(unique_id, quest_id)
                        self._last_visible_quest_id = quest_id
                        self._content.set_quest_id(quest_id)
                        self._fav_button.update()
            else:
                self._intro_comp.visible = True

    @property
    def _quests_tracker(self):
        return BigWorld.player()._quests_tracker

    def get_selected_quest_id(self):
        return self._content.selected_quest_id