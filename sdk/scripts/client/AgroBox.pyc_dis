# Embedded file name: ./client/AgroBox.py
import BigWorld
from Localization import lc
from BoxStatus import BoxStatus
from MovableBox import MovableBox
from Helpers.Caps import CAP_INTERACT

class AgroBox(MovableBox):

    def __init__(self):
        MovableBox.__init__(self)
        self._model_path = ''
        self.name = lc(BoxStatus.get_name_by_type(self.box_type))
        self.update_model()

    def on_death(self):
        pass

    def set_dead(self, old_value):
        if self.dead:
            pass

    def set_status(self, old_value):
        self.update_model()
        self.update_targetCaps()

    def update_targetCaps(self):
        self.targetCaps = [CAP_INTERACT] if self.visible and self.status != BoxStatus.DEAD else []

    def can_interact(self):
        if self.status == BoxStatus.DEAD:
            return False
        return MovableBox.can_interact(self)

    def get_model_path(self):
        return BoxStatus.get_model_by_type(self.box_type, self.status)

    def update_model(self):

        def on_load(model):
            if self.isDestroyed:
                return
            self.model = model
            self.setObstacle(self.visible)

        BigWorld.fetchModel(self.get_model_path(), on_load)

    def get_interaction_dist(self):
        return 2

    def onBoarHit(self, damager):
        pass