# Embedded file name: ./client/CellListener.py
import BigWorld

class CellListener:
    _subscribed_visobjects = {}
    _last_notify_time = {}

    def on_marks_update_tick(self):
        if not self._subscribed_visobjects:
            return
        entity = BigWorld.target()
        if not entity or entity.isDestroyed:
            return
        if not hasattr(entity, 'get_observe_visible_quest_object_type'):
            return
        object_type = entity.get_observe_visible_quest_object_type()
        if object_type not in self._subscribed_visobjects:
            return
        object_hash = entity.get_observe_visible_quest_object_hash()
        if object_hash not in self._subscribed_visobjects[object_type]:
            return
        self._on_needed_obj_visible(object_type, object_hash)

    def _on_needed_obj_visible(self, object_type, object_hash):
        if BigWorld.time() - self._last_notify_time[object_hash] > 3:
            self._last_notify_time[object_hash] = BigWorld.time()
            self.base.on_client_visobject_event(object_type, object_hash)

    def subscribe_visible_objects(self, object_type, object_hash):
        if not self._subscribed_visobjects:
            self._subscribed_visobjects = {}
        if not self._last_notify_time:
            self._last_notify_time = {}
        self._last_notify_time[object_hash] = 0
        if object_type not in self._subscribed_visobjects:
            self._subscribed_visobjects[object_type] = set()
        self._subscribed_visobjects[object_type].add(object_hash)

    def unsubscribe_visible_objects(self, object_type, object_hash):
        self._subscribed_visobjects[object_type].remove(object_hash)
        if not self._subscribed_visobjects[object_type]:
            del self._subscribed_visobjects[object_type]
        del self._last_notify_time[object_hash]