# Embedded file name: ./client/soHightMessage.py
import GUI
import math
import BigWorld
import BWPersonality
import colorCodes as cc
import Helpers.PyGUI as PyGUI
from Constants import MESSAGE_TYPES as MT
from soGUI.soTextField import soTextField3
ICONS = {MT.QUEST: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/quest.dds'),
 MT.LOCATION: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/location.dds'),
 MT.SYSTEM: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/system.dds'),
 MT.SUCCESS: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/success.dds'),
 MT.FAIL: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/fail.dds'),
 MT.DUNGEON: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/dungeon.dds'),
 MT.PERSONAL: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/personal.dds'),
 MT.SPECIAL: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/special.dds'),
 MT.CLAN: BigWorld.PyTextureProvider('soGUI/maps/Icons/messages/speaker.dds')}
COLORS = {MT.QUEST: (255, 133, 0, 255),
 MT.LOCATION: (255, 255, 255, 255),
 MT.SYSTEM: (255, 255, 255, 255),
 MT.SUCCESS: (0, 255, 0, 255),
 MT.FAIL: (255, 9, 9, 255),
 MT.DUNGEON: (0, 234, 255, 255),
 MT.PERSONAL: (255, 255, 255, 255),
 MT.SPECIAL: (255, 215, 77, 255),
 MT.CLAN: (255, 255, 255, 255)}

def get_icon(message_type):
    return ICONS.get(message_type, None)


def get_color(message_type):
    return COLORS.get(message_type, (255, 255, 255, 255))


class HighMessageWindow(PyGUI.PyGUIBase):
    factoryString = 'highmessage'

    def __init__(self):
        component = GUI.Window()
        PyGUI.PyGUIBase.__init__(self, component)
        self.callback_id = None
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 512
        cmp.height = 128
        cmp.position = (0.0, 0.5, 0.1)
        cmp.textureName = ''
        cmp.visible = False
        cmp.colour = (255, 255, 255, 0)
        self.setup_content()
        return

    def setup_content(self):
        self._show_shader = GUI.AlphaShader()
        self._show_shader.mode = 'ALL'
        self._show_shader.speed = 0.4
        self.component.addShader(self._show_shader)
        cmp = GUI.Frame2('soGUI/frame/frame_massage_left.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 1
        cmp.height = 1
        cmp.position = (0, 0, 1.2)
        self.component.addChild(cmp, 'frame_left')
        cmp = GUI.Frame2('soGUI/frame/frame_massage_right.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 1
        cmp.height = 1
        cmp.position = (0, 0, 1.2)
        self.component.addChild(cmp, 'frame_right')
        self.txt = GUI.Text(u'', 'RobotoCondensedShadow_18.font')
        self.txt.colour = (255, 255, 255, 255)
        self.txt.hpm, self.txt.vpm = ('CLIP', 'CLIP')
        self.txt.ha, self.txt.va = ('CENTER', 'TOP')
        self.txt.position = (0, 0, 0)
        self.txt.visible = True
        tf = soTextField3(GUI.Window(), 700, 700, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        cmp = tf.component
        cmp.horizontalPositionMode, cmp.verticalPositionMode = ('CLIP', 'PIXEL')
        cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'TOP')
        cmp.widthMode, cmp.heightMode = ('PIXEL', 'PIXEL')
        cmp.colour = (255, 255, 255, 255)
        cmp.position = (0, 37, 0.3)
        cmp.focus = False
        cmp.moveFocus = False
        self.component.addChild(cmp, 'message')
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 125)
        cmp.materialFX = 'BLEND'
        cmp.width = 24
        cmp.height = 24
        cmp.position = (0, 6, 0.4)
        self.component.addChild(cmp, 'icon')

    def update_dimentions(self, width, height):
        self.component.width = width
        self.component.height = height
        self.component.frame_left.width = width / 2
        self.component.frame_right.width = width / 2
        self.component.frame_left.height = height
        self.component.frame_right.height = height
        self.component.frame_left.position.x = width / 2
        self.component.frame_right.position.x = width / 2
        self.component.message.script.textWidth = width

    def show_text(self, text, message_type = 0, show_time = 4):
        if self.callback_id:
            BigWorld.cancelCallback(self.callback_id)
            self.callback_id = 0
        if self.component.parent is None:
            BWPersonality.GUICore.flashWorldLayer.addChild(self.component, self.factoryString)
        self.component.visible = True
        text_lines = text.split('\n')
        text_width = 180
        text_height = 22
        for i in text_lines:
            width, text_height = self.txt.stringDimensions(i)
            text_width = max(text_width, width)

        lines = math.ceil(text_width / 750.0)
        lines += len(text_lines)
        width = min(800, max(text_width + 60, 180))
        if width % 2:
            width += 1
        height = lines * text_height + 55
        self.component.icon.texture = get_icon(message_type)
        self.update_dimentions(width, height)
        colour = get_color(message_type)
        self.component.icon.colour = colour
        self.component.message.script.setText(u'<font=RobotoCondensedShadow_18.font>{0}<alignment=center>'.format(cc.rgba_to_xml(colour)) + text)
        self._show_shader.alpha = 0
        self._show_shader.reset()
        self._show_shader.alpha = 1
        self.callback_id = BigWorld.callback(show_time, self.hide_text)
        return

    def hide_text(self):
        if self.callback_id:
            BigWorld.cancelCallback(self.callback_id)
            self.callback_id = 0
        self._show_shader.alpha = 1
        self._show_shader.reset()
        self._show_shader.alpha = 0
        self.component.message.script.setText('')