# Embedded file name: ./client/cloth_paint_interface.py
import BigWorld
import BWPersonality
import steam_client_api
import UCManager
import DyeConstant
from utils import PY

class ClothPaintInterface:

    def __init__(self):
        self.avatar_paint_info = {}
        self.__stored_consumables = None
        self.__prev_avatar_dbid = None
        return

    def loadPaintData(self, avatar_dbid):
        print '--> avatar_dbid', avatar_dbid
        self.base.requestAvatarClothInventory(avatar_dbid)
        self.__stored_consumables = None
        self.__prev_avatar_dbid = avatar_dbid
        self.avatar_paint_info.pop(avatar_dbid, None)
        if self.isSteamAcc():
            self.getStoreHouseItems()
        return

    def onPaintNotify(self, msg_id):
        print 'onPaintNotify', msg_id
        paint_screen = BWPersonality.GUICore._menu_paint_screen
        if paint_screen and paint_screen.visible:
            paint_screen.on_paint_event(msg_id)
        if BWPersonality.GUICore.is_equip_paint_screen_visible():
            BWPersonality.GUICore._equip_paint_screen.on_paint_event(msg_id)

    def paintCloth(self, *args):
        print 'paintCloth', args
        self.base.paintCloth(*args)

    def onLoadPaintData(self, avatar_dbid, data):
        print 'onLoadPaintData', BigWorld.time(), avatar_dbid
        print 'inventory_consumables', PY(data['inventory_consumables'])
        print 'consumables', PY(data['consumables'])
        data = dict(data)
        self.setAvatarConsumables(avatar_dbid, data['inventory_consumables'])
        self.avatar_paint_info[avatar_dbid] = dict(data)
        if self.isSteamOrMGAcc():
            data['consumables'] = self.getAccountConsumables()
            print 'steam consumables', PY(data['consumables'])
        print '-----------\n'
        if self.__prev_avatar_dbid == avatar_dbid:
            BWPersonality.GUICore.menu_paint_screen.load_paint_result(avatar_dbid, data)
        if BWPersonality.GUICore.is_equip_paint_screen_visible():
            BWPersonality.GUICore._equip_paint_screen.load_paint_result(avatar_dbid, data)

    def onAvatarEmblemsReady(self, avatar_dbid, standard_emblems, personal_emblems):
        print 'onAvatarEmblemsReady', avatar_dbid, standard_emblems, personal_emblems

    def onEmblemEventFromAvatar(self, avatar_dbid, event_id, msg):
        print 'onEmblemEventFromAvatar', avatar_dbid, event_id, msg
        UCManager.ucmanager.onBWEmblemEvent(event_id, msg)

    def emblemServerEvent(self, event_id, msg):
        print 'emblemServerEvent', [event_id, msg]
        avatar_dbid = self.current_character_dbid()
        self.base.emblemServerEvent(avatar_dbid, event_id, msg, DyeConstant.TO_ACCOUNT)

    def getMyEmblems(self):
        avatar_dbid = self.current_character_dbid()
        self.base.requestAvatarEmblems(avatar_dbid)