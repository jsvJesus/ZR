# Embedded file name: ./client/AvatarDummyModelLoader.py
import BigWorld
import StalkerModel

class AvatarDummyModelLoader:
    """ \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x83 \xd0\xb7\xd0\xb0\xd0\xb3\xd1\x80\xd1\x83\xd0\xb7\xd0\xba\xd1\x83 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb5\xd0\xb9 \xd0\xb2 \xd1\x84\xd0\xbe\xd0\xbd\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f AvatarDummy
    """
    HEAD_ZONE_MODEL_PATH = 'characters2/clothing/ManNude/HeadZone/ManHeadZone.model'
    CACHE_LIMIT = 15
    USE_CACHE = True

    def __init__(self, dummy):
        self._cache = {}
        self._dummy = dummy
        self._characters_cached = False

    def get_model(self, callback, force_hide_slots = None, force_hide_modes = None):
        if self._dummy.model and AvatarDummyModelLoader.USE_CACHE:
            for m in list(self._dummy.model.motors):
                self._dummy.model.delMotor(m)

            while len(self._cache) >= AvatarDummyModelLoader.CACHE_LIMIT:
                del self._cache[self._cache.keys()[0]]

            self._cache[self._dummy.model.sources] = self._dummy.model
        additional_models = [AvatarDummyModelLoader.HEAD_ZONE_MODEL_PATH]
        StalkerModel.ComposePlayerModelTraker(self._dummy, callback=callback, additional_models=additional_models, force_hide_slots=force_hide_slots, force_hide_modes=force_hide_modes, ready_model=None)
        if not self._characters_cached and AvatarDummyModelLoader.USE_CACHE:
            self._load_all_characters_to_cache(self._dummy.name)
        return

    def _load_all_characters_to_cache(self, exclude_name):
        if not BigWorld.player():
            return
        self._characters_cached = True

        def on_model_loaded(model):
            self._cache[model.sources] = model

        for char_list in BigWorld.player().characterList:
            if char_list['name'] == exclude_name:
                continue
            model_lst = StalkerModel.compose_player_model_list(AvatarImitator(char_list), [AvatarDummyModelLoader.HEAD_ZONE_MODEL_PATH])['models']
            BigWorld.fetchModel(*(model_lst + [on_model_loaded]))

    def clear_cache(self):
        self._cache.clear()


class AvatarImitator(object):

    def __init__(self, char_list):
        self._char_list = char_list

    @property
    def EquippedArmor(self):
        return self._char_list.equippedArmor

    @property
    def EquipModes(self):
