# Embedded file name: ./client/Vivert.py
import BigWorld
import traceback
from vivert_common.vivert_utils import model_path, EventType as VET
from vivert_client.vivert_filter import VivertFilter, EventType as FEV
from vivert_client.vivert_animator import VivertAnimator
from vivert_client.vivert_debugger import VivertDebugger

class Vivert(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._filter = VivertFilter(self)
        self._filter.add_listener(self._on_filter_event)
        self._animator = VivertAnimator(self)
        self._debugger = VivertDebugger(self)
        print '  ZIM: vivert created on client', self.id

    def prerequisites(self):
        return [model_path]

    def onEnterWorld(self, prereqs):
        self.model = prereqs[model_path]

    def _on_filter_event(self, event_type, data):
        if event_type == FEV.OnTick:
            try:
                self._debugger.on_tick()
                self._animator.on_tick()
            except:
                traceback.print_exc()
                traceback.print_stack()
                self._filter.remove_listener(self._on_filter_event)

    def run_debug_command(self, command, str_data):
        pass

    def notify_event(self, event_type):
        if event_type == VET.OnStrikeStarted:
            self._animator.draw_strike()

    def get_height_idle_scaled(self):
        return 0.5