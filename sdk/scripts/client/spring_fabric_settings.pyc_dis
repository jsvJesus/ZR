for key, value in _weapon_clother_displacement.items():
    del _weapon_clother_displacement[key]
    _weapon_clother_displacement[os.path.normpath(key)] = value

class Config():

    def __init__(self):
        self._data = defaultdict(list)
        for key, value in _weapon_configs.items():
            if key == 'default_config':
                continue
            config_copy = _weapon_configs['default_config'].copy()
            config_copy.update(value)
            _weapon_configs[key] = config_copy

        for conf in _configs:
            path = conf['model'].lower().replace('\\', '/')
            self._data[path].append(conf)

    def get(self, model_path):
        model_path = model_path.lower().replace('\\', '/')
        return self._data.get(model_path, [])

    def get_weapon(self, tag):
        return _weapon_configs.get(tag)

    def get_weapon_displacement(self, model):
        """ \xd1\x81\xd0\xbc. \xd1\x82\xd0\xb8\xd0\xba\xd0\xb5\xd1\x82 http://hz-dev.stalker.so:8090/issues/7803"""
        slot_names = ('weaponback', 'weaponback2', 'belly')
        result = {}
        for slot_name in slot_names:
            result[slot_name] = []

        for norm_path in [ os.path.normpath(path) for path in model.sources ]:
            if norm_path not in _weapon_clother_displacement:
                continue
            cloth_data = _weapon_clother_displacement[norm_path]
            for slot_name in slot_names:
                if slot_name in cloth_data:
                    result[slot_name].append(cloth_data[slot_name])

        delegates = {'weaponback': (max,
                        max,
                        max,
                        max,
                        min,
                        max),
         'weaponback2': (max,
                         min,
                         max,
                         max,
                         max,
                         min),
         'belly': (max,
                   max,
                   min,
                   max,
                   max,
                   max)}

        def add_nums(n1, n2, delegate = None):
            if n1 is None:
                return n2
            elif n2 is None:
                return n1
            elif delegate:
                return delegate(n1, n2)
            else:
                return n1 + n2
                return

        def add_vectors(v1, v2, delegate = None):
            if v1 is None:
                return v2
            elif v2 is None:
                return v1
            else:
                return [ add_nums(v1[i], v2[i], delegate and delegate[i]) for i in xrange(3) ]

        def sum_data(res, data, delegate):
            translation_disp = data.get('translation_disp')
            if translation_disp is not None:
                res['translation_disp'] = add_vectors(res['translation_disp'], translation_disp, delegate[:3])
            rotation_disp = data.get('rotation_disp')
            if rotation_disp is not None:
                res['rotation_disp'] = add_vectors(res['rotation_disp'], rotation_disp, delegate[3:])
            translation_add = data.get('translation_add')
            if translation_add is not None:
                res['translation_disp'] = add_vectors(res['translation_disp'], translation_add)
            return

        def average_data(disp_data, delegate):
            res = {'translation_disp': None,
             'rotation_disp': None}
            for data in disp_data:
                sum_data(res, data, delegate)

            if res['translation_disp'] is None:
                res['translation_disp'] = Vector3()
            if res['rotation_disp'] is None:
                res['rotation_disp'] = Vector3()
            for i in xrange(3):
                if res['translation_disp'][i] is None:
                    res['translation_disp'][i] = 0
                if res['rotation_disp'][i] is None:
                    res['rotation_disp'][i] = 0

            res['translation_disp'] = Vector3(res['translation_disp'])
            res['rotation_disp'] = Vector3(res['rotation_disp'])
            return res

        for slot_name in slot_names:
            result[slot_name] = average_data(result[slot_name], delegates[slot_name])

        return result


spring_fabric_config = Config()