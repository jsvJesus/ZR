# Embedded file name: ./client/TransformDroppedBox.py
import BigWorld
import traceback
from TransformDroppedConst import MODEL_BY_TYPE
from TransformDroppedConst import MARK_NAME_BY_TYPE
from TransformDroppedConst import SCALE_BY_TYPE
from Helpers.Caps import CAP_INTERACT
from Localization import lc

class TransformDroppedBox(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.filter = BigWorld.NoneFilter()
        self.targetCaps = [CAP_INTERACT]

    def prerequisites(self):
        return [self._model_path()]

    def _model_path(self):
        return MODEL_BY_TYPE[self.transform_type]

    def onEnterWorld(self, prereqs):
        try:
            self.model = prereqs[self._model_path()]
            self.model.isObstacle = True
        except:
            print '\nERROR', self, repr(self._model_path())
            self.model = BigWorld.Model('models/bolvan/helpers/anomaly_field_error.model')
            traceback.print_exc()

        if self.transform_type in SCALE_BY_TYPE:
            sc = SCALE_BY_TYPE[self.transform_type]
            self.model.scale = (sc, sc, sc)
            self.model.newScaleTest = (sc, sc, sc)

    def interact(self, player):
        self.cell.interact()

    def get_mark_name(self):
        return lc(MARK_NAME_BY_TYPE[self.transform_type])

    def onLeaveWorld(self):
        self.model = None
        return