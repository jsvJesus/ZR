    def rand_supermodel(self):
        has_armor = random.random() > 0.5
        has_bodywoh = random.random() > 0.5
        has_suite = random.random() > 0.8
        has_backpak = random.random() > 0.4
        if has_suite:
            has_armor = False
            has_backpak = False
        body = [self.BASE]
        body.append(get_rand_m(self.HEADS))
        if has_suite:
            if random.random() > 0.8:
                body.append(get_rand_m(self.SUITE_WITHOUT_HAND))
                body.append(get_rand_m(self.HANDS))
            else:
                body.append(get_rand_m(self.SUITE))
        else:
            body.append(get_rand_m(self.HANDS))
            if has_bodywoh:
                body.append(get_rand_m(self.BODY_WITHOUT_HOOD))
            else:
                body.append(get_rand_m(self.BODY_WITH_HOOD))
            if random.random() > 0.5:
                body.append(get_rand_m(self.LEGS_WITH_BOOTS))
            else:
                body.append(get_rand_m(self.LEGS_WITHOUT_BOOTS))
                body.append(get_rand_m(self.BOOTS))
        if has_armor:
            body.append(get_rand_m(self.ARMOR))
        model_backpack = None
        if has_backpak:
            model_backpack = BigWorld.Model(get_rand_m(self.BACK))
        model = BigWorld.Model(*body)
        if has_armor:
            model.backpack = model_backpack
        else:
            model.backpack_noarmor = model_backpack
        if not has_suite:
            mask_model = None
            if random.random() > 0.5:
                mask_model = BigWorld.Model(get_rand_m(self.MASK))
                model.head = mask_model
            cap_model = None
            if has_bodywoh and not mask_model and random.random() > 0.5:
                cap_model = BigWorld.Model(get_rand_m(self.CAP))
                model.head = cap_model
        return model


def get_rand_m(textblock):
    paths = []
    for line in textblock.split('\n'):
        line = line.strip()
        if line:
            paths.append(line)

    return random.choice(paths)