class SubstratesCache:

    def __init__(self):
        self._cache = {}
        self._brows_cache = {1: BigWorld.PyTextureProvider('characters2/clothing/ManNude/Brow/Brow_1.dds'),
         2: BigWorld.PyTextureProvider('characters2/clothing/ManNude/Brow/Brow_2.dds'),
         3: BigWorld.PyTextureProvider('characters2/clothing/ManNude/Brow/Brow_3.dds'),
         4: BigWorld.PyTextureProvider('characters2/clothing/ManNude/Brow/Brow_4.dds')}
        self._battle_mark = {1: BigWorld.PyTextureProvider('characters2/clothing/ManNude/BattleMark/battle_mark_1.dds'),
         2: BigWorld.PyTextureProvider('characters2/clothing/ManNude/BattleMark/battle_mark_2.dds'),
         3: BigWorld.PyTextureProvider('characters2/clothing/ManNude/BattleMark/battle_mark_3.dds'),
         4: BigWorld.PyTextureProvider('characters2/clothing/ManNude/BattleMark/battle_mark_4.dds')}
        self._camo_cache = {}
        for color_data in DyeConstant.ITEM_COLORS_CONFIG.values():
            self._camo_cache[color_data['id']] = BigWorld.PyTextureProvider(color_data['mask'])

        self.black_pixel = BigWorld.PyTextureProvider('textures/default/blackpixel.dds')

    def _add_to_cache(self, path):
        self._cache[path] = BigWorld.PyTextureProvider(path)

    def __getitem__(self, path):
        if path not in self._cache:
            self._add_to_cache(path)
        return self._cache[path]

    def get_brow(self, brow_type):
        return self._brows_cache[brow_type]

    def get_battle_mark(self, battle_mark):
        return self._battle_mark[battle_mark]

    def get_camo(self, camo_id):
        return self._camo_cache[camo_id]


SUBSTRATES_CACHE = SubstratesCache()

def isHeadExist(model):
    """\xd0\x95\xd1\x81\xd1\x82\xd1\x8c \xd0\xbb\xd0\xb8 \xd1\x83 \xd1\x8d\xd1\x82\xd0\xbe\xd0\xb9 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb8 \xd1\x81\xd1\x83\xd0\xb1\xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xb3\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd1\x8b"""
    if not model:
        return False
    for model_name in model.sources:
        if model_name in _head_models:
            return True

    return False


def default():
    supermodel = [STALKER_MODEL.BASE]
    for part_model in STALKER_MODEL.REQUIRED.values():
