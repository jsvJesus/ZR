class STALKER_PART:
    HEAD, SHIRT, HANDS, PANTS, BOOTS = xrange(0, 5)
    ARMOR = 5
    HAT, MASK, BACKPACK = xrange(6, 9)


class STALKER_HP:
    HEAD = 'HP_head'
    BACKPACK = 'HP_backpack'
    BACKPACK_NOARMOR = 'HP_backpack_noarmor'


def unique(parts):
    parts = set(parts)
    return tuple(parts)


def unique_second(parts):
    base_model = parts[0]
    parts = set(parts[1:])
    return [base_model] + list(parts)


def unique_noempty(parts):
    parts = [ x for x in parts if x ]
    parts = set(parts)
    return tuple(parts)


def printSourcesNotFound(res_sources_list):
    if isinstance(res_sources_list, tuple) or isinstance(res_sources_list, list):
        not_found_sources = [ s for s in res_sources_list if not ResMgr.isFile(s) ]
        if not_found_sources:
            print 'ERROR. sources not found:', tuple(not_found_sources)


