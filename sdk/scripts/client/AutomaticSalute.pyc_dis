# Embedded file name: ./client/AutomaticSalute.py
import Math
import BigWorld
import utils_async
MODEL = 'models/props/ng/fireworks_launchbox_01_lod1.model'

class AutomaticSalute(BigWorld.Entity):
    """" client/AutomaticSalute """

    def __init__(self):
        self.height = 1.2
        BigWorld.Entity.__init__(self)
        self.name = u''

    def onLoadModel(self, prereqs):
        if self.isDestroyed:
            return
        model = prereqs.produce(0)
        self.model = model
        if self.model:
            self.model.isObstacle = True
        self.height = Math.Matrix(self.model.bounds).get(1, 1) if model else 1.0

    def onEnterWorld(self, prereqs):
        utils_async.load_model(MODEL, self.onLoadModel)
        self.targetFullBounds = True

    def onLeaveWorld(self):
        self.model = None
        return