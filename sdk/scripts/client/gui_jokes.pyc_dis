class GuiHandler(object):
    NEXT_ID = 0
    ACTIVE_GUI_HANDLERS = {}
    OK, CANCEL, YES, NO, APPLY = (soDialogueBox.BTN_OK,
     soDialogueBox.BTN_CANCEL,
     soDialogueBox.BTN_YES,
     soDialogueBox.BTN_NO,
     soDialogueBox.BTN_APPLY)
    CLOSED = -1
    enter_btn = None

    def __init__(self, props = None, callback = None, POS = None):
        if not getattr(self, 'ID', None):
            self.ID = 'gui_jokes_%s_%s' % (self.__class__.__name__, self.NEXT_ID)
        GuiHandler.NEXT_ID += 1
        if callback:
            self.callback = callback
            self.registerListener()
        self.props = props
        x, y = (0.0, 0.0)
        forcePos = True
        if POS:
            forcePos = True
            x, y = POS
        return BWPersonality.GUICore.showMessageBox(self.ID, props, x=x, y=y, forcePos=forcePos, defaultAction=self.enter_btn)

    def registerListener(self):
        if not GuiHandler.ACTIVE_GUI_HANDLERS.has_key(self.ID):
            BWPersonality.GUICore.addListener('dlgBoxEvent', self.onDlgBoxEvent)
            GuiHandler.ACTIVE_GUI_HANDLERS[self.ID] = self

    def unregisterListener(self):
        BWPersonality.GUICore.removeListener('dlgBoxEvent', self.onDlgBoxEvent)
        if GuiHandler.ACTIVE_GUI_HANDLERS.has_key(self.ID):
            del GuiHandler.ACTIVE_GUI_HANDLERS[self.ID]

    def onDlgBoxEvent(self, event, data):
        id = data[0]
        if id == self.ID:
            self.unregisterListener()
            self.processEventData(event, data)

    def processEventData(self, event, data):
        pass

    def close(self):
        self.unregisterListener()
        BWPersonality.GUICore.closeMessageBox(self.ID)


def inputBox(title, subtitle = u'', callback = None, id = None, isModal = False, active = False, defaultText = u'', input_validator = None):

    def handler(event, data):
        if event == MESSAGEBOX.EVENT_BTNPRESS and data['btn'] == MESSAGEBOX.BTN_OK:
            text = data['add_controls']['edit_box']
            if text:
                callback(text)

    add_controls = [{'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
      'ID': 'main_txt_field',
      'text': subtitle,
      'hAnchor': MESSAGEBOX.ANCHOR_CENTER}, {'type': MESSAGEBOX.ADDCONTROL_EDIT,
      'ID': 'edit_box',
      'hAnchor': MESSAGEBOX.ANCHOR_CENTER,
      'active': active,
      'default': defaultText}]
    if input_validator:
        add_controls[1]['input_validator'] = input_validator
    BWPersonality.GUICore.showMsgBox(id or 'inputBox.default', isModal=isModal, x=0.0, y=0.0, width=300, caption=title, forcePos=False, parent_gui_id=None, bind_to_parent=False, btn_set=[{'type': MESSAGEBOX.BTN_OK,
      'width': 80}, {'type': MESSAGEBOX.BTN_CANCEL,
      'width': 80}], timeout=-1, closeBox=True, defaultAction=MESSAGEBOX.BTN_OK, addControls=add_controls, callback=handler)
    return


def confirmation_dialog_box(title, text, callback = None, get_error_msg = None, width = 300, key_word = u'', id = None, isModal = False, active = False, defaultText = u'', input_validator = None):
    """
    \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd1\x81 \xd0\xba\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xbc \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xbc
    """

    def foo(*e):
        pass

    add_controls = [{'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
      'ID': 'main_txt_field',
      'text': text,
      'hAnchor': MESSAGEBOX.ANCHOR_CENTER}, {'type': MESSAGEBOX.ADDCONTROL_EDIT,
      'ID': 'edit_box',
      'hAnchor': MESSAGEBOX.ANCHOR_CENTER,
      'active': active,
      'default': defaultText}, {'type': MESSAGEBOX.ADDCONTROL_LABEL,
      'ID': 'error_lb',
      'text': u'',
      'color': (255, 0, 0, 255),
      'font': 'RobotoCondensedRegular_16.font',
      'hAnchor': MESSAGEBOX.ANCHOR_CENTER}]
    if input_validator:
        add_controls[1]['input_validator'] = input_validator
    msgBox = BWPersonality.GUICore.showMsgBox(id or 'inputBox.default', isModal=isModal, x=0.0, y=0.0, width=width, caption=title, forcePos=False, parent_gui_id=None, bind_to_parent=False, btn_set=[{'type': MESSAGEBOX.BTN_OK,
      'width': 80}, {'type': MESSAGEBOX.BTN_CANCEL,
      'width': 80}], timeout=-1, closeBox=True, defaultAction=MESSAGEBOX.BTN_OK, addControls=add_controls, callback=foo)

    def btn_pre_handler(self, btn, byUser):
        """
        \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 True, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb5\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd0\xbc \xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xba\xd1\x83 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8 \xd0\xb8\xd0\xb7-\xd0\xb7\xd0\xb0 \xd0\xbe\xd1\x88\xd0\xb8\xd0\xb1\xd0\xbe\xd0\xba
        """
        if btn == MESSAGEBOX.BTN_OK:
            text = msgBox._getControlsData()['edit_box']
            if text and text == key_word:
                if get_error_msg:
                    error_msg = get_error_msg()
                    if error_msg:
                        msgBox.component.label_error_lb.text = error_msg
                        msgBox.component.edit_edit_box.script.activate(True)
                        return True
                callback()
            else:
                edit_box_comp = msgBox.component.edit_edit_box
                edit_box_comp.script.runErrorNotify()
                edit_box_comp.script.activate(True)
                return True
        return False

    msgBox.btn_pre_handler = partial(btn_pre_handler, msgBox)
    return


class radioBox(GuiHandler):

    def __init__(self, title, subtitle = u'', boxes = None, callback = None):
        boxes_as_tuples = []
        if boxes is not None:
            for box in boxes:
                box.insert(0, 'radio')
                boxes_as_tuples.append(tuple(box))

        props = soDlgBoxPropsStructure(caption=title, msg=subtitle, modal=True, btnSet=[soDialogueBox.BTN_OK, soDialogueBox.BTN_CANCEL], additions=boxes_as_tuples)
        GuiHandler.__init__(self, props, callback)
        return

    def processEventData(self, event, data):
        if event == soDialogueBox.EVENT_BTNPRESS:
            id, btn, adddata = data
            if btn == soDialogueBox.BTN_OK:
                for radio in adddata:
                    if radio[1]:
                        self.callback(radio[0])
                        return


class msgBox(GuiHandler):

    def __init__(self, title, subtitle = u'', large = False, POS = None):
        if large:
            screen_size = BigWorld.screenSize()
            screen_size = [ size / 2 for size in screen_size ]
            props = soDlgBoxPropsStructure(width=screen_size[0], height=screen_size[1], caption=title, msg=subtitle, modal=True, btnSet=[soDialogueBox.BTN_OK])
        else:
            props = soDlgBoxPropsStructure(caption=title, msg=subtitle, modal=True, btnSet=[soDialogueBox.BTN_OK])
        GuiHandler.__init__(self, props, None, POS=POS)
        return


class CustomAsk(GuiHandler):

    def __init__(self, props, callback = None, POS = ''):
        GuiHandler.__init__(self, props, callback, POS=POS)

    def processEventData(self, event, data):
        if event in [soDialogueBox.EVENT_CLOSE, soDialogueBox.EVENT_BTNPRESS]:
            if event == soDialogueBox.EVENT_CLOSE:
                self.callback(askUser.CLOSED)
            elif event == soDialogueBox.EVENT_BTNPRESS:
                btn = data[1]
                self.callback(btn)


class askUser(GuiHandler):

    def __init__(self, title, subtitle = u'', callback = None, btn_set = None, enter_btn = None, default_btn = None, timeout_for_default = None, large = False, POS = '', timeout = 1, customBtnLabel = None, show_timer_btn = False, closeBox = True, bg_color = None, enter_enable = None, unic_id = None, modal = True):
        if large:
            screen_size = BigWorld.screenSize()
            screen_size = [ size / 2 for size in screen_size ]
            props = soDlgBoxPropsStructure(width=screen_size[0], height=screen_size[1], caption=title, msg=subtitle, modal=modal, btnSet=btn_set, customBtnLabel=customBtnLabel, closeBox=closeBox, bg_color=bg_color)
        else:
            props = soDlgBoxPropsStructure(caption=title, msg=subtitle, modal=modal, btnSet=btn_set, customBtnLabel=customBtnLabel, closeBox=closeBox, bg_color=bg_color)
        self.enter_btn = enter_btn
        self._enter_enable = None
        if callback and timeout_for_default and default_btn is not None:
            self.default_btn = default_btn
            self.setupTimeoutTimer(timeout_for_default)
            if show_timer_btn:
                self._enter_enable = enter_enable
                self._end_time = BigWorld.time() + timeout_for_default
                self._show_timer_btn_id = BigWorld.callback(0.3, self._updateBtnTimerText)
        else:
            self.timeout_timer = None
        if unic_id:
            self.ID = unic_id
        result = GuiHandler.__init__(self, props, callback, POS=POS)
        if self._enter_enable and result:
            BWPersonality.GUICore.setMsgBoxBtnData(self.ID, self.enter_btn, {'enabled': self._enter_enable()})
        return

    def processEventData(self, event, data):
        if event in [soDialogueBox.EVENT_CLOSE, soDialogueBox.EVENT_BTNPRESS]:
            self.cancelTimeoutTimer()
            if event == soDialogueBox.EVENT_CLOSE:
                self.callback(askUser.CLOSED)
            elif event == soDialogueBox.EVENT_BTNPRESS and (not self._enter_enable or self._enter_enable()):
                btn = data[1]
                self.callback(btn)

    def _updateBtnTimerText(self):
        lost = int(self._end_time - BigWorld.time())
        lost = max(0, lost)
        caption = soDialogueBox.btnCaptionMap.get(self.default_btn, '')
        BWPersonality.GUICore.setMsgBoxBtnData(self.ID, self.default_btn, {'caption': '%s [%s]' % (caption, lost)})
        if self._enter_enable:
            BWPersonality.GUICore.setMsgBoxBtnData(self.ID, self.enter_btn, {'enabled': self._enter_enable()})
        if lost > 0:
            self._show_timer_btn_id = BigWorld.callback(0.3, self._updateBtnTimerText)

    def setupTimeoutTimer(self, t):
        self.cancelTimeoutTimer()
        self.timeout_timer = BigWorld.callback(t, self.onTimeEnd)

    def cancelTimeoutTimer(self):
        if getattr(self, 'timeout_timer', None):
            BigWorld.cancelCallback(self.timeout_timer)
            self.timeout_timer = None
        if getattr(self, '_show_timer_btn_id', 0):
            BigWorld.cancelCallback(self._show_timer_btn_id)
            self._show_timer_btn_id = None
        return

    def onTimeEnd(self):
        self.cancelTimeoutTimer()
        BWPersonality.GUICore.removeListener('dlgBoxEvent', self.onDlgBoxEvent)
        BWPersonality.GUICore.closeMessageBox(self.ID)
        self.callback(self.default_btn)


