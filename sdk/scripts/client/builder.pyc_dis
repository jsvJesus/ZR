# Embedded file name: ./client/builder.py
import BigWorld
import BWPersonality
import Constants
import Math
import traceback
import ChatChannelConfig
import gui_jokes
from Localization import lc
CHANNEL_CONSTS = ChatChannelConfig.ChannelConsts()
from Sandbag import BOXS, getBoxByID
import sand_bag_optimize

def update_gui_quantity_block():
    if BWPersonality.GUICore._builder_menu:
        quantity = len(BWPersonality.game.block_builder_data)
        BWPersonality.GUICore._builder_menu.updateQuantityBlock(quantity)


class Builder:
    buildRoomID = 0

    def __init__(self):
        self.__pull_data_blocks = {}

    def buildEvent(self, event, charname, data):
        print 'Builder buildEvent', [event, charname, data]
        if event == Constants.BUID_INVITE:
            if self.isEventsSpace():
                chat_msg = lc('builder.CHAT_MSH_BUID_INVITE').format(charname)
                self.putMessage(CHANNEL_CONSTS.SYSTEM, chat_msg)
                roomID = int(data)

                def listener(event):
                    if event == gui_jokes.askUserYesNo.YES:
                        self.runCommand(u'/connectToBuildSpace %s' % roomID)

                msg = lc('builder.ASK_BUID_INVITE').format(charname)
                gui_jokes.askUserYesNo(u'', msg, listener, POS=(0.5, 0.7))
            else:
                msg = lc('builder.BUILD_INVITE_ERROR').format(charname)
                self.putMessage(CHANNEL_CONSTS.SYSTEM, msg)
        elif event == Constants.BUID_START_LOAD:
            BigWorld.player().showOnLoadBuidDialog(self.name)
        elif event == Constants.BUID_START_CLEAR:
            BigWorld.player().showOnClearBuidDialog(self.name)
        elif event == Constants.BUID_CANCEL_LOAD:
            BigWorld.player().cancelLoadBuid(self.name)
        elif event == Constants.BUILD_CLEAR_ALL_BLOCKS:
            BigWorld.player().clearAllBlocks()
        elif event == Constants.CONNECT_BUILD_OK:
            self.buildRoomID = int(data)
        elif event == Constants.CONNECT_BUILD_ROOM_ERROR:
            self.putMessage(CHANNEL_CONSTS.SYSTEM, data)
        elif event == Constants.BUID_SPAWN_POSITION:
            print 'respwn position:', data
            data = map(float, data.split())
            self.last_spawn_position = Math.Vector3(data)

    def onDeleteBlock(self, owner_id, server_block_id):
        key = (owner_id, server_block_id)
        local_id = BWPersonality.game.block_server_local.pop(key, None)
        if not local_id:
            print 'onDeleteBlock ERROR , %s not found!' % key
            return
        else:
            BWPersonality.game.block_builder_data.pop(local_id)
            BWPersonality.game.block_local_server.pop(local_id)
            sand_bag_optimize.delete_block(local_id)
            update_gui_quantity_block()
            self.deleteRespawnBox(local_id)
            return

    def onCreateBlocks(self, blocks, remain):
        for box in blocks:
            self.__pull_data_blocks[box['id']] = (box['pos'], box['angle'], box['boxID'])

        if remain:
            BWPersonality.gpd.sendHightMessage('remained:%s' % remain)

        def on_add_block(server_block_id, unical_id, box, matrix, model, position, angles):
            self.registerBuildBlock(server_block_id, unical_id, position, angles, boxID)
            update_gui_quantity_block()

        def on_fetch_complete(load_out_data, serv_id_to_local):
            for serv_id, unical_id in serv_id_to_local.items():
                position, angles, boxID = load_out_data.pop(unical_id)
                self.registerBuildBlock(serv_id, unical_id, position, angles, boxID)

            update_gui_quantity_block()

        if not remain and len(self.__pull_data_blocks) < 10:
            for server_block_id, (pos, angles, boxID) in self.__pull_data_blocks.items():
                sand_bag_optimize.add_block_manual(server_block_id, boxID, pos, angles, on_add_block)

            self.__pull_data_blocks.clear()
        elif not remain:
            sand_bag_optimize.load_all(self.__pull_data_blocks, on_fetch_complete)
            self.__pull_data_blocks.clear()
        if BWPersonality.GUICore._builder_menu:
            BWPersonality.GUICore._builder_menu.showRemainLoad(remain)

    def registerBuildBlock(self, server_block_id, local_block_id, position, angles, boxID):
        BWPersonality.game.block_builder_data[local_block_id] = (tuple(position), tuple(angles), int(boxID))
        if not server_block_id:
            server_block_id = local_block_id
        key = (self.id, server_block_id)
        BWPersonality.game.block_server_local[key] = local_block_id
        BWPersonality.game.block_local_server[local_block_id] = key
        box = getBoxByID(boxID)
        respawn_color = box.get('respawn_color')
        if respawn_color:
            self.addRespawnBox(respawn_color, local_block_id, boxID, position, angles)

    def createBuildBlock(self, server_block_id, position, angles, boxID):
        BWPersonality.game.block_builder_data[local_block_id] = (tuple(position), tuple(angles), int(boxID))
        if not server_block_id:
            server_block_id = local_block_id
        key = (self.id, server_block_id)
        BWPersonality.game.block_server_local[key] = local_block_id
        update_gui_quantity_block()
        box = getBoxByID(boxID)
        respawn_color = box.get('respawn_color')
        if respawn_color:
            self.addRespawnBox(respawn_color, local_block_id, boxID, position, angles)
        return local_block_id

    def addRespawnBox(self, respawn_color, local_block_id, boxID, position, angles):
        BWPersonality.game.block_respawn_colors[local_block_id] = (respawn_color, position, angles)

    def deleteRespawnBox(self, local_block_id):
        try:
            del BWPersonality.game.block_respawn_colors[local_block_id]
        except:
            pass