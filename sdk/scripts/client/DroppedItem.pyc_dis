# Embedded file name: ./client/DroppedItem.py
from Localization import lc
import BigWorld
from ItemHolder import ItemHolder
from Items import ItemsCatalog
import ItemsUtils
import GUI
from Helpers.Caps import CAP_CAN_PICKUP
import traceback
from functools import partial
import Constants
from soGUI.soInworldMarkers import soInworldMarker

class DroppedItem(BigWorld.Entity, ItemHolder):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.targetCaps = [CAP_CAN_PICKUP]
        self._messageTimerHandle = None
        self._messageAttachment = None
        self.name = lc('DroppedItem.client.VOID_ITEM')
        self._pix_model = None
        self.__weapon = None
        return

    def onLoadPS(self, ps):
        self.model.root.attach(ps)
        ps.force()

    def getModelName(self):
        tints = {}
        item_type = self.CarryingItems[0]['complexItemType']
        item_params = ItemsCatalog.GetItemParam(item_type)
        if item_params.has_key('OnFlorModel'):
            item_model = item_params['OnFlorModel']
            if item_params.has_key('OnFlorTint'):
                tints = item_params['OnFlorTint']
        else:
            if 'ModelNames' not in item_params:
                return ('characters2/items/loot/shells_box.model', {})
            item_model = self.getModelNameByNamesDict(item_params['ModelNames'].values())
            if item_params.has_key('Tint'):
                tints = item_params['Tint']
        return (item_model, tints)

    def getParticleName(self):
        item_type = self.CarryingItems[0]['complexItemType']
        item_params = ItemsCatalog.GetItemParam(item_type)
        if item_params.has_key('ParticleName'):
            ps = item_params['ParticleName']
        else:
            ps = 'particles/item_light.xml'
        return ps

    def prerequisites(self):
        pre = []
        md, tints = self.getModelName()
        if md.__class__.__name__ == 'list':
            for e in md:
                pre.append(e)

        else:
            pre.append(md)
        particle_name = self.getParticleName()
        if particle_name:
            pre.append(self.getParticleName())
        return pre

    def onEnterWorld(self, prereqs):
        item = self.CarryingItems[0]
        item_type = item['complexItemType']
        self.name = ItemsUtils.GetItemName(item_type)
        item_class = ItemsCatalog.GetItemClass(item_type)

        def onLoadModel(model):
            if self.isDestroyed:
                return
            else:
                self.model = model
                item = self.CarryingItems[0]
                item_type = item['complexItemType']
                item_class = ItemsCatalog.GetItemClass(item_type)
                if self.getParticleName() not in prereqs.failedIDs:
                    try:
                        ps = prereqs[self.getParticleName()]
                        self._pix_model = BigWorld.Model('')
                        self._pix_model.position = self.position
                        self.addModel(self._pix_model)
                        self._pix_model.root.attach(ps)
                        ps.force()
                    except KeyError:
                        print 'Error init dropped item, item type:', item_type, 'particle name:', self.getParticleName()

                else:
                    print self.getParticleName(), 'failed to load'
                if self.model is None:
                    print self.getModelName()[0], 'failed to load'
                else:
                    try:
                        self.model.idle()
                    except:
                        pass

                return

        def createSimpleModel():
            md, tints = self.getModelName()

            def onLoadSimpleModel(model):
                for tint in tints:
                    setattr(model, tint, tints[tint])

                onLoadModel(model)

            try:
                if md.__class__.__name__ == 'list':
                    md.append(onLoadSimpleModel)
                    BigWorld.fetchModel(*md)
                else:
                    BigWorld.fetchModel(md, onLoadSimpleModel)
            except:
                print 'md', repr(md), dict(item)
                self.lasterrmd = md
                traceback.print_exc()
                BigWorld.fetchModel('characters2/items/loot/shells_box.model', onLoadSimpleModel)

        def createModelFromCarryingItems(callback):
            if item_class != ItemsCatalog.WEAPON:
                callback(None)
                return
            else:
                import clweapon
                self.__weapon = clweapon.ClWeapon(item)
                try:
                    m = self.__weapon.getModel()
                except:
                    print dict(item)
                    traceback.print_exc()
                    BigWorld.fetchModel('characters2/items/loot/shells_box.model', onLoadModel)
                    return

                callback(m)
                return

        def onLoadModelFromCarryingItems(model):
            if model == None:
                createSimpleModel()
            else:
                onLoadModel(model)
            return

        createModelFromCarryingItems(onLoadModelFromCarryingItems)

    def hitPot(self, enteredTrap, handle):
        if self.model is None:
            cb = partial(hitPot, enteredTrap, handle)
            BigWorld.callback(1.0, cb)
            return
        else:
            if enteredTrap:
                self.model.visible = True
            else:
                self.model.visible = False
            return

    def _displayMessage(self, msg):
        self._clearMessage()
        text = GUI.Text(msg)
        text.explicitSize = True
        text.size = (0, 0.3)
        text.colour = (255, 205, 149, 245)
        text.filterType = 'LINEAR'
        text.verticalAnchor = 'BOTTOM'
        text.position = (0, 1, 0)
        atch = GUI.Attachment()
        atch.component = text
        atch.faceCamera = True
        self.model.root.attach(atch)
        self._messageAttachment = atch
        self._setMessageHideTimer()

    def _clearMessage(self):
        self._cancelMessageTimer()
        if self._messageAttachment is not None:
            self.model.root.detach(self._messageAttachment)
            self._messageAttachment = None
        return

    def _setMessageHideTimer(self, timeout = 5.0):
        self._cancelMessageTimer()
        self._messageTimerHandle = BigWorld.callback(timeout, self._handleMessageHideTimer)

    def _cancelMessageTimer(self):
        if self._messageTimerHandle is not None:
            BigWorld.cancelCallback(self._messageTimerHandle)
            self._messageTimerHandle = None
        return

    def _handleMessageHideTimer(self):
        self._messageTimerHandle = None
        self._clearMessage()
        return

    def onLeaveWorld(self):
        self._cancelMessageTimer()
        del self._messageTimerHandle
        del self._messageAttachment
        self.model = None
        if self._pix_model:
            self._pix_model.root.attachments = []
            self.delModel(self._pix_model)
            self._pix_model = None
        if self.__weapon:
            self.__weapon.destroy()
        self.__weapon = None
        return

    def get_target_mark(self, distance):
        if distance > Constants.INTERACTION_DISTANCE:
            return None
        elif CAP_CAN_PICKUP not in self.targetCaps:
            return None
        else:
            return soInworldMarker.MARKER_USE

    def get_hightlight(self, distance):
        if distance > Constants.HILITE_MARKS_DISTANCE:
            return None
        else:
            return True