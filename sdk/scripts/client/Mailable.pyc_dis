# Embedded file name: ./client/Mailable.py
"""\xd0\x9c\xd0\xbe\xd0\xb4\xd1\x83\xd0\xbb\xd1\x8c \xd1\x80\xd0\xb5\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd1\x83 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c \xd0\xbe\xd0\xb1\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f\xd0\xbc\xd0\xb8."""
import BigWorld
import BWPersonality
import ChatChannelConfig
from Localization import lc
from functools import partial
import MessagesUtils
from MessageConstants import get_coded_message
from MessageConstants import MC
import colorCodes as cc
from Constants import MESSAGE_TYPES as MT
CHANNEL_CONSTS = ChatChannelConfig.ChannelConsts()
WHISPER_DISTANCE = 2.0

class Mailable:
    """
    \xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x88\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2 CLIENT-\xd0\x90\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0, \xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0 \xd0\xb1\xd1\x8b\xd0\xbb\xd0\xb0 
    \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd1\x8b\xd0\xbb\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb8\xd0\xb7 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xb8 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb4\xd1\x8b.
    """
    _interviewee_callbacks = {}

    def chatConsoleCommand(self, cmd):
        return False

    def onEnterWorld(self):
        pass

    def onLeaveWorld(self):
        for id_ in self._interviewee_callbacks.values():
            BigWorld.cancelCallback(id_)

        self._interviewee_callbacks.clear()

    def putMessageItems(self, code, string_args, int_args):
        self.put_message(code, CHANNEL_CONSTS.ITEMS, string_args, int_args)

    def putMessageAchivements(self, code, string_args, int_args):
        self.put_message(code, CHANNEL_CONSTS.ACHIEVMENTS, string_args, int_args)

    def putMessageSystem(self, code, string_args, int_args):
        self.put_message(code, CHANNEL_CONSTS.SYSTEM, string_args, int_args)

    def putMessageWhisper(self, code, string_args, int_args):
        self.put_message(code, CHANNEL_CONSTS.WHISPER, string_args, int_args)

    def putMessageClan(self, code, string_args, int_args):
        self.put_message(code, CHANNEL_CONSTS.CLAN, string_args, int_args)

    def putMessageNews(self, code, string_args, int_args):
        self.put_message(code, CHANNEL_CONSTS.NEWS, string_args, int_args)

    def putMessageUnion(self, code, string_args, int_args):
        self.put_message(code, CHANNEL_CONSTS.UNION, string_args, int_args)

    def putMessageGroup(self, code, string_args, int_args):
        self.put_message(code, CHANNEL_CONSTS.GROUP, string_args, int_args)

    def put_message(self, code, channel_id, string_args, int_args):
        text = get_coded_message(code, string_args, int_args)
        if self.active_transform:
            text = self.active_transform.hook_putMessage(channel_id, text, None)[0]
            if text is None:
                return
        BWPersonality.GUICore.chatPrint(channel_id, text)
        return

    def put_hight_message_nonlocaled(self, non_loc_text, string_args, int_args, message_type):
        args = [ s.decode('utf8') for s in string_args ] + list(int_args)
        text = lc(non_loc_text).format(*args)
        BWPersonality.gpd.sendHightMessage(text, message_type)

    def put_hight_message(self, code, string_args, int_args):
        self.put_hight_message_colored(code, string_args, int_args, MT.NONE)

    def put_hight_message_colored(self, code, string_args, int_args, message_type):
        text = get_coded_message(code, string_args, int_args)
        BWPersonality.gpd.sendHightMessage(text, message_type)

    def putMessage(self, channel_id, text, sender = u''):
        """\xd0\x92\xd1\x8b\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82."""
        if not text:
            return
        elif sender and self.is_black(sender):
            return
        else:
            if isinstance(sender, unicode):
                sender = sender.encode('utf-8')
            if self.active_transform:
                text, sender = self.active_transform.hook_putMessage(channel_id, text, sender)
                if text is None:
                    return
            BWPersonality.GUICore.chatPrint(channel_id, text, sender)
            return

    def putUnionMessage(self, clan_name, text, sender = u''):
        if not text:
            return
        elif self.is_black(sender):
            return
        else:
            if isinstance(sender, unicode):
                sender = sender.encode('utf-8')
            if self.active_transform:
                text, sender = self.active_transform.hook_putMessage(CHANNEL_CONSTS.UNION, text, sender)
                if text is None:
                    return
            BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.UNION, text, sender, clan_name)
            return

    def putPMMessage(self, text, sender = u'', sender_level = 0):
        if self.is_black(sender):
            return
        self._set_interviewee(sender)
        channel_id = CHANNEL_CONSTS.WHISPER
        self.putMessage(channel_id, text, sender)

    def runCommand(self, command):
        """\xd0\x92\xd1\x8b\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb4\xd1\x83."""
        if isinstance(command, str):
            command = command.decode('utf-8')
        if not command.startswith(u'/'):
            command = u'/' + command
        if not self.chatConsoleCommand(command):
            self.cell.runCommand(command)

    def is_whisper_distance(self, receiver):
        from Avatar import Avatar
        if receiver == self.name:
            return True
        for e in BigWorld.entities.values():
            if isinstance(e, Avatar) and getattr(e, 'name', '') == receiver:
                return self.position.distTo(e.position) <= WHISPER_DISTANCE

        return False

    def send_message(self, channel_id, text, receiver):
        """\xd0\x9e\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5."""
        receiver = receiver.decode('utf-8')
        self._set_interviewee(receiver)
        if self.dead:
            BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.SYSTEM, lc('Mailable.client.UNCONSCIOUS'))
            return
        else:
            text = text.decode('utf-8')
            if self.active_transform:
                text = self.active_transform.hook_send_message(channel_id, text)
                if text is None:
                    return
            elif channel_id in [CHANNEL_CONSTS.CLAN, CHANNEL_CONSTS.WHISPER, CHANNEL_CONSTS.GROUP]:
                pass
            elif channel_id in [CHANNEL_CONSTS.PVP]:
                if not self.inPVPinstance:
                    BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.SYSTEM, lc('Mailable.client.NO_PVP'))
                    return
            if channel_id == CHANNEL_CONSTS.GROUP:
                self.putMessage(CHANNEL_CONSTS.GROUP, text, self.name)
            self.cell.send_message(channel_id, text, receiver)
            return

    def send_olive_msg(self, msg_id):
        self.cell.send_olive_msg(msg_id)

    def is_black(self, black_name):
        return False

    def _set_interviewee(self, name):
        """\xd0\xa1 \xd1\x8d\xd1\x82\xd0\xb8\xd0\xbc \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba\xd0\xbe\xd0\xbc \xd0\xb2\xd0\xb5\xd0\xb4\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xb1\xd0\xb5\xd1\x81\xd0\xb5\xd0\xb4\xd0\xb0, \xd0\xb2 \xd1\x81\xd0\xbb\xd1\x83\xd1\x87\xd0\xb0\xd0\xb5 \xd1\x81\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb5\xd0\xb9 \xd1\x8d\xd1\x82\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd1\x82\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd1\x8c"""
        if not name:
            return
        if not isinstance(name, unicode):
            name = name.decode('utf-8')
        name = name.lower().strip()
        if name in self._interviewee_callbacks:
            BigWorld.cancelCallback(self._interviewee_callbacks[name])
        elif self.hide_all_other_avatar_key:
            self._interviewee_callbacks[name] = 0
            avatar = self.getAvatarByName(name)
            if avatar:
                avatar.updateVisibleForPlayer()
        self._interviewee_callbacks[name] = BigWorld.callback(600, partial(self._on_end_interviewee, name))

    def _on_end_interviewee(self, name):
        self._interviewee_callbacks.pop(name, None)
        if self.hide_all_other_avatar_key:
            avatar = self.getAvatarByName(name)
            if avatar:
                avatar.updateVisibleForPlayer()
        return

    def send_coded_messages(self, messages):
        for message in messages:
            message_text, sender, channel_id = MessagesUtils.decode_message_data(message['code'], message['blob'])
            self.putMessage(channel_id, message_text, sender)

    def is_recent_interviewee(self, avatar_name):
        return avatar_name.lower() in self._interviewee_callbacks