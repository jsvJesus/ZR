# Embedded file name: ./client/Helicopter.py
from Localization import lc
import BigWorld
from Math import Matrix
from Vehicle import Vehicle, AnimationState
import heliconstants as H
from math_bw import inverse_lerpclam
from sounds_manager import playSound

class Helicopter(Vehicle):

    def __init__(self):
        Vehicle.__init__(self)

    def _update_pitch(self):
        if self._fly_sound:
            param_value = inverse_lerpclam(0, 20, self._filter.speed)
            self._fly_sound.set_param('flight_speed', param_value)

    def on_speed_changed(self):
        Vehicle.on_speed_changed(self)
        self._update_pitch()

    def on_touchdown(self):
        playSound(H.LAND_SOUND, self.model)

    def on_animation_state_changed(self, state, prev_state):
        Vehicle.on_animation_state_changed(self, state, prev_state)
        if state == AnimationState.Prepare:
            if prev_state == AnimationState.Stand:
                playSound(H.START_SOUND, self.model)
                self.model.fly_in().fly()
        if prev_state == AnimationState.Undefined:
            if state in (AnimationState.Run, AnimationState.Prepare):
                self.model.fly()
        if state == AnimationState.Stand:
            self.model.fly_in.stop()
            self.model.fly.stop()
        self._update_pitch()

    def set_preparation_factor(self, old_value):
        Vehicle.set_preparation_factor(self, old_value)
        out_factor = 0.8
        if self.preparation_factor < out_factor:
            if old_value >= out_factor:
                if self._fly_sound:
                    self._fly_sound.stop()
                    self._fly_sound = None
                    playSound(H.STOP_SOUND, self.model)
                    self.model.fly_out()
        return

    def get_sound(self):
        return H.FLY_SOUND

    def get_model_name(self):
        return H.MODEL_NAME

    def get_collider_name(self):
        return 'models/transport/helicopter/mi-2/door.xml'

    def get_boxes_count(self):
        return H.BOXES_COUNT

    def get_cam_node(self):
        return self.model.node('camera')

    def get_entrance_node(self):
        return self.model.node('entrance')

    def get_mark_name(self):
        return lc('Helicopter.name')

    def get_box_scale(self):
        return 0.7

    def get_npc_animation(self):
        return H.NPC_ANIMATION

    def can_take_boxes_out(self):
        return True

    def can_sit_inside(self):
        return True

    def can_interact(self):
        if not Vehicle.can_interact(self):
            return False
        to_player = BigWorld.player().position - self.position
        m = Matrix(self.matrix)
        m.invert()
        return m.applyVector(to_player)[0] < 0