# Embedded file name: ./client/WayFollower.py
import BigWorld
from PathFollower.circuit import WayPointCircuit, RoutePoint
from draw_utils_extend import LinesHolder
import math_bw
from DrawPrimitivesUtils import draw_cilinder
from Math import Vector3
from WayFollowerCommon import WayFollowerCommon

class WayFollower(WayFollowerCommon):

    def debug_draw(self, positions, follower_pos, target_distance, progress_distance, cycle_route):
        for model in getattr(self, '_debug_models', []):
            BigWorld.delModel(model)

        if hasattr(self, '_debug_lineholder'):
            self._debug_lineholder.clear()
        self._debug_lineholder = LinesHolder(max_lines=0)
        self._debug_models = []

        def to_route_point(pos):
            return RoutePoint(pos, None)

        circuit = WayPointCircuit(map(to_route_point, positions), cycle_route)
        circuit.debug_draw(self._debug_lineholder)
        for i, pos in enumerate(positions):
            model = BigWorld.Model('models/bolvan/helpers/strelka.model')
            direction = circuit.get_waypoint(i).direction
            direction = Vector3(0, direction.pitch, direction.yaw)
            m = math_bw.matrix_from_pos_and_dir(pos, direction)
            model.setWorldTransform(m)
            self._debug_models.append(model)
            BigWorld.addModel(model)

        target_point = circuit.get_route_point(target_distance)
        self._debug_lineholder.addLine(follower_pos, target_point.position, color=(1, 0, 0, 1), ower=True)
        model = BigWorld.Model('models/bolvan/helpers/strelka.model')
        direction = Vector3(0, target_point.direction.pitch, target_point.direction.yaw)
        m = math_bw.matrix_from_pos_and_dir(target_point.position, direction)
        model.setWorldTransform(m)
        self._debug_models.append(model)
        BigWorld.addModel(model)
        progress_point = circuit.get_route_point(progress_distance)
        draw_cilinder(progress_point.position, 1.0, 2.0, holder=self._debug_lineholder)

    def onLeaveWorld(self):
        for model in getattr(self, '_debug_models', []):
            BigWorld.delModel(model)

        if hasattr(self, '_debug_lineholder'):
            self._debug_lineholder.clear()