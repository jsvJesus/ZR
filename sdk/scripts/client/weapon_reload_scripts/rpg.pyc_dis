# Embedded file name: ./client/weapon_reload_scripts/rpg.py
import BigWorld
import time
import BWPersonality
import Math, math
from Math import Matrix, Vector3
import traceback
from Items import ItemsCatalog
from utils import ignoreError
from utils_bw import not_safe_animation_callback
from reload_base_script import BaseWeaponReloader, BaseWeaponManualReloader
from reload_base_script import _set_visible_magazine_from_model
import weapon_attachment
from functools import partial

class ReloadRPG(BaseWeaponManualReloader):
    anim_name = 'reload_RPG7'

    def play(self, anim_name):
        gr_type = self.ammo_or_magazine_item['complexItemType']
        rocket_in_hand_old = None
        if self.player.active_weapon.getAmmoNumber():
            old_gr_type = self.player.active_weapon.getAmmoType()
            rocket_in_hand_old = weapon_attachment.WeaponAttachment._loadModel(old_gr_type)
            rocket_in_hand_old.visible = False
            self.player.model.Lmanipulator = rocket_in_hand_old
        rocket_in_hand = weapon_attachment.WeaponAttachment._loadModel(gr_type)
        rocket_in_weapon = weapon_attachment.WeaponAttachment._loadModel(gr_type)
        rocket_in_hand.visible = False
        Rhand_model = self.player.active_weapon.createCopyModelWeapon()
        self.player.model.Rhand = Rhand_model
        self.player.active_weapon.setVisibleModel(Rhand_model)

        def RoundGunToHandSYS(*e):
            self.playSfxOrSound('RoundGunToHandSYS')
            rocket_in_hand_old.visible = True

            def foo():
                self.player.active_weapon.updateLauncherGunByItem(None)
                return

            BigWorld.callback(0, foo)

        def RoundHandToPocketSYS(*e):
            self.playSfxOrSound('RoundHandToPocketSYS')
            rocket_in_hand_old.visible = False

        def RoundHandToDropSYS(*e):
            self.playSfxOrSound('RoundHandToDropSYS')

        def RoundPocketToHandSYS(*e):
            self.playSfxOrSound('RoundPocketToHandSYS')
            rocket_in_hand.visible = True

            def foo():
                self.player.model.Lmanipulator = rocket_in_hand

            BigWorld.callback(0, foo)

        def RoundHandToGunSYS(*e):
            self.playSfxOrSound('RoundHandToGunSYS')
            self.player.model.Lmanipulator = None
            Rhand_model.grenade = rocket_in_weapon
            self._onInsetAmmoCallback(self.ammo_or_magazine_item)
            self.player.active_weapon.updateLauncherGunByItem(gr_type)
            self.ammo_or_magazine_item = None
            return

        self.player.model.cue('RoundGunToHandSYS', RoundGunToHandSYS)
        self.player.model.cue('RoundHandToPocketSYS', RoundHandToPocketSYS)
        self.player.model.cue('RoundHandToDropSYS', RoundHandToDropSYS)
        self.player.model.cue('RoundPocketToHandSYS', RoundPocketToHandSYS)
        self.player.model.cue('RoundHandToGunSYS', RoundHandToGunSYS)
        self.player.model.cue('BoltOpen', lambda *e: self.playSfxOrSound('BoltOpen'))
        self.player.model.cue('BoltClose', lambda *e: self.playSfxOrSound('BoltClose'))
        duration = self.player.model.reload_RPG7.duration
        if self.player.active_weapon.getAmmoNumber():
            duration += self.player.model.reload_RPG7_pull_out.duration
            self.player.model.reload_RPG7_pull_out().reload_RPG7()
        else:
            self.player.model.reload_RPG7()
        self.player.nodeInfoR.AttachedProviders = (None, 0.3)
        self.player.nodeInfoL.AttachedProviders = (None, 0.3)
        BigWorld.callback(duration - 0.1, partial(self.returnHand, self.player, blend_time=0.2))
        BigWorld.callback(duration + 0.01, self.onFini)
        return

    def cancelReload(self, smooth = True):
        if self.player and self.player.model:
            self.player.model.Lmanipulator = None
            self.player.model.reload_RPG7_pull_out.stop()
            self.player.model.reload_RPG7.stop()
        BaseWeaponManualReloader.cancelReload(self, smooth=True)
        return