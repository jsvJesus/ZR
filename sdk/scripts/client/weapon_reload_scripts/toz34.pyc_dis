                patr_in_weaponTopIdle.shell_skinned = 'red'
                patr_in_weaponBottomIdle.shell_skinned = 'green'
                patr_in_weaponTop.shell_skinned = 'blue'
                patr_in_weaponBottom.shell_skinned = 'yellow'
                patr_in_hand.shell_skinned = 'white'
            except:
                traceback.print_exc()

        player.model.Rhand = Rhand_model
        self.player.active_weapon.setVisibleModel(Rhand_model)
        patr_in_weaponTopIdle.visible = False
        patr_in_weaponBottomIdle.visible = False
        patr_in_weaponTop.visible = True
        patr_in_weaponBottom.visible = True
        patr_in_hand.visible = False
        action_pl = player.model.action(anim_name)
        action_w = Rhand_model.action(anim_name)
        Rhand_model.forceDraw()
        self.xspeed = 1.1 * self.reload_speed

        def actionSet(parent, action_name, pool):
            if not pool:
                return 0.0
            callb, startfr, endfr = pool.pop(0)
            dur = (endfr - startfr) / (parent.frameRate * self.xspeed)
            res = parent(0, callb, 0, startfr, endfr, parent.frameRate * self.xspeed)
            if not pool:
                return dur
            next_action = getattr(res, action_name)
            return dur + actionSet(next_action, action_name, pool)

        need_ammo = getattr(self.player.active_weapon, 'need_ammo_number', 1)
        st_fr = 90
        end_fr = 102
        if need_ammo == 2:
            pool = [(step_1, -1, st_fr),
             (step_2, st_fr, end_fr),
             (step_3, st_fr, end_fr),
             (step_4, end_fr, action_pl.lastFrame)]
            poolw = [(None, -1, st_fr),
             (None, st_fr, end_fr),
             (None, st_fr, end_fr),
             (None, end_fr, action_w.lastFrame)]
        else:
            pool = [(step_1, -1, st_fr), (step_3, st_fr, end_fr), (step_4, end_fr, action_pl.lastFrame)]
            poolw = [(None, -1, st_fr), (None, st_fr, end_fr), (None, end_fr, action_w.lastFrame)]
        dur_pl = actionSet(action_pl, anim_name, pool)
        dur_w = actionSet(action_w, anim_name, poolw)
        BigWorld.callback(dur_pl - 0.39999999999999997, _returnHand)
        return

    def cancelReload(self, smooth = True):
        self._canceled = True
        self.unsubscribeCues()
        acts = self.player.model.reload_TOZ34.playedInfo()
        played_ = 0
        frameRate = self.player.model.reload_TOZ34.frameRate
        for a in acts:
            if a['name_'] == 'reload_TOZ34':
                played_ = a['played_']
                duration = a['duration']

        player = self.player

        def onMoveComplete(isBreak):
            if isBreak:
                return
            if not player or player.isDestroyed:
                return
            player.active_weapon.setVisibleModel(player.active_weapon_model)

        def _returnHand():
            if not player or player.isDestroyed:
                return
            interval = 0.4
            player.nodeInfoR.AttachedProviders = (player.right_weapon_prov, interval, onMoveComplete)
            player.nodeInfoL.AttachedProviders = (player.left_weapon_prov, 0.01)

        speed = 1.9
        st_fr = 90.0
        end_fr = 102.0
        if self._step in (1, 2):
            played_ += st_fr / frameRate
        played_frame = int(played_ * frameRate)
        BigWorld.callback(played_ / speed - 0.3, _returnHand)
        self.player.model.Rhand.reload_TOZ34.stop()
        self.player.model.reload_TOZ34.stop()
        self.player.model.Rhand.reload_TOZ34(0, None, 0, played_frame, 0, frameRate * speed)
        self.player.model.reload_TOZ34(0, None, 0, played_frame, 0, frameRate * speed)

        def continuecancel():
            BaseWeaponReloader.cancelReload(self, smooth=smooth)

        BigWorld.callback(played_ / speed + 0.3, continuecancel)
        return