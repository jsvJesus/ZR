DEBUG = False

def blendOffset(player, Lhand_model, handprov, interval):
    weapon_lhand = player.active_weapon_model.node('HP_Lhand')
    model_lhand = player.model.node('HP_Lhand')
    player.model.forceDraw()
    weapon_lhand = Matrix(weapon_lhand)
    model_lhand = Matrix(model_lhand)
    offset_matrx = Matrix(model_lhand)
    offset_matrx.invert()
    offset_matrx.preMultiply(weapon_lhand)
    Lhand_model.setBlendedMatrixOffset(1, 0, interval, offset_matrx)


def blendOutOffset(player, Lhand_model, handprov, interval):
    if handprov is None:
        handprov = player.left_weapon_prov
    offset_prov = handprov.getAddRotateProvider()
    Lhand_model.setBlendedMatrixOffset(0, 1, interval, offset_prov)
    return


class ReloadTOZ34(BaseWeaponReloader):
    anim_name = 'reload_TOZ34'

    def play(self, e = None):
        patr_name = 'characters2/weapons/ammo/12x7x/ammo_buckshot_lod1.model'
        anim_name = self.anim_name
        player = self.player

        def playSoundSafe(name):
            BigWorld.callback(0, partial(self.playSfxOrSound, name))

        def BoltOpen(*e):
            self.playSfxOrSound('BoltOpen')

        def BoltClose(*e):
            self.playSfxOrSound('BoltClose')

        @not_safe_animation_callback
        def RoundGunToHandSYS(*e):
            patr_in_hand.visible = True
            patr_in_weaponTop.visible = False
            if need_ammo > 1:
                patr_in_weaponBottom.visible = False
            playSoundSafe('RoundGunToHandSYS')

        @not_safe_animation_callback
        def RoundHandToDropSYS(*e):
            patr_in_hand.visible = False
            playSoundSafe('RoundHandToDropSYS')

        @not_safe_animation_callback
        def RoundPocketToHandSYS(*e):
            patr_in_hand.visible = True
            playSoundSafe('RoundPocketToHandSYS')

        @not_safe_animation_callback
        def RoundHandToGunSYS(*e):
            playSoundSafe('RoundHandToGunSYS')

        self._step = 0

        def step_1(*e):
            self._step = 1

        def step_2(*e):
            self._step = 2
            patr_in_hand.visible = False
            patr_in_weaponBottom.visible = True
            if self._onInsetAmmoCallback:
                self._onInsetAmmoCallback(self.ammo_or_magazine_item)

        def step_3(*e):
            self._step = 3
            patr_in_hand.visible = False
            patr_in_weaponTop.visible = True
            if self._onInsetAmmoCallback:
                self._onInsetAmmoCallback(self.ammo_or_magazine_item)

        def step_4(*e):
            self._step = 4

        self.player.model.cue('BoltOpen', BoltOpen)
        self.player.model.cue('BoltClose', BoltClose)
        self.player.model.cue('RoundGunToHandSYS', RoundGunToHandSYS)
        self.player.model.cue('RoundHandToDropSYS', RoundHandToDropSYS)
        self.player.model.cue('RoundPocketToHandSYS', RoundPocketToHandSYS)
        self.player.model.cue('RoundHandToGunSYS', RoundHandToGunSYS)

        def onMoveComplete(isBreak):
            if isBreak:
                return
            elif not player or player.isDestroyed:
                return
            else:
                player.active_weapon.setVisibleModel(player.active_weapon_model)
                player.model.Rmanipulator = None
                self.onFini()

                def endR(isBreak):
                    if isBreak:
                        return
                    else:
                        player.model.Lhand = None
                        player.model.Rhand = None
                        return

                return

        def onEndAnim():
            pass

        def onHandInFake(isBreak):
            if isBreak:
                return

        def _returnHand():
            if not player or player.isDestroyed:
                return
            if self._canceled:
                return
            interval = 0.4
            player.nodeInfoR.AttachedProviders = (player.right_weapon_prov, interval, onMoveComplete)
            player.nodeInfoL.AttachedProviders = (fake_Lhand_provider, 0.1)

            def detachLfake1():
                player.nodeInfoL.AttachedProviders = (player.left_weapon_prov, 0.1)

            BigWorld.callback(0.4, detachLfake1)
            blendOutOffset(player, Rhand_model, player.right_weapon_prov, interval)

        def _draw(prov, color = (0, 1, 0, 1), size = 0.2):
            pass

        def onLeft(isBreak):
            if isBreak:
                return

        player.model.Lhand = None
        Rhand_model = self.player.active_weapon.createCopyModelWeapon()
        Rhand_model.node('HP_Rhand').attach(BigWorld.Model(''))
        Rhand_model.node('HP_Lhand').attach(BigWorld.Model(''))
        Rhand_model.testAnimateFromTpose = True
        fake_Lhand_provider = Rhand_model.node('HP_Lhand')
        fake_Lhand_provider.blend_factor_hand = 1
        fake_Lhand_provider.disableDrawInReflection = True
        player.nodeInfoR.AttachedProviders = (None, 0.6, onLeft)
        player.nodeInfoL.AttachedProviders = (fake_Lhand_provider, 0.1)

        def detachLfake():
            player.nodeInfoL.AttachedProviders = (None, 0.3)
            return None

        BigWorld.callback(0.4, detachLfake)
        patr_in_weaponTop = BigWorld.Model(patr_name)
        patr_in_weaponBottom = BigWorld.Model(patr_name)
        patr_in_weaponTopIdle = BigWorld.Model(patr_name)
        patr_in_weaponBottomIdle = BigWorld.Model(patr_name)
        patr_in_hand = BigWorld.Model(patr_name)
        Rhand_model.PatronTop = patr_in_weaponTop
        Rhand_model.PatronBottom = patr_in_weaponBottom
        Rhand_model.PatronTopIdle = patr_in_weaponTopIdle
        Rhand_model.PatronBottomIdle = patr_in_weaponBottomIdle
        player.model.Rmanipulator = patr_in_hand
        if DEBUG:
