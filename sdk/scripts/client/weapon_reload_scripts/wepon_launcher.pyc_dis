# Embedded file name: ./client/weapon_reload_scripts/wepon_launcher.py
import BigWorld
import BWPersonality
import Math
import traceback
from Items import ItemsCatalog
from utils import ignoreError
from utils_bw import not_safe_animation_callback
from reload_base_script import BaseWeaponReloader, BaseWeaponManualReloader
from functools import partial

class ReloadLauncher(BaseWeaponManualReloader):

    def play(self, anim_name = 'reload_GP25'):
        self.anim_name = anim_name.split(':')[-1]
        launcher_id = self.player.active_weapon._first_launcher.getID()
        gr_type = self.ammo_or_magazine_item['complexItemType']
        greande_weapon = self.player.active_weapon._first_launcher._loadModelGrenade(gr_type)
        greande_hand = self.player.active_weapon._first_launcher._loadModelGrenade(gr_type)
        Rhand_model = self.player.active_weapon.createCopyModelWeapon()
        self.player.model.Rhand = Rhand_model
        self.player.active_weapon.setVisibleModel(Rhand_model)

        def RoundGunToHandSYS(*e):
            self.playSfxOrSound('RoundGunToHandSYS')

        def RoundHandToDropSYS(*e):
            self.playSfxOrSound('RoundHandToDropSYS')

        def RoundPocketToHandSYS(*e):
            self.playSfxOrSound('RoundPocketToHandSYS')
            self.player.model.Lmanipulator = greande_hand

        def RoundHandToGunSYS(*e):
            launcher = self.player.active_weapon._getVisibleWeapon().findAttach(launcher_id)
            launcher_model = launcher.getModel()
            try:
                launcher_model.grenade = None
                launcher_model.grenade = greande_weapon
            except:
                traceback.print_exc()

            self._onInsetAmmoCallback(self.ammo_or_magazine_item)
            self.player.model.Lmanipulator = None
            self.player.active_weapon.updateLauncherGreandeByItem(self.ammo_or_magazine_item)
            self.ammo_or_magazine_item = None
            self.player.active_weapon.playSound('guns/launch/gp_25/grenade_locked', launcher_model)
            return

        self.player.model.cue('RoundGunToHandSYS', RoundGunToHandSYS)
        self.player.model.cue('RoundHandToDropSYS', RoundHandToDropSYS)
        self.player.model.cue('RoundPocketToHandSYS', RoundPocketToHandSYS)
        self.player.model.cue('RoundHandToGunSYS', RoundHandToGunSYS)
        self.player.model.cue('BoltOpen', lambda *e: self.playSfxOrSound('BoltOpen'))
        self.player.model.cue('BoltClose', lambda *e: self.playSfxOrSound('BoltClose'))
        action = self.player.model.action(self.anim_name)
        duration = action.duration
        action()
        self.player.nodeInfoR.AttachedProviders = (None, 0.3)
        self.player.nodeInfoL.AttachedProviders = (None, 0.3)
        BigWorld.callback(duration - 0.2, partial(self.returnHand, self.player, blend_time=0.4))
        BigWorld.callback(duration + 0.01, self.onFini)
        return None


class ReloadLauncherPullOut(BaseWeaponManualReloader):
    anim_name = ''

    def play(self, anim_name):
        self.anim_name = anim_name.split(':')[-1]
        greande_hand = None

        def RoundGunToHandSYS(*e):
            self.playSfxOrSound('RoundGunToHandSYS')
            self._onInsetAmmoCallback(None)
            self.player.active_weapon.updateLauncherGreandeByItem(None)
            if greande_hand:
                self.player.model.Lmanipulator = greande_hand
            launcher = self.player.active_weapon._getVisibleWeapon().findAttach(launcher_id)
            launcher.getModel().grenade = None
            self.player.active_weapon.playSound('guns/launch/gp_25/grenade_locked', launcher.getModel())
            return

        def RoundHandToPocketSYS(*e):
            self.playSfxOrSound('RoundHandToPocketSYS')
            self.player.model.Lmanipulator = None
            return

        self.player.model.cue('RoundGunToHandSYS', RoundGunToHandSYS)
        try:
            self.player.model.cue('RoundHandToPocketSYS', RoundHandToPocketSYS)
        except:
            traceback.print_exc()

        self.player.model.cue('BoltOpen', lambda *e: self.playSfxOrSound('BoltOpen'))
        self.player.model.cue('BoltClose', lambda *e: self.playSfxOrSound('BoltClose'))
        action = self.player.model.action(self.anim_name)
        duration = action.duration
        action()
        launcher_id = self.player.active_weapon._first_launcher.getID()
        gr_type = self.player.active_weapon._first_launcher.getAmmoType()
        if gr_type:
            greande_hand = self.player.active_weapon._first_launcher._loadModelGrenade(gr_type)
        Rhand_model = self.player.active_weapon.createCopyModelWeapon()
        self.player.model.Rhand = Rhand_model
        self.player.active_weapon.setVisibleModel(Rhand_model)
        self.player.nodeInfoR.AttachedProviders = (None, 0.3)
        self.player.nodeInfoL.AttachedProviders = (None, 0.3)
        BigWorld.callback(duration - 0.2, partial(self.returnHand, self.player, blend_time=0.4))
        BigWorld.callback(duration + 0.01, self.onFini)
        return