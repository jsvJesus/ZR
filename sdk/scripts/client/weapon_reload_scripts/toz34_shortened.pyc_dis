# Embedded file name: ./client/weapon_reload_scripts/toz34_shortened.py
import BigWorld
from utils_bw import not_safe_animation_callback
from reload_base_script import BaseWeaponReloader
from functools import partial

class ReloadTOZ34Shortened(BaseWeaponReloader):
    anim_name = 'reload_TOZ34'

    def play(self, e = None):
        patr_name = 'characters2/weapons/ammo/12x7x/ammo_buckshot_lod1.model'
        anim_name = self.anim_name
        player = self.player

        def playSoundSafe(name):
            BigWorld.callback(0, partial(self.playSfxOrSound, name))

        def BoltOpen(*e):
            self.playSfxOrSound('BoltOpen')

        def BoltClose(*e):
            self.playSfxOrSound('BoltClose')

        @not_safe_animation_callback
        def RoundGunToHandSYS(*e):
            patr_in_hand.visible = True
            patr_in_weaponTop.visible = False
            if need_ammo > 1:
                patr_in_weaponBottom.visible = False
            playSoundSafe('RoundGunToHandSYS')

        @not_safe_animation_callback
        def RoundHandToDropSYS(*e):
            patr_in_hand.visible = False
            playSoundSafe('RoundHandToDropSYS')

        @not_safe_animation_callback
        def RoundPocketToHandSYS(*e):
            patr_in_hand.visible = True
            playSoundSafe('RoundPocketToHandSYS')

        @not_safe_animation_callback
        def RoundHandToGunSYS(*e):
            playSoundSafe('RoundHandToGunSYS')

        self._step = 0

        def step_1(*e):
            self._step = 1

        def step_2(*e):
            self._step = 2
            patr_in_hand.visible = False
            patr_in_weaponBottom.visible = True
            if self._onInsetAmmoCallback:
                self._onInsetAmmoCallback(self.ammo_or_magazine_item)

        def step_3(*e):
            self._step = 3
            patr_in_hand.visible = False
            patr_in_weaponTop.visible = True
            if self._onInsetAmmoCallback:
                self._onInsetAmmoCallback(self.ammo_or_magazine_item)

        def step_4(*e):
            self._step = 4

        player.model.cue('BoltOpen', BoltOpen)
        player.model.cue('BoltClose', BoltClose)
        player.model.cue('RoundGunToHandSYS', RoundGunToHandSYS)
        player.model.cue('RoundHandToDropSYS', RoundHandToDropSYS)
        player.model.cue('RoundPocketToHandSYS', RoundPocketToHandSYS)
        player.model.cue('RoundHandToGunSYS', RoundHandToGunSYS)

        def onHandInFake(isBreak):
            if isBreak:
                return

        def _returnHand():
            if not player or player.isDestroyed:
                return
            if self._canceled:
                return
            player._weapon_to_attached = 'Right'
            player._HandControl__reload_weapon_osn_anmation = False
            player._HandControl__check()

        def onLeft(isBreak):
            if isBreak:
                return

        player.model.Lhand = None
        Rhand_model = player.active_weapon.createCopyModelWeapon()
        Rhand_model.node('HP_Rhand').attach(BigWorld.Model(''))
        Rhand_model.node('HP_Lhand').attach(BigWorld.Model(''))
        Rhand_model.testAnimateFromTpose = True
        fake_Lhand_provider = Rhand_model.node('HP_Lhand')
        fake_Lhand_provider.blend_factor_hand = 1
        fake_Lhand_provider.disableDrawInReflection = True
        player.nodeInfoR.AttachedProviders = (None, 0.6, onLeft)
        player.nodeInfoL.AttachedProviders = (fake_Lhand_provider, 0.1)

        def detachLfake():
            player.nodeInfoL.AttachedProviders = (None, 0.3)
            return None

        BigWorld.callback(0.4, detachLfake)
        patr_in_weaponTop = BigWorld.Model(patr_name)
        patr_in_weaponBottom = BigWorld.Model(patr_name)
        patr_in_weaponTopIdle = BigWorld.Model(patr_name)
        patr_in_weaponBottomIdle = BigWorld.Model(patr_name)
        patr_in_hand = BigWorld.Model(patr_name)
        Rhand_model.PatronTop = patr_in_weaponTop
        Rhand_model.PatronBottom = patr_in_weaponBottom
        Rhand_model.PatronTopIdle = patr_in_weaponTopIdle
        Rhand_model.PatronBottomIdle = patr_in_weaponBottomIdle
        player.model.Rmanipulator = patr_in_hand
        player.model.Rhand = Rhand_model
        player.active_weapon.setVisibleModel(Rhand_model)
        patr_in_weaponTopIdle.visible = False
        patr_in_weaponBottomIdle.visible = False
        patr_in_weaponTop.visible = True
        patr_in_weaponBottom.visible = True
        patr_in_hand.visible = False
        action_pl = player.model.action(anim_name)
        action_w = Rhand_model.action(anim_name)
        Rhand_model.forceDraw()
        self.xspeed = 1.1 * self.reload_speed

        def actionSet(parent, action_name, pool):
            if not pool:
                return 0.0
            callb, startfr, endfr = pool.pop(0)
            dur = (endfr - startfr) / (parent.frameRate * self.xspeed)
            res = parent(0, callb, 0, startfr, endfr, parent.frameRate * self.xspeed)
            if not pool:
                return dur
            next_action = getattr(res, action_name)
            return dur + actionSet(next_action, action_name, pool)

        need_ammo = getattr(player.active_weapon, 'need_ammo_number', 0)
        st_fr = 90
        end_fr = 102
        if need_ammo == 2:
            pool = [(step_1, -1, st_fr),
             (step_2, st_fr, end_fr),
             (step_3, st_fr, end_fr),
             (step_4, end_fr, action_pl.lastFrame)]
            poolw = [(None, -1, st_fr),
             (None, st_fr, end_fr),
             (None, st_fr, end_fr),
             (None, end_fr, action_w.lastFrame)]
        else:
            pool = [(step_1, -1, st_fr), (step_3, st_fr, end_fr), (step_4, end_fr, action_pl.lastFrame)]
            poolw = [(None, -1, st_fr), (None, st_fr, end_fr), (None, end_fr, action_w.lastFrame)]
        dur_pl = actionSet(action_pl, anim_name, pool)
        dur_w = actionSet(action_w, anim_name, poolw)
        BigWorld.callback(dur_pl - 0.39999999999999997, _returnHand)
        BigWorld.callback(dur_pl, self.onFini)
        return

    def cancelReload(self, smooth = True):
        self._canceled = True
        self.unsubscribeCues()
        acts = self.player.model.reload_TOZ34.playedInfo()
        played_ = 0
        frameRate = self.player.model.reload_TOZ34.frameRate
        for a in acts:
            if a['name_'] == 'reload_TOZ34':
                played_ = a['played_']

        player = self.player

        def onMoveComplete(isBreak):
            if isBreak:
                return
            if not player or player.isDestroyed:
                return
            player.active_weapon.setVisibleModel(player.active_weapon_model)

        def _returnHand():
            if not player or player.isDestroyed:
                return
            interval = 0.4
            player.nodeInfoR.AttachedProviders = (player.right_weapon_prov, interval, onMoveComplete)
            player.nodeInfoL.AttachedProviders = (player.left_weapon_prov, 0.01)

        speed = 1.9
        st_fr = 90.0
        if self._step in (1, 2):
            played_ += st_fr / frameRate
        played_frame = int(played_ * frameRate)
        BigWorld.callback(played_ / speed - 0.3, _returnHand)
        self.player.model.reload_TOZ34.stop()
        self.player.model.reload_TOZ34(0, None, 0, played_frame, 0, frameRate * speed)

        def continuecancel():
            BaseWeaponReloader.cancelReload(self, smooth=smooth)

        BigWorld.callback(played_ / speed + 0.3, continuecancel)
        return