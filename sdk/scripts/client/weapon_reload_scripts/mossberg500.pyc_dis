# Embedded file name: ./client/weapon_reload_scripts/mossberg500.py
import BigWorld
import time
import BWPersonality
import Math, math
from Math import Matrix, Vector3
import traceback
from Items import ItemsCatalog
from utils import ignoreError
from utils_bw import not_safe_animation_callback
from reload_base_script import BaseWeaponReloader
from reload_base_script import _set_visible_magazine_from_model

class ReloadMossberg500(BaseWeaponReloader):

    def cancelReload(self, smooth = True):
        if not self.player:
            return
        if self.player.model:
            for anim_name in 'reload_MOSSBERG500_in reload_MOSSBERG500_loop reload_MOSSBERG500_out'.split():
                try:
                    self.player.model.action(anim_name).stop()
                except:
                    print 'anim_name:', anim_name
                    traceback.print_exc()

        BaseWeaponReloader.cancelReload(self, smooth=smooth)

    def play(self, anim_name = None):
        BigWorld.callback(15.0, self.onFini)
        player = self.player
        to_anim_interval = 0.5
        player.nodeInfoL.AttachedProviders = (None, to_anim_interval)
        player.nodeInfoR.AttachedProviders = (None, to_anim_interval)
        Rhand_model = self.player.active_weapon.createCopyModelWeapon()
        player.model.Rhand = Rhand_model
        Rhand_model.node('HP_Lhand').attach(BigWorld.Model(''))
        Rhand_model.testAnimateFromTpose = True
        self.player.blendHandOffset(Rhand_model, self.player.right_weapon_prov, 1, 0, to_anim_interval)
        self.player.active_weapon.setVisibleModel(Rhand_model)

        def onInsertAmmo(*e):
            if self._canceled:
                return
            if self._onInsetAmmoCallback:
                self._onInsetAmmoCallback(self.ammo_or_magazine_item)

        def onMoveComplete(isBreak):
            if isBreak:
                return
            elif not player or player.isDestroyed:
                return
            elif self._canceled:
                return
            else:
                player.active_weapon.setVisibleModel(player.active_weapon_model)
                player.model.Rmanipulator = None
                self.onFini()

                def endR(isBreak):
                    if isBreak:
                        return
                    else:
                        player.model.Rhand = None
                        return

                player.nodeInfoL.AttachedProviders = (player.left_weapon_prov, 0.3, endR)
                return

        def _returnHand():
            if not player or player.isDestroyed:
                return
            if self._canceled:
                return
            to_tr_interval = 0.3
            player.nodeInfoR.AttachedProviders = (player.right_weapon_prov, to_tr_interval, onMoveComplete)
            player.nodeInfoL.AttachedProviders = (player.left_weapon_prov, to_tr_interval)
            player.blendHandOffset(Rhand_model, player.right_weapon_prov, 0.0, 1.0, to_tr_interval)

        act = self.player.model.reload_MOSSBERG500_in
        anim = act(0, None, 0, act.firstFrame, act.lastFrame, act.frameRate * self.reload_speed)
        duration = act.duration
        for x in xrange(getattr(player.active_weapon, 'need_ammo_number', 1)):
            act = self.player.model.reload_MOSSBERG500_loop
            anim = anim.reload_MOSSBERG500_loop(0, onInsertAmmo, 0, act.firstFrame, act.lastFrame, act.frameRate * self.reload_speed)
            duration += act.duration

        act = self.player.model.reload_MOSSBERG500_out
        anim.reload_MOSSBERG500_out(0, None, 0, act.firstFrame, act.lastFrame, act.frameRate * self.reload_speed)
        duration += act.duration
        duration = duration / self.reload_speed
        BigWorld.callback(duration - 0.3, _returnHand)
        BigWorld.callback(duration + 2, self.onFini)
        return