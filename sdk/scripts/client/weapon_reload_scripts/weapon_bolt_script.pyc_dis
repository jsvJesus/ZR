# Embedded file name: ./client/weapon_reload_scripts/weapon_bolt_script.py
import BigWorld
import BWPersonality
import Math
import traceback
from Items import ItemsCatalog
from utils import ignoreError
from utils_bw import not_safe_animation_callback
from reload_base_script import BaseWeaponReloader, BaseWeaponManualReloader
from functools import partial

class BaseWeaponBoltAnimation(BaseWeaponManualReloader):
    LEFT_HAND = False

    def __init__(self, player, onComplete, *w, **kw):
        self.player = player
        self._onComplete = onComplete

    def isBoltAnimation(self):
        return True

    def play(self, anim_name):
        BigWorld.callback(0.0, lambda : self._continuePlay(anim_name))

    def _continuePlay(self, anim_name):
        try:
            action_pl = self.player.model.action(anim_name)
        except:
            print 'avatar model= anim_name: %r' % anim_name
            print 'self.player', self.player
            print 'weapon', self.player.active_weapon
            if self.player == BigWorld.player() and self.player.isAdminAccess():
                BWPersonality.gpd.sendHightMessage(u'\u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d \u044d\u043a\u0448\u043d \u0443 \u0438\u0433\u0440\u043e\u043a\u0430:%r' % anim_name)
            traceback.print_exc()
            self.onFini()
            return False

        self.player.nodeInfoL.AttachedProviders = (None, self.player.TO_TRACKER_HAND_DELAY)
        self.player.nodeInfoR.AttachedProviders = (None, self.player.TO_TRACKER_HAND_DELAY)
        copy_model = self.player.active_weapon.createCopyModelWeapon()
        copy_model.testAnimateFromTpose = True
        if self.LEFT_HAND:
            self.player.model.Lhand = copy_model
            self.player.blendHandOffset(copy_model, self.player.left_weapon_prov, 1, 0, self.player.TO_TRACKER_HAND_DELAY)
        if not self.LEFT_HAND:
            self.player.model.Rhand = copy_model
            self.player.blendHandOffset(copy_model, self.player.right_weapon_prov, 1, 0, self.player.TO_TRACKER_HAND_DELAY)
        self.player.active_weapon.setVisibleModel(copy_model)
        action_pl(0, self._onEndAnimationRealod)
        try:
            action_w = copy_model.action(anim_name)
            action_w()
        except:
            print 'weapon anim_name: %r' % anim_name
            if self.player == BigWorld.player() and self.player.isAdminAccess():
                BWPersonality.gpd.sendHightMessage(u'\u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d \u044d\u043a\u0448\u043d \u0443 \u043e\u0440\u0443\u0436\u0438\u044f:%r' % anim_name)
            traceback.print_exc()

        duration = action_pl.duration
        delay = duration - self.player.TO_TRACKER_HAND_DELAY - 0.03
        BigWorld.callback(delay, partial(self.returnHand, self.player, right=not self.LEFT_HAND))
        return

    def _onEndAnimationRealod(self):
        self.onFini()