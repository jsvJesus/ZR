# Embedded file name: ./client/Tutorial/GetItemsPhase.py
from PollPhase import PollPhase

class GetItemsPhase(PollPhase):
    INVENTORY_ITEMS, EQUIPPED_ITEMS, UNEQUIPPED_ITEMS, ALL_ITEMS = xrange(4)

    def __init__(self, items, mode, global_index, actor):
        self._items = items
        self._mode = mode
        PollPhase.__init__(self, [self._check], global_index, actor)

    def _check(self):
        all_types = set()
        if self._mode in [GetItemsPhase.EQUIPPED_ITEMS, GetItemsPhase.UNEQUIPPED_ITEMS, GetItemsPhase.ALL_ITEMS]:
            for item_data in self.actor.EquippedArmor.values():
                all_types.add(item_data['itemType'])

            for item in self.actor.ActiveGadgetList:
                all_types.add(item['GadjetType'])

        if self._mode in [GetItemsPhase.INVENTORY_ITEMS, GetItemsPhase.ALL_ITEMS]:
            for item in self.actor.CarryingItems:
                all_types.add(item['complexItemType'])

        if self._mode == GetItemsPhase.UNEQUIPPED_ITEMS:
            for item_type in self._items:
                if item_type in all_types:
                    return False

        else:
            for item_type in self._items:
                if item_type not in all_types:
                    return False

        return True