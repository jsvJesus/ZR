# Embedded file name: ./client/Tutorial/CorpsePhase.py
import BigWorld
import ResourceLoader
from functools import partial
from Localization import lc
from SequentialPhase import SequentialPhase
from WaitAnimationPhase import WaitAnimationPhase
from GetItemsPhase import GetItemsPhase
from QuestEntity import QuestEntity
import traceback
import Helpers.Caps
import Math
ASYNC_LOAD_COUNTER_LIMIT = 50
ASYNC_LOAD_CALLBACK_DELAY = 0.1
PARTICLE_PATH = 'particles/artifacts/ognevik_blue.xml'

class CorpsePhase(SequentialPhase):

    def __init__(self, global_index, actor):
        wait_phase = partial(WaitAnimationPhase, global_index, actor)
        get_item_phase = partial(GetItemsPhase, [1197], GetItemsPhase.INVENTORY_ITEMS, global_index, actor)
        self._pulse = None
        self._quest_object = None
        self._async_load_callback = 0
        self._async_load_counter = 0
        self._particle = None
        SequentialPhase.__init__(self, [wait_phase, get_item_phase], global_index, actor)
        return

    def create_component(self):
        return self.create_standard_text()

    def _animate_stalker(self):
        if self.completed:
            return
        else:
            stalker_object = None
            for e in BigWorld.entities.values():
                if isinstance(e, QuestEntity):
                    if e.conditions and e.conditions[0]['quest_id'] == 10565:
                        if stalker_object:
                            raise RuntimeError
                        stalker_object = e

            if not stalker_object or not stalker_object.model:
                BigWorld.callback(0, self._animate_stalker)
                return
            stalker_object.targetCaps = [Helpers.Caps.CAP_CAN_TALK]
            stalker_object.model.height = 0.3
            try:
                stalker_object.model.dead_stalker()
            except:
                traceback.print_exc()
                traceback.print_stack()

            inverted_name = self.actor.name[::-1]
            stalker_object.get_mark_name = lambda : inverted_name
            stalker_object.get_target_mark = lambda distance: None
            stalker_object.can_talk = lambda : False
            return

    def _highlight_trigger(self):
        if self.completed:
            return
        else:
            trigger = None
            for e in BigWorld.entities.values():
                if isinstance(e, QuestEntity):
                    if e.mark['id'] == 20273:
                        if trigger:
                            raise RuntimeError
                        trigger = e

            if not trigger or not trigger.model:
                BigWorld.callback(0, self._highlight_trigger)
                return
            if self._async_load_callback:
                BigWorld.cancelCallback(self._async_load_callback)
                self._async_load_callback = 0
            if not self._particle:
                if self._async_load_counter > 0:
                    self._async_load_counter -= 1
                    self._async_load_callback = BigWorld.callback(ASYNC_LOAD_CALLBACK_DELAY, self._highlight_trigger)
                else:
                    self._async_load_counter = ASYNC_LOAD_COUNTER_LIMIT

                    def on_load(prereqs):
                        self._particle = prereqs.produce(0)
                        self._async_load_counter = 0
                        self._highlight_trigger()

                    ResourceLoader.asyncLoad([(ResourceLoader.PARTICLE, PARTICLE_PATH)], on_load)
                return
            trigger.particle = self._particle
            trigger.model.root.attach(trigger.particle)
            trigger.particle.force()
            trigger.model.idle()
            flame_r = 250
            flame_g = 100
            flame_b = 100
            timescale = 0.5
            pulseShader = Math.Vector4Animation()
            pulseShader.duration = 6.6 * timescale
            pulseShader.keyframes = [(0.0 * timescale, (0.35 * flame_r,
               0.35 * flame_g,
               0.35 * flame_b,
               0)),
             (0.6 * timescale, (0.65 * flame_r,
               0.65 * flame_g,
               0.65 * flame_b,
               0)),
             (0.7 * timescale, (0.33 * flame_r,
               0.33 * flame_g,
               0.33 * flame_b,
               0)),
             (0.9 * timescale, (0.65 * flame_r,
               0.65 * flame_g,
               0.65 * flame_b,
               0)),
             (1.2 * timescale, (0.41 * flame_r,
               0.41 * flame_g,
               0.41 * flame_b,
               0)),
             (1.5 * timescale, (0.65 * flame_r,
               0.65 * flame_g,
               0.65 * flame_b,
               0)),
             (1.7 * timescale, (0.41 * flame_r,
               0.41 * flame_g,
               0.41 * flame_b,
               0)),
             (1.9 * timescale, (0.8 * flame_r,
               0.8 * flame_g,
               0.8 * flame_b,
               0)),
             (2.1 * timescale, (0.2 * flame_r,
               0.2 * flame_g,
               0.2 * flame_b,
               0)),
             (2.4 * timescale, (0.92 * flame_r,
               0.92 * flame_g,
               0.92 * flame_b,
               0)),
             (2.7 * timescale, (0.44 * flame_r,
               0.44 * flame_g,
               0.44 * flame_b,
               0)),
             (3.2 * timescale, (0.72 * flame_r,
               0.72 * flame_g,
               0.72 * flame_b,
               0)),
             (3.7 * timescale, (0.32 * flame_r,
               0.32 * flame_g,
               0.32 * flame_b,
               0)),
             (3.9 * timescale, (0.78 * flame_r,
               0.78 * flame_g,
               0.78 * flame_b,
               0)),
             (4.2 * timescale, (0.18 * flame_r,
               0.18 * flame_g,
               0.18 * flame_b,
               0)),
             (4.4 * timescale, (0.86 * flame_r,
               0.86 * flame_g,
               0.86 * flame_b,
               0)),
             (4.8 * timescale, (0.46 * flame_r,
               0.46 * flame_g,
               0.46 * flame_b,
               0)),
             (5.5 * timescale, (0.76 * flame_r,
               0.76 * flame_g,
               0.76 * flame_b,
               0)),
             (5.8 * timescale, (0.22 * flame_r,
               0.22 * flame_g,
               0.22 * flame_b,
               0)),
             (6.3 * timescale, (0.8 * flame_r,
               0.8 * flame_g,
               0.8 * flame_b,
               0)),
             (6.5 * timescale, (0.36 * flame_r,
               0.36 * flame_g,
               0.36 * flame_b,
               0)),
             (6.5 * timescale, (0.54 * flame_r,
               0.54 * flame_g,
               0.54 * flame_b,
               0))]
            self._pulse = BigWorld.PyChunkLight()
            self._pulse.innerRadius = 1
            self._pulse.outerRadius = 4
            self._pulse.position = trigger.position + (0, 1.5, 0)
            self._pulse.shader = pulseShader
            self._pulse.specular = 1
            self._pulse.diffuse = 1
            self._pulse.visible = True
            return

    def phase_started(self, phase, phase_index):
        if phase_index == 0:
            try:
                self._highlight_trigger()
            except:
                print traceback.format_exc()

            try:
                self._animate_stalker()
            except:
                print traceback.format_exc()

        self.set_standard_text(lc('Tutorial.phases.PHASE_19_' + str(phase_index)))
        self.show_in_gui()

    def on_destroy(self):
        SequentialPhase.on_destroy(self)
        if self._pulse:
            self._pulse.visible = False
            self._pulse = None
        if self._quest_object:
            BigWorld.destroyEntity(self._quest_object.id)
        return