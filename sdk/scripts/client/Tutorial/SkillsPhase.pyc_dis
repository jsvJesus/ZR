# Embedded file name: ./client/Tutorial/SkillsPhase.py
from perks_system import perks_parser
from Localization import lc
from SequentialPhase import SequentialPhase
from OpenUIPhase import OpenUIPhase, SKILLS_TYPE
from functools import partial
from PollPhase import PollPhase

class SkillsPhase(SequentialPhase):

    def __init__(self, global_index, actor):
        open_phase = partial(OpenUIPhase, SKILLS_TYPE, global_index, actor)
        phase = partial(PollPhase, [self._check_skills], global_index, actor)
        SequentialPhase.__init__(self, [open_phase, phase], global_index, actor)

    def _check_skills(self):
        return perks_parser.get_perk_by_alias('modification', self.actor.perks)

    def create_component(self):
        return self.create_standard_text()

    def phase_started(self, phase, phase_index):
        self.set_standard_text(lc('Tutorial.phases.PHASE_13_' + str(phase_index)))
        self.show_in_gui()