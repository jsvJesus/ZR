# Embedded file name: ./client/Tutorial/SetQuickbarPhase.py
from PollPhase import PollPhase

class SetQuickbarPhase(PollPhase):

    def __init__(self, item_types, global_index, actor):
        PollPhase.__init__(self, [self._check], global_index, actor)
        self._items = {}
        for item_type in item_types:
            has_item = self.actor.has_item_in_quick_slots(item_type)
            self._items[item_type] = 1 if has_item else 0

        if not self._items:
            self.phase_completed()

    def _check(self):
        check = False
        for item_type, value in self._items.items():
            if value is True:
                continue
            has_item = self.actor.has_item_in_quick_slots(item_type)
            if value == 0 and has_item:
                self._items[item_type] = True
                check = True
            if value == 1 and not has_item:
                self._items[item_type] = 0

        if check and all((value is True for value in self._items.values())):
            return True
        return False