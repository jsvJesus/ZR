    def __init__(self, phases_builders, global_index, actor, lock_interactions = False):
        Phase.__init__(self, global_index, actor, lock_interactions=lock_interactions)
        self._inside_triggers = set()
        self._phase_index = -1
        self._phases = phases_builders
        self.phase_started_callback = self.phase_started
        self._next_phase()

    def phase_started(self, phase, phase_index):
        pass

    def _next_phase(self):
        self._phase_index += 1
        if self._phase_index >= len(self._phases):
            self.phase_completed()
            return
        self._phases[self._phase_index] = self._phases[self._phase_index]()
        self._cur_phase.complete_callback = self._phase_completed
        self.phase_started_callback(self._cur_phase, self._phase_index)
        for trigger_id in self._inside_triggers:
            trigger = BigWorld.entities.get(trigger_id)
            if trigger:
                self._cur_phase.on_player_client_trigger(True, trigger)

    def _phase_completed(self):
        self._cur_phase.on_destroy()
