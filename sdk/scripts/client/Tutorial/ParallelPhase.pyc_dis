# Embedded file name: ./client/Tutorial/ParallelPhase.py
from Phase import Phase

class ParallelPhase(Phase):

    def __init__(self, phases, global_index, actor, lock_interactions = False):
        Phase.__init__(self, global_index, actor, lock_interactions)
        self._phases = phases
        for phase in self._phases:
            phase.complete_callback = self._phase_completed

    def _phase_completed(self):
        if all((phase.completed for phase in self._phases)):
            self.phase_completed()

    def on_player_client_trigger(self, is_inside, trigger):
        for phase in self._phases:
            if phase.completed:
                continue
            phase.on_player_client_trigger(is_inside, trigger)

    def on_throwable_anomaly_hit(self, trowable_id, anomaly_id):
        for phase in self._phases:
            if phase.completed:
                continue
            phase.on_throwable_anomaly_hit(trowable_id, anomaly_id)

    def on_weapon_upgrade(self, item_id):
        for phase in self._phases:
            if phase.completed:
                continue
            phase.on_weapon_upgrade(item_id)

    def on_destroy(self):
        Phase.on_destroy(self)
        for phase in self._phases:
            phase.on_destroy()