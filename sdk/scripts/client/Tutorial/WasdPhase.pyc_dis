# Embedded file name: ./client/Tutorial/WasdPhase.py
import BigWorld
import BWPersonality
from InterceptActionsPhase import InterceptActionsPhase
from SequentialPhase import SequentialPhase
from Localization import lc
from functools import partial
from TabPhase import TabPhase
from WelcomePhase import WelcomePhase

class Fader:

    def __init__(self, component):
        self._start_alpha = 200
        self._component = component
        self._component.colour[3] = self._start_alpha
        self._component.position[2] = 0.5

    def show(self):
        BWPersonality.GUICore.tutorialLayer.addChild(self._component, 'tutorial_fade')

    def _fade_out(self):
        self._component.colour[3] = max(0, self._component.colour[3] - BigWorld.getTimeDelta() * 100)
        if self._component.colour[3] == 0:
            try:
                BWPersonality.GUICore.tutorialLayer.delChild(self._component)
            except:
                pass

        else:
            BigWorld.callback(0, self._fade_out)

    def hide(self):
        if not BWPersonality.GUICore.tutorialLayer.hasChild(self._component, False):
            return
        if self._component.colour[3] < self._start_alpha:
            return
        self._fade_out()


class WasdPhase(SequentialPhase, InterceptActionsPhase):

    def __init__(self, global_index, actor):
        actions = ('MoveForward', 'MoveBackward', 'StrafeRight', 'StrafeLeft')
        tab_phase = partial(TabPhase, global_index, actor)
        welcome_phase = partial(WelcomePhase, global_index, actor)
        wasd_phase = partial(InterceptActionsPhase, actions, global_index, actor, False)
        SequentialPhase.__init__(self, [tab_phase, welcome_phase, wasd_phase], global_index, actor)
        InterceptActionsPhase.__init__(self, self.move_actions, global_index, actor)
        self._intercept_moving = True
        self._fader = Fader(self.create_fade_component())
        self._fader.show()
        BWPersonality.GUICore.hideWorldLayer(True)
        BWPersonality.GUICore.mouseAltMode = False
        BWPersonality.game.set_cursor_mouse(False)

    def create_component(self):
        return self.create_standard_text()

    def _key_intercepted(self, event):
        return self._intercept_moving and bool(self._find_key(event.key))

    def phase_started(self, phase, phase_index):
        if phase_index == 1:
            self._fader.hide()
            self.actor.request_tutorial_quest(self.global_index, phase_index)
            BWPersonality.GUICore.show_tutorial_skip_in_ingame_menu(True)
            BWPersonality.GUICore.tutorial_gui.show_skip(True)
        elif phase_index == 2:
            self._intercept_moving = False
            self.set_standard_text(lc('Tutorial.phases.PHASE_1_' + str(phase_index)))
            self.show_in_gui()

    def on_destroy(self):
        BWPersonality.GUICore.hideWorldLayer(False)
        SequentialPhase.on_destroy(self)
        self._fader.hide()
        InterceptActionsPhase.on_destroy(self)