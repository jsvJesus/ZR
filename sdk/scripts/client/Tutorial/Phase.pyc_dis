import BWPersonality
from soGUI.soTextField import soTextField3
import GUI

class Phase(object):

    def __init__(self, global_index, actor, lock_interactions = False):
        self.global_index = global_index
        self.complete_callback = lambda : None
        self.actor = actor
        self.completed = False
        self.destroyed = False
        self._lock_interactions = lock_interactions
        self._comp = self.create_component()

    def show_in_gui(self):
        BWPersonality.GUICore.tutorial_gui.show(self._comp)

    def on_destroy(self):
        if self.destroyed:
            return
        else:
            self.destroyed = True
            self.actor = None
            self.complete_callback = lambda : None
            return

    def phase_completed(self):
        if self.completed:
            return
        self.completed = True
        self.complete_callback()

    def create_component(self):
        return None

    def on_player_client_trigger(self, is_inside, trigger):
        pass

