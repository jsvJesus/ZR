        pass

    def on_weapon_upgrade(self, item_id):
        pass

    def on_restore(self):
        pass

    def need_skip(self):
        return False

    def create_fade_component(self):
        fade_component = GUI.Simple('soGUI/frame/paint/white.dds')
        fade_component.horizontalPositionMode, fade_component.verticalPositionMode = ('CLIP', 'CLIP')
        fade_component.widthMode, fade_component.heightMode = ('CLIP', 'CLIP')
        fade_component.position = (0, 0, 0.01)
        fade_component.colour = (16, 16, 16, 228)
        fade_component.materialFX = 'BLEND'
        fade_component.width, fade_component.height = (2, 2)
        return fade_component

    def create_standard_text(self):
        self._standard_text = soTextField3(GUI.Window(), width=270, height=200, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=5, hOffset=5, textureless=1, autosize=0)
        comp = self._standard_text.component
        comp.horizontalPositionMode = 'CLIP'
        comp.horizontalAnchor = 'CENTER'
        comp.position = (0, 0, 0.5)
        return comp

    def set_standard_text(self, text):
        text = BWPersonality.settings.keyBindings.parse_actions_and_replace(text)
        self._standard_text.setText(u'<alignment=center><color=255255255181><font=RobotoCondensedRegular_16.font>' + text)

    def get_state(self):
        return u'index: ' + str(self.global_index) + '  type: ' + self.__class__.__name__

    @property
    def move_actions(self):
        return ('MoveForward', 'MoveBackward', 'StrafeRight', 'StrafeLeft')

    @property
    def lock_interactions(self):
