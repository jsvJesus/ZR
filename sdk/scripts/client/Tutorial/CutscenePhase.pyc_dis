# Embedded file name: ./client/Tutorial/CutscenePhase.py
import BigWorld
import BWPersonality
from PollPhase import PollPhase

class State:
    WaitLoad, Cutscene, Completed = range(3)


class CutscenePhase(PollPhase):

    def __init__(self, global_index, actor):
        PollPhase.__init__(self, [self._check], global_index, actor)
        self._state = State.WaitLoad
        self._min_wait_time = BigWorld.time() + 1.0

    def _check(self):
        if self._state == State.WaitLoad:
            if BigWorld.time() > self._min_wait_time and not BWPersonality.GUICore.isVisibleLoaderGUI():
                BWPersonality.GUICore.show_cutscene('NEW_GAME.pyson', BWPersonality.GUICore.systemLayer, 1)
                self._state = State.Cutscene
            return False
        if self._state == State.Cutscene:
            if not BWPersonality.GUICore.cutscene_visible():
                self._state = State.Completed
            return False
        return True