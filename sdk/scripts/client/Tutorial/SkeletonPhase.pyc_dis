# Embedded file name: ./client/Tutorial/SkeletonPhase.py
from Localization import lc
import BigWorld
import BWPersonality
from SequentialPhase import SequentialPhase
from TalkNPCPhase import TalkNPCPhase
from functools import partial
from FollowNpcPhase import FollowNpcPhase
from QuestPhase import QuestPhase
import Quest

class SkeletonPhase(SequentialPhase):

    def __init__(self, global_index, actor):
        follow = partial(FollowNpcPhase, global_index, actor)
        talk = partial(TalkNPCPhase, global_index, actor)
        quest_phase = partial(QuestPhase, ((10567, Quest.STATE_CLOSED),), global_index, actor)
        SequentialPhase.__init__(self, [follow, talk, quest_phase], global_index, actor)

    def create_component(self):
        return self.create_standard_text()

    def phase_started(self, phase, phase_index):
        if phase_index == 0:
            self.set_standard_text(lc('Tutorial.phases.TALK_F'))
        elif phase_index == 1:
            if not BWPersonality.GUICore.is_dialog_screen_visible():
                npc = self.actor._tutorial_manager._recorder.get_singleton_entity()
                BigWorld.player().start_talk(npc)
            self.set_standard_text(lc('Tutorial.phases.TALK_F'))
        elif phase_index == 2:
            self.set_standard_text(lc('Tutorial.phases.PHASE_39_' + str(phase_index)))
        self.show_in_gui()