# Embedded file name: ./client/Tutorial/PollPhase.py
from Phase import Phase
import BigWorld

class PollPhase(Phase):

    def __init__(self, check_methods, global_index, actor, lock_interactions = False):
        Phase.__init__(self, global_index, actor, lock_interactions=lock_interactions)
        self._check_methods = check_methods
        self._check_result = [False] * len(self._check_methods)
        if len(self._check_methods):
            BigWorld.callback(0, self._tick)
        else:
            self.phase_completed()

    def _tick(self):
        if self.completed or self.destroyed:
            return
        update = False
        for i, method in enumerate(self._check_methods):
            if self._check_result[i]:
                continue
            if method():
                self._check_result[i] = True
                update = True

        if update and all(self._check_result):
            self.phase_completed()
            return
        BigWorld.callback(0, self._tick)