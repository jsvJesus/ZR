# Embedded file name: ./client/Tutorial/WalkPhase.py
import BWPersonality
from Phase import Phase

class WalkPhase(Phase):

    def __init__(self, *args, **kargs):
        Phase.__init__(self, *args, **kargs)
        self._plus_dx = False
        self._minus_dx = False
        BWPersonality.register_mouse_event_interceptor(self._mouse_intercepted)

    def _mouse_intercepted(self, event):
        if not self.actor.movingForward or not event.dx:
            return False
        if event.dx > 0:
            self._plus_dx = True
        if event.dx < 0:
            self._minus_dx = True
        if self._plus_dx and self._minus_dx:
            self.phase_completed()
        return False

    def on_destroy(self):
        Phase.on_destroy(self)
        BWPersonality.unregister_mouse_event_interceptor(self._mouse_intercepted)