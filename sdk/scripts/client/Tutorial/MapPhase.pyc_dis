# Embedded file name: ./client/Tutorial/MapPhase.py
import BWPersonality
from Localization import lc
from PollPhase import PollPhase

class MapPhase(PollPhase):

    def __init__(self, global_index, actor):
        PollPhase.__init__(self, [self._tooltip_visible], global_index, actor)
        self.set_standard_text(lc('Tutorial.phases.PHASE_11'))
        self.show_in_gui()

    def _tooltip_visible(self):
        if not BWPersonality.GUICore.is_worldmap_visible():
            return False
        tt = BWPersonality.GUICore.toolTip
        if not tt or not tt.component.visible or not tt.toolTipID:
            return False
        space_map = BWPersonality.GUICore.world_map._cur_space_map
        if not space_map:
            return False
        for qm in space_map._quest_marks:
            if qm.quest_id == 19633:
                break
        else:
            return False

        if tt.toolTipID != id(qm):
            return False
        return True

    def create_component(self):
        return self.create_standard_text()