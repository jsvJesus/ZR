from InterceptActionsPhase import InterceptActionsPhase
from PollPhase import PollPhase
from ParallelPhase import ParallelPhase
from SequentialPhase import SequentialPhase
from TriggerPhase import TriggerPhase
from Localization import lc

class ClimbPhase(SequentialPhase):

    def __init__(self, global_index, actor):

        def create_climb_phase():
            climb_trigger_phase = TriggerPhase(('tutorial_climb',), global_index, actor)
            actions_phase = InterceptActionsPhase(('Jump',), global_index, actor)
            return ParallelPhase((climb_trigger_phase, actions_phase), global_index, actor)

        def create_crouch_phase():
            poll_phase = PollPhase((actor.IsAvatarCrouched,), global_index, actor)
            crouch_trigger_phase = TriggerPhase(('tutorial_crouch',), global_index, actor)
            return ParallelPhase((crouch_trigger_phase, poll_phase), global_index, actor)

        SequentialPhase.__init__(self, [create_climb_phase, create_crouch_phase], global_index, actor)

    def create_component(self):
        return self.create_standard_text()

    def phase_started(self, phase, phase_index):
        self.set_standard_text(lc('Tutorial.phases.PHASE_2_' + str(phase_index)))
        self.show_in_gui()