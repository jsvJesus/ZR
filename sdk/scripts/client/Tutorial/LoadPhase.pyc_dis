# Embedded file name: ./client/Tutorial/LoadPhase.py
from Localization import lc
from PollPhase import PollPhase

class LoadPhase(PollPhase):

    def __init__(self, global_index, actor):
        PollPhase.__init__(self, [self._check], global_index, actor)
        self.set_standard_text(lc('Tutorial.phases.PHASE_44'))
        self.show_in_gui()

    def _check(self):
        weapon = self.actor.active_weapon
        if not weapon:
            return False
        if weapon.getAmmoNumber() < weapon.getAmmoCapacity():
            return False
        return True

    def create_component(self):
        return self.create_standard_text()