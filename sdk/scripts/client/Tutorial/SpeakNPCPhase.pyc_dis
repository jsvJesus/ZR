# Embedded file name: ./client/Tutorial/SpeakNPCPhase.py
import BWPersonality
import BigWorld
from PollPhase import PollPhase

class SpeakNPCPhase(PollPhase):
    COMPLETE_ON_START, COMPLETE_ON_END = xrange(2)

    def __init__(self, npc_name, complete_type, global_index, actor):
        PollPhase.__init__(self, [self._check], global_index, actor)
        self._npc_name = npc_name
        self._complete_type = complete_type
        self._speak_on_start = self._speaking_now

    def _check(self):
        if self._complete_type == SpeakNPCPhase.COMPLETE_ON_START:
            if self._speak_on_start:
                if not self._speaking_now:
                    self._speak_on_start = False
            if not self._speak_on_start:
                if self._speaking_now:
                    return True
        if self._complete_type == SpeakNPCPhase.COMPLETE_ON_END:
            if not self._speak_on_start:
                if self._speaking_now:
                    self._speak_on_start = True
            if self._speak_on_start:
                if not self._speaking_now:
                    return True
        return False

    @property
    def _speaking_now(self):
        return BWPersonality.GUICore.is_dialog_screen_visible() and self._last_speaker_name == self._npc_name

    @property
    def _last_speaker_name(self):
        if not self.actor.last_interlocutor_id:
            return None
        else:
            last_speaker = BigWorld.entities.get(self.actor.last_interlocutor_id)
            if not last_speaker:
                return None
            return getattr(last_speaker, 'npcName', None)