# Embedded file name: ./client/Tutorial/BeatPhase.py
import BigWorld
import BWPersonality
from Phase import Phase
import sounds_manager as sounds

class BeatPhase(Phase):

    def __init__(self, *args, **kargs):
        Phase.__init__(self, *args, **kargs)
        sounds.playSound('players/injury')
        self._sound = sounds.getSound('players/deafening')
        self._sound.play()
        BWPersonality.GUICore.screenFade(doShow=True, afterTime=0.0, visible_time=30, fade_speed=1.0)
        BigWorld.callback(4, self.phase_completed)

    def on_destroy(self):
        if self._sound:
            self._sound.stop()
            self._sound.releaseSound()
            self._sound = None
        Phase.on_destroy(self)
        return