# Embedded file name: ./client/Tutorial/FollowNpcPhase.py
from WaitAnimationPhase import WaitAnimationPhase
from Localization import lc

class FollowNpcPhase(WaitAnimationPhase):

    def __init__(self, global_index, actor):
        WaitAnimationPhase.__init__(self, global_index, actor)
        self.set_standard_text(lc('Tutorial.phases.PHASE_' + str(global_index), default=lc('Tutorial.phases.PHASE_FOLLOW')))
        self.show_in_gui()

    def create_component(self):
        return self.create_standard_text()

    def _check(self):
        animation_completed = WaitAnimationPhase._check(self)
        if not animation_completed:
            return False
        npc = self.actor._tutorial_manager._recorder.get_singleton_entity()
        if not npc or npc.isDestroyed:
            return False
        player = self.actor
        if not player or player.isDestroyed:
            return False
        if player.position.distTo(npc.position) > 3.0:
            return False
        return True