# Embedded file name: ./client/Tutorial/WeaponPhase.py
from SpeakNPCPhase import SpeakNPCPhase
from functools import partial
from Localization import lc
from PollPhase import PollPhase
from Items import ItemsCatalog
import ItemCategories
from SequentialPhase import SequentialPhase

class WeaponPhase(SequentialPhase):

    def __init__(self, global_index, actor):
        speak_phase = partial(SpeakNPCPhase, 'Fake_Charon', SpeakNPCPhase.COMPLETE_ON_END, global_index, actor)
        poll_phase = partial(PollPhase, [self._check], global_index, actor)
        SequentialPhase.__init__(self, [speak_phase, poll_phase], global_index, actor)
        self.show_in_gui()

    def _check(self):
        check_category = ItemCategories.TREADED_BAR
        for item in self.actor.CarryingItems:
            category = ItemsCatalog.GetItemCategory(item['complexItemType'])
            if category == check_category:
                return True
            if ItemCategories.is_subcategory(category, check_category):
                return True

        return False

    def create_component(self):
        text = self.create_standard_text()
        self.set_standard_text(lc('Tutorial.phases.PHASE_15_0'))
        return text

    def need_skip(self):
        return self._check()