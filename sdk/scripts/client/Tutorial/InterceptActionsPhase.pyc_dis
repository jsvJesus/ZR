            if self._actions.get(key) is False:
                self._actions[key] = True
                if all(self._actions.values()):
                    self._on_actions_completed()
        else:
            self._on_actions_completed()
        return False

    def _find_key(self, key):
        return next((k for k in self._actions if key in k), None)

