from ReadNotePhase import ReadNotePhase
from PollPhase import PollPhase
from ParallelPhase import ParallelPhase
from Localization import lc
from SequentialPhase import SequentialPhase
from TriggerPhase import TriggerPhase
from QuestPhase import QuestPhase
import Quest
from WaitAnimationPhase import WaitAnimationPhase

class FencePhase(SequentialPhase):
    quest_id = 10235

    def __init__(self, global_index, actor):

        def create_climb_wall_phase():
            trigger_phase = TriggerPhase(['tutorial_lookwallbehind'], global_index, actor)

            def is_looking():
                return 0.6 < actor.yaw < 2.2

            look_phase = PollPhase([is_looking], global_index, actor)
            return ParallelPhase([trigger_phase, look_phase], global_index, actor, lock_interactions=True)

        wait_phase = partial(WaitAnimationPhase, global_index, actor)
        quest_phase = partial(QuestPhase, ((FencePhase.quest_id, Quest.STATE_ONTEST),), global_index, actor)
        note_phase = partial(ReadNotePhase, global_index, actor)
        SequentialPhase.__init__(self, [wait_phase,
         create_climb_wall_phase,
         quest_phase,
         note_phase], global_index, actor)

    def create_component(self):
        return self.create_standard_text()

    def phase_started(self, phase, phase_index):
        self.set_standard_text(lc('Tutorial.phases.PHASE_9_' + str(phase_index)))
        self.show_in_gui()