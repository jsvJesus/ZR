# Embedded file name: ./client/Tutorial/TriggerPhase.py
from Phase import Phase

class TriggerPhase(Phase):

    def __init__(self, trigger_names, global_index, actor):
        Phase.__init__(self, global_index, actor)
        self._triggers = {}
        for trigger_name in trigger_names:
            self._triggers[trigger_name] = False

    def on_player_client_trigger(self, is_inside, trigger):
        if not self.completed and self._triggers.get(trigger.trigger_id) is False:
            self._triggers[trigger.trigger_id] = True
            if all(self._triggers.values()):
                self.phase_completed()