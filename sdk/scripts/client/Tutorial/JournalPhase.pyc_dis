# Embedded file name: ./client/Tutorial/JournalPhase.py
from SequentialPhase import SequentialPhase
from PollPhase import PollPhase
from OpenUIPhase import OpenUIPhase, JOURNAL_TYPE
from functools import partial
from Localization import lc

class JournalPhase(SequentialPhase):

    def __init__(self, global_index, actor):
        self._track_quest_id = 19633
        open_journal = partial(OpenUIPhase, JOURNAL_TYPE, global_index, actor, lock_interactions=True)
        track_quest = partial(PollPhase, [self._is_traking], global_index, actor, lock_interactions=True)
        SequentialPhase.__init__(self, [open_journal, track_quest], global_index, actor)

    def _is_traking(self):
        tracker = self.actor._quests_tracker
        if not tracker:
            return
        return tracker.is_tracking(self._track_quest_id)

    def create_component(self):
        return self.create_standard_text()

    def phase_started(self, phase, phase_index):
        text = lc('Tutorial.phases.PHASE_10_' + str(phase_index))
        self.set_standard_text(text)
        self.show_in_gui()