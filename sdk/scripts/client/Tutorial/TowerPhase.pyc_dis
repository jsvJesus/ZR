# Embedded file name: ./client/Tutorial/TowerPhase.py
import BWPersonality
from Localization import lc
from SequentialPhase import SequentialPhase
from SpeakNPCPhase import SpeakNPCPhase
from TriggerPhase import TriggerPhase
from GetItemsPhase import GetItemsPhase
from functools import partial
from PollPhase import PollPhase

class TowerPhase(SequentialPhase):

    def __init__(self, global_index, actor):
        speak_phase = partial(SpeakNPCPhase, 'Fake_Charon', SpeakNPCPhase.COMPLETE_ON_END, global_index, actor)
        trigger_phase = partial(TriggerPhase, ['tutorial_observation'], global_index, actor)
        equip_phase = partial(GetItemsPhase, [300], GetItemsPhase.EQUIPPED_ITEMS, global_index, actor)
        look_phase = partial(PollPhase, [self._is_looking], global_index, actor)
        SequentialPhase.__init__(self, [speak_phase,
         trigger_phase,
         equip_phase,
         look_phase], global_index, actor)

    def _is_looking(self):
        return BWPersonality.GUICore.isBinocularMode and 1.29 <= self.actor.yaw <= 2.08

    def create_component(self):
        return self.create_standard_text()

    def phase_started(self, phase, phase_index):
        self.set_standard_text(lc('Tutorial.phases.PHASE_14_' + str(phase_index)))
        self.show_in_gui()