# Embedded file name: ./client/Tutorial/RunNPCPhase.py
import BigWorld
from Localization import lc
from PollPhase import PollPhase

class RunNPCPhase(PollPhase):

    def __init__(self, global_index, actor):
        PollPhase.__init__(self, [self._check], global_index, actor)
        self._accumulator = 0.0
        self.set_standard_text(lc('Tutorial.phases.PHASE_13'))
        self.show_in_gui()

    def _check(self):
        if self.actor.sprinting:
            self._accumulator += BigWorld.getTimeDelta()
        else:
            self._accumulator = 0
        return self._accumulator >= 2.0

    def create_component(self):
        return self.create_standard_text()