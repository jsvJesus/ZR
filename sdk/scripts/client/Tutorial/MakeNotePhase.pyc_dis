# Embedded file name: ./client/Tutorial/MakeNotePhase.py
from PollPhase import PollPhase
from InterceptActionsPhase import InterceptActionsPhase
import BWPersonality

class MakeNotePhase(PollPhase, InterceptActionsPhase):

    def __init__(self, *args, **kargs):
        PollPhase.__init__(self, [self._check], *args, **kargs)
        InterceptActionsPhase.__init__(self, self.move_actions, *args, **kargs)
        self.actor.stopPlayerMoving()

    def _check(self):
        if not BWPersonality.GUICore.is_worldmap_visible():
            return False
        marks_count = BWPersonality.GUICore.world_map.marks_count_on_space('spaces/start_tutorial')
        if not hasattr(self, '_marks_count'):
            self._marks_count = marks_count
        if marks_count > self._marks_count:
            return True
        self._marks_count = marks_count
        return False

    def _key_intercepted(self, event):
        intercepted = bool(self._find_key(event.key))
        if intercepted:
            BWPersonality.GUICore.tutorial_gui.blink()
        return intercepted

    def on_destroy(self):
        PollPhase.on_destroy(self)
        InterceptActionsPhase.on_destroy(self)