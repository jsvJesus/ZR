# Embedded file name: ./client/Tutorial/AltCamPhase.py
import BigWorld
from PollPhase import PollPhase
from InterceptActionsPhase import InterceptActionsPhase

class AltCamPhase(PollPhase, InterceptActionsPhase):

    def __init__(self, global_index, actor):
        self._look_time = 0.0
        lock_actions = ('MoveForward', 'MoveBackward', 'StrafeRight', 'StrafeLeft')
        PollPhase.__init__(self, [self._check], global_index, actor)
        InterceptActionsPhase.__init__(self, lock_actions, global_index, actor)

    def _check(self):
        if self.actor.lookingaround:
            self._look_time += BigWorld.getTimeDelta()
        return self._look_time >= 2.0

    def _key_intercepted(self, event):
        return self._find_key(event.key)

    def on_destroy(self):
        PollPhase.on_destroy(self)
        InterceptActionsPhase.on_destroy(self)