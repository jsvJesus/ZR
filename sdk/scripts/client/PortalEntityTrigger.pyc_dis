# Embedded file name: ./client/PortalEntityTrigger.py
import BigWorld
from client_utils import readable_space_pos
from sounds_manager import playSound
from Constants import PORTAL_TRIGGER_TYPE
from Math import Vector3
from math_bw import angle_between_vectors
import math

class PortalEntityTrigger(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._pot_id = None
        self._tid = None
        return

    def __repr__(self):
        if self.isDestroyed:
            return 'PortalEntityTrigger[%s]Destroyed' % self.id
        return 'PortalEntityTrigger[%s]%s at %s' % (self.id, self.portalTriggerType, readable_space_pos(self))

    def onEnterWorld(self, prereqs):
        if self.radius:
            self._pot_id = BigWorld.addPot(self.matrix, self.radius, self.on_player_inside)

    def on_player_inside(self, enteredTrap, handle):
        if not enteredTrap:
            if self._tid:
                BigWorld.cancelCallback(self._tid)
            return
        if self.portalTriggerType == PORTAL_TRIGGER_TYPE.OFF:
            portal = BigWorld.entities.get(self.portalID)
            if not portal:
                return
            portal.disablePortal()
        elif self.portalTriggerType == PORTAL_TRIGGER_TYPE.DIRECTION:
            if self._tid:
                BigWorld.cancelCallback(self._tid)
            self._check_camera()

    def _check_camera(self):
        if self.isDestroyed:
            return
        cam = Vector3(BigWorld.camera().direction)
        cam.y = 0
        cam.normalise()
        tr = Vector3()
        tr.setPitchYaw(0, self.yaw)
        angle = angle_between_vectors(tr, cam)
        if angle < math.pi / 4:
            portal = BigWorld.entities.get(self.portalID)
            if not portal:
                return
            portal.enablePortal()
            return
        BigWorld.callback(0.05, self._check_camera)

    def onLeaveWorld(self):
        if self._pot_id:
            BigWorld.delPot(self._pot_id)
            self._pot_id = None
        if self._tid:
            BigWorld.cancelCallback(self._tid)
            self._tid = None
        return