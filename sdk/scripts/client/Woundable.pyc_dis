# Embedded file name: ./client/Woundable.py
"""
        \xd0\xbc\xd0\xbe\xd0\xb4\xd1\x83\xd0\xbb\xd1\x8c \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xbe\xd1\x8f\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbf\xd1\x8f\xd1\x82\xd0\xb5\xd0\xbd \xd0\xba\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb8 \xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x85\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb5\xd0\xb9
"""
from collections import defaultdict
import BWPersonality
import BigWorld
from Math import Matrix
import math_bw
from wound_and_soak_parameters import model_blood_params, material_colors, WOUND_CHANNEL
import traceback
import functools
AUTO_CLEAR_TIME = 60
AUTO_CLEAR_VALUE = 0.1
CLEAR_BLOOD_SPEED = 0.3
STAINS_PER_SECOND = 3
STAINS_DENSITY = 5
BLOOD_VISIBLE_DISTANCE = 10
MAX_SPOTS_COUNT = 5
_DEBUG_IGNORE_OPTIMIZATION = False

class BloodSpot(object):
    """ \xd0\xbe\xd1\x82\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xba\xd1\x80\xd0\xbe\xd0\xb2\xd1\x8f\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbf\xd1\x8f\xd1\x82\xd0\xbd\xd0\xbe """
    k1 = 255 / 0.9
    BLACK_POINT_COLOR = math_bw.toHEX(255, 57, 12, 16)

    def __init__(self, parent, center_pos, model, model_name, indices_dict, dists_dict, blood_config, stain_index):
        self._stain_index = stain_index
        self._stopped = False
        self._parent = parent
        self._indices_dict = indices_dict
        self._dists_dict = dists_dict
        self._model_name = model_name
        self._radius = 0.07
        self._tick()

    def _tick(self):
        self._radius += BigWorld.getTimeDelta() * 0.05
        if self._parent.isDestroyed:
            return
        if not self._indices_dict or self._stopped:
            self._parent.spot_ready(self)
            return
        for model_adress in self._indices_dict.keys():
            colors, is_ready, remove_indices = self._get_vertex_colors(model_adress)
            self._parent.model.setSeveralVertexColourIntensity(self._model_name, WOUND_CHANNEL, model_adress[0], model_adress[1], self._indices_dict[model_adress], colors)
            if is_ready:
                del self._indices_dict[model_adress]
                del self._dists_dict[model_adress]
            else:
                for i in remove_indices:
                    del self._indices_dict[model_adress][i]
                    del self._dists_dict[model_adress][i]

        BigWorld.callback(0, self._tick)

    def stop(self):
        self._stopped = True

    def _get_vertex_colors(self, model_adress):
        indices = self._indices_dict[model_adress]
        dists = self._dists_dict[model_adress]
        step = 0.1
        is_ready = True
        colors = []
        remove_indices = []
        k1 = self._radius - step
        existing_colors = self._parent.color_alphas[self._model_name][model_adress]
        for i, index in enumerate(indices):
            dist = dists[i]
            if dist < 0.05:
                alpha = 1.0
            elif dist < k1:
                alpha = 0.9
            elif dist < self._radius:
                is_ready = False
                alpha = (self._radius - dist) * 9
            else:
                is_ready = False
                alpha = 0
            prev_point = existing_colors.get(index)
            if prev_point:
                alpha = max(alpha, prev_point[0])
            if alpha > 0.89:
                remove_indices.append(i)
            colors.append(int(alpha * 255))
            existing_colors[index] = [alpha, self._stain_index]

        remove_indices.reverse()
        return (colors, is_ready, remove_indices)


class BloodRemover(object):
    """ \xd0\xbe\xd1\x87\xd0\xb8\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xba\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb8 """

    def __init__(self, parent, indices_dict, immidate):
        self._indices_dict = indices_dict
        self._parent = parent
        self._immidiate = immidate
        if self._immidiate:
            self._tick()
        else:
            BigWorld.callback(0, self._tick)

    def _tick(self):
        if self._parent.isDestroyed:
            return
        modelnames_to_delete = []
        for model_name in self._indices_dict:
            modeladress_to_delete = []
            for model_adress in self._indices_dict[model_name]:
                indices = []
                colors = []
                for i in xrange(len(self._indices_dict[model_name][model_adress]) - 1, -1, -1):
                    index = self._indices_dict[model_name][model_adress][i]
                    if self._immidiate:
                        alpha = 0
                    else:
                        alpha = self._parent.get_point_alpha(model_name, model_adress, index)
                        alpha = max(0, alpha - BigWorld.getTimeDelta() * CLEAR_BLOOD_SPEED)
                    self._parent.set_point_alpha(model_name, model_adress, index, alpha)
                    indices.append(index)
                    colors.append(int(alpha * 255))
                    if alpha == 0:
                        del self._indices_dict[model_name][model_adress][i]
                        self._parent.del_point_alpha(model_name, model_adress, index)
                    self._parent.model.setSeveralVertexColourIntensity(model_name, WOUND_CHANNEL, model_adress[0], model_adress[1], indices, colors)

                if not self._indices_dict[model_name][model_adress]:
                    modeladress_to_delete.append(model_adress)

            for model_adress in modeladress_to_delete:
                del self._indices_dict[model_name][model_adress]

            if not self._indices_dict[model_name]:
                modelnames_to_delete.append(model_name)

        for modelname in modelnames_to_delete:
            del self._indices_dict[modelname]

        if self._indices_dict:
            BigWorld.callback(0, self._tick)


class Woundable(object):
    """ \xd0\xb8\xd0\xbd\xd1\x82\xd0\xb5\xd1\x80\xd1\x84\xd0\xb5\xd0\xb9\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85, \xd0\xba\xd1\x82\xd0\xbe \xd1\x85\xd0\xbe\xd1\x87\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd1\x80\xd0\xbe\xd0\xb2\xd1\x8f\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd1\x8f\xd1\x82\xd0\xbd\xd0\xb0 """
    ON = True

    @staticmethod
    def _on_woundable_settings_changed(enabled):
        for e in BigWorld.entities.values():
            if isinstance(e, Woundable):
                e.set_wound_enabled(enabled and Woundable.ON)

    def __init__(self):
        self.color_alphas = defaultdict(lambda : defaultdict(dict))
        self._total_vertices_number = 0
        self._auto_clear_callback_id = 0
        self._stain_index = 0
        self._min_stain_index = 0
        self._active_spots = set()
        self._last_wound_point = None
        self._last_wound_time = BigWorld.time()
        self._wound_enabled = False
        return

    def onEnterWorld(self):
        self._auto_clear_callback_id = BigWorld.callback(AUTO_CLEAR_TIME, self.auto_clear_blood)
        if Woundable.ON and BWPersonality.settings.getSetting('settings').get('soakable'):
            self.set_wound_enabled(True)

    def onLeaveWorld(self):
        BigWorld.cancelCallback(self._auto_clear_callback_id)
        self._active_spots.clear()

    def set_wound_enabled(self, enabled):
        if self._wound_enabled == enabled:
            return
        self._wound_enabled = enabled
        if not self._wound_enabled:
            self.clear_blood()

    def set_point_alpha(self, model_name, model_adress, index, value):
        point = self.color_alphas[model_name][model_adress].get(index)
        if not point:
            print 'Woundable (ERROR):', (model_name,
             model_adress,
             index,
             value)
            raise RuntimeError
        point[0] = value

    def del_point_alpha(self, model_name, model_adress, index):
        if model_name not in self.color_alphas:
            return
        elif model_adress not in self.color_alphas[model_name]:
            return
        else:
            self.color_alphas[model_name][model_adress].pop(index, None)
            if not self.color_alphas[model_name][model_adress]:
                del self.color_alphas[model_name][model_adress]
                if not self.color_alphas[model_name]:
                    del self.color_alphas[model_name]
            return

    def get_point_alpha(self, model_name, model_adress, index):
        if model_name not in self.color_alphas:
            return 0
        if model_adress not in self.color_alphas[model_name]:
            return 0
        point = self.color_alphas[model_name][model_adress].get(index)
        if not point:
            return 0
        return point[0]

    def spot_ready(self, spot):
        self._stain_index += 1
        if spot in self._active_spots:
            self._active_spots.remove(spot)

    def auto_clear_blood(self):
        if self.isDestroyed or self.dead:
            return
        self._auto_clear_callback_id = BigWorld.callback(AUTO_CLEAR_TIME, self.auto_clear_blood)
        self.clear_blood(AUTO_CLEAR_VALUE)

    def clear_blood(self, ratio = 1.0, immidate = False):
        """ \xd0\xbe\xd1\x87\xd0\xb8\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd1\x80\xd0\xbe\xd0\xb2\xd1\x8c
                ratio - \xd0\xbf\xd1\x80\xd0\xbe\xd1\x86\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbf\xd1\x8f\xd1\x82\xd0\xb5\xd0\xbd
                immidiate - \xd0\xbc\xd0\xb3\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd1\x87\xd0\xb8\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5
        """
        if self.isDestroyed or self.dead and not immidate:
            return
        if not self.color_alphas:
            return
        if self._active_spots:
            for spot in self._active_spots:
                spot.stop()

            self._active_spots = set()
            return
        stains_number = self._stain_index - self._min_stain_index
        stains_to_clear = min(stains_number, int(stains_number * ratio) + 2)
        if stains_to_clear <= 0:
            return
        indices_to_clear = set(xrange(self._min_stain_index, self._min_stain_index + stains_to_clear))
        self._min_stain_index += stains_to_clear
        indices_result = defaultdict(lambda : defaultdict(list))
        for model_name in self.color_alphas:
            for model_adress in self.color_alphas[model_name]:
                points = self.color_alphas[model_name][model_adress]
                for index in points:
                    if points[index][1] in indices_to_clear:
                        indices_result[model_name][model_adress].append(index)

        BloodRemover(self, indices_result, immidate)

    def get_wound_base_model_id(self):
        """ \xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb8 \xd0\xb2 T-\xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb5 """
        raise NotImplementedError

    def wound_directed(self, damager_pos):
        """ \xd1\x80\xd0\xb0\xd0\xbd\xd1\x8b \xd0\xb1\xd0\xbb\xd0\xb8\xd0\xb6\xd0\xbd\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xb1\xd0\xbe\xd1\x8f """
        if not self.skeletonCollider:
            return
        direction = (self.position - damager_pos) * 1.5
        direction[1] = 0
        if self.skeletonCollider.doCollide(damager_pos, direction):
            blood_world_pos = self.skeletonCollider.impactPoint
            collider_name = self.skeletonCollider.impactCollider.name
            self.wound(blood_world_pos, collider_name)

    def _debug_blood_coat(self):
        """ \xd0\xbf\xd0\xbe\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd1\x81\xd0\xb5\xd0\xb1\xd1\x8f \xd0\xba\xd1\x80\xd0\xbe\xd0\xb2\xd1\x8c\xd1\x8e (\xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd0\xb8 \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe) """
        global _DEBUG_IGNORE_OPTIMIZATION
        import math
        from random import uniform
        ignore_prev = _DEBUG_IGNORE_OPTIMIZATION
        _DEBUG_IGNORE_OPTIMIZATION = True
        for angle in xrange(0, 1080, 40):
            x = math.cos(math.radians(angle)) * 2.0
            z = math.sin(math.radians(angle)) * 2.0
            self.wound_directed(self.position + (x, uniform(0.2, 1.7), z))

        _DEBUG_IGNORE_OPTIMIZATION = ignore_prev

    def _can_be_wounded(self):
        if _DEBUG_IGNORE_OPTIMIZATION:
            return True
        if not self._wound_enabled or self.invulnerable:
            return False
        if len(self._active_spots) >= MAX_SPOTS_COUNT:
            return False
        if BigWorld.time() - self._last_wound_time <= 1.0 / STAINS_PER_SECOND:
            return False
        if (self.position - BigWorld.player().position).length > BLOOD_VISIBLE_DISTANCE:
            return False
        return True

    def wound(self, blood_world_pos, collider_name):
        if not self._can_be_wounded():
            return
        BigWorld.cancelCallback(self._auto_clear_callback_id)
        self._auto_clear_callback_id = BigWorld.callback(AUTO_CLEAR_TIME, self.auto_clear_blood)
        node_name = self.collider_nodes[collider_name][0]
        real_node = self.model.node(node_name)
        world_inv = Matrix(real_node)
        world_inv.invert()
        local_pos = world_inv.applyPoint(blood_world_pos)
        matrix = self._get_base_model_matrix(node_name)
        if not matrix:
            return
        tpos_matrix = Matrix(matrix)
        box = self.collider_boxes[collider_name]
        box_local_matrix = Matrix(box.localTransform)
        box_local_matrix.invert()
        tpos_matrix.preMultiply(box_local_matrix)
        tpos_pos = tpos_matrix.applyPoint(local_pos)
        if not _DEBUG_IGNORE_OPTIMIZATION and self._last_wound_point and (self._last_wound_point - tpos_pos).length <= 1.0 / STAINS_DENSITY:
            return
        self._last_wound_point = tpos_pos
        self._last_wound_time = BigWorld.time()
        self._total_vertices_number = 0
        for model_name in self.model.sources:
            blood_config = model_blood_params.get(model_name)
            if not blood_config:
                continue
            colors = material_colors.get(model_name)
            data_dict = defaultdict(list)
            self._total_vertices_number += self.model.createVertexColour(model_name)
            self.model.setVertexColorParametrs(model_name, *colors)
            spot_sqr_width = blood_config.get('spot_width', 0.1) ** 2
            spot_sqr_hight = blood_config.get('spot_height', 0.3) ** 2
            spot_offset = blood_config.get('spot_height_offset', 0.0)
            part_mesh = self.model.getMeshByCondition(model_name, tpos_pos, spot_sqr_width, spot_sqr_hight, spot_offset)
            for rs_index, render_set in enumerate(part_mesh):
                for g_index, geometry in enumerate(render_set):
                    for i, vertex in enumerate(geometry['vertices']):
                        v_index = geometry['indices'][i]
                        data_dict[rs_index, g_index].append((v_index, tpos_pos.distTo(vertex)))

            if data_dict:
                indices_dict, dists_dict = {}, {}
                for data in data_dict.values():
                    data.sort(key=lambda item: item[1])

                for key, value in data_dict.items():
                    indices_dict[key] = [ v[0] for v in value ]
                    dists_dict[key] = [ v[1] for v in value ]

                self._active_spots.add(BloodSpot(self, tpos_pos, self.model, model_name, indices_dict, dists_dict, blood_config, self._stain_index))

    def onDestroyModel(self):
        self.color_alphas = defaultdict(lambda : defaultdict(dict))
        self._stain_index = 0
        self._min_stain_index = 0
        self._last_wound_time = BigWorld.time()
        self._last_wound_point = None
        return


def try_connect_to_settings(attempts):
    if attempts <= 0:
        print "Woundable (ERROR): couldn't connect to settings"
        traceback.print_stack()
        return
    if hasattr(BWPersonality, 'settings'):
        BWPersonality.settings.soak_settings_observers.append(Woundable._on_woundable_settings_changed)
    else:
        BigWorld.callback(0, functools.partial(try_connect_to_settings, attempts - 1))


try_connect_to_settings(100)