def switchDebugSoundMode():
    global DEBUG_SOUND
    DEBUG_SOUND = not DEBUG_SOUND
    for e in BigWorld.entities.values():
        if isinstance(e, Creature):
            e.updateDebugSoundMode()

    return DEBUG_SOUND


def _createDebugTextNode(mob):
    textnode = GUI.Text('')
    textnode.explicitSize = True
    textnode.colourFormatting = True
    textnode.multiline = True
    textnode.size = (5, 1)
    textnode.colour = (255, 255, 255, 255)
    textnode.filterType = 'LINEAR'
    textnode.verticalAnchor = 'BOTTOM'
    textnode.position = (0, mob.get_height() + 0.5, 0)
    return textnode


