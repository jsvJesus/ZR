        full_path = os.path.dirname(os.getcwd()) + '/res/' + config_path
        data = open(full_path).read().replace('<bodyZone>\t</bodyZone>', '<bodyZone> TORSO </bodyZone>')
        with open(full_path, 'w') as f:
