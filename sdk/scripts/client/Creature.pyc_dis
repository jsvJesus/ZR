    def _onEndFadeOut(self, model):
        if self.isDestroyed:
            return
        if self.isDecomposed:
            self.model.visible = False

    def _fadeOutModel(self):
        if self.isDestroyed:
            return
        else:
            delay = self.get_decompose_fadeouttime()
            distance = BigWorld.camera().position.distTo(self.position)
            if delay > 0 and distance < 150 and self._model_root and self._model_root.isActualCoords:
                creature_fader.enable(self.model, self._onEndFadeOut, delay)
            else:
                self.model.visible = False
            self._model_root = None
            sfx_name = self.get_config(Cfg.DECOMPOSE_SFX)
            if self._end_live:
                if not self.get_config(Cfg.DECOMPOSE_ENDLIVE_SFX):
                    sfx_name = sfx_name
                sfx_name and SFXer.playSFX(sfx_name, self.model.position + (0, 0.1, 0))
            return

    def _showModel(self):
        if self.isDestroyed:
            return
        if self.isDecomposed:
            return
        self.model.visible = True

    def checkDecomposed(self):
        if self.isDecomposed:
            if self.model.visible:
                self._model_root = self.model.root
                BigWorld.callback(0.01, self._fadeOutModel)
            BigWorld.player().NeedToCloseItemCache(self)
            self.stopSounds()
            self.targetCaps = []
            self.model.isCalcBoundBoxFromNodes = 0
            if self.dead:
                self.targetCaps = [CAP_EXCLUDE]
        else:
            creature_fader.cancelModel(self.model)
            BigWorld.callback(0.1, self._showModel)

    def onLeaveWorld(self):
        Skills.onLeaveWorld(self)
        CreatureFootsteps.clearCueFootSteps(self)
        if self.get_config(Cfg.ATTACK_TRANSPORT):
            CreatureAttackHits.clearCueHits(self, self.get_config(Cfg.TRANSPORT_HIT_SFX))
        Woundable.onLeaveWorld(self)
        CreatureStipple.onLeaveWorld(self)
        self.stopSounds()
        self.soundsPersistNames.clear()
        if self._idle_soundpot:
            BigWorld.delPot(self._idle_soundpot)
        if self._pot_playerpos:
            BigWorld.delPot(self._pot_playerpos)
        self._clear_debug_attaches()
        creature_fader.cancelModel(self.model)
        BurnInterface.stopBurn(self)
        if inRange(self, BigWorld.player(), Constants.INTERACTION_DISTANCE ** 2):
            BigWorld.player().NeedToUpdateItemCache()
        self.filter.targetMatrix = None
        for cue, sound in self.get_cue_sounds().items():
            self.model.cue(cue, None)

        self._clearFlyCorps()
        self.model = None
        self._model_root = None
        return

    def set_isDecomposed(self, b):
        self.checkDecomposed()
        self._clearFlyCorps()

    def on_death(self, source_data, item_type, noSound = False):
        Skills.on_death(self)
        Victim.on_death(self, source_data, item_type)
        Bleeding.on_death(self)
        self.stopSounds()
        self.soundsPersistNames.clear()

    def on_damaged(self, source_data, damagetaken_data):
        Victim.on_damaged(self, source_data, damagetaken_data)
        if source_data['type'] == SourceTypes.EFFECT:
            self.bleed_on_effect(source_data, damagetaken_data)
            return
        self.bleed_on_damage(source_data, damagetaken_data)
        if not self.is_dead():
            self.event_fired(Cfg.EV_ON_TAKE_DAMAGE)
        CreatureStipple.onDamaged(self, source_data, damagetaken_data)

    def onBoarHit(self, damager):
        pass

    def blood_sfx_on_damage(self, damage_source, damagetaken_data):
        if damagetaken_data.has_key('ammo_type'):
            ammo_type = damagetaken_data['ammo_type']
        else:
            ammo_type = None
            damager = BigWorld.entities.get(damage_source['entity_id'])
            if damager:
                ammo_type = damager.get_ammo_type()
            else:
                return
        return self.get_bleed_sfx(damagetaken_data['body_zone'], ammo_type)

    def get_blood_drip_sfx(self):
        return 'sfx/hits/bleed_red_decal.xml'

    def bleed_on_effect(self, damage_source, damagetaken_data):
        sfx_name = self.get_config(Cfg.BLEED_EFFECT_SFX)
        if not sfx_name:
            return
        blood_rel_pos = self.blood_rel_pos(damagetaken_data['body_zone']) + self.position
        bloodvector = (0.01, -1, 0.01)
        self.bleedglobal(blood_rel_pos, bloodvector, sfx_name)

    def bleed_on_damage(self, damage_source, damagetaken_data):
        if damage_source['entity_id'] == BigWorld.player().id:
            return
        if self.is_sfx_damager_locked(damage_source['entity_id']):
            return
        damager = BigWorld.entity(damage_source['entity_id'], True)
        blood_rel_pos = self.blood_rel_pos(damagetaken_data['body_zone']) + self.position
        if damager:
            bloodvector = self.position - damager.position + blood_rel_pos - (0.01, 1, 0.01)
            damager_pos = damager.position + (0.01, 1, 0.01)
            damager_dir = blood_rel_pos - damager_pos
            doCollide = self.skeletonCollider.doCollide(damager_pos, damager_dir)
            if doCollide:
                blood_rel_pos = self.skeletonCollider.impactPoint
        else:
            bloodvector = (0.01, 1, 0.01)
        sfx_id = self.blood_sfx_on_damage(damage_source, damagetaken_data)
        self.bleedglobal(blood_rel_pos, bloodvector, sfx_id)

    def stopSoundCreature(self, soundPath):
        if STOP_SOUND_PERSIST:
            if soundPath in self.soundsPersistNames:
                self.soundsPersistNames.remove(soundPath)
            sound = self.soundsPersist.pop(soundPath, None)
            if sound:
                sound.stop()
                sound.releaseSound()
        return

    def _addPersistSound(self, soundPath, sound):
        if not self._idleSoundInside:
            return
        if self.dead or self.isDecomposed:
            return
        if soundPath in self.soundsPersist:
            return
        self.soundsPersist[soundPath] = sound
        sound.play()
        return True

    def playSoundCreature(self, soundPath, model):
        if not self.model:
            return
        elif not soundPath:
            return
        elif soundPath in self.soundsPersist:
            return
        elif soundPath in self.soundsPersistNames:
            return
        else:
            try:
                sound = getSound(soundPath, volumeFactor=self.get_sfx_volume(), model=self.model)
            except Exception:
                traceback.print_exc()
                print 'soundPath', soundPath
                return

            if sound is None:
                return
            if sound.duration < 0:
                self.soundsPersistNames.add(soundPath)
                if not self._addPersistSound(soundPath, sound):
                    sound.releaseSound()
                    return
            elif not self.isDecomposed:
                sound.play()
            if DEBUG_SOUND:
                self._showSoundDebug(soundPath, sound.duration, sound)
            sound.set_pitch(self.get_pitch())
            return sound

    def _idleSoundTrap(self):
        if not self._idleSoundInside:
            self.stopSounds()
        elif self.model:
            for soundPath in self.soundsPersistNames:
                try:
                    sound = getSound(soundPath, volumeFactor=self.get_sfx_volume(), model=self.model)
                except Exception:
                    traceback.print_exc()
                    print 'soundPath', soundPath
                    continue

                if sound:
                    if self._addPersistSound(soundPath, sound):
                        sound.set_pitch(self.get_pitch())

    def idleSoundTrap(self, enteredTrap, handle):
        if self.isDestroyed:
            return
        self._idleSoundInside = enteredTrap
        self._idleSoundTrap()

    def stopSounds(self):
        for sound in self.soundsPersist.values():
            if sound is not None:
                sound.stop()
                sound.releaseSound()

        self.soundsPersist.clear()
        return

    def onTeleportCalled(self, teleport_type, expected_position):
        self.filter = BigWorld.DumbFilter()

    def onTeleportEnded(self, wasSuccessful, direction = None):
        Skills.onTeleportEnded(self, wasSuccessful, direction)
        self.filter = BigWorld.AvatarDropFilter()

    def set_CarryingItems(self, old_value):
        if inRange(self, BigWorld.player(), Constants.INTERACTION_DISTANCE ** 2):
            BigWorld.player().NeedToUpdateItemCache()
        items, _ = BigWorld.player().filterItemsWithoutQuests(self.CarryingItems)
        if not items:
            self.targetCaps = []
            BigWorld.player().NeedToCloseItemCache(self)
            self.model.isCalcBoundBoxFromNodes = 0
            if self.dead:
                self.targetCaps = [CAP_EXCLUDE]
        elif self.dead and not self.isDecomposed:
            self.targetCaps = [CAP_CAN_OPEN_AND_EXPLORE]
            self.model.isCalcBoundBoxFromNodes = 1

    def get_interaction_dist(self):
        return self.get_config(Cfg.INTERACTION_DISTANCE)

    def set_dead(self, old):
        if self.dead and self.get_config(Cfg.FLY_CORPS_SFX):
            BigWorld.callback(self.get_config(Cfg.FLY_CORPS_TIME), self._createFlyCorps)
        else:
            self._clearFlyCorps()
        if self.dead:
            self.targetCaps = not self.isDecomposed and (self.CarryingItems or self.looted and not not self.CarryingItems) and [CAP_CAN_OPEN_AND_EXPLORE]
            self.name = self.get_name()
            self.height = 1.0
            self.model.isCalcBoundBoxFromNodes = 1
        else:
            BigWorld.player().NeedToCloseItemCache(self)
            self.targetCaps = [CAP_EXCLUDE]
            self.model.isCalcBoundBoxFromNodes = 0
        self.onSetDead()

    def _createFlyCorps(self):
        if self.isDestroyed:
            return
        elif not self.dead:
            return
        elif self.isDecomposed:
            return
        elif getattr(self, '_fly_corps', None):
            return
        else:
            loadPersistentExtBG(self.get_config(Cfg.FLY_CORPS_SFX), self._onLoadFlyCorps)
            return

    def _onLoadFlyCorps(self, fx_obj):
        if self.isDestroyed:
            return
        elif not self.dead:
            return
        elif self.isDecomposed:
            return
        else:
            raise not getattr(self, '_fly_corps', None) or AssertionError
            self._fly_corps = fx_obj
            self._fly_corps.attach(self.model)
            self._fly_corps.go()
            return

    def _clearFlyCorps(self):
        if not getattr(self, '_fly_corps', None):
            return
        else:
            try:
                self._fly_corps.stop()
                self._fly_corps.detach()
            except:
                traceback.print_exc()

            self._fly_corps = None
            return

    def water_callback(self, watered, water_volume):
        if watered:
            if self.water_listener_id:
                BigWorld.delWaterVolumeListener(self.water_listener_id)
            self.water_listener_id = None
            avatars = [ (avatar, avatar.position.distSqrTo(self.position)) for avatar in BigWorld.entities.values() if isinstance(avatar, Avatar) ]
            avatars.sort(key=lambda x: x[1])
            if len(avatars) == 1 or BigWorld.player() in (avatars[0][0], avatars[1][0]):
                self.cell.water_entered()
        return

    def burn(self, status):
        BurnInterface.burn(self, status)
        if status and not self.water_listener_id:
            self.water_listener_id = BigWorld.addWaterVolumeListener(self.matrix, self.water_callback)
        if not status and self.water_listener_id:
            BigWorld.delWaterVolumeListener(self.water_listener_id)
            self.water_listener_id = None
        return

    def onOpen(self, player):
        self.cell.onOpenContainer()
        return True

    def onClose(self, player):
        self.cell.onCloseContainer()

    def set_isBleending(self, old_value):
        self.checkBleeding()

    def checkBleeding(self):
        if self.isBleending:
            self.bleedDropEff()
        else:
            self.removeBleedDropEff()

    def setDefenceStat(self, defence):
        pass

    def get_wound_base_model_id(self):
        return (self.creatureType, self.level)

    def get_target_mark(self, distance):
        if CAP_CAN_OPEN_AND_EXPLORE not in self.targetCaps:
            return None
        elif distance > self.get_interaction_dist():
            return None
        else:
            return soInworldMarker.MARKER_USE

    def getHeightContainer(self, *w, **kw):
        return 0.1

    def get_hightlight(self, distance):
        if CAP_CAN_OPEN_AND_EXPLORE not in self.targetCaps:
            return None
        elif distance > Constants.HILITE_MARKS_DISTANCE:
            return None
        else:
            return True

    def playAnimationLiveEnd(self):
        self.stopSounds()
        self._end_live = True
        if self.dead:
            return
        anim_list = self.get_config(Cfg.ENDLIVE_ANIMATION)
        if not anim_list:
            return
        act = self.model
        for action_name in anim_list:
            act = getattr(act, action_name)()

    def spawn_isolated_effect(self, sfx, position = None):
        if not sfx:
            return
        m = BigWorld.Model('')
        m.position = position or self.position
        BigWorld.addModel(m)
        FX.bufferedOneShotEffect(sfx, m)
        BigWorld.callback(15.0, partial(BigWorld.delModel, m))

    def on_start_panic(self):
        escape_state_config = next((state for state in self.get_config(Cfg.STATES).values() if state.get('__name__') == 'escape'))
        entering_data = escape_state_config.get('entering_actions', {})
        if entering_data and entering_data['time'] > 0:
            for action in entering_data['actions']:
                self.do_named_action(action, duration=entering_data['time'])

    def onCallFrends(self):
        assist = self.get_config(Cfg.ASSIST)
        model_actions = assist.get('model_actions', [])
        sfx = assist.get('sfx')
        if sfx:
            FX.bufferedOneShotEffect(sfx, self.model)
        for act in model_actions:
            self.model.action(act)()

    def get_observe_visible_quest_object_type(self):
        return VOT.Creature

    def get_observe_visible_quest_object_hash(self):
        mob_subtype = Cfg.get_subtype_name(self.creatureType, self.level)
        return CellListenerUtils.calc_visibleobject_hash(VOT.Creature, self.creatureType, mob_subtype)