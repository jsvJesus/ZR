# Embedded file name: ./client/maputils/requester.py
from bwhttp import _get_host_path, myurlencode
import bwhttp
import requests
from threading import Thread

def post_bwhttp(server_command, callback = None, errorCallback = None, args = {}):
    bwhttp.post(server_command, callback=callback, errorCallback=errorCallback, args=args)


def get_bwhttp(server_command, callback = None, errorCallback = None, args = {}):
    bwhttp.get(server_command, callback=callback, errorCallback=errorCallback, args=args)


def post_request(server_command, callback = None, errorCallback = None, args = {}):
    Thread(target=post_thread, args=(server_command,
     callback,
     errorCallback,
     args)).start()


def get_request(server_command, callback = None, errorCallback = None, args = {}):
    Thread(target=get_thread, args=(server_command,
     callback,
     errorCallback,
     args)).start()


def get_thread(server_command, callback, error_callback, args):
    host, path = _get_host_path(server_command)
    path += myurlencode(args)
    r = requests.get(host + path, timeout=10)
    status_code = r.status_code
    text, headers = r.text, r.headers
    r.raw.release_conn()
    if status_code == 200:
        callback(status_code, headers, text)
    else:
        error_callback(str(status_code))


def post_thread(server_command, callback, error_callback, args):
    host, path = _get_host_path(server_command)
    path += myurlencode(args)
    r = requests.post(host + path, timeout=10)
    status_code = r.status_code
    text, headers = r.text, r.headers
    r.raw.release_conn()
    if status_code == 200:
        callback(status_code, headers, text)
    else:
        error_callback(str(status_code))