class PartyMarksController(ListMarksController):

    def __init__(self, parent):
        ListMarksController.__init__(self, parent, FM.Party)

    def _get_marks(self):
        return []

    def create_mark(self, member_id):
        member = BigWorld.entities.get(member_id)
        if member:
            ListMarksController._create_with_provider(self, member.matrix, 'soGUI/frame/map/mark_partner_mini.dds', member_id)
            self._check_color(member_id)

    def _check_color(self, member_id):
        member_comp = self._marks.get(member_id)
        member = BigWorld.entities.get(member_id)
        if not member_comp or not member:
            return
        member_comp[1].colour = (255, 0, 0, 255) if member.is_dead() else (0, 255, 0, 255)

    def check_dead(self):
        for member_id in self._marks.iterkeys():
            self._check_color(member_id)

    def remove_mark(self, member_id):
        self._remove(member_id)


class QuestMark(Destructable):

    def __init__(self, quest_id, mark_data, cmap):
        Destructable.__init__(self)
        self._circle_mark_id = None
        self._visible = True
        self._cmap = cmap
        self._pos = mark_data['pos']
        self._radius = mark_data['radius']
        matrix = Matrix()
        matrix.setTranslate(self._pos)
        if self._radius:
            path = 'soGUI/frame/map/task_area.dds'
            flags = EntryMask.CLAMP_RANGE | EntryMask.ROTATE | EntryMask.IGNORE_BLEND
        else:
            path = 'soGUI/frame/minimap/mark.dds'
            flags = EntryMask.CLAMP_RANGE | EntryMask.IGNORE_BLEND
        color = qd.get_priority_color(quest_id)
        comp = GUI.Simple(path)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.materialFX = 'BLEND'
        comp.colour = color
        comp.filterType = 'LINEAR'
        self._note_comp = comp
        self._note_mark_id = self._cmap.add(matrix, comp, flags)
        color = Vector4(tuple((c / 255.0 for c in color)))
        if self._radius:
            g = GUI.CircleComponent('textures/default/alpha.dds')
            g.ha, g.va = ('CENTER', 'CENTER')
            g.wm, g.hm = ('PIXEL', 'PIXEL')
            g.materialFX = 'BLEND'
            g.width = g.height = self._radius * 2
            g.outlineColor = color
            color[3] = 0.3
            g.baseColor = color
            g.radius = 1.0
            g.outlineWidth = 0.03
            g.minOutlinePixelWidth = 5
            g.setShapes([((0, 0), (0, 0, 1, 1))])
            g.setShapeActives([(0, 0)])
            g.filterType = 'LINEAR'
            flags = EntryMask.NONE | EntryMask.WORLD_SIZE | EntryMask.IGNORE_BLEND
            self._circle_mark_id = self._cmap.add(matrix, g, flags)
            self._circle_comp = g
            self._update_content(self._cmap.isInRange(self._pos, self._radius))
        return

    def set_visible(self, visible):
        if self._visible == visible:
            return
        self._visible = visible
        if self._radius:
            self._circle_comp.visible = self._visible
            self._update_content(self._cmap.isInRange(self._pos, self._radius))
        else:
            self._note_comp.visible = self._visible

    def _update_content(self, is_in_range):
        if is_in_range or not self._visible:
            self._note_comp.visible = False
        else:
            self._note_comp.visible = True

    def on_enter_range(self, mark_id):
        if self._circle_mark_id != mark_id:
            return
        self._update_content(True)

    def on_leave_range(self, mark_id):
        if self._circle_mark_id != mark_id:
            return
        self._update_content(False)

    def on_release(self):
        self._cmap.remove(self._note_mark_id)
        if self._circle_mark_id:
            self._cmap.remove(self._circle_mark_id)


class QuestMarksController(MarkController, Destructable):

    def __init__(self, parent):
        Destructable.__init__(self)
        MarkController.__init__(self, parent, FM.Quests)
        self._marks = defaultdict(list)

    def _on_space_changed(self):
        MarkController._on_space_changed(self)
        self._full_update()

    def on_loaded(self):
        self._full_update()

    def on_marks_data_changed(self):
        MarkController.on_marks_data_changed(self)
        self._full_update()

    def on_filter_changed(self):
        MarkController.on_filter_changed(self)
        visible = not self._get_filter_value()
        for marks in self._marks.itervalues():
            for mark in marks:
                mark.set_visible(visible)

    def _full_update(self):
        for marks in self._marks.itervalues():
            for mark in marks:
                mark.release()

        self._marks.clear()
        if self._space_name and self._marks_data:
            quest_ids = self._marks_data.quest_marks.get(self._space_name, [])
            for q_id in quest_ids:
                for mark_data in qd.get_marks(q_id):
                    if mark_data['space_name'] != self._space_name:
                        continue
                    self._marks[q_id].append(QuestMark(q_id, mark_data, self._parent.component))

    def on_data_changed(self, is_active, quest_id):
        if is_active:
            if quest_id in self._marks:
                return
        elif quest_id not in self._marks:
            return
        for mark_data in qd.get_marks(quest_id):
            if mark_data['space_name'] != self._space_name:
                continue
            if is_active:
                self._marks[quest_id].append(QuestMark(quest_id, mark_data, self._parent.component))
            else:
                for mark in self._marks[quest_id]:
                    mark.release()

                del self._marks[quest_id]

    def on_enter_range(self, mark_id):
        for marks in self._marks.itervalues():
            for mark in marks:
                mark.on_enter_range(mark_id)

    def on_leave_range(self, mark_id):
        for marks in self._marks.itervalues():
            for mark in marks:
                mark.on_leave_range(mark_id)

    def on_release(self):
        for marks in self._marks.itervalues():
            for mark in marks:
                mark.release()


