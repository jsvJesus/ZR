class PersonalMarksController(ListMarksController):

    def __init__(self, parent):
        ListMarksController.__init__(self, parent, FM.Personal)

    def _need_show(self):
        if ListMarksController._need_show(self):
            load_status_personal = self._marks_data.has_loaded_personal_data(self._space_name)
            return load_status_personal == LoadStatus.Ready
        return False

    def _get_marks(self):
