            return self._marks_data.personal_marks.get(self._space_name, [])
        return []

    def create_mark(self, mark):
        path = MapNotes.get_path(mark['flags'])
        ListMarksController._create(self, mark['position'], path, mark['uid'])
        self._marks[mark['uid']][1].colour = MapNotes.colors[mark['color']]

    def remove_mark(self, mark):
        self._remove(mark['uid'])


