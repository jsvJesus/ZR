class EntryMask:
    NONE = 0
    CLAMP_RANGE = 1
    ROTATE = 2
    IGNORE_BLEND = 4
    WORLD_SIZE = 8


class MarkController(object):

    def __init__(self, parent, filter_mode):
        self._filter_mode = filter_mode
        self._parent = parent
        self._space_name = None
        return

    def _get_filter_value(self):
        if not self._parent._filterset:
            return False
        return self._parent._filterset.get_value(self._filter_mode)

    def _are_data_ready(self):
        return bool(self._marks_data)

    def set_space(self, space_name):
        if self._space_name == space_name:
            return
        self._space_name = space_name
        self._on_space_changed()

    @property
    def _marks_data(self):
        return self._parent._marks_data

    def on_marks_data_changed(self):
        self._something_changed()

    def on_filter_data_changed(self):
        self._something_changed()

    def _on_space_changed(self):
        self._something_changed()

    def on_data_changed(self):
        self._something_changed()

    def on_filter_changed(self):
        self._something_changed()

    def _something_changed(self):
        pass


class PlayerMarkController(MarkController):

    def __init__(self, parent):
        MarkController.__init__(self, parent, None)
        comp = GUI.Simple('soGUI/frame/minimap/avatar_icon.dds')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.wm, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.width, comp.height = (34, 34)
        comp.filterType = 'LINEAR'
        comp.position = (0.0, 0.0, 0.1)
        comp.materialFX = 'BLEND'
        self.component = comp
        self._icon_id = None
        return

    def _something_changed(self):
        if self._space_name:
            if not self._icon_id:
                provider = TranslationRotationProvider(BigWorld.player().matrix, BigWorld.camera().invViewMatrix)
                self._icon_id = self._parent.component.add(provider, self.component)
        elif self._icon_id is not None:
            self._parent.component.remove(self._icon_id)
            self._icon_id = None
        return


class ListMarksController(MarkController):

    def __init__(self, parent, filter_mode):
        MarkController.__init__(self, parent, filter_mode)
        self._marks = {}
        self._marks_visible = True

    def _need_show(self):
        return bool(self._space_name and self._marks_data)

    def _get_marks(self):
        raise NotImplementedError

    def on_marks_data_changed(self):
        MarkController.on_marks_data_changed(self)
        self._full_update()

    def _on_space_changed(self):
        MarkController._on_space_changed(self)
        self._full_update()

    def on_loaded(self):
        self._full_update()

    def _full_update(self):
        for icon_id, _ in self._marks.itervalues():
            self._parent.component.remove(icon_id)

        self._marks.clear()
        if self._need_show():
            for md in self._get_marks():
                self.create_mark(md)

    def _create(self, position, path, uid):
        raise uid not in self._marks or AssertionError
        m = Matrix()
        m.setTranslate(position)
        self._create_with_provider(m, path, uid)

    def _create_with_provider(self, matrix, path, uid):
        raise uid not in self._marks or AssertionError
        comp = GUI.Simple(path)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.materialFX = 'BLEND'
        comp.visible = self.marks_visible
        self._marks[uid] = (self._parent.component.add(matrix, comp), comp)

    def _remove(self, uid):
        mark = self._marks.get(uid)
        if mark is None:
            return
        else:
            self._parent.component.remove(mark[0])
            del self._marks[uid]
            return

    @property
    def marks_visible(self):
        return self._marks_visible

    @marks_visible.setter
    def marks_visible(self, value):
        if self._marks_visible == value:
            return
        self._marks_visible = value
        for _, comp in self._marks.itervalues():
            comp.visible = value

    def on_filter_changed(self):
        MarkController.on_filter_changed(self)
        self.marks_visible = not self._get_filter_value()

    def on_filter_data_changed(self):
        MarkController.on_filter_changed(self)
        self.marks_visible = not self._get_filter_value()


class NpcMarksController(ListMarksController):

    def __init__(self, parent):
        ListMarksController.__init__(self, parent, FM.Npc)

    def _get_marks(self):
        if self._space_name and self._marks_data:
            return self._marks_data.npcs_marks.get(self._space_name, [])
        return []

    def _need_show(self):
        if ListMarksController._need_show(self):
            load_status_personal = self._marks_data.has_loaded_common_data(self._space_name)
            return load_status_personal == LoadStatus.Ready
        return False

    def create_mark(self, mark):
        npc_id = mark
        config = get_npcmarks_config(self._space_name)
        npc_name = AP.get_npc_name_by_id(npc_id)
        npc_pos = config['npcs_data'].get(npc_name)
        if not npc_pos:
            return
        ListMarksController._create(self, npc_pos, 'soGUI/frame/map/mark_questNPC.dds', npc_id)

    def remove_mark(self, mark):
        npc_id = mark
        self._remove(npc_id)


