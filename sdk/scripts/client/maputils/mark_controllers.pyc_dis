        comp.materialFX = 'BLEND'
        self.component = comp
        self._icon_id = None
        self._matrix = Matrix()
        return

    def _something_changed(self):
        if self._are_data_ready():
            need_show = self._space_name
            if need_show:
                mark = self._parent._marks_data._wanted_mark
                if mark:
                    space_name, position = mark
                    if space_name != self._space_name:
                        need_show = False
                else:
                    need_show = False
            if need_show:
                self._matrix.setTranslate(position)
                self._icon_id = self._icon_id or self._parent.component.add(self._matrix, self.component)
        elif self._icon_id is not None:
            self._parent.component.remove(self._icon_id)
            self._icon_id = None
        return


class PvpMarksController(MarkController):

    def __init__(self, parent):
        MarkController.__init__(self, parent, None)
        comp = GUI.Simple('soGUI/maps/Icons/pvp/flag_blue.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.4)
        self._blue_comp = comp
        self._blue_icon_id = None
        self._blue_matrix = Matrix()
        comp = GUI.Simple('soGUI/maps/Icons/pvp/flag_red.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.4)
        self._red_comp = comp
        self._red_icon_id = None
        self._red_matrix = Matrix()
        return

    def on_data_changed(self, blue_pos, red_pos):
        MarkController.on_data_changed(self)
        if self._are_data_ready():
            need_show = self._space_name
            if need_show:
                self._blue_matrix.setTranslate(blue_pos)
                self._red_matrix.setTranslate(red_pos)
                self._blue_icon_id = self._blue_icon_id or self._parent.component.add(self._blue_matrix, self._blue_comp)
                self._red_icon_id = self._parent.component.add(self._red_matrix, self._red_comp)
        else:
            self._clear_marks()

    def _clear_marks(self):
        if self._blue_icon_id is not None:
            self._parent.component.remove(self._blue_icon_id)
            self._blue_icon_id = None
        if self._red_icon_id is not None:
            self._parent.component.remove(self._red_icon_id)
            self._red_icon_id = None
        return

    def _on_space_changed(self):
        self._clear_marks()


class TargetMarkController(MarkController):

    def __init__(self, parent):
        MarkController.__init__(self, parent, FM.Target)
        comp = GUI.Simple('soGUI/frame/map/mark_target.dds')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.wm, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.filterType = 'LINEAR'
        comp.position = (0.0, 0.0, 0.3)
        comp.materialFX = 'BLEND'
        self.component = comp
        self._icon_id = None
        self._matrix = Matrix()
        return

    def _something_changed(self):
        if self._are_data_ready() and self._space_name:
            need_show = not self._get_filter_value()
            if need_show:
                mark = self._parent._marks_data.get_target_mark()
                if mark:
                    space_name, position = mark
                    if space_name != self._space_name:
                        need_show = False
                else:
                    need_show = False
            if need_show:
                self._matrix.setTranslate(position)
                self._icon_id = self._icon_id or self._parent.component.add(self._matrix, self.component, EntryMask.CLAMP_RANGE | EntryMask.IGNORE_BLEND)
        elif self._icon_id is not None:
            self._parent.component.remove(self._icon_id)
            self._icon_id = None
        return