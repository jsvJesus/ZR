# Embedded file name: ./client/maputils/config_parser.py
import os
import ResMgr
import pyson
from Localization import get_global_language
import space_utils
from MapNotes import get_npcmarks_config
path = 'scripts\\client\\data\\WorldMapsData.pyson'
data = pyson.loads(ResMgr.openSection(path).asBinary)
for space_name, space_data in data.items():
    long_space_name = 'spaces/' + space_name
    space_config = get_npcmarks_config(long_space_name)
    if space_config:
        bounds = space_config['bounds']
        space_data['bounds'] = bounds
        space_data['size'] = (bounds[2] - bounds[0], bounds[3] - bounds[1])
        space_data['shift'] = ((bounds[2] + bounds[0]) / 2, (bounds[3] + bounds[1]) / 2)
    data[long_space_name] = space_data

_maps_textures_path = 'soGUI/worldMaps/'

def get_map_texture_name(space_name):
    map_data = data.get(space_name)
    if not map_data:
        return
    path = map_data['path']
    if get_global_language() != u'russian':
        file_name, ext = os.path.splitext(path)
        en_path = file_name + '_en' + ext
        if ResMgr.isFile(os.path.join(_maps_textures_path, en_path)):
            path = en_path
    return os.path.join(_maps_textures_path, path)


def get_view_range(space_name):
    map_data = data.get(space_name)
    return map_data and map_data.get('view_range')


def get_size_and_shift(space_name):
    map_data = data.get(space_name)
    if not map_data or 'bounds' not in map_data:
        return None
    else:
        return (map_data['size'], map_data['shift'])


def get_zoom_limits(space_name):
    map_data = data.get(space_name)
    return map_data and map_data.get('zoom_limits')


def get_map_localized_name(space_name):
    return space_utils.getLokalizedSpaceNameByName(space_name)


def has_space(space_name):
    return space_name in data