# Embedded file name: ./client/maputils/system_buttons.py
from Localization import lc
import colorCodes as cc
import BWPersonality
import GUI
from soGUI.equip_paint.eqp_button import EqpButton

class Button(EqpButton):
    factoryString = 'MinimapSystemButton'

    def __init__(self, component, tooltip_text):
        self._ttt = cc.tf3_regular_text_color + lc('GUI.minimap_ttt.' + tooltip_text)
        EqpButton.__init__(self, component)

    def update_visual2(self, hovered, pressed, disabled):
        if disabled:
            col = (62, 62, 62, 255)
        elif pressed:
            col = (255, 255, 255, 255)
        elif hovered:
            col = (220, 220, 220, 255)
        else:
            col = (190, 190, 190, 255)
        self.component.colour = col

    def handleMouseEnterEvent(self, comp):
        result = EqpButton.handleMouseEnterEvent(self, comp)
        BWPersonality.GUICore.showToolTip(self._ttt, tooltipID=self.factoryString)
        return result

    def handleMouseLeaveEvent(self, comp):
        result = EqpButton.handleMouseLeaveEvent(self, comp)
        BWPersonality.GUICore.hideToolTip(self.factoryString)
        return result


class SystemButtons:

    def __init__(self):
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (230, 26)
        self.component = comp
        comps = []

        def create_button(texture, callback, ttt):
            comp = GUI.Window(texture)
            comp.materialFX = 'BLEND'
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.width, comp.height = comp.texture.width, comp.texture.height
            comp.ha, comp.va = ('LEFT', 'BOTTOM')
            comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
            comp.position = (0, -1, 0.5)
            comps.append(comp)
            self.component.addChild(comp)
            Button(comp, ttt).on_click = callback

        core = BWPersonality.GUICore
        create_button('soGUI/frame/minimap/sbuttons/equipment.dds', core.toggleCharScreen, 'equipment')
        create_button('soGUI/frame/minimap/sbuttons/leveling.dds', core.toggleSkillGUI, 'perks')
        create_button('soGUI/frame/minimap/sbuttons/inventory.dds', core.toggleInventory, 'inventory')
        create_button('soGUI/frame/minimap/sbuttons/craft.dds', core.toggleCraft, 'craft')
        create_button('soGUI/frame/minimap/sbuttons/map.dds', core.toggle_world_map, 'wmap')
        create_button('soGUI/frame/minimap/sbuttons/journal.dds', core.toggleQuestLog, 'quests')
        create_button('soGUI/frame/minimap/sbuttons/friends.dds', core.toggleFriendList, 'friends')
        create_button('soGUI/frame/minimap/sbuttons/emotions.dds', core.toggleEmotionGUI, 'emotions')
        create_button('soGUI/frame/minimap/sbuttons/help.dds', self._toggle_help, 'help')
        space = 2
        width = sum((c.width for c in comps))
        width += space * (len(comps) - 1)
        pos_x = (self.component.width - width) * 0.5
        for comp in comps:
            comp.position[0] = pos_x
            pos_x += comp.width + space

    def _toggle_help(self):
        core = BWPersonality.GUICore
        if core.f1Help and core.f1Help.component.visible:
            core.showFlashHelp(False, True)
        else:
            core.showFlashHelp(True, True)