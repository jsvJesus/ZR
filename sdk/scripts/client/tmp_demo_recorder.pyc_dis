        delete_btn.onClick = self._onBtnDelete
        delete_btn.setVisualState('normal')
        self.component.addChild(cmp, 'delete_btn')

    def _onBtnDelete(self):
        key = self.itemData['key']
        demo = s_recorder.demos[key]
        if not demo:
            BWPersonality.gpd.sendLowerMessage('\xd0\xa4\xd0\xb0\xd0\xb9\xd0\xbb \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xbe\xd0\xb9')
            return
        if BigWorld.isKeyDown(Keys.KEY_LSHIFT) or BigWorld.isKeyDown(Keys.KEY_RSHIFT):
            return s_recorder.deleteDemo(key)

        def listener(event):
            if event == gui_jokes.askUserYesNo.YES:
                s_recorder.deleteDemo(key)

        gui_jokes.askUserYesNo('Delete?', u'\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u044c\n%s ?' % demo['name'], listener)

    def _onBtnPlayPause(self):
        key = self.itemData['key']
        if key and key in s_recorder.demos:
            demo = s_recorder.demos[key]
            if not demo:
                BWPersonality.gpd.sendLowerMessage('\xd0\xa4\xd0\xb0\xd0\xb9\xd0\xbb \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xbe\xd0\xb9')
                return
            if demo['rec_info']['VERSION'] != VERSION:
                gui_jokes.askUserOk('ERROR', 'old VERSION demo %s\nmin version:%s' % (demo['rec_info']['VERSION'], VERSION))
                return
        repeat = self.component.repet_box.script.isChecked()
        if key in s_recorder.active_demos:
            s_recorder.active_demos[key].swithPause()
        else:
            print 'repeat----', repeat
            s_recorder.startPlay(key, repeat)

    def _onBtnStop(self):
        key = self.itemData['key']
        s_recorder.stopPlay(key)

    def _onRepeatChange(self):
        repeat = self.component.repet_box.script.isChecked()
        key = self.itemData['key']
        self._last_repeads[key] = repeat
        if key in s_recorder.active_demos:
            s_recorder.active_demos[key].repeat = repeat

    def onLClick(self):
        if not self.haveItem():
            return

    def onRClick(self):
        if not self.haveItem():
            return
        s_recorder_gui.showContextMenu(self.itemData['key'])

    def onDblClick(self):
        if not self.haveItem():
            return
        s_recorder_gui._onRename(self.itemData['key'])

    def _applyItemData(self):
        show = bool(self.haveItem())
        self.component.name.visible = show
        self.component.time.visible = show
        self.component.play_pause_demo.visible = show
        self.component.stop_demo.visible = False
        self.component.repet_box.visible = show
        self.component.delete_btn.visible = show
        if not self.haveItem():
            return
        else:
            key = self.itemData['key']
            demo = s_recorder.demos[key]
            played_demo = s_recorder.active_demos.get(key, None)
            self.component.name.text = demo['name'] if demo else key
            if demo and demo['rec_info']['VERSION'] != VERSION:
                self.component.play_pause_demo.visible = False
                self.component.stop_demo.visible = False
                self.component.repet_box.visible = False
                self.component.name.text = demo['name'] + '  (OLD VERSION)'
                return
            frames = len(demo['rec_data']) if demo else 0
            repeat = self._last_repeads.get(key, True)
            pl_text = 'Play'
            time_text = '-:-- '
            if played_demo:
                repeat = played_demo.repeat
                self.component.stop_demo.visible = True
                if played_demo.end_frame or played_demo.paused:
                    pl_text = '>'
                else:
                    pl_text = '||'
                time_text = convert_time_to_str(played_demo._played_time) + ' '
            duration = demo['rec_info'].get('duration', 0) if demo else 0
            self.component.time.text = time_text + convert_time_to_str(duration)
            self.component.play_pause_demo.label.text = pl_text
            if repeat:
                self.component.repet_box.script.setActive()
            else:
                self.component.repet_box.script.setInactive()
            return


def convert_time_to_str(secs):
    if not secs:
        return '?:??'
    minutes = secs / 60
    secs = secs % 60
    return '%i:%02i' % (int(minutes), int(secs))


def getRecorder():
    global s_recorder
    if not s_recorder:
        s_recorder = Recorder()
    return s_recorder


def show():
    global s_recorder_gui
    global s_recorder
    if not s_recorder:
        s_recorder = Recorder()
        s_recorder.load()
    if not s_recorder_gui:
        s_recorder_gui = RecordGUI(GUI.Window())
        s_recorder_gui.onBound()
    s_recorder_gui.show()
    s_recorder_gui.onChangeDemos()