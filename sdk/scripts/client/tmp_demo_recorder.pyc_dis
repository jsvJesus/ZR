        self.component.addChild(cmp, 'itemView')
        itemView.onBound()
        itemView.setRestrictingComponent(None)
        itemView.setItems(None)
        self._itemView = itemView
        itemView.setItems(None)
        return

    def slotHandler(self, event, data):
        return False

    def itemViewHandler(self, event, data):
        return False

    @BWMemberCoroutine
    def _updateTimer(self):
        while self.component.visible:
            self.onChangeDemos()
            yield BWWaitForPeriod(0.01)

    def handleMouseButtonEvent(self, comp, event):
        if event.key == Keys.KEY_RIGHTMOUSE:
            if not event.isKeyDown():
                self.showContextMenu()
            return True
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleKeyEvent(self, event):
        if not self.component.visible:
            return False
        if event.key == Keys.KEY_F12:
            if not event.isKeyDown():
                self.start_stop_rec()
            return True
        if event.key == Keys.KEY_F11:
            if not event.isKeyDown():
                self.start_stop_play_last()
            return True
        return False

    def start_stop_rec(self):
        if s_recorder.rec:
            s_recorder.stopRec()
        else:
            if not s_recorder.demo_mode:
                BWPersonality.gpd.sendLowerMessage('\xd0\x92 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xb5 NPC \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xb0 \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7\xd0\xb0\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c')
                return
            s_recorder.startRec()
        self.component.rec_status.visible = s_recorder.rec
        self.component.rec_time.text = '0:00'

    def start_stop_play_last(self):
        if s_recorder.rec:
            self.start_stop_rec()
        keys = s_recorder.demos.keys()
        if not keys:
            return
        key = keys[-1]
        repeat = RowItemRec._last_repeads.get(key, True)
        if key in s_recorder.active_demos:
            s_recorder.active_demos[key].swithPause()
        else:
            print '\n\nstart_stop_play_last repeat:', repeat
            s_recorder.startPlay(key, repeat)

    def _onBtnDeleteALL(self, *e):
        if not s_recorder.demo_mode:
            BWPersonality.gpd.sendLowerMessage('\xd0\xbd\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x8f')
            return

        def listener(event):
            if event == gui_jokes.askUserYesNo.YES:
                s_recorder.deleteAll()

        gui_jokes.askUserYesNo('Delete all?', u'\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0412\u0421\u0415 \u0437\u0430\u043f\u0438\u0441\u0438?', listener)

    def _onPlayAll(self, *e):
        for key in s_recorder.demos.keys():
            if key in s_recorder.active_demos:
                s_recorder.active_demos[key].swithPause(False)
                continue
            repeat = RowItemRec._last_repeads.get(key, True)
            s_recorder.startPlay(key, repeat)

    def _onPauseAll(self, *e):
        for key in s_recorder.active_demos:
            s_recorder.active_demos[key].swithPause(True)

    def _onStopAll(self, *e):
        s_recorder.stopAllPlay()

    def _onRepeatChangeAll(self, *e):
        repeat = self.component.repet_all.script.isChecked()
        for key in s_recorder.demos.keys():
            RowItemRec._last_repeads[key] = repeat
            if key in s_recorder.active_demos:
                s_recorder.active_demos[key].repeat = repeat

        self.onChangeDemos()

    def onRecTick(self, rec_time):
        self.component.rec_time.text = convert_time_to_str(rec_time)

    def onChangeDemos(self):
        self._itemView.setItems([ {'key': x} for x in s_recorder.demos.keys() ])

    def showContextMenu(self, key = None):
        self._last_context_key = key
        self._removeContextMenu()
        actions = {}
        if not key:
            actions['gotoDEMO_MODE'] = '[%s] DEMO mode' % ('x' if s_recorder.demo_mode else ' ')
            actions['gotoNPC_TUTOR_MODE'] = '[%s]NPC TUTOR mode' % (' ' if s_recorder._demo_mode else 'x')
        if key:
            if s_recorder.demo_mode:
                actions['renameDemo'] = u'\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c'
            if not s_recorder.demo_mode:
                actions['startRewriteDemo'] = u'\u041d\u0430\u0447\u0430\u0442\u044c \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0438\u0441\u044c!'
            actions['tp_start'] = u'\u0422\u0435\u043b\u0435\u043f\u043e\u0440\u0442 \u0432 \u043d\u0430\u0447\u0430\u043b\u043e'
            actions['tp_end'] = u'\u0422\u0435\u043b\u0435\u043f\u043e\u0440\u0442 \u0432 \u043a\u043e\u043d\u0435\u0446'
            actions['move_start'] = u'\u041f\u0435\u0440\u0435\u043c\u043e\u0442\u043a\u0430 \u0432 \u043d\u0430\u0447\u0430\u043b\u043e'
            actions['move_end'] = u'\u041f\u0435\u0440\u0435\u043c\u043e\u0442\u043a\u0430 \u0432 \u043a\u043e\u043d\u0435\u0446'
        BWPersonality.GUICore.addListener('contextMenuEvent', self.onContextMenuEvent)
        BWPersonality.GUICore.showContextMenu(564565, actions)

    def _removeContextMenu(self):
        try:
            BWPersonality.GUICore.removeListener('contextMenuEvent', self.onContextMenuEvent)
        except:
            traceback.print_exc()

    def updateByMode(self):
        pass

    def onContextMenuEvent(self, interface_id, id, caption, event, data):
        if interface_id != 564565:
            return
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            if id in ('gotoDEMO_MODE', 'gotoNPC_TUTOR_MODE'):
                if id == 'gotoDEMO_MODE':
                    demo_mode = True
                if id == 'gotoNPC_TUTOR_MODE':
                    demo_mode = False
                s_recorder.stopAllPlay()
                if s_recorder.rec:
                    s_recorder.stopRec()
                s_recorder.changeMode(demo_mode)
                if s_recorder.demo_mode:
                    self.component.iFrame.colour = (25, 25, 25, 255)
                else:
                    self.component.iFrame.colour = (10, 10, 15, 255)
            if id == 'renameDemo':
                self._onRename(self._last_context_key)
            if id == 'move_start':
                s_recorder.teleportDemoTo(self._last_context_key, end_pos=False)
            if id == 'move_end':
                s_recorder.teleportDemoTo(self._last_context_key, end_pos=True)
            if id == 'tp_start':
                s_recorder.teleportPlayerTo(self._last_context_key, end_pos=False)
            if id == 'tp_end':
                s_recorder.teleportPlayerTo(self._last_context_key, end_pos=True)
            if id == 'startRewriteDemo':
                s_recorder.startRewriteDemo(self._last_context_key)
                self.component.rec_status.visible = s_recorder.rec
                self.component.rec_time.text = '0:00'
            self._removeContextMenu()
        elif event == soGUI.soContextMenuComponent.EVENT_SHOW:
            pass
        elif event == soGUI.soContextMenuComponent.EVENT_CANCEL:
            self._removeContextMenu()

    def onChangePlay(self):
        pass

    coroutine = None

    def show(self):
        self.component.visible = True
        self.component.iFrame.visible = True
        BWPersonality.GUICore.worldLayer.delChild('RecordGUI')
        BWPersonality.GUICore.worldLayer.addChild(self.component, 'RecordGUI')
        if not self.coroutine:
            self.coroutine = self._updateTimer()
            self.coroutine.run()

    def _onRename(self, key):
        if not s_recorder.demo_mode:
            return
        demo = s_recorder.demos[key]

        def listener(new_name):
            if new_name:
                s_recorder.renameDemo(key, new_name)

        gui_jokes.inputBox(u'\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c', u'\u043f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c %s\n\n%s' % (key, demo['name']), listener, defaultText=demo['name'])

    def hide(self):
        self.component.visible = False
        if s_recorder.rec:
            s_recorder.stopRec()
        if self.coroutine:
            self.coroutine.stop()
            self.coroutine = None
        return


class RowItemRec(soItemSlot):
    SLOTWIDTH = 420
    SLOTHEIGHT = 25
    _last_repeads = {}

    def __init__(self, component, slotIndex, itemData, centerDProxy = True):
        soItemSlot.__init__(self, component, slotIndex, itemData, centerDProxy=True)
        component.script = self
        self.component.mouseButtonFocus = True
        self.component.width = self.SLOTWIDTH
        self.component.height = self.SLOTHEIGHT

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
