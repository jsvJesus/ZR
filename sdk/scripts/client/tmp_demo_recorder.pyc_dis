class DemoPlayed():

    def __init__(self, key, repeat = True, npc_params = None, entity = None):
        self.key = key
        self.ent = entity
        self.paused = False
        self.end_frame = False
        self.repeat = repeat
        self.entity = None
        self._is_played = False
        self._timer_id = 0
        self._frameden = None
        self._last_time = 0
        self._overflow_time = 0
        self._need_time = 0
        self._prev_tick_entry = None
        self._played_time = 0
        self._npc_params = npc_params
        self._onEndFrame = None
        self._smooth_start = False
        self._smooth_arr = []
        if self._npc_params:
            demo = s_recorder.demos[self.key]
            if demo:
                demo['rec_info']['attr'].pop('ActiveWeaponSet2', None)
                demo['rec_info']['attr'].pop('ActiveItemID', None)
                demo['rec_info']['attr'].pop('BellyItemID', None)
        return

    @property
    def isPlayed(self):
        if self.paused:
            return False
        return self._is_played

    def spawnEntity(self, onLoadCallback, pos_end = False, debug_name = True):
        demo = s_recorder.demos[self.key]
        player = BigWorld.player()
        pos = player.position
        yaw = player.yaw
        pitch = player.pitch
        if demo:
            pos = demo['rec_info']['position']
            yaw = demo['rec_info']['pl_yaw']
            pitch = demo['rec_info']['pl_pitch']
        if self._npc_params:
            params = dict(self._npc_params)
            if demo:
                params['usingGesture'] = demo['rec_info'].get('usingGesture', 0)
                params['playedAnimationIndexList'] = demo['rec_info'].get('usingGesture', 0)
                params['EquipModes'] = demo['rec_info']['attr'].get('EquipModes', 0)
            entity_class = 'NPC'
        else:
            entity_class = 'Avatar'
            params = {'name': u'pl1',
             'usingGesture': demo['rec_info'].get('usingGesture', 0),
             'ActiveWeaponSet2': demo['rec_info']['attr']['ActiveWeaponSet2'],
             'ActiveItemID': demo['rec_info']['attr']['ActiveItemID'],
             'BellyItemID': demo['rec_info']['attr']['BellyItemID'],
             'EquipModes': demo['rec_info']['attr'].get('EquipModes', 0),
             'personality': demo['rec_info']['personality'],
             'EquippedArmor': demo['rec_info']['EquippedArmor'],
             'coloriseEmblems': demo['rec_info'].get('coloriseEmblems', [])}

        class FakeEntity(object):

            @property
            def EquippedArmor(self):
                return params['EquippedArmor']

            @property
            def EquipModes(self):
                return params['EquipModes']

            @EquipModes.setter
            def EquipModes(self, value):
                params['EquipModes'] = value

        fake_entity = FakeEntity()
        try:
            if ItemsUtils.get_tuck_force(fake_entity):
                EST.set_mode(fake_entity, EST.MODE_TUCK)
        except:
            traceback.print_exc()
            traceback.print_stack()

        if pos_end and demo:
            end_frame = s_recorder.demos[self.key]['rec_data'][-1]
            _, pos, yaw, pitch, _, _ = end_frame
        a_id = BigWorld.createEntity(entity_class, player.spaceID, 0, pos, (0, pitch, yaw), params)
        self._pl_id = a_id
        self.ent = BigWorld.entity(a_id)

        def apply_vars():
            if demo:
                if self._npc_params:
                    if debug_name:
                        self.ent.name += '[%s]' % demo['name']
                else:
                    self.ent.name = demo['name']
            self.ent.filter = BigWorld.DumbFilter()
            self.ent.STOP_MODE = 0
            s_recorder.entID2Key[a_id] = self.key
            onLoadCallback(self.ent)

        def check_load():
            self.ent = BigWorld.entity(a_id)
            if self.ent:
                apply_vars()
            else:
                BigWorld.callback(0.05, check_load)

        check_load()

    def _stopTimer(self):
        if self._timer_id:
            BigWorld.cancelCallback(self._timer_id)
            self._timer_id = 0

    def loadAndPlay(self, repeat = True, callback_ = None):

        def continue_play(*e):
            self.play(repeat)
            if callback_:
                callback_()

        if self.ent:
            return continue_play()
        self.spawnEntity(continue_play)

    def play(self, repeat = True, on_end_frame = None, smooth_start = False):
        global s_recorder_gui
        self.repeat = repeat
        self._onEndFrame = on_end_frame
        self._smooth_start = smooth_start
        self._stopTimer()
        self._initAvatar()
        self._tick()
        self._is_played = True
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()

    def swithPause(self, to_pause = None):
        if to_pause is not None:
            if to_pause == self.paused:
                if not to_pause and self.end_frame:
                    self.paused = True
                else:
                    return
        self._stopTimer()
        if self.end_frame:
            self.end_frame = False
            self.paused = False
            self._frameden = None
            self._initAvatar()
        else:
            self.paused = not self.paused
        if not self.paused:
            self._last_time = time.time()
            self._tick()
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()
        return

    def stop(self, destroy = True):
        self._stopTimer()
        self._frameden = None
        if self.ent:
            if destroy:
                BigWorld.callback(0.01, partial(realyDestroy, self.ent.id))
            self.ent = None
            self._onStop()
        return

    def onRename(self, name):
        if self.ent:
            self.ent.name = name

    def _onStop(self):
        self._is_played = False
        self._stopTimer()
        if self._onEndFrame:
            self._onEndFrame()
        self._onEndFrame = None
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()
        return

    def _initAvatar(self):
        if not self.ent:
            raise ValueError('avatar not loaded!')
        rec_info = s_recorder.demos[self.key]['rec_info']
        for attr, val in rec_info['attr'].items():
            self._applyAttr(attr, val)

        self.ent.resetFootTwist()

    def _getFrameGenerator(self):
        rec_data = s_recorder.demos[self.key]['rec_data']
        for frame_id, entry in enumerate(rec_data):
            yield (frame_id, entry)

    def getFutureFrame(self, cur_frame):
        rec_data = s_recorder.demos[self.key]['rec_data']
        next_frame = cur_frame + 1
        if len(rec_data) <= next_frame:
            return
        return rec_data[next_frame]

    def _applyAttr(self, atrr, new_val, old_val = None):
        try:
            if getattr(self.ent, atrr, None) == new_val:
                return
            setattr(self.ent, atrr, new_val)
            set_name = 'set_' + atrr
            if hasattr(self.ent, set_name):
                getattr(self.ent, set_name)(old_val)
        except:
            traceback.print_exc()

        return

    def _applyFoo(self, function_name, w, kw):
        try:
            if hasattr(self.ent, function_name):
                foo = getattr(self.ent, function_name)
                foo(*w, **kw)
        except:
            print function_name, (w, kw)
            traceback.print_exc()

    def teleportDemoTo(self, end_pos):
        self.paused = False
        self._stopTimer()
        self.repeat = False
        self._smooth_arr[:] = []
        if end_pos:

            def _getCustomFrameGenerator():
                rec_data = s_recorder.demos[self.key]['rec_data']
                yield (len(rec_data), rec_data[-1])

            self._frameden = _getCustomFrameGenerator()
            try:
                self._tick()
            except:
                traceback.print_exc()

            self._played_time = s_recorder.demos[self.key]['rec_info'].get('duration', 0)
        else:
            self._frameden = None
            self._tick()
        self.paused = True
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()
        return

    def _tick(self):
        t = time.time()
        realDtime = t - self._last_time
        self._last_time = t
        if self.paused:
            self._last_time = t
            return
        else:
            self._timer_id = BigWorld.callback(0.01, self._tick)
            if not self.ent:
                return
            if not self._frameden:
                self._frameden = self._getFrameGenerator()
                self._played_time = 0
                self._overflow_time = 0
                self._need_time = 0
                self._prev_tick_entry = None
                self._cur_frame = 0
                realDtime = -10000
            if self._smooth_start:
                end_frame = s_recorder.demos[self.key]['rec_data'][0]
                _, pos, yaw, pitch, _, _ = end_frame
                direction = pos - self.ent.position
                distance = direction.length
                if distance > 0.1:
                    direction.normalise()
                    dTime = realDtime if realDtime > 0 else 0.01
                    step = min(1.8 * dTime, distance)
                    position = self.ent.position + direction * step
                    self._apply_pos_yaw(position, (yaw, pitch, 0))
                    return
                self._smooth_start = False
            self.end_frame = False
            sum_dtime_demo = self._overflow_time
            sub_tick = -1
            while 1:
                sub_tick += 1

                def next_tick():
                    skip_foo = False
                    self._need_time -= realDtime
                    next_entry = None
                    if self._need_time > 0.005 and self._prev_tick_entry and FIX_PLAY_FPS:
                        skip_foo = True
                        entry = self._prev_tick_entry
                        next_entry = self.getFutureFrame(self._cur_frame)
                    else:
                        self._cur_frame, entry = self._frameden.next()
                        self._prev_tick_entry = entry
                        self._need_time = entry[0]
                        self._played_time += entry[0]
                    demodTime, position, yaw, pitch, rec_atr, rec_foo = entry
                    if next_entry:
                        f_position = next_entry[1]
                        f_yaw = next_entry[2]
                        f_pitch = next_entry[3]
                        f_dt = 1 - self._need_time / demodTime
                        position = position + (Vector3(f_position) - position) * f_dt
                    self._apply_pos_yaw(position, (yaw, pitch, 0))

                    def apply_atr():
                        for atrr, (old_val, new_val) in rec_atr.items():
                            self._applyAttr(atrr, new_val, old_val)

                        for function_name, (w, kw) in rec_foo.items():
                            self._applyFoo(function_name, w, kw)

                    if not skip_foo and (rec_atr or rec_foo):
                        BigWorld.callback(0.0, apply_atr)
                    return demodTime

                try:
                    demodTime = next_tick()
                except StopIteration:
                    if self.repeat:
                        self._initAvatar()
                        self._frameden = None
                        return
                    self.end_frame = True
                    self._overflow_time = 0
                    self._stopTimer()
                    self._onStop()
                    return

                if realDtime <= 0:
                    realDtime = demodTime
                sum_dtime_demo += demodTime
                if sum_dtime_demo + 0.01 >= realDtime:
                    self._overflow_time = realDtime - sum_dtime_demo
                    self._overflow_time = max(0, self._overflow_time)
                    return

            return

    def _apply_pos_yaw(self, pos, dir_):
        self._smooth_arr.append(Vector3(pos))
        if len(self._smooth_arr) > 5:
            del self._smooth_arr[0]
        newpos = Vector3()
        for p in self._smooth_arr:
            newpos += p

        newpos = newpos / len(self._smooth_arr)
        self.ent.filter.debugPosition(newpos, dir_)


class Recorder(Singlton):
    """docstring for Recorder"""
    DIRECTORY = '../demo'
    TUTOR_NPC_DEV_PATH = '../res/scripts/client/data/tutorial_npc_animations'
    rec = False
    played = False
    _demo_mode = True
    _rec_tid = 0
    _play_tid = 0
    _rewrite_key = None
    entID2Key = {}
    demos = OrderedDict()
    active_demos = {}
    current_npc = None
    current_npc_key = None

    def loadNPCAsync(self, phase_name, pos_end = False, on_load_callback = None):
        self.demos.clear()
        self._demo_mode = False
        player = BigWorld.player()
        if not player._tutorial_manager:
            raise ValueError('empty _tutorial_manager')
        demos_names = player._tutorial_manager.npc_animation_list
        directory = 'scripts/client/data/tutorial_npc_animations/'
        res_list = []
        res_dict = {}
        for name in demos_names:
            path = directory + name + '.npc_demo'
            res_list.append(path)
            res_dict[name] = path

        def onLoadNPC(npc):
            self.current_npc = npc
            try:
                npc.model.motors[0].matchNotifierLodDistance = 200.0
                npc.fniLeft.maxWorkingDistanceToCamera = 200.0
                npc.fniRight.maxWorkingDistanceToCamera = 200.0
                npc.model.simple_cloth_tracker.maxLod = 50.0
            except Exception as e:
                traceback.print_exc()

            if on_load_callback:
                on_load_callback(npc)

        def on_load_files(res):
            if res.failedIDs:
                print 'failedIDs', res.failedIDs
            for name in demos_names:
                path = res_dict[name]
                self.demos[name] = None
                if path in res.failedIDs:
                    continue
                try:
                    data = res[path].asBinary
                    self.demos[name] = json.loads(data)
                    print name, 'load ok'
                except Exception as e:
                    print 'error for ', path
                    traceback.print_exc()

            self.current_npc_key = phase_name
            self.active_demos[phase_name] = DemoPlayed(phase_name, repeat=False, npc_params=tutorial_demos_npc_config)
            self.active_demos[phase_name].spawnEntity(onLoadNPC, pos_end=pos_end, debug_name=False)
            return

        BigWorld.loadResourceListBG(res_list, on_load_files)

    def playNPCDemo(self, phase_name, on_end_play, smooth_start = True):
        if not self.current_npc:
            print 'ERROR: not NPC'
            return
        elif self.current_npc.isDestroyed:
            print 'ERROR: NPC isDestroyed'
            self.current_npc = None
            return
        else:
            if self.current_npc_key and self.current_npc_key in self.active_demos:
                self.active_demos[self.current_npc_key].stop(destroy=False)
                del self.active_demos[self.current_npc_key]
                self.current_npc_key = None
            self.current_npc_key = phase_name
            self.active_demos[phase_name] = DemoPlayed(phase_name, repeat=False, npc_params=tutorial_demos_npc_config, entity=self.current_npc)
            self.active_demos[phase_name].play(repeat=False, on_end_frame=on_end_play, smooth_start=smooth_start)
            return

    def isNPCDemoPlayed(self):
        if not self.current_npc:
            print 'ERROR: not NPC'
            return
        if self.current_npc_key and self.current_npc_key in self.active_demos:
            return self.active_demos[self.current_npc_key].isPlayed

    def loadDevNPCDemos(self):
        print 'loadDevNPCDemos'
        self.demos.clear()
        player = BigWorld.player()
        if not player:
            return
        elif not player._tutorial_manager:
            print 'ERROR player._tutorial_manager'
            return
        else:
            for name in player._tutorial_manager.npc_animation_list:
                self.demos[name] = None
                path = self.TUTOR_NPC_DEV_PATH + '/' + name + '.npc_demo'
                if not os.path.isfile(path):
                    print name, 'empty'
                    continue
                try:
                    with open(path, 'rb') as fh:
                        self.demos[name] = json.loads(fh.read())
                    print name, 'load ok'
                except Exception as e:
                    print 'error for ', path
                    traceback.print_exc()

            return

    def load(self):
        print 'load rec'
        self.demos.clear()
        if not os.path.isdir(self.DIRECTORY):
            return
        for fname in os.listdir(self.DIRECTORY):
            if not fname.endswith('.so_demo'):
                continue
            path = self.DIRECTORY + '/' + fname
            try:
                with open(path, 'rb') as fh:
                    demo = json.loads(fh.read())
                key = demo['key']
                self.demos[key] = demo
            except:
                print 'demo path:', repr(path)
                traceback.print_exc()
                continue

        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()

    def destroyDemos(self):
        self.stopAllPlay()
        self.demos.clear()
        if self.current_npc and not self.current_npc.isDestroyed:
            BigWorld.callback(0.01, partial(realyDestroy, self.current_npc.id))
        self.current_npc = None
        return

    def startRec(self):
        print 'startRec'
        player = BigWorld.player()
        self.rec = True
        self._rec_info = {'attr': {}}
        self._rec_info['VERSION'] = VERSION
        self._rec_info['position'] = tuple(player.position)
        self._rec_info['pl_yaw'] = player.yaw
        self._rec_info['pl_pitch'] = player.pitch
        self._rec_info['model_yaw'] = player.model.yaw
        self._rec_info['usingGesture'] = player.usingGesture
        self._rec_info['personality'] = PY(player.personality)
        self._rec_info['EquippedArmor'] = PY(player.EquippedArmor)
        self._rec_info['coloriseEmblems'] = PY(player.coloriseEmblems)
        self._rec_info['attr']['isMovingTest'] = player.isMovingTest
        self._rec_info['attr']['ActiveItemID'] = player.ActiveItemID
        self._rec_info['attr']['BellyItemID'] = player.BellyItemID
        self._rec_info['attr']['weaponStatus'] = player.weaponStatus
        self._rec_info['attr']['transformationID'] = player.transformationID
        self._rec_info['attr']['transformationProperty'] = PY(player.transformationProperty)
        self._rec_info['attr']['ActiveWeaponSet2'] = PY(player.ActiveWeaponSet2)
        self._rec_info['attr']['crouching_or_crawling'] = player.crouching_or_crawling
        self._rec_info['attr']['EquipModes'] = player.EquipModes
        self._rec_data = []
        self._rec_atr = {}
        self._rec_foo = {}
        self._start_rec_time = time.time()
        self._last_time = time.time()
        self._rec_tid = BigWorld.callback(0.001, self.rec_tick)
        player.isTogleCursor = True
        BWPersonality.GUICore.setMouseAltState(False, force=True)

    def _generateKey(self):
        d = datetime.datetime.fromtimestamp(time.time())
        return d.strftime('%Y-%m-%d__%H_%M_%S')

    def stopRec(self):
        print 'stopRec'
        BigWorld.cancelCallback(self._rec_tid)
        self._rec_tid = 0
        if self.rec:
            self.rec = False
            self._rec_info['duration'] = time.time() - self._start_rec_time
            key = self._generateKey()
            if self._rewrite_key and not self.demo_mode:
                key = self._rewrite_key
            demo = {}
            demo['name'] = key
            demo['key'] = key
            demo['path'] = '%s.so_demo' % key
            demo['rec_info'] = self._rec_info
            demo['rec_data'] = self._rec_data
            self.demos[key] = demo
            self.saveDemo(demo)
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()
        self._rec_data = []

    def saveDemo(self, demo):
        if not os.path.isdir(self.DIRECTORY):
            os.makedirs(self.DIRECTORY)
        if self._rewrite_key and not self.demo_mode:
            demo['path'] = '%s.npc_demo' % demo['key']
            path = self.TUTOR_NPC_DEV_PATH + '/' + demo['path']
        else:
            path = self.DIRECTORY + '/' + demo['path']
        with open(path, 'wb') as f:
            f.write(json.dumps(demo))

    def deleteDemo(self, key):
        self.stopPlay(key)
        if key not in self.demos:
            return
        path = self.DIRECTORY + '/' + self.demos[key]['path']
        del self.demos[key]
        if os.path.isfile(path):
            os.remove(path)
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()

    def renameDemo(self, key, new_name):
        if key not in self.demos:
            return
        self.demos[key]['name'] = new_name
        self.saveDemo(self.demos[key])
        if key in self.active_demos:
            self.active_demos[key].onRename(new_name)
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()

    def teleportDemoTo(self, key, end_pos = False):
        if key not in self.active_demos:
            return
        self.active_demos[key].teleportDemoTo(end_pos)

    def teleportPlayerTo(self, key, end_pos = False):
        if key not in self.demos:
            BWPersonality.gpd.sendLowerMessage('\xd0\xa4\xd0\xb0\xd0\xb9\xd0\xbb \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xbe\xd0\xb9. \xd0\xa2\xd0\xb5\xd0\xbb\xd0\xb5\xd0\xbf\xd0\xbe\xd1\x80\xd1\x82 \xd0\xbd\xd0\xb5\xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd!')
            return
        demo = self.demos[key]
        if end_pos:
            entry = demo['rec_data'][-1]
        else:
            entry = demo['rec_data'][0]
        dTime, position, yaw, pitch, rec_atr, rec_foo = entry
        player = BigWorld.player()
        player.cell.TeleportTo(position)
        player.physics.teleport(position, (yaw, pitch, 0))
        dc = BigWorld.dcursor()
        dc.yaw = yaw
        dc.pitch = pitch
        player.model.yaw = yaw
        player.resetFootTwist()

    def startRewriteDemo(self, key):
        print 'TODO'
        if self.demo_mode:
            BWPersonality.gpd.sendLowerMessage('\xd0\x9d\xd0\xb5\xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb2 \xd1\x8d\xd1\x82\xd0\xbe\xd0\xbc \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xb5!')
            return
        if self.rec:
            BWPersonality.gpd.sendLowerMessage('\xd0\x97\xd0\xb0\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c \xd1\x83\xd0\xb6\xd0\xb5 \xd0\xb8\xd0\xb4\xd0\xb5\xd1\x82!')
            return
        self._rewrite_key = key
        self.startRec()

    def rec_foo_demo(self, function_name, w, kw):
        self._rec_foo[function_name] = (w, kw)

    def rec_attr_demo(self, atr, old_val, new_val):
        self._rec_atr[atr] = (old_val, new_val)

    def rec_tick(self):
        player = BigWorld.player()
        t = time.time()
        dTime = t - self._last_time
        self._last_time = t
        entry = (dTime,
         tuple(player.position),
         player.yaw,
         player.pitch,
         self._rec_atr,
         self._rec_foo)
        self._rec_atr = {}
        self._rec_foo = {}
        self._rec_data.append(entry)
        self._rec_tid = BigWorld.callback(0.001, self.rec_tick)
        if s_recorder_gui:
            s_recorder_gui.onRecTick(t - self._start_rec_time)

    def stopAllPlay(self):
        for key in self.active_demos.keys():
            self.stopPlay(key)

    @property
    def demo_mode(self):
        return self._demo_mode

    def changeMode(self, mode):
        if mode == self._demo_mode:
            return
        self._demo_mode = mode
        print '_demo_mode', self._demo_mode
        if self._demo_mode:
            self.load()
        else:
            self.loadDevNPCDemos()
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()

    def deleteAll(self):
        for key in s_recorder.demos.keys():
            self.deleteDemo(key)

    def stopPlay(self, key):
        if key not in self.active_demos:
            return
        self.active_demos[key].stop()
        del self.active_demos[key]
        if s_recorder_gui:
            s_recorder_gui.onChangeDemos()

    def startPlay(self, key, repeat = False):
        if key in self.active_demos:
            print 'already played', key
            return
        elif not self.demos[key]:
            return
        else:
            npc_params = None
            if not self.demo_mode:
                npc_params = tutorial_demos_npc_config
            self.active_demos[key] = DemoPlayed(key, repeat, npc_params=npc_params)

            def callback_(*e):
                if s_recorder_gui:
                    s_recorder_gui.onChangeDemos()

            self.active_demos[key].loadAndPlay(repeat, callback_)
            if s_recorder_gui:
                s_recorder_gui.onChangeDemos()
            return


