    def read_personality(self):
        """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd1\x86\xd1\x8b \xd0\xbb\xd0\xb8\xd1\x86\xd0\xb0 \xd0\xb2 \xd0\xb1\xd0\xb8\xd1\x82\xd1\x8b \xd0\xb8 \xd0\xb7\xd0\xb0\xd0\xbf\xd0\xb8\xd1\x85\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2 personality """
        face_data = self.face_controller.raw_data
        face_blob = FaceSaver.face_data_to_int64_array(face_data, self.face_limits_type)
        self.personality['face'] = face_blob
        return self.personality

    @property
    def personality(self):
        if self.character:
            return self.character['personality']
        return self._chosen_personality

    @personality.setter
    def personality(self, value):
        if 'mark' not in value:
            value['mark'] = {'id': 0,
             'color': 0}
        self._chosen_personality = value

    @property
    def EquipModes(self):
        if self.character:
            return self.character['equipModes']
        return self._chosen_modes

    @EquipModes.setter
    def EquipModes(self, value):
        self._chosen_modes = value

    def sendWTonAvatarChangeWeaponStatus(self):
        tracker_key = self._getTrackerKey()
        BWPersonality.onAvatarChangeWeaponStatus(self.weaponStatus, self._last_action_type, tracker_key)

    def sendWTonAvatarChangeWeapon(self):
        weapon_type = self.active_weapon.getItemType() if self.active_weapon else 0
        BWPersonality.onAvatarChangeWeapon(weapon_type)