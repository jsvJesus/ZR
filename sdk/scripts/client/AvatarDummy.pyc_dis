    def on_npc_face_type_click(self, npc_mode):
        self.face_limit_type = LC.NPC if npc_mode else LC.PLAYER
        self.personality['face'] = FaceSaver.generate_random_face(self.face_limits_type)
        self._reset_face_on_set_model = True
