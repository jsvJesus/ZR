        if BWPersonality.GUICore.is_promo_gui_visible():
            BWPersonality.GUICore.promo_gui.on_use_promocode(stritems)

    def _buyDonatePlatina(self, buy_items, full_cost):
        print '_buyDonatePlatina', self, buy_items, full_cost, int(full_cost)
        self.bb = buy_items
        self.base.buyDonatePlatina(buy_items, int(full_cost))