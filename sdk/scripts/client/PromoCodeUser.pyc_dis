    def onPrCoEvent(self, code):
        if BWPersonality.GUICore.is_promo_gui_visible():
            BWPersonality.GUICore.promo_gui.on_promo_event(code)
        print 'onPrCoEvent', code, unicode(PCODE.get_lc(code)).encode('utf8')

    def onNoPartner(self):
        print 'no partner!', self
        self.onUpdatePartnerInfo(0, '', False, '', 0, [])

    def onUpdatePartnerInfo(self, partner_id, promo_code, disabled, stritems, perc, perc_serv):
        print 'onUpdatePartnerInfo', [partner_id,
         promo_code,
         disabled,
         stritems,
         perc,
         PY(perc_serv)]
        PromoCodeUser._partner_id = partner_id
        PromoCodeUser._partner_promo_code = promo_code
        PromoCodeUser._partner_disabled = disabled
        PromoCodeUser._partner_stritems = stritems
        PromoCodeUser._partner_perc = (perc, perc_serv)
        BWPersonality.GUICore.loginFlash.update_partner_id(partner_id)
