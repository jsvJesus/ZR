            BWPersonality.GUICore.promo_gui.on_reg_partner(email, secret)

    def onUpdatePartnerPlatina(self, platina):
        print 'onUpdatePartnerPlatina', platina
        PromoCodeUser._current_platina = platina
        BWPersonality.GUICore.updateStorehouseMoney()

    def onUsePartnerPromoCode(self, stritems, note):
        if BWPersonality.GUICore.is_promo_gui_visible():
