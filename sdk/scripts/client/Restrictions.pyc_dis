# Embedded file name: ./client/Restrictions.py
__author__ = 'leviathan'
import time
from RestrictionsUtils import RestrictionCommon
import BWPersonality
from CallbackHelpers import callbackHe

class Restrictions(RestrictionCommon):
    CALLBACK_ID_STR = 'restriction_channel_'

    def __init__(self):
        self.InitRestrictionArray()
        self.ClientChannelServerWaiting = {}
        self.RestrictionCallbacks = {}
        self._client_restrictions = {}
        self.custom_restrictions = set()

    def UpdateRestrictions(self):
        return
        index = 0
        for channel in self.restrictions:
            time_left = channel - time.time()
            if time_left < 0:
                time_left = 0
            BWPersonality.GUICore.drawLabel(text='channel ' + str(index) + ' = ' + str(time_left), id=index, x=235, y=7 + 13 * index)
            index += 1

    def DoAction(self, channel, action_duration, name = u'', callback_func = None):
        if action_duration > 0.0:
            self.ClientChannelServerWaiting[channel] = 1
            self._client_restrictions[channel] = time.time() + action_duration
            self.RestrictionCallbacks[channel] = callback_func

    def CheckRestriction(self, channel, check_server = True):
        if self.block_channel_items:
            return False
        elif self.custom_restrictions:
            return False
        elif self.isRelaodWeaponProgress:
            return False
        elif self.isPutOnOffWeaponProgress:
            return False
        elif self.isEquipWeaponProgress:
            return False
        elif self.isImpactingPlayed():
            return False
        else:
            client_waiting_restrict = self.ClientChannelServerWaiting.get(channel, 0)
            if client_waiting_restrict:
                self.cell.ConfirmRestriction(channel)
                need_time = self._client_restrictions.get(channel, 0)
                return need_time <= time.time()
            elif callbackHe.findFirst(self.CALLBACK_ID_STR + str(channel)) is not None:
                return False
            elif check_server:
                return RestrictionCommon.CheckRestriction(self, channel)
            return True
            return

    def ServerRestrict(self, channel, action_duration, restr_name = u'', percent_cast = 0.0):
        self.ClientChannelServerWaiting[channel] = 0
        callback_func = self.RestrictionCallbacks.pop(channel, None)
        if callback_func:
            callbackHe(callback_func, action_duration, id=self.CALLBACK_ID_STR + str(channel))
        RestrictionCommon.DoAction(self, channel, action_duration)
        bar_show_threshold = 0.6
        if action_duration != None and action_duration > bar_show_threshold:
            if percent_cast:
                BWPersonality.GUICore.cast_bar.runSegmentCast(action_duration, percent_cast)
            else:
                BWPersonality.GUICore.cast_bar.runCast(action_duration)
        return

    def CancelAction(self, channel):
        self.ClientChannelServerWaiting[channel] = 0
        self.RestrictionCallbacks[channel] = None
        try:
            self.restrictions[channel] = 0
        except IndexError:
            print 'Unknown restriction channel', channel

        BWPersonality.GUICore.cast_bar.cancelCast()
        return