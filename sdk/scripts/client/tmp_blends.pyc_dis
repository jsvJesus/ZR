# Embedded file name: ./client/tmp_blends.py
import BigWorld
import Math
from Math import Matrix, Vector3, Vector2

def percent_from(val, min_val, max_val):
    min_val = float(min_val)
    if val <= min_val:
        return 0.0
    if val >= max_val:
        return 1.0
    return (val - min_val) / (max_val - min_val)


def get_linear_coeff(current_val, val_min, val_max, to_val_min, to_Val_max):
    perc = percent_from(current_val, val_min, val_max)
    return to_val_min + (to_Val_max - to_val_min) * perc


class LinearBlend:

    def __init__(self, step = 0.1, curentValue_ = 0.0, valueTo_ = 0.0):
        self.curentValue_ = curentValue_
        self.valueTo_ = valueTo_
        self.accelerationStep_ = step

    def setValueTo(self, val):
        self.valueTo_ = val

    def setCurrentValue(self, val):
        self.curentValue_ = val

    def getCurrentValue(self):
        return self.curentValue_

    def updateBlend(self, dtime):
        blendstep = self.accelerationStep_ * dtime
        if abs(self.curentValue_ - self.valueTo_) < blendstep:
            self.curentValue_ = self.valueTo_
            return
        if self.curentValue_ > self.valueTo_:
            self.curentValue_ = self.curentValue_ - blendstep
            return
        self.curentValue_ = self.curentValue_ + blendstep


class HalfBlend(LinearBlend):

    def updateBlend(self, dtime):
        delta = self.valueTo_ - self.curentValue_
        self.curentValue_ = self.curentValue_ + delta * self.accelerationStep_


class AcceleratedBlendCls(LinearBlend):

    def __init__(self, step = 0.1, porog = 0.1):
        LinearBlend.__init__(self)
        self.curentValue_ = 0
        self.valueTo_ = 0
        self.ignoredDelta_ = 0
        self.currentSpeed_ = 0
        self.accelerationStep_ = step
        self.accelerationPorog_ = porog

    def updateBlend(self, xdtime):
        if xdtime < 0.0001:
            xdtime = 0.0001
        deltaPos = abs(self.valueTo_ - self.curentValue_)
        if deltaPos < self.ignoredDelta_:
            self.curentValue_ = self.valueTo_
            self.currentSpeed_ = 0.0
            return 0.0
        if deltaPos > self.accelerationStep_ * xdtime:
            self.currentSpeed_ = self.currentSpeed_ + self.accelerationStep_ / xdtime
        if deltaPos < self.currentSpeed_ * self.accelerationPorog_:
            self.currentSpeed_ = deltaPos / self.accelerationPorog_
        dt = self.currentSpeed_ * xdtime
        if self.valueTo_ > self.curentValue_:
            self.curentValue_ = self.curentValue_ + dt
            if self.valueTo_ < self.curentValue_:
                self.curentValue_ = self.valueTo_
                self.currentSpeed_ = 0.0
                return deltaPos
            return dt
        self.curentValue_ = self.curentValue_ - dt
        if self.valueTo_ > self.curentValue_:
            self.curentValue_ = self.valueTo_
            self.currentSpeed_ = 0.0
            return -deltaPos
        else:
            return -dt