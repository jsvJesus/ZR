# Embedded file name: ./client/creature_footsteps.py
"""
\xd1\x88\xd0\xb0\xd0\xb3\xd0\xb8 \xd0\xbc\xd0\xbe\xd0\xb1\xd0\xbe\xd0\xb2
\xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f \xd0\xb3\xd0\xb5\xd0\xbd\xd0\xb5\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd1\x8e\xd1\x82\xd1\x81\xd1\x8f CUE \xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8
\xd0\xb2 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd0\xb5 \xd0\xbc\xd0\xbe\xd0\xb1\xd0\xbe\xd0\xb2 "cue_footstep_node":{"cue_trak","node_name"}
"""
from functools import partial
from itertools import chain
import traceback
import BigWorld
import sounds_manager as sounds
import utils
from client_utils import GetDogWatch
TYPE_STEP, TYPE_FALL = xrange(2)
MAX_DISTANCE = 900

class CreatureFootsteps:

    def __init__(self):
        self.__fall_sound_path = None
        self.__sound_path = None
        return

    def createCueFootSteps(self, sound_path, fall_sound_path):
        if self.model is None:
            return
        else:
            self.__sound_path = sound_path
            self.__fall_sound_path = fall_sound_path

            def createCue(path_sound, cue_name, sound_type):
                if not path_sound:
                    return
                try:
                    self.model.cue(cue_name, partial(self._onCueFoots, cue_name, sound_type))
                except:
                    print 'ERROR create cue %r' % cue_name, self, self.model.sources
                    traceback.print_exc()

            createCue(sound_path, 'footprint_sound', TYPE_STEP)
            createCue(fall_sound_path, 'fall', TYPE_FALL)
            return

    def getSoundByType(self, sound_type):
        if sound_type == TYPE_STEP:
            return self.__sound_path
        if sound_type == TYPE_FALL:
            return self.__fall_sound_path
        return ''

    def clearCueFootSteps(self):
        if not self.model:
            return
        else:
            for cue_name in ['footprint_sound', 'fall']:
                try:
                    self.model.cue(cue_name, None)
                except:
                    print 'ERROR create cue %r' % cue_name, self, self.model.sources
                    traceback.print_exc()

            return

    def _onCueFoots(self, cue_name, event_type):
        if self.isDestroyed:
            return
        else:
            dist = BigWorld.camera().position.distSqrTo(self.position)
            if dist > MAX_DISTANCE:
                return
            res = BigWorld.collide(self.spaceID, self.position + (0, 1, 0), self.position - (0, 1, 0))
            if not res:
                self.onCueFootTriggered(event_type, None, None)
                return
            mat_id = res[-1]
            collide_position = res[0]
            mat_sound = utils.get_material_sound_by_id(mat_id, 'grass')
            water_res = BigWorld.waterCollide(self.position + (0, 2, 0), collide_position)
            if water_res:
                collide_position = water_res[0]
                mat_sound = 'water'
            if not mat_sound:
                return
            sound_name = self.getSoundByType(event_type) + '/' + mat_sound
            sound = sounds.playSound(sound_name, self, self.get_sfx_volume())
            if sound:
                sound.set_pitch(self.get_pitch())
                self.onCueFootTriggered(event_type, collide_position, sound)
            return

    def onCueFootTriggered(self, event_type, position, sound):
        pass