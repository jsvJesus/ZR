# Embedded file name: ./client/MemLogger.py
import os
import psutil
from time import time, strftime, gmtime
from CallbackHelpers import callbackHe
CRITICAL_MEMORY_LIMIT = 500

class MemLogger(object):

    def __init__(self, callback_func = None):
        super(MemLogger, self).__init__()
        self._pid = os.getpid()
        self._callback_func = callback_func

    def start(self):
        print '[MemLogger] start'
        callbackHe(self._print_memory_usage, 10, interval=420, cancel_existing=True)

    def _print_memory_usage(self):
        process = psutil.Process(self._pid)
        mem = psutil.virtual_memory()
        mem_usage = process.memory_info().vms >> 20
        mem_free = mem.free >> 20
        mem_total = mem.total >> 20
        date = strftime('%b %d %Y %H:%M:%S', gmtime(time()))
        print '{0} MEMORY_USAGE: {1}MB, Free {2}MB, Total {3}MB, perc {4:.1f}'.format(date, mem_usage, mem_free, mem_total, mem.percent)
        if mem_free < CRITICAL_MEMORY_LIMIT:
            if self._callback_func is not None:
                self._callback_func(-1, 'LOW MEMORY')
            else:
                print 'LOW MEMORY'
        return