# Embedded file name: ./client/GunPoint.py
from Math import Vector3
import BigWorld
import Helpers.Caps
from soGUI.soInworldMarkers import soInworldMarker
from Localization import lc
from Tank import IGNORE_MATERIAL
from gunpoints.GunPointBox import GunPointBox
model_name = 'characters2/weapons/machinegun/pkp/pkp.model'

class GunPoint(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.targetCaps = self.targetCaps + [Helpers.Caps.CAP_INTERACT]
        self._box = None
        return

    def prerequisites(self):
        return [model_name]

    def onEnterWorld(self, prereqs):
        self.model = prereqs[model_name]
        self.model.visible = not self.gunner_id
        self._create_box()

    def _create_box(self):
        if self._box:
            self._box.destroy()
        self._box = GunPointBox(self.chargebox, self.spaceID, self.id)

    def on_load_request(self, data):
        self.cell.request_load(data['cid'], data['count'])

    def set_gunner_id(self, old_value):
        self.model.visible = not self.gunner_id

    def interact(self, interactor):
        interactor.interact_gunpoint(self)

    def get_gunner_position(self):
        p1 = self.position
        p2 = self.position - Vector3(0, 2, 0)
        res = BigWorld.collideIgnoreFlags(self.spaceID, p1, p2, IGNORE_MATERIAL)
        return res and res[0]

    def get_interaction_dist(self):
        return 2

    def get_target_mark(self, distance):
        if distance <= self.get_interaction_dist():
            return soInworldMarker.MARKER_USE

    def set_ammotype(self, old_value):
        if self.gunner_id:
            gunner = BigWorld.entities.get(self.gunner_id)
            gunner and gunner.on_gun_ammotype_changed(self.ammotype)

    def get_mark_name(self):
        return lc('gunner.name')

    def onLeaveWorld(self):
        self._box.destroy()