class EquipItem(SimpleCommand):

    @BWMemberCoroutine
    def run(self):
        try:
            yield BWWaitForPeriod(0)
            player = BigWorld.player()
            ison = self._args[0].lower() == 'on'
            item_type = int(self._args[1])

            def is_on_condition():
                equipped_ids = ItemsUtils.GetEquipSetFullIDs(player)
                for item_index in ItemsUtils.get_multiple_item_indices_by_ids(player, equipped_ids):
                    if player.CarryingItems[item_index]['complexItemType'] == item_type:
                        return True

                return False

            if ison:
                if is_on_condition():
                    return
                equipped_ids = ItemsUtils.GetEquipSetFullIDs(player)
                citem = [None]

                def find_item_on():
                    for ci in player.CarryingItems:
                        if ci['complexItemType'] != item_type:
                            continue
                        if ci['complexItemID'] in equipped_ids:
                            continue
                        if not player.can_put_on_item(ci):
                            continue
                        citem[0] = ci
                        return True

                    return False

                try:
                    yield BWWaitForCondition(find_item_on, 5, 0.5)
                except BWCoroutineTimeoutException:
                    self.errors.append(u'cant find item {0} to put it on'.format(item_type))
                    return

                player.put_on_item(citem[0])
                try:
                    yield BWWaitForCondition(lambda : not player.is_clothing(), 10, 0.5)
                    yield BWWaitForCondition(is_on_condition, 5, 0.5)
                except BWCoroutineTimeoutException:
                    self.errors.append(u'cant put item {0} on'.format(item_type))
                    return

            else:
                if not is_on_condition():
                    return
                citem = [None]

                def find_item_off():
                    equipped_ids = ItemsUtils.GetEquipSetFullIDs(player)
                    for item_index in ItemsUtils.get_multiple_item_indices_by_ids(player, equipped_ids):
                        ci = player.CarryingItems[item_index]
                        if ci['complexItemType'] != item_type:
                            continue
                        if not player.can_put_off_items([ci]):
                            continue
                        citem[0] = ci
                        return True

                    return False

                try:
                    yield BWWaitForCondition(find_item_off, 5, 0.5)
                except BWCoroutineTimeoutException:
                    self.errors.append(u'cant find item {0} to put it off'.format(item_type))
                    return

                player.put_off_item(citem[0])
                try:
                    yield BWWaitForCondition(lambda : not player.is_clothing(), 10, 0.5)
                    yield BWWaitForCondition(lambda : not is_on_condition(), 5, 0.5)
                except BWCoroutineTimeoutException:
                    self.errors.append(u'cant put item {0} on'.format(item_type))
                    return

        except GeneratorExit:
            pass
        except:
            traceback.print_stack()
            traceback.print_exc()
            self.errors.append(u'python error')

        return


class DelItem(SimpleCommand):

    @BWMemberCoroutine
    def run(self):
        try:
            yield BWWaitForPeriod(0)
            player = BigWorld.player()
            item_type = int(self._args[0])
            last_search_items = [None, None]

            def check_presence():
                items_to_delete = []
                items_to_putoff = []
                equipped_ids = ItemsUtils.GetEquipSetFullIDs(player)
                for citem in player.CarryingItems:
                    if citem['complexItemType'] != item_type:
                        continue
                    if citem['complexItemID'] in equipped_ids:
                        items_to_putoff.append(citem)
                    else:
                        items_to_delete.append(citem)

                last_search_items[0] = items_to_putoff
                last_search_items[1] = items_to_delete
                return bool(items_to_delete or items_to_putoff)

            if not check_presence():
                return
            items_to_putoff, items_to_delete = last_search_items
            for item_put_off in items_to_putoff:
                coroutine = EquipItem('off {0}'.format(item_put_off['complexItemType']))
                yield BWWaitForCoroutine(coroutine.run())
                items_to_delete.append(item_put_off)

            if items_to_delete:
                player.delete_items(items_to_delete)
                player.NeedToUpdateInventory(need_block=True)
                try:
                    yield BWWaitForCondition(lambda : not check_presence(), 5, 0.5)
                except BWCoroutineTimeoutException:
                    self.errors.append(u'cant del item {0}'.format(item_type))
                    return

        except GeneratorExit:
            pass
        except:
            traceback.print_stack()
            traceback.print_exc()
            self.errors.append(u'python error')

        return


