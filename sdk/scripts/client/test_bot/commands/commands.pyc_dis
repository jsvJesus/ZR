class TpPos(SimpleCommand):

    @BWMemberCoroutine
    def run(self):
        try:
            yield BWWaitForPeriod(0)
            tp_position = None
            if len(self._args) == 3:
                try:
                    x, y, z = map(float, self._args)
                    tp_position = Vector3(x, y, z)
                except:
                    pass

            if not tp_position:
                self.errors.append(u'bad teleport position ' + self._args)
                return

            def near_condition():
                return BigWorld.player().position.distTo(tp_position) < 1.0

            def world_ready_condition():
                return BigWorld.spaceLoadStatus() >= 1.0

            try:
                yield BWWaitForCondition(world_ready_condition, 180, 0.5)
            except BWCoroutineTimeoutException:
                self.errors.append(u'too long map loading time')
                return

            if not near_condition():
                BWPersonality.GUICore.chatConsole.run_command(u'tp {0}'.format(tp_position))
            try:
                yield BWWaitForCondition(near_condition, 5, 0.5)
            except BWCoroutineTimeoutException:
                self.errors.append(u'cant teleport')
                return

        except GeneratorExit:
            pass
        except:
            traceback.print_stack()
            traceback.print_exc()
            self.errors.append(u'python error')

        return


class InviteSelf(SimpleCommand):

    @BWMemberCoroutine
    def run(self):
        try:
            yield BWWaitForPeriod(0)

            def is_in_party():
                return BigWorld.player()._party_status != S.Lone

            if is_in_party():
                yield BWWaitForPeriod(0)
                return
            BigWorld.player()._invite_timer._last_invoke_time.clear()
            BWPersonality.GUICore.chatConsole.run_command(u'invite {0}'.format(BigWorld.player().name))
            msbox = [None]

            def find_msbox():
                for box in BWPersonality.GUICore.msgBoxMgr.msgBoxes.values():
                    if u'\u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u043e\u0442\u0440\u044f\u0434' in box.caption.lower():
                        msbox[0] = box
                        return True

                return False

            try:
                yield BWWaitForCondition(find_msbox, 5.0, 0)
            except BWCoroutineTimeoutException:
                self.errors.append(u"can't find invite agreement")
                return

            for btn in msbox[0].btns:
                if btn['type'] == MESSAGEBOX.BTN_YES:
                    btn_comp = getattr(msbox[0].component, 'btn_{0}'.format(btn['type']))
                    btn_comp.script.onClick()
                    break
            else:
                self.errors.append(u"can't find proper invite agreement")
                return

            try:
                yield BWWaitForCondition(is_in_party, 2.0, 0)
            except BWCoroutineTimeoutException:
                self.errors.append(u"can't invite self")
                return

        except GeneratorExit:
            pass
        except:
            traceback.print_stack()
            traceback.print_exc()
            self.errors.append(u'python error')

        return


