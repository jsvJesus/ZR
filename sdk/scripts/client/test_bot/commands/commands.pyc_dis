            player.base.test_bot([TBC.SetAch, ach_id])
            yield BWWaitForPeriod(0)
            player.base.test_bot([TBC.GetAch, ach_id])
            yield BWWaitForPeriod(0)
            try:
                yield BWWaitForCondition(lambda : completed[0] is not None, 5, 0.5)
            except BWCoroutineTimeoutException:
                self.errors.append(u'server not responding while setting ach {0}'.format(ach_id))
                return

            if not completed[0]:
                self.errors.append(u"can't set ach {0}".format(ach_id))
                return
        except GeneratorExit:
            pass
        except:
            traceback.print_stack()
            traceback.print_exc()
            self.errors.append(u'python error')

        return


_command_to_class = {'tpnpc': TpNameCommand,
 'start_dialog': StartDialog,
 'say': SayCommand,
 'set_rep': SetRepCommand,
 'say_status': SayStatus,
 'answer_status': AnswerStatus,
 'quest_status': QuestStatus,
 'item': CreateItem,
 'answer_status': AnswerStatus,
 'item_status': ItemsCheck,
 'equip': EquipItem,
 'delitem': DelItem,
 'achset': AchSet,
 'achwipe': AchWipe,
 'inviteself': InviteSelf,
 'tppos': TpPos,
 'wait': Wait,
 'quest_get': QuestGet,
 'quests_wipe': QuestsWipe,
 'quest_complete': QuestComplete,
 'money_set': MoneySet,
 'run_console': RunConsole}

def get_coroutine(command_name, args):
    command_class = _command_to_class.get(command_name)
    return command_class and command_class(args)