class QuestStatus(SimpleCommand):

    @BWMemberCoroutine
    def run(self):
        try:
            yield BWWaitForPeriod(0)
            player = BigWorld.player()
            status = self._args[0].lower()
            quest_id = int(self._args[1])

            def test_bot(args):
                if args[0] == TBC.CheckQuest:
                    completed[0] = args

            start_time = BigWorld.time()
            while True:
                completed = [None]
                player.test_bot = test_bot
                yield BWWaitForPeriod(0)
                player.base.test_bot([TBC.CheckQuest, quest_id])
                yield BWWaitForPeriod(0)
                try:
                    yield BWWaitForCondition(lambda : completed[0] is not None, 5, 0.5)
                except BWCoroutineTimeoutException:
                    self.errors.append(u'server not responding while quest status {0} {1}'.format(status, quest_id))
                    return

                error = None
                server_quest_id, server_status = completed[0][1:]
                if server_status == Quest.STATE_OPENED:
                    if status not in ('open', 'opened'):
                        error = u'bad quest status {0} {1} STATE_OPENED'.format(quest_id, status)
                elif server_status == Quest.STATE_ONTEST:
                    if status not in ('ontest',):
                        error = u'bad quest status {0} {1} STATE_ONTEST'.format(quest_id, status)
                elif server_status == Quest.STATE_CLOSED:
                    if status not in ('close', 'closed'):
                        error = u'bad quest status {0} {1} STATE_CLOSED'.format(quest_id, status)
                elif server_status == Quest.STATE_FREEZ:
                    if status not in ('freez',):
                        error = u'bad quest status {0} {1} STATE_FREEZ'.format(quest_id, status)
                elif server_status == Quest.STATE_FAILED:
                    if status not in ('fail', 'failed'):
                        error = u'bad quest status {0} {1} STATE_FAILED'.format(quest_id, status)
                elif server_status == Quest.STATE_ABSENT:
                    if status not in ('absent',):
                        error = u'bad quest status {0} {1} STATE_ABSENT'.format(quest_id, status)
                if not error or BigWorld.time() - start_time >= 3.0:
                    break

            if error:
                self.errors.append(error)
        except GeneratorExit:
            pass
        except:
            traceback.print_stack()
            traceback.print_exc()
            self.errors.append(u'python error')

        return


