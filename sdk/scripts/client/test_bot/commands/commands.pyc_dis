class SimpleCommand:

    def __init__(self, args):
        self._args = args.split()
        self._str_args = args
        self.errors = []

    def get_cur_count(self, item_type):
        count = 0
        for citem in BigWorld.player().CarryingItems:
            if citem['complexItemType'] == item_type:
                count += ItemsUtils.GetItemNumber(citem)

        return count

    def dialog_ready_condition(self):
        dialog_screen = BWPersonality.GUICore.dialog_screen
        if not dialog_screen.visible or dialog_screen.pending:
            return False
        button_comps = dialog_screen._buttons_block.component.buttonsblock.children
        if not button_comps:
            return False
        for _, btn_comp in button_comps:
            if not Utils.is_visible_in_hierarchy(btn_comp) or btn_comp.script.buttonDisabled:
                return False

        return True

    @BWMemberCoroutine
    def run(self):
        raise NotImplementedError


class TpNameCommand(SimpleCommand):

    @BWMemberCoroutine
    def run(self):
        try:
            yield BWWaitForPeriod(0)
            npc_name = self._args[0]

            def npc_near_condition():
                for entity in BigWorld.entities.values():
                    if getattr(entity, 'npcName', None) == npc_name:
                        return (entity.position - BigWorld.player().position).length < QuesterConsts.MAX_DIALOG_DISTANCE

                return False

            if npc_near_condition():
                return

            def world_ready_condition():
                return BigWorld.spaceLoadStatus() >= 1.0

            BWPersonality.GUICore.chatConsole.run_command('tpnpc ' + npc_name)
            try:
                yield BWWaitForCondition(npc_near_condition, 5, 0.5)
            except BWCoroutineTimeoutException:
                pass

            other_world = BigWorld.spaceLoadStatus() < 1.0
            try:
                yield BWWaitForCondition(world_ready_condition, 180, 0.5)
            except BWCoroutineTimeoutException:
                self.errors.append(u'too long map loading time')
                return

            try:
                yield BWWaitForCondition(npc_near_condition, 30 if other_world else 5, 0.5)
            except BWCoroutineTimeoutException:
                self.errors.append(u'npc {0} not found'.format(npc_name))
                return

        except GeneratorExit:
            pass
        except:
            traceback.print_stack()
            traceback.print_exc()
            self.errors.append(u'python error')


class StartDialog(SimpleCommand):

    @BWMemberCoroutine
    def run(self):
        try:
            yield BWWaitForPeriod(0)
            npc_name = self._args[0]
            tpname_command = TpNameCommand(npc_name)
            yield BWWaitForCoroutine(tpname_command.run())
            if tpname_command.errors:
                self.errors.extend(tpname_command.errors)
                return
            for entity in BigWorld.entities.values():
                if getattr(entity, 'npcName', None) == npc_name:
                    break
            else:
                self.errors.append(u'npc {0} not found'.format(npc_name))
                return

            if self.dialog_ready_condition():
                dialog_screen = BWPersonality.GUICore.dialog_screen
                dialog_screen.hide()
            BigWorld.player().start_talk(entity)
            try:
                yield BWWaitForCondition(self.dialog_ready_condition, 5.0, 0.5)
            except BWCoroutineTimeoutException:
                self.errors.append(u"can't open dialog with entity " + npc_name)
                return

        except GeneratorExit:
            pass
        except:
            traceback.print_stack()
            traceback.print_exc()
            self.errors.append(u'python error')

        return


