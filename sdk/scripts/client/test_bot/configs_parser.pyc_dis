# Embedded file name: ./client/test_bot/configs_parser.py
import ResMgr
_data = {}

def parse():
    path = 'scripts/client/test_bot/configs'
    ResMgr.purge(path, True)
    section = ResMgr.openSection(path)
    paths = []
    for path, item in section.items():
        paths.append(path)
        _data[path] = item.asBinary.decode('utf8')

    return paths


def get_config_commands(config):
    commands = _data[config].splitlines()
    run_params = []
    if commands:
        potential_run_params = commands[0].split(' ')
        if potential_run_params[0] == 'set_run_params':
            run_params = potential_run_params[1:]
    return (run_params, filter(bool, commands))