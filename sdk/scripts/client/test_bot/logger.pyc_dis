# Embedded file name: ./client/test_bot/logger.py
import os

def log(start_time, config_name, errors):
    path = os.path.normpath(os.path.join(os.getcwd(), '../res/scripts/client/test_bot/logs'))
    if not os.path.exists(path):
        os.makedirs(path)
    file_name = os.path.splitext(config_name)[0] + '_' + start_time + '.txt'
    with open(os.path.join(path, file_name), 'w') as f:
        errors = [ e.encode('utf8') for e in errors ]
        if errors:
            f.writelines(errors)
        else:
            f.write('no errors')