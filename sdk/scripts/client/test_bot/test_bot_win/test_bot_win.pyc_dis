    def _on_close_click(self):
        self.notify_listeners(EventType.OnCloseRequest)

    def _on_stop_clicked(self):
        self.notify_listeners(EventType.OnStopRequested)

    def _on_run_clicked(self):
        data = {'config': self.get_selected_config()}
        self.notify_listeners(EventType.OnRunRequested, data)

    def _on_reload_configs_clicked(self):
        self.notify_listeners(EventType.OnReloadConfigsRequested)

    def _on_help_click(self):
        import webbrowser
        webbrowser.open('http://hz-dev.stalker.so:8090/projects/stalker-online/wiki/Bottesting')

    def connect_brain(self, brain):
        if self._brain:
            self._brain.remove_listener(self._on_brain_event)
        self._brain = brain
        if self._brain:
            self._brain.add_listener(self._on_brain_event)
        self._update_content()
        self._update_stats()

    def show(self):
        self.component.visible = True
        self._update_content()
        self._update_stats()

    def _on_brain_event(self, event_type, data):
        if event_type == BotET.OnStarted:
            self._update_content()
        elif event_type == BotET.OnStopped:
            self._update_content()
            self._update_stats()
        elif event_type == BotET.OnStatChanged:
            self._update_stats()

    def _update_stats(self):
        text = None
        if self._brain:
            if self._brain.is_running():
                command = self._brain.statistics.command
                text = command and u'process:\ncommand: ' + command
            else:
                text = u'result:\nerrors: ' + str(len(self._brain.statistics.errors))
        self._command_tf.setText(text or u'', immidiate=True)
        return

    def _update_content(self):
        run_enabled = False
        stop_enabled = False
        if self._brain and self._brain.is_running():
            stop_enabled = True
        else:
            run_enabled = bool(self.get_selected_config())
        self._run_btn.setDisabledState(not run_enabled)
        self._stop_btn.setDisabledState(not stop_enabled)

    def _on_config_selected(self, config):
        self._update_content()

    def get_selected_config(self):
        return self._configs_ddl.getSelection()[0]

    def select_config(self, config_name):
        self._configs_ddl.setSelectionByValue(config_name)

    def set_config_names(self, names):
        prev_selection = self.get_selected_config()
        self._configs_ddl.clear()
        ddl_elements = []
        for name in names:
            ddl_elements.append((name, name))

        self._configs_ddl.addElements(ddl_elements)
        if prev_selection:
            self._configs_ddl.setSelectionByValue(prev_selection, silent=True)
        if self.get_selected_config() != prev_selection:
            self._on_config_selected(None)
        self._update_content()
        return

    def hide(self):
        self.component.visible = False

    def destroy(self):
        Listenable.release(self)
        self.hide()
        BWPersonality.GUICore.worldLayer.delChild('test_bot_win')