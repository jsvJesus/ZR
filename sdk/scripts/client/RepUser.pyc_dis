# Embedded file name: ./client/RepUser.py
import BWPersonality

class RepUser:
    _subscribers = {}
    _rep_data = {}

    def __init__(self):
        self._subscribers = RepUser._subscribers
        self.fav_users = BWPersonality.settings.get_fav_users(self.name)
        self._rep_data = RepUser._rep_data

    def subscribe_repvalue(self, group_id, listener):
        if group_id not in self._subscribers:
            self._subscribers[group_id] = [listener]
            self.base.subscribe_repvalue(group_id)
        else:
            self._subscribers[group_id].append(listener)
            if group_id in self._rep_data:
                listener(group_id, self._rep_data[group_id])

    def unsubscribe_repvalue(self, group_id, listener):
        if listener not in self._subscribers.get(group_id, []):
            return
        self._subscribers[group_id].remove(listener)
        if not self._subscribers[group_id]:
            if self.isConnected:
                self.base.unsubscribe_repvalue([group_id])
            del self._subscribers[group_id]
            if group_id in self._rep_data:
                del self._rep_data[group_id]

    def on_repvalue_event(self, group_id, value):
        self._rep_data[group_id] = value
        if group_id in self._subscribers:
            for listener in self._subscribers[group_id]:
                listener(group_id, value)

    def is_rep_favourite(self, group_id):
        return group_id in self.fav_users

    def is_fav_rep_limit(self):
        return len(self.fav_users) >= 5

    def set_rep_favourite(self, rep_id, value):
        if value:
            if rep_id not in self.fav_users:
                self.fav_users.append(rep_id)
        elif rep_id in self.fav_users:
            self.fav_users.remove(rep_id)
        BWPersonality.settings.set_fav_user(self.name, self.fav_users)

    def onLeaveWorld(self):
        self._rep_data.clear()
        self._subscribers.clear()