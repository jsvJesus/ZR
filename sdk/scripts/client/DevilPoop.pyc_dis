use_new = True

class DevilPoop(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._sfx = None
        return

    def onEnterWorld(self, prereqs):
        self.model = BigWorld.Model('')

        def on_load(prereq):
            if self.isDestroyed or not self.model:
                return
            self._sfx = PersistentExt(_sfx_path, prereq)
            self._sfx.attach(self.model)
            self._sfx.go()

        loadPersistentExtAsync([_sfx_path], on_load)

