# Embedded file name: ./client/HeliTransmitter.py
import BigWorld
import Helpers.Caps
from soGUI.soInworldMarkers import soInworldMarker
MODEL_NAME = 'models/props/makenjaf/antenna.model'

class HeliTransmitter(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.targetCaps = self.targetCaps + [Helpers.Caps.CAP_INTERACT]

    def prerequisites(self):
        return [MODEL_NAME]

    def onEnterWorld(self, prereqs):
        self.model = prereqs[MODEL_NAME]

    def interact(self, interactor):
        BigWorld.player().cell.try_summon_helicopter(self.helipoint_id)

    def get_target_mark(self, distance):
        if distance <= self.get_interaction_dist():
            return soInworldMarker.MARKER_USE

    def get_mark_name(self):
        return u'\u0412\u0435\u0440\u0442\u043e\u043b\u0451\u0442\u043e\u0432\u044b\u0437\u044b\u0432\u0430\u043b\u043a\u0430'

    def get_interaction_dist(self):
        return 5.0

    def onLeaveWorld(self):
        self.model = None
        return