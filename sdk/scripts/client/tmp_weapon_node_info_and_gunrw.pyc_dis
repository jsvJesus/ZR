MAX_DIFF_YAW = 0.2

class RecoilRotator():

    def __init__(self):
        self.to_x = 0
        self.to_y = 0
        self.x = 0
        self.y = 0
        self.time_per_shot = 0.01
        self.played = 0
        self._isendfire = False
        self._shot_index = 0
        self._total_perc = 0
        self._deb_total_x = 0

    def fire(self, rec_paint, shot_number, time_per_shot, mult = 1.0):
        index = shot_number % len(rec_paint)
        self._total_perc = 0
        (to_x, to_y), left, right = rec_paint[index]
        if index > 1:
            prev_index = (shot_number - 1) % len(rec_paint)
            to_x = to_x - rec_paint[prev_index][0][0]
            to_y = to_y - rec_paint[prev_index][0][1]
        rand = left - random.random() * (left - right)
        self.to_x = rand + to_x
        self.to_x *= mult
        self.to_y = to_y * mult
        self.x += self.to_x
        self.y += self.to_y
        self.time_per_shot = time_per_shot or 0.01
        self.played = 0
        self._isendfire = False

    def endFire(self):
        self._isendfire = True

    def update(self, dtime):
        self.played += dtime
        if self._isendfire:
            self.x *= 0.9
            self.y *= 0.9

    def getYP(self, dtime):
        perc = dtime / self.time_per_shot
        if self._total_perc + perc >= 1.0:
            perc = 1.0 - self._total_perc
        self._total_perc += perc
        return (self.to_x * perc, self.to_y * perc)

    def getAccumYP(self):
        return (self.x, self.y)


def calc_recoil(cur_val, v0, v1, minV, maxV):
    diff = random.uniform(v0, v1)
    cur_val = clamp(cur_val, minV, maxV)
    new_val = cur_val + diff
    return new_val


class GunNode():

    def __init__(self, player, tickFromPython):
        self.tickFromPython = tickFromPython
        self.gunnodeInfo = player.gunnodeInfo
        self.player = player
        self._onfire_time = 0
        self._spread_fire_time = 0
        self._sft_id = 0
        self._cache = None
        self._last_prev_lookAtWS = None
        self._last_lookAtWS = None
        self._debug_show_recoil = False
        self._bl_ang_vel = tmp_blends.HalfBlend(0.09)
        self._bl_ang_ac = tmp_blends.HalfBlend(0.09)
        self._rec_paint_back = 1.0
        self._rec_paint_incombat_on = False
        if self.tickFromPython:
            self._param_spread_ypr_gun_speed = PercentBlendVec3(0.1)
            self._param_spread_ypr_gun = PercentBlendVec3(0.1)
            self._spread_YPR_counter = Vector3(0, 0, 0)
            self._recoil_pos_power = tmp_blends.AcceleratedBlendCls()
            self._rec_paint = RecoilRotator()
            self._add_recoil = Vector3(0, 0, 0)
            self._wepon_to_0_coef = tmp_blends.LinearBlend(step=15.0)
            self._bl_coll = tmp_blends.AcceleratedBlendCls(0.5, 0.1)
            self._bl_coll.setCurrentValue(MAX_DIST_COLLIDE)
            self._bl_lookCam = tmp_blends.HalfBlend(0.09)
        self._recoil_circle = tmp_blends.LinearBlend(step=0.01)
        self._diff_sig_pos = None
        self._sight_to_camera_coef = 0
        self.updateSpread()
        return

    def destroy(self):
        if self.gunnodeInfo:
            self.gunnodeInfo.pDebugTick = None
            self.gunnodeInfo.pCallBackTestPython = None
        self.player = None
        self.gunnodeInfo = None
        self._cache = None
        if getattr(self, '_sft_id2', 0):
            BigWorld.cancelCallback(self._sft_id2)
        return

    _endfire = True

    def endBurstWeapon(self):
        self._endfire = True
        if not self.player:
            return
        tr_param, tr_param_override = self.player.getRecoilAndSpreadParam()
        if self.tickFromPython:
            self._rec_paint.endFire()
        else:
            self.gunnodeInfo.recoil_rotate_accelerationStep = 0.7

    def onWeaponSniping(self, is_sniping):
        if not is_sniping:
            self.pitch_comp = 0.0

    def onChangeScopeModel(self):
        pass

    def onFire(self, isBrust = False, launcher = None, shot_number = 1, time_per_shot = 0):
        tr_param, tr_param_override = self.player.getRecoilAndSpreadParam()
        weapon_param = self.player.getActiveWeaponParam()
        if launcher and tr_param_override:
            tr_param = tr_param_override
        recoil_pos_mul, recoil_rot_mul, recoil_speed_mul = recoil_and_spread_table.getRecoilGunCoef(self.player)
        self._rec_paint_back = tr_param.get('rec_paint_back', 1.0)
        self._rec_paint_incombat_on = tr_param.get('rec_paint_incombat_on', False)
        if self.tickFromPython:
            self._add_recoil = recoil_pos_mul * Vector3(random.uniform(*tr_param['recoil_pos_gun_z']), random.uniform(*tr_param['recoil_pos_gun_y']), random.uniform(*tr_param['recoil_pos_gun_x']))
            self._recoil_pos_power.setCurrentValue(1.0)
            self._recoil_pos_power.setValueTo(0.0)
        else:
            self.gunnodeInfo.add_recoil = recoil_pos_mul * Vector3(random.uniform(*tr_param['recoil_pos_gun_z']), random.uniform(*tr_param['recoil_pos_gun_y']), random.uniform(*tr_param['recoil_pos_gun_x']))
            self.gunnodeInfo.recoil_pos_power_curentValue = 1.0
            self.gunnodeInfo.recoil_pos_power_valueTo = 0.0
        if self.tickFromPython:
            try:
                rec_paint = tr_param['rec_paint']
            except Exception as err:
                weap = self.player.getActiveWeapon()
                print 'ERROR FOR:', self, ' weapon', weap, ' launcher', launcher,
                if launcher and weap:
                    print ' _custom_hilt=', weap._custom_hilt
                print
                raise err

            mult = recoil_rot_mul * weapon_param.get('rec_mult', 1.0)
            self._rec_paint.fire(rec_paint, shot_number, time_per_shot, mult)
            min_circle, max_circle = tr_param.get('recoil_circle', [0.01, 0.1])
            fire_circle = tr_param.get('recoil_fire_circle', 0.02)
            new_value = fire_circle + self._recoil_circle.getCurrentValue()
            self._recoil_circle.setCurrentValue(min(new_value, max_circle))
            self._updateCircleLimits(launcher)
        self._spread_fire_time = BigWorld.time()
        if self._sft_id:
            BigWorld.cancelCallback(self._sft_id)
        self._sft_id = BigWorld.callback(SPREAD_SLEEP_AFTER_FIRE + 0.01, self.updateSpread)
        if getattr(self, '_sft_id2', 0):
            BigWorld.cancelCallback(self._sft_id2)
        self._sft_id2 = BigWorld.callback(time_per_shot + 0.001, self.endBurstWeapon)
        self._endfire = False
        self.updateSpread()

    def _updateCircleLimits(self, launcher = None):
        tr_param, tr_param_override = self.player.getRecoilAndSpreadParam()
        if launcher and tr_param_override:
            tr_param = tr_param_override
        min_circle, max_circle = tr_param.get('recoil_circle', [0.01, 0.1])
        drop_circle = tr_param.get('recoil_drop_circle', 0.1)
        self._recoil_circle.accelerationStep_ = drop_circle
        self._recoil_circle.setValueTo(min_circle)

    def updateSpread(self):
        if not self.player:
            return
        tr_param, tr_param_override = self.player.getRecoilAndSpreadParam()
        spread_mul = recoil_and_spread_table.getSpreadGunCoef(self.player)
        spread_mul_sp = spread_mul
        if BigWorld.time() - self._spread_fire_time < SPREAD_SLEEP_AFTER_FIRE:
            spread_mul_sp = 0.0
        if self.tickFromPython:
            self._param_spread_ypr_gun.setValueTo(spread_mul * Vector3(tr_param.get('spread_ypr_gun', (0, 0, 0))) * 0.001)
            self._param_spread_ypr_gun_speed.setValueTo(spread_mul_sp * Vector3(tr_param.get('spread_ypr_gun_speed', (1, 1, 1))))
        else:
            self.gunnodeInfo.param_spread_ypr_gun_valueTo = spread_mul * Vector3(tr_param.get('spread_ypr_gun', (0, 0, 0))) * 0.001
            self.gunnodeInfo.param_spread_ypr_gun_speed_valueTo = spread_mul * Vector3(tr_param.get('spread_ypr_gun_speed', (1, 1, 1)))

    def debugDrawLines(self):
        if not self._debug_show_recoil:
            return
        sys_point, barrel_point, dir_ = self.player.get_firing_point()
        pos = barrel_point
        main.recoildrawer.clear()
        main.recoildrawer.addLine(pos, pos + dir_ * 100)
        m = Matrix()
        v = Vector3()
        recoil_angle = self.getCurrentRecoilCircle()
        yaw, pitch = dir_.yaw, dir_.pitch
        v.setPitchYaw(recoil_angle, 0)
        for x in xrange(20):
            m.setRotateYPR((yaw, pitch, x * 0.3))
            dir_ = m.applyVector(v)
            main.recoildrawer.addLine(pos, pos + dir_ * 100, (0.5, 1, 0, 1))

    def tick(self, dtime):
        dtime = clamp(dtime, 0.0001, 0.9999)
        spread_speed = self._param_spread_ypr_gun_speed.getCurrentValue()
        self._spread_YPR_counter[0] += dtime * 2.9 * random.uniform(0.9, 1.1) * spread_speed[0]
        self._spread_YPR_counter[1] += dtime * 1.9 * random.uniform(0.9, 1.1) * spread_speed[1]
        self._spread_YPR_counter[2] += dtime * 0.9 * random.uniform(0.9, 1.1) * spread_speed[2]
        if self._spread_YPR_counter[0] > 2 * math.pi:
            self._spread_YPR_counter[0] -= 2 * math.pi
        if self._spread_YPR_counter[1] > 2 * math.pi:
            self._spread_YPR_counter[1] -= 2 * math.pi
        if self._spread_YPR_counter[2] > 2 * math.pi:
            self._spread_YPR_counter[2] -= 2 * math.pi
        self._recoil_pos_power.updateBlend(dtime)
        self._rec_paint.update(dtime)
        self._recoil_circle.updateBlend(dtime)
        self._param_spread_ypr_gun.updateBlend(dtime)
        self._param_spread_ypr_gun_speed.updateBlend(dtime)
        if self.player.isFPSmode() and self.player.IsAvatarSniping() and not self.player._is_weapon_collide and not self.player._disable_camera_aimtoweapon:
            if self._diff_sig_pos is None:
                self._diff_sig_pos = Vector3(self.player.active_weapon.getDefaultSightOffset())
            else:
                new_diff = self.player.active_weapon.getDefaultSightOffset()
                self._diff_sig_pos = self._diff_sig_pos + (new_diff - self._diff_sig_pos) * 0.2
            self._sight_to_camera_coef += 5 * dtime
        else:
            self._sight_to_camera_coef -= 4 * dtime
        self._sight_to_camera_coef = clamp(self._sight_to_camera_coef)
        self._wepon_to_0_coef.setValueTo(0.999 if self._sight_to_camera_coef > 0.999 else 0.0)
        self.updateInertion(dtime)
        self._bl_coll.updateBlend(dtime)
        self._wepon_to_0_coef.updateBlend(dtime)
        self._bl_lookCam.updateBlend(dtime)
        if self.player.lookingaround or self.player._inAir or self._sight_to_camera_coef > 0:
            self._bl_lookCam.setValueTo(0.0)
        else:
            self._bl_lookCam.setValueTo(1.0)
        self.applyRecoilDcursor(dtime)
        return

    __mouse_dx = 0
    __mouse_speed = 0

    def handleMouseEvent(self, event):
        self.__mouse_dx += abs(event.dx) + abs(event.dy)

    _bl_2d_vel = None
    _bl_2d_ac = None
    _itenrt = None
    _itenrt_blend = None
    _inert_res_vector = None
    weapon_motion_sens = 0.01

    def updateInertion(self, dtime):
        self.__mouse_speed = self.__mouse_dx / dtime
        self.__mouse_dx = 0
        self._tmp_cold_value = self._tmp_cold_value - dtime * 5
        if self._tmp_cold_value < 0:
            self._tmp_cold_value = 0
        self._tmp_cold_enable = clamp(self._tmp_cold_enable + 4.5 * dtime, 0, 1)
        if not self._bl_2d_vel:
            self._bl_2d_vel = PercentBlendVec3(0.1)
            self._bl_2d_vel_old = PercentBlendVec3(0.05)
            self._bl_2d_ac = IntertionBlendVec3_v2(0.1)
        if self._last_lookAtWS and self._last_prev_lookAtWS:
            MAX_SPEED = 50.0
            MIN_SPEED = 2.7
            d_yaw = self._last_prev_lookAtWS.yaw - self._last_lookAtWS.yaw
            if d_yaw > math.pi:
                d_yaw = d_yaw - math.pi * 2
            if d_yaw < -math.pi:
                d_yaw = d_yaw + math.pi * 2
            d_pitch = self._last_prev_lookAtWS.pitch - self._last_lookAtWS.pitch
            self._bl_2d_vel_old.setValueTo(Vector3(clamp(d_yaw, -0.5, 0.5), 0, 0))
            d_yaw = clamp(d_yaw / dtime, -MAX_SPEED, MAX_SPEED)
            d_pitch = clamp(d_pitch / dtime, -MAX_SPEED, MAX_SPEED)
            if abs(d_yaw) < MIN_SPEED:
                d_yaw = 0.0
            if abs(d_pitch) < MIN_SPEED:
                d_pitch = 0.0
            self._bl_2d_vel.setValueTo(Vector3(d_yaw, d_pitch, 0))
            self._bl_2d_vel.updateBlend(dtime)
            self._bl_2d_vel_old.updateBlend(dtime)
            acc = Vector3(d_yaw, d_pitch, 0) - self._bl_2d_vel.getCurrentValue() * -0.01
            prev_acc = self._bl_2d_ac.getCurrentValue()

            def is_protivop(a, b):
                if a > 0 and b < 0:
                    return True
                if a < 0 and b > 0:
                    return True
                return False

            if abs(acc.length) > prev_acc.length:
                self._bl_2d_ac.accelerationStep_ = 0.1
            else:
                self._bl_2d_ac.accelerationStep_ = 0.07
            self._bl_2d_ac.inertinon_mode = self.__mouse_speed < 100.0
            self._bl_2d_ac.setValueTo(acc)
            self._bl_2d_ac.updateBlend(dtime)
            self._inert_res_vector = self._bl_2d_ac.getCurrentValue() * self.weapon_motion_sens * 0.01
            self._inert_res_vector.x = clamp(self._inert_res_vector.x, -0.25, 0.25)
            self._inert_res_vector.y = clamp(self._inert_res_vector.y, -0.2, 0.2)
            self._inert_res_vector.y += abs(self._inert_res_vector.x) * 0.1
            self._inert_res_vector.z = clamp(self._inert_res_vector.x, -0.25, 0.25)
            self._inert_res_vector.z *= -2.5
            self.player._pygunRWnode.inertion_val = self._inert_res_vector * -2.0
        self._last_prev_lookAtWS = self._last_lookAtWS

    def _apply_inertion(self, new_matr):
        if self._inert_res_vector:
            m_acc = Matrix()
            acc = Vector3(self._inert_res_vector)
            acc.x = clamp(acc.x, -0.5, 0.5)
            acc.y = clamp(acc.y, -0.5, 0.5)
            m_acc.setRotateYPR(acc)
            new_matr.preMultiply(m_acc)
        return new_matr

    def _get_collide_pos(self, sys_pos):
        cam = BigWorld.camera()
        cam_dir = cam.direction
        l_sys = sys_pos - cam.position
        dot = l_sys.dot(cam_dir)
        weapon_depth = 0.4
        cam_pos = cam_pos_orig = cam.position + cam_dir * (weapon_depth + dot)
        cam_pos_p = cam.position + cam_dir * 0.1
        if BigWorld.collidePortal(cam_pos_p, cam_pos):
            cam_pos = cam_pos_p
        end_pos = cam_pos + cam_dir * MAX_DIST_COLLIDE
        res = BigWorld.naturalCollideIgnoreFlags(cam_pos, end_pos, PORTALS_DEPTH_COLLIDE, IGNORE_MATERIAL)
        if res and res[0]:
            end_pos = res[-1]
        detect_collider = BigWorld.traceBullet(cam_pos, end_pos, self.player.id)
        if detect_collider:
            end_pos = detect_collider[1]
        dist = end_pos.distTo(cam_pos_orig)
        return (cam_pos_orig, cam_dir, dist)

    def _calcFixlookDir(self, worldPrimary):
        source_pos = worldPrimary.translation
        cam_pos, cam_dir, dist = self._get_collide_pos(source_pos)
        self._bl_coll.setValueTo(dist)
        end_point = cam_pos + cam_dir * self._bl_coll.getCurrentValue()
        aimsys = Matrix(self.player.active_weapon_model.node('HP_AIMSYS'))
        wgunr = Matrix(self.player.active_weapon_model.node('HP_GUNR'))
        sys_pos = aimsys.translation
        inv_wgunr = Matrix(wgunr)
        inv_wgunr.invert()
        offset_pos = inv_wgunr.applyPoint(sys_pos)
        offset_pos[2] = 0
        fix_source_pos = worldPrimary.applyPoint(offset_pos)
        newlookAt = end_point - fix_source_pos
        newlookAt.normalise()
        return newlookAt

    def _applyLimits(self, lookAtWS, worldLimitNode):
        invNode = Matrix(worldLimitNode)
        invNode.invert()
        lookAtLS = invNode.applyVector(lookAtWS)
        pitch = lookAtLS.pitch
        yaw = lookAtLS.yaw
        if yaw < self.gunnodeInfo.minYawReal:
            yaw = self.gunnodeInfo.minYawReal
        if yaw > self.gunnodeInfo.maxYawReal:
            yaw = self.gunnodeInfo.maxYawReal
        if pitch < self.gunnodeInfo.minPitchReal:
            pitch = self.gunnodeInfo.minPitchReal
        if pitch > self.gunnodeInfo.maxPitchReal:
            pitch = self.gunnodeInfo.maxPitchReal
        lookAtLS.setPitchYaw(pitch, yaw)
        return worldLimitNode.applyVector(lookAtLS)

    def addSpineRotation(self, lookAtWS):
        add_torso_yaw = 0
        original_m = Matrix(self.player.torsoProvider_entity)
        original_m.invert()
        diff_vector = original_m.applyVector(lookAtWS)
        add_torso_yaw = clamp(diff_vector.yaw, -MAX_DIFF_YAW, MAX_DIFF_YAW)
        self.player.torso_nodeinfo.addYawSecondary = add_torso_yaw

    def onDcursorMove(self, dYaw, dPitch):
        if self._endfire:
            return
        if self.player.lookingaround:
            return
        self.pitch_comp -= abs(dPitch)
        self.pitch_comp = max(0, self.pitch_comp)

    def getCurrentRecoilYPR(self):
        if self.tickFromPython:
            ry, rp = self._rec_paint.getAccumYP()
            return Vector3(ry, rp, 0)
        else:
            return self.player.test_nodeInfo_gunrw.recoilRotateCurentValue

    def getCurrentRecoilCircle(self):
        recoil_pos_mul, recoil_rot_mul, recoil_speed_mul = recoil_and_spread_table.getRecoilGunCoef(self.player)
        return recoil_rot_mul * self._recoil_circle.getCurrentValue()

    pitch_comp = 0

    def applyRecoilDcursor(self, dtime):
        if not self.player.isFPSmode() and not self._rec_paint_incombat_on:
            return
        d = BigWorld.dcursor()
        current_pitch = d.pitch
        current_yaw = d.yaw
        if self.player.lookingaround:
            if self.player.in_transport:
                current_pitch = self.player.last_pitch
                current_yaw = self.player.last_yaw
            elif hasattr(self.player.filter, 'headPitch'):
                current_pitch = self.player.filter.headPitch
                current_yaw = self.player.filter.headYaw
        ry = 0
        if not self._endfire:
            ry, rp = self._rec_paint.getYP(dtime)
            if rp < 0:
                max_rp = d.minPitch - current_pitch
                if max_rp > rp:
                    rp = max_rp
            pitch = current_pitch + rp
            self.pitch_comp -= rp * self._rec_paint_back
        else:
            prev_pitch_comp = self.pitch_comp
            self.pitch_comp *= 0.99
            pitch = current_pitch + prev_pitch_comp - self.pitch_comp
        pitch = clamp(pitch, d.minPitch, d.maxPitch)
        if self.player.lookingaround:
            if self.player.in_transport:
                pass
            elif hasattr(self.player.filter, 'headPitch'):
                self.player.filter.headPitch = pitch
                self.player.filter.headYaw = ry + current_yaw
        else:
            d.pitch = pitch
            d.yaw = ry + current_yaw

    def smootClearinaccuracy(self):
        if self.player.AvatarCam.inaccuracyProvider:
            val = self.player.AvatarCam.inaccuracyProvider.value
            self.player.AvatarCam.inaccuracyProvider.value = val * 0.8

    def lookAt(self, lookAtWS, dirInWS, localPrimary, camPrimary, worldPrimary, localLimitNode, camLimitNod, worldLimitNode):
        if self.player.active_weapon_model and not self.player.heli_weapon:
            lookfix = self._calcFixlookDir(worldPrimary)
        else:
            lookfix = lookAtWS
        lookAtWS = math_bw.direction_slerp(lookAtWS, lookfix, self._bl_lookCam.getCurrentValue())
        lookAtWS = self._applyLimits(lookAtWS, worldLimitNode)
        self.addSpineRotation(lookAtWS)
        self._last_lookAtWS = Vector3(lookAtWS)
        parentCS = Matrix(localPrimary)
        parentCS.invert()
        parentCS.postMultiply(camPrimary)
        angle = math.acos(max(-1, min(1, lookAtWS.dot(dirInWS))))
        c_axis = dirInWS.crossProduct(lookAtWS)
        inverse_prim = Matrix(camPrimary)
        inverse_prim.invert()
        axis_ls = inverse_prim.applyVector(c_axis)
        q = Math.Quaternion()
        q.fromAngleAxis(angle, axis_ls)
        mq = Matrix()
        mq.setRotateQuat(q)
        new_matr = Matrix(localPrimary)
        new_matr.preMultiply(mq)
        if self.player.isFPSmode():
            spread_power = self.player._view_bunocular_activate and not self.player.binocularDevice and self._param_spread_ypr_gun.getCurrentValue()
            spr_y = math.sin(self._spread_YPR_counter[0]) * spread_power[0]
            spr_p = math.sin(self._spread_YPR_counter[1]) * spread_power[1]
            spr_r = math.sin(self._spread_YPR_counter[2]) * spread_power[2]
            self.player.AvatarCam.inaccuracyProvider = Vector4(spr_y, spr_p, spr_r, 0.0)
        else:
            self.smootClearinaccuracy()
        new_matr = self._apply_fps_mode(new_matr, parentCS)
        new_matr = self._apply_inertion(new_matr)
        self._apply_cold(new_matr)
        add_recoil = Matrix()
        currentRecoilPos = self._add_recoil * self._recoil_pos_power.getCurrentValue()
        add_recoil.setTranslate(currentRecoilPos)
        new_matr.preMultiply(add_recoil)
        self._cache = Matrix(new_matr)
        self.debugDrawLines()
        return new_matr

    _tmp_cold_value = 0.0
    _tmp_cold_enable = 0

    def _apply_cold(self, new_matr):
        if self._tmp_cold_value < 0.01:
            return
        cold_matr = Matrix()
        v = math.sin(self._tmp_cold_value * 0.2) * 0.0005 * self._tmp_cold_enable
        cold_matr.setTranslate((2 * v * math.sin(self._tmp_cold_value * 6), v * math.cos(self._tmp_cold_value * 6.6), 0))
        cold_matr_rot = Matrix()
        cold_matr_rot.setRotateYPR((v * 15, 2 * v, 0))
        new_matr.preMultiply(cold_matr_rot)
        new_matr.preMultiply(cold_matr)

    def shivering_cold(self):
        self._tmp_cold_value = math.pi * 2
        self._tmp_cold_enable = 0

    def _getCameraPosFromCamSpace(self):
        b_factor_current = 0
        if self.player._cam_fps_offset:
            b_factor_current = self.player._cam_fps_offset.b_factor_current
        if self.player.isFPSmode() and (self.player.AvatarCam.weaponModeFactor > 0.98 or b_factor_current > 0.98):
            return Vector3(0, 0, 0)
        if self.player._wt_neck_aim:
            m = Matrix(self.player._wt_neck_aim)
            calc_view = Matrix()
            pos = m.translation - self.player.AvatarCam.position
            calc_view.lookAt(pos, self.player.AvatarCam.direction, self.player.AvatarCam.uprightDirection)
            if self.player._cam_fps_offset:
                aim_offset = self.player._cam_fps_offset.b
                calc_view.postMultiply(aim_offset)
            calc_view.invert()
            res = calc_view.translation
            return res
        return Vector3(0, 0, 0)

    def _apply_fps_mode(self, new_matr, parentWS):
        if self._sight_to_camera_coef <= 1e-06:
            return new_matr
        if not self._diff_sig_pos:
            return new_matr
        new_world0 = Matrix(parentWS)
        new_world0.preMultiply(new_matr)
        diff_pos = self._diff_sig_pos
        if self.player.test_nodeInfo_gunrw:
            diff_pos = self._diff_sig_pos + self.player.test_nodeInfo_gunrw.vecAddPosGunBlended
        cam_pos = self._getCameraPosFromCamSpace()
        s_pos = new_world0.applyPoint(diff_pos)
        need_to_cam = cam_pos - s_pos
        dist_cam = need_to_cam.length
        if dist_cam > 3.5:
            need_to_cam = Vector3(0, 0, 0)
            dist_cam = 0
        inverse_prim = Matrix(parentWS)
        inverse_prim.preMultiply(new_matr)
        inverse_prim.invert()
        dir_ = inverse_prim.applyVector(need_to_cam)
        dir_.normalise()
        add_aim = Matrix()
        add_aim.setTranslate(dir_ * (dist_cam * self._wepon_to_0_coef.getCurrentValue()))
        new_matr.preMultiply(add_aim)
        return new_matr


def init(player):
    if getattr(player, '_pygunnode', None):
        player._pygunnode.destroy()
        player._pygunnode = None
    if getattr(player, '_pygunRWnode', None):
        player._pygunRWnode.destroy()
        player._pygunRWnode = None
    if not player.gunnodeInfo:
        return
    elif not player.test_nodeInfo_gunrw:
        return
    else:
        if player.gunnodeInfo:
            player.gunnodeInfo.pCallBackTestPython = None
            player.test_nodeInfo_gunrw.pDebugTick = None
        if player.test_nodeInfo_gunrw:
            player.test_nodeInfo_gunrw.pDebugLookAt = None
        if not player.gunnodeInfo:
            return
        elif not player.test_nodeInfo_gunrw:
            return
        tickFromPython = player == BigWorld.player()
        import tmp_weapon_node_gunrw
        player._pygunnode = GunNode(player, tickFromPython)
        player._pygunRWnode = tmp_weapon_node_gunrw.WeaponGunRWmover(player, tickFromPython)
        player._pygunnode._updateCircleLimits()
        if tickFromPython:
            player.test_nodeInfo_gunrw.pDebugTick = player._pygunRWnode.tick
            player.test_nodeInfo_gunrw.pDebugLookAt = player._pygunRWnode.lookAt
            player.gunnodeInfo.pDebugTick = player._pygunnode.tick
            player.gunnodeInfo.pCallBackTestPython = player._pygunnode.lookAt
        return