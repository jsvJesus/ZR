class TemporaryFlag(object):
    """
    \xd0\x92\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd1\x82\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0, \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9
    \xd0\xb2 \xd0\xba\xd0\xb0\xd0\xba\xd0\xb8\xd1\x85 \xd1\x82\xd0\xbe\xd1\x87\xd0\xba\xd0\xb0\xd1\x85 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xba\xd1\x83\xd0\xbf\xd0\xb8\xd1\x82\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3.
    """

    def __init__(self, unique_str_id, position, name, base_name):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        self.unique_str_id = unique_str_id
        self.name = name
        self.base_name = base_name
        self.flag_model_path = 'models/misc/signs/flag_anim.model'
        self.model = BigWorld.Model(self.flag_model_path)
        self.model.position = position
        self._pending_mode = None
        self._demonstration_mode = None
        self._current_mode = None
        text = lc('BaseToCapture.FLAG_ON_BOUGHT') % self.name
        return

    @property
    def demonstration_mode(self):
        """\xd0\xa0\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc \xd0\xbe\xd0\xb6\xd0\xb8\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8."""
        return self._demonstration_mode

    @demonstration_mode.setter
    def demonstration_mode(self, value):
        if value:
            self.model.phong1 = 'grey_flagpole'
            self.model.pasted__lambert43_skinned = 'grey_flag'
        else:
            self.model.phong1 = 'Default'
            self.model.pasted__lambert43_skinned = 'Default'
        self._demonstration_mode = value
        self._pending_mode = False

    @property
    def pending_mode(self):
        """\xd0\xa0\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc \xd0\xbe\xd0\xb6\xd0\xb8\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8."""
        return self._pending_mode

    @pending_mode.setter
    def pending_mode(self, value):
        if value:
            self.model.phong1 = 'pending_flagpole'
            self.model.pasted__lambert43_skinned = 'pending_flag'
        else:
            self.model.phong1 = 'Default'
            self.model.pasted__lambert43_skinned = 'Default'
        self._demonstration_mode = False

    def show_in_world(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2 \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xbc \xd0\xbc\xd0\xb8\xd1\x80\xd0\xb5."""
        player = BigWorld.player()
        BigWorld.addModel(self.model)

    def buy(self):
        """\xd0\x9a\xd1\x83\xd0\xbf\xd0\xb8\xd1\x82\xd1\x8c \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3."""
        self.pending_mode = True
        player = BigWorld.player()
        player.buy_flag(self.base_name, self.unique_str_id)

    def disactive(self):
        """\xd0\xa3\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0."""
        try:
            BigWorld.delModel(self.model)
        except BigWorld.EntityIsDestroyedException:
            import traceback
            traceback.print_exc()


class TempFlagManager(object):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x83\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc\xd0\xb8 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0\xd0\xbc\xd0\xb8 \xd0\xb2\xd0\xbe \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xb2."""

    def __init__(self, base_name, flags_on_create):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        self.base_name = base_name
        self._temp_flags = {}
        self._flag_name_to_unique_str_id = {}
        self._unique_str_id_to_flag_name = {}
        self.create_temp_flags(flags_on_create)

    def create_temp_flags(self, flags_on_create):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb8."""
        for unique_str_id, flag_data in flags_on_create.items():
            position = flag_data['position']
            flag_name = flag_data['name']
            temp_flag = TemporaryFlag(unique_str_id, position, flag_name, self.base_name)
            self._temp_flags[unique_str_id] = temp_flag
            self._flag_name_to_unique_str_id[flag_name] = unique_str_id

    def show_temp_flags(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb8."""
        for temp_flag in self._temp_flags.values():
            temp_flag.demonstration_mode = True
            temp_flag.show_in_world()

    def hide_bought_flag(self, unique_str_id):
        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xba\xd1\x83\xd0\xbf\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3."""
        print 'hide_bought_flag', self, unique_str_id, self._temp_flags[unique_str_id]
        self._temp_flags[unique_str_id].disactive()
        del self._temp_flags[unique_str_id]

    def hide_all_flags(self):
        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xb2\xd1\x81\xd0\xb5 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb8."""
        for temp_flag in self._temp_flags.values():
            temp_flag.disactive()

        self._temp_flags.clear()

    def buy_flag(self, name):
        """\xd0\x9a\xd1\x83\xd0\xbf\xd0\xb8\xd1\x82\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3 \xd1\x81 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbc name."""
        unique_str_id = self._flag_name_to_unique_str_id[name]
        temp_flag = self._temp_flags[unique_str_id]
        temp_flag.buy()

    def on_buy_flag(self, unique_str_id, success):
        """
        \xd0\x94\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd1\x8f, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb5 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd1\x81\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x88\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5
        \xd1\x83\xd0\xb4\xd0\xb0\xd1\x87\xd0\xbd\xd0\xbe\xd0\xb9/\xd0\xbd\xd0\xb5\xd1\x83\xd0\xb4\xd0\xb0\xd1\x87\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0.
        """
        if success:
            self.hide_bought_flag(unique_str_id)
        else:
            self._temp_flags[unique_str_id].pending_mode = False
            self._temp_flags[unique_str_id].demonstration_mode = True

    def unique_str_id_to_flag_name(self, unique_str_id):
        if not self._unique_str_id_to_flag_name:
            self._unique_str_id_to_flag_name = dict(((v, k) for k, v in self._flag_name_to_unique_str_id.items()))
        return self._unique_str_id_to_flag_name[unique_str_id]