__all__ = ['FlagsInfoStorage']
import time
import traceback
import BigWorld
import BWPersonality
from Localization import lc
from base_to_capture_common.utils import next_capture_time

class FlagData(object):

    def __init__(self, name):
        self.name = name
        self._height = 0
        self._clan_owner = None
        self.clan_invader = None
        self.last_change = 0
        return

    @property
    def is_playeravatar_owner(self):
        """\xd0\x9f\xd1\x80\xd0\xb5\xd0\xbd\xd0\xb0\xd0\xb4\xd0\xbb\xd0\xb5\xd0\xb6\xd0\xb8\xd1\x82 \xd0\xbb\xd0\xb8 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3 \xd0\xba\xd0\xbb\xd0\xb0\xd0\xbd\xd1\x83, \xd0\xb2 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbc \xd0\xbd\xd0\xb0\xd1\x85\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f \xd0\xbf\xd0\xbb\xd1\x8d\xd0\xb9\xd0\xb5\xd1\x80\xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80."""
        player = BigWorld.player()
        if not player:
            return 0
        return player.clanName == self.clan_owner

    @property
    def is_playeravatar_invader(self):
        player = BigWorld.player()
        if not player:
            return 0
        if self.clan_invader:
            return player.clanID == self.clan_invader
        return self.is_playeravatar_owner

    @property
    def height(self):
        return self._height

    @height.setter
    def height(self, value):
        self._height = value
        self.last_change = time.time()

    @property
    def clan_owner(self):
        return self._clan_owner

    @clan_owner.setter
    def clan_owner(self, value):
        self._clan_owner = value


class BaseData(object):

    def __init__(self, name, clan_owner = None, state = None):
        self.name = name
        self.clan_owner = clan_owner
        self.state = state
        self._next_capture_time = 0
        self.entity_id = 0
        self.active_flags = {}
        self._inti_capture_time = 0
        self._cycle_time = 0
        self._time_of_capture = 0
        self._start_capture_time = 0

    def set_init_capture_time(self, inti_capture_time, cycle_time, time_of_capture):
        self._inti_capture_time = inti_capture_time + BWPersonality.gpd.time_diff
        self._cycle_time = cycle_time
        self._time_of_capture = time_of_capture

    @property
    def underatack_end_time(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""
        end_time = self._start_capture_time + self._time_of_capture
        return end_time

    def set_capture_time_start(self, value):
        self._start_capture_time = value

    def set_next_capture_time(self, value):
        self._next_capture_time = value

    @property
    def is_fortification(self):
        return self._time_of_capture < 2700

    @property
    def next_capture_time(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb5 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""
        now = time.time()
        if self._next_capture_time >= now:
            return self._next_capture_time
        if not self._cycle_time:
            return now + 2592000
        under_atack_time = next_capture_time(self._inti_capture_time, self._cycle_time)
        return under_atack_time

    def _get_flag(self, flag_name):
        try:
            flag = self.active_flags[flag_name]
        except KeyError:
            flag = FlagData(flag_name)
            self.active_flags[flag_name] = flag

        return flag

    def get_flag(self, flag_name):
        return self._get_flag(flag_name)

    def get_flags_info(self):
        dct = {}
        for flag in self.active_flags.values():
            dct[flag.name] = {'is_my_flag': flag.is_playeravatar_owner,
             'am_i_invader': flag.is_playeravatar_invader,
             'height': flag.height}

        return dct

    def adjust_flag_data(self, flag_name, height, clan_owner, clan_invader, last_change):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb2\xd1\x88\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5."""
        flag = self._get_flag(flag_name)
        flag.clan_owner = clan_owner
        flag.clan_invader = clan_invader
        if last_change > flag.last_change:
            flag.height = height
        flag.last_change = last_change

    def rewrite_flags_data(self, new_data):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb2\xd1\x88\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5."""
        self.active_flags.clear()
        for flag_data in new_data.values():
            flag = self._get_flag(flag_data['name'])
            flag.clan_owner = flag_data['clan_owner_name']
            flag.clan_invader = flag_data['clan_invader']
            flag.last_change = flag_data['last_change'] + BWPersonality.gpd.time_diff
            flag.height = flag_data['height']

    def set_active_flags(self, flags_names):
        """\xd0\x9f\xd0\xbe\xd0\xb4\xd1\x87\xd0\xb8\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbd\xd0\xb5\xd1\x81\xd1\x83\xd1\x89\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb5 \xd1\x82\xd0\xb5\xd0\xbf\xd0\xb5\xd1\x80\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb8."""
        for flag_name in self.active_flags.keys():
            if flag_name not in flags_names:
                del self.active_flags[flag_name]


class FlagsInfoStorage(object):

    def __init__(self):
        self._data = {}

    def get_base_info(self, base_name):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb8\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbe \xd0\xb1\xd0\xb0\xd0\xb7\xd0\xb5."""
        if base_name not in self._data:
            return {'name': lc('BaseToCaptureNames.%s' % base_name),
             'owner': '-----',
             'state': 1,
             'next_time': 0,
             'flags': {}}
        base = self._data[base_name]
        if base.state == 2:
            next_time = base.underatack_end_time - time.time()
        else:
            next_time = base.next_capture_time - time.time()
        return {'name': lc('BaseToCaptureNames.%s' % base_name),
         'owner': base.clan_owner,
         'state': base.state,
         'next_time': next_time,
         'flags': base.get_flags_info()}

    def _get_base(self, base_name):
        try:
            base = self._data[base_name]
        except KeyError:
            base = BaseData(base_name)
            self._data[base_name] = base

        return base

    def get_flag(self, base_name, flag_name):
        base = self._get_base(base_name)
        return base.get_flag(flag_name)

    def get_base(self, base_name):
        return self._get_base(base_name)

    def remove_base(self, base_name):
        """\xd0\xa3\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb8\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbe \xd0\xb1\xd0\xb0\xd0\xb7\xd0\xb5."""
        try:
            if self._data.has_key(base_name):
                del self._data[base_name]
        except:
            print 'error base_name:', repr(base_name)
            traceback.print_exc()