class MovableMarker(PyGUIBase):
    """\xd0\x9e\xd0\xb1\xd0\xb5\xd1\x80\xd1\x82\xd0\xba\xd0\xb0 \xd0\xb2\xd0\xbe\xd0\xba\xd1\x80\xd1\x83\xd0\xb3 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0, \xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xbe\xd0\xbd \xd0\xbe\xd1\x82\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb6\xd0\xb0\xd0\xbb\xd1\x81\xd1\x8f 
    \xd0\xbd\xd0\xb0 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb5 \xd0\xbf\xd1\x80\xd0\xb8\xd0\xb2\xd1\x8f\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc \xd0\xba \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xbc\xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd1\x86\xd0\xb5."""
    factoryString = 'soGUI.Marker'

    def __init__(self, component, matrix, height):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        PyGUIBase.__init__(self, component)
        component.script = self
        self.matrix = matrix
        self.height = height
        self.alpha = 255.0
        self.clipMP = GUI.WorldToClipMP()
        self.setupMark()
        self.change_h_id = None
        return

    def setupMark(self):
        shader = GUI.MatrixShader()
        shader.eta = 0
        shader.blend = True
        shader.target = self.clipMP
        self.component.addShader(shader, 'mover')
        shift_prov = ShiftProvider(self.matrix, (0, self.height, 0))
        self.clipMP.target = shift_prov

    def fini(self):
        self.clearAllChildren(self.component)
        self.component.delShader('mover')
        self.component.script = None
        self.component = None
        self.clipMP = None
        return

    def change_height(self, new_height, slowly = True):
        """\xd0\x98\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb2\xd1\x8b\xd1\x81\xd0\xbe\xd1\x82\xd1\x83 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb8 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0.
        
        slowly - \xd0\xbf\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xbd\xd0\xbe \xd0\xbe\xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3.
        """

        def change_h(height):
            self.height = height
            shift_prov = ShiftProvider(self.matrix, (0, self.height, 0))
            self.clipMP.target = shift_prov

        if self.change_h_id is not None:
            BigWorld.cancelCallback(self.change_h_id)
        if not slowly:
            change_h(new_height)
            return
        else:
            velocity = 0.05
            coeff = 1 if new_height - self.height > 0 else -1
            stop_condition = lambda curr_h, end_h: (curr_h >= end_h if coeff > 0 else curr_h <= end_h)

            def change_h_loop():
                if stop_condition(self.height, new_height):
                    self.change_h_id = None
                    self.height = new_height
                    shift_prov = ShiftProvider(self.matrix, (0, self.height, 0))
                    self.clipMP.target = shift_prov
                    return
                else:
                    self.height += velocity * coeff
                    shift_prov = ShiftProvider(self.matrix, (0, self.height, 0))
                    self.clipMP.target = shift_prov
                    self.change_h_id = BigWorld.callback(velocity, change_h_loop)
                    return

            if self.change_h_id is not None:
                BigWorld.cancelCallback(self.change_h_id)
            self.change_h_id = BigWorld.callback(0, change_h_loop)
            return


class FlagCaption(object):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd1\x80\xd0\xb5\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb8 \xd0\xba \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0\xd0\xbc \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""

    def __init__(self, flag_matrix, identific, component, mark_action = None, height = 0):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        self.flag_matrix = flag_matrix
        self.identific = identific
        self.component = component
        self.mark_action = mark_action if mark_action is not None else []
        self.height = height
        self.flag_markers_gui = BWPersonality.GUICore.flagMarkersGUI
        self.marker = None
        self.update_limits()
        return

    def attach_inworld_caption(self):
        """\xd0\x94\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd1\x83."""
        if self.marker is None:
            self.marker = MovableMarker(self.component, self.flag_matrix, self.height)
        self.flag_markers_gui.add_inworld_caption(self.identific, self.marker.component)
        self.update_limits()
        return

    def attach_caption_on_buy(self):
        """\xd0\x94\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd1\x83."""
        if self.marker is None:
            self.marker = MovableMarker(self.component, self.flag_matrix, self.height)
        self.flag_markers_gui.add_on_buying_caption(self.identific, self.marker.component)
        return

    def detach_inworld_caption(self):
        """\xd0\xa3\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c \xd1\x83 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0."""
        self.flag_markers_gui.del_inworld_caption(self.identific)

    def detach_caption_on_buy(self):
        """\xd0\xa3\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8 \xd1\x83 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0."""
        self.flag_markers_gui.del_on_buying_caption(self.identific)

    def change_caption(self, component):
        """\xd0\x98\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb8 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0."""
        if self.marker is not None:
            self.marker.fini()
            self.marker = None
        self.component = component
        if self.flag_markers_gui.is_in_inworld_caption(self.identific):
            self.attach_inworld_caption()
        self.update_limits()
        return

    def update_limits(self):
        if self.component and hasattr(self.component, 'mover'):
            self.component.mover.limit_y = True
            self.component.verticalAnchor = 'TOP'

    def change_height(self, height, slowly = True):
        self.height = height
        self.marker.change_height(height, slowly)

    def fini(self):
        if self.marker is not None:
            self.marker.fini()
            self.flag_markers_gui.del_inworld_caption(self.identific)
            self.flag_markers_gui.del_on_buying_caption(self.identific)
            self.marker = None
        return