# Embedded file name: ./client/base_to_capture/flying_camera.py
"""
\xd0\x9c\xd0\xbe\xd0\xb4\xd1\x83\xd0\xbb\xd1\x8c \xd1\x80\xd0\xb5\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd1\x83
\xd0\xbd\xd0\xb0\xd0\xb4 \xd0\xb1\xd0\xb0\xd0\xb7\xd0\xbe\xd0\xb9 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd0\xbc\xd0\xbe\xd1\x82\xd1\x80\xd0\xb0 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xb2 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8.
"""
import functools
import BigWorld
import CameraNode
import Math
import math
import BWPersonality
import UCManager
import StalkerModel
import ResourceLoader
import player_speed_settings

class BaseToCaptureFlyingCam(object):
    """\xd0\x9a\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd0\xb0 \xd0\xbb\xd0\xb5\xd1\x82\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb0\xd1\x8f \xd0\xba \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0\xd0\xbc."""
    MIN_TIME_STEP = 0.1
    VELOCITY = 7
    flag_model_path = 'models/misc/signs/flag_anim.model'
    flag_new_path = 'models/misc/signs/flag/flag.model'

    def __init__(self, base_node_name, camera_points):
        self._base_node_name = base_node_name
        self._camera_points = camera_points
        self._init_cam = None
        self._flying_cam = None
        self._loop_id = None
        self._action_after_stopping = lambda : None
        self._flag_model_out_of_range = None

        def on_load(prereqs):
            self._flag_model_out_of_range = prereqs.produce(0)
            self._new_flag_model = prereqs.produce(1)
            self._flag_model_out_of_range.pasted__lambert43_skinned = 'disable'
            self._flag_model_out_of_range.node('newflag').attach(self._new_flag_model)

        resource_list = ((ResourceLoader.MODEL, self.flag_model_path), (ResourceLoader.MODEL, self.flag_new_path))
        ResourceLoader.asyncLoad(resource_list, on_load)
        BWPersonality.GUICore.targettingGUI.builder_dot(True)

        def camera_nodes_gen():
            for cn in BigWorld.userDataObjects.values():
                if isinstance(cn, CameraNode.CameraNode):
                    yield (cn.name, cn)

        self.camera_nodes = dict(camera_nodes_gen())
        return

    def _move_cam(self, pos_matrix):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd1\x83 \xd0\xb2 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x83\xd1\x8e \xd0\xbc\xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd1\x86\xd1\x83."""
        self._flying_cam.invViewProvider = pos_matrix

    def _set_cam_init_position(self, init_cam):
        """\xd0\x97\xd0\xb0\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x83\xd1\x8e \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbb\xd0\xb5\xd1\x82\xd1\x8f\xd1\x89\xd0\xb5\xd0\xb9 \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b."""
        self._init_cam = init_cam
        self._flying_cam = BigWorld.FreeCamera(init_cam)
        self._flying_cam.invViewProvider = Math.Matrix(init_cam.invViewMatrix)
        BigWorld.camera(self._flying_cam)

    @property
    def current_cam_matrix(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbf\xd0\xb8\xd1\x8e \xd0\xbc\xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd1\x86\xd1\x8b \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b."""
        return Math.Matrix(self._flying_cam.invViewProvider)

    def _get_init_cam_matrix(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbf\xd0\xb8\xd1\x8e \xd0\xbc\xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd1\x86\xd1\x8b \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b."""
        m = Math.Matrix(self._init_cam.invViewMatrix)
        return m

    def _get_matrix_from_node(self, node):
        m = Math.Matrix()
        m.setRotateYPR((node.yaw, node.pitch, node.roll))
        m.translation = node.position
        return m

    def _get_matrix_from_dct(self, dct):
        yaw, pitch, roll = dct['direction']
        m = Math.Matrix()
        m.setRotateYPR((yaw, pitch, roll))
        m.translation = dct['position']
        return m

    def _get_matrix_from_instance(self, instance):
        roll, pitch, yaw = instance.direction
        m = Math.Matrix()
        m.setRotateYPR((yaw, pitch, roll))
        m.translation = instance.position
        return m

    def _get_steps_count(self, start_m, end_m):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbb-\xd0\xb2\xd0\xbe \xd1\x88\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xb2 \xd0\xb2\xd0\xbe \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x91\xd1\x82\xd0\xb0."""
        distance = end_m.translation.distTo(start_m.translation)
        flight_time = distance / self.VELOCITY
        divider = flight_time / self.MIN_TIME_STEP
        steps_count = int(divider) + 1
        return steps_count

    def on_moving_end(self):
        pass

    def on_finish_fly(self):
        pass

    def _run_moving(self, end_m, base_m = None):
        """\xd0\x97\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb4\xd0\xb2\xd0\xb8\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b."""

        def _get_camera_matrix(cam):
            try:
                cam = Math.Matrix(cam)
            except TypeError:
                if hasattr(cam, 'direction') and hasattr(cam, 'position'):
                    cam = self._get_matrix_from_instance(cam)
                elif isinstance(end_m, dict) and 'direction' in cam and 'position' in cam:
                    cam = self._get_matrix_from_dct(cam)
                elif all((hasattr(end_m, attr) for attr in ('yaw', 'pitch', 'roll', 'position'))):
                    cam = self._get_matrix_from_node(cam)
                else:
                    msg = 'Unsupported type {0} for moving'.format(cam.__class__.__name__)
                    raise TypeError(msg)

            return cam

        self._action_after_stopping = None
        if not base_m:
            base_m = self.camera_nodes[self._base_node_name]
        fov = player_speed_settings.FOV.DEFAULT_FOV
        if hasattr(end_m, 'fov'):
            fov = math.radians(getattr(end_m, 'fov'))
        elif isinstance(end_m, dict) and 'fov' in end_m:
            fov = math.radians(end_m['fov'])
        BigWorld.projection().rampFov(fov, 4.0)
        base_m = _get_camera_matrix(base_m)
        end_m = _get_camera_matrix(end_m)
        steps_count = self._get_steps_count(self.current_cam_matrix, end_m)
        points = self.getPointsBezierFlying(self.current_cam_matrix, base_m, end_m)
        if points is None:
            callback = lambda : self._set_cam_position_loop_linear(self.current_cam_matrix, end_m, steps_count, steps_count)
        else:
            callback = functools.partial(self._set_cam_position_loop_Bezier, self.current_cam_matrix, end_m, steps_count, 0, points)
        self._loop_id = BigWorld.callback(0, callback)
        return

    def _get_step(self, v1, v2, divider):
        return (v1 - v2) / divider

    def _set_cam_position_loop_linear(self, init_start_m, end_m, divider, steps_count):
        """\xd0\x9f\xd0\xb5\xd1\x82\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb0\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b."""
        if self._loop_id:
            BigWorld.cancelCallback(self._loop_id)
            self._loop_id = None
        if steps_count == 1:
            self._move_cam(end_m)
            if self._action_after_stopping:
                self._action_after_stopping()
            self._action_after_stopping = lambda : None
            self.on_moving_end()
            return
        else:
            pos_matr = Math.Matrix()
            rot_matr = Math.Matrix()
            start_m = self.current_cam_matrix
            new_pos = start_m.translation + self._get_step(end_m.translation, init_start_m.translation, divider)
            pos_matr.setTranslate(new_pos)
            rot_matr.setRotateYPR((start_m.yaw + self._get_step(end_m.yaw, init_start_m.yaw, divider), start_m.pitch + self._get_step(end_m.pitch, init_start_m.pitch, divider), start_m.roll + self._get_step(end_m.roll, init_start_m.roll, divider)))
            pos_matr.preMultiply(rot_matr)
            self._move_cam(pos_matr)
            steps_count -= 1
            callback = lambda : self._set_cam_position_loop_linear(init_start_m, end_m, divider, steps_count)
            self._loop_id = BigWorld.callback(0, callback)
            return

    def _set_cam_position_loop_Bezier(self, init_start_m, end_m, divider, current_step, points):
        """\xd0\x9f\xd0\xb5\xd1\x82\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb0\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b."""
        if current_step == len(points) - 1:
            self._loop_id = None
            self._move_cam(end_m)
            if self._action_after_stopping:
                self._action_after_stopping()
            self._action_after_stopping = lambda : None
            return
        else:
            pos_matr = Math.Matrix()
            rot_matr = Math.Matrix()
            start_m = self.current_cam_matrix
            new_pos = points[current_step]
            pos_matr.setTranslate(new_pos)
            rot_matr.setRotateYPR((start_m.yaw + self._get_step(end_m.yaw, init_start_m.yaw, len(points)), start_m.pitch + self._get_step(end_m.pitch, init_start_m.pitch, len(points)), start_m.roll + self._get_step(end_m.roll, init_start_m.roll, len(points))))
            pos_matr.preMultiply(rot_matr)
            self._move_cam(pos_matr)
            current_step += 1
            callback = functools.partial(self._set_cam_position_loop_Bezier, init_start_m, end_m, divider, current_step, points)
            self._loop_id = BigWorld.callback(0, callback)
            return

    def emergency_stop(self):
        """\xd0\x90\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb8\xd0\xb9\xd0\xbd\xd0\xb0\xd1\x8f \xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x91\xd1\x82\xd0\xb0."""
        if self._loop_id:
            BigWorld.cancelCallback(self._loop_id)
            self._loop_id = None
        player = BigWorld.player()
        player.flag_demonstr_cam = False
        player.moving_locked = False
        BigWorld.camera(self._init_cam)
        self.del_flag_model()
        self._init_cam = None
        self._action_after_stopping = lambda : None
        BigWorld.target.source = BigWorld.camera().invViewMatrix
        BigWorld.projection().rampFov(player_speed_settings.FOV.DEFAULT_FOV, 1.0)
        BWPersonality.GUICore.targettingGUI.builder_dot(False)
        self.on_finish_fly()
        return

    def come_back_to_earth(self, with_center = True):
        """\xd0\x92\xd0\xb5\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xb2 \xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd1\x83\xd1\x8e \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbd\xd0\xb0 \xd0\xb7\xd0\xb5\xd0\xbc\xd0\xbb\xd0\xb5."""
        if self._loop_id:
            BigWorld.cancelCallback(self._loop_id)
            self._loop_id = None
        center_point = None if with_center else self._get_init_cam_matrix()
        self._run_moving(self._get_init_cam_matrix(), center_point)
        self._action_after_stopping = self.emergency_stop
        self.del_flag_model()
        return

    def take_wing(self):
        """\xd0\x92\xd0\xb7\xd0\xbb\xd0\xb5\xd0\xbb\xd0\xb5\xd1\x82\xd1\x8c \xd0\xbd\xd0\xb0\xd0\xb4 \xd0\xb7\xd0\xb5\xd0\xbc\xd0\xbb\xd0\xb5\xd0\xb9 \xd0\xb2 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x83\xd1\x8e \xd1\x82\xd0\xbe\xd1\x87\xd0\xba\xd1\x83."""
        if self._loop_id:
            BigWorld.cancelCallback(self._loop_id)
            self._loop_id = None
        if self._init_cam is None:
            self._set_cam_init_position(BigWorld.camera())
        player = BigWorld.player()
        player.flag_demonstr_cam = True
        player.moving_locked = True
        self._run_moving(self.camera_nodes[self._base_node_name])
        return

    def go_to_main_plan(self):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xbd\xd0\xb0 \xd0\xbe\xd1\x81\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbb\xd0\xb0\xd0\xbd."""
        self.del_flag_model()
        if self._loop_id:
            BigWorld.cancelCallback(self._loop_id)
            self._loop_id = None
        self._run_moving(self.camera_nodes[self._base_node_name])
        return

    def go_to_next_camera_point(self, name, flag_data = None, with_center = True):
        """
        \xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xb2 \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd0\xbc\xd0\xbe\xd1\x82\xd1\x80\xd0\xb0 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0 \xd1\x81 
        \xd1\x83\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xbc \xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbc unique_str_id.
        """
        self.del_flag_model()
        if flag_data:
            type_active, flag_id, flag_pos = flag_data
            flag = BigWorld.entities.get(flag_id, None)
            if not flag and type_active and self._flag_model_out_of_range and self._new_flag_model:
                self._flag_model_out_of_range.position = flag_pos
                BigWorld.addModel(self._flag_model_out_of_range)
                self._flag_model_out_of_range.pasted__lambert43_skinned = 'disable'
                self._flag_model_out_of_range.RaiseBC(0, None, 1, 599, 599, 1)
                self._new_flag_model.visible = True
                self._new_flag_model.flag_color = 'blue'
                self._new_flag_model.Wave()
                self.load_clan_emblem()
        if self._loop_id:
            BigWorld.cancelCallback(self._loop_id)
            self._loop_id = None
        next_point = self._camera_points[name]
        if not with_center:
            self._run_moving(next_point, next_point)
        else:
            self._run_moving(next_point)
        return

    def del_flag_model(self):
        if self._flag_model_out_of_range and self._flag_model_out_of_range in BigWorld.models():
            BigWorld.delModel(self._flag_model_out_of_range)

    def _drawIcon(self, imgID = 0, feedName = '', texture = None):
        if not self._new_flag_model:
            return
        else:
            if imgID and texture:
                StalkerModel.setFeed(self._new_flag_model, None, 'flag_color', feedName, texture)
            else:
                StalkerModel.setFeed(self._new_flag_model, None, 'flag_color', 'feed_disabled', texture)
            return

    def load_clan_emblem(self):
        player = BigWorld.player()
        if player.clanEmblemID:
            UCManager.ucmanager.loadImg(player.clanEmblemID, self._drawIcon)
        else:
            self._drawIcon(0)

    def getPointsBezierFlying(self, init_start_m, main_m, end_m):
        nodes = []
        nodes.append(init_start_m.translation)
        nodes.append(main_m.translation)
        nodes.append(end_m.translation)
        A = nodes[0][1] * (nodes[1][2] - nodes[2][2]) + nodes[1][1] * (nodes[2][2] - nodes[0][2]) + nodes[2][1] * (nodes[0][2] - nodes[1][2])
        B = nodes[0][2] * (nodes[1][0] - nodes[2][0]) + nodes[1][2] * (nodes[2][0] - nodes[0][0]) + nodes[2][2] * (nodes[0][0] - nodes[1][0])
        C = nodes[0][0] * (nodes[1][1] - nodes[2][1]) + nodes[1][0] * (nodes[2][1] - nodes[0][1]) + nodes[2][0] * (nodes[0][1] - nodes[1][1])
        D = nodes[0][0] * (nodes[1][1] * nodes[2][2] - nodes[2][1] * nodes[1][2]) + nodes[1][0] * (nodes[2][1] * nodes[0][2] - nodes[0][1] * nodes[2][2]) + nodes[2][0] * (nodes[0][1] * nodes[1][2] - nodes[1][1] * nodes[0][2])
        if A == B == C == D == 0:
            return None
        else:

            def F(x, z):
                if B == 0:
                    return 0
                return (D - C * z - A * x) / B

            def getBezierBasis(num, count, t):

                def fac(n):
                    if n == 0:
                        return 1
                    return fac(n - 1) * n

                return fac(count) / (fac(num) * fac(count - num)) * t ** num * (1 - t) ** (count - num)

            def getBezierCurve(arr, steps = 0.01):
                res = []
                t = 0
                while t < 1 + steps:
                    if t > 1:
                        t = 1
                    X = 0
                    Z = 0
                    for i in xrange(0, len(arr)):
                        b = getBezierBasis(i, len(arr) - 1, t)
                        X += arr[i][0] * b
                        Z += arr[i][2] * b

                    res.append(Math.Vector3(X, F(X, Z), Z))
                    t += steps

                return res

            points = getBezierCurve(nodes, self.MIN_TIME_STEP / 20)
            return points