    def suggest_spare_item(self, item):

        def number_check(newStr, wholeText, offset):
            full_text = wholeText[0:offset] + newStr + wholeText[offset:]
            if not full_text.isdigit():
                return False
            if wholeText:
                if 0 < int(full_text) < ItemsUtils.GetItemNumber(item):
                    return True
                return False
            return True

        self.context_menu_item = item
        msgbox_templates.input_box_ok_cancel(MESSAGEBOX.MSG_ID_CACHE_SPARE, lc('Inventory.client.DIVIDE_PROCESS'), lc('Inventory.client.HOW_MUCH_ITEMS_DEVIDE'), callback=self.SpareCalback, default='1', input_validator=number_check)

