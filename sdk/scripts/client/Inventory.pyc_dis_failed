        param = ItemsCatalog.GetItemParam(item_type)
        item_class = ItemsCatalog.GetItemClass(item_type)
        item_category = ItemsCatalog.GetItemCategory(item_type)
        inc_item = ItemsUtils.GetComplexItemInconstanParams(item)
        if not ItemsUtils.IsItemFixed(item):
            returning_list[ItemsCatalog.CAN_DROP] = lc('Inventory.client.DROP')
        if param.get('disassemblesTo', None):
            returning_list[ItemsCatalog.CAN_DISASSEMBLE] = lc('Inventory.client.CAN_DISASSEMBLE')
        if item_class in [ItemsCatalog.WEAPON, ItemsCatalog.CLOTH]:
            if not ItemsUtils.IsQuestBlock(item, inc_item):
                if item_category != IC.CLOTH_ATTACH:
                    returning_list[ItemsCatalog.CAN_PUT_ON] = lc(param.get('SlotEquipName', 'Inventory.client.EQUIP'))
                if param.get('GasMaskFilterClass') and inc_item.get(ItemsCatalog.INC_GASMASK_FILTER_TYPE):
                    returning_list['DETACH_GASMASK_FILTER'] = lc('Inventory.client.DETACH_GASMASK_FILTER')
                if param.get('GasMaskFilterClass'):
