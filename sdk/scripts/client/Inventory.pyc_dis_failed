    def ItemLocked(self, item):
        if not item:
            return False
        if isinstance(item, int):
            return False
        if type(item) in (tuple, list):
            item = item[0]
        if not item:
            return False
        item_id = item['complexItemID']
        if item['fromEntityID']:
            return True
        if item_id in self.craftItemList:
            return True
        if item_id in self.NPCBarterItemList:
            return True
        if item_id in self.items_to_drop:
            return True
        if item_id in getattr(self, 'items_on_workbench', []):
            return True
        for exchange_item in self.ExchangeProperties.ItemsToExchange:
            if item_id == exchange_item.complexItemID:
                return True

        if item_id in self.locked_items:
            return True
        if self.PCTradeItems:
            for trade_item in self.PCTradeItems:
                if item_id == trade_item['complexItemID']:
                    return True

        if self.is_item_barter_locked(item_id):
            return True
        if self.is_item_sell_locked(item_id):
            return True
        if self.is_magnpc_locked(item_id):
            return True
        return False

    def ItemLockedByShop(self, item):
        if not item:
            return False
        if isinstance(item, int):
            return False
        if ItemsUtils.get_shopped_item(self, item['complexItemID']):
            return True
        return False

