    def isClothProhibitActionForUseActionAdvanced(self, anim_action, show_msg = True):
        hood = EST.is_mode_on(self, EST.MODE_HOOD)
        visor = not EST.is_mode_on(self, EST.MODE_VISOR)
        for eq_item in self.EquippedArmor.values():
            if not eq_item['itemType']:
                continue
            eq_item_param = ItemsCatalog.GetItemParam(eq_item['itemType'])
            prohibit_action = eq_item_param.get('ProhibitAction')
            if not prohibit_action:
                continue
            if hood and EST.MODE_HOOD in prohibit_action:
                if anim_action in prohibit_action[EST.MODE_HOOD]:
                    if show_msg:
                        itemname = ItemsUtils.GetItemName(eq_item['itemType'])
                        msg = lc('Inventory.client.prohibit_action_hood').format(itemname=itemname)
                        self.putMessage(CHANNEL_CONSTS.ITEMS, msg)
                    return (IAPE.Hood, eq_item)
            if visor and EST.MODE_VISOR in prohibit_action:
                if anim_action in prohibit_action[EST.MODE_VISOR]:
                    if show_msg:
                        itemname = ItemsUtils.GetItemName(eq_item['itemType'])
                        msg = lc('Inventory.client.prohibit_action_visor').format(itemname=itemname)
                        self.putMessage(CHANNEL_CONSTS.ITEMS, msg)
                    return (IAPE.Visor, eq_item)
            if 'equiped' in prohibit_action:
                if anim_action in prohibit_action['equiped']:
                    if show_msg:
                        itemname = ItemsUtils.GetItemName(eq_item['itemType'])
                        msg = lc('Inventory.client.prohibit_action').format(itemname=itemname)
                        self.putMessage(CHANNEL_CONSTS.ITEMS, msg)
                    return (IAPE.Equip, eq_item)

        return (IAPE.Ok, None)

    def DoItemDefaultAction(self, item, slot_number = 0):
        if not item or self.ItemLocked(item) or self.clone_model or self.binoculars_animation:
            return
        elif not self.canUse() or self.is_throwing or self.isMovingToCreatureLoot():
            return
        else:
            item_id = item['complexItemID']
            item_type = item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                allowed_items = [ItemsCatalog.BUFF, ItemsCatalog.CLOTH]
                if item_class not in allowed_items:
                    return
            if ItemsUtils.IsQuestBlock(item):
                return
            if item_class == ItemsCatalog.WEAPON:
                if ItemsUtils.IsItemEquipped(self, item_id):
                    if self.ActiveItemID == item_id:
                        self.putOffItem(item)
                    else:
                        self.equipWeaponById(item_id, prev_to_belly=True)
                else:
                    self.putOnItem(item, slot_number=slot_number)
            elif item_class == ItemsCatalog.CLOTH:
                if not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.cancelCandle()
                    self.put_on_item(item)
                elif ItemsUtils.has_item_hood(item_type):
                    if EST.is_mode_on(self, EST.MODE_HOOD):
                        self.take_hood_off(item)
                    else:
                        self.check_hood_and_on(item)
                elif ItemsUtils.has_item_visor(item_type):
                    if EST.is_mode_on(self, EST.MODE_VISOR):
                        self.check_visor_and_close(item)
                    else:
                        self.open_visor(item)
                elif ItemsUtils.has_item_headlight(item_type):
                    if EST.is_mode_on(self, EST.MODE_HEADLIGHT):
                        self.switch_headlight_off(item)
                    else:
                        self.switch_headlight_on(item)
                elif ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.cancelCandle()
                    self.put_off_item(item)
            elif item_class == ItemsCatalog.EXPLOSION:
                if not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
            elif item_class == ItemsCatalog.BUFF:
                item_params = ItemsCatalog.GetItemParam(item_type)
                if item_params.get('NY_teleport') or item_params.get('art_save_teleport'):
                    return
                if item_params.get('CanUse', 1):
                    self.useItem(item)
            elif item_class == ItemsCatalog.AMMO:
                self.startReloadWeapon(item)
            elif item_class == ItemsCatalog.GADGET:
                item_params = ItemsCatalog.GetItemParam(item_type)
                item_category = ItemsCatalog.GetItemCategory(item_type)
                if 'waterNumberOfSips' in item_params and ItemsUtils.GetItemCondition(None, item) > 0:
                    sips = ItemsUtils.getWaterSipsPot(item)
                    if sips < 1:
                        self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.EMPTY_BOOTLE'))
                        return
                    self.useItem(item)
                    return
                if ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    gadget_action = item_params.get('Action', None)
                    if gadget_action:
                        self.startGadgetAction(gadget_action, item_params, item)
                elif item_params.get('SubType', None) and not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
                elif item_category == IC.AMULET:
                    self.putOnItem(item)
                elif item_type == ItemsCatalog.PDA['TypeID']:
                    if BWPersonality.GUICore.pdawin_visible():
                        BWPersonality.GUICore.pdawin.hide()
                    else:
                        BWPersonality.GUICore.pdawin.show()
            elif item_class == ItemsCatalog.ARTIFACT:
                if not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
            elif item_class == ItemsCatalog.LOOT:
                if self.canUse() and self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                    item_params = ItemsCatalog.GetItemParam(item_type)
                    if item_params.get('isSandbag', False):
                        raise RuntimeError('deprecated')
                    elif 'CanUse' in item_params and item_params['CanUse']:
                        if self.isBlockUseItemAsQuenchThirst(item_params):
                            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.prohibit_use_water'))
                            return
                        if self.isBlockUseItemAsQuenchHungry(item_params, item=item):
                            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.prohibit_use_food'))
                            return
                        self.useItem(item)
            elif item_class == ItemsCatalog.PART:
                item_params = ItemsCatalog.GetItemParam(item_type)
                gasmask = ItemsUtils.GetComplexItemByID(self, self.EquippedGasMaskCond['gasmask_id'])
                if item_params.get('SubType', None) and not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
                elif gasmask and ItemsUtils.CanAttachGasmaskFilter(gasmask, item):
                    self.startAttachFilterGasmask(gasmask, item['complexItemID'])
            return

    def isBlockUseItemAsQuenchThirst(self, item_params):
        effects = item_params.get('Effect')
        if not effects:
            return False
        if item_params.get('RandomEffect'):
            return False
        if EffectNames.Water_drink != effects.get('Effect'):
            return False
        if self.thirst > 0.9:
            return True
        return False

    def check_hood_and_on(self, item):
        prohibit_items = set()
        for slot_type in EST._hood_slots:
            slot_item = EST.get_slot_data(self, slot_type)
            item_type = slot_item['itemType']
            if item_type <= 0:
                continue
            if ItemsCatalog.GetItemParam(item_type).get('KeepHood', False):
                continue
            prohibit_items.add(slot_item['itemID'])

        if prohibit_items:
            if not ItemsUtils.CheckMaxItemNumber(self, len(prohibit_items)):
                self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Avatar.OVERLOADED'))
                return
            actions_queue = []
            for item_id in prohibit_items:
                pitem = ItemsUtils.GetComplexItemByID(self, item_id)
                actions_queue.append({'type': QueueActions.ItemOff,
                 'item': pitem})

            actions_queue.append({'type': QueueActions.HoodOn,
             'hood': item})
            self.handle_queue_cancel()
            self._queue_coroutine = self._queue_action_coroutine(actions_queue)
            self._queue_coroutine.run()
        else:
            self.put_hood_on(item)

    def check_visor_and_close(self, visor):
        for item_data in self.EquippedArmor.values():
            if not item_data or item_data['itemID'] <= 0 or item_data['itemType'] <= 0:
                continue
            if ItemsCatalog.GetItemParam(item_data['itemType']).get('LockVisor', False):
                if not ItemsUtils.CheckMaxItemNumber(self, 1):
                    self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Avatar.OVERLOADED'))
                    return
                prohibit_item = ItemsUtils.GetComplexItemByID(self, item_data['itemID'])
                self.handle_queue_cancel()
                self._queue_coroutine = self._queue_action_coroutine(({'type': QueueActions.ItemOff,
                  'item': prohibit_item}, {'type': QueueActions.VisorOn,
                  'visor': visor}))
                self._queue_coroutine.run()
                break
        else:
            if not self._queue_coroutine:
                self.close_visor(visor)

    def isBlockUseItemAsQuenchHungry(self, item_params, item = None):
        if item and (ItemsUtils.getCookingEffects(item) or ItemsUtils.getCookingSatietyStacks(item)):
            if self.hungry > 0.9:
                return True
        effects = item_params.get('Effect')
        if not effects:
            return False
        if EffectNames.Food_eat == effects.get('Effect') and self.hungry > 0.9:
            return True
        return False

    def UpdateQuickBar(self):
        data = {}
        data['line_number'] = str(self.quickSlotActiveLineNumber)
        if len(self.quickSlotBars) < self.quickSlotActiveLineNumber:
            self.quickSlotActiveLineNumber = max(1, len(self.quickSlotBars))
        try:
            current_line = self.quickSlotBars[self.quickSlotActiveLineNumber - 1]
        except IndexError:
            print 'quickSlotBars=', len(self.quickSlotBars), 'quickSlotActiveLineNumber=', self.quickSlotActiveLineNumber
            traceback.print_exc()
            return

        slots = []

        def getAboveText(index):
            result = str(index + 1)[-1]
            key_str = ''
            use_key = 'no use_key'
            try:
                use_key = BWPersonality.settings.keyBindings.getBindingsForAction('QuickSlot' + result)
                if use_key:
                    list_key = list(use_key[0])
                    list_key.sort()
                    for index, key in enumerate(list_key):
                        if index:
                            key_str = ' + ' + key_str
                        key_str = BWPersonality.settings.keyBindings.checkKeyCode(key) + key_str

            except:
                key_str = ' '

            return key_str

        olive_fun_srd = None
        for entry_index in xrange(len(current_line)):
            quick_entry = current_line[entry_index]
            slot_dict = {'icon': '',
             'abovetext': getAboveText(entry_index),
             'low_right_number': '',
             'item': None,
             'item_id': 0,
             'item_type': 0,
             'left_text': ''}
            if quick_entry[QUICK_TYPE_POS] == QUICK_BAR_EMPTY:
                slots.append(slot_dict)
                continue
            if quick_entry[QUICK_TYPE_POS] == QUICK_BAR_ITEM:
                item = None
                item_id = quick_entry[QUICK_DATA_ID_POS]
                item_type = quick_entry[QUICK_DATA_TYPE_POS]
                item_class = ItemsCatalog.GetItemClass(item_type)
                if item_id:
                    item = ItemsUtils.GetComplexItemByID(self, item_id)
                if not item and item_class in [ItemsCatalog.WEAPON, ItemsCatalog.CLOTH]:
                    current_line[entry_index] = [0, 0, QUICK_BAR_EMPTY]
                    slots.append(slot_dict)
                    continue
                if not item:
                    item = ItemsUtils.GetFirstComplexItemByType(self, item_type)
                    item_id = item['complexItemID'] if item else 0
                low_right_number = ''
                if item:
                    slot_dict['have_item'] = True
                    item_param = ItemsCatalog.GetItemParam(item_type)
                    if item_type == ItemsCatalog.EVENT_OLIVE_SRD['TypeID']:
                        olive_fun_srd = item_type
                    if len(item['itemList']):
                        slot_dict['left_text'] = '+'
                        if item_param.get('IsArtefactContainer', 0):
                            slot_dict['left_text'] = str(len(item['itemList']))
                    elif item_class == ItemsCatalog.PART:
                        if item_param.get('PartType') == ItemsCatalog.MAGAZINE:
                            magazine_inc = ItemsUtils.GetComplexItemInconstanParams(item)
                            loaded_ammo_type = magazine_inc.get(ItemsCatalog.INC_LOADED_MUNITION_TYPE)
                            loaded_ammo_number = magazine_inc.get(ItemsCatalog.INC_MUNITION_NUMBER)
                            if loaded_ammo_number:
                                slot_dict['left_text'] = ItemsUtils.GetItemName(loaded_ammo_type, True)
                    low_right_number = ItemsUtils.GetDisplayValue(item)
                    icon_name = ItemsUtils.GetIconName(item, item_type)
                    above_text = getAboveText(entry_index)
                    slot_dict['low_right_number'] = low_right_number
                    slot_dict['abovetext'] = above_text
                    slot_dict['item_type'] = item_type
                    slot_dict['icon'] = icon_name
                    slot_dict['item_id'] = item_id
                    slot_dict['item'] = item
                current_line[entry_index] = [item_id, item_type, QUICK_BAR_ITEM]
            slots.append(slot_dict)

        self.is_olive_fun_srd = olive_fun_srd
        data['slots'] = slots
        BWPersonality.GUICore.setActionBarData(data)
        return

