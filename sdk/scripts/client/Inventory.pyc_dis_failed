    def _check_limit_warning(self):
        """ http://hz-dev.stalker.so:8090/issues/11951 """
        if self.is_pvp_room_transformation():
            return None
        else:
            free_slots = self.getMaxInventorySlots() - ItemsUtils.visual_carring_items_length(self)
            if free_slots >= 10:
                return None
            last_time, was_critical = getattr(self, '_last_check_limit_inventory', (0, None))
            is_critical = free_slots < 2
            if BigWorld.time() - last_time < 5.0:
                if not is_critical or was_critical:
                    return None
            if is_critical:
                message = lc('Inventory.client.FULL_INVENTORY1')
                BWPersonality.gpd.sendHightMessage(message, MT.PERSONAL)
            else:
                message = lc('Inventory.client.FULL_INVENTORY0', MT.PERSONAL)
            self.putMessage(CHANNEL_CONSTS.ITEMS, message)
            self._last_check_limit_inventory = (BigWorld.time(), is_critical)
            return None

