    def lock_action_items(self, item_ids, duration = None):
        """\xd0\xb1\xd0\xbb\xd0\xbe\xd0\xba\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd0\xb5 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd1\x8f"""
        self.unlock_action_items(update_inv=False)
        for item_id in item_ids:
            self.locked_items[item_id] = 0

        self._locked_action_items = list(item_ids)
        self.UpdateInventory(0)
        if duration:
            self._unlock_action_items_callback = BigWorld.callback(duration, self.unlock_action_items)

    def unlock_action_items(self, update_inv = True):
        """\xd1\x80\xd0\xb0\xd0\xb7\xd0\xb1\xd0\xbb\xd0\xbe\xd0\xba\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xb7\xd0\xb0\xd0\xb2\xd0\xb5\xd1\x80\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd1\x8f"""
        if self._unlock_action_items_callback:
            BigWorld.cancelCallback(self._unlock_action_items_callback)
            self._unlock_action_items_callback = None
        for item_id in self._locked_action_items:
            self.locked_items.pop(item_id, None)

        del self._locked_action_items[:]
        if update_inv:
            self.UpdateInventory(0)
        return

    def handle_queue_cancel(self):
        if self._queue_coroutine:
            self._queue_coroutine.stop()
            self._queue_coroutine = None
            self.set_action_canceler_notifier(None)
            return True
        else:
            return False

    @BWMemberCoroutine
    def _queue_action_coroutine(self, queue_actions):
        start_time = BigWorld.time()

        def queue_action_notifier(event_type):
            if event_type in (NotifierEvent.OnClear, NotifierEvent.OnRelease):
                if BWPersonality.handling_key_event and start_time != BigWorld.time():
                    if self._queue_coroutine:
                        self._queue_coroutine.stop()
                        self._queue_coroutine = None
                        self.set_action_canceler_notifier(None)
            return

        self.set_action_canceler_notifier(queue_action_notifier)

        def completed():
            if not self._queue_coroutine:
                return True
            elif self._is_using_mode():
                return False
            elif self.is_putting_item_off():
                return False
            elif self.is_putting_item_on():
                return False
            elif BWPersonality.GUICore.cast_bar.ratio is not None:
                return False
            elif not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                return False
            else:
                return True

        for i, queue_action in enumerate(queue_actions):
            if queue_action['type'] == QueueActions.VisorOff:
                self.open_visor(queue_action['visor'])
            elif queue_action['type'] == QueueActions.VisorOn:
                self.close_visor(queue_action['visor'])
            elif queue_action['type'] == QueueActions.Action:
                queue_action['action']()
            elif queue_action['type'] == QueueActions.ItemOff:
                self.put_off_item(queue_action['item'])
            elif queue_action['type'] == QueueActions.ItemOn:
                self.put_on_item(queue_action['item'])
            elif queue_action['type'] == QueueActions.HoodOn:
                self.put_hood_on(queue_action['hood'])
            else:
                raise NotImplementedError
            yield BWWaitForCondition(completed)
            if not self._queue_coroutine:
                return
            if i < len(queue_actions) - 1:
                yield BWWaitForPeriod(0.01)
                if not self._queue_coroutine:
                    return

        self._queue_coroutine = None
        self.set_action_canceler_notifier(None)
        return

    def stop_multiload(self):
        if self._reload_coroutine:
            self._reload_coroutine.stop()
            self._reload_coroutine = None
        self.popTrackerLock('multireload')
        self.cancel_action_clear()
        self.unlock_action_items()
        return

    @BWMemberCoroutine
    def _insert_multitple_ammos_coroutine(self, ammo_id, magazine_ids):
        self.pushTrackerLockByName('multireload', 'Belly-Belly2-PistolHolster', lock_track_torso=True, lock_track_head=True, print_error=False)
        all_ids = [ammo_id] + magazine_ids
        BWPersonality.GUICore.inventoryGUI.del_block_multiple_items(all_ids)
        self.lock_action_items(all_ids)
        for magazine_id in magazine_ids:
            found_items = ItemsUtils.get_multiple_items_by_ids(self, [magazine_id, ammo_id])
            if not all(found_items):
                break
            self.loadAmmoInMagazine(magazine_id, ammo_id)
            yield BWWaitForCondition(lambda : self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS, True) and not self.reloading)

        self._reload_coroutine = None
        self.popTrackerLock('multireload')
        self.unlock_action_items()
        return

    def _move_items_to_item(self, motherItem, attach_items):
        if self.dead:
            return
        if self.is_hoist_flag:
            return
        if not attach_items:
            return
        attachingItem = attach_items[0]
        if ItemsUtils.can_charge_gadget_with_item(self, motherItem, attachingItem):
            self.charge_gadget_with_item(motherItem, attachingItem)
            return True
        for attach_item in attach_items:
            if ItemsUtils.CanInsertAmmoInMagazine(self, attach_item, motherItem) != ItemsUtils.FAIL_NO:
                break
        else:
            self.cancel_action_start(self.cancel_reload)
            attach_item_ids = [ ai['complexItemID'] for ai in attach_items ]
            self._reload_coroutine = self._insert_multitple_ammos_coroutine(motherItem['complexItemID'], attach_item_ids)
            self._reload_coroutine.run()
            return True

        if ItemsUtils.CanInsertAmmoInMagazine(self, motherItem, attachingItem) == ItemsUtils.FAIL_NO:
            self.cancel_action_start(self.cancel_reload)
            self._reload_coroutine = self._insert_multitple_ammos_coroutine(attachingItem['complexItemID'], [motherItem['complexItemID']])
            self._reload_coroutine.run()
            return True
        result, part_type, error_code = ItemsUtils.CanAttachItem(self, motherItem, attachingItem)
        if result:
            self.AttachItem(motherItem['complexItemID'], attachingItem['complexItemID'])
            return True
        if error_code in (ItemsUtils.FAIL_CANT_MODIFY_EQUIPPED_ITEM, ItemsUtils.FAIL_ARTEFACT_DEAD, ItemsUtils.FAIL_ATTACHING_SUB_ITEM_TTL):
            self.ReportCodedMessage(error_code)
            return True
        if ItemsUtils.CanAddStabToArtefactContainer(self, motherItem, attachingItem):
            self.addStabToArtefactContainer(motherItem['complexItemID'], attachingItem['complexItemID'])
            return True
        if motherItem['complexItemType'] == attachingItem['complexItemType']:
            self.UniteItems(motherItem, attachingItem)
            return True
        if ItemsUtils.CanAttachGasmaskFilter(motherItem, attachingItem):
            self.startAttachFilterGasmask(motherItem, attachingItem['complexItemID'])
            return True
        if ItemsUtils.canGreaseOilWeapon(motherItem['complexItemType'], attachingItem['complexItemType']):
            self.askStartWeaponGreaseOil(attachingItem, motherItem)
            return True
        if ItemsUtils.CanRepairByKit(motherItem, attachingItem):
            self.askStartItemRepair(attachingItem, motherItem)
            return True
        return False

    def loadAmmoInMagazine(self, motherItemID, attachingItemID):
        if self.dead:
            return
        if self._playing_animation_loot:
            return
        if self.is_box_moving():
            return
        if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            return
        if self.IsAvatarCrawling() or self.IsAvatarSniping() or not self.checkActiveWeapon():
            return
        if self.isEquipWeaponProgress or self.isRelaodWeaponProgress or self.is_box_moving():
            return self.ReportFail(ItemsUtils.FAIL_OTHER_ACTION)
        if self.sprinting:
            self.SetSprinting(False)
        self.cancelCandle()
        self.setBoredStatus()
        magazine = ItemsUtils.GetComplexItemByID(self, motherItemID)
        ammo_item = ItemsUtils.GetComplexItemByID(self, attachingItemID)
        magazine_inc = ItemsUtils.GetComplexItemInconstanParams(magazine)
        loaded_ammo_count = magazine_inc.get(ItemsCatalog.INC_MUNITION_NUMBER)
        loaded_ammo_type = magazine_inc.get(ItemsCatalog.INC_LOADED_MUNITION_TYPE)
        magaz_param = ItemsCatalog.GetItemParam(magazine['complexItemType'])
        magaz_capacity = magaz_param.get('AmmoCapacity', 0)
        if loaded_ammo_type == ammo_item['complexItemType'] and loaded_ammo_count >= magaz_capacity:
            self.ReportFail(ItemsUtils.AMMO_ALREADY_LOADED)
            return
        if loaded_ammo_type != ammo_item['complexItemType']:
            loaded_ammo_count = 0
        ammo_item_count = ItemsUtils.GetItemNumber(ammo_item)
        duration_all, one_duration = Durations.GetLoadAmmoInMagazineDuration(self, magazine['complexItemType'], loaded_ammo_count, ammo_item_count)
        self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, duration_all, lc('Items.GUIStrings.RELOAD'))
        slot = WeaponAttachment.makeWeaponAttachmentSlot(magazine)
        self.drawLoadAmmoInMagazine(slot, one_duration)
        self.cell.loadAmmoInMagazine(motherItemID, attachingItemID)

    def unloadAmmoMagazine(self, motherItemID):
        self.cancel_action_start(self.cancel_reload)
        if self.dead:
            return
        if self._playing_animation_loot:
            return
        if self.is_box_moving():
            return
        if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            return
        if self.IsAvatarCrawling() or self.IsAvatarSniping() or not self.checkActiveWeapon():
            return
        if self.isEquipWeaponProgress or self.isRelaodWeaponProgress or self.is_box_moving():
            return self.ReportFail(ItemsUtils.FAIL_OTHER_ACTION)
        if self.sprinting:
            self.SetSprinting(False)
        magazine = ItemsUtils.GetComplexItemByID(self, motherItemID)
        magazine_inc = ItemsUtils.GetComplexItemInconstanParams(magazine)
        if not ItemsUtils.CheckMaxItemNumber(self, 1):
            loaded_ammo_type = magazine_inc.get(ItemsCatalog.INC_LOADED_MUNITION_TYPE)
            for item in self.CarryingItems:
                if item['complexItemType'] == loaded_ammo_type:
                    break
            else:
                self.systemMsgChat(lc('GUI.InterPlayerTrade.NO_INVENTORY_ROOM'))
                return

        loaded_ammo_count = magazine_inc.get(ItemsCatalog.INC_MUNITION_NUMBER)
        magaz_param = ItemsCatalog.GetItemParam(magazine['complexItemType'])
        self.cancelCandle()
        if loaded_ammo_count <= 0:
            self.ReportFail(ItemsUtils.FAIL_NO_AMMO)
            return
        slot = WeaponAttachment.makeWeaponAttachmentSlot(magazine)
        one_duration = magaz_param.get('LoadAmmoTime', 0.5)
        duration_all = loaded_ammo_count * one_duration + 1.1 + 0.7
        self.drawLoadAmmoInMagazine(slot, one_duration, unload=True)
        self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, duration_all, lc('Items.GUIStrings.UNLOAD'))
        self.__unload_ammo_magaz_id = motherItemID
        self.__unload_ammo_last_time = time.time()
        self.__unload_ammo_callback = BigWorld.callback(one_duration * loaded_ammo_count + 1.1, self.endUnloadAmmo)
        self.lock_action_items([motherItemID])
        self.cell.startUnloadAmmoMagazine(motherItemID)

    def endUnloadAmmo(self, canceled = False):
        if canceled and self.__unload_ammo_callback:
            BigWorld.cancelCallback(self.__unload_ammo_callback)
            self.__unload_ammo_callback = None
        if not self.__unload_ammo_magaz_id or not self.__unload_ammo_last_time:
            return
        else:
            magazine_item_id = self.__unload_ammo_magaz_id
            start_time = self.__unload_ammo_last_time
            self.__unload_ammo_magaz_id = None
            self.__unload_ammo_last_time = None
            duration = time.time() - start_time
            magazine = ItemsUtils.GetComplexItemByID(self, magazine_item_id)
            if not magazine:
                print 'Inventory::endUnloadAmmo error, not found item', magazine_item_id
                return
            magazine_inc = ItemsUtils.GetComplexItemInconstanParams(magazine)
            loaded_ammo_count = magazine_inc.get(ItemsCatalog.INC_MUNITION_NUMBER)
            duration_all, one_duration = Durations.GetLoadAmmoInMagazineDuration(self, magazine['complexItemType'], 0, loaded_ammo_count)
            count = round(max(0, duration - 1.1) / one_duration)
            self.cell.unloadAmmoMagazine(magazine_item_id, count, canceled)
            self.unlock_action_items()
            return

    def charge_gadget_with_item(self, item_gadget, item_battery = None):
        """
        \xd0\xb7\xd0\xb0\xd1\x80\xd1\x8f\xd0\xb4\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb3\xd0\xb0\xd0\xb4\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb1\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9\xd0\xba\xd0\xb0\xd0\xbc\xd0\xb8
        \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb1\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbd\xd0\xb5 \xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd1\x8b, \xd0\xbd\xd0\xb0\xd0\xb9\xd0\xb4\xd1\x91\xd1\x82 \xd1\x81\xd0\xb0\xd0\xbc
        \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x83\xd1\x81\xd0\xbf\xd0\xb5\xd1\x85 (\xd0\xbd\xd0\xb5\xd1\x83\xd1\x81\xd0\xbf\xd0\xb5\xd1\x85)
        """
        gadget_params = ItemsCatalog.GetItemParam(item_gadget['complexItemType'])
        if 'ManualFuel' not in gadget_params:
            return False
        if item_battery:
            battery_param = ItemsCatalog.GetItemParam(item_battery['complexItemType'])
            if battery_param.get('AmmoClass') == gadget_params['ManualFuel']:
                if ItemsUtils.GetBatteryLevel(item_gadget) >= ItemsUtils.GetMaxBatteryLevel(item_gadget):
                    self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('ItemHolder.FULL_CHARGED'))
                    return True
                self.cell.chargeBatteryWithItem(item_gadget['complexItemID'], item_battery['complexItemID'])
                return True
            else:
                return False
        else:
            self.cell.charge_item(item_gadget['complexItemID'])
            return True

