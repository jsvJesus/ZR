    def RedrawItemCache(self):
        if self.cacheMode == ItemsUtils.CACHE_MODE_SAFEBOX:
            trader_name = self.GetTraderName(self.cacheObjectID)
            item_list = ItemsUtils.get_shopped_items(self, trader_name)
            stored_items = self.StoredItems.get(trader_name)
            if stored_items:
                item_list.extend(stored_items)
            self.current_trader_name = trader_name
            BWPersonality.GUICore.setItemCacheData({'items': item_list,
             'caption': lc('Inventory.client.ItemStorage'),
             'slots_string': (len(item_list), self.GetMaxItemStorageNumber(trader_name)),
             'trader_name': trader_name})
        elif self.cacheMode in (ItemsUtils.CACHE_MODE_CONTAIER, ItemsUtils.CACHE_MODE_CREATURE):
            cont_name = ''
            container_entity = None
            try:
                container_entity = BigWorld.entities[self.cacheObjectID]
            except:
                item_list = []
            else:
                item_list = self.GetContainerStoresItems(container_entity)
                item_list, quest_list = self.filterItemsWithoutQuests(item_list)
                self.base.get_quests_for_cache(self.cacheObjectID, quest_list)

            if container_entity:
                cont_name = container_entity.name
            BWPersonality.GUICore.setItemLootCacheData({'items': item_list,
             'caption': cont_name,
             'filters': self.itemcacheFilter})
        elif self.cacheMode == ItemsUtils.CACHE_MODE_USERFIRE:
            BWPersonality.GUICore.updateUserFire()
        return

