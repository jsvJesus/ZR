    def ItemCacheEvent(self, action, data):
        if action == ITEM_CACHE.EVENT_FILTERCHANGE:
            self.SetItemCacheFilter(data)
            return
        if self.cacheMode == ItemsUtils.CACHE_MODE_SAFEBOX:
            if not data:
                return
            if action == ITEM_CACHE.EVENT_TAKE:
                self.restore_items0(self.cacheObjectID, data['item_ids'], data['item_types'])
            elif action == ITEM_CACHE.EVENT_GIVE:
                if self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                    self.store_items0(self.cacheObjectID, data)
        elif self.cacheMode in (ItemsUtils.CACHE_MODE_CREATURE, ItemsUtils.CACHE_MODE_CONTAIER, ItemsUtils.CACHE_MODE_USERFIRE):
            if action == ITEM_CACHE.EVENT_TAKE:
                self.GetItemsFromContainerAdvanced(self.cacheObjectID, data['item_ids'], data['item_types'])
            if action == ITEM_CACHE.EVENT_TAKE_ALL:
                self.GetItemsFromContainerAdvanced(self.cacheObjectID, data['item_ids'], data['item_types'])
            elif action == ITEM_CACHE.EVENT_GIVE:
                if self.cacheMode != ItemsUtils.CACHE_MODE_CONTAIER:
                    self.PutItemsToContainer(self.cacheObjectID, data)

    def itemCacheUserFireEvent(self, action, data):
        if self.cacheMode != ItemsUtils.CACHE_MODE_USERFIRE:
            return
        elif action == ITEM_CACHE.EVENT_FILTERCHANGE:
            self.SetItemCacheFilter(data)
            return
        else:
            if action == ITEM_CACHE.EVENT_TAKE:
                item = data[0]
                if not item:
                    return
                userfire = BigWorld.entity(self.cacheObjectID)
                if not userfire.canAccess(self):
                    BWPersonality.GUICore.showUserFireErrorCode(ItemsUtils.FAIL_USER_FIRE_ACCESS)
                    return self.ReportFail(ItemsUtils.FAIL_USER_FIRE_ACCESS)
                self.GetItemsFromContainer(self.cacheObjectID, [item['complexItemID']])
            elif action == ITEM_CACHE.EVENT_GIVE_COOKINGPOT:
                item, slot = data
                userfire = BigWorld.entity(self.cacheObjectID)
                err_code = userfire.checkAddCookingPotIngredien(item, slot, self)
                if err_code == ItemsUtils.FAIL_USER_FIRE_COOKING_MAX_STACK:
                    if userfire.getCountCanAddIngredient(item):
                        err_code = None
                if err_code:
                    BWPersonality.GUICore.showUserFireErrorCode(err_code)
                    return self.ReportFail(err_code)
                self.cell.addUserFireCookingPotIngredient(self.cacheObjectID, item['complexItemID'], slot)
            elif action == ITEM_CACHE.EVENT_GIVE:
                item = data[0]
                if not item:
                    return
                userfire = BigWorld.entity(self.cacheObjectID)
                err_code = userfire.checkAddItem(item, self)
                if err_code:
                    BWPersonality.GUICore.showUserFireErrorCode(err_code)
                    return self.ReportFail(err_code)
                resutl = self.PutItemsToContainer(self.cacheObjectID, [item])
                if resutl:
                    self.on_start_cooking_item(item['complexItemType'])
            return

    @staticmethod
    def GetItemString(item, entity = None, includeWeight = True, active_color = colorCodes.active_xml, inactive_color = colorCodes.inactive_xml):

        def get_colored_value(value):
            """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82\xd0\xb0, \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x89\xd0\xb8\xd1\x85 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbd\xd0\xb5\xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82"""
            if isinstance(value, str):
                value = value.replace(u'%', inactive_color + u'%' + active_color)
            return u'{0} {1} {2}'.format(active_color, value, inactive_color)

        if not item.has_key('complexItemType'):
            return u''
        else:
            item_type = item['complexItemType']
            item_param = ItemsCatalog.GetItemParam(item_type)
            item_class = ItemsCatalog.GetItemClass(item_type)
            item_inconstant_param = ItemsUtils.GetComplexItemInconstanParams(item, entity)
            string = active_color + Inventory.GetItemName(item, item_inconstant_param) + inactive_color
            if item_class == ItemsCatalog.WEAPON:
                try:
                    string += u'\n' + inactive_color + lc('Inventory.client.STATE').format(get_colored_value(ItemsUtils.GetItemConditionPercentString(None, item, True, item_param, item_inconstant_param)))
                except TypeError:
                    pass

                pollut_value = round(ItemsUtils.GetItemPollution(item, pollution_type=ItemsCatalog.INC_POLLUTION_SCORCHING, entity=entity), 1)
                string += u'\n' + inactive_color + lc(ItemsCatalog.DIRT_TYPE_TO_NAME[ItemsCatalog.INC_POLLUTION_SCORCHING]).format(get_colored_value(pollut_value))
                string += u'\n' + inactive_color + lc('Inventory.client.REPAIRS_NUMBER').format(get_colored_value(item_inconstant_param.get(ItemsCatalog.INC_REPAIRS_NUMBER, 0)))
                weapon = clweapon.ClWeapon(item, parent_entity=entity)
                loaded_munition_type = weapon.getAmmoType()
                if not (loaded_munition_type and ItemsUtils.GetItemName(loaded_munition_type, fGetShortName=True)):
                    munition_type_string = ''
                    string += u'\n' + inactive_color + lc('Inventory.client.NUM_ARMED').format(get_colored_value(weapon.getAmmoNumber() or 0), get_colored_value(munition_type_string))
                    if item_inconstant_param.get(ItemsCatalog.INC_IS_BROKEN, 0) > 0:
                        string += u'\n' + inactive_color + lc('Inventory.client.WEAPON_JAMMED')
                    oil_time_left = ItemsUtils.getGreaseOilWeaponLeftTime(item, item_inconstant_param, BWPersonality.gpd.time_diff)
                    if oil_time_left:
                        oil_time_left = max(1, int(oil_time_left / 60))
                        string += u'\n' + inactive_color + lc('Inventory.client.oil_tooltip').format(get_colored_value(oil_time_left))
                elif item_class == ItemsCatalog.CLOTH:
                    try:
                        string += u'\n' + inactive_color + lc('Inventory.client.STATE').format(get_colored_value(ItemsUtils.GetItemConditionPercentString(None, item, True, item_param, item_inconstant_param)))
                    except TypeError:
                        pass

                    if ItemsUtils.GetItemConditionRatio(entity, item, item_inconstant_param) <= 0:
                        string += u'\n' + inactive_color + lc('Inventory.client.ITEM_BROKEN')
                    if 'FuelMax' in item_param:
                        max_battery_level = ItemsUtils.get_max_battery_level(item_type)
