    def _getValyeByKeyDiapason(self, dct, dkey):
        keys = dct.keys()
        keys.sort()
        lastKey = keys[0]
        if lastKey > dkey:
            return dct[lastKey]
        for k in keys:
            if k > dkey:
                return dct[lastKey]
            lastKey = k

        return dct[k]

