    def _getDrawwellWaterType(self):
        """
        \xd1\x82\xd0\xb8\xd0\xbf \xd0\xb2\xd0\xbe\xd0\xb4\xd1\x8b \xd0\xb2 \xd0\xba\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb4\xd1\x86\xd0\xb5, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb9 \xd1\x80\xd1\x8f\xd0\xb4\xd0\xbe\xd0\xbc
        """
        if self._current_drawwel:
            if self._current_drawwel.isDestroyed:
                self._current_drawwel = None
                return DrawWellUtil.WATER_TYPE_NONE
            if self._current_drawwel.waterType in (DrawWellUtil.WATER_TYPE_CLEAN, DrawWellUtil.WATER_TYPE_POISON, DrawWellUtil.WATER_TYPE_FLAMETHROWER_FUEL):
                return self._current_drawwel.waterType
            return DrawWellUtil.WATER_TYPE_DIRTY
        elif EffectNames.WaterClean in self.current_effects:
            return DrawWellUtil.WATER_TYPE_CLEAN
        elif EffectNames.Water in self.current_effects:
            return DrawWellUtil.WATER_TYPE_DIRTY
        else:
            return DrawWellUtil.WATER_TYPE_NONE

    def canDropPourWaterToPot(self, item, targetEntity = None):
        param = ItemsCatalog.GetItemParam(item['complexItemType'])
        if ItemsUtils.GetItemCondition(None, item) <= 0:
            return
        elif not self._current_drawwel:
            return
        else:
            if not targetEntity:
                force_hillight, targetEntity = self.getBestTarget()
            if not targetEntity:
                return
            elif self._current_drawwel != targetEntity:
                return
            elif targetEntity.__class__.__name__ != 'DrawWell':
                return
            if targetEntity.waterType in [DrawWellUtil.WATER_TYPE_CLEAN, DrawWellUtil.WATER_TYPE_DIRTY]:
                if 'waterNumberOfSips' not in param:
                    return
            if targetEntity.waterType == DrawWellUtil.WATER_TYPE_POISON:
                if not param.get('is_fuel_tank'):
                    return
                if param.get('AmmoClass') != ItemsCatalog.AMMO_CL_SPRAYER_POISON:
                    return
            elif targetEntity.waterType == DrawWellUtil.WATER_TYPE_FLAMETHROWER_FUEL:
                if not param.get('is_fuel_tank'):
                    return
                if param.get('AmmoClass') != ItemsCatalog.AMMO_CL_FLAMETHROWER_FUEL:
                    return
            return True

    def startDrinkTheWaterDrawWall(self, drawwel_id):
        self.cancel_action_release()
        if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            return
        if self.thirst > 0.99:
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.prohibit_use_water'))
            return
        if self.isClothProhibitActionForUseAction('use_water'):
            return
        self.isDrinkDrawWell = True
        self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, DrawWellUtil.DRINK_TIME, lc('Items.GUIStrings.DRINKWATERSIPS'))
        self.cell.startDrinkTheWaterDrawWall(drawwel_id)
        self.setControlLockByEffect(Constants.ControlLockTypes.CRAFTING, duration=DrawWellUtil.DRINK_TIME)
        self._drdwid = BigWorld.callback(DrawWellUtil.DRINK_TIME, self.onEndDrinkDrawWell)
        self.cancel_action_start(self.cancelDrinkTheWaterDrawWall)

    def on_use_drawwell_coin(self):
        if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            return
        self.cell.on_use_drawwell_coin()

    def onEndDrinkDrawWell(self):
        if not self.isDrinkDrawWell:
            return
        else:
            self.isDrinkDrawWell = False
            self._drdwid = None
            self.cancel_action_clear()
            return

    def cancelDrinkTheWaterDrawWall(self):
        if self.isDrinkDrawWell:
            self.cell.cancelDrinkTheWaterDrawWall()
            self.removeControlLockByEffect(Constants.ControlLockTypes.CRAFTING)
        if getattr(self, '_drdwid', 0):
            BigWorld.cancelCallback(self._drdwid)
        self._drdwid = None
        self.isDrinkDrawWell = False
