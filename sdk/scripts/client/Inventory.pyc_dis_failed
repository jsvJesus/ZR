    def InventoryDropItems(self, items, from_drag = False):
        if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            BWPersonality.gpd.sendHightMessage(lc('PlayerAvatar.client.FAIL_CHECKRESTRICTION'), MT.PERSONAL)
            return
        if len(items) != 1:
            if len(items) > 1:
                gui_jokes.askUserOk(lc('Inventory.ITEM_DROP'), lc('Inventory.CANT_MULTY_DROP'))
            return
        item = items[0]
        if not item:
            return
        if from_drag and self.canDropPourWaterToPot(item):
            self.pourWaterToPot(item)
            return
        if ItemsUtils.IsItemFixed(item):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnonDropable_msg'))
            return
        if TutorialManager.is_space_tutorial(self.spaceID):
            if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and not self.isAdminAccess():
                self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.TutorialLockItems'))
                return

            def drop_listener(event):
                if event == gui_jokes.askUserYesNo.YES:
                    self.dropItem(item)
                    sounds_manager.playSound('ui/inventory/item_drop')
                elif event == gui_jokes.askUserYesNo.NO:
                    self.NeedToUpdateInventory()
                elif event == gui_jokes.askUserYesNo.CLOSED:
                    self.NeedToUpdateInventory()

            target = BigWorld.target()
            if target and self.canUseItemOnTarget(target.id, item['complexItemID']):
                if target.__class__.__name__ == 'Avatar':
                    target.used_item_on_target or self.useItemOnTarget(item['complexItemID'])
                else:
                    self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Avatar.cell.USE_HEAL_LATER'))
            else:
                self.useItemOnTarget(item['complexItemID'])
        elif self.inPVPinstance:
            self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Avatar.pvp.action_forbidden_pvpspace'))
            self.NeedToUpdateInventory()
        else:
            item_name = colorCodes.active_xml + Inventory.GetItemName(item) + colorCodes.inactive_xml
            gui_jokes.askUserYesNo(lc('Inventory.ITEM_DROP'), lc('Inventory.RLY_DROP').format(item_name), drop_listener, enter_btn=gui_jokes.askUserYesNo.YES)

    def InventoryDeleteItems(self, items):
        if BigWorld.isKeyDown(BigWorld.stringToKey('F2')):
            awesome_user = self.isAdminAccess()
            if not items or not all(items):
                return
            if len(items) > 1 and not awesome_user:
                gui_jokes.askUserOk(lc('Inventory.ITEM_DELETE'), lc('Inventory.CANT_MULTY_DELETE'))
                return
            if TutorialManager.is_space_tutorial(self.spaceID) and not awesome_user:
                self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.TutorialLockItems'))
                return

            def delete_listener(event):
                if event == gui_jokes.askUserYesNo.YES:
                    self.delete_items(items)
                    self.NeedToUpdateInventory(need_block=True)
                elif event == gui_jokes.askUserYesNo.NO:
                    self.NeedToUpdateInventory()
                elif event == gui_jokes.askUserYesNo.CLOSED:
                    self.NeedToUpdateInventory()

            def check_quest_id(quest_id):
                if not quest_id:
                    return False
                quest = qd.getQuestOnID(quest_id)
                if quest['Additional']['CantCancel']:
                    return True
                return check_quest_id(qd.get_direct_parent_by_id(quest_id))

            if check_quest_id(ItemsUtils.GetQuestItemID(items[0])):
                self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.QuestLockItems'))
                return
            if len(items) == 1:
                item = items[0]
                quest_id = ItemsUtils.GetQuestItemID(item)
                item_name = Inventory.GetItemName(item)
                quest_title = quest_id and qd.cancel_fail_mode(qd.getQuestOnID(quest_id)) and colorCodes.active_xml + qd.getQuestTitleByID(quest_id) + colorCodes.inactive_xml
                item_name = colorCodes.active_xml + item_name + colorCodes.inactive_xml
                text = lc('Inventory.RLY_QUEST_DELETE').format(item_name, quest_title)
                gui_jokes.askUserYesNo(lc('Inventory.ITEM_DELETE'), text, delete_listener, enter_btn=gui_jokes.askUserYesNo.YES)
                return
        else:
            item_name = lc('Inventory.RLY_MULTY')
        gui_jokes.askUserYesNo(lc('Inventory.ITEM_DELETE'), lc('Inventory.RLY_DELETE').format(colorCodes.active_xml + item_name + colorCodes.inactive_xml), delete_listener, enter_btn=gui_jokes.askUserYesNo.YES)

