    def PlayerRepairTooltip(self, item):
        item_class = ItemsCatalog.GetItemClass(item['complexItemType'])
        item_params = ItemsCatalog.GetItemParam(item['complexItemType'])
        if self.ItemLocked(item):
            return lc('Items.Messages.FAIL_OTHER_ACTION')
        else:
            if item_class == ItemsCatalog.WEAPON:
                kit_id = self.NeededRepairIDFunc.args[0]
                kit = ItemsUtils.GetComplexItemByID(self, kit_id)
                kit_result = ItemsUtils.can_apply_kit_to_weapon(self, item, kit)
                can_repair, need_repair = kit_result['repair']
                if need_repair and can_repair:
                    return lc('Inventory.client.REPAIR_AVAILABLE')
                can_clear, need_clear = kit_result['clear']
                if can_clear and need_clear:
                    return lc('Inventory.client.MAINTENANCE_AVAILABLE')
                if can_repair:
                    return lc('Inventory.client.REPAIR_UNAVAILABLE')
                if can_clear:
                    return lc('Inventory.client.MAINTENANCE_NOT_NEEDED')
            string = None
            repair_cost, margin = ItemsUtils.GetRepairCost(item, self)
            if repair_cost:
                string = lc('Inventory.client.MAINTENANCE_AVAILABLE')
            elif item_params.get('isnotRepairable'):
                string = lc('Items.Messages.REPAIR_IS_UNAVAILABLE')
            elif item_class == ItemsCatalog.CLOTH and ItemsUtils.is_item_broken(item):
                string = lc('Inventory.client.MAINTENANCE_AVAILABLE')
