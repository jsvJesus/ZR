            if not gadget_data['GadjetType']:
                continue
            if ItemsCatalog.GetItemCategory(gadget_data['GadjetType']) != IC.GRENADE:
                continue
            grenade_item = ItemsUtils.GetComplexItemByID(self, gadget_data['GadjetID'])
            if not grenade_item:
                continue
            grenades_data = {'type': gadget_data['GadjetType'],
             'count': ItemsUtils.GetItemNumber(grenade_item)}
            break

        data = {'primary_name': primary_weapon_name,
         'primary2_name': primary2_weapon_name,
         'secondary_name': secondary_weapon_name,
         'primary_count': primary_weapon_string,
         'primary2_count': primary2_weapon_string,
         'all_primary_ammo': primary_inventory_ammo,
         'all_primary2_ammo': primary2_inventory_ammo,
         'secondary_count': secondary_weapon_string,
         'all_secondary_ammo': secondary_inventory_ammo,
         'ShootingMode': None,
         'active_slot_name': None,
         'grenades_data': grenades_data,
         'weight': (self.ItemsWeight, self.GetStatValue(Stats.ch_MaxWeight))}
        if self.active_weapon:
            data['active_slot_name'] = self.active_weapon.slot_name
