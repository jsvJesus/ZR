    def inventoryEvent(self, action, data, slot = None, index = 0):
        if getattr(self, 'is_throwing', False):
            return
        elif action == INV_CONST.A_DRAG_STOP:
            self.fadeInventoryItems(None)
            return
        elif action == INV_CONST.A_DRAG_START:
            item_params = ItemsCatalog[data['complexItemType']]
            if item_params.get('weaponGreaseOilTimeMinutes'):
                self.fadeInventoryItems(ItemsUtils.filterNoWeapon)
            elif item_params.get('RepairKitType') or item_params.get('RepairOnlyItemsType'):
                self.fadeInventoryItems(lambda item: not ItemsUtils.CanRepairByKit(item, data))
            return
        elif action == INV_CONST.A_REPAIR:
            if not data:
                return
            self._repairEvent(data)
            return
        else:
            allowed_actions = [INV_CONST.A_CONTEXT, INV_CONST.A_EQUIP, INV_CONST.A_MOVE]
            if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS) and action not in allowed_actions:
                BWPersonality.gpd.sendHightMessage(lc('PlayerAvatar.client.FAIL_CHECKRESTRICTION'), MT.PERSONAL)
                return
            elif action == INV_CONST.A_MOVE_UP:
                self.setFirstItemSlotNumber(data)
                return
            elif action == INV_CONST.A_MOVE_DOWN:
                self.setlastItemsSlotNumber(data)
                return
            if action == INV_CONST.A_MOVE:
                item_to, items = data
                if items:
                    item_from = items[0]
                    if self.ItemLocked(item_to):
                        return
                    if any(map(self.ItemLocked, items)):
                        return
                    if item_to and items:
                        if BigWorld.isKeyDown(Keys.KEY_LSHIFT) or BigWorld.isKeyDown(Keys.KEY_RSHIFT):
                            self.displaceItemSlot(items, item_to)
                            return
                        if not self._move_items_to_item(item_to, items):
                            if len(items) > 1:
                                self.displaceItemSlot(items, item_to)
                            else:
                                self.SwapItemsInSlots(item_from, item_to)
                        return
                    if items:
                        item_ids = [ item['complexItemID'] for item in items if item is not None ]
                        self.setlastItemsSlotNumber(item_ids)
                    return
                if action == INV_CONST.A_TOQUICKBAR:
                    itemData, slotN, prev_item_id, prev_item_type = data
                    if self.ItemLocked(data[0]):
                        return
                    if prev_item_id:
                        prev_item = ItemsUtils.GetComplexItemByID(self, prev_item_id)
                        if prev_item:
                            if ItemsUtils.CheckPossibleAttach(self, prev_item, itemData):
                                self._move_items_to_item(prev_item, [itemData])
                                return
                    self.AddItemToQuickSlot(itemData, slotN)
                    self.UpdateQuickBar()
                    return
                if self.ItemLocked(data):
                    return
                if action == INV_CONST.A_EQUIP:
                    self.DoItemDefaultAction(data, slot_number=index)
                    return
                if action == INV_CONST.A_ATTACH:
                    filter_item, gasmask = data
                    if ItemsUtils.CanAttachGasmaskFilter(gasmask, filter_item):
                        self.startAttachFilterGasmask(gasmask, filter_item['complexItemID'])
                    return
                action == INV_CONST.A_FILTERCHANGE and self.SetInventoryFilter(data)
            elif action == INV_CONST.A_SORTCHANGE:
                self.set_inventory_sort(data)
            elif action == INV_CONST.A_CONTEXT:
                if self.ItemLocked(data):
                    return
                self.context_menu_item = data
                self.context_menu_slot = slot
                if self.context_menu_item:
                    actions = self.GetItemActions(self.context_menu_item)
                    if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and self.isAdminAccess():
                        actions['copy_id'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c ItemID %s' % data['complexItemID']
                        actions['copy_type'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c ItemType %s' % data['complexItemType']
                        actions['copy_inc'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c INC \u043a\u043e\u0434'
                        actions['copy_itemNameLC'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u043c\u044f'
                        actions['open_ItemsEditor'] = u'\u043e\u0442\u0440\u044b\u0442\u044c \u0432 ItemsEditor'
                        actions['trade_data'] = u'\u0434\u0430\u043d\u043d\u044b\u0435 \u043e \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435'
                        var_name = ItemsCatalog.GetItemVarName(data['complexItemType'])
                        if var_name:
                            actions['copy_itemName'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c %s' % var_name
                    self.StartInventoryContextMenu(actions, BWPersonality.GUICore.GUI_ID_INVENTORY)
            elif action == INV_CONST.A_DROP:
                self.InventoryDropItems(data, from_drag=True)
            elif action == INV_CONST.A_DELETE:
                self.InventoryDeleteItems(data)
            elif action == INV_CONST.EVENT_ACTION:
                pass
            else:
                return
            return

