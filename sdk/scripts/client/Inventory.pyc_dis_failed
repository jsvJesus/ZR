    def UpgradeCraft(self):
        remove_list = []
        for item in self.craftItemList:
            if not ItemsUtils.GetComplexItemByID(self, item):
                remove_list.append(item)

        for remove_item in remove_list:
            self.craftItemList.remove(remove_item)

        data = {'recipes': self.GetReceiptList(),
         'items': self.craftItemList,
         'description': colorCodes.tf3_gray_text + self.GetReceiptDescription(self.craftSelectedReceipt),
         'autofill': self.craftAutofill,
         'icon': self.GetReceiptIcon(self.craftSelectedReceipt),
         'recipie_id': self.craftSelectedReceipt}
        BWPersonality.GUICore.setCraftData(data)

    @if_not_destroyed
    def craftEvent(self, event, data):
        if event == CraftGUI.EVENT_SELECT:
            self.craftSelectedReceipt = data
            if self.craftAutofill:
                resource_dict = self.GetReceiptPartsList(self.craftSelectedReceipt)
                min_art_depl = ItemsUtils.getRecipieMinArtifactDepleetionPercent(self.craftSelectedReceipt)
                self.craftItemList = self.FillContainerWithResourceIDs(resource_dict, min_art_depl)
            self.UpgradeCraft()
        elif event == CraftGUI.EVENT_AUTOFILL:
            self.craftAutofill = data
            if self.craftSelectedReceipt and self.craftAutofill:
                resource_dict = self.GetReceiptPartsList(self.craftSelectedReceipt)
                min_art_depl = ItemsUtils.getRecipieMinArtifactDepleetionPercent(self.craftSelectedReceipt)
                self.craftItemList = self.FillContainerWithResourceIDs(resource_dict, min_art_depl)
            self.UpgradeCraft()
        elif event == CraftGUI.EVENT_CANCEL:
            self.on_cancel_craft()
        elif event == CraftGUI.EVENT_CRAFT:
            self.startCraft(WorkbenchUtil.WorkbenchTypes.NONE, self.craftSelectedReceipt, self.craftItemList, [])
        elif event == CraftGUI.EVENT_CLEAR:
            self.craftItemList = []
            self.UpgradeCraft()
        elif event == CraftGUI.EVENT_REMOVE_ITEM:
            if data in self.craftItemList:
                self.craftItemList.remove(data)
            self.UpgradeCraft()
        elif event == CraftGUI.EVENT_ADDITEM:
            item_id = data['complexItemID']
            item = ItemsUtils.GetComplexItemByID(self, item_id)
            if item and item_id not in self.craftItemList and not ItemsUtils.IsQuestItem(item):
                self.craftItemList.append(item_id)
                self.UpgradeCraft()
        elif event == CraftGUI.EVENT_DELITEM:
            if data in self.craftItemList:
                self.craftItemList.remove(data)
                self.UpgradeCraft()
        self.NeedToUpdateInventory()

