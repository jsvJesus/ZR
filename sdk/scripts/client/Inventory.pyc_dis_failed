    def UpdateInventory(self, delay = 0.3, need_block = False):

        def reallyUpdateInventory():
            if self.isDestroyed:
                return
            elif not hasattr(self, 'inventoryPositionList'):
                return
            else:
                self.CheckAllItemsInPosList()
                items = self.GetItemsList()
                self._max_weight = self.GetStatValue(Stats.ch_MaxWeight)
                BWPersonality.GUICore.setInventoryData(items, (self.ItemsWeight,
                 self._max_weight,
                 ItemsUtils.visual_carring_items_length(self),
                 self.getMaxInventorySlots()), (self.CreditNumber, self.GoldCreditNumber), self.inventoryFilter)
                BWPersonality.GUICore.updateWeaponModWindow()
                character_screen_data = {'items': self.GetCharacterEquippedItemsDict(),
                 'displayName': self.name,
                 'attachSlots': self.getVisibleAttaches()}
                BWPersonality.GUICore.setCharScreenData(character_screen_data)
                self.items_to_drop = filter(lambda x: ItemsUtils.GetComplexItemByID(self, x) != None, self.items_to_drop)
                self.UpdateWeaponIcon()
                self.updateInventoryTimer = None
                BWPersonality.GUICore.inventoryGUI.clearDarkScreen()
                self.UpdateQuickBar()
                return

        if BWPersonality.GUICore.inventoryGUI and need_block:
            BWPersonality.GUICore.inventoryGUI.wait()
        if self.updateInventoryTimer is not None:
            BigWorld.cancelCallback(self.updateInventoryTimer)
        if delay:
            self.updateInventoryTimer = BigWorld.callback(delay, reallyUpdateInventory)
        else:
            reallyUpdateInventory()
        return

    def UpdateWeaponIcon(self):
        return

        def get_weapon_string(set_slot_name):
            if not self.weapon_slots or set_slot_name not in self.weapon_slots:
                return (u'-', '-', '-')
            weapon = self.weapon_slots[set_slot_name]
            weapon_name = ItemsUtils.GetItemName(weapon.getItemType(), fGetShortName=True)
            weapon_string = '-'
            all_ammo = ''
            if weapon.isGrenadeLaunchMode():
                weapon_string = '%s/%s' % (weapon.getCurrentGrenadeNumber(), weapon.getCurrentGrenadeCapacity())
                if weapon.getCurrentGrenadeType():
                    all_ammo = ItemsUtils.GetItemName(weapon.getCurrentGrenadeType(), fGetShortName=True)
            elif weapon.getMagazine() or weapon.isBuiltinMagazine():
                weapon_string = '%s/%s' % (weapon.getAmmoNumber(), weapon.getAmmoCapacity())
                if weapon.getAmmoType():
                    all_ammo = ItemsUtils.GetItemName(weapon.getAmmoType(), fGetShortName=True)
            return (weapon_name, weapon_string, all_ammo)

        primary_weapon_name, primary_weapon_string, primary_inventory_ammo = get_weapon_string('PrimarySlot')
        primary2_weapon_name, primary2_weapon_string, primary2_inventory_ammo = get_weapon_string('Primary2Slot')
        secondary_weapon_name, secondary_weapon_string, secondary_inventory_ammo = get_weapon_string('SecondarySlot')
