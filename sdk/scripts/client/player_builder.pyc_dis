# Embedded file name: ./client/player_builder.py
import BigWorld
import BWPersonality
from time import time
import Keys
import Math
from Math import Matrix, Vector3
import math
import SFXer
import pickle
import pyson
import os
import itertools
from Sandbag import BOXS, getBoxByID
from gui_const import MESSAGEBOX
import Constants
import random
import traceback
import gui_jokes
from Localization import lc
from builder import update_gui_quantity_block
