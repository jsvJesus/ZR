        \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0 \xd0\xbf\xd0\xbe\xd1\x81\xd1\x8b\xd0\xbb\xd0\xba\xd1\x83-\xd0\xbf\xd1\x80\xd0\xb8\xd0\xbd\xd1\x8f\xd1\x82\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xb0\xd1\x80\xd0\xbe\xd1\x87\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xbf\xd0\xbe\xd1\x81\xd1\x8b\xd0\xbb\xd0\xbe\xd0\xba

"""
import BigWorld
import BWPersonality
from Localization import lc
from NPCs import NPCs
import gui_jokes
from GiftBankUtils import EVENTS
from GiftBankUtils import ERROR_CODE
from ChatChannelConfig import ChannelConsts
CHANNEL_CONSTS = ChannelConsts()

class GiftRecipient:

    def onGiftEvent(self, eventID, code, target, npc_name):
        print 'onGiftEvent', [eventID,
         code,
         target,
         npc_name]
        txt = ERROR_CODE.msg[code].format(target, npc_name)
        print txt.encode('utf8')
        if eventID == EVENTS.RECEIVING:
            if code == ERROR_CODE.RECEIVED_GIFT_AVATAR_OK:
                if not NPCs.getProfession(npc_name, self):
                    npc_name_lc = '???'
                    txt = ERROR_CODE.msg[code].format(target, npc_name_lc)
                elif code == ERROR_CODE.RECEIVED_GIFT_SHOP_OK:
                    npc_name_lc = NPCs.getProfession(npc_name, self) or '???'
                    txt = ERROR_CODE.msg[code].format(npc_name_lc)
                elif code == ERROR_CODE.ERROR_IS_BLACK_LIST:
                    txt = ERROR_CODE.msg[code].format(target)
                self._msg_on_loadworld(txt)
                return
            if eventID == EVENTS.OPEN:
                self._msg_on_loadworld(txt)
                if code == ERROR_CODE.DELETE_OK:
                    return
                if code == ERROR_CODE.OPEN_OK:
                    gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SHOW_GIFT'), txt)
                    return
                gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_OPEN_ERROR'), txt)
                return
            if eventID == EVENTS.SEND:
                self._msg_on_loadworld(txt)
                code == ERROR_CODE.SEND_OK and gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_OK'), txt)
                return
            gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_ERROR'), txt)
            return

    def won_mass_quest(self, messages):
        """ \xd1\x83\xd0\xb2\xd0\xb5\xd0\xb4\xd0\xbe\xd0\xbc\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbe \xd0\xbf\xd0\xbe\xd0\xb1\xd0\xb5\xd0\xb4\xd0\xb5 \xd0\xb2 \xd0\xbc\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xbc \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb5 (\xd0\xb8\xd0\xbb\xd0\xb8 \xd0\xb2 \xd0\xbd\xd0\xb5\xd1\x81\xd0\xba\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xb8\xd1\x85) """
        self._msg_on_loadworld_mq(messages)

    def _msg_on_loadworld(self, txt):
        if self.isDestroyed:
            return
        if self.isInWorld:
            self.putMessage(CHANNEL_CONSTS.ITEMS, txt, u'')
        else:
            BigWorld.callback(10, lambda : not self.isDestroyed and self._msg_on_loadworld(txt))

    def _msg_on_loadworld_mq(self, messages):
        """ \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbe \xd0\xbf\xd0\xbe\xd0\xb1\xd0\xb5\xd0\xb4\xd0\xb5 \xd0\xb2 \xd0\xbc\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0\xd1\x85 """
        if self.isDestroyed:
            return
        if self.isInWorld:
            for txt in messages:
                self.putMessage(CHANNEL_CONSTS.ITEMS, txt, u'')

        else:
            BigWorld.callback(5, lambda : not self.isDestroyed and self._msg_on_loadworld_mq(messages))

    def got_gifts0(self, *args):
        if BWPersonality.GUICore.is_gifts_win_visible():
            BWPersonality.GUICore._gifts_win.got_gifts1(*args)

    def on_gift_event0(self, *args):
        if BWPersonality.GUICore.is_gifts_win_visible():
            BWPersonality.GUICore._gifts_win.on_gift_event1(*args)