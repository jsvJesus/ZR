class Button(soButton):

    def __init__(self, drag_comp, size):
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = size, size
        soButton.__init__(self, comp)
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = 'i'
        self.initVSC('soGUI/elements/button_transforamtionhelp.xml')
        self._drag_comp = drag_comp
        self._start_drag_pos = None
        return

    def handleMouseButtonEvent(self, comp, event):
        key = event.key
        down = event.isKeyDown()
        if key == Keys.KEY_LEFTMOUSE:
            if down:
                self._start_drag_pos = Vector3(self._drag_comp.position)
            else:
                reset_move_click = True
                if self._start_drag_pos and self._drag_comp.position.distTo(self._start_drag_pos) < 2:
                    reset_move_click = False
                if reset_move_click:
                    self.buttonPressed = False
        soButton.handleMouseButtonEvent(self, comp, event)
        return False


def create_text(text, index):
    line_height = 24
    comp = GUI.Text(text, 'RobotoCondensedRegular_16.font')
    comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
    comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
    comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
    comp.width, comp.height = 180, line_height
    if index == 0:
        pos_x = 14
        comp.colour = cc.header_rgba
    else:
        comp.colour = cc.inactive_rgba
        pos_x = 50
    comp.position = (pos_x, 8 + line_height * 0.5 + index * line_height, 0.5)
    return comp


class HeliBlock:

    def __init__(self, component):
        self.component = component
        comp = create_text(lc('Helicopter.gui.title0'), 0)
        self.component.addChild(comp)
        self._users_comp = create_text(lc('Helicopter.gui.users'), 1)
        self._users_comp.colour = (255, 255, 255, 255)
        self._users_comp.colourFormatting = True
        self.component.addChild(self._users_comp)
        self._boxes_comp = create_text(lc('Helicopter.gui.boxes'), 2)
        self._boxes_comp.colour = (255, 255, 255, 255)
        self._boxes_comp.colourFormatting = True
        self.component.addChild(self._boxes_comp)
        comp = create_text(lc('Helicopter.gui.camera'), 3)
        self.component.addChild(comp)
        comp = create_text(lc('Helicopter.gui.load'), 4)
        self.component.addChild(comp)

    def set_data(self, box_count, box_total, users_count):
        self._boxes_comp.text = cc.inactive_hex + lc('Helicopter.gui.boxes') + cc.active_hex + u' {0}/{1}'.format(box_count, box_total)
        self._users_comp.text = cc.inactive_hex + lc('Helicopter.gui.users') + cc.active_hex + u' {0}/{1}'.format(users_count, H.SEATS_COUNT)


class MinigunBlock:

    def __init__(self, component):
        self.component = component
        comp = create_text(lc('Helicopter.gui.title1'), 0)
        self.component.addChild(comp)
        comp = create_text(lc('Helicopter.gui.ammo'), 1)
        self.component.addChild(comp)
        self._bullet_comp = comp
        bullet_comp_width = self._bullet_comp.stringDimensions(self._bullet_comp.text)[0]
        comp = GUI.Simple('soGUI/frame/helicopter/infinity.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (bullet_comp_width + self._bullet_comp.position[0] + 8, self._bullet_comp.position.y, 0.5)
        self.component.addChild(comp, 'inf')
        comp = GUI.Simple('soGUI/frame/helicopter/pp_gun.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = ((self.component.width - comp.width) * 0.5, self.component.height - 16, 0.5)
        self.component.addChild(comp)
        orig_comp = comp
        comp = GUI.Simple('soGUI/frame/helicopter/overheat.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = orig_comp.horizontalPositionMode, orig_comp.verticalPositionMode
        comp.horizontalAnchor, comp.verticalAnchor = orig_comp.horizontalAnchor, orig_comp.verticalAnchor
        comp.widthMode, comp.heightMode = orig_comp.widthMode, orig_comp.heightMode
        comp.width, comp.height = orig_comp.width, orig_comp.height
        comp.materialFX = 'BLEND'
        comp.position = orig_comp.position - Vector3(0, 0, 0.1)
        self.component.addChild(comp, 'overheat')
        self._overheat_width = comp.width

    def _set_count(self, count):
        if count is None:
            self.component.inf.visible = True
            self._bullet_comp.text = lc('Helicopter.gui.ammo')
        else:
            self.component.inf.visible = False
            self._bullet_comp.text = lc('Helicopter.gui.ammo') + ': ' + str(count)
        return

    def _set_ratio(self, ratio):
        self.component.overheat.width = self._overheat_width * ratio
        self.component.overheat.mapping = ((0, 0),
         (0, 1),
         (1 * ratio, 1),
         (1 * ratio, 0))


class HeliInterface(DragWin, GUIPositions):
    factoryString = 'HelInterface.GUI.Win'

    def __init__(self):
        self._caption_size = 30
        self._win_width = 240
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self._win_width, 300
        comp.position = (300, 300, 0.5)
        comp.visible = False
        DragWin.__init__(self, comp)
        GUIPositions.__init__(self)
        self.component.script = self
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self._win_width, 135
        comp.position = (0, self._caption_size, 0.5)
        comp.colour = (255, 255, 255, 200)
        comp.materialFX = 'BLEND'
        self._base_block = HeliBlock(comp)
        self.component.addChild(comp, 'heli_block')
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self._win_width, 135
        comp.position = (0, 165, 0.5)
        comp.colour = (255, 255, 255, 200)
        comp.materialFX = 'BLEND'
        self._minigun_block = MinigunBlock(comp)
        self._minigun_block._set_count(None)
        self.component.addChild(comp, 'minigun_block')
        btn = Button(self.component, self._caption_size)
        btn.component.position = (0, 0, 0.5)
        self.component.addChild(btn.component, 'button')
        btn.onClick = self._on_btn_click
        btn.onBound()
        self._collapsed = False
        return

    def on_stick(self):
        self._minigun_block._set_ratio(0)
        self._update_visiblity()

    def on_unstick(self):
        self._update_visiblity()

    def _on_btn_click(self):
        self._collapsed = not self._collapsed
        self._update_visiblity()

    def show(self):
        if self.visible:
            return
        self.component.visible = True
        self._update_visiblity()
        self._minigun_block._set_ratio(0)
        self._base_block.set_data(0, 0, 0)
        GUIPositions.show(self)

    def is_gun_visible(self):
        return self._minigun_block.component.visible

    def reset_position(self):
        """ \xd1\x81\xd0\xb1\xd1\x80\xd0\xb0\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd """
        self.component.position = (300, 300, 0.5)

    def _update_visiblity(self):
        if self._collapsed:
            show_base_block = False
            show_minigun_block = False
        else:
            show_base_block = True
            show_minigun_block = False
            heli = BigWorld.entities.get(self._p.transport_seat)
            if heli:
                show_minigun_block = heli.get_user_seat_index(self._p.id) == H.GUNNER_SEAT_INDEX
        self._minigun_block.component.visible = show_minigun_block
        self._base_block.component.visible = show_base_block
        height = self._caption_size
        width = self._caption_size
        if show_base_block:
            height += self._base_block.component.height
            width = self._win_width
        if show_minigun_block:
            height += self._minigun_block.component.height
            width = self._win_width
        self.component.width, self.component.height = width, height
        self._check_win_position()

    def update_data(self, box_count, box_total, users_count):
        self._base_block.set_data(box_count, box_total, users_count)

    def update_temperature(self, temp_ratio):
        self._minigun_block._set_ratio(temp_ratio)

    def _check_win_position(self):
        self.on_size_changed()

    def hide(self):
        if not self.visible:
            return
        self.component.visible = False

    @property
    def visible(self):
        return self.component.visible

    @property
    def _p(self):
        return BigWorld.player()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)