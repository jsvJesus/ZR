    def _clear_seats(self):
        self._selected = None
        self._hovered = None
        for i, p in enumerate(self._places):
            occupied = self._helicopter.seat_ids[i + 1]
            p.set_mode(SeatMode.Occupided if occupied else SeatMode.Free)

        self._update_seat_button()
        self._boxes.apply_count(len(self._helicopter.boxes))
        return

    def _on_place_hover(self, place, enter):
        if enter:
            if self._hovered == place:
                return
            if self._hovered:
                self._hovered.set_mode(SeatMode.Free)
            self._hovered = None
            if place.seat_mode == SeatMode.Free:
                self._hovered = place
            if self._hovered:
                self._hovered.set_mode(SeatMode.Highlighted)
        else:
            if self._hovered:
                self._hovered.set_mode(SeatMode.Free)
            self._hovered = None
        return

    def _on_place_click(self, place):
        if self._selected == place:
            return
        elif place.seat_mode == SeatMode.Occupided:
            return
        else:
            if self._selected:
                self._selected.set_mode(SeatMode.Free)
            self._selected = place
            if self._selected:
                self._selected.set_mode(SeatMode.Selected)
            if self._hovered and self._hovered.seat_mode != SeatMode.Highlighted:
                self._hovered = None
            self._update_seat_button()
            return

    def on_seat_changed(self):
        for i, p in enumerate(self._places):
            occupied = self._helicopter.seat_ids[i + 1]
            if occupied:
                p.set_mode(SeatMode.Occupided)
            elif p.seat_mode == SeatMode.Occupided:
                p.set_mode(SeatMode.Free)

        if self._selected and self._selected.seat_mode != SeatMode.Selected:
            self._selected = None
        if self._hovered and self._hovered.seat_mode != SeatMode.Highlighted:
            self._hovered = None
        self._update_seat_button()
        return

    def on_boxes_changed(self):
        self._boxes.apply_count(len(self._helicopter.boxes))

    def _update_seat_button(self):
        enabled = self._selected and self._selected.seat_mode != SeatMode.Occupided
        self._seat_button.setDisabledState(not enabled)

    def _on_dbl_place_click(self, place):
        helicopter = self._helicopter
        self.hide()
        self._request_seat(helicopter)

    def _on_take_place_click(self):
        helicopter = self._helicopter
        self.hide()
        self._request_seat(helicopter)

    def _request_seat(self, helicopter):
        player = BigWorld.player()
        if player.will_die_on > 0:
            player.notify_iwannadie()
            return
        if player.is_box_moving() or player.waiting_autopickup() or not player.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS) or player.dead or player.isPlayerJump() or player.physics.inAir or player.binoculing:
            return
        player.on_heliseat_requested(helicopter.id)
        helicopter.cell.request_seat(self._selected.index)

    def show(self, helicopter):
        if self.component.visible:
            return
        self._helicopter = helicopter
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        self._pot_handler = BigWorld.addPot(helicopter.matrix, helicopter.get_interaction_dist() + 0.5, self._on_pot)
        self._clear_seats()
        self.onBound()

    def _on_pot(self, entered, handle):
        if not entered:
            self.hide()

    def hide(self):
        if not self.component.visible:
            return
        else:
            self._helicopter = None
            BigWorld.delPot(self._pot_handler)
            self._pot_handler = None
            self.component.visible = False
            BWPersonality.GUICore.setBestCursor()
            return

    @property
    def visible(self):
        return self.component.visible