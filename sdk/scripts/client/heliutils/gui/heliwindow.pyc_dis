class SeatMode:
    Occupided, Free, Highlighted, Selected = xrange(4)


class Seatplace(Interceptor):

    def __init__(self, vertical):
        self.seat_mode = SeatMode.Free
        self.on_hover_callback = lambda seatplace, enter: None
        self.on_click_callback = lambda seatplace: None
        self.on_dbl_click_callback = lambda seatplace: None
        self._prev_click = (Vector2(), 0)
        texture = 'soGUI/frame/helicopter/Armchair_vert.dds' if vertical else 'soGUI/frame/helicopter/Armchair.dds'
        highlight_image_comp = GUI.Window(texture)
        texture = 'soGUI/frame/helicopter/Armchair_vert_full.dds' if vertical else 'soGUI/frame/helicopter/Armchair_full.dds'
        selected_image_comp = GUI.Window(texture)
        width = max(highlight_image_comp.texture.width, selected_image_comp.texture.width)
        height = max(highlight_image_comp.texture.height, selected_image_comp.texture.height)
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width, height
        Interceptor.__init__(self, comp)
        self.component.script = self
        comp = highlight_image_comp
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width, self.component.height
        comp.position = (0, 0, 0.5)
        comp.colour = (255, 255, 255, 125)
        self.component.addChild(comp, 'frame_image')
        comp = selected_image_comp
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width, self.component.height
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'full_image')
        self._update_content()

    def handleMouseLeaveEvent(self, comp):
        self.on_hover_callback(self, False)
        return Interceptor.handleMouseLeaveEvent(self, comp)

    def handleMouseEnterEvent(self, comp):
        self.on_hover_callback(self, True)
        return Interceptor.handleMouseEnterEvent(self, comp)

    def handleMouseButtonEvent(self, comp, event):
        if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
            self.on_click_callback(self)
            cur_click = Vector2(event.cursorPosition)
            if self._prev_click[0].distTo(cur_click) <= 0.05 and BigWorld.time() - self._prev_click[1] < 0.3:
                self._prev_click = (cur_click, 0)
                self.on_dbl_click_callback(self)
            else:
                self._prev_click = (cur_click, BigWorld.time())
        return Interceptor.handleMouseButtonEvent(self, comp, event)

    def set_mode(self, mode):
        self.seat_mode = mode
        self._update_content()

    def _update_content(self):
        if self.seat_mode == SeatMode.Occupided:
            self.component.frame_image.visible = False
            self.component.full_image.visible = False
        elif self.seat_mode == SeatMode.Selected:
            self.component.frame_image.visible = False
            self.component.full_image.visible = True
            self.component.full_image.colour = (255, 255, 255, 255)
        elif self.seat_mode == SeatMode.Highlighted:
            self.component.frame_image.visible = False
            self.component.full_image.visible = True
            self.component.full_image.colour = (255, 255, 255, 125)
        elif self.seat_mode == SeatMode.Free:
            self.component.full_image.visible = False
            self.component.frame_image.visible = True
        else:
            RuntimeError


class Boxes:

    def __init__(self, component):
        self.component = component
        self._boxes = []

        def create_box(position):
            comp = GUI.Window('soGUI/frame/helicopter/Box.dds')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = comp.texture.width, comp.texture.height
            comp.position = position
            self.component.addChild(comp)
            self._boxes.append(comp)

        create_box((297, 295, 0.5))
        create_box((249, 295, 0.5))
        create_box((201, 295, 0.5))
        self.apply_count(0)

    def apply_count(self, count):
        for i, comp in enumerate(self._boxes):
            comp.visible = i < count
            comp.colour = (255, 255, 255, 255) if i + len(self._boxes) < count else (255, 255, 255, 125)


