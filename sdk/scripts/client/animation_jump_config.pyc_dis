        print '},'

    def __repr__(self):
        return 'jump[%s-%s]' % (self.ID, self.name)

    def __str__(self):
        return repr(self)

    def getWaitFrame(self, cur_frame, all_frame):
        if self.from_frame < 0:
            return 0
        if cur_frame >= self.from_frame and cur_frame <= self.to_frame:
            return 0
        if cur_frame < self.from_frame:
            return self.from_frame - cur_frame
        return all_frame - cur_frame + self.from_frame

    def getActions(self, jmp_status_id):
        if jmp_status_id == JSTAT_UP:
            return [self.action_up, self.action_fly]
        if jmp_status_id == JSTAT_FLY:
            return [self.action_fly]
        if jmp_status_id == JSTAT_FLY_HIGH:
            return [self.action_fly_high]
        if jmp_status_id == JSTAT_FLY_DOWN_STOP:
            return [self.action_down_stop]
        if jmp_status_id == JSTAT_FLY_DOWN_MOVE:
            return [self.action_down_move]
        if jmp_status_id == JSTAT_FLY_DOWN_HIGH:
            return [self.action_down_high]

    def getAllactions(self):
        return (self.action_up,
         self.action_fly,
         self.action_fly_high,
         self.action_down_stop,
         self.action_down_move,
         self.action_down_high)

    def isStatusForDown(self, jmp_status_id):
        return jmp_status_id in (JSTAT_FLY_DOWN_STOP, JSTAT_FLY_DOWN_MOVE, JSTAT_FLY_DOWN_HIGH)


class JUMPS:
    cls_instance = None
    dict_items = {}

    def __new__(cls, *args):
        print '__new__'
        if cls.cls_instance is None:
            cls.cls_instance = object.__new__(cls, *args)
        return cls.cls_instance

    def __init__(self):
        self._by_id = {}
        self._by_name = {}
        self._jmps = []
        for data in _jumps_data:
            jmp = _Jump_conf(data)
            self._by_id[jmp.ID] = jmp
            self._by_name[jmp.name] = jmp
            self._jmps.append(jmp)

    def __getitem__(self, key):
        return self._by_id[key]

    def getByName(self, name):
        return self._by_name.get(name)

    def findBestJump(self, player_speed, cur_anim_frame, all_frame, fall = False):
        best_jmp = None
        best_frame = None
        for jmp in self._jmps:
            if jmp.speed[0] <= player_speed and player_speed <= jmp.speed[1]:
                if cur_anim_frame < 0:
                    return jmp
                wait_frame = jmp.getWaitFrame(cur_anim_frame, all_frame)
                if wait_frame == 0:
                    return jmp
                if best_frame is None or wait_frame < best_frame:
                    best_jmp = jmp
                    best_frame = wait_frame

        if not best_jmp and fall:
            best_jmp = self.getByName('J_IDLE_FALL')
        return best_jmp


