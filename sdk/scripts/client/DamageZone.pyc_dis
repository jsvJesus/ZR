# Embedded file name: ./client/DamageZone.py
import BigWorld
from Items import ItemsCatalog
import FX
from FX.persistent_ext_bg import loadPersistentExtAsync
from Helpers.Caps import CAP_EXCLUDE

class DamageZone(BigWorld.Entity):
    FADE_TIME = 2.0

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.sfx = None
        self.targetCaps = [CAP_EXCLUDE]
        return

    def onEnterWorld(self, prereqs):
        self.model = BigWorld.Model('')
        damage_zone = ItemsCatalog.GetItemParam(self.parentType)['DamageZone']
        diametr = damage_zone['radius'] * 2
        self.model.scale = (diametr, diametr, diametr)
        sfx_name = damage_zone['sfx']
        if sfx_name:

            def on_load(prereqs):
                if self.isDestroyed:
                    return
                self.sfx = FX.PersistentExt(sfx_name, prereqs)
                self.sfx.attach(self.model)
                self.sfx.go()
                BigWorld.callback(damage_zone['life_time'] - DamageZone.FADE_TIME, self.sfx.stop)

            loadPersistentExtAsync([sfx_name], on_load)

    def onLeaveWorld(self):
        if self.sfx:
            self.sfx.detach()
        self.sfx = None
        return