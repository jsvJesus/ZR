        raise Exception

    def onFlagPosition(self, *e):
        raise Exception

    def getPVPteamName(self, team):
        key = {1: 'red',
         2: 'blue'}.get(team, '')
        if not key:
            return ''
        return lc('soPvPStats.instplayer.{0}'.format(key))


class PvpPlayerAvatar(PvpAvatar):
    _player_flags_returned = 0
    _players_kill_listen = False

    def onFlagPosition(self, red_pack, blue_pack):
        red_pos, red_home = csconstans.unpackPVPFlagPosition(red_pack)
        blue_pos, blue_home = csconstans.unpackPVPFlagPosition(blue_pack)
        BWPersonality.GUICore.pvpScoreUpdateFalgsState(red_home, blue_home)
        self.marks_data.pvp_flags_updated(blue_pos, red_pos)

    def roomErrMsgCode(self, code):
        print 'roomErrMsgCode', code
        msg = lc(CODE_ERR.getLocaliseKey(code))
        BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.GENERAL, msg)
        if BWPersonality.GUICore.rooms_win:
            BWPersonality.GUICore.rooms_win.on_server_error(code)

    def _connect_answer(self, e):
        ready = e == gui_jokes.askUserYesNo.YES
        if not ready:
            msg = lc('soPvPStats.instplayer.connect_cancelled')
            BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.GENERAL, msg)
        self.base.connectToPVPAnswer(ready)

    def _on_event_cabman_registered(self, e):
        is_agree = e == gui_jokes.askUserYesNo.YES
        if is_agree:
            self.base.unregister_cabman()
            if hasattr(self, '_registerPVP_func'):
                BigWorld.callback(0.5, self._registerPVP_func)

    def on_pvp_kill(self):
        pass

    def on_pvp_game_end(self, game_mode, isPrivate):
        pass

    def roomEvent(self, eventID, code, msg):
        print 'roomEvent', [eventID, code, msg]
        if eventID == csconstans.EVENT_PARTY_START_REG:
            if getattr(self, '_ask_topvp', None):
                self._ask_topvp.close()

            def callback(answer):
                self.base.onAnswerRegPartyPVP(answer == gui_jokes.askUserYesNo.YES)
                self._ask_topvp = None
                return

            pvpConfID = code
            title = lc('soPvPStats.instplayer.party_req_title')
            pvpname = pvp_inst_config.configs.get(pvpConfID, {}).get('title', 'NONE')
            pvpname = lc(pvpname)
            subtitle = lc('soPvPStats.instplayer.party_req_text').format(msg, pvpname)
            self._ask_topvp = gui_jokes.askUserYesNoDelayDeafultNo(title, subtitle, callback, timer=csconstans.PARTY_REG_TIMEOUT)
            playSound('ui/flag_capture')
            return
        elif eventID == csconstans.EVENT_FORCE_CHOICE_TEAM:
            BigWorld.callback(3, lambda : BWPersonality.GUICore.showChoiceTeam(True, True))
            return
        else:
            print_to_up = True
            print_to_chat = True
            text = None
            if eventID == csconstans.EVENT_FLAG_CAPTURED:
                playSound('ui/flag_capture')
                if self.teamID == code:
                    text = lc('soPvPStats.instplayer.flag_captured_enemy').format(name=msg)
                else:
                    text = lc('soPvPStats.instplayer.flag_captured').format(name=msg)
            if eventID == csconstans.EVENT_FLAG_COUNTED:
                playSound('ui/flag_base')
                if self.teamID == code:
                    text = lc('soPvPStats.instplayer.flag_counted_enemy').format(name=msg)
                else:
                    text = lc('soPvPStats.instplayer.flag_counted').format(name=msg)
            if eventID == csconstans.EVENT_FLAG_RETURN_TO_BASE:
                if self.teamID == code:
                    text = lc('soPvPStats.instplayer.flag_return').format(name=msg)
                else:
                    text = lc('soPvPStats.instplayer.flag_return_enemy').format(name=msg)
                if msg == self.name:
                    self._player_flags_returned += 1
            if eventID == csconstans.EVENT_PARTY_TIMEOUT_REG:
                text = lc('soPvPStats.instplayer.party_timeout_reg').format(msg)
            if eventID == csconstans.EVENT_PARTY_OK_REG:
                text = lc('soPvPStats.instplayer.party_ok_reg').format(msg)
            if eventID == csconstans.EVENT_PARTY_CANCEL_REG:
                text = lc('soPvPStats.instplayer.party_cancel_reg').format(msg)
            if eventID == csconstans.EVENT_SEASON_REWARD_NOT_FOUND:
                text = lc('soPvPStats.instplayer.season_reward_not_found').format(msg)
            if eventID == csconstans.EVENT_SEASON_REWARD_ERR:
                text = lc('ERROR!')
            if eventID == csconstans.EVENT_SEASON_REWARD_OK:
                text = lc('soPvPStats.instplayer.season_reward_ok').format(msg)
            if eventID == csconstans.EVENT_PLAYER_CHANGE_TEAM:
                print_to_up = False
                team = self.getPVPteamName(code)
                text = lc('soPvPStats.instplayer.player_change_team').format(name=msg, team=team)
            if eventID == csconstans.EVENT_PLAYER_LEAVE:
                print_to_up = False
                text = lc('soPvPStats.instplayer.player_leave').format(msg)
            if eventID == csconstans.EVENT_START_CONNECT:
                text = lc('soPvPStats.instplayer.start_connect')
                print_to_chat = False
                title = lc('soPvPStats.instplayer.connect_title')
                if self.dead:
                    connask = lc('soPvPStats.instplayer.dead_connect_text')
                    enter_enable = lambda : not self.dead
                else:
                    connask = lc('soPvPStats.instplayer.connect_text')
                    enter_enable = None
                gui_jokes.askUserYesNoDelayDeafultNo(title, connask, self._connect_answer, csconstans.CONNECT_ASK_DELAY - 1, show_timer_btn=True, closeBox=False, bg_color=(40, 40, 40, 50), enter_enable=enter_enable)
                playSound('ui/flag_capture')
            if eventID == csconstans.EVENT_REM_FROM_QUEUE_OK:
                text = lc('soPvPStats.instplayer.rem_from_queue_ok')
            if eventID == csconstans.EVENT_GAME_START:
                playSound('music/volcano_event/start')
                text = lc('soPvPStats.instplayer.start_game')
                BWPersonality.GUICore.pvpScoreStartRound()
                self._player_flags_returned = 0
                self._players_kill_listen = True
            if eventID == csconstans.EVENT_EXTRA_TIME:
                text = lc('soPvPStats.instplayer.event_extra_time')
                BWPersonality.GUICore.pvpScoreStartExtraTime()
            if eventID == csconstans.EVENT_ADD_TO_QUEUE_OK:
                text = lc('soPvPStats.instplayer.add_to_queue_ok').format(code)
            if eventID == csconstans.EVENT_ADD_PARTY_TO_QUEUE_OK:
                text = lc('soPvPStats.instplayer.add_party_to_queue_ok').format(code)
            if eventID == csconstans.EVENT_PLAYER_GAME_WIN:
                isPrivate = code
                playSound('music/volcano_event/defeat')
                text = lc('soPvPStats.instplayer.playerwon').format(msg)
                BWPersonality.GUICore.pvpScoreWinPlayer(text)
                BWPersonality.GUICore.showPVPScoreBarPlayerList(True)
                self.on_pvp_game_end(self.pvpInstConfig['gamePlay'], isPrivate)
                self._players_kill_listen = False
            if eventID == csconstans.EVENT_TEAM_GAME_WIN:
                isPrivate = code & 8
                code &= -9
                if code == csconstans.TEAM_NO:
                    playSound('music/volcano_event/defeat')
                    text = lc('soPvPStats.instplayer.dead_heat')
                else:
                    if self.teamID == code:
                        playSound('music/volcano_event/victory')
                    else:
                        playSound('music/volcano_event/defeat')
                    text = lc('soPvPStats.instplayer.win').format(self.getPVPteamName(code))
                BWPersonality.GUICore.pvpScoreWinTeam(code)
                BWPersonality.GUICore.showPVPScoreBarPlayerList(True)
                self.on_pvp_game_end(self.pvpInstConfig['gamePlay'], isPrivate)
                self._players_kill_listen = False
            if eventID == csconstans.EVENT_RANK_LEVELUP:
                print_to_up = True
                rank = pvp_rating_config.conf[code]
                rank_name = lc(rank['name'])
                text = lc('soPvPStats.instplayer.rank_levelup').format(rank_name)
                playSound('ui/flag_base')
            if eventID == csconstans.EVENT_MAX_PAUSE_DESTROY:
                text = lc('soPvPStats.instplayer.event_max_pause_destroy')
            if eventID == csconstans.EVENT_GINGERBREAD_MONSTR_DEAD:
                text = lc('soPvPStats.instplayer.event_gingerbread_monstr_dead')
            if eventID == csconstans.EVENT_START_ROUND:
                playSound('music/volcano_event/start')
                text = lc('soPvPStats.instplayer.start_round')
                if code:
                    if self.teamID == code:
                        text += '\n' + lc('soPvPStats.instplayer.round_attack')
                    else:
                        text += '\n' + lc('soPvPStats.instplayer.round_defence')
                BWPersonality.GUICore.pvpScoreStartRound()
            elif eventID == csconstans.EVENT_ROUND_WIN:
                playSound('ui/flag_base')
                text = lc('soPvPStats.instplayer.win_round').format(self.getPVPteamName(code))
            if eventID == csconstans.EVENT_CREATE_ROOM_SUCCESS:
                BWPersonality.GUICore.showCreateRoom(False)
            if eventID == csconstans.EVENT_COOLDOWN_REGISTER:
                text = lc('soPvPStats.instplayer.EVENT_COOLDOWN_REGISTER').format(code)
            if eventID == csconstans.EVENT_CABMAN_REGISTERED:
                _title = lc('soPvPStats.instplayer.connect_title')
                _text = lc('soPvPStats.instplayer.event_cabman_registered_text')
                gui_jokes.askUserYesNoDelayDeafultNo(_title, _text, self._on_event_cabman_registered, csconstans.CONNECT_ASK_DELAY - 1, show_timer_btn=True, closeBox=False, bg_color=(40, 40, 40, 50))
            if text:
                if print_to_up:
                    self.systemMessage(text, 16711935)
                if print_to_chat:
                    BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.GENERAL, text)
            if eventID == csconstans.EVENT_GINGERBREAD_WAIT_PLAYERS:
                BWPersonality.GUICore.pvpScorePauseRound()
            if eventID == csconstans.EVENT_GINGERBREAD_PLAY:
                if self.teamID == csconstans.TEAM_BLUE:
                    self.systemMessage(lc('soPvPStats.MSG.GB_PLAY_MONSTER'), 16711935)
                else:
                    self.systemMessage(lc('soPvPStats.MSG.GB_PLAY_HUMAN'), 16711935)
                BWPersonality.GUICore.pvpScoreStartRound()
            if eventID == csconstans.EVENT_GINGERBREAD_WIN_MONSTR:
                playSound('music/volcano_event/defeat')
            if eventID == csconstans.EVENT_GINGERBREAD_WIN_HUMAN:
                playSound('music/volcano_event/victory')
            BWPersonality.GUICore.pvpScoreEvent(eventID, code, msg)
            return

    def onCheckSeasonReward(self, data):
        BWPersonality.GUICore.setBoardSeasonReward(data)

    def onRatingPage(self, data, all_count):
        BWPersonality.GUICore.setBoardRatingPage(data, all_count)

    def onBoardPVPInfo(self, data):
        BWPersonality.GUICore.setBoardPVPInfo(data)

    def onBoardPVPRooms(self, data):
        BWPersonality.GUICore.setBoardPVPRooms(data)

    def onBoardPVPSeasonalEventsInfo(self, data):
        BWPersonality.GUICore.setBoardPVPSeasonalEventsInfo(data)

    def on_roomData(self, data):
        self.last_roomData = data
        BWPersonality.GUICore.setScoreData(data)

    def on_roomData2(self, data):
        self.last_roomData = data
        BWPersonality.GUICore.setScoreData(data)

    def canShowPVPFriendMark(self):
        if self.inPVPinstance and self.pvpInstConfig['gamePlay'] in csconstans.ENABLE_PVP_MARK:
            return True
        return False

    def set_inPVPinstance(self, userID):
        BWPersonality.GUICore.change_inPVPinstance(self.inPVPinstance)
        if not self.inPVPinstance:
            BWPersonality.GUICore.showPVPScoreBarPlayerList(False)
        if not self.inPVPinstance:
            BWPersonality.GUICore.showChoiceTeam(False)

    def _updateChoiceTeam(self):
        if not self.inPVPinstance:
            return
        if self.pvpInstConfig['gamePlay'] in (csconstans.GAMEPLAY_TEAM_DM, csconstans.GAMEPLAY_FLAG, csconstans.GAMEPLAY_BUTTON_MODE):
            BWPersonality.GUICore.showChoiceTeam(True, blackBG=True)

    def onSpaceEntered(self):
        if not self.inPVPinstance:
            return
        if self.pvpInstConfig['gamePlay'] in (csconstans.GAMEPLAY_TEAM_DM, csconstans.GAMEPLAY_FLAG, csconstans.GAMEPLAY_BUTTON_MODE):
            BWPersonality.GUICore.showChoiceTeam(True, blackBG=True)
        elif self.pvpInstConfig['gamePlay'] == csconstans.GAMEPLAY_NY_SNOWBALLS_TEAM_DM:
            pass
        else:
            self.base.changeTeam(csconstans.TEAM_RED)

    def getBoardPVPInfo(self):
        if self.isEventsSpace():
            self.base.getNYBoardPVPInfo()
        else:
            self.base.getBoardPVPInfo()

    def getBoardPVPRooms(self):
        self.base.getBoardPVPRooms2()

    def getBoardPVPSeasonalEventsInfo(self):
        self.base.getBoardPVPSeasonalEventsInfo()

    @property
    def pvpInstConfig(self):
        return pvp_inst_config.configs.get(self.inPVPinstance, {})

    def set_teamID(self, old):
        print 'playerAvatar  (%s) set_teamID :' % self.id, old, '->', self.teamID
        BWPersonality.GUICore.onChangeTeamPVP(self.teamID)
        if not self.teamID:
            BWPersonality.GUICore.clearAllPVPmarkers()
            BWPersonality.GUICore.showPVPmarker(False)
            return
        if self.canShowPVPFriendMark():
            BWPersonality.GUICore.showPVPmarker(True)
            BWPersonality.GUICore.clearAllPVPmarkers()
            for entity in BigWorld.entities.values():
                if entity.id == self.id:
                    continue
                if entity.__class__.__name__ == 'Avatar':
                    if entity.teamID == self.teamID:
                        BWPersonality.GUICore.addPVPmarker(entity.id, entity.matrix)

    def onAvatarTeamIDChanged(self, userID, old_teamID, teamID):
        if self.teamID:
            if teamID == self.teamID and self.canShowPVPFriendMark():
                BWPersonality.GUICore.addPVPmarker(userID, BigWorld.entity(userID).matrix)
            else:
                BWPersonality.GUICore.delPVPmarker(userID)

    def on_roomKill(self, teamIDAgr, teamIDVic, agrName, vicName):
        red = '"#ff0a0a"'
        blue = '"#0a0aff"'
        white = '"#\xd1\x810\xd1\x810\xd1\x810"'

        def getcolor(team):
            if team == csconstans.TEAM_RED:
                return red
            if team == csconstans.TEAM_BLUE:
                return blue
            return white

        def coltag(team, text):
            col = getcolor(team)
            return '<font color=%s>%s</font>' % (col, text)

        def _lc_name(name):
            if self.pvpInstConfig['gamePlay'] == csconstans.GAMEPLAY_NY_SNOWBALLS_TEAM_DM:
                return lc('soPvPStats.soGUI.NY_SNOWBALLS_TEAM_DM_PLAYER_NAME')
            return name

        msg = u''
        if not agrName:
            msg += coltag(teamIDVic, _lc_name(vicName)) + '  ' + lc('soPvPStats.instplayer.suicide')
        else:
            msg += coltag(teamIDAgr, _lc_name(agrName)) + ' ' + lc('soPvPStats.instplayer.kill') + '  ' + coltag(teamIDVic, _lc_name(vicName))
        BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.GENERAL, msg)
        if self._players_kill_listen and agrName == self.name:
            self.on_pvp_kill()

    def showAskToGingerbread(self, timeout):

        def callback(event, data):
            answer = data.get('btn') == MESSAGEBOX.BTN_OK
            self.base.answerToGingerbread(answer)

        title = lc('soPvPStats.showAskToGingerbread.title')
        subtitle = lc('soPvPStats.showAskToGingerbread.subtitle')
        msg_id = 'showAskToGingerbread'
        addControls = [{'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
          'ID': 'main_txt_field',
          'text': subtitle,
          'hAnchor': MESSAGEBOX.ANCHOR_CENTER}]
        BWPersonality.GUICore.showMsgBox(msg_id, width=500, caption=title, btn_set=[{'type': MESSAGEBOX.BTN_OK,
          'width': 200}, {'type': MESSAGEBOX.BTN_CANCEL,
          'width': 200}], timeout=timeout, closeBox=True, defaultAction=MESSAGEBOX.BTN_CANCEL, addControls=addControls, callback=callback)

    def is_registered_PVP(self):
        soBulletinBoard = BWPersonality.GUICore.soBulletinBoard
        if soBulletinBoard:
            for d in soBulletinBoard.pvpboard._rooms_info:
                if d['is_registered']:
                    return True

            if getattr(soBulletinBoard, 'pvp_seasonal_events_board', None):
                for d in soBulletinBoard.pvp_seasonal_events_board._rooms_info:
                    if d['is_registered']:
                        return True

        return False