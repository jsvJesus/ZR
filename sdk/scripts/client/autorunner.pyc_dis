# Embedded file name: ./client/autorunner.py
import BWPersonality
import BigWorld

class Autorunner:

    def __init__(self, player):
        self._p = player
        self._running = False
        self._ignore_unsprint = False
        self._callack_handler = None
        return

    def on_sprint_btn(self, event):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82, \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbb\xd0\xb8 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb5 """
        if not self._running:
            return False
        if event:
            if not event.isKeyDown():
                if self._ignore_unsprint:
                    self._ignore_unsprint = False
                    return True
        return False

    def on_move_btn(self, event):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82, \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbb\xd0\xb8 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb5 """
        if not self._running:
            return False

        def get_bind(action):
            return BWPersonality.settings.keyBindings.getBindingsForAction(action)[0][0]

        if event:
            if not event.isKeyDown():
                if event.key == get_bind('MoveForward'):
                    return True
                else:
                    return False
            if event.isRepeatedEvent():
                return False

        def mild_stop():
            self._running = False
            BigWorld.cancelCallback(self._callack_handler)
            self._callack_handler = None
            return

        if event.key == get_bind('MoveForward'):
            mild_stop()
            return False
        if event.key == get_bind('MoveBackward'):
            mild_stop()
            self._p.moveForward(False)
            return False
        return True

    def try_toggle(self):
        if self._running:
            self.stop()
        elif self._p.isPlayerPressMove() and self._can_use():
            self._p.moveForward(True)
            self._ignore_unsprint = False
            if self._p._sprint_key_pressed:
                self._p.SetSprinting(True)
                self._ignore_unsprint = True
            self._p.UpdateVelocity()
            self._running = True
            self._callack_handler = BigWorld.callback(0, self._tick)

    def _tick(self):
        if self._can_use() and self._p.isPlayerPressMove():
            self._callack_handler = BigWorld.callback(0, self._tick)
        else:
            self.stop()

    def stop(self):
        if self._running:
            self._ignore_unsprint = False
            self._running = False
            self._p.SetSprinting(False)
            self._p.moveForward(False)
            BigWorld.cancelCallback(self._callack_handler)
            self._callack_handler = None
        return

    def _can_use(self):
        if not self._p or self._p.isDestroyed:
            return False
        if self._p.dead:
            return False
        return True