    def set_CarryingItems(self, old_value):
        if inRange(self, BigWorld.player(), Constants.INTERACTION_DISTANCE ** 2):
            BigWorld.player().NeedToUpdateItemCache()
        items, _ = BigWorld.player().filterItemsWithoutQuests(self.CarryingItems)
        if not items:
            BigWorld.player().NeedToCloseItemCache(self)

    def isPersistentSfxEnableForWeather(self):
        return True

    def isOutsideShell(self):
        res = BigWorld.isOtside(self.spaceID, self.position)
        return res > 0

    def _has_positive_bonus(self, bonus_id, rep_id, rep_value):
        bonus_value = rep_utils.get_bonus_value(rep_id, bonus_id)
        return bool(bonus_value is not None and rep_value >= bonus_value)

    def _on_repvalue_got(self, group_id, value):
        if self.get_aggr_group() != group_id:
            return
        else:
            penalty_value = rep_utils.get_bonus_value(group_id, Bonus.Enemy)
            if penalty_value is not None:
                self._player_war = value <= penalty_value
                self._type_rep = self._has_positive_bonus(Bonus.RepeatQuests, group_id, value) and NPCSound.GOOD_REP
            elif self._has_positive_bonus(Bonus.Resp, group_id, value):
                self._type_rep = NPCSound.MID_REP
            else:
                self._type_rep = NPCSound.BAD_REP
            return

    @property
    def ignorePK(self):
        return self.bit_flags & 1

    @property
    def ignorePVP(self):
        return self.bit_flags & 2

    @property
    def ignoreWAR(self):
        return self.bit_flags & 4

    @property
    def isAgressive(self):
        return self.bit_flags & 8

    def _is_aggressive(self):
        if self.isAgressive:
            return True
        player = BigWorld.player()
        if not player:
            return
        if not self.ignorePVP:
            if player.AgrFlag:
                return True
        if not self.ignoreWAR:
            if getattr(self, '_player_war', False):
                return True
        if not self.ignorePK:
            if player.karma >= CharacterConst.PK_KARMA_PER_AGGR:
                return True
        if self.clanName and player.clanName and self.clanName in player.clanEnemies:
            return True

    def get_nametext_color(self):
        if self.get_clantext_color() == cc.mark_clan_in_alliance:
            return cc.mark_name
        if self._is_aggressive():
            return cc.mark_clan_in_war
        return cc.mark_name

    def get_clantext_color(self):
        player = BigWorld.player()
        if player.clanName and self.clanName in player.clanEnemies:
            return cc.mark_clan_in_war
        if player.clanID and self.clanName == player.clanUnion:
            return cc.mark_clan_in_alliance
        return cc.mark_clan_neutral

    def setWaypoint(self, position):
        print 'setWaypoint', position
        import DrawPrimitivesUtils
        DrawPrimitivesUtils.clear_drawings()
        DrawPrimitivesUtils.draw_sphere(position, 0.5)

