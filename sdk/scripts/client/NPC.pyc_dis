    @lazyproperty
    def repair_classes(self):
        """ \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb5 \xd1\x83\xd0\xbc\xd0\xb5\xd0\xb5\xd1\x82 \xd1\x87\xd0\xb8\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c """
        result = set([])
        if Constants.REPAIROPT_WEAPON in self.getAdditionalParam('repair_type'):
            result.add(ItemsCatalog.WEAPON)
        if Constants.REPAIROPT_CLOTHER in self.getAdditionalParam('repair_type'):
            result.add(ItemsCatalog.CLOTH)
        if Constants.REPAIROPT_GADGET in self.getAdditionalParam('repair_type'):
            result.add(ItemsCatalog.GADGET)
        return result

