# Embedded file name: ./client/UseFakeItemTrigger.py
import BigWorld
import ResMgr
import json
import traceback
from Helpers.Caps import CAP_CAN_PICKUP
from Localization import lc
from Items import ItemsCatalog
section = ResMgr.openSection('scripts/common/EnumProps/ModelSelector.json')
CONFIG = json.loads(section.asBinary)['model_index']['values']

class UseFakeItemTrigger(BigWorld.Entity):

    def __init__(self):
        self.height = 1.0
        BigWorld.Entity.__init__(self)
        self.targetCaps = [CAP_CAN_PICKUP]
        self.name = self.get_mark_text()
        self._model_path = str(next((model for index, model in CONFIG if index == self.modelSelect), ''))

    def prerequisites(self):
        if self._model_path:
            return [self._model_path]

    def onEnterWorld(self, prereqs):
        if not self._model_path:
            self.model = BigWorld.Model('')
            return
        try:
            self.model = prereqs[self._model_path]
        except:
            print 'ERROR LOAD MODEL: %r' % self._model_path, self, self.modelSelect, self.position
            traceback.print_exc()
            self.model = BigWorld.Model('models/bolvan/helpers/xyz.model')

    def onLeaveWorld(self):
        self.model = None
        return

    def get_mark_text(self):
        text = u'????????'
        item_param = ItemsCatalog.GetItemParam(self.useItemType)
        if item_param and item_param.get('Action_use_name_local'):
            text = lc(item_param.get('Action_use_name_local'))
        return text

    def interact(self, avatar):
        self.cell.interact()