_DEBUG = False
_AUTOSAVE_PATH = os.path.join(utils.stalker_path(), 'usercontent/backup.fcd')
_AUTOSAVE_PERIOD = 30

class FaceCustomizer:
    """ \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0 \xd1\x80\xd1\x83\xd1\x87\xd0\xbd\xd1\x83\xd1\x8e \xd0\xbb\xd0\xb5\xd0\xbf\xd0\xba\xd1\x83 \xd0\xbb\xd0\xb8\xd1\x86\xd0\xb0 """
    last_face_file_name = '../res/headpresets'

    def __init__(self, dummy):
        self._dummy = dummy
        self._debug_win = None
        self._params_win = None
        self._setup_renderer()
        self._destroyed = False
        self._next_save_time = BigWorld.time() + _AUTOSAVE_PERIOD
        BigWorld.callback(0, self._tick)
        self._face_controller = FaceController.create_controller(self)
        self._face_controller.dynamic = True
        self._selected_bone_name = None
        self._mouse_pos = None
        self._plane_fader = PlaneFader()
        self._locked = True
        self._save_dialog = None
        self._open_dialog = None
        self._head_node = self._dummy.model.node('Head')
        self.on_enter_game_callback = lambda : None
        BWPersonality.GUICore.face_debug_win = self
        return

    @property
    def face_limits_type(self):
        return self._dummy.face_limits_type

    def lock(self, value):
        self._locked = value
        if not self._locked and not self._params_win and _DEBUG:
            self.show_params_win()

    def show_debug_win(self):
        self._debug_win = FaceCustomizerWin()
        self._debug_win.show(self._mr.texture)

    def show_params_win(self):
        self._params_win = FaceDebugWin(self._dummy.face_limit_type == LC.NPC)
        self._params_win.show()
        self._params_win.limits_changed_callback = self._limits_changed
        self._params_win.npc_mode_callback = self._npc_mode_changed

    def _setup_renderer(self):
        self._model = BigWorld.Model('characters2/basemodel/StalkerBase2.model', 'characters2/clothing/ManNude/HeadZone/ManHeadZone_colored.model')
        self._model.origin('Head')
        size = BigWorld.screenSize()
        if size[0] > 512 or size[1] > 512:
            factor = 512.0 / max(size[0], size[1])
            size = (size[0] * factor, size[1] * factor)
        self._mr = BigWorld.PyModelRenderer(int(size[0]), int(size[1]))
        self._mr.addAmbientColor((1, 1, 1, 1))
        self._mr.viewMatrix = BigWorld.camera().matrix
        self._mr.dynamic = True
        self._mr.models = [self._model]
        self._mr.nearPlane = 0.1
        self._mr.farPlane = 10
        self._mr.fov = FOV

        def random_color():
            colors = set()
            step = 25
            while True:
                color_step = (randint(0, step), randint(0, step), randint(0, step))
                if color_step in colors:
                    continue
                colors.add(color_step)
                homo_color = (color_step[0] / float(step),
                 color_step[1] / float(step),
                 color_step[2] / float(step),
                 1.0)
                yield (homo_color, color_step)

        randomcolor_generator = random_color()
        self.color_to_bone = {}
        for i, material_name in enumerate(FaceSettings.plane_config.keys()):
            if not hasattr(self._model, material_name):
                print "FaceCustomizer (ERROR): can't find plane named", material_name
                continue
            try:
                setattr(self._model, material_name, 'colored')
                homo_color, color_step = randomcolor_generator.next()
                getattr(self._model, material_name).g_colour = homo_color
                self.color_to_bone[color_step] = material_name
            except Exception as e:
                print "FaceCustomizer (ERROR): can't set shader color for", material_name, e

    def _tick(self):
        if self._destroyed:
            return
        elif BigWorld.player().__class__.__name__ == 'PlayerAvatar':
            self.on_enter_game_callback()
            return
        else:
            if BigWorld.player() and BigWorld.player().accessLevel == 6 and BigWorld.isKeyDown(Keys.KEY_F3) and not self._params_win and BigWorld.player().dummy._face_mode:
                self.show_params_win()
            self._model.setWorldTransform(Matrix(self._head_node))
            raw_data = getattr(getattr(self._dummy, 'face_controller', None), 'raw_data', None)
            if raw_data is not None:
                self._face_controller.raw_data = self._dummy.face_controller.raw_data
            if self._locked:
                if self._selected_bone_name:
                    self._plane_selected(None, self._selected_bone_name)
                    self._selected_bone_name = None
            else:
                mouse_pos = BWPersonality.game.mcursor.position

                def int_to_color_step(col):

                    def to_step(value):
                        return math_bw.clamp(int(value / 255.0 * 26.0), 0, 25)

                    r = 255 & col >> 16
                    g = 255 & col >> 8
                    b = 255 & col
                    return (to_step(r), to_step(g), to_step(b))

                if BigWorld.isKeyDown(Keys.KEY_RIGHTMOUSE):
                    bone_name = None
                elif BigWorld.isKeyDown(Keys.KEY_LEFTMOUSE):
                    bone_name = self._selected_bone_name
                else:
                    color_int = self._mr.texture.getColour(int(math_bw.clamp(self._mr.texture.width * math_bw.clamp((mouse_pos[0] + 1.0) * 0.5), 0, self._mr.texture.width - 1)), int(math_bw.clamp(self._mr.texture.height * math_bw.clamp(1.0 - (mouse_pos[1] + 1.0) * 0.5), 0, self._mr.texture.height - 1)))
                    color_step = int_to_color_step(color_int)
                    bone_name = self.color_to_bone.get(color_step)
                if self._selected_bone_name != bone_name:
                    self._plane_selected(bone_name, self._selected_bone_name)
                    self._selected_bone_name = bone_name
                if self._mouse_pos != mouse_pos:
                    if self._selected_bone_name and BigWorld.isKeyDown(Keys.KEY_LEFTMOUSE):
                        self._drag_plane(self._mouse_pos, mouse_pos, self._selected_bone_name)
                    self._mouse_pos = mouse_pos
            BigWorld.callback(0, self._tick)
            if BigWorld.player() and BigWorld.player().accessLevel == 6 and BigWorld.time() >= self._next_save_time:
                self._next_save_time = BigWorld.time() + _AUTOSAVE_PERIOD
                self._autosave()
            return

    def _plane_selected(self, plane_name, prev_plane_name):
        if prev_plane_name:
            self._plane_fader.hide_fade(self._dummy.model, prev_plane_name)
        if plane_name:
            self._plane_fader.show_fade(self._dummy.model, plane_name)
        DummyRotating().lock(bool(plane_name))
        if self._params_win and plane_name:
            self._params_win.update_last_selected_plain(plane_name)

    def _drag_plane(self, from_pos, to_pos, plane_name):
        handles_list = FaceSettings.plane_config[plane_name]
        if handles_list:
            self._dummy.face_controller.drag_handles(from_pos, to_pos, handles_list)
            self._face_controller.raw_data = self._dummy.face_controller.raw_data
        if self._params_win and plane_name:
            self._params_win.update_last_dragged_plain(plane_name)
            if handles_list:
                handles = [ self._face_controller.name_to_handle[h] for h in handles_list ]
                self._params_win.update_last_dragged_position(handles[0].raw_data.translation)
                self._params_win.update_last_dragget_scale(math_bw.getScaleMatrix(handles[0].raw_data))
        self._on_face_changed()

    def _on_face_changed(self):
        pass

    def doReposition(self):
        self._mr.dynamic = False
        self._setup_renderer()

    def destroy(self):
        self._dummy = None
        self._mr.dynamic = False
        self._destroyed = True
        self._plane_fader.destroy()
        BWPersonality.GUICore.face_debug_win = None
        if self._params_win:
            self._params_win.hide()
        FaceController.destroy_controller(self)
        self._face_controller = None
        return

    def _npc_mode_changed(self, npc_mode):
        self._dummy.on_npc_face_type_click(npc_mode)

    def _limits_changed(self):
        self._face_controller.limites_changed()
        self._dummy.face_controller.limites_changed()

    def _on_file_open(self, file_name):
        BWPersonality.GUICore.loginFlash.component.focus = True
        if not file_name:
            return
        FaceCustomizer.last_face_file_name = file_name
        with open(file_name, 'r') as f:
            personality = json.load(f)
            self._dummy.set_loaded_personality(personality)

    def _on_file_save(self, file_name):
        BWPersonality.GUICore.loginFlash.component.focus = True
        if not file_name:
            return
        FaceCustomizer.last_face_file_name = file_name
        with open(file_name, 'w+') as f:
            personality = self._dummy.read_personality()
            face_parts = {}
            for slot_type in EST.get_face_slots():
                face_parts[slot_type] = EST.get_slot_data(self._dummy, slot_type)

            import utils
            personality, face_parts = utils.PY(personality), utils.PY(face_parts)
            json.dump((personality, face_parts), f)

    def _autosave(self):
        self._on_file_save(_AUTOSAVE_PATH)

    def on_face_load_click(self):
        if not self._save_dialog:
            self._save_dialog = OpenFileDialog(GUI.Window())
            BWPersonality.GUICore.loginFlash.component.focus = False
        self._save_dialog.show(self._on_file_open, init_dir=FaceCustomizer.last_face_file_name, filters=['.fcd'])

    def on_face_save_click(self):
        if not self._open_dialog:
            self._open_dialog = SaveFileDialog(GUI.Window())
            BWPersonality.GUICore.loginFlash.component.focus = False
        self._open_dialog.show(self._on_file_save, init_dir=FaceCustomizer.last_face_file_name, filters=['.fcd'])

    @property
    def model(self):
        return self._model


