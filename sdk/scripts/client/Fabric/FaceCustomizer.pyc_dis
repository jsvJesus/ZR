    def _check_click(self):
        if self.npc_mode_callback:
            self.npc_mode_callback(self._cb.isChecked())

    def _on_reload_click(self):
        if self.limits_changed_callback:
            self.limits_changed_callback()

    def _generate_portraits(self):
        import npc_portraits
        self.component.win_frame.genbutton.script.setDisabledState(True)

        def completed():
            self.component.win_frame.genbutton.script.setDisabledState(False)

        npc_portraits.run(completed)

    def _on_buffer_pos_click(self):
        buffer_text = self._last_dragged_text.text + '\n' + self._last_dragged_position.text
        BigWorld.clipboardSetPlainText(buffer_text)

    def _on_buffer_scale_click(self):
        buffer_text = self._last_dragged_text.text + '\n' + self._last_dragged_scale.text
        BigWorld.clipboardSetPlainText(buffer_text)

    def update_last_selected_plain(self, plane_name):
        self._last_selected_text.text = 'last selected plane: ' + plane_name

    def update_last_dragged_plain(self, plane_name):
        self._last_dragged_text.text = 'last dragged plane: ' + plane_name

    def update_last_dragged_position(self, position):
        self._last_dragged_position.text = 'last dragged position: ' + str(position)

    def update_last_dragget_scale(self, scale):
        self._last_dragged_scale.text = 'last dragged scale: ' + str(scale)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.generalLayer.addChild(self.component, 'face_debugger')
        self.component.visible = True
        return

    def hide(self):
        self.component.visible = False


class FaceCustomizerWin(PyGUIBase, DraggableComponent):
    """ \xd0\xb5\xd1\x89\xd1\x91 \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe \xd0\xb4\xd0\xb5\xd0\xb1\xd0\xb0\xd0\xb6\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe (\xd1\x80\xd0\xb5\xd0\xbd\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb8\xd1\x82 \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82\xd0\xbd\xd1\x83\xd1\x8e \xd1\x80\xd0\xbe\xd0\xb6\xd1\x83) """

    def __init__(self):
        component = GUI.Window()
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        component.script = self
        self.setupRoot()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def setupRoot(self):
        width = BigWorld.screenSize()[0] * 0.5
        height = BigWorld.screenSize()[1] * 0.5
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width, cmp.height = width, height
        cmp.position = (1.0, -1.0, 0.1)
        cmp.colour = (255, 255, 255, 100)
        cmp.materialFX = 'BLEND'
        cmp.visible = False
        cmp.dragFocus = True
        self.component.mouseButtonFocus = True
        cmp = GUI.Frame2('soGUI/frame/basic_frame_1.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width, cmp.height = width, height
        cmp.height = self.component.height
        cmp.position = (width * 0.5, height * 0.5, 1.0)
        self.component.addChild(cmp, 'win_frame')
        cmp = GUI.Simple('textures/default/blue_dark.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'SOLID'
        cmp.position = (width * 0.5, height - 37, 0.5)
        self.component.addChild(cmp, 'render_space')
        cmp.width, cmp.height = width - 4, height - 67

    def show(self, texture):
        if self.component.parent is None:
            BWPersonality.GUICore.generalLayer.addChild(self.component, 'face_customizer')
        self.component.visible = True
        if hasattr(self.component, 'render_space'):
            self.component.render_space.texture = texture
        return


UP, DOWN = xrange(2)
FADE_TIME = 0.5

class PlaneParams:

    def __init__(self, alpha, direction, original_color):
        self.alpha = alpha
        self.direction = direction
        self.original_color = original_color


class PlaneFader:
    """ \xd0\xb7\xd0\xb0\xd1\x82\xd1\x83\xd1\x85\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb8 \xd0\xb2\xd1\x82\xd1\x83\xd1\x85\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xbb\xd0\xb5\xd0\xb9\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb8 """

    def __init__(self):
        self._dyes = {}
        self._destroyed = False

    def get_color(self, plane_params):
        oc = plane_params.original_color
        return (oc[0],
         oc[1],
         oc[2],
         oc[3] * plane_params.alpha)

    def show_fade(self, model, dye):
        if not self._dyes:
            self.cur_time = BigWorld.time()
            BigWorld.callback(0, self.tick)
        setattr(model, dye, 'highlighted')
        key = (model, dye)
        if key in self._dyes:
            self._dyes[key].direction = UP
        else:
            self._dyes[key] = PlaneParams(0.0, UP, getattr(model, dye).g_colour)
        getattr(model, dye).g_colour = self.get_color(self._dyes[key])

    def hide_fade(self, model, dye):
        key = (model, dye)
        if key in self._dyes:
            self._dyes[key].direction = DOWN

    def destroy(self):
        self._destroyed = True

    def tick(self):
        if self._destroyed or not self._dyes:
            return
        dtime = (BigWorld.time() - self.cur_time) / FADE_TIME
        self.cur_time = BigWorld.time()
        for key in self._dyes.keys():
            try:
                getattr(key[0], key[1]).g_colour = self.get_color(self._dyes[key])
            except:
                print 'FaceCustomizer (ERROR): bad dye key', key, self._dyes, getattr(key[0], key[1]).tint
                self._dyes.clear()
                traceback.print_exc()
            else:
                if self._dyes[key].direction == UP:
                    self._dyes[key].alpha = min(self._dyes[key].alpha + dtime, 1.0)
                else:
                    self._dyes[key].alpha -= dtime
                    if self._dyes[key].alpha <= 0.0:
                        setattr(key[0], key[1], 'no_render')
                        del self._dyes[key]

        BigWorld.callback(0, self.tick)