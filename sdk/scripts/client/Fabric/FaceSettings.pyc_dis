class LimitsConfigurator(object):
    PLAYER, NPC = xrange(2)

    @staticmethod
    def _initialize():
        LimitsConfigurator._configs = {LimitsConfigurator.PLAYER: copy.deepcopy(_handle_config),
         LimitsConfigurator.NPC: copy.deepcopy(_handle_config)}
        LimitsConfigurator._apply_config_multiplier(LimitsConfigurator._configs[LimitsConfigurator.PLAYER], player_limit_factor)
        LimitsConfigurator._apply_config_multiplier(LimitsConfigurator._configs[LimitsConfigurator.NPC], npc_limit_factor)
        LimitsConfigurator._bones_config = {LimitsConfigurator.PLAYER: LimitsConfigurator._create_bones_configs(LimitsConfigurator.config(LimitsConfigurator.PLAYER)),
         LimitsConfigurator.NPC: LimitsConfigurator._create_bones_configs(LimitsConfigurator.config(LimitsConfigurator.NPC))}

    @staticmethod
    def _apply_config_multiplier(config, multiplier):
        for bone_config in config['handles'].values():
            for limit in bone_config['limits']:
                if 'Move' in limit:
                    bone_config['limits'][limit] = tuple((l * multiplier for l in bone_config['limits'][limit]))
                elif 'Scale' in limit:
                    bone_config['limits'][limit] = tuple(((l - 1.0) * multiplier + 1.0 for l in bone_config['limits'][limit]))

    @staticmethod
    def _create_bones_configs(handle_config):
        bones_set = set()
        bones_configs = []
        pairs = set()
        for bones_line in handle_config['bones']:
            for bone in bones_line:
                if bone in handle_config['handles'] and bone not in bones_set:
                    if bone in pairs:
                        continue
                    bones_set.add(bone)
                    config = handle_config['handles'][bone]
                    if 'pair' in config:
                        pairs.add(config['pair'])
                    bones_configs.append(config)

        return bones_configs

    @staticmethod
    def config(limits_type):
        return LimitsConfigurator._configs[limits_type]

    @staticmethod
    def bones_config(limits_type):
        return LimitsConfigurator._bones_config[limits_type]


LimitsConfigurator._initialize()