# Embedded file name: ./client/Fabric/Link.py
import DrawPrimitivesUtils
from DrawPrimitivesUtils import one_draw_line
from Element import Element
from spring_fabric_settings import SUCK_ALGORITHM0
import math_bw

class Link(Element):

    def __init__(self, parent_point, child_point, suck_algorithm, stretch):
        Element.__init__(self, None, None, None)
        self.parent_point, self.child_point = parent_point, child_point
        self._rest_position = parent_point.position - child_point.position
        self.rest_distance = self._rest_position.length
        self.suck_algorithm = suck_algorithm
        self.stretch = stretch
        return

    def fixed_update(self, dtime):
        p1_to_p2 = self.child_point.position - self.parent_point.position
        current_distance = p1_to_p2.length
        correction_vector = p1_to_p2 * (1 - self.rest_distance / current_distance) * (1.0 - self.stretch)
        correction_vector_half = correction_vector * 0.5

        def move_point_along(point, hit_entity, collision_position, suggested_position):
            if hit_entity.__class__.__name__ == 'BoxAttachment':
                reflection = hit_entity.getReflectionFromCollision(point.position, collision_position)
            else:
                reflection = math_bw.calculate_reflection(collision_position, collision_position - point.position, hit_entity)[0]
            if reflection:
                direction = collision_position - point.position
                reflection *= direction.length
                direction += reflection
                direction.normalise()
                direction *= (suggested_position - point.position).length
                next_position = point.position + direction
                if not point.collide_move(next_position):
                    point.position = next_position

        if self.parent_point.movable:
            next_position = self.parent_point.position + correction_vector_half
            collision = self.parent_point.collide_move(next_position)
            if collision:
                pass
            else:
                self.parent_point.position = next_position
        if self.child_point.movable:
            next_position = self.child_point.position - correction_vector_half
            collision = self.child_point.collide_move(next_position)
            if collision:
                if self.suck_algorithm == SUCK_ALGORITHM0:
                    move_point_along(self.child_point, collision[1], collision[0], next_position)
                    p1_to_p2 = self.child_point.position - self.parent_point.position
                    current_distance = p1_to_p2.length
                    correction_vector = p1_to_p2 * (1 - self.rest_distance / current_distance) * (1.0 - self.stretch)
                    correction_vector_half = correction_vector * 0.5
                    next_position = self.child_point.position - correction_vector_half
                    if not self.child_point.collide_move(next_position):
                        self.child_point.position = next_position
            else:
                self.child_point.position = next_position

    def draw(self, alpha):
        if self.parent_point.debug or self.child_point.debug:
            one_draw_line(self.parent_point.interpolated_position, self.child_point.interpolated_position)

    def relax(self):
        self.child_point.position = self.parent_point.position - self._rest_position