# Embedded file name: ./client/Fabric/face_randomizer.py
import ResMgr
import json
import math_bw
import random
from random import choice, randint
import FaceSaver
from EquipSlotsConfigs import EquipSlotTypes as EST

def compile_random_personality(seed, limits_type):
    return rprovider.compile_random_personality(seed, limits_type)


class RandomPersonalityProvider:

    def __init__(self):
        charmaker_data = ResMgr.openSection('scripts/common/data/charMakerFaceCfg.json')
        base_data = json.loads(charmaker_data.asBinary)
        for hair_data in base_data['4_hair']:
            label = hair_data['label']
            if label == 'hairstyle':
                data = hair_data['data'][0]['data']
                self._hair_types, self._hair_weights = [], []
                for w in data:
                    self._hair_types.append(w['item_id'])
                    self._hair_weights.append(w['weight'])

            elif label == 'beard':
                data = hair_data['data'][0]['data']
                self._beard_types = [ w['item_id'] for w in data ]
            elif label == 'mustache':
                data = hair_data['data'][0]['data']
                self._mustache_types = [ w['item_id'] for w in data ]
            elif label == 'eyebrows':
                data = hair_data['data'][0]['data']
                self._brows_types = [ w['item_id'] for w in data ]
            elif label == 'color':
                data = hair_data['data'][0]['colors']
                self._hcolors, self._hcolor_weights = [], []
                for d in data:
                    color, weight = d.split(':')
                    self._hcolor_weights.append(int(weight))
                    self._hcolors.append(int(color, 16))

        self._scolors, self._scolor_weights = [], []
        for skin_color in base_data['2_skin']['data'][0]['colors']:
            color, weight = skin_color.split(':')
            self._scolor_weights.append(int(weight))
            self._scolors.append(int(color, 16))

        self._ecolors, self._ecolor_weights = [], []
        for skin_color in base_data['3_eye']['data'][0]['colors']:
            color, weight = skin_color.split(':')
            self._ecolor_weights.append(int(weight))
            self._ecolors.append(int(color, 16))

    def rint(self):
        return randint(0, 255)

    def random_hair(self):
        random_index = math_bw.weighted_random(self._hair_weights)
        return {'itemID': 0,
         'itemType': self._hair_types[random_index]}

    def random_beard(self):
        return {'itemID': 0,
         'itemType': choice(self._beard_types)}

    def random_mustache(self):
        return {'itemID': 0,
         'itemType': choice(self._mustache_types)}

    def random_brows(self):
        return {'style': choice(self._brows_types),
         'position': self.rint(),
         'rotation': self.rint()}

    def random_hcolor(self):
        random_index = math_bw.weighted_random(self._hcolor_weights)
        return self._hcolors[random_index]

    def random_scolor(self):
        random_index = math_bw.weighted_random(self._scolor_weights)
        return self._scolors[random_index]

    def random_ecolor(self):
        random_index = math_bw.weighted_random(self._ecolor_weights)
        return self._ecolors[random_index]

    def compile_random_personality(self, seed, limits_type):
        random.seed(seed)
        face = FaceSaver.generate_random_face(limits_type)
        personality = {'face': face,
         'hairs': self.rint(),
         'moustache': self.rint(),
         'beard': self.rint(),
         'haircolor': self.random_hcolor(),
         'skincolor': self.random_scolor(),
         'eyescolor': self.random_ecolor(),
         'age': self.rint(),
         'details': self.rint(),
         'unshaven': self.rint(),
         'brows': self.random_brows(),
         'mark': {'id': 0,
                  'color': 0}}
        face_parts = {EST.HAIR: self.random_hair(),
         EST.BEARD: self.random_beard(),
         EST.MOUSTACHE: self.random_mustache()}
        random.seed()
        return (personality, face_parts)


rprovider = RandomPersonalityProvider()