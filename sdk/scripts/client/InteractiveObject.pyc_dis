import BigWorld
import Dialog
import Helpers.Caps

class InteractiveObject:

    def __init__(self):
        pass

    def onEnterWorld(self):
        if self.talkFlag:
            self.addCaps(Helpers.Caps.CAP_CAN_TALK)

    def set_talkFlag(self, old_value):
        if self.talkFlag:
            self.addCaps(Helpers.Caps.CAP_CAN_TALK)
        else:
            self.removeCaps(Helpers.Caps.CAP_CAN_TALK)

    def addCaps(self, caps, comment = None):
        if caps not in self.targetCaps:
            self.targetCaps += [caps]

    def removeCaps(self, caps, comment = None):
        if caps in self.targetCaps:
            tmp = list(self.targetCaps)
            tmp.remove(caps)
            self.targetCaps = tmp

    def can_talk(self):
        return True