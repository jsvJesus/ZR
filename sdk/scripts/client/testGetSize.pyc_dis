# Embedded file name: ./client/testGetSize.py
import BigWorld
from BWPersonality import GUICore
import Localization
import DialogsDispatcher as dd
import QuestDispatcher as qd
import Items
import ResMgr
import Config.Anomalies
import Config.Creatures
from sys import getsizeof

class Data:

    def __init__(self, name, obj, len = 0, size = 0):
        self.name = name
        self.obj = obj
        self.len = len
        self.size = size


class SizeOfData:

    def __init__(self):
        self.objects = [Data('Quests', qd.get_quests()),
         Data('Dialogs', dd.get_dialogs()),
         Data('Local_rus', Localization.localization_object.loaded_loc_files),
         Data('Local_en', Localization.localization_object.loaded_loc_files_english),
         Data('Items.ItemBase', Items.ItemBase),
         Data('Config.Anomalies', Config.Anomalies.get_config.cache),
         Data('Config.Creatures', Config.Creatures.get_type_config.cache),
         Data('inventoryDataSection', GUICore.inventoryDataSection),
         Data('clanDataSection', GUICore.clanDataSection),
         Data('actionBarDataSection', GUICore.actionBarDataSection),
         Data('itemCacheDataSection', GUICore.itemCacheDataSection),
         Data('healthDataSection', GUICore.healthDataSection),
         Data('characterManagerDataSection', GUICore.characterManagerDataSection),
         Data('craftDataSection', GUICore.craftDataSection),
         Data('loginDataSection', GUICore.loginDataSection),
         Data('inworldMarkersDataSection', GUICore.inworldMarkersDataSection),
         Data('emblemsDataSection', GUICore.emblemsDataSection),
         Data('crosshairsDataSection', GUICore.crosshairsDataSection),
         Data('munitionsDataSection', GUICore.munitionsDataSection)]
        self.PL_Items = Data('PL_Items', None)
        self.constSize = 0
        for d in self.objects[0:5]:
            d.size = self.get_size(d.obj)
            self.constSize += d.size

        return

    def get_len(self, obj, level = 0):
        if obj is None:
            return 0
        else:
            size = len(obj)
            if level >= 2:
                return size
            if isinstance(obj, dict):
                for key in obj.keys():
                    size += self.get_size(key)

                for key in obj:
                    size += self.get_size(obj[key])

            elif isinstance(obj, list) or isinstance(obj, tuple):
                for key in obj:
                    size += self.get_size(key)

            elif isinstance(obj, ResMgr.DataSection):
                size += self.get_size(dict(obj))
            elif hasattr(obj, '__dict__'):
                for key, item in obj.__dict__.items():
                    size += self.get_size(key)
                    size += self.get_size(item, level + 1)

            return size

    def get_size(self, obj, level = 0):
        size = getsizeof(obj)
        if level >= 2:
            return size
        if isinstance(obj, dict):
            for key in obj.keys():
                size += self.get_size(key)

            for key in obj:
                size += self.get_size(obj[key])

        elif isinstance(obj, list) or isinstance(obj, tuple):
            for key in obj:
                size += self.get_size(key)

        elif isinstance(obj, ResMgr.DataSection):
            size += self.get_size(dict(obj))
        elif hasattr(obj, '__dict__'):
            for key, item in obj.__dict__.items():
                size += self.get_size(key)
                size += self.get_size(item, level + 1)

        return size

    def update(self):
        size = 0
        leng = 0
        import time
        t = time.time()
        for val in self.objects[5:]:
            val.size = self.get_size(val.obj)
            size += val.size

        print 'get_size', time.time() - t
        t = time.time()
        for val in self.objects[5:]:
            val.len = self.get_len(val.obj)
            leng += val.len

        print 'get_len', time.time() - t
        if BigWorld.player() and hasattr(BigWorld.player(), 'CarryingItems'):
            self.PL_Items.obj = BigWorld.player().CarryingItems
            self.PL_Items.size = self.get_size(self.PL_Items.obj)
            size += self.PL_Items.size
            print 'self.PL_Items.size={0}'.format(self.PL_Items.size)
        resultSize = self.constSize + size
        print 'resultSize = {0}'.format(resultSize)
        return resultSize

    def startPrint(self):

        def strSize(val):
            ret = 0
            postfix = ''
            if val < 1024:
                ret = val
            elif val < 1048576:
                ret = float(val) / 1024
                postfix = 'Kb'
            elif val < 1073741824:
                ret = float(val) / 1024 / 1024
                postfix = 'Mb'
            else:
                ret = val
            return '{0} {1}'.format(ret, postfix)

        result = 0
        for data in self.objects:
            result += data.size
            print '{0} = {1}'.format(data.name, strSize(data.size))

        print strSize(result)