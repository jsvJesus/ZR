# Embedded file name: ./client/SpaceSounds.py
import BigWorld
import sounds_manager as sounds
data = {1: [{'sound_name': 'music/volcano_event/start_far',
      'sound_position': (22.9, 395.600006, -306.200012)}, {'sound_name': 'music/volcano_event/siren',
      'sound_position': (-574.400024, 40.200001, -671.0)}]}
sound_models = []
sounds_mb = []

def playSpaceSound(sound_id):
    global sound_models
    global data
    global sounds_mb
    sound_data = data.get(sound_id)
    if not sound_data:
        return
    stopSounds()
    for i in sound_data:
        soundName = i['sound_name']
        print 'playSpaceSound', sound_id, soundName
        sound_model = BigWorld.Model('')
        sound_models.append(sound_model)
        sound_model.position = i['sound_position']
        BigWorld.addModel(sound_model)
        if soundName:
            sound = sounds.getSound(soundName, model=sound_model)
            if not sound:
                return
            sound.play()
            sounds_mb.append(sound)


def stopSounds():
    global sound_models
    global sounds_mb
    for sound in sounds_mb:
        sound.stop()

    sounds_mb = []
    for sound_model in sound_models:
        BigWorld.delModel(sound_model)

    sound_models = []