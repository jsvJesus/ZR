HALFPI = math.pi / 2
FOURTH_PI = math.pi / 4
PI = math.pi
PI2 = math.pi * 2
PI3 = math.pi * 3

def clamp3(minValue, value, maxValue):
    if value < minValue:
        return minValue
    if value > maxValue:
        return maxValue
    return value


def clamp(magnitude, value):
    return clamp3(-magnitude, value, magnitude)


def _gener(x, y):
    while 1:
        for i in xrange(x, y):
            yield i


_gen = _gener(1, 5)

def getRoketNodeID():
    return _gen.next()


class Helicopter(object):
    """docstring for Helicopter"""

    def __init__(self, entity):
        self.entity = entity
        self.isControlled = entity == BigWorld.player()
        self._prop = {}
        self._tid = 0
        self._model = None
        self._obst_model = None
        self._prev_pos = self.entity.position
        self._prev_yaw = self.entity.yaw
        self._prev_dpos = Vector3()
        self.hel_yaw = self.entity.yaw
        self.hel_pos = self.entity.position
        self._add_pos = Vector3()
        self._add_pos_factor = 0.0
        self._add_pos2 = Vector3()
        self._add_pitch = 0
        self._add_roll = 0
        self._lastt = time.time()
        self._body_pitch = 0.0
        self._body_roll = 0.0
        self._shot_node = None
        self._roket_guns = {}
        self._mash_gunID = 0
        self._rockFireID = 0
        self._clb_f0 = 0
        self._clb_f1 = 0
        self._clb_f2 = 0
        self._sound1 = None
        self._sound2 = None
        self._heat_trap_left_node = None
        self._heat_trap_right_node = None
        self._lock_yaw = None
