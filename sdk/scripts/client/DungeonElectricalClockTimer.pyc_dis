# Embedded file name: ./client/DungeonElectricalClockTimer.py
import BigWorld
import time
import BWPersonality
from electical_clock import ElecticalClock, CLOCK_TYPE, COMP_GAME_TYPE
from Helpers.Caps import CAP_INTERACT
from time import time, strftime, localtime
from functools import partial

class DungeonElectricalClockTimer(BigWorld.Entity, ElecticalClock):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        ElecticalClock.__init__(self)
        self.filter = BigWorld.NoneFilter()

    def onEnterWorld(self, prereqs):
        ElecticalClock.onEnterWorld(self, prereqs)
        self.setDynamic()
        self.update_timer()

    def set_activated(self, prev):
        self.update_timer()

    def set_endtime(self, prev):
        self.update_timer()

    def _get_time(self):
        if not self.activated:
            return 0
        if self.clock_type == CLOCK_TYPE.TIMER:
            return max(0, int(self._t_end - time()))
        if self.clock_type == CLOCK_TYPE.STOPWATCH:
            return max(0, int(round(time() - self.starttime - BWPersonality.gpd.time_diff)))
        return 0

    def update_timer(self):
        self.stop_tick()
        self.start_tick()
        delay = max(0, self.endtime - time() + BWPersonality.gpd.time_diff)
        self.start_timer(int(round(delay)))