            def credit_check_validator(new_str, whole_text, offset):
                full_text = whole_text[0:offset] + new_str + whole_text[offset:]
                full_text = full_text.replace('`', '')
                if not full_text.isdigit():
                    return False
                if full_text:
                    return int(full_text) <= BigWorld.player().CreditNumber
                return True

