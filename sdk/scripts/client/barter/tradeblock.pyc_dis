    def _blink_money(self, colour):
        if not self._money_shad:
            return
        self.component.blinker.colour = colour
        self._money_shad.value = 1.0
        self._money_shad.reset()
        self._money_shad.mode = 'ALL'
        self._money_shad.start = 1.0
        self._money_shad.stop = 0.0
        self._money_shad.alpha = 1
        self._money_shad.speed = 0.9
        self._money_shad.value = 0.0

    def _on_container_event(self, event_type, data):
        if event_type == ContET.OnMoneyChanged:
            if self._money_label:
                self._money_label.setValue(data['money'])
            if self._money_shad:
                color = (0, 255, 0, 150) if data['money'] > data['prev_money'] else (255, 0, 0, 150)
                print data['money'], data['prev_money']
                self._blink_money(color)
        elif event_type == ContET.OnLockChanged:
            locked = data['locked']
            self.component.locker.visible = locked != LockType.Null
            if self._money_edit:
                self._money_edit.activate(0)
            if self._stat_text:
                if locked == LockType.Lock:
                    self._stat_text.text = lc('Common.Messages.OPPONENT_OFFER')
                elif locked == LockType.Confirm:
                    self._stat_text.text = lc('Common.Messages.OPPONENT_ACCEPT')
                else:
                    self._stat_text.text = u''
        elif event_type == ContET.OnCleared:
            self.component.locker.visible = False
            if self._money_edit:
                self._money_edit.setValue(u'0')
                self._money_edit.activate(0)
            if self._money_label:
                self._money_label.setValue(0)

    def _on_money_changed(self, value):
        self.container.set_money(value)

    def is_item_locked(self, item_id):
        return self.container.is_item_locked(item_id)

    def on_show(self, owner):
        self.container.clear()
        self.container.on_show(owner)
        self._trade_view.on_show()
        self._name.text = owner and owner.name or u''

    def on_hide(self):
        self.container.clear()
        if self._money_edit:
            self._money_edit.activate(0)