# Embedded file name: ./client/barter/retranslator.py
import BigWorld
from barter.container import EventType as ContET
from Constants import BarterNotification as BN

class Retranslator:

    def __init__(self, container, opponent_container):
        container.add_listener(self._on_container_event)
        self._opponent_container = opponent_container
        self._opponent = None
        return

    def on_show(self, opponent):
        BigWorld.player().notify_bart_retranslator_event = self._notify_bart_retranslator_event
        self._opponent = opponent

    def _notify_bart_retranslator_event(self, opponent_id, event_type, items, item_ids):
        if event_type == BN.ItemsAdded:
            self._opponent_container.add_items(items)
        elif event_type == BN.ItemsRemoved:
            self._opponent_container.remove_items(item_ids)
        elif event_type == BN.ItemsCleared:
            self._opponent_container.clear()
        elif event_type == BN.MoneyChanged:
            money = item_ids[0]
            self._opponent_container.set_money(money)
        elif event_type == BN.LockChanged:
            locked = item_ids[0]
            self._opponent_container.set_lock(locked)

    def _on_container_event(self, event_type, data):
        if not self._opponent or self._opponent.isDestroyed:
            return
        if event_type == ContET.OnAdded:
            items = data['items']
            self._opponent.cell.notify_bart_retranslator_event(BN.ItemsAdded, items, [])
        elif event_type == ContET.OnRemoved:
            item_ids = data['item_ids']
            self._opponent.cell.notify_bart_retranslator_event(BN.ItemsRemoved, [], item_ids)
        elif event_type == ContET.OnCleared:
            self._opponent.cell.notify_bart_retranslator_event(BN.ItemsCleared, [], [])
        elif event_type == ContET.OnMoneyChanged:
            money = data['money']
            self._opponent.cell.notify_bart_retranslator_event(BN.MoneyChanged, [], [money])
        elif event_type == ContET.OnLockChanged:
            locked = data['locked']
            self._opponent.cell.notify_bart_retranslator_event(BN.LockChanged, [], [locked])