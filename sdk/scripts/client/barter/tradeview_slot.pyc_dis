# Embedded file name: ./client/barter/tradeview_slot.py
from soGUI.soItemView import soItemSlot
import GUI
import ItemsUtils
import BWPersonality
import colorCodes as cc
from Localization import lc
from soGUI import soContextMenuComponent as CMC
shader_speed = 0.6

class BarterSlot(soItemSlot):
    factoryString = 'soGUI.bartertradeslot'
    SLOTWIDTH = 64
    SLOTHEIGHT = 64
    EVENT_INFO = 0

    def __init__(self, component, slotIndex, itemData = None):
        soItemSlot.__init__(self, component, slotIndex, itemData, centerDProxy=True)
        component.script = self

    def setupRoot(self):
        comp = self.component
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.SLOTWIDTH, self.SLOTHEIGHT
        comp.dragFocus = True
        comp.dropFocus = True
        comp.crossFocus = True
        comp.moveFocus = True
        comp.mouseButtonFocus = True

    def setupContent(self):
        comp = GUI.Frame2('soGUI/items/cell.dds')
        comp.vpm, comp.hpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.SLOTWIDTH, self.SLOTHEIGHT
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'frameCmp')
        comp = GUI.Simple('')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.SLOTWIDTH, self.SLOTHEIGHT
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.4)
        self.component.addChild(comp, 'itemIcon')
        comp = GUI.Simple('soGUI/maps/Icons/icon_item_painted.dds')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.materialFX = 'BLEND'
        comp.position = (self.component.width, 20, 0.7)
        comp.visible = False
        self.component.addChild(comp, 'itemColored')
        comp = GUI.Simple('soGUI/maps/Icons/icon_item_label.dds')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.materialFX = 'BLEND'
        comp.position = (self.component.width - 12, 20, 0.0)
        comp.visible = False
        self.component.addChild(comp, 'itemEmblem')
        comp = GUI.Text(u'', 'ArialNarrow_12.family')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.colour = (175, 166, 112, 255)
        comp.materialFX = 'BLEND'
        comp.position = (self.SLOTWIDTH - 5, 5, 0.3)
        self.component.addChild(comp, 'itemCount')

    def handleMouseEnterEvent(self, comp):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        if self.haveItem():
            from Inventory import Inventory
            string = Inventory.GetItemString(self.itemData)
            BWPersonality.GUICore.showToolTip(cc.tf3_regular_text_color + string)
        return soItemSlot.handleMouseEnterEvent(self, comp)

    def onRClick(self):
        if self.haveItem():
            BWPersonality.GUICore.addListener('contextMenuEvent', self._context_menu_event)
            BWPersonality.GUICore.showContextMenu(self.factoryString, {BarterSlot.EVENT_INFO: lc('Inventory.client.INFO')})

    def _context_menu_event(self, interface_id, eventid, caption, event, data = None):
        if event == CMC.EVENT_SHOW and self.factoryString == interface_id:
            return
        BWPersonality.GUICore.removeListener('contextMenuEvent', self._context_menu_event)
        if interface_id != self.factoryString:
            return
        if eventid == BarterSlot.EVENT_INFO:
            BWPersonality.GUICore.showItemInfo(self.itemData)

    def handleMouseLeaveEvent(self, comp):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        return soItemSlot.handleMouseLeaveEvent(self, comp)

    def _applyItemData(self):
        soItemSlot._applyItemData(self)
        if self.haveItem():
            if not ItemsUtils.GetIconName(self.itemData):
                icon_name = 'nottexture.dds'
                self.component.itemIcon.textureName = icon_name
                self.component.itemColored.visible = bool(ItemsUtils.getItemColorise(self.itemData) or ItemsUtils.getTintID(self.itemData))
                self.component.itemEmblem.visible = bool(ItemsUtils.getItemEmblem(self.itemData))
                condition = ItemsUtils.GetItemConditionPercentString(None, self.itemData)
                self.component.itemCount.text = condition and condition
            else:
                count_str = ItemsUtils.GetDisplayValue(self.itemData) or u''
                self.component.itemCount.text = count_str
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemCount.text = u''
            self.component.itemColored.visible = False
            self.component.itemEmblem.visible = False
        return


class InteractableSlot(BarterSlot):

    def __init__(self, component, slotIndex, itemData = None):
        BarterSlot.__init__(self, component, slotIndex, itemData)
        self.dragProxy = self.component.dragProxy
        self.proxyHolder = self.component
        self.proxyName = 'dragProxy'
        self.dragProxy = self.component.dragProxy
        self._onDragStart = self.on_drag_start
        self._onDragStop = self.on_drag_stop

    def on_out_screen_drop(self):
        self.parent_view.on_inventory_drop(self)

    def on_inventory_drop(self):
        self.parent_view.on_inventory_drop(self)

    def on_drag_start(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def on_drag_stop(self):
        self.dragProxy.visible = False
        return True

    def setupContent(self):
        BarterSlot.setupContent(self)
        self._create_multiselector()
        self._create_multidrag_proxy()

    def _applyItemData(self):
        BarterSlot._applyItemData(self)
        self.set_drag_proxy_visual(self.component.itemIcon.texture, self.multiselected)


class NonInteractableSlot(BarterSlot):

    def __init__(self, component, slotIndex, itemData = None):
        BarterSlot.__init__(self, component, slotIndex, itemData)
        comp = GUI.Simple('soGUI/white.dds')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.SLOTWIDTH - 4, self.SLOTWIDTH - 4
        comp.colour = (255, 85, 85, 0)
        comp.materialFX = 'BLEND'
        comp.position = (2, 2, 0.8)
        self.component.addChild(comp, 'blinker')
        self._shader = GUI.AlphaShader()
        comp.addShader(self._shader)

    def blink(self, color):
        self.component.blinker.colour = color
        self._shader.value = 1.0
        self._shader.reset()
        self._shader.mode = 'ALL'
        self._shader.start = 1.0
        self._shader.stop = 0.0
        self._shader.alpha = 1
        self._shader.speed = shader_speed
        self._shader.value = 0.0