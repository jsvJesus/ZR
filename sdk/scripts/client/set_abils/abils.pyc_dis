# Embedded file name: ./client/set_abils/abils.py
import BigWorld
import sys
import BWPersonality
from utils import Listenable
from copy import deepcopy

class AbilEventType:
    OnJustUse, OnChargeChanged = ((r, 'SetAbil') for r in range(2))


class Abil(Listenable):

    def __init__(self, last_use_time, config):
        Listenable.__init__(self)
        self._last_use_time = last_use_time
        self._config = config
        self._charge = 0

    def get_time_remain(self):
        result = self._last_use_time + self.get_cooldown_time() - BWPersonality.gpd.server_time
        return max(0, result)

    def reset_cooldown(self):
        self._last_use_time = 0

    def is_in_cooldown(self):
        return self.get_time_remain() > 0

    def get_cooldown_time(self):
        return self._config['cooldown']

    @property
    def charge(self):
        return self._charge

    @charge.setter
    def charge(self, value):
        if self._charge == value:
            return
        self._charge = value
        self.notify_listeners(AbilEventType.OnChargeChanged)

    def start_use(self):
        player = BigWorld.player()
        if not player:
            return
        sound_name = self._config.get('sound')
        action_name = self._config.get('start_action')
        if sound_name or action_name:
            player.start_use_abil(self.get_id())
        self.continue_use()

    def continue_use(self, data = None):
        self._last_use_time = BWPersonality.gpd.server_time
        data = data and deepcopy(data) or {}
        data['last_use_time'] = self._last_use_time
        self.notify_listeners(AbilEventType.OnJustUse, data)

    def get_id(self):
        return self._config['id']

    def get_name(self):
        raise NotImplementedError


class TrenogaAbil(Abil):

    def get_name(self):
        return u'\u0422\u0430\u0431\u0443\u0440\u0435\u0442\u043a\u0430'

    def continue_use(self, entity_id):
        data = {'entity_id': entity_id}
        Abil.continue_use(self, data)

    def start_use(self):
        player = BigWorld.player()
        if not player:
            return
        player.start_use_trenoga(self.get_id(), self.continue_use)


class AdrenalinAbil(Abil):

    def get_name(self):
        return u'\u0410\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d'

    def start_use(self):
        Abil.start_use(self)


def get_abil_class_by_name(class_name):
    return getattr(sys.modules[__name__], class_name)