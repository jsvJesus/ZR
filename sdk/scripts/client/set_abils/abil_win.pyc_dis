        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        self.component.htk.addChild(comp)
        self._htk_text = comp
        comp = GUI.Text(u'', 'RobotoCondensedRegular_18.font')
        comp.vpm = 'PIXEL'
        comp.va = 'TOP'
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'ttext')
        comp = Circle().component
        pcomp = GUI.Window()
        comp.position = (0, 0, 0.1)
        pcomp.addChild(comp, 'circle')
        pcomp.widthMode, pcomp.heightMode = ('PIXEL', 'PIXEL')
        pcomp.width, pcomp.height = comp.texture.width, comp.texture.height
        pcomp.position = (0, 0, 0.1)
        self.component.addChild(pcomp, 'circle')
        comp = GUI.Window('soGUI/frame/stuff/adrenalin_background.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (255, 255, 255, 125)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (0, 0, 0.9)
        comp.width, comp.height = comp.texture.width, comp.texture.height
        self.component.addChild(comp, 'circleback')
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.vpm = 'PIXEL'
        comp.position = (0, 56, 0.5)
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'ctext')
        comp = GUI.Window('soGUI/frame/stuff/kd_progress.dds')
        comp.materialFX = 'BLEND'
        comp.filterType = 'LINEAR'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        self.component.addChild(comp, 'scircle')
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        self.component.addChild(comp, 'image')
        shader = GUI.ClipShader()
        shader.speed = 0
        shader.value = 1
        shader.mode = 'UP'
        comp.addShader(shader, 'clipper')
        comp = self.component.scircle
        self.component.width, self.component.height = comp.width, comp.height + 48
        self.component.position = self._get_default_position()
        self._states = {TrenogaAbil: TrenogaWinState(self.component),
         AdrenalinAbil: AdrenalinWinState(self.component)}
        return

    def _update_hotkey(self):
        self._htk_text.text = BWPersonality.get_action_key('UseSetAbil', prepend_space_if_valid=False)
        comp = self.component.htk
        comp.width, comp.height = self._htk_text.stringDimensions(self._htk_text.text)

    def show(self, abil):
        if self.component.visible:
            return
        self.component.visible = True
        BWPersonality.GUICore.addListener('key_binding_changed', self._on_binding_changed)
        self.abil = abil
        self._update_hotkey()
        GUIPositions.show(self)

    def _get_default_position(self):
        return (0, -1, 0.21)

    def reset_position(self):
        self.component.position = self._get_default_position()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)

    @property
    def abil(self):
        return self._state and self._state._abil

    @abil.setter
    def abil(self, value):
        if self.abil == value:
            return
        else:
            new_state = self._states.get(value.__class__, None)
            if self._state == new_state:
                return
            if self._state:
                self._state.on_leave()
            self._state = new_state
            if self._state:
                self._state.on_enter(value)
            return

    def _on_binding_changed(self, data):
        if 'UseSetAbil' in data:
            self._update_hotkey()

    def hide(self):
        BWPersonality.GUICore.removeListener('key_binding_changed', self._on_binding_changed)
        self.abil = None
        self.component.visible = False
        return