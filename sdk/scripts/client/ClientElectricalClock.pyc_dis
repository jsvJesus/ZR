# Embedded file name: ./client/ClientElectricalClock.py
import BigWorld
from electical_clock import ElecticalClock, CLOCK_TYPE, COMP_GAME_TYPE
from Helpers.Caps import CAP_INTERACT
from time import time, strftime, localtime
from functools import partial

class ClientElectricalClock(BigWorld.Entity, ElecticalClock):

    def __init__(self):
        self.height = 1.0
        BigWorld.Entity.__init__(self)
        ElecticalClock.__init__(self)
        self.targetCaps = [CAP_INTERACT]
        self.filter = BigWorld.NoneFilter()
        self._tid = 0
        self._t_end = 0
        self.update_mark_text()

    def onEnterWorld(self, prereqs):
        ElecticalClock.onEnterWorld(self, prereqs)
        self.update_mark_text()
        self.setDynamic()
        self.stat_tick()

    def update_mark_text(self):
        self.name = self.get_mark_text()

    def get_mark_text(self):
        if self.clock_type == CLOCK_TYPE.TIMER:
            return u'Timer'
        elif self.comp_game_type == COMP_GAME_TYPE.GAME:
            return u'Clock'
        else:
            return u'Clock(comp)'

    def interact(self, player):
        self.stop_redrawtext()
        if self.clock_type == CLOCK_TYPE.TIMER:
            self.start_timer(self.delay_sec)
            return
        self.comp_game_type = not self.comp_game_type
        self.update_mark_text()
        self._on_update()