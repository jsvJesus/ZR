    def checkClanRights(self, right):
        return self.clanRights & (right | Clan.FLAG_CLAN_OWNER)

    def onEnterRFPoint(self):
        pass

    def onEnterBase(self):
        pass

    def onLeaveWorld(self):
        self.close_clanleader_offer()
        try:
            f = open(ALLIANCE_SAVE_PATH, 'wb')
            f.write(pyson.dumps(self.relationshipClanParam))
            f = open(MEMBERS_SAVE_PATH, 'wb')
            f.write(pyson.dumps(self.visible_clan_members))
        except:
            traceback.print_stack()
            traceback.print_exc()

    def onEnterWorld(self):
        self.start_check_clanleader_offer()
        if os.path.isfile(ALLIANCE_SAVE_PATH):
            try:
                with open(ALLIANCE_SAVE_PATH, 'rb') as f:
                    self.relationshipClanParam = pyson.loads(f.read())
            except:
                traceback.print_exc()

        if os.path.isfile(MEMBERS_SAVE_PATH):
            try:
                with open(MEMBERS_SAVE_PATH, 'rb') as f:
                    self.visible_clan_members = pyson.loads(f.read())
            except:
                traceback.print_exc()

    def start_check_clanleader_offer(self):
        self.base.start_check_clanleader_offer()

    def getRelationMarkParamByName(self, clan_name):
        clan_relation_type = 0
        if clan_name == self.clanName:
            clan_relation_type = Clan.CLAN_RELATION_TYPE_MY_CLAN
        elif clan_name in self.clanEnemies:
            clan_relation_type = Clan.CLAN_RELATION_TYPE_WAR
        elif clan_name == self.clanUnion:
            clan_relation_type = Clan.CLAN_RELATION_TYPE_UNION
        return self.getRelationMarkParam(clan_relation_type)

    def getRelationMarkParam(self, clan_relation_type):
        return self.relationshipClanParam.get(self.name, {}).get(clan_relation_type, Clan.GUI_VISIBLE_NORMAL)

    def setAllianceMarkParam(self, clan_relation_type, value):
        if not self.relationshipClanParam.has_key(self.name):
            self.relationshipClanParam[self.name] = {}
        self.relationshipClanParam[self.name][clan_relation_type] = value

    def setClanMemberVisible(self, member_name, value):
        if not self.visible_clan_members.has_key(self.name):
            self.visible_clan_members[self.name] = []
        has_key = member_name in self.visible_clan_members[self.name]
        if value and not has_key:
            self.visible_clan_members[self.name].append(member_name)
        elif not value and has_key:
            self.visible_clan_members[self.name].remove(member_name)

    def clearClanMemberVisible(self):
        if self.visible_clan_members.has_key(self.name):
            del self.visible_clan_members[self.name]

    def getClamMemberVisible(self):
        return self.visible_clan_members.get(self.name, [])

    def set_clanName(self, old_value):
        self.clanRoster['cName'] = self.clanName.decode('utf-8')
        self.update_clan_screen()
        self.updateOnlineClanMembers()

    def setClanRights(self, value):
        self.clanRights = value
        self.update_clan_screen()

    def set_clan_bases_list(self, bases_list):
        self.clan_screen_set_bases(bases_list)

    def set_clan_donat_bases_list(self, bases_list):
        self.clan_screen_set_donat_bases(bases_list)

    def leaveClan(self):

        def listener(event, data):
            if event == MESSAGEBOX.EVENT_BTNPRESS:
                if data['btn'] == MESSAGEBOX.BTN_YES:
                    if self == BigWorld.player():
                        self.cell.leaveClan()

        BWPersonality.GUICore.showMsgBox(id='clan_leave', isModal=False, x=0.0, y=0.0, width=300, caption=lc('Clans.Interface.LEAVE_TITLE'), forcePos=False, parent_gui_id=None, bind_to_parent=False, btn_set=[{'type': MESSAGEBOX.BTN_YES,
          'width': 80}, {'type': MESSAGEBOX.BTN_NO,
          'width': 80}], timeout=10, closeBox=True, defaultAction=MESSAGEBOX.BTN_NO, addControls=[{'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
          'ID': 'main_txt_field',
          'text': lc('Clans.Interface.LEAVE_QUESTION'),
          'hAnchor': MESSAGEBOX.ANCHOR_CENTER}], callback=listener)
        return

    def tryDestroyClan(self):

        def listener(event, data):
            if event == MESSAGEBOX.EVENT_BTNPRESS:
                if data['btn'] == MESSAGEBOX.BTN_YES:
                    if self == BigWorld.player():
                        self.base.destroyClan()

        BWPersonality.GUICore.showMsgBox(id='clan_leave', isModal=False, x=0.0, y=0.0, width=300, caption=lc('Clans.Interface.DESTROY_TITLE'), forcePos=False, parent_gui_id=None, bind_to_parent=False, btn_set=[{'type': MESSAGEBOX.BTN_YES,
          'width': 80}, {'type': MESSAGEBOX.BTN_NO,
          'width': 80}], timeout=10, closeBox=True, defaultAction=MESSAGEBOX.BTN_NO, addControls=[{'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
          'ID': 'main_txt_field',
          'text': lc('Clans.Interface.DESTROY_QUESTION'),
          'hAnchor': MESSAGEBOX.ANCHOR_CENTER}], callback=listener)
        return

    def can_auction(self):
        if not self.GetClanID():
            return False
        if not ClanSettings.can_buy_base(self.clan_level):
            return False
        return self.checkClanRights(Clan.FLAG_CLAN_OWNER)

    def ask_union_invite(self, allianceClanID, clan_name, tag):

        def callback(event):
            BWPersonality.GUICore.closeMsgBox('clan_union_offer')
            if event == soDialogueBox.BTN_ACCEPT:
                self.base.confirmInviteUnion(allianceClanID, tag)
                return
            self.base.cancelCreateUnion(allianceClanID)

        cost = ClanSettings.get_diplomacy_cost(self.clan_level, 'union')
        msg = lc('Clans.Interface.ASK_UNION1').format(clan_name.decode('utf-8'), tag.decode('utf-8'), cost)
        gui_jokes.askUserAcceptDecline('', msg, callback, timeout_for_default=30, show_timer_btn=1, default_btn=soDialogueBox.BTN_DECLINE, unic_id='clan_union_offer', modal=False)

    def ask_clan_peace(self, offer_peace_id, peace_clan_name):
        from soGUI.soDialogueBox import soDialogueBox

        def callback(event):
            if event == soDialogueBox.BTN_ACCEPT:
                self.cell.answer_clan_peace(True, offer_peace_id)
                return
            self.cell.answer_clan_peace(False, offer_peace_id)

        cost = ClanSettings.get_diplomacy_cost(self.clan_level, 'peace')
        msg = lc('Clans.Interface.ASK_PEACE').format(peace_clan_name.decode('utf-8'), cost)
        gui_jokes.askUserAcceptDecline('', msg, callback, timeout_for_default=30, show_timer_btn=1, default_btn=soDialogueBox.BTN_DECLINE, unic_id='clan_peace_offer')

    def ask_clan_war(self, offer_peace_id, war_clan_name):
        from soGUI.soDialogueBox import soDialogueBox

        def callback(event):
            if event == soDialogueBox.BTN_ACCEPT:
                self.cell.answer_clan_war(True, offer_peace_id)
                return
            self.cell.answer_clan_war(False, offer_peace_id)

        msg = lc('Clans.Interface.ASK_WAR').format(war_clan_name.decode('utf-8'))
        gui_jokes.askUserAcceptDecline('', msg, callback, timeout_for_default=30, show_timer_btn=1, default_btn=soDialogueBox.BTN_DECLINE, unic_id='clan_war_offer')

    def stop_offer_clan_peace(self):
        BWPersonality.GUICore.closeMsgBox('clan_peace_offer')

    def stop_offer_clan_war(self):
        BWPersonality.GUICore.closeMsgBox('clan_war_offer')

    def union_invite_sended(self, allianceClanID, clan_name):

        def cancel():
            try:
                self.base.cancelCreateUnion(allianceClanID)
            except Exception as e:
                print 'ERROR :: union_invite_sended.cancel:', self, allianceClanID, clan_name
                print e

        BWPersonality.GUICore.showWaitingAlliance(clan_name, cancel, '')

    def cancel_union_invite(self, clan_name):
        if isinstance(clan_name, str):
            clan_name = clan_name.decode('utf-8')
        message = lc('Clans.Messages.CREATE_UNION_CANCELED').format(clan_name)
        self.putMessage(CHANNEL_CONSTS.CLAN, message)

    def cancel_alliance_invite(self, clan_name):
        if isinstance(clan_name, str):
            clan_name = clan_name.decode('utf-8')
        message = lc('Clans.Messages.CREATE_ALLIANCE_CANCELED').format(clan_name)
        self.putMessage(CHANNEL_CONSTS.CLAN, message)

    def show_msg_with_timer(self, text, timerfield_text, **kwargs):
        addControls = ({'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
          'ID': 'main_txt_field',
          'text': text,
          'hAnchor': MESSAGEBOX.ANCHOR_CENTER}, {'type': MESSAGEBOX.ADDCONTROL_TIMERFIELD,
          'ID': '',
          'text': timerfield_text,
          'hAnchor': MESSAGEBOX.ANCHOR_CENTER})
        kwargs['width'] = 550
        kwargs['timeout'] = 30
        kwargs['closeBox'] = True
        kwargs['defaultAction'] = None
        return BWPersonality.GUICore.showMsgBox(addControls=addControls, **kwargs)

    def show_confirm_clanleader_offer(self, owner_dbid):

        def listener(event, data):

            def response(is_agree):
                try:
                    self.base.clanleader_owner_offer_response(owner_dbid, is_agree)
                except Exception as e:
                    print 'ERROR :: show_confirm_clanleader_offer:', self, owner_dbid, is_agree
                    print e

            if event == MESSAGEBOX.EVENT_BTNPRESS:
                if data['btn'] == MESSAGEBOX.BTN_CONFIRM:
                    response(True)
                elif data['btn'] == MESSAGEBOX.BTN_CANCEL:
                    response(False)

        if getattr(self, '_clanleader_offer_gui', None):
            self._clanleader_offer_gui.internalClose()
        title = lc('Clans.Interface.LEADERSHIP_TITLE')
        text = lc('Clans.Interface.OWNER_OFFER_CONFIRM_TEXT')
        timerfield_text = lc('Clans.Interface.TIMER_TEXT')
        self._clanleader_offer_gui = self.show_msg_with_timer(text, timerfield_text, id='waiting_clanleader_offer', caption=title, btn_set=[{'type': MESSAGEBOX.BTN_CONFIRM,
          'width': 140}, {'type': MESSAGEBOX.BTN_CANCEL,
          'width': 140}], callback=listener)
        return

    def show_waiting_clanleader_offer(self, new_leader_name):

        def listener(event, data):
            if event == MESSAGEBOX.EVENT_BTNPRESS:
                if data['btn'] == MESSAGEBOX.BTN_CANCEL:
                    try:
                        self.base.clanleader_owner_offer_cancel()
                    except Exception as e:
                        print 'ERROR :: show_waiting_clanleader_offer.cancel:', self, new_leader_name
                        print e

        if getattr(self, '_clanleader_offer_gui', None):
            self._clanleader_offer_gui.internalClose()
        title = lc('Clans.Interface.LEADERSHIP_TITLE')
        text = lc('Clans.Interface.OWNER_OFFER_WAIT_TEXT').format(new_leader_name.decode('utf-8') if isinstance(new_leader_name, str) else new_leader_name)
        timerfield_text = lc('Clans.Interface.TIMER_TEXT')
        self._clanleader_offer_gui = self.show_msg_with_timer(text, timerfield_text, id='waiting_clanleader_offer', caption=title, btn_set=[{'type': MESSAGEBOX.BTN_CANCEL,
          'width': 140}], callback=listener)
        return

    def close_clanleader_offer(self):
        if getattr(self, '_clanleader_offer_gui', None):
            self._clanleader_offer_gui.internalClose()
            self._clanleader_offer_gui = None
        return

    def send_another_clan_info(self, data):
        BWPersonality.GUICore.showClanCard(data)

    def get_available_rewards_count(self):
        self.base.get_available_rewards_count()

    def request_clan_rate_reward(self, level):
        self.base.request_clan_rate_reward0(level)