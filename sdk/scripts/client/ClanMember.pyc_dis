MEMBERS_SAVE_PATH = os.path.join(utils.stalker_path(), 'usercontent/members_visible.pyson')

class ClanMember(PlayerAvatarForSoClanScreen):
    debug_dict = dict()
    BASE_CAPTURE_ID = '_base'
    FLAG_CAPTURE_ID = '_flag'
    base_tracker = dict()
    reinfp_tracker = dict()
