    def __init__(self):
        pass

    @property
    def clanEnemies(self):
        return self.clan_myenemies

    def clanRosterUpdate(self, roster):
        PlayerAvatarForSoClanScreen.clanRosterUpdate(self, roster)

    def clanMemberRosterUpdate(self, member):
        PlayerAvatarForSoClanScreen.clanMemberRosterUpdate(self, member)

    def clanRanksUpdate(self, ranks, self_id):
        PlayerAvatarForSoClanScreen.clanRanksUpdate(self, ranks, self_id)

    def clan_info_update(self, motto, message, clan_points):
        self.clan_motto_update(motto)
        self.clan_message_update(message)
        PlayerAvatarForSoClanScreen.clan_points_update(self, clan_points)

    def clan_motto_update(self, motto):
        PlayerAvatarForSoClanScreen.clan_motto_update(self, motto)

    def clan_message_update(self, message):
        PlayerAvatarForSoClanScreen.clan_message_update(self, message)
        if message:
            self.putMessage(CHANNEL_CONSTS.CLAN, message, lc('Clans.Messages.CLAN_MESSAGE'))

    def clan_motto_change(self, motto_text):
        if not self.checkClanRights(Clan.FLAG_CAN_CHANGE_MOTD):
            return
        self.base.clan_motto_change(motto_text)

    def clan_message_change(self, message_text):
        if not self.checkClanRights(Clan.FLAG_CAN_CHANGE_CLANMSG):
            return
        self.base.clan_message_change(message_text)

    def clan_level_up(self):
        if not self.checkClanRights(Clan.FLAG_CLAN_OWNER):
            self.tellAboutClanStatus([], [], Clan.STATUS_YOU_ARE_NOT_LEADER)
            return

        def callback(event):
            if event == gui_jokes.askUserYesNo.YES:
                self.cell.clan_upgrade_level()

        if self.clan_level == 2:
            msg = lc('Clans.Interface.SURE_UPGRADE')
            gui_jokes.askUserYesNo('', msg, callback)
            return
        self.cell.clan_upgrade_level()

    def showClanCreateDialog(self, isRepeat):
        msg = u' '
        title = lc('Clans.Interface.ENTER_CLAN_NAME')
        gui_jokes.inputBox(title, msg, self.onTryCreateClan, active=True)
        BWPersonality.GUICore.mouseAltMode = True
        BWPersonality.game.set_cursor_mouse(True)

    def onTryCreateClan(self, text):
        err = check_clan_name(text)
        if err != Clan.STATUS_CLAN_NAME_OK:
            self.tellAboutClanStatus([], [], err)
            BigWorld.callback(0.5, lambda : self.showClanCreateDialog(True))
            return
        if self.money < Clan.COST_CREATE_CLAN:
            self.tellAboutClanStatus([], [], Clan.STATUS_NOT_ENOUGH_MONEY)
            BigWorld.callback(0.5, lambda : self.showClanCreateDialog(True))
            return
        if self.get_level() < Clan.LEVEL_CREATE_CLAN:
            self.tellAboutClanStatus([], [], Clan.STATUS_NOT_ENOUGH_PLAYER_LEVEL)
            BigWorld.callback(0.5, lambda : self.showClanCreateDialog(True))
            return

        def endCreateClan(event):
            if event == gui_jokes.askUserYesNo.YES:
                BWPersonality.GUICore.mouseAltMode = False
                BWPersonality.GUICore.setBestCursor()
                self.cell.createClan(text.encode('utf-8'))
                return
            if event == gui_jokes.askUserYesNo.NO:
                BigWorld.callback(0.5, lambda : self.showClanCreateDialog(True))

        msg = lc('Clans.Interface.CREATE_CLAN_MESSSAGE').format(text, Clan.COST_CREATE_CLAN)
        gui_jokes.askUserYesNo('', msg, endCreateClan)

    def runClanLeader(self, ua):
        new_leader_name = ua[12:]
        if new_leader_name:
            self.runCommand(ua)
        else:
            print 'WARNING :: runClanLeader, not new_leader_name'

    def GetHolderClanID(self):
        return self.GetClanID()

    def GetClanID(self):
        return self.cellClanID

    def set_cellClanID(self, old_value):
        self.clanID = self.cellClanID
        self.update_clan_screen()
        if not self.clanID:
            self.clearClanMemberVisible()

    def onLeaveBase(self):
        pass

    def onLeaveRFPoint(self):
        pass

    def showClanWars(self):
        if not self.clanEnemies:
            warList = lc('Clans.Messages.YOUR_CLAN_HAS_NO_WARS')
        else:
            warList = lc('Clans.Messages.YOUR_CLAN_IS_IN_WAR_WITH')
            warList += '\n'
            warList += '\n'.join(self.clanEnemies).decode('utf-8')
        self.putMessage(CHANNEL_CONSTS.SYSTEM, warList)

    def setClanRelations(self, my_enemies, union_enemies, union):
        self.clanUnion = union if union else None
        self.clan_myenemies = my_enemies
        self.clan_unenemies = union_enemies
        self.update_clan_screen()
        return

