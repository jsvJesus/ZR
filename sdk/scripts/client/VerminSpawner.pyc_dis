# Embedded file name: ./client/VerminSpawner.py
import BigWorld
from _VerminSpawnerC import *
from client_utils import GetDogWatch
_active_spawners = []
prof_firecode = BigWorld.DogWatchProfiler('vtCpp')

def trace_bullet(shot_directions, max_dist = None):
    if shot_directions:
        srs = BigWorld.player().get_firing_point()[1]
        direction = shot_directions[0]
        for spawner in _active_spawners:
            spawner.trace_bullet(srs, direction, max_dist=max_dist)


def on_avatar_step(position):
    for spawner in _active_spawners:
        spawner.on_avatar_step(position)


class VerminSpawner(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.EXT_OBJ = None
        self._tick_controller_id = None
        return

    def onEnterWorld(self, prereqs = None):
        if not self.EXT_OBJ:
            self.EXT_OBJ = Helper()
            self.EXT_OBJ.setEntity(self)
        _active_spawners.append(self)
        if self.EXT_OBJ:
            self.EXT_OBJ.onEnterWorld(prereqs)
            self._tick_controller_id = BigWorld.callback(0, self._tick)

    def _tick(self):
        if self.EXT_OBJ and not self.isDestroyed:
            prof_firecode.start()
            self.EXT_OBJ.tick()
            self._tick_controller_id = BigWorld.callback(0, self._tick)
            prof_firecode.stop()

    def onLeaveWorld(self):
        if self._tick_controller_id:
            BigWorld.cancelCallback(self._tick_controller_id)
            self._tick_controller_id = None
        if self.EXT_OBJ:
            self.EXT_OBJ.onLeaveWorld()
        _active_spawners.remove(self)
        self.EXT_OBJ = None
        return

    def on_avatar_step(self, position):
        if self.EXT_OBJ:
            self.EXT_OBJ.onAvatarStep(position)

    def trace_bullet(self, srs, direction, max_dist = None):
        if self.EXT_OBJ:
            self.EXT_OBJ.traceBullet(srs, direction)