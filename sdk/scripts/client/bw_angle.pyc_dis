# Embedded file name: ./client/bw_angle.py
import math
MATH_PI = math.pi
MATH_2PI = math.pi * 2
TWO_PI = math.pi * 2
THREE_PI = math.pi * 3

class Angle(object):

    def __init__(self, value):
        if isinstance(value, Angle):
            value = value.angle_
        value = float(value)
        self.angle_ = self.normalise(value)

    def normalise(self, value):
        if value > MATH_PI:
            if value > THREE_PI:
                return value - math.floor((value + MATH_PI) / TWO_PI) * TWO_PI
            else:
                return value - TWO_PI
        elif value <= -MATH_PI:
            if value <= -THREE_PI:
                return value - math.floor((value + MATH_PI) / TWO_PI) * TWO_PI
            else:
                return value + TWO_PI
        return value

    def decay(self, src, dst, halfLife, dTime):
        dst = self.sameSignAngle(src, dst)
        if halfLife <= 0.0:
            return dst
        else:
            return dst + math.pow(0.5, dTime / halfLife) * (src - dst)

    def sameSignAngle(self, angle, closest):
        if closest > angle + MATH_PI:
            return closest - 2.0 * MATH_PI
        elif closest < angle - MATH_PI:
            return closest + 2.0 * MATH_PI
        else:
            return closest

    def clampBetween(self, Angle_min, Angle_max):
        Angle_min = Angle.getAngle(Angle_min)
        Angle_max = Angle.getAngle(Angle_max)
        diff = Angle.turnRange(Angle_min, self)
        a_range = Angle.turnRange(Angle_min, Angle_max)
        if diff > a_range:
            self.angle_ = Angle_max.angle_ if diff - a_range / 2.0 < MATH_PI else Angle_min.angle_
            return True
        return False

    def isBetween(self, Angle_min, Angle_max):
        Angle_min = Angle.getAngle(Angle_min)
        Angle_max = Angle.getAngle(Angle_max)
        diff = Angle.turnRange(Angle_min, self)
        a_range = Angle.turnRange(Angle_min, Angle_max)
        return diff <= a_range

    def lerp(self, a, b, alpha):
        a = Angle.getAngle(a)
        b = Angle.getAngle(b)
        self.angle_ = (self.sameSignAngle(a, b) - a) * alpha + a

    @staticmethod
    def turnRange(Angle_from, Angle_to):
        Angle_from = Angle.getAngle(Angle_from)
        Angle_to = Angle.getAngle(Angle_to)
        diff = (Angle_to - Angle_from).angle_
        if diff < 0:
            return diff + MATH_2PI
        return diff

    @staticmethod
    def getAngle(other):
        if not isinstance(other, Angle):
            other = Angle(other)
        return other

    def __repr__(self):
        return 'A(%.1f)' % math.degrees(self.angle_)

    def __str__(self):
        return 'A(%.1f)' % math.degrees(self.angle_)

    def __add__(self, other):
        return Angle(self.angle_ + Angle.getAngle(other).angle_)

    def __sub__(self, other):
        return Angle(self.angle_ - Angle.getAngle(other).angle_)

    def __div__(self, other):
        return Angle(self.angle_ / Angle.getAngle(other).angle_)

    def __floordiv__(self, other):
        return Angle(self.angle_ // Angle.getAngle(other).angle_)

    def __mul__(self, other):
        return Angle(self.angle_ * Angle.getAngle(other).angle_)

    def __lt__(self, other):
        return self.angle_ < Angle.getAngle(other).angle_

    def __gt__(self, other):
        return self.angle_ > Angle.getAngle(other).angle_

    def __le__(self, other):
        return self.angle_ <= Angle.getAngle(other).angle_

    def __eq__(self, other):
        return self.angle_ == Angle.getAngle(other).angle_

    def __ne__(self, other):
        return self.angle_ != Angle.getAngle(other).angle_

    def __ge__(self, other):
        return self.angle_ >= Angle.getAngle(other).angle_


if __name__ == '__main__':
    model_yaw = Angle(-1.5394)
    dc = Angle(0.399)
    print 'turnRange:', Angle.turnRange(model_yaw, dc) > math.pi