                    elif status == Quest.STATUS_CABMAN_NO_PLACES:
                        message = lc('Quests.Messages.CABMAN_NO_PLACES')
                    elif status == Quest.STATUS_CABMAN_NO_MONEY:
                        message = lc('Quests.Messages.CABMAN_NO_MONEY')
                    elif status == Quest.STATUS_CANT_COMPLETE:
                        self.restart_current_dialog_node()
                    elif status == Quest.STATUS_CANT_TAKE_SUBCHAPTER:
                        self.restart_current_dialog_node()
                        message = lc('Quests.Messages.CANT_TAKE_SUBCHAPTER')
                    elif status == Quest.STATUS_USEITEM_FAIL:
                        message = lc('Quests.Messages.USEITEM_FAIL')
                    elif status == Quest.STATUS_VISOBJECT_VISIBLE:
                        message = lc('Quests.Messages.VISOBJECT_COMPLETE')
                    elif status == Quest.STATUS_SUCCESSFULL_COLLECT_BOXES:
                        message = lc('Quests.Messages.COLLECT_BOXES').format(qd.getQuestTitleByID(questID))
                    elif status == Quest.STATUS_ONPROCESS_COLLECT_BOXES:
                        message = lc('Quests.Messages.ONPROCESS_BOXES').format(qd.getQuestTitleByID(questID), data[1], qd.get_dung_data(questID)[1])
                    elif status == Quest.STATUS_ONPROCESS_KILLED_CAPTURE:
                        count = quest['Target']['NumOfObjects']
                        kills, deaths = Quest.unpack_double_count(data[1])
                        need_finishdead = bool(quest['Target'].get('ObjectAttr'))
                        if need_finishdead:
                            local = lc('Quests.Messages.FINISH_PROCESS')
                        else:
                            local = lc('Quests.Messages.KILL_PROCESS')
                        message = local.format(qd.getQuestTitleByID(questID), kills, count)
                    elif status == Quest.STATUS_ONPROCESS_FLAGS_CAPTURE:
                        count = quest['Target']['NumOfObjects']
                        flags, deaths = Quest.unpack_double_count(data[1])
                        message = lc('Quests.Messages.FLAGS_PROCESS').format(qd.getQuestTitleByID(questID), flags, count)
                    elif status == Quest.STATUS_ONPROCESS_REVIVES_CAPTURE:
                        count = quest['Target']['NumOfObjects']
                        revives, deaths = Quest.unpack_double_count(data[1])
                        message = lc('Quests.Messages.REVIVE_PROCESS').format(qd.getQuestTitleByID(questID), revives, count)
                    if message:
                        message = BWPersonality.settings.keyBindings.parse_actions_and_replace(message)
                        self.questerMessageToConsole(message)
                        screen_message = screen_message and (BWPersonality.settings.keyBindings.parse_actions_and_replace(screen_message[0]), screen_message[1])
                        BWPersonality.gpd.sendHightMessage(screen_message[0], MT.QUEST)
                sound and sounds.playSound(sound)
            return

    def questerMessageToConsole(self, string):
        self.putMessage(CHANNEL_CONSTS.QUESTS, string)

    def setPVPStatus(self, status):
        self.PVPInfo['State'] = status

    def deleteTriggerMarkers(self, qID):
        if qID in self.trigger_markers:
            self.trigger_markers.remove(qID)
        if qID in self._mark_listeners:
            for listener in self._mark_listeners[qID]:
                listener.on_mark_changed(False)

    def addTriggerMarkers(self, qID):
        self.trigger_markers.append(qID)
        if qID in self._mark_listeners:
            for listener in self._mark_listeners[qID]:
                listener.on_mark_changed(True)

    def removeAllTriggerMarkers(self):
        self.trigger_markers[:] = []
        for listeners in self._mark_listeners.values():
            for listener in listeners:
                listener.on_mark_changed(False)

    @lazyproperty
    def trigger_markers(self):
        return []

    @staticmethod
    def findTitleQuest(quest_id):
        try:
            return qd.getQuestTitleByID(qd.get_parent_by_id(quest_id))
        except:
            return u'!!! internal error !!!'

    def _countQItems(self, quest):
        attr = quest['Target']['ObjectAttr']
        itemDict = []
        if attr:
            itemDict = [ dict(count=self.getNumberOfItemsForQuester(quest['Target']['ObjectType'], at), quest=at) for at in quest['Target']['AObjectAttrs'] ]
            return (sum([ at['count'] for at in itemDict ]), itemDict)
        else:
            return (self.getNumberOfItemsForQuester(quest['Target']['ObjectType'], quest['Target']['ObjectAttr']), itemDict)

    def getNumberOfItemsForQuester(self, itemType, itemAttr):
        return ItemsUtils.GetItemQuanity(self.CarryingItems, itemType, itemAttr)

    def got_reward(self, quest_id):
        BWPersonality.GUICore.show_quest_reward_window(quest_id)

    def get_quest_status_callback(self, status):
        from Helpers.Autoquester import Autoquester
        Autoquester.get_quest_status_callback(status)

    def request_board_quests(self):
        """ \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd1\x8c \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2 """
        self.base.request_board_quests()

    def got_board_quests(self, quest_ids):
        """ \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd0\xb0 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0 \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2 """
        self._quest_board.update_quests(quest_ids)

    def register_mark_listener(self, listener, mark_id):
        """ \xd1\x81\xd0\xb8\xd0\xb3\xd0\xbd\xd0\xb0\xd1\x82\xd1\x83\xd1\x80\xd0\xb0: listener.on_mark_changed(exist) """
        self._mark_listeners[mark_id].append(listener)
        listener.on_mark_changed(mark_id in self.trigger_markers)

    def unregister_mark_listener(self, listener):
        for mark_id, listeners in self._mark_listeners.items():
            if listener in listeners:
                listeners.remove(listener)
                if not listeners:
                    del self._mark_listeners[mark_id]

    def register_quest_listener(self, listener, quest_ids):
        """ \xd1\x81\xd0\xb8\xd0\xb3\xd0\xbd\xd0\xb0\xd1\x82\xd1\x83\xd1\x80\xd0\xb0: listener.on_quest_state_changed(quest_id, state) """
        server_send_quest_ids = []
        for quest_id in quest_ids:
            self._quest_listeners[quest_id]['listeners'].append(listener)
            if len(self._quest_listeners[quest_id]['listeners']) == 1:
                server_send_quest_ids.append(quest_id)
            else:
                last_state = self._quest_listeners[quest_id]['last_state']
                if last_state is not None:
                    listener.on_quest_state_changed(quest_id, last_state)

        if server_send_quest_ids:
            self.base.register_quest_listener(server_send_quest_ids)
        return

    def stop_quest_listen(self, listener, quest_ids):
        unregister_q_ids = []
        for quest_id in quest_ids:
            if quest_id not in self._quest_listeners:
                continue
            listeners_data = self._quest_listeners[quest_id]
            if listener not in listeners_data['listeners']:
                continue
            listeners_data['listeners'].remove(listener)
            if not listeners_data['listeners']:
                del self._quest_listeners[quest_id]
                unregister_q_ids.append(quest_id)

        if not self.isDestroyed and unregister_q_ids and self.isConnected:
            self.base.unregister_quest_listener(unregister_q_ids)

    def unregister_quest_listener(self, listener):
        unregister_q_ids = []
        for q_id, listeners_data in self._quest_listeners.items():
            if listener in listeners_data['listeners']:
                listeners_data['listeners'].remove(listener)
                if not listeners_data['listeners']:
                    del self._quest_listeners[q_id]
                    unregister_q_ids.append(q_id)

        if not self.isDestroyed and unregister_q_ids and self.isConnected:
            self.base.unregister_quest_listener(unregister_q_ids)

    def on_quest_changed_state(self, quest_ids, states):
        for quest_id, state in zip(quest_ids, states):
            if quest_id not in self._quest_listeners:
                continue
            self._quest_listeners[quest_id]['last_state'] = state
            listeners = self._quest_listeners[quest_id]['listeners']
            for i in xrange(len(listeners) - 1, -1, -1):
                if getattr(listeners[i], 'isDestroyed', False):
                    self.unregister_quest_listener(listeners[i])
                    continue
                listeners[i].on_quest_state_changed(quest_id, state)

    def request_quest_from_board(self, quest_id):
        """ \xd0\xb2\xd0\xb7\xd1\x8f\xd1\x82\xd1\x8c \xd0\xb2\xd1\x8b\xd0\xb1\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82 """
        self.base.request_quest_from_board(quest_id)

    def got_requested_quest(self, quest_id, request_result, update_result, quest_ids):
        """ \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd0\xb0 \xd0\xb2\xd0\xb7\xd1\x8f\xd1\x82\xd0\xb8\xd1\x8f \xd0\xb2\xd1\x8b\xd0\xb1\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0
                \xd0\xb4\xd0\xbe \xd0\xba\xd1\x83\xd1\x87\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb8\xd1\x81\xd1\x8b\xd0\xbb\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb4\xd0\xbe\xd1\x81\xd1\x82\xd1\x83\xd0\xbf\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2
        """
        if update_result:
            self._quest_board.update_quests(quest_ids)
        if request_result == CTQ.OK:
            return
        if request_result == CTQ.ERROR_TIMEPOS:
            self._wating_for_time_remain = quest_id
            self.base.get_time_remain(quest_id)
        else:
            self.questerMessageToConsole(CTQ.get_error_message(request_result))

    def got_time_remain(self, time):
        if not hasattr(self, '_wating_for_time_remain'):
            return
        del self._wating_for_time_remain
        from soGUI.DialogGUI.AsyncLoader import time_to_string
        time = time_to_string(time)
        message = CTQ.get_error_message(CTQ.ERROR_TIMEPOS).format(time)
        self.questerMessageToConsole(message)

    @property
    def _quest_board(self):
        return BWPersonality.GUICore.soBulletinBoard.quest_board

    def request_acquaintances(self, callback):
        self._request_acquaintances_callback = callback
        self.base.request_acquaintances()

    def got_acquaintances(self, data):
        self._request_acquaintances_callback(data)
        del self._request_acquaintances_callback

    def on_document_read(self, item_type, quest_id):
        description = qd.getQItemInfo(quest_id, item_type)['content']
        item_name = ItemsUtils.GetItemName(item_type, fGetShortName=True)
        NoteBox(description, item_name)

    def got_pvp_quests(self, quest_ids):
        if not hasattr(self, '_last_pvp_game_data'):
            return

        def resolve_pvp_quest(quest_id):
            quest = qd.getQuestOnID(quest_id)
            pvp_data = self._last_pvp_game_data
            game_mode = quest['Target'].get('additional')
            if game_mode is not None and game_mode != pvp_data['game_mode']:
                return False
            else:
                not_die_count = quest['Conditions'].get('notDieCount')
                if not_die_count is not None and pvp_data['deaths'] > not_die_count:
                    return False
                be_pvp_winner_color = quest['Conditions'].get('bePvpWinner')
                if be_pvp_winner_color is not None and be_pvp_winner_color != csconstans.TEAM_NO:
                    if not pvp_data['winner']:
                        return False
                    if be_pvp_winner_color != csconstans.TEAM_ANY and pvp_data['teamID'] != be_pvp_winner_color:
                        return False
                pvp_win_team = quest['Conditions'].get('pvpWinTeam')
                if pvp_win_team is not None:
                    if pvp_data['is_best'] < pvp_win_team:
                        return False
                quest_type = qd.get_type(quest)
                need_count = quest['Target']['NumOfObjects']
                if quest_type == Quest.TYPE_PVP_MAP_KILL:
                    use_weapon_type = quest['Conditions'].get('useWeaponType')
                    if use_weapon_type:
                        count = pvp_data['weapon_kills'].get(use_weapon_type, 0)
                    else:
                        count = pvp_data['kills']
                    return count >= need_count
                if quest_type == Quest.TYPE_PVP_MAP_CAPTURE_FLAG:
                    bring_mode = quest['Target'].get('ObjectType', 0)
                    if bring_mode:
                        count = pvp_data['return_flags']
                    else:
                        count = pvp_data['brought_flags']
                    mode = int(quest['Target'].get('ObjectName', '0'))
                    if mode:
                        return quest['Target'].get('ObjectAttr', 0) >= pvp_data['is_best']
                    else:
                        return count >= need_count
                elif quest_type == Quest.TYPE_PVP_MAP_SCORE:
                    mode = quest['Target'].get('ObjectType', 0)
                    if mode:
                        return quest['Target'].get('ObjectAttr', 0) >= pvp_data['is_best']
                    else:
                        return pvp_data['plscore'] >= need_count
                raise RuntimeError
                return

        resolved = filter(resolve_pvp_quest, quest_ids)
        del self._last_pvp_game_data
        if resolved:
            self.base.resolve_pvp_quests(resolved)

    def on_pvp_game_end(self, data, isPrivate):
        if isPrivate:
            return
        self._last_pvp_game_data = data
        self.base.request_pvp_quests()

    def subscribe_all_quests_changes(self, callbacks, hashable_id, quest_ids = None):
        """ quest_ids == None, \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb8\xd1\x82 \xd0\xb2\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5 \xd0\xb2\xd1\x81\xd0\xb5 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd1\x8b """
        subscribe = []
        if quest_ids:
            for q_id in quest_ids:
                if q_id not in self._all_quests_callbacks:
                    self._all_quests_callbacks[q_id] = {}
                    subscribe.append(q_id)
                self._all_quests_callbacks[q_id][hashable_id] = callbacks

        else:
            if None not in self._all_quests_callbacks:
                self._all_quests_callbacks[None] = {}
                subscribe.append(0)
            self._all_quests_callbacks[None][hashable_id] = callbacks
        if subscribe:
            self.base.subscribe_all_quests_changes(True, subscribe)
        return

    def unsubscribe_all_quests_changes(self, hashable_id, quest_ids = None):
        unsubscribe = []
        if quest_ids:
            for q_id in quest_ids:
                if q_id not in self._all_quests_callbacks:
                    continue
                if hashable_id in self._all_quests_callbacks[q_id]:
                    del self._all_quests_callbacks[q_id][hashable_id]
                if not self._all_quests_callbacks[q_id]:
                    del self._all_quests_callbacks[q_id]
                    unsubscribe.append(q_id)

        elif None in self._all_quests_callbacks:
            if hashable_id in self._all_quests_callbacks[None]:
                del self._all_quests_callbacks[None][hashable_id]
            if not self._all_quests_callbacks[None]:
                del self._all_quests_callbacks[None]
                unsubscribe.append(0)
        if unsubscribe and not self.isDestroyed and self.isConnected:
            self.base.subscribe_all_quests_changes(False, unsubscribe)
        return

    def on_quest_event(self, quest_id, prev_state, state):
        for key in (quest_id, None):
            if key not in self._all_quests_callbacks:
                continue
            for callbacks in self._all_quests_callbacks[key].values():
                callbacks[0] and callbacks[0](quest_id, prev_state, state)

        return

    def get_active_subs_and_params0(self, quest_id, callback):
        if not hasattr(self, '_get_active_subs_and_params_callback'):
            self._get_active_subs_and_params_callback = []
        self._get_active_subs_and_params_callback.append((quest_id, callback))
        self.base.get_active_subs_and_params1(quest_id)

    def get_active_subs_and_params3(self, base_state, sub_states, data_ints, known_groups):
        for i in xrange(len(sub_states) - 1, -1, -1):
            ss = sub_states[i]
            if not qd.get_description_by_id(ss['id'], ss['state']):
                del sub_states[i]
                data_ints = filter(lambda (q_id, _): q_id != ss['id'], data_ints)

        if hasattr(self, '_get_active_subs_and_params_callback'):
            index = next((i for i, (quest_id, _) in enumerate(self._get_active_subs_and_params_callback) if quest_id == base_state['id']), None)
            if index is not None:
                callback = self._get_active_subs_and_params_callback[index][1]
                del self._get_active_subs_and_params_callback[index]
                if not self._get_active_subs_and_params_callback:
                    del self._get_active_subs_and_params_callback
                callback(base_state, sub_states, data_ints, known_groups)
        return

    def on_quest_internal_event(self, quest_id, int_value):
        for key in (quest_id, None):
            if key not in self._all_quests_callbacks:
                continue
            for callbacks in self._all_quests_callbacks[key].values():
                callbacks[1] and callbacks[1](quest_id, int_value)

        return

    def force_auto_tracked_quest(self, quest_id):
        if self._quests_tracker:
            self._quests_tracker.force_queue(quest_id)

    def request_story_quest0(self, story_id):
        self.base.request_story_quest1(story_id)

    def onLeaveWorld(self):
        self._quest_listeners.clear()
        self._all_quests_callbacks.clear()
        self._mark_listeners.clear()
        if hasattr(self, '_unread_quests'):
            with open(UNREAD_SAVE_PATH, 'wb') as f:
                f.write(pyson.dumps(self.unread_quests))

