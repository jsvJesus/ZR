        if status == Quest.STATES_MESSAGE_STATE_CHANGED:
            quest_id, state_from, state_to = data
            local_messages = qd.get_quest_mesages(quest_id)
            for i, message in enumerate(qd.notify_messages(quest_id, state_from, state_to)):
                to_screen = message['screen']
                local_text = local_messages[message['index']]
                local_text = BWPersonality.settings.keyBindings.parse_actions_and_replace(local_text)
                if to_screen:
                    BWPersonality.gpd.sendHightMessage(local_text, MT.QUEST)
                else:
                    self.questerMessageToConsole(local_text)

            return
        else:

            def getItemName(item_type, attr):
                name = u''
                if attr:
                    q_item_info = qd.getQItemInfo(questID, item_type)
                    if q_item_info:
                        name = q_item_info.get('title')
                    else:
                        quest = qd.getQuestOnID(questID)
                        quest_attrs = quest['Target']['AObjectAttrs']
                        if len(quest_attrs) == 1:
                            q_item_info = qd.getQItemInfo(quest_attrs[0], item_type)
                            if q_item_info:
                                name = q_item_info.get('title')
                if not name:
                    name = ItemsUtils.GetItemName(item_type)
                return name

            def getCreatureName(mob_type, mob_level):
                return Config.Creatures.get_mob_name(mob_type, mob_level)

            def getFractionName(fraction_id):
                return lc(Fractions.FractionNames[fraction_id])

            def getNPCName(displayName, npcName):
                from NPCs import NPCs
                if displayName:
                    name = lc(displayName)
                elif NPCs.getName(npcName) != u'' and NPCs.getName(self.npcName) != '<NO DATA>':
                    name = NPCs.getName(npcName)
                else:
                    raise RuntimeError
                return name

            message = u''
            sound = None
            screen_message = None
            if data:
                if data[0]:
                    questID = qd.get_parent_by_id(data[0])
                    if questID:
                        quest = qd.getQuestOnID(questID)
                        if quest:
                            if not BWPersonality.GUICore.journal_win_visible() or BWPersonality.GUICore.journal_win.get_selected_quest_id() != questID:
                                self._mark_quest_as_changed(questID)
                    if status == Quest.STATUS_WIPE_OVER:
                        message = lc('Quests.Messages.WIPE_COMPLETE')
                    elif status == Quest.STATUS_OPENED and quest:
                        message = lc('Quests.Messages.MISSION_TAKEN').format(quest['Information']['Title'])
                        sound = 'ui/quest_changes'
                        if not BWPersonality.GUICore.journal_win_visible() or BWPersonality.GUICore.journal_win.get_selected_quest_id() != questID:
                            self._mark_quest_as_new(questID)
                    elif status == Quest.STATUS_CLOSED and quest:
                        message = lc('Quests.Messages.MISSION_COMPLETE').format(quest['Information']['Title'])
                        sound = 'ui/accomplish'
                    elif status == Quest.STATUS_FAILED and quest:
                        message = lc('Quests.Messages.MISSION_FAILED').format(quest['Information']['Title'])
                    elif status == Quest.STATUS_SUCCESSFULL_COLLECT_ITEMS:
                        questID, item_type, attr = data
                        name = getItemName(item_type, attr)
                        message = lc('Quests.Messages.COLLECT_COMPLETE').format(name, qd.getQuestTitleByID(questID))
                    elif status == Quest.STATUS_ONPROCESS_COLLECT_ITEMS:
                        questID, itemID, attr, numOfItem, needOfItem = data
                        name = getItemName(itemID, attr)
                        numOfItem = needOfItem if numOfItem > needOfItem else numOfItem
                        message = lc('Quests.Messages.COLLECT_PROCESS').format(str(numOfItem), str(needOfItem), name, qd.getQuestTitleByID(questID))
                    elif status == Quest.STATUS_FAILED_COLLECT_ITEMS:
                        questID, itemID, attr = data
                        name = getItemName(itemID, attr)
                        message = lc('Quests.Messages.COLLECT_FAILED').format(name)
                    elif status == Quest.STATUS_SUCCESSFULL_KILLED_CREATURE:
                        questID, mobID, mobAttr = data
                        name = getCreatureName(mobID, mobAttr)
                        title = qd.getQuestTitleByID(questID)
                        message = lc('Quests.Messages.FARM_COMPLETE').format(title, name)
                    elif status == Quest.STATUS_SUCCESSFULL_CRAFT:
                        quest_id, cur_count = data
                        title = qd.getQuestTitleByID(quest_id)
                        message = lc('Quests.Messages.CRAFT_COMPLETE').format(title, cur_count)
                    elif status == Quest.STATUS_SUCCESSFULL_NPCKILL:
                        quest_id, cur_count = data
                        title = qd.getQuestTitleByID(quest_id)
                        message = lc('Quests.Messages.NPCKILL_COMPLETE').format(title, cur_count)
                    elif status == Quest.STATUS_SUCCESSFULL_COOK:
                        quest_id, cur_count = data
                        title = qd.getQuestTitleByID(quest_id)
                        message = lc('Quests.Messages.COOK_COMPLETE').format(title, cur_count)
                    elif status == Quest.STATUS_SUCCESSFULL_ART:
                        quest_id = data[0]
                        title = qd.getQuestTitleByID(quest_id)
                        message = lc('Quests.Messages.ART_COMPLETE').format(title)
                    elif status == Quest.STATUS_SUCCESSFULL_KILLED_NPC:
