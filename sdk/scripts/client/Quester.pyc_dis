UNREAD_SAVE_PATH = os.path.join(utils.stalker_path(), 'usercontent/unreadquests.pyson')

class Quester:
    _all_quests_callbacks = {}
    _mark_listeners = defaultdict(list)
    _quest_listeners = defaultdict(lambda : {'listeners': [],
     'last_state': None})

    @property
    def unread_quests(self):
        if not hasattr(self, '_unread_quests'):
            self._unread_quests = {'unread': set(),
             'changed': set()}
            if os.path.exists(UNREAD_SAVE_PATH):
                with open(UNREAD_SAVE_PATH, 'rb') as f:
                    try:
                        data = pyson.loads(f.read())
                        if not isinstance(data, dict):
                            data = {'unread': data,
                             'changed': set()}
                        self._unread_quests = data
                    except:
                        print 'Quester (ERROR) bad unread quests:'
                        traceback.print_stack()
                        traceback.print_exc()

        return self._unread_quests

    def request_cancel_quest(self, quest_id):
        quest = qd.getQuestOnID(quest_id)

        def listener(event):
            if event == gui_jokes.askUserYesNoDelayDeafultNo.YES:
                self.end_dialog()
                if qd.cancel_fail_mode(quest):
                    self.cell.request_fail_quest(quest_id)
                else:
                    self.base.removeQuestFromJournal(quest_id)
                if message_quest_cancel:
                    self.questerMessageToConsole(message_quest_cancel)

        quest_title = qd.getQuestTitleByID(quest_id)
        message_quest_cancel = None
        cancel_header = lc('Quests.Journal.CANCEL_QUEST_HEADER')
        if quest['Additional']['CantCancel']:
            cancel_question = lc('Quests.Journal.CANTCANCEL_QUEST_QUESTION')
            gui_jokes.askUserOk(cancel_header, cancel_question.format(quest_title), listener)
            message_quest_cancel = lc('Quests.Messages.CANTCANCEL_QUEST_QUESTION').format(quest_title)
        else:
            if qd.cancel_fail_mode(quest):
                groups_data = None
                know_ids = []
                for rep_id in qd.get_penalty(quest).get('Reputation2', []):
                    if not rep_utils.is_group_hidden(rep_id):
                        know_ids.append(kp.get_group_acquaintance_id(rep_id) or 0)

                if know_ids:
                    know_ids.sort()
                    knowledge_data = getattr(self, '_quester_knowledge_data', None)
                    if not knowledge_data:

                        def on_got_knowledge(quest_id, knowledge_data):
                            self._quester_knowledge_data = knowledge_data
                            self.request_cancel_quest(quest_id)

                        self.notify_knowledge0(know_ids, partial(on_got_knowledge, quest_id))
                        return
                    del self._quester_knowledge_data
                    group_ids = map(kp.get_groupid_from_knowledge, know_ids)
                    groups_data = dict(zip(group_ids, knowledge_data))
                win_width = 600
                title = colorCodes.active_xml + quest_title + colorCodes.inactive_xml
                cancel_question = lc('Quests.CancelQuest.CANCEL_QUEST_QUESTION_F').format(title)
                penalty_string = qd.get_penalty_string(quest_id, groups_data)
                if penalty_string:
                    cancel_question += u' {0}\n{1}'.format(lc('Quests.CancelQuest.CANCEL_QUEST_QUESTION_F2'), colorCodes.active_xml + penalty_string)
            else:
                win_width = 400
                title = colorCodes.active_xml + quest_title + colorCodes.inactive_xml
                cancel_question = lc('Quests.CancelQuest.CANCEL_QUEST_QUESTION_C').format(title)

            def callbackHandler(event, data):
                if event == MESSAGEBOX.EVENT_BTNPRESS:
                    if data['btn'] == MESSAGEBOX.BTN_YES:
                        listener(gui_jokes.askUserYesNoDelayDeafultNo.YES)

            addControls = [{'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
              'ID': 'main_text',
              'text': cancel_question,
              'hAnchor': MESSAGEBOX.ANCHOR_CENTER}]
            BWPersonality.GUICore.showMsgBox('cancelquest', caption=cancel_header, width=win_width, addControls=addControls, btn_set=[{'type': MESSAGEBOX.BTN_YES,
              'width': 120}, {'type': MESSAGEBOX.BTN_NO,
              'width': 120}], callback=callbackHandler, defaultAction=None)
        return

    def _mark_quest_as_changed(self, quest_id):
        if quest_id not in self.unread_quests['changed']:
            self.unread_quests['changed'].add(quest_id)
            if BWPersonality.GUICore.journal_win_visible():
                BWPersonality.GUICore.journal_win.mark_quest_status(quest_id, ReadStatus.Changed)

    def _mark_quest_as_new(self, quest_id):
        if quest_id not in self.unread_quests['unread']:
            self.unread_quests['unread'].add(quest_id)
            if BWPersonality.GUICore.journal_win_visible():
                BWPersonality.GUICore.journal_win.mark_quest_status(quest_id, ReadStatus.New)

    def mark_quest_as_read(self, quest_id):
        changed = False
        if quest_id in self.unread_quests['unread']:
            self.unread_quests['unread'].remove(quest_id)
            changed = True
        if quest_id in self.unread_quests['changed']:
            self.unread_quests['changed'].remove(quest_id)
            changed = True
        if changed and BWPersonality.GUICore.journal_win_visible():
            BWPersonality.GUICore.journal_win.mark_quest_status(quest_id, ReadStatus.Common)

    def get_read_status(self, quest_id):
        if quest_id in self.unread_quests['unread']:
            return ReadStatus.New
        if quest_id in self.unread_quests['changed']:
            return ReadStatus.Changed
        return ReadStatus.Common

    def getNPCName(self, quest, id):
        for e in quest['Information']['NPCs']:
            if e['id'] == id:
                return e['name']

        return u''

