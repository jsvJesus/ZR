class Slot(soItemSlot):
    factoryString = 'soGUI.gunpointslot'
    SLOTWIDTH = 66
    SLOTHEIGHT = 66

    def setupRoot(self):
        comp = self.component
        comp.widthMode = self.component.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTWIDTH
        comp.crossFocus = True
        comp.dragFocus = True
        comp.dropFocus = True
        comp.moveFocus = True
        comp.mouseButtonFocus = True
        self._interface_id = 'gunpointwin.slot' + str(hash(self))
        self._item_data = None
        return

    def setupContent(self):
        comp = GUI.Frame2('soGUI/items/cell.dds')
        comp.verticalPositionMode, comp.horizontalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (64, 64)
        comp.materialFX = 'SOLID'
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'frame')
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (64, 64)
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (0, 0, 0.2)
        self.component.addChild(comp, 'content')
        content_comp = comp
        comp = GUI.Window('textures/default/black.dds')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (64, 64)
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (0, 0, 0.1)
        comp.materialFX = 'BLEND'
        comp.colour = (0, 0, 0, 150)
        content_comp.addChild(comp, 'fade')
        comp = GUI.Simple('')
        comp.verticalPositionMode, comp.horizontalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (64, 64)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.5)
        content_comp.addChild(comp, 'image')
        comp = GUI.Text('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.font = 'ArialNarrow_10.font'
        comp.position = (1, 1, 0.5)
        comp.colour = cc.highlighted2_rgba
        content_comp.addChild(comp, 'count')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position[0] -= 6
        comp.position[1] += 2

    def setContent(self, item_data):
        soItemSlot.setContent(self, item_data)
        self._item_data = item_data
        if not item_data:
            self.component.content.visible = False
            return
        else:
            self.component.content.visible = True
            self.component.content.image.textureName = ItemsUtils.GetIconName(None, item_data['item_type'])
            count = item_data['count']
            self.component.content.count.text = str(count)
            self.component.content.fade.visible = count == 0
            core = BWPersonality.GUICore
            if core.toolTip and core.toolTipState and core.toolTip.toolTipID == self._interface_id:
                self._show_tooltip()
            return

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip(self._interface_id)
        return soItemSlot.handleMouseLeaveEvent(self, comp)

    def _show_tooltip(self):
        if self._item_data:
            from Inventory import Inventory
            fake_item = ItemsUtils.CreateFakeItem(self._item_data['item_type'])
            ItemsUtils.SetItemNumber(fake_item, self._item_data['count'])
            text = Inventory.GetItemString(fake_item)
            BWPersonality.GUICore.showToolTip(cc.tf3_regular_text_color + text, tooltipID=self._interface_id)
        else:
            BWPersonality.GUICore.hideToolTip(self._interface_id)

    def handleMouseEnterEvent(self, comp):
        self._show_tooltip()
        return soItemSlot.handleMouseEnterEvent(self, comp)


class GunPointWin(DragWin):

    def __init__(self):
        self._tick_callback_handler = 0
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'SOLID'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (352, 350)
        comp.visible = False
        DragWin.__init__(self, comp)
        comp = GUI.Window()
        btn = soButton(comp)
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.width, comp.height = (18, 18)
        comp.position = (self.component.width - 6, 6, 0.2)
        self.component.addChild(comp, 'closeBox')
        btn.onBound()
        btn.initVSC('soGUI/elements/closeBox.xml')
        btn.onClick = self.hide
        comp = GUI.Text(lc('gunner.ui.caption'), 'RobotoCondensedRegular_18.font')
        comp.colour = cc.active_rgba
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (0, 24, 0.5)
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width - 90, 100
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.position = (0, 48, 0.5)
        tf = soTextField3(comp, comp.width, comp.height, comp.width)
        tf.DEFAULT_FONT = 'RobotoCondensedRegular_18.font'
        tf.DEFAULT_COLOR = cc.active_rgba
        tf.DEFAULT_ALIGNMENT = 'center'
        tf.setText(lc('gunner.ui.text'), immidiate=True)
        self.component.addChild(comp)
        comp = GUI.Text(u'', 'RobotoCondensedRegular_18.font')
        comp.colourFormatting = True
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (0, 112, 0.5)
        self.component.addChild(comp, 'loadtext')

        def create_item_view(cols, pos_y):
            comp = GUI.Window()
            item_view = soItemView(comp, Slot, rowWidth=1, cols=cols, rows=1, vScroll=False, hScroll=False, slot_eventsHandler=self._slot_handler, borderWidth=0)
            comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
            comp.ha, comp.va = ('CENTER', 'TOP')
            comp.position = (0, pos_y, 0.5)
            self.component.addChild(comp)
            item_view.onBound()
            item_view.setRestrictingComponent(None)
            return item_view

        self._need_iv = create_item_view(4, 132)
        self._give_iv = create_item_view(1, 212)
        comp = GUI.Window()
        btn = soButton(comp)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.label.text = lc('gunner.ui.loadbutton')
        comp.position = (0, self.component.height - 16, 0.2)
        comp.width, comp.height = (120, 29)
        btn.initVSC('soGUI/elements/button_1.xml')
        btn.onBound()
        btn.onClick = self._on_load_click
        btn._updateVisualState()
        self.component.addChild(comp, 'okbutton')
        self._load_btn = btn

    def _set_give_item(self, item):
        self._give_iv.setItems([item])
        self._update_button()

    def _update_button(self):
        item = self._give_iv.component.slot0.script.itemData
        if not item:
            self._load_btn.setDisabledState(True)
            return
        count = 0
        for i in range(len(GUN_TYPES)):
            slot = getattr(self._need_iv.component, 'slot' + str(i))
            item_data = slot.script.itemData
            if item_data:
                count += item_data['count']

        if count >= BULLET_LIMIT:
            self._load_btn.setDisabledState(True)
            return
        self._load_btn.setDisabledState(False)

    def _update_ammo(self, ammo):
        self._need_iv.setItems([ {'item_type': type_id,
         'count': count} for type_id, count in zip(GUN_TYPES, ammo) ])
        self.component.loadtext.text = u'{0}{1} {2}{3}/{4}'.format(cc.inactive_hex, lc('gunner.ui.loaded'), cc.active_hex, sum(ammo), BULLET_LIMIT)
        self._update_button()

    def _on_load_click(self):
        item = self._give_iv.component.slot0.script.itemData
        self._load_btn.setDisabledState(True)
        if not item:
            return
        else:
            self._owner.on_load_request(item)
            self._set_give_item(None)
            return

    def _slot_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DROP:
            slot = data[1]
            if slot.factoryString == 'soGUI.soInventorySlot2':
                item_ids = slot.get_multiselection()
                if len(item_ids) != 1:
                    self._set_give_item(None)
                    return True
                item = ItemsUtils.GetComplexItemByID(BigWorld.player(), item_ids[0])
                item_type = item['complexItemType']
                if not item or item_type not in GUN_TYPES:
                    self._set_give_item(None)
                    return True
                count = ItemsUtils.GetItemNumber(item)
                self._set_give_item({'item_type': item_type,
                 'count': count,
                 'cid': item['complexItemID']})
        elif event == ITSLOT.SLOTEVENT_MOUSEBUTTON:
            slot = data[0]
            if slot.parent_view == self._give_iv:
                self._set_give_item(None)
        return True

    def _update_data_tick(self):
        if self._tick_callback_handler:
            BigWorld.cancelCallback(self._tick_callback_handler)
            self._tick_callback_handler = 0
        if not Utils.is_visible_in_hierarchy(self.component):
            return
        self._owner.cell.request_gun_data0()
        self._tick_callback_handler = BigWorld.callback(1, self._update_data_tick)

    def _on_got_data(self, ammo):
        if self.visible:
            item = self._give_iv.component.slot0.script.itemData
            if item:
                number = 0
                complex_item = ItemsUtils.GetComplexItemByID(BigWorld.player(), item['cid'])
                if complex_item:
                    number = ItemsUtils.GetItemNumber(complex_item)
                if item['count'] != number:
                    if number == 0:
                        self._set_give_item(None)
                    elif number < item['count']:
                        item['count'] = number
                        self._set_give_item(item)
            self._update_ammo(ammo)
        return

    def _on_show(self):
        self._set_give_item(None)
        self._update_ammo([0] * len(GUN_TYPES))
        BWPersonality.GUICore.setBestCursor()
        pixelperfect_component(self.component)
        self._update_data_tick()
        BigWorld.player().request_gun_data1 = self._on_got_data
        return

    def _on_hide(self):
        BWPersonality.GUICore.setBestCursor()
        if self._tick_callback_handler:
            BigWorld.cancelCallback(self._tick_callback_handler)
            self._tick_callback_handler = 0

    def show(self, owner):
        self._owner = owner
        if self.component.visible:
            return
        self.component.visible = True
        self._on_show()

    def hide(self):
        self._owner = None
        if not self.component.visible:
            return
        else:
            self.component.visible = False
            self._on_hide()
            return

    @property
    def visible(self):
        return self.component.visible