# Embedded file name: ./client/Stone.py
import BigWorld
from Throwable import Throwable
from client_utils import readable_space_pos

class Stone(BigWorld.Entity, Throwable):
    CONTACT_SOUND_PREFIX = 'grenade/stone_contact/'

    def __init__(self):
        BigWorld.Entity.__init__(self)
        Throwable.__init__(self)

    def __repr__(self):
        if self.isDestroyed:
            return 'Stone[%s]Destroyed' % self.id
        return 'Stone[%s] at %s' % (self.id, readable_space_pos(self))

    def get_max_existence_time(self):
        return 5.0

    def throw(self):
        result = Throwable.throw(self)
        if not self.fromServer:
            self.tick()
        return result