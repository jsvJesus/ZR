# Embedded file name: ./client/TransportBell.py
import BigWorld
import ResourceLoader
import ResMgr
import json
import Helpers.Caps
from soGUI.soInworldMarkers import soInworldMarker
from Localization import lc
import sounds_manager as sounds
section = ResMgr.openSection('scripts/common/EnumProps/TransportBell.json')
CONFIG = json.loads(section.asBinary)['model_index']['values']
PIXIE = 'particles/rocket_flare.xml'
SOUND = 'environment/fireworks/rocketstart'

class TransportBell(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._model_path = next((model for index, model in CONFIG if index == self.model_index), None)
        self.targetCaps += [Helpers.Caps.CAP_INTERACT]
        self._last_trigger_time = 0.0
        self._pixie = None
        self._sound = None
        return

    def prerequisites(self):
        if self._model_path:
            return [self._model_path]
        return []

    def onEnterWorld(self, prereqs):
        if self._model_path:
            self.model = prereqs[self._model_path]

    def interact(self, interactor):
        if BigWorld.time() - self._last_trigger_time < 3.0:
            return
        self.cell.summon_boat1()

    def get_interaction_dist(self):
        return 3.0

    def get_target_mark(self, distance):
        if distance < self.get_interaction_dist():
            return soInworldMarker.MARKER_TALK

    def onLeaveWorld(self):
        if self._pixie:
            self._pixie.clear()
            self.model.root.detach(self._pixie)
        self._pixie = None
        if self._sound:
            self._sound.stop()
            self._sound.releaseSound()
        self._sound = None
        self.model = None
        return

    def get_mark_name(self):
        return lc('Transport.bell.name')

    def on_trigger(self):
        self._last_trigger_time = BigWorld.time()
        if self._pixie:
            self._pixie.clear()
            self.model.root.detach(self._pixie)

        def on_load(prereqs):
            if self.isDestroyed:
                return
            self._pixie = prereqs.produce(0)
            self._pixie.force()
            if self._sound:
                self._sound.stop()
                self._sound.releaseSound()
            self._sound = sounds.playSound(SOUND, self.model)
            self.model.root.attach(self._pixie)

        ResourceLoader.asyncLoad([(ResourceLoader.PARTICLE, PIXIE)], on_load)