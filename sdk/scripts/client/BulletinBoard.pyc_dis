# Embedded file name: ./client/BulletinBoard.py
import BigWorld
import Math
import Pixie
import random
import ItemsUtils
import time
import GUI
from Localization import lc
from ItemHolder import ItemHolder
from Helpers.Caps import CAP_OPEN_BULLETIN_BOARD

class BulletinBoard(BigWorld.Entity):
    """" client/BulletinBoard """
    DEFAULT_MODEL = 'models/entities/bulletin_board_01_lod1.model'

    def __init__(self):
        self.height = 2.47
        BigWorld.Entity.__init__(self)
        self.targetCaps = [CAP_OPEN_BULLETIN_BOARD]
        self.name = lc('soBulletinBoard.EntityName')

    def onLoadModel(self, model):
        if self.isDestroyed:
            return
        self.model = model
        if self.model:
            self.model.isObstacle = True
        self.height = Math.Matrix(self.model.bounds).get(1, 1) if model else 1.0

    def onEnterWorld(self, prereqs):
        BigWorld.fetchModel(self.DEFAULT_MODEL, self.onLoadModel)
        self.targetFullBounds = True

    def onLeaveWorld(self):
        self.model = None
        return