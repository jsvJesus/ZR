# Embedded file name: ./client/ParticleUDO.py
import BigWorld
import Pixie

class ParticleUDO(BigWorld.UserDataObject):

    def __init__(self):
        BigWorld.UserDataObject.__init__(self)
        self.model = None
        self.sfx = None
        self.callback_id = None
        self.active = False
        return

    def deactivate(self, force = False):
        self.cance_callbacks()
        self.active = False
        if self.sfx:
            self.sfx.clear()
            self.model.root.detach(self.sfx)
            self.sfx = None
        if self.model:
            BigWorld.delModel(self.model)
            self.model = None
        for next_udo in self.next_udos:
            next_udo.deactivate()

        return

    def activate(self, time = 0):
        self.cance_callbacks()
        if self.active:
            return
        self.active = True
        if self.delay <= time:
            self.on_activated(time - self.delay)
        else:
            self.callback_id = BigWorld.callback(self.delay - time, self.on_activated)

    def cance_callbacks(self):
        if self.callback_id:
            BigWorld.cancelCallback(self.callback_id)
            self.callback_id = None
        return

    def on_activated(self, time = 0):
        if not self.sfxName:
            raise ValueError('ERROR Sfx path [{0}]'.format(self.sfxName))
        self.model = BigWorld.Model('')
        self.model.position = self.position
        self.sfx = Pixie.create(self.sfxName)
        self.model.root.attach(self.sfx)
        BigWorld.addModel(self.model)
        self.sfx.force()
        for next_udo in self.next_udos:
            next_udo.activate(time)