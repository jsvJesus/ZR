# Embedded file name: ./client/Squid.py
from Squids.squid_child import SquidChild
from Squids.Constants import SPAWN_PERIOD, DEBUG
import BigWorld
from SquidUDO import SquidUDO
import DrawPrimitivesUtils
from draw_utils_extend import LinesHolder
from Math import Vector3
import math_bw
from random import uniform
from itertools import chain

class Squid(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        BigWorld.callback(1, self._wait_udos)
        self._points = None
        self._active_children = []
        self._inactive_children = []
        self._tick_controller = None
        self._lines = None
        if DEBUG:
            print '  Squid inited', self.id
            self._lines = LinesHolder(max_lines=0)
            DrawPrimitivesUtils.draw_cilinder(self.position, self.radius, 5, holder=self._lines, alwaysdraw=False)
        return

    def _wait_udos(self):
        if self.isDestroyed:
            return
        else:
            points = []

            def get_next_point(parent):
                next_point = parent.next_point
                if not next_point:
                    return None
                elif not isinstance(next_point, SquidUDO):
                    return False
                else:
                    points.append(next_point)
                    return get_next_point(next_point)

            result = get_next_point(self)
            if result is None:
                self._on_ponits_ready(points)
                return
            BigWorld.callback(1, self._wait_udos)
            return

    def _on_ponits_ready(self, points):
        self._points = [(self.position, self.radius)] + [ (p.position, p.radius) for p in points ]
        if self._lines:
            for i in xrange(len(self._points) - 1):
                self._lines.add(self._points[i][0], self._points[i + 1][0])

        BigWorld.callback(uniform(*SPAWN_PERIOD), self._spawn_child)

    def _tick(self):
        if self.isDestroyed:
            return
        else:
            self._tick_controller = None
            if not self._active_children:
                return
            dtime = min(0.2, BigWorld.getTimeDelta())
            for i in xrange(len(self._active_children) - 1, -1, -1):
                child = self._active_children[i]
                child.update(dtime)
                if child.destroyed:
                    self._inactive_children.append(child)
                    del self._active_children[i]

            self._tick_controller = BigWorld.callback(0, self._tick)
            return

    def _spawn_child(self):
        if self.isDestroyed:
            return
        if self._inactive_children:
            child = self._inactive_children.pop()
        else:
            child = SquidChild()

        def rand_point(point):
            v2 = math_bw.random_point_in_circle(point[1])
            return point[0] + Vector3(v2[0], 0, v2[1])

        child.initialize(map(rand_point, self._points))
        self._active_children.append(child)
        if not self._tick_controller:
            self._tick_controller = BigWorld.callback(0, self._tick)
        BigWorld.callback(uniform(*SPAWN_PERIOD), self._spawn_child)

    def onLeaveWorld(self):
        for child in chain(self._active_children, self._inactive_children):
            child.destroy()

        del self._active_children
        del self._inactive_children
        if self._lines:
            self._lines.clear()