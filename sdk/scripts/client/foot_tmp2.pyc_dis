    def getSaveState(self):
        """
        \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd1\x81\xd0\xb5\xd0\xb9\xd1\x87\xd0\xb0\xd1\x81 \xd1\x83\xd0\xbd\xd0\xb8\xd1\x87\xd1\x82\xd0\xbe\xd0\xb6\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f, \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x8f\xd0\xb5\xd0\xbc \xd1\x81\xd0\xbe\xd1\x82\xd0\xbe\xd1\x8f\xd0\xbd\xd0\xb8\xd1\x8f
        """
        data = {}
        data['_angle_rotate_bl'] = self._angle_rotate_bl.getCurrentValue()
        data['_add_z_by_roll'] = self._add_z_by_roll.getCurrentValue()
        data['_hips_z_bl'] = self._hips_z_bl.getCurrentValue()
        data['_angle_rotate_bl'] = self._angle_rotate_bl.getCurrentValue()
        data['angle_rotate_bl_valueTo_'] = self._angle_rotate_bl.valueTo_
        data['_test_add_z_by_roll_valueTo_'] = self._add_z_by_roll.valueTo_
        data['hips_z_bl_valueTo_'] = self._hips_z_bl.valueTo_
        data['angle_rotate_bl_valueTo_'] = self._angle_rotate_bl.valueTo_
        data['l_foot'] = self.entitiy.foots[0].getSaveStateFoot()
        data['r_foot'] = self.entitiy.foots[1].getSaveStateFoot()
        return data

    def restoreState(self, data):
        """
        \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd1\x81\xd0\xb5\xd0\xb9\xd1\x87\xd0\xb0\xd1\x81 \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xb0\xd1\x81\xd1\x8c, \xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xbc \xd1\x81\xd0\xbe\xd1\x82\xd0\xbe\xd1\x8f\xd0\xbd\xd0\xb8\xd1\x8f
        """
        self._angle_rotate_bl.setCurrentValue(data['_angle_rotate_bl'])
        self._add_z_by_roll.setCurrentValue(data['_add_z_by_roll'])
        self._hips_z_bl.setCurrentValue(data['_hips_z_bl'])
        self._angle_rotate_bl.setCurrentValue(data['_angle_rotate_bl'])
        self._angle_rotate_bl.setValueTo(data['angle_rotate_bl_valueTo_'])
        self._add_z_by_roll.setValueTo(data['_test_add_z_by_roll_valueTo_'])
        self._hips_z_bl.setValueTo(data['hips_z_bl_valueTo_'])
        self._angle_rotate_bl.setValueTo(data['angle_rotate_bl_valueTo_'])
        self.entitiy.foots[0].restoreStateFoot(data['l_foot'])
