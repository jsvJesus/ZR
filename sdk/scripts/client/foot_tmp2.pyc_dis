def tri_normal(triangle):
    tri_normal = (triangle[2] - triangle[0]) * (triangle[2] - triangle[1])
    tri_normal.normalise()
    return tri_normal


def rotateMatrixTo(worldMatrNode, WorldFromPos, worldPointTo, limited = None, BLENDF = 1.0):
    worldMatrNodeInv = Math.Matrix(worldMatrNode)
    worldMatrNodeInv.invert()
    localFrom = worldMatrNodeInv.applyPoint(WorldFromPos)
    localTo = worldMatrNodeInv.applyPoint(worldPointTo)
    localFrom.normalise()
    localTo.normalise()
    dotprod = max(min(localFrom.dot(localTo), 1), -1)
    angle = math.acos(dotprod) * BLENDF
    waxis = localFrom * localTo
    waxis.normalise()
    if limited:
        if angle < limited[0]:
            angle = limited[0]
        if angle > limited[1]:
            angle = limited[1]
    return Math.Matrix().xfromAngleAxis(waxis, angle)


def rotateMatrixToByPlane(worldMatrNode, WorldFromPos, worldPointTo, palne_matr, limited = None, BLENDF = 1.0, debug = False):
    if BLENDF <= 0.001:
        return Matrix()
    pos = worldMatrNode.applyToOrigin()
    new_dir = worldPointTo - pos
    new_dir.normalise()
    vector_up = -palne_matr.applyToAxis(0).crossProduct(new_dir)
    new_world = Math.Matrix()
    new_world.lookAt(pos, new_dir, vector_up)
    new_world.invert()
    worldMatrNode_inv = Matrix(worldMatrNode)
    worldMatrNode_inv.invert()
    new_world.postMultiply(worldMatrNode_inv)
    if BLENDF >= 0.998:
        return new_world
    bl_matrix = Matrix()
    bl_matrix.blendMatrix(BLENDF, new_world)
    return bl_matrix


def getSubPointCircleMethod(lenghtBone1, lenghtBone2, distToTarget):
    errorcode = 1
    if distToTarget > lenghtBone1 + lenghtBone2 or distToTarget < abs(lenghtBone1 - lenghtBone2):
        subPoint2d = Math.Vector3((0.0, 0.0, 1.0))
        errorcode = 0
    else:
        a = (lenghtBone1 * lenghtBone1 - lenghtBone2 * lenghtBone2 + distToTarget * distToTarget) / (2 * distToTarget)
        h = math.sqrt(lenghtBone1 * lenghtBone1 - a * a)
        x0 = 0.0
        y0 = 0.0
        x1 = 0.0
        y1 = distToTarget
        x2 = x0 + a * (x1 - x0) / distToTarget
        y2 = y0 + a * (y1 - y0) / distToTarget
        x3a = x2 - h * (y1 - y0) / distToTarget
        y3a = y2 + h * (x1 - x0) / distToTarget
        subPoint2d = Math.Vector3(0.0, -x3a, y3a)
        subPoint2d.normalise()
    if subPoint2d[2] > 0.8:
        subPoint2d[2] = 0.8
    if subPoint2d[1] < 0.2:
        subPoint2d[1] = 0.2
    return (subPoint2d, errorcode)


