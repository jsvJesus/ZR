        space_name = BigWorld.player().getSpaceName()
        self._map_view.on_show(space_name)

    def _on_mapview_event(self, event_type, data):
        if event_type == MapET.OnStartLoad:
            self.component.loadpane.visible = True
        elif event_type == MapET.OnStopLoad:
            self.component.loadpane.visible = False

    def on_hide(self):
        Tab.on_hide(self)
        self._map_view.on_hide()

