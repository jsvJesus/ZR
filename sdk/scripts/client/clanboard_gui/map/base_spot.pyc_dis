    def _run_timer(self):
        if self._tick_handler:
            BigWorld.cancelCallback(self._tick_handler)
            self._tick_handler = 0
        self._tick()

    def _tick(self):
        if not Utils.is_visible_in_hierarchy(self.component):
            self._tick_handler = 0
            return
        total_time = self._time_value - BigWorld.time()
        total_time /= 86400
        time_string = u''
        days = int(total_time)
        if days:
            time_string += u' ' + unicode(days) + u' ' + lc('clan_win.Captures.Desc.days')
        total_time = (total_time - days) * 24.0
        hours = int(total_time)
        if time_string or hours:
            time_string += u' ' + unicode(hours) + u' ' + lc('clan_win.Captures.Desc.hours')
        total_time = (total_time - hours) * 60.0
        minutes = int(total_time)
        if time_string or minutes:
            time_string += u' ' + unicode(minutes) + u' ' + lc('clan_win.Captures.Desc.mins')
        total_time = (total_time - minutes) * 60.0
        seconds = int(total_time)
        if not days and (time_string or seconds):
            time_string += u' ' + unicode(seconds) + u' ' + lc('clan_win.Captures.Desc.secs')
        self.component.content.capture_time.text = time_string.strip()
        self._tick_handler = BigWorld.callback(1, self._tick)

    def _stop_timer(self):
        self._time_value = 0.0
        if self._tick_handler:
            BigWorld.cancelCallback(self._tick_handler)
            self._tick_handler = 0

    def _icon_loaded(self, image_id, feed_name, texture):
        if self._load_emblem != image_id:
            return
        self.component.content.loadpane.texture = texture
        self.component.content.loadpane.pips.visible = False

    def _start_load_emblem(self, emblem_id):
        self._load_emblem = emblem_id
        self.component.content.loadpane.textureName = ''
        self.component.content.loadpane.pips.visible = True
        UCManager.ucmanager.loadImg(emblem_id, self._icon_loaded)

    def _stop_load_emblem(self):
        self.component.content.loadpane.textureName = ''
        self.component.content.loadpane.pips.visible = False

    def set_data(self, data, ukr):
        self.component.content.visible = True
        self.component.loadpane.visible = False
        self.component.content.basepic.visible = bool(ukr)
        self.component.content.caption.text = lc('BaseToCaptureNames.{0}'.format(data['name']))
        if data['clan_name']:
            text = data['clan_name'].decode('utf8')
            self.component.content.clan_name.text = text
        elif data['clan_id']:
            self.component.content.clan_name.text = lc('clan_win.Captures.Desc.UndefinedClan')
        else:
            self.component.content.clan_name.text = lc('clan_win.Captures.Desc.NoClan')
        self.component.content.capture_time.colour = cc.active_rgba
        self._state = data['state']
        if self._state == bc.FREE_STATE:
            self.component.content.capture_caption.text = lc('clan_win.Captures.Desc.NoOwner')
            self.component.content.capture_time.text = u''
        elif self._state == bc.UNDERATACK_STATE:
            self.component.content.capture_caption.text = lc('clan_win.Captures.Desc.CaptureEndTime')
            self.component.content.capture_time.colour = cc.red_rgba
            self._time_value = data['time'] + BigWorld.time()
            if data['time'] > 0:
                self._run_timer()
            else:
                self.component.content.capture_time.text = u''
        elif self._state == bc.PEACEFUL_STATE:
            self.component.content.capture_caption.text = lc('clan_win.Captures.Desc.CaptureStartTime')
            self.component.content.capture_time.colour = cc.active_rgba
            self._time_value = data['time'] + BigWorld.time()
            self._run_timer()
        if data['emblem']:
            self._start_load_emblem(data['emblem'])
        else:
            self._stop_load_emblem()
        fraction_id = config.get_fraction(data['name'])
        show_fraction = False
        outer_links = config.get_outer_links(data['name'])
        if outer_links:
            self.component.height = self._component_height[2]
            self._paths_comp.visible = True
            names = [ lc('BaseToCaptureNames.' + base_name) for base_name in outer_links ]
            self._paths_comp.name.text = ', '.join(names)
            show_fraction = True
            self.component.content.link_pic.visible = True
        else:
            self.component.content.link_pic.visible = False
            self._paths_comp.visible = False
            show_fraction = bool(fraction_id)
            if show_fraction:
                self.component.height = self._component_height[1]
            else:
                self.component.height = self._component_height[0]
        if show_fraction:
            self._fract_comp.visible = True
            if fraction_id:
                name = rep_utils.get_name(fraction_id)
            else:
                name = lc('clan_win.Captures.Desc.NoClan')
            self._fract_comp.name.text = name
        else:
            self._fract_comp.visible = False

    def _on_show(self):
        self._stop_timer()
        self._stop_load_emblem()
        self.component.content.visible = False
        self.component.loadpane.visible = True
        self.notify_listeners(DescEventType.OnRequestData)
        self.component.height = self._component_height[0]
        pixelperfect_component(self.component)

    def _on_hide(self):
        self._state = None
        self._load_emblem = None
        self._stop_timer()
        self._stop_load_emblem()
        if self.component.loadpane.visible:
            self.notify_listeners(DescEventType.OnRequestStop)
        return

    @property
    def visible(self):
        return self.component.visible

    @visible.setter
    def visible(self, value):
        if self.visible == value:
            return
        self.component.visible = value
        if value:
            self._on_show()
        else:
            self._on_hide()

    def _on_close_click(self):
        self.notify_listeners(DescEventType.OnCloseClick)


class BaseSpot(Listenable):

    def __init__(self, parent_comp):
        Listenable.__init__(self)
        comp = GUI.Simple('')
        self.component = comp
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        g = GUI.CircleComponent('textures/default/alpha.dds')
        g.horizontalPositionMode, g.verticalPositionMode = ('CLIP', 'CLIP')
        g.horizontalAnchor, g.verticalAnchor = ('CENTER', 'CENTER')
        g.widthMode, g.heightMode = ('CLIP', 'CLIP')
        g.materialFX = 'BLEND'
        g.filterType = 'LINEAR'
        g.radius = 1.0
        g.outlineWidth = 0.03
        g.minOutlinePixelWidth = 5
        g.setShapes([((0, 0), (0, 0, 1, 1))])
        g.setShapeActives([(0, 0)])
        self.component.addChild(g, 'circle')
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.filterType = 'LINEAR'
        comp.materialFX = 'BLEND'
        comp.width, comp.height = (32, 32)
        self.component.addChild(comp, 'mark')
        self._mark_button = PaintButton(comp, visual_state='soGUI/frame/map/base_image_button.xml', soundControlName='clan_base_mark_button')
        self._mark_button.on_click = self._on_toggle_click
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (255, 255, 255, 210)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width = 298
        parent_comp.addChild(comp)
        self._desc = Desc(comp)
        self._desc.add_listener(self._on_desc_event)

    def _on_desc_event(self, event_type, data):
        if event_type == DescEventType.OnCloseClick:
            self.desc_visible = False
        elif event_type == DescEventType.OnRequestData:
            data = {'base_id': self.base_data['base_id']}
            self.notify_listeners(SpotEventType.OnRequestData, data)
        elif event_type == DescEventType.OnRequestStop:
            data = {'base_id': self.base_data['base_id']}
            self.notify_listeners(SpotEventType.OnRequestStop, data)

    def _on_toggle_click(self):
        self.desc_visible = not self.desc_visible

    @property
    def desc_visible(self):
        return self._desc.visible

    @desc_visible.setter
    def desc_visible(self, value):
        if self.desc_visible == value:
            return
        self._desc.visible = value

    def clamp(self):
        comp = self._desc.component
        parent_width = self.component.parent.width
        parent_height = self.component.parent.height
        if parent_width * self._homo_x + comp.width > parent_width:
            homo_x = float(parent_width - comp.width) / parent_width
        else:
            homo_x = self._homo_x
        if parent_height * self._homo_y + comp.height > parent_height:
            homo_y = float(parent_height - comp.height) / parent_height
        else:
            homo_y = self._homo_y
        comp.position = (homo_x * 2 - 1, homo_y * 2 - 1, 0.2)
        sort_value = (homo_x + homo_y) * 0.1
        self._desc.component.position[2] = sort_value

    def set_desc(self, base_data):
        ukr = self.base_data['ukr']
        self._desc.set_data(base_data, ukr)

    def show(self):
        self.desc_visible = False
        self.component.visible = True

    def hide(self):
        self.desc_visible = False
        self.component.visible = False

    def initialize(self, base_data, bounds):
        self.base_data = base_data
        if base_data['ukr']:
            self._mark_button.image = 'soGUI/frame/map/ukr_mark.dds'
        else:
            self._mark_button.image = 'soGUI/frame/map/base_mark.dds'
        x, y = base_data['position']
        min_x, min_y, max_x, max_y = bounds
        width, height = max_x - min_x, max_y - min_y
        self._homo_x = float(x - min_x) / width
        self._homo_y = float(y - min_y) / height
        x = self._homo_x * 2 - 1
        y = self._homo_y * 2 - 1
        width = base_data['radius'] / width * 4
        height = base_data['radius'] / height * 4
        comp = self.component
        comp.position = (x, y, 0.5)
        comp.width, comp.height = width, height
        comp = self.component.circle
        comp.width, comp.height = width, height
        comp.position = (x, y, 0.9)
        if not base_data['owner'] or base_data['state'] == bc.FREE_STATE:
            color = _colors['neutral']
        elif base_data['state'] == bc.UNDERATACK_STATE:
            color = _colors['attack']
        elif base_data['owner'] == BigWorld.player().clanID:
            color = _colors['friend']
        else:
            color = _colors['opponent']
        comp.baseColor = color + (0.12,)
        comp.outlineColor = color + (1,)
        comp = self.component.mark
        comp.position = (x, y, 0.3)
        comp = self._desc.component
        comp.position = (x, y, 0.2)
        self.desc_visible = False