import BigWorld
import GUI
import colorCodes as cc
from Localization import lc
import UCManager
from soGUI.soButton import soButton

class Wreath:
    _interface_id = 'clanboard.line.wreath'

    def __init__(self, component):
        self._ttplace = None
        self.component = component
        return

    def set_place(self, place, show_tooltip):
        self._ttplace = place if show_tooltip and place in (1, 2, 3) else None
        self.component.visible = place in (1, 2, 3)
        return


class Line(soButton):
    height = 68.0
    positions = [None] * 6
    last_time_click = 0

    def __init__(self, component):
        soButton.__init__(self, component)
        self.component.visible = False
        self.initVSC('soGUI/elements/clan_line_button.xml')
        self.onBound()
        self.onClick = self._on_click
        self._texts = []
        sizes = (1.0, 1.0, 3.0, 1.0, 1.0, 1.0)
        width = sum(sizes)
        pos_x = [-1.0]
        index = [0]

        def create_comp(name):
            ratio = sizes[index[0]] / width
            comp = GUI.Window()
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
            comp.width, comp.height = ratio * 2, 2
            comp.position = (pos_x[0], 0, 0.5)
            self.component.addChild(comp, name)
            Line.positions[index[0]] = pos_x[0] + comp.width * 0.5
            pos_x[0] += comp.width
            index[0] += 1

        create_comp('place')
        create_comp('emblem')
        create_comp('name')
        create_comp('mpoints')
        create_comp('points')
        create_comp('level')
        comp = GUI.Text()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        comp.font = 'RobotoCondensedRegular_16.font'
        self.component.name.addChild(comp, 'text')
        self._texts.append(comp)
        comp = GUI.Text()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        comp.font = 'RobotoCondensedRegular_16.font'
        self.component.mpoints.addChild(comp, 'text')
        self._texts.append(comp)
        comp = GUI.Text()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        comp.font = 'RobotoCondensedRegular_16.font'
        self.component.points.addChild(comp, 'text')
        self._texts.append(comp)
        comp = GUI.Text()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        comp.font = 'RobotoCondensedRegular_16.font'
        self.component.level.addChild(comp, 'text')
        self._texts.append(comp)
        comp = GUI.Window('soGUI/maps/Icons/pvp/wreath.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        self.component.place.addChild(comp, 'wreath')
        self._wreath = Wreath(comp)
        comp = GUI.Text()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        comp.font = 'RobotoCondensedRegular_16.font'
        self.component.place.addChild(comp, 'text')
        self._texts.append(comp)
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.materialFX = 'BLEND'
        comp.filterType = 'LINEAR'
        self.component.emblem.addChild(comp, 'icon')

    def set_highlighted(self, value):
        colour = cc.highlighted_rgba if value else cc.active_rgba
        for text in self._texts:
            text.colour = colour

    def _on_click(self):
        if BigWorld.time() <= Line.last_time_click + 0.5:
            return
        Line.last_time_click = BigWorld.time()
        BigWorld.player().base.get_another_clan_info(self._data['clan_name'])

    def _icon_loaded(self, icon_id, feed, texture):
        if self._data and self._data['icon'] and self._data['icon'] == icon_id:
            comp = self.component.emblem.icon
            comp.texture = texture
            comp.width, comp.height = (64, 64)

    def hide(self):
        self.component.visible = False
        self._data = None
        return

    def set_data(self, place, data, show_level_and_reward):
        self.component.name.text.text = data['clan_name'].decode('utf8')
        self.component.points.text.text = unicode(data['clan_point'])
        self.component.mpoints.text.text = unicode(data['month_points'])
        self.component.place.text.text = unicode(place)
        self._wreath.set_place(place, show_level_and_reward)
        if show_level_and_reward:
            self.component.level.text.text = u'{0} {1}'.format(data['level'], lc('clan_win.Clans.Lv'))
            self.component.level.visible = True
        else:
            self.component.level.visible = False
        self._data = data
        if data['icon']:
            UCManager.ucmanager.loadImg(data['icon'], self._icon_loaded)
            comp = self.component.emblem.icon
            comp.textureName = 'soGUI/frame/journal/load_anim/load_pips'
            comp.width, comp.height = comp.texture.width, comp.texture.height
            comp.visible = True
        else:
            self.component.emblem.icon.visible = False
        self.set_highlighted(BigWorld.player().clanID == data['clan_id'])
        self.component.visible = True