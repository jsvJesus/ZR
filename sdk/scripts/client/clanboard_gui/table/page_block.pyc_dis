    def disable_type(self, disable, btn_type):
        if btn_type in (BtnType.Start, BtnType.All):
            self.component.btn_start.script.enabled = not disable
        if btn_type in (BtnType.Prev, BtnType.All):
            self.component.btn_left.script.enabled = not disable
        if btn_type in (BtnType.Next, BtnType.All):
            self.component.btn_right.script.enabled = not disable
        if btn_type in (BtnType.End, BtnType.All):
            self.component.btn_end.script.enabled = not disable

    def _notify_filter_changed(self):
        self.notify_listeners(EventType.OnFilterChanged)

    def _on_filter_changed(self, by_user):
        BigWorld.cancelCallback(self._filter_change_callback)
        if by_user:
            self._filter_change_callback = BigWorld.callback(0.5, self._notify_filter_changed)

    def on_hide(self):
        BigWorld.cancelCallback(self._filter_change_callback)
        self._filter_box.activate(False)

    def get_filter_text(self):
        return self._filter_box.rawText

    def do_reposition(self):
        prev_mode = self.component.widthMode
        self.component.widthMode = 'PIXEL'
        width = self.component.width
        self.component.widthMode = prev_mode
        comp_prev = self.component.btn_left
        comp_prev.position[0] = width * 0.5 - 4
        self.component.btn_start.position[0] = comp_prev.position[0] - comp_prev.width - 2
        comp_right = self.component.btn_right
        comp_right.position[0] = width * 0.5 + 4
        self.component.btn_end.position[0] = comp_right.position[0] + comp_right.width + 2
        for r in self._repositioners:
            r.do_reposition()