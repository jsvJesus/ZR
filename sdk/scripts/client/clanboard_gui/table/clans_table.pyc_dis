# Embedded file name: ./client/clanboard_gui/table/clans_table.py
import GUI
from clans_loader import ClansLoader, EventType as LoaderET
from Helpers.PyGUI import PyGUIBase
from page_block import PageBlock, EventType as PageET, BtnType
from table_line import Line
from Localization import lc
import colorCodes as cc
from soGUI.soTextField import soTextField3

class ClansTable(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._loader = ClansLoader()
        self._loader.add_listener(self._on_loader_event)
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 32)
        comp.position = (0, 0, 0.5)
        self._page_block = PageBlock(comp)
        self._page_block.add_listener(self._on_page_event)
        self.component.addChild(comp)
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (255, 255, 255, 100)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0)
        self.component.addChild(comp, 'loadscreen')
        comp = GUI.Simple('soGUI/frame/journal/load_anim/load_pips')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (0, 0, 0.5)
        self.component.loadscreen.addChild(comp)
        self._captions = []
        for caption in ['Place',
         'Emblem',
         'Name',
         'MPoints',
         'Points',
         'Level']:
            comp = GUI.Text(lc('clan_win.Clans.Captions.' + caption), 'RobotoCondensedRegular_16.font')
            comp.colour = cc.active_rgba
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
            comp.position = (0, 21, 0.5)
            self.component.addChild(comp)
            self._captions.append(comp)

        self._text = soTextField3(GUI.Window(), 1000, 61, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        comp = self._text.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.colour = (255, 255, 255, 255)
        comp.position = (0, self.component.height - 100, 0.1)
        comp.width, comp.height = (500, 30)
        comp.focus = False
        comp.moveFocus = False
        self.component.addChild(comp, 'text')
        self._loaded_params = {'level': None,
         'index': 0}
        self._lines = []
        return

    def recreate_lines(self):
        bottom_space = 104
        top_space = 42
        for i in range(len(self._lines) - 1, -1, -1):
            self.component.delChild(self._lines[i].component)
            del self._lines[i]

        pos_y = top_space
        while pos_y + bottom_space <= self.component.height - Line.height:
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
            comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
            comp.width, comp.height = 2, Line.height
            comp.position = (0, pos_y, 0.5)
            line = Line(comp)
            self.component.addChild(comp)
            self._lines.append(line)
            pos_y += Line.height

        for i, pos in enumerate(Line.positions):
            self._captions[i].position[0] = pos

    def _on_page_event(self, event_type, data):
        if event_type == PageET.OnClick:
            mode = data
            if mode == BtnType.Next:
                self._loaded_params['index'] += len(self._lines)
                self._apply_load_params()
            elif mode == BtnType.Prev:
                self._loaded_params['index'] -= len(self._lines)
                self._apply_load_params()
            elif mode == BtnType.Start:
                self._loaded_params['index'] = 0
                self._apply_load_params()
            elif mode == BtnType.End:
                self._loaded_params['index'] = -1
                self._apply_load_params()
        elif event_type == PageET.OnFilterChanged:
            self._loaded_params['index'] = 0
            self._apply_load_params()

    def _on_loader_event(self, event_type, data):
        if event_type == LoaderET.OnTableLoaded:
            total_count = data['count']
            if self._loaded_params['index'] == -1:
                self._loaded_params['index'] = total_count - len(data['data'])
            show_level_and_reward = self._loaded_params['level'] == -1
            index = self._loaded_params['index']
            i = -1
            for i, line_data in enumerate(data['data']):
                self._lines[i].set_data(index + i + 1, line_data, show_level_and_reward)

            for i in range(i + 1, len(self._lines)):
                self._lines[i].hide()

            self._page_block.disable_type(index - len(self._lines) < 0, BtnType.Start)
            self._page_block.disable_type(index - len(self._lines) < 0, BtnType.Prev)
            self._page_block.disable_type(index + len(self._lines) >= total_count, BtnType.Next)
            self._page_block.disable_type(index + len(self._lines) >= total_count, BtnType.End)
            self._captions[-1].visible = show_level_and_reward
            text = data['last_reward'].decode('utf-8').format(lc('clan_win.Clans.place'))
            text = u'{0}{1} {2}{3}'.format(cc.highlighted_xml, lc('clan_win.Clans.LastMonthReward'), cc.active_xml, text)
            text = u'<font=RobotoCondensedRegular_16.font><alignment=center>' + text
            self._text.setText(text)
        elif event_type == LoaderET.OnLoadChanged:
            self.component.loadscreen.visible = self._loader.loading

    def on_show(self):
        self._loader.on_show()

    def on_hide(self):
        self._page_block.on_hide()

    def set_level(self, level):
        self._loaded_params['level'] = level
        self._loaded_params['index'] = 0
        self._apply_load_params()

    def _apply_load_params(self):
        self._page_block.disable_type(True, BtnType.All)
        level = self._loaded_params['level']
        if level is None:
            for line in self._lines:
                line.component.visible = False

            self._loader.stop_load()
        else:
            count = len(self._lines)
            filter_text = self._page_block.get_filter_text()
            self._loader.load_level(level, self._loaded_params['index'], count, filter_text)
        return

    def do_reposition(self):
        comp = self._page_block.component
        comp.position[1] = comp.parent.height - 58
        self._page_block.do_reposition()
        self._text.component.position.y = self.component.height - 100
        self.recreate_lines()
        if self._loaded_params['level'] is not None:
            self._loaded_params['index'] = 0
            self._apply_load_params()
        return