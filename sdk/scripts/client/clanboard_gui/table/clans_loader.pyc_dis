# Embedded file name: ./client/clanboard_gui/table/clans_loader.py
import BigWorld
from utils import Listenable
from functools import partial

class EventType:
    OnTableLoaded, OnLoadChanged = ((r, 'clans_loader') for r in range(2))


class ClansLoader(Listenable):

    def __init__(self):
        Listenable.__init__(self)
        self._request_id = 0
        self._loading = False
        self._pending_request_id = None
        self._request_pend_handler = 0
        return

    def _next_request_id(self):
        self._request_id = (self._request_id + 1) % 100
        return self._request_id

    def load_level(self, level, index, count, filter_text):
        self.loading = True
        self._pending_request_id = self._next_request_id()
        BigWorld.cancelCallback(self._request_pend_handler)
        foo = partial(BigWorld.player().base.get_rating_table0, level, index, count, filter_text.lower(), self._pending_request_id)
        self._request_pend_handler = BigWorld.callback(0.5, foo)

    def stop_load(self):
        self._pending_request_id = None
        BigWorld.cancelCallback(self._request_pend_handler)
        self.loading = False
        return

    def _on_got_rating_table(self, data, count, has_reward, last_reward, request_id):
        if self._pending_request_id != request_id:
            return
        data = {'data': data,
         'count': count,
         'has_reward': has_reward,
         'last_reward': last_reward}
        self.notify_listeners(EventType.OnTableLoaded, data)
        self.loading = False

    def on_show(self):
        BigWorld.player().send_clan_rating0 = self._on_got_rating_table

    def on_hide(self):
        pass

    @property
    def loading(self):
        return self._loading

    @loading.setter
    def loading(self, value):
        if self._loading == value:
            return
        self._loading = value
        self.notify_listeners(EventType.OnLoadChanged)