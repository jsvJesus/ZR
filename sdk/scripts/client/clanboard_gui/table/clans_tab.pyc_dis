import GUI
from clans_table import ClansTable
from ..tab import Tab
from ..tab_view import TabView
from Localization import lc

class ClansTabView(TabView):

    def __init__(self, component):
        TabView.__init__(self, component)
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.width = 2
        comp.position = (0, -1, 0.5)
        self._clans_table = ClansTable(comp)
        self.component.addChild(comp)

    def create_tabs(self, components_provider):
        tabs = [{'caption': lc('clan_win.Clans.All'),
          'tab': Tab(None)}]
        for i in range(1, 6):
            tabs.append({'caption': unicode(i) + u' ' + lc('clan_win.Clans.Level'),
             'tab': Tab(None)})

        return tabs

    def on_active_tab_changed(self, index, prev_index):
        if index == 0:
            level = -1
        else:
            level = index
        self._clans_table.set_level(level)

    def on_show(self):
        TabView.on_show(self)
        self._clans_table.on_show()

    def on_hide(self):
        TabView.on_hide(self)
        self._clans_table.on_hide()

    def do_reposition(self):
        TabView.do_reposition(self)
        comp = self._clans_table.component
        comp.heightMode = 'CLIP'
        comp.height = 2
        comp.heightMode = 'PIXEL'
        comp.height -= TabView.buttons_height
        self._clans_table.do_reposition()


