class LineEventType:
    OnEnter, OnLeft, OnDown = ((r, 'fractline') for r in range(3))


class ScrollEventType:
    OnSelectionChanged, = ((r, 'scrollfractline') for r in range(1))


class Line(PyGUIBase, Listenable):
    height = 22

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        Listenable.__init__(self)
        self._hovered = False
        self._selected = False
        self._enabled = False
        self.component.script = self
        self.component.crossFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.component.visible = False
        self.component.materialFX = 'BLEND'
        comp = GUI.Text(u'', 'RobotoCondensedRegular_18.font')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width, self.component.height
        comp.position = (32, 0, 0.5)
        self.component.addChild(comp, 'name')
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (18, 18)
        comp.position = (8, 0, 0.5)
        self.component.addChild(comp, 'button')

    def initialize(self, fract_id):
        self.fract_id = fract_id
        self.component.name.text = rep_utils.get_name(fract_id)
        self._update_visual()

    def handleMouseEnterEvent(self, comp):
        if self._enabled:
            self.notify_listeners(LineEventType.OnEnter, self)
        return False

    def handleMouseLeaveEvent(self, comp):
        if self._enabled:
            self.notify_listeners(LineEventType.OnLeft, self)
        return False

    def _update_visual(self):
        if not self._enabled:
            self.component.name.colour = (255, 255, 255, 100)
        elif self._selected:
            self.component.name.colour = (255, 255, 255, 255)
        else:
            self.component.name.colour = (255, 255, 255, 200)
        if self._enabled and self._hovered:
            self.component.colour = (255, 255, 255, 50)
        else:
            self.component.colour = (255, 255, 255, 0)
        if self._selected:
            self.component.button.textureName = 'soGUI/frame/map/radiobuttonon.dds'
        else:
            self.component.button.textureName = 'soGUI/frame/map/radiobuttonoff.dds'

    def set_enabled(self, value):
        self._enabled = value
        self._update_visual()

    def set_hovered(self, value):
        self._hovered = value
        self._update_visual()

    def set_selected(self, value):
        self._selected = value
        self._update_visual()

    def handleMouseButtonEvent(self, comp, event):
        if self._enabled:
            if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
                self.notify_listeners(LineEventType.OnDown, self)
        return False


class ScrollView(PyGUIBase, Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        PyGUIBase.__init__(self, component)
        self._visible_count = 10
        self._lines = []
        self.component.script = self
        self.component.crossFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.component.height = Line.height * self._visible_count
        self._hovered = None
        self._selected = None
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width, 0, 0.5)
        self._sb = soScrollBar2(comp, steps=5, height=self.component.height)
        self._sb.setValue(0)
        self._sb.setVisualState('normal')
        self._sb.scrollUp = self._scroll_up
        self._sb.scrollDown = self._scroll_down
        self._sb.scrollMoved = self._scroll_moved
        self._sb.onBound()
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width - 18, 330
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'view')
        return

    def _on_line_event(self, event_type, line):
        if event_type == LineEventType.OnEnter:
            self.hovered = line
        elif event_type == LineEventType.OnLeft:
            if self.hovered == line:
                self.hovered = None
        elif event_type == LineEventType.OnDown:
            self.selected = line
        return

    def _set_scroll_value(self, value):
        value = clamp(value, 0, self._sb.steps)
        if self._sb.getValue() == value:
            return
        self._sb.setValue(value)
        self.component.view.position[1] = -Line.height * value

    def _create_line(self):
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.width, comp.height = self.component.view.width, Line.height
        comp.position = (0, 0, 0.5)
        self.component.view.addChild(comp)
        line = Line(comp)
        line.add_listener(self._on_line_event)
        self._lines.append(line)

    def activate_fractions(self, awailable_fractions, cur_fraction):
        awailable_fractions = set(awailable_fractions)
        for line in self._lines:
            if line.fract_id in awailable_fractions:
                line.set_enabled(True)
            if line.fract_id == cur_fraction:
                self.selected = line

    def set_fractions(self, fractions):
        count = len(fractions)
        self._sb.setSteps(max(0, count - self._visible_count))
        self.component.view.height = count * Line.height
        self.hovered = None
        self.selected = None
        for line in self._lines:
            line.component.visible = False

        while len(self._lines) < count:
            self._create_line()

        for i, fract_id in enumerate(fractions):
            line = self._lines[i]
            line.component.position[1] = i * Line.height
            line.component.visible = True
            line.initialize(fract_id)
            line.set_enabled(False)

        return

    @property
    def selected(self):
        return self._selected

    @selected.setter
    def selected(self, value):
        if self._selected == value:
            return
        if self._selected:
            self._selected.set_selected(False)
        self._selected = value
        if self._selected:
            self._selected.set_selected(True)
        self.notify_listeners(ScrollEventType.OnSelectionChanged)

    @property
    def hovered(self):
        return self._hovered

    @hovered.setter
    def hovered(self, value):
        if self._hovered == value:
            return
        if self._hovered:
            self._hovered.set_hovered(False)
        self._hovered = value
        if self._hovered:
            self._hovered.set_hovered(True)

    def handleMouseEvent(self, comp, event):
        dz = event.dz
        if dz > 0:
            self._scroll_up()
            return True
        if dz < 0:
            self._scroll_down()
            return True
        return True

    def _scroll_moved(self, value):
        self._set_scroll_value(value)

    def _scroll_down(self):
        self._set_scroll_value(self._sb.getValue() + 1)

    def _scroll_up(self):
        self._set_scroll_value(self._sb.getValue() - 1)


class FractWin(DragWin):

    def __init__(self):
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'SOLID'
        comp.position = (0, 0, 0.4)
