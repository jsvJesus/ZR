        self.component.addChild(comp, 'closeBox')
        btn.onBound()
        btn.initVSC('soGUI/elements/closeBox.xml')
        btn.onClick = self.hide
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (20, 48, 0.8)
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width = 322
        self.component.addChild(comp)
        self._scroll = ScrollView(comp)
        self._scroll.add_listener(self._on_scroll_event)
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('clan_win.FractWin.Change')
        comp.width, comp.height = (86, 26)
        comp.position = (self.component.width / 2 - 16, 316, 0.1)
        comp.script.onClick = self._on_change_click
        self.component.addChild(comp)
        btn.onBound()
        self._change_btn = btn
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('clan_win.FractWin.Cancel')
        comp.width, comp.height = (86, 26)
        comp.position = (self.component.width / 2 + 16, 316, 0.1)
        comp.script.onClick = self.hide
        self.component.addChild(comp)
        btn.onBound()
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width = self.component.width - 64
        comp.position = (32, 328, 0.5)
        self.component.addChild(comp)
        tf = soTextField3(comp, width=comp.width, textWidth=comp.width, height=200)
        text = cc.inactive_xml + u'<font=RobotoCondensedRegular_18.font><alignment=center>' + lc('clan_win.FractWin.Costnotify').format(cc.active_xml + unicode(CHANGE_TRADER_FRACT_COST))
        tf.setText(text, immidiate=True)

    @property
    def visible(self):
        return self.component.visible

    def show(self, traderuniname):
        if self.component.visible:
            return
        self._traderuniname = traderuniname
        self.component.visible = True
        self._on_show()
        BigWorld.player().on_got_available_tradefractions = self._on_got_available_tradefractions
        BigWorld.player().got_trader_fraction = self._got_trader_fraction
        BigWorld.player().cell.get_available_tradefractions0(self._traderuniname)

    def _on_change_click(self):
        BigWorld.player().cell.buy_change_trader_fract0(self._traderuniname, self._scroll.selected.fract_id)
        self.hide()

    def _on_scroll_event(self, event_type, data):
        if event_type == ScrollEventType.OnSelectionChanged:
            self._update_change_button()

    def _update_change_button(self):
        enabled = self._cur_fraction is not None and self._scroll.selected and self._scroll.selected.fract_id != self._cur_fraction
        self._change_btn.setDisabledState(not enabled)
        return

    def _on_show(self):
        BWPersonality.GUICore.setBestCursor()
        pixelperfect_component(self.component)
        self._awaited_answer.clear()
        self._cur_fraction = None
        self._update_change_button()
        base_name = BigWorld.player().get_current_base_name()
        fractions = set()
        for bn in config.get_spot(base_name):
            fraction = config.get_fraction(bn)
            if fraction:
                fractions.add(fraction)

        self._scroll.set_fractions(fractions)
        return

    def _on_got_available_tradefractions(self, fractions):
        self._awaited_answer['fractions'] = fractions
        if len(self._awaited_answer) == 2:
            self._on_answer_ready()

    def _got_trader_fraction(self, fract_id):
        self._awaited_answer['fract_id'] = fract_id
        if len(self._awaited_answer) == 2:
            self._on_answer_ready()

    def _on_answer_ready(self):
        awailable_fractions = self._awaited_answer['fractions']
        self._cur_fraction = self._awaited_answer['fract_id']
        self._awaited_answer.clear()
        self._scroll.activate_fractions(awailable_fractions, self._cur_fraction)

    def _on_hide(self):
        BWPersonality.GUICore.setBestCursor()
        self._awaited_answer.clear()

    def hide(self):
        if not self.component.visible:
            return
        self.component.visible = False
        self._on_hide()