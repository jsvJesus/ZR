# Embedded file name: ./client/clanboard_gui/recruit/filter_view.py
import colorCodes as cc
from Localization import lc
import GUI
from soGUI.soDropDownList import soDropDownList2
import ClanSettings
from soGUI.soButton import soButton
from soGUI.soEditField import soEditBox2
from filter_model import EventType as FilterET, SortType

class FilterView:

    def __init__(self, component, nav_comp, model):
        self._component = component
        self._model = model
        self._model.add_listener(self._on_model_event)
        pos_y = 18
        text = cc.inactive_hex + lc('clan_win.Recruit.Filter.Level').format(cc.active_hex)
        comp = GUI.Text(text, 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.colourFormatting = True
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (8, 18, 0.5)
        component.addChild(comp)
        comp.width = comp.stringDimensions(comp.text)[0]
        text_comp = comp
        comp = GUI.Window()
        ddl = soDropDownList2(comp, width=180, height=26, listHeight=130)
        ddl.onSelectedElement = self._on_level_changed
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (text_comp.position.x + text_comp.width + 8, pos_y, 0.5)
        component.addChild(comp)
        level_text = u' ' + lc('clan_win.Recruit.Filter.Lev')
        elements = [ (lev, unicode(lev) + level_text) for lev in range(1, ClanSettings.get_max_level() + 1) ]
        elements.insert(0, (0, lc('clan_win.Recruit.Filter.All')))
        ddl.addElements(elements)
        ddl.setSelectionByValue(0, silent=True)
        self._ddl = ddl
        text = cc.inactive_hex + lc('clan_win.Recruit.Filter.Sort').format(cc.active_hex)
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.position = (0, 18, 0.5)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        btn = soButton(comp)
        comp.label.text = text
        comp.label.ha = 'RIGHT'
        comp.label.position[0] = 1
        btn.initVSC('soGUI/elements/sale_inactive.xml')
        btn.onBound()
        btn.onClick = self._on_sort_click
        comp.width, comp.height = comp.label.stringDimensions(comp.label.text)[0], 18
        component.addChild(comp, 'btn_text')
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (18, 18)
        comp.position = (0, 18, 0.4)
        btn = soButton(comp)
        btn.onClick = self._on_sort_click
        btn.setVisualState('normal')
        component.addChild(comp)
        self._btn_arrow = btn
        comp = nav_comp
        self._edit = soEditBox2(comp, 220, 21, placeholder=lc('clan_win.Recruit.Filter.Search'))
        self._edit.onValueChange = self._on_filtertext_changed
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (0, 0, 0.5)

    def _on_sort_click(self):
        self._model.toggle_sort()

    def _on_model_event(self, event_type, data):
        if event_type in (FilterET.OnLevelChanged, FilterET.OnSortChanged, FilterET.OnFiltertextChanged):
            self._update_content()

    def _on_filtertext_changed(self, by_user):
        self._model.set_filtertext(self._edit.getRaw())

    def _on_level_changed(self, level):
        self._model.set_level(level)

    def _update_content(self):
        self._ddl.setSelectionByValue(self._model.level, silent=True)
        if self._model.sort == SortType.DateForward:
            self._btn_arrow.initVSC('soGUI/elements/sale_arrow_down.xml')
        elif self._model.sort == SortType.DateBackward:
            self._btn_arrow.initVSC('soGUI/elements/sale_arrow_up.xml')
        self._btn_arrow.onBound()

    def on_show(self):
        self._update_content()
        self._edit.onValueChange = lambda *args: None
        if self._edit.getValue() != self._model.filter_text:
            self._edit.setValue(self._model.filter_text)
        self._edit.onValueChange = self._on_filtertext_changed

    def on_hide(self):
        self._ddl.showList(False)
        self._edit.activate(False)

    def do_reposition(self):
        self._ddl.showList(False)
        mode = self._component.wm
        self._component.wm = 'PIXEL'
        width = self._component.width
        self._component.wm = mode
        comp = self._btn_arrow.component
        comp.position[0] = width
        comp = self._component.btn_text
        comp.position[0] = width - 20