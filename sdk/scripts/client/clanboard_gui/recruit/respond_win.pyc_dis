        btn.initVSC('soGUI/elements/closeBox.xml')
        btn.onBound()
        btn.onClick = self.hide
        self.component.addChild(comp)
        margin = 16
        self._clan_id = None
        comp = GUI.Window()
        self._text_edit = soEditBox(comp, width=self.component.width - margin * 2, height=92, autosize=False, hOffset=3, vOffset=3, font='RobotoCondensedRegular_16.font', color=(220, 220, 220, 255), multiline=True, inputValidator=self._text_validator)
        self._text_edit.onValueChange = self._on_text_value_changed
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
