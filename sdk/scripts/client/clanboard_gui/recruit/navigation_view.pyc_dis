# Embedded file name: ./client/clanboard_gui/recruit/navigation_view.py
from utils import Listenable
import GUI
from Localization import lc
from soGUI.UtilsGUI.PaintButton import PaintButton
from pos_model import EventType as PosET
from load_model import EventType as LoadET, State as LoadState

class EventType:
    OnNextRequested, OnPrevRequested, OnStartRequested, OnEndRequested = ((r, 'RecruitNavView') for r in range(4))


class NavigationView(Listenable):

    def __init__(self, comp, pos_model, load_model):
        Listenable.__init__(self)
        self.component = comp
        self._repositioners = []
        self._pos_model = pos_model
        self._pos_model.add_listener(self._on_pos_model_event)
        self._load_model = load_model
        self._load_model.add_listener(self._on_load_model_event)
        btn_width0 = 96
        btn_width1 = 132
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'CLIP')
        comp.width, comp.height = btn_width0, 2
        comp.position = (0, 0, 0.5)
        btn = PaintButton(comp, visual_state='soGUI/frame/paint/salepages_left.xml')
        btn.image = 'soGUI/elements/arrow_pag_start.dds'
        btn.text = lc('sales.FILTERS.PAGEBLOCK.START')
        btn.on_click = self._on_start_click
        self._repositioners.append(btn)
        self.component.addChild(comp, 'btn_start')
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
        comp.width, comp.height = btn_width1, 2
        comp.position = (0, 0, 0.5)
        btn = PaintButton(comp, visual_state='soGUI/frame/paint/salepages_left.xml')
        btn.image = 'soGUI/elements/arrow_pag_left.dds'
        btn.text = lc('sales.FILTERS.PAGEBLOCK.PREV')
        btn.on_click = self._on_left_click
        self._repositioners.append(btn)
        self.component.addChild(comp, 'btn_left')
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
        comp.width, comp.height = btn_width1, 2
        comp.position = (0, 0, 0.5)
        btn = PaintButton(comp, visual_state='soGUI/frame/paint/salepages_right.xml')
        btn.image = 'soGUI/elements/arrow_pag_left.dds'
        btn.text = lc('sales.FILTERS.PAGEBLOCK.NEXT')
        btn.on_click = self._on_right_click
        self._repositioners.append(btn)
        self.component.addChild(comp, 'btn_right')
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
        comp.width, comp.height = btn_width0, 2
        comp.position = (0, 0, 0.5)
        btn = PaintButton(comp, visual_state='soGUI/frame/paint/salepages_right.xml')
        btn.image = 'soGUI/elements/arrow_pag_start.dds'
        btn.text = lc('sales.FILTERS.PAGEBLOCK.END')
        btn.on_click = self._on_end_click
        self._repositioners.append(btn)
        self.component.addChild(comp, 'btn_end')

    def on_show(self):
        self._update_availability()

    def _on_load_model_event(self, event_type, data):
        if event_type == LoadET.OnStateChanged:
            self._update_availability()

    def _on_pos_model_event(self, event_type, data):
        if event_type in (PosET.OnTotalChanged, PosET.OnSizeChanged, PosET.OnIndexChanged):
            self._update_availability()

    def _update_availability(self):
        if self._load_model.state == LoadState.Ready:
            has_right_space = self._pos_model.index > 0
            self.component.btn_start.script.enabled = has_right_space
            self.component.btn_left.script.enabled = has_right_space
            has_left_space = self._pos_model.index + self._pos_model.size < self._pos_model.total
            self.component.btn_end.script.enabled = has_left_space
            self.component.btn_right.script.enabled = has_left_space
        else:
            self._disable_all()

    def _disable_all(self):
        self.component.btn_start.script.enabled = False
        self.component.btn_end.script.enabled = False
        self.component.btn_left.script.enabled = False
        self.component.btn_right.script.enabled = False

    def _on_right_click(self):
        self.notify_listeners(EventType.OnNextRequested)

    def _on_left_click(self):
        self.notify_listeners(EventType.OnPrevRequested)

    def _on_start_click(self):
        self.notify_listeners(EventType.OnStartRequested)

    def _on_end_click(self):
        self.notify_listeners(EventType.OnEndRequested)

    def do_reposition(self):
        prev_mode = self.component.widthMode
        self.component.widthMode = 'PIXEL'
        width = self.component.width
        self.component.widthMode = prev_mode
        comp_prev = self.component.btn_left
        comp_prev.position[0] = width * 0.5 - 4
        self.component.btn_start.position[0] = comp_prev.position[0] - comp_prev.width - 2
        comp_right = self.component.btn_right
        comp_right.position[0] = width * 0.5 + 4
        self.component.btn_end.position[0] = comp_right.position[0] + comp_right.width + 2
        for r in self._repositioners:
            r.do_reposition()