import Clan

class PublishEventType:
    OnRespondRequested, OnPublishRequested, OnEditRequested = ((r, 'RecruitPublishWin') for r in range(3))


class State(object):

    def __init__(self, win):
        self._win = win
        self._component = self._win.component
        self._margin = 16
        self._icon_id = None
        self._clan_id = None
        return

    def on_enter(self):
        self._component.icon.visible = False

    def on_exit(self):
        self._clan_id = None
        self._icon_id = None
        return

    def apply_data(self, data):
        self._clan_id = data.get('clan_id')
        self._component.clevel.text = u'{0} {1}'.format(cc.inactive_hex + lc('clan_win.Recruit.PWin.CLevel'), cc.active_hex + unicode(data['clan_level']))
        self._component.name.text = u'{0} {1}'.format(cc.inactive_hex + lc('clan_win.Recruit.PWin.Name'), cc.active_hex + data['clan_name'].decode('utf8'))
        self._component.icon.visible = False
        self._icon_id = data['icon_id']
        if self._icon_id:
            UCManager.ucmanager.loadImg(self._icon_id, self._icon_loaded)

    def _icon_loaded(self, icon_id, feed_name, texture):
        if self._icon_id == icon_id:
            self._component.icon.visible = True
            self._component.icon.texture = texture


class PublishState(State):

    def __init__(self, win, publish_callback):
        State.__init__(self, win)
        self._publish_callback = publish_callback
        self._container = GUI.Simple(u'')
        self._container.position = (0, 0, 0.5)
        self._container.visible = False
        self._component.addChild(self._container)
        comp = GUI.Window()
        self._level_edit = soEditBox2(comp, 120, 21, inputValidator=self._int_validator)
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (self._win._plevel_pos[0] + 4, self._win._plevel_pos[1], 0.5)
        self._container.addChild(comp)
        comp = GUI.Window()
        self._text_edit = soEditBox(comp, width=self._component.width - self._margin * 2, height=86, autosize=False, hOffset=3, vOffset=3, font='RobotoCondensedRegular_16.font', color=(220, 220, 220, 255), multiline=True, inputValidator=self._text_validator)
        self._text_edit.onValueChange = self._on_text_value_changed
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.position = (self._margin, 124, 0.5)
        self._container.addChild(comp)
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('clan_win.Recruit.PWin.Publish')
        comp.width, comp.height = (144, 25)
        comp.position = (self._margin, self._component.height - self._margin, 0.5)
        btn.onClick = self._on_publish_click
        self._container.addChild(comp, 'btn_publish')
        btn.onBound()
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.colour = cc.inactive_rgba
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (0, self._component.height - 28, 0.5)
        self._container.addChild(comp)
        self._counter = comp

    def _text_validator(self, new_str, whole_text, offset):
        potential_text = whole_text[:offset] + new_str + whole_text[offset:]
        lines = potential_text.split('\n')
        if len(lines) > 4:
            return False
        if len(potential_text) > Clan.RECR_MAX_COMMENT_LENGTH:
            return False
        return True

    def _int_validator(self, new_str, whole_text, offset):
        potential_text = whole_text[:offset] + new_str + whole_text[offset:]
        try:
            value = int(potential_text)
            return 0 <= value <= pp.MAX_LEVEL
        except ValueError:
            return False

    def _on_text_value_changed(self, by_user):
        self._update_counter()

    def _update_counter(self):
        text = self._text_edit.getRaw()
        self._counter.text = u'{0}/{1}'.format(len(text), Clan.RECR_MAX_COMMENT_LENGTH)

    def on_enter(self):
        State.on_enter(self)
        self._container.visible = True
        self._update_counter()
        self._level_edit.setValue(u'1')
        self._container.btn_publish.script.setDisabledState(False)

    def on_exit(self):
        State.on_exit(self)
        self._text_edit.clear()
        self._level_edit.clear()
        self._text_edit.activate(False)
        self._level_edit.activate(False)
        self._container.visible = False

    def _on_publish_click(self):
        text = self._text_edit.getRaw()
        try:
            player_level = int(self._level_edit.getRaw())
        except:
            player_level = 1

        self._publish_callback(text.encode('utf8'), player_level)


class InvestigateState(State):
    _request_id = 0

    def __init__(self, win, respond_callback):
        State.__init__(self, win)
        self._respond_callback = respond_callback
        self._container = GUI.Simple(u'')
        self._container.position = (0, 0, 0.5)
        self._container.visible = False
        self._component.addChild(self._container)
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (self._win._plevel_pos[0] + 4, self._win._plevel_pos[1], 0.5)
        comp.colour = cc.active_rgba
        self._container.addChild(comp, 'plevel')
        comp = GUI.Window('')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.width, comp.height = self._component.width - self._margin * 2, 92
        comp.position = (self._margin, 124, 0.5)
        self._tf = soTextField3(comp, width=comp.width, textWidth=comp.width, height=comp.height)
        self._container.addChild(comp)
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('clan_win.Recruit.PWin.Respond')
        comp.width, comp.height = (144, 25)
        comp.position = (self._margin, self._component.height - self._margin, 0.5)
        btn.onClick = self._on_respond_click
        self._container.addChild(comp, 'btn_respond')
        btn.onBound()

    def _on_respond_click(self):
        self._respond_callback(self._clan_id)

    def on_enter(self):
        State.on_enter(self)
        self._container.visible = True
        self._container.btn_respond.script.setDisabledState(True)

    def apply_data(self, data):
        State.apply_data(self, data)
        p = BigWorld.player()
        p.got_recruit_info0 = self._got_recruit_info
        self._container.plevel.text = unicode(data['player_level'])
        self._tf.setText(u'...', immidiate=True)
        InvestigateState._request_id = 120 % (InvestigateState._request_id + 1)
        p.base.get_recruit_info0(data['clan_id'], InvestigateState._request_id)
        can_respond = not bool(p.clanID) and p.get_level() >= data['player_level']
        self._container.btn_respond.script.setDisabledState(not can_respond)

    def _got_recruit_info(self, publishment, request_id, is_valid):
        if request_id != InvestigateState._request_id:
            return
        if not is_valid:
            self._win._not_valid_request()
            return
        self._tf.setText(cc.active_xml + publishment.decode('utf8'), immidiate=True)

    def on_exit(self):
        State.on_exit(self)
        self._container.visible = False
        BigWorld.player().got_recruit_info0 = lambda *args: None


class EditState(PublishState):
    _request_id = 0

    def apply_data(self, data):
        PublishState.apply_data(self, data)
        self._level_edit.setValue(unicode(data['player_level']))
        p = BigWorld.player()
        p.got_recruit_info0 = self._got_recruit_info
        EditState._request_id = 120 % (EditState._request_id + 1)
        p.base.get_recruit_info0(data['clan_id'], EditState._request_id)
        self._container.btn_publish.script.setDisabledState(True)

    def _got_recruit_info(self, publishment, request_id, is_valid):
        if request_id != EditState._request_id:
            return
        if not is_valid:
            self._win._not_valid_request()
            return
        self._text_edit.setValue(publishment.decode('utf8'))
        self._container.btn_publish.script.setDisabledState(False)

    def on_exit(self):
        PublishState.on_exit(self)
        BigWorld.player().got_recruit_info0 = lambda *args: None


