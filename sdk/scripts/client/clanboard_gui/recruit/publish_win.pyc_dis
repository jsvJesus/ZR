        self._publish_state = PublishState(self, self._on_publish_requested)
        self._edit_state = EditState(self, self._on_edit_requested)
        return

    def _not_valid_request(self):
        BigWorld.player().systemMsgChat(lc('clan_win.Recruit.NotValidClan'))
        self.hide()

    def _on_publish_requested(self, message, player_level):
        data = {'message': message,
         'player_level': player_level}
        self.notify_listeners(PublishEventType.OnPublishRequested, data)

    def _on_edit_requested(self, message, player_level):
        data = {'message': message,
         'player_level': player_level}
        self.notify_listeners(PublishEventType.OnEditRequested, data)

    def _on_respond_requested(self, clan_id):
        data = {'clan_id': clan_id}
        self.notify_listeners(PublishEventType.OnRespondRequested, data)

    def show_edit(self, clan_id, clan_level, clan_name, icon_id, player_level):
        data = {'clan_level': clan_level,
         'clan_name': clan_name,
         'icon_id': icon_id,
         'clan_id': clan_id,
         'player_level': player_level}
        self.component.visible = True
        self.state = self._edit_state
        self.state.apply_data(data)

    def show_publish(self, clan_level, clan_name, icon_id):
        data = {'clan_level': clan_level,
         'clan_name': clan_name,
         'icon_id': icon_id}
        self.component.visible = True
        self.state = self._publish_state
        self.state.apply_data(data)

    def show_investigate(self, clan_id, clan_level, clan_name, player_level, icon_id):
        data = {'clan_id': clan_id,
         'clan_level': clan_level,
         'clan_name': clan_name,
         'player_level': player_level,
         'icon_id': icon_id}
        self.component.visible = True
        self.state = self._investigate_state
        self.state.apply_data(data)

    def hide(self):
        if self.component.visible:
            self.component.visible = False
            self._on_hide()

    def _on_hide(self):
        self.state = None
        return

    @property
    def state(self):
        return self._state

    @state.setter
    def state(self, value):
        if value == self._state:
            return
        if self._state:
            self._state.on_exit()
        self._state = value
        if self._state:
            self._state.on_enter()