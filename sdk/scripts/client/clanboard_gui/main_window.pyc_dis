            BWPersonality.GUICore.clan_card.hide()
        AudioMixer.blend_volume_to(1.0, 'CLANBOARD_GUI', blend_time=0.5, bus_ids=AudioMixer.NO_UI_BUS_IDS)

    def doReposition(self):
        self._dirty_layout = True
        if self.visible:
            self.do_reposition()

    def do_reposition(self):
        self._dirty_layout = False
        top, bottom, left, right = (32, 0, 8, 8)
        comp = self.component.tab_comp
        sw, sh = BigWorld.screenSize()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = sw - left - right, sh - top - bottom
        comp.position = (left, top, 0.5)
        self.component.close_btn.position[0] = sw - 8
        self._tab_view.do_reposition()
        pixelperfect_component(self.component)

