# Embedded file name: ./client/clanboard_gui/tab_view.py
from Helpers.PyGUI import PyGUIBase
from soGUI.soButton import soButton
from functools import partial
import GUI

class Button:

    def __init__(self, component, caption):
        self.component = component
        self.on_click = lambda : None
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.materialFX = 'SOLID'
        comp.width, comp.height = (2, 29)
        comp.position = (0, 1, 0.5)
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        btn.soundControlName = 'clan_base_tab'
        btn.onBound()
        btn.onClick = lambda : self.on_click()
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = caption
        comp.label.verticalPositionMode = 'PIXEL'
        comp.label.position[1] = 16
        self.component.addChild(comp)
        comp = GUI.Simple('textures/default/bright_gray.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.materialFX = 'BLEND'
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 1)
        comp.position = (0, self.component.height - 4, 0.5)
        self.component.addChild(comp, 'line')

    def set_active(self, value):
        comp = self.component.line
        comp.colour.alpha = 255 if value else 120


class TabView(PyGUIBase):
    buttons_height = 36

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._cur_index = None
        self._last_visible_index = None

        def create_tab_component():
            comp = GUI.Window()
            comp.materialFX = 'SOLID'
            comp.visible = False
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
            comp.widthMode = 'CLIP'
            comp.width = 2
            comp.position = (0, TabView.buttons_height, 0.5)
            self.component.addChild(comp)
            return comp

        self._buttons = []
        self._tabs = []
        for i, tab_data in enumerate(self.create_tabs(create_tab_component)):
            self._tabs.append(tab_data['tab'])
            comp = GUI.Window()
            comp.materialFX = 'SOLID'
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.height = TabView.buttons_height
            self.component.addChild(comp)
            btn = Button(comp, tab_data['caption'])
            btn.on_click = partial(self._on_tab_click, i)
            self._buttons.append(btn)

        return

    def create_tabs(self, components_provider):
        raise NotImplementedError

    def _on_tab_click(self, index):
        self._set_tab_active(index)

    def _set_tab_active(self, index):
        if self._cur_index == index:
            return
        else:
            prev_index = self._cur_index
            if self._cur_index is not None:
                self._tabs[self._cur_index].on_hide()
                comp = self._tabs[self._cur_index].component
                if comp:
                    comp.visible = False
            self._cur_index = index
            if self._cur_index is not None:
                self._tabs[self._cur_index].on_show()
                comp = self._tabs[self._cur_index].component
                if comp:
                    comp.visible = True
            for i, btn in enumerate(self._buttons):
                btn.set_active(i == self._cur_index)

            self.on_active_tab_changed(self._cur_index, prev_index)
            return

    def on_active_tab_changed(self, index, prev_index):
        pass

    def on_show(self):
        index_to_show = 0 if self._last_visible_index is None else self._last_visible_index
        self._last_visible_index = None
        self._set_tab_active(index_to_show)
        return

    def on_hide(self):
        self._last_visible_index = self._cur_index
        self._set_tab_active(None)
        return

    def do_reposition(self):
        space = 4.0
        prev_mode = self.component.widthMode
        self.component.widthMode = 'PIXEL'
        comp_width = float(self.component.width)
        self.component.widthMode = prev_mode
        spaces_width = (len(self._buttons) - 1) * space
        width = (comp_width - spaces_width) / len(self._buttons)
        pos_x = 0.0
        for i, btn in enumerate(self._buttons):
            btn.component.position = (pos_x, 0, 0.5)
            btn.component.width = width
            pos_x += width + space

        for tab in self._tabs:
            comp = tab.component
            if not comp:
                continue
            comp.heightMode = 'CLIP'
            comp.height = 2
            comp.heightMode = 'PIXEL'
            comp.height -= TabView.buttons_height
            tab.do_reposition()