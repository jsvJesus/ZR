    def onChangeActiveWeapon1(self, new_weapon):
        """ \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd1\x80\xd1\x83\xd0\xb6\xd0\xb8\xd0\xb5
        """
        pass

    def onSwithScopeReticle(self):
        if self.binoculing and self.binocularDevice:
            self.binocularDevice.switchNightVision()
            return self.updateScopeParam()
        if not self.active_weapon:
            return
        attach = self.active_weapon.getCurrentIronSight()
        if not attach:
            return
        if attach.switchScopeReticle():
            self.active_weapon.playSoundScopeReticle(attach)
            self.addWeaponSettings(reticle_index=attach._current_scope_reticle_index)
            return self.updateScopeParam()
        if attach.switchIronSightMode():
            self.active_weapon.playSoundShootingMode()

    def onChangeVisibleWeaponModel1(self, weapon, model):
        if weapon:
            new_id = weapon.getItemID()
            active_id = self.active_weapon and self.active_weapon.getItemID()
            return new_id and new_id != active_id and None
        elif not hasattr(self, 'AvatarCam'):
            return
        elif self._last_weapon_model == model:
            self.updateCameraWeaponTagert()
            return
        else:
            self._wt_neck_aim = None
            self._last_weapon_model = model
            self.updateCameraWeaponTagert()
            self.updateDCursorParam()
            return

