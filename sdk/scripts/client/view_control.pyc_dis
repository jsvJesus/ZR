    def onChangeWeaponStatus1(self):
        if not hasattr(self, 'AvatarCam'):
            return
        self.updateCameraWeaponTagert()
        can_fps = True
        if self.active_transform and self.active_transform.getparam('camera_pivot_position') or self.active_weapon and self.active_weapon.getParam('disable_aim_camera'):
            can_fps = False
            self.fps_mode = False
        if self.__isSniping() and self._snip_mode_fps_enable and can_fps and not self.lookingaround:
            self.AvatarCam.weaponMode = 1
            self._cam_fps_node_pivot.b_factor = 1
            self._cam_fps_offset.b_factor = 1
            if not self._isFPS:
                self.enableFPS()
            self._setHeapTagertVisible(False)
        else:
            if self.weaponStatus == Constants.WEAPON_BORED:
                self._setHeapTagertVisible(False)
            else:
                self._setHeapTagertVisible(True)
            self._cam_fps_node_pivot.b_factor = 0
            self._cam_fps_offset.b_factor = 0
            if self.model:
                self.model.tickDisable = False
            if self.fps_mode or self._sniping_key_pressed and self.isEquipWeaponProgress or self._view_bunocular_action:
                if not self._isFPS:
                    self.enableFPS()
                    self.AvatarCam.weaponMode = 1
            elif self._isFPS:
                self.AvatarCam.weaponMode = 0
                self.disableFPS()
        if self._isFPS and self.lookingaround and not self.in_helicopter:
            self.AvatarCam.weaponMode = 0
            self.disableFPS()
        self.updateScopeParam()
        self.updateDCursorParam()

    def onReloadWeapon1(self, end = False):
        self.__reload_anim = not end
        if not self._cam_fps_node_pivot:
            return
        end = 1 if end and self.__isSniping() else 0
        self._cam_fps_node_pivot.b_factor = end
        self._cam_fps_offset.b_factor = end
        self.updateScopeParam()
        if not end and self.active_weapon and self.active_weapon.getParam('reload_weapon_can_aim'):
            return
        self._onreloadSnipToIncombat(end)

    def onBoltAnimationWeapon1(self, end = False):
        self.__bolt_anim = not end
        if not self._cam_fps_node_pivot:
            return
        end = 1 if end and self.__isSniping() else 0
        self._cam_fps_node_pivot.b_factor = end
        self._cam_fps_offset.b_factor = end
        self.updateScopeParam()
        if not end and self.active_weapon and self.active_weapon.getParam('boltAnimationCanAim'):
            return
        self._onreloadSnipToIncombat(end)

    _return_to_snip_after_reloadw = False

    def _onreloadSnipToIncombat(self, end = False):
        if not end and self.__isSniping():
            self._return_to_snip_after_reloadw = True
            self.SetWeaponStatusNoValidate(Constants.WEAPON_INCOMABAT)
        if end and self._return_to_snip_after_reloadw:
            self._return_to_snip_after_reloadw = False
            if self._sniping_key_pressed:
                self.SetWeaponStatusNoValidate(Constants.WEAPON_SNIPING)

    def updateViewLookArround(self, lookArround):
        self.updateDCursorParam()
        self.updateScopeParam()
        self.sendHeadRotationBylookArround()

    def onReloadViewSettings(self):
        self._cam_fps_node_pivot = None
        self._cam_fps_offset = None
