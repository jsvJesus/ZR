def zoomTofov(zoom):
    return 2 * math.atan(math.tan(player_speed_settings.FOV.DEFAULT_FOV / 2) / zoom)


def initCameraUpdater(AvatarCam, player):

    def cameraPreUpdate(dtime):
        if player.isDestroyed:
            AvatarCam.pDebugPreUpdate = None
            return
        elif player.dead:
            return
        else:
            if player._view_bunocular_activate and player.binocularDevice:
                player._updateBinocularSpread(dtime)
            if player.model:
                if player._camera_isWeapon or player._isFPS or player._headlight.on or player._transf_camera_attached:
                    player.model.forceDraw()
                    player.model.transformModsDirty = True
                if not player._camera_isWeapon and not player._isFPS:
                    return
                player.setDrawModelTypes(head=False, torso=False, foot=False)
                player.setDisableFlagParticle(True)
                head = player.model.node('Head')
                player.model.forceDraw(1.0, True)
                myscope.prender.debugTickDrawPlayer(dtime, True)
                state_3ps = AvatarCam.weaponModeFactor <= 0.799
                myscope.paused = state_3ps
                head_out = head.lastRenderTransform.translation.length > 0.4
                out_from_fps = AvatarCam.weaponMode == 0
                player.setDrawModelTypes(head=head_out, torso=state_3ps or out_from_fps, foot=True)
                player.setDisableFlagParticle(False)
                player.model.visible = True
            return

    AvatarCam.pDebugPreUpdate = cameraPreUpdate


