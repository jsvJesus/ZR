    def _print(self, node, level):
        for tag in node._nodes:
            print (level - 1) * '-' + '>', tag, node._nodes[tag]._name
            self._print(node._nodes[tag], level + 1)

    def printself(self):
        self._print(self, 2)

    def _add(self, tokens, nodes):
        if len(tokens) == 0:
            return
        else:
            tag = tokens[0]
            subnode = None
            if tag not in nodes:
                subnode = Tree.Node(tag)
                nodes[tag] = subnode
            else:
                subnode = nodes[tag]
            if len(tokens) == 1:
                subnode._real = True
            tokens = tokens[1:]
            return self._add(tokens, subnode._nodes)

    def add(self, name):
        tokens = name.split('/')
        self._add(tokens, self._nodes)

    def _getRootByToken(self, parent, tokens):
        if len(tokens) == 0:
            print 'len of tokens is 0'
            return ''
        name = tokens[0]
        result = ''
        if name not in parent._nodes:
            print 'no name in nodes', name, parent._nodes
            return ''
        node = parent._nodes[name]
        if node._real:
            return node._name
        tokens = tokens[1:]
        res = self._getRootByToken(node, tokens)
        if res != '':
            return name + '/' + res
        else:
            return ''

    def getRootByName(self, name):
        tokens = name.split('/')
        res = self._getRootByToken(self, tokens)
        if res == '':
            res = name
        return res