BOXS_DICT = {}
for box in BOXS:
    if box['boxID'] in BOXS_DICT:
        raise Exception('duplicate box %s' % box['boxID'])
    box['can_unite'] = True
    if box.get('tint') or box.get('animations') or box.get('no_physics'):
        box['can_unite'] = False
    if not box.get('model'):
        box['can_unite'] = False
    BOXS_DICT[box['boxID']] = box

def getBoxByID(boxID):
    return BOXS_DICT.get(boxID)


class Sandbag(BigWorld.Entity):

    def __init__(self):
        self.height = 0
        BigWorld.Entity.__init__(self)
        self.filter = BigWorld.NoneFilter()

    def prerequisites(self):
        box = BOXS_DICT.get(self.modelType)
        if not box:
            print self, 'not found box %s' % self.modelType
            return
        return [box['model']]

    def onEnterWorld(self, prereqs):
        box = BOXS_DICT.get(self.modelType)
        if box:
            if box['model'] not in prereqs.failedIDs:
                self.model = prereqs[box['model']]
            else:
                print self, 'error load model %r id =%s' % (box['model'], self.modelType)
        if self.model:
            self.height = Math.Matrix(self.model.bounds).get(1, 1)
            animations = box.get('animations')
            if animations:
                try:
                    for action in animations:
                        self.model.action(action)()

                except:
                    print 'box:', box
                    traceback.print_exc()

            tint = box.get('tint')
            if tint:
                try:
                    for dye, tint_name in tint.items():
                        setattr(self.model, dye, tint_name)

                except:
                    print 'box:', box
                    traceback.print_exc()

            if not box.get('no_physics'):
                self.model.isObstacle = True
        if not self.model:
            self.model = BigWorld.Model('models/bolvan/helpers/xyz.model')

    def onLeaveWorld(self):
        self.model = None
        return

    def damage(self, complexItemType):
        self.cell.damage(BigWorld.player().id, complexItemType)

    def onDead(self):
        self.model = BigWorld.Model('')
        SFXer.AddPixieToEntity(self, 'particles/_ice_cube_dead2.xml', node=self.model.root)