# Embedded file name: ./client/ObjectInfo.py
import json
import ResMgr
import BigWorld
import Constants
import BWPersonality
from soGUI.soInworldMarkers import soInworldMarker
from Localization import lc
from Helpers.Caps import CAP_INTERACT
section = ResMgr.openSection('scripts/common/EnumProps/ObjectInfo.json')
CONFIG = json.loads(section.asBinary)['model_index']['values']

class ObjectInfo(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._model_path = next((model for index, model in CONFIG if index == self.model_index), None)
        self.model = None
        self.targetCaps = [CAP_INTERACT]
        self.name = lc('soObjectInfo.names.{0}'.format(self.name_id))
        self.filter = BigWorld.NoneFilter()
        return

    def interact(self, player):
        if player.position.distTo(self.position) > self.radius:
            return
        BWPersonality.GUICore.show_object_info(self.name_id)

    def prerequisites(self):
        if self._model_path:
            return [self._model_path]
        return []

    def onEnterWorld(self, prereqs):
        if not self._model_path:
            return
        scale = self.scale
        self.model = prereqs[self._model_path]
        self.model.scale = (scale, scale, scale)
        self.model.newScaleTest = (scale, scale, scale)
        self.model.visible = True
        try:
            self.model.no_draw = 'no_draw'
        except:
            pass

    def onLeaveWorld(self):
        self.model = None
        return

    def get_interaction_dist(self):
        if not self.targetCaps:
            return 0
        return self.radius

    def get_mark_distance(self):
        return self.radius * 2

    def get_hightlight(self, distance):
        if not self.targetCaps or distance > self.radius:
            return None
        else:
            return True

    def get_target_mark(self, distance):
        if CAP_INTERACT not in self.targetCaps:
            return None
        elif distance > self.radius:
            return None
        else:
            return soInworldMarker.MARKER_USE

    def start_destroy(self):
        BigWorld.callback(0, lambda : BigWorld.destroyEntity(self.id))