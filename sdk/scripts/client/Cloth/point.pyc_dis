# Embedded file name: ./client/Cloth/point.py
import BigWorld
from Math import Vector3, Matrix
import math_bw

class Point(object):

    def __init__(self):
        self.links = []
        self.is_static = False
        self._prev_position = None
        return

    @property
    def position(self):
        return Vector3(self._position)

    @position.setter
    def position(self, value):
        if self._prev_position is None:
            self._prev_position = Vector3(value)
        self._position = Vector3(value)
        return

    def interpolated_position(self, alpha):
        if self.is_static:
            return self.position
        return math_bw.lerp(self._prev_position, self.position, alpha)

    def move(self, direction):
        self._position += direction
        self._prev_position += direction

    def teleport(self, position):
        time_disp = self._prev_position - self._position
        self._position = Vector3(position)
        self._prev_position = self._position + time_disp

    def destroy(self):
        pass

    def set_static(self, disp):
        self.is_static = True
        self.static_disp = Matrix()
        self.static_disp.setTranslate(disp)

    def calculate_forces(self, dtime):
        if self.is_static:
            return
        spring_force = self.links[0].get_force()
        delta = self.position - self._prev_position
        vel = delta / dtime
        damp_force = -vel * 8.0
        gravity = -9.8
        self._force = Vector3(0, gravity, 0) + spring_force + damp_force

    def calculate_move(self, dtime):
        if self.is_static:
            return
        new_prev_position = Vector3(self.position)
        self.position = self.position * 2 - self._prev_position + self._force * dtime * dtime
        self._prev_position = new_prev_position