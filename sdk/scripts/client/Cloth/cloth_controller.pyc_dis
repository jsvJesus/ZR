# Embedded file name: ./client/Cloth/cloth_controller.py
from point import Point
from link import Link
from cloth import Cloth
import BigWorld
from Math import Vector3, Matrix
gi = BigWorld.getGeometricInstance()

class ClothController:

    def __init__(self, node_info):
        node_info.pTick = self._tick
        node_info.pDraw = self._draw
        self._cloth = self._create_cloth()
        self._time_accumulator = 0
        self._prev_pos = None
        return

    def _tick(self, dtime):
        self._dtime = dtime
        self._time_accumulator += dtime

    def _draw(self, wind, bones):
        matrix = Matrix(bones[0][0][0])
        pos = matrix.translation
        if self._prev_pos is None:
            self._prev_pos = Vector3(pos)
        total_dist = pos.distTo(self._prev_pos)
        bad_dist = total_dist - 0.05
        if bad_dist > 0.0:
            direction = pos - self._prev_pos
            direction.normalise()
            direction *= bad_dist
            self._cloth.move(direction)
            self._prev_pos = Vector3(pos)
        simulation_step = 0.02
        while self._time_accumulator >= simulation_step:
            self._time_accumulator -= simulation_step
            self._cloth.calculate_limits()
            self._cloth.calculate_forces(simulation_step)
            self._cloth.calculate_move(simulation_step, Matrix(matrix))

        self._cloth.render(self._time_accumulator / simulation_step)
        return

    def _create_cloth(self):
        width = 8
        height = 8
        horizontal_step = 0.05
        vertical_step = 0.05
        hor_disp1 = -0.35
        hor_disp2 = 0
        vert_disp = 0
        points = []
        for x in xrange(width):
            static_disp = Vector3(hor_disp2, vert_disp, x * horizontal_step + hor_disp1)
            p = Point()
            p.set_static(Vector3(static_disp))
            p.position = Vector3(static_disp)
            points.append(p)
            if x == 0:
                continue
            left_point = points[-2]
            l = Link(left_point, p)
            left_point.links.append(l)
            p.links.append(l)

        for y in xrange(height - 1):
            for x in xrange(width):
                p = Point()
                disp = Vector3(hor_disp2, -vertical_step * (y + 1) + vert_disp, x * horizontal_step + hor_disp1)
                p.position = Vector3(disp)
                top_point = points[x + y * width]
                l = Link(top_point, p)
                top_point.links.append(l)
                p.links.append(l)
                points.append(p)
                if x == 0:
                    continue
                top_left_point = points[x - 1 + y * width]
                l = Link(top_left_point, p)
                top_left_point.links.append(l)
                p.links.append(l)
                left_point = points[-2]
                l = Link(left_point, p)
                left_point.links.append(l)
                p.links.append(l)
                l = Link(left_point, top_point)
                left_point.links.append(l)
                top_point.links.append(l)

        for y in xrange(height - 2):
            for x in xrange(width):
                p = points[x + y * width]
                bottom_point = points[x + (2 + y) * width]
                l = Link(p, bottom_point, False)
                p.links.append(l)
                bottom_point.links.append(l)

        for x in xrange(width - 2):
            for y in xrange(height):
                p = points[x + y * width]
                right_point = points[x + y * width + 2]
                l = Link(p, right_point, False)
                p.links.append(l)
                right_point.links.append(l)

        return Cloth(points)

    def destroy(self):
        self._cloth.destroy()