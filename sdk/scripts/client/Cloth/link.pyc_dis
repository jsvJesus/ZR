# Embedded file name: ./client/Cloth/link.py
import BigWorld

class Link:

    def __init__(self, p1, p2, limited = True):
        self.p1 = p1
        self.p2 = p2
        self._rest_length = (self.p1.position - self.p2.position).length
        self._line_id = None
        self._limit_ratio = 3.0
        self._k = 200
        self._limited = limited
        return

    def render(self, interpolated_alpha):
        gi = BigWorld.getGeometricInstance()
        if self._line_id:
            gi.remove(self._line_id)
        pos1 = self.p1.interpolated_position(interpolated_alpha)
        pos2 = self.p2.interpolated_position(interpolated_alpha)
        color = (1, 1, 0, 1)
        self._line_id = gi.addLine(pos1, pos2, color, True)

    def apply_limits(self):
        if not self._limited:
            return
        direction = self.p2.position - self.p1.position
        length = direction.length
        bad_length = length - abs(self._rest_length * self._limit_ratio)
        if bad_length <= 0.0:
            return
        direction.normalise()
        self.p2.teleport(self.p1.position + direction * (self._rest_length + bad_length * 0.0) * self._limit_ratio)

    def destroy(self):
        gi = BigWorld.getGeometricInstance()
        if self._line_id:
            gi.remove(self._line_id)

    def get_force(self):
        direction = self.p1.position - self.p2.position
        length = direction.length
        force = length - self._rest_length
        direction.normalise()
        return direction * force * self._k