# Embedded file name: ./client/Cloth/cloth.py
from Math import Matrix
import math

class Cloth:

    def __init__(self, points):
        self._points = points
        self._links = set()
        for p in self._points:
            self._links |= set(p.links)

        self._links = list(self._links)

    def destroy(self):
        for p in self._points:
            p.destroy()

        self._points = []
        for l in self._links:
            l.destroy()

        self._links = []

    def calculate_limits(self):
        for l in self._links:
            l.apply_limits()

    def calculate_forces(self, dtime):
        for p in self._points:
            p.calculate_forces(dtime)

    def move(self, direction):
        for p in self._points:
            p.move(direction)

    def calculate_move(self, dtime, matrix):
        t = Matrix()
        t.setTranslate((0, 0, 0.1))
        matrix = Matrix(matrix)
        matrix.preMultiply(t)
        r = Matrix()
        r.setRotateYPR((math.pi * 0.5, 0, 0))
        matrix.preMultiply(r)
        for p in self._points:
            if p.is_static:
                local_m = Matrix(p.static_disp)
                local_m.postMultiply(matrix)
                p.position = local_m.translation
            else:
                p.calculate_move(dtime)

    def render(self, interpolated_alpha):
        for l in self._links:
            l.render(interpolated_alpha)