# Embedded file name: ./client/QuestObject.py
import json
import ResMgr
import BigWorld
import ResourceLoader
from Helpers.Caps import CAP_EXCLUDE
from Quest import QuestCheckState
import Quest
section = ResMgr.openSection('scripts/common/EnumProps/ModelSelector.json')
CONFIG = json.loads(section.asBinary)['model_index']['values']

class QuestObject(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._model_path = str(next((model for index, model in CONFIG if index == self.modelSelect), None))
        self.particle = None
        return

    def onEnterWorld(self, prereqs):
        self.targetCaps = [CAP_EXCLUDE]
        BigWorld.player().register_quest_listener(self, [self.questID])

    def onLeaveWorld(self):
        player = BigWorld.player()
        if player:
            player.unregister_quest_listener(self)
        self._hide_model()

    def is_obstacle(self):
        return True

    def load_model_on_enter_world(self):
        return False

    def prerequisites(self):
        if self.load_model_on_enter_world():
            return [self._model_path]
        return []

    def _on_model_loaded(self, model):
        if self.isDestroyed:
            return
        self.model = model
        if self.model:
            self.model.isObstacle = self.is_obstacle()
        try:
            self.model.no_draw = 'no_draw'
        except:
            pass

    def load_model(self, prereqs = None):
        if prereqs is None or not prereqs.has_key(self._model_path):

            def on_load_ref(prereqs):
                if self.isDestroyed:
                    return
                self._on_model_loaded(prereqs.produce(0))

            resType = ResourceLoader.MODEL
            if type(self._model_path) in (list, tuple):
                resType = ResourceLoader.MULTI_MODEL
            ResourceLoader.asyncLoad([(resType, self._model_path)], on_load_ref)
        else:
            self._on_model_loaded(prereqs[self._model_path])
        return

    def _show_model(self):
        if self.model:
            self.model.visible = True
            self.model.isObstacle = self.is_obstacle()
        else:
            self.load_model()

    def _hide_model(self):
        if self.particle:
            self.particle.clear()
            self.model.root.detach(self.particle)
            self.particle = None
        if self.model:
            self.model.visible = False
            self.model.isObstacle = False
        return

    def on_quest_state_changed(self, quest_id, state):
        if self.show_if == QuestCheckState.NO_QUEST:
            if state == Quest.STATE_ABSENT:
                self._show_model()
            else:
                self._hide_model()
        elif self.show_if == QuestCheckState.HAS_QUEST:
            if state == Quest.STATE_ABSENT:
                self._hide_model()
            else:
                self._show_model()
        elif self.show_if == QuestCheckState.OPENED:
            if state == Quest.STATE_OPENED:
                self._show_model()
            else:
                self._hide_model()
        elif self.show_if == QuestCheckState.CLOSED:
            if state == Quest.STATE_CLOSED:
                self._show_model()
            else:
                self._hide_model()
        elif self.show_if == QuestCheckState.FAILED:
            if state == Quest.STATE_FAILED:
                self._show_model()
            else:
                self._hide_model()
        elif self.show_if == QuestCheckState.ON_TEST:
            if state == Quest.STATE_ONTEST:
                self._show_model()
            else:
                self._hide_model()

    def onLoadModelComplete(self):
        if self.isDestroyed or not self.model:
            return

    @property
    def height(self):
        return 1.0