        self.cell.GetItemsFromHolderClient(cacheObjectID, item_ids)

    def PutItemsToContainer(self, cacheObjectID, items):
        try:
            container = BigWorld.entities[cacheObjectID]
        except:
            return

        if getattr(container, 'LOCK_PUT_ITEM', False):
            return
        for item in items:
            if not item:
                return
            if ItemsUtils.IsItemFixed(item):
                return
            if not ItemsUtils.IsCanPlaceToContainer(item['complexItemType']):
                return

        item_ids = [ item['complexItemID'] for item in items ]
        container.cell.GetItemsFromHolderClient(self.id, item_ids)
        return True

    def change_money1(self, money, success):
        if not success:
            gui_jokes.askUserOk(lc('GUI.DonateBase.title'), lc('GUI.DonateBase.error_nomoney'))
            return
        trader_id = self.cacheObjectID

        def show_access_error():
            gui_jokes.askUserOk(lc('GUI.DonateBase.title'), lc('GUI.DonateBase.text_access_error'))

        if money > 0:
            if not self.checkClanRights(Clan.FLAG_CAN_BASE_ADD_MONEY):
                show_access_error()
                return
        if money < 0:
            if not self.checkClanRights(Clan.FLAG_CAN_BASE_WITHDRAW_MONEY):
                show_access_error()
                return
        self.cell.change_money2(money, trader_id)

    def put_item_to_warehouse1(self, item, success):
        if not success:
            gui_jokes.askUserOk(lc('GUI.DonateBase.title'), lc('GUI.DonateBase.noroom'))
            return
        trader_id = self.cacheObjectID
        if not self.checkClanRights(Clan.FLAG_CAN_BASE_ADD_STORE):
            gui_jokes.askUserOk(lc('GUI.DonateBase.title'), lc('GUI.DonateBase.text_access_error'))
            return
        if not ItemsUtils.is_item_donatbase_storable(item):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnonStorable_msg'))
            return
        if ItemsUtils.IsItemFixed(item, entity=self):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnonStorable_msg'))
            return
        self.cell.put_item_to_warehouse2(trader_id, item['complexItemID'])

    def get_item_from_warehouse1(self, item):
        trader_id = self.cacheObjectID
        if not self.checkClanRights(Clan.FLAG_CAN_BASE_WITHDRAW_ITEMS):
