    def update_equipped_condition(self, equipped_cond, gasmask_cond):
        self.EquippedCond2 = equipped_cond
        self.EquippedGasMaskCond = gasmask_cond
        if not getattr(self, 'enteredWorld', False):
            return
        updated_items_ids = []
        for equipped_data in self.EquippedCond2:
            item_id = equipped_data['itemID']
            if item_id and item_id not in updated_items_ids:
                updated_items_ids.append(item_id)

        self.partiallyUpdateInventory(updated_items_ids)

    def updateItemsWeightOnClient(self, item_weight):
        old_value = self.ItemsWeight
        self.ItemsWeight = item_weight
        self.set_ItemsWeight(old_value)

    def set_ActiveItemID(self, oldType = None):
        for slot, weapon in self.weapon_slots.items():
            if weapon.getItemID() == self.ActiveItemID:
                self.equipWeaponToHand(weapon)
                return

        self.equipWeaponToHand(None)
        return

    def set_EquippedArmor(self, old_value):
        self.UpdateAvatarModelAsync(callback=self.model.forceDraw)
        self.updateGasMaskFlag()

    def set_EquipModes(self, old_value):
        if not old_value:
            old_value = 0
            if self == BigWorld.player():
                rec_attr_demo('EquipModes', old_value, self.EquipModes)
            diff = self.EquipModes ^ old_value
            if diff & 1 << EST.MODE_HOOD:
                self.UpdateAvatarModelAsync(callback=self.model.forceDraw)
            if diff & 1 << EST.MODE_VISOR:
                pass
            if diff & 1 << EST.MODE_GASMASK_FILTER_OFF:
                StalkerModel.update_filter_mask(self)
            if diff & 1 << EST.MODE_HEADLIGHT:
                value = self.EquipModes & 1 << EST.MODE_HEADLIGHT
                prev_item_id = self._headlight.cur_item_id
                self.switch_headlight(value)
                post_item_id = self._headlight.cur_item_id
                if not post_item_id:
                    item_id = prev_item_id
                    item_id and self is BigWorld.player() and self.partiallyUpdateInventory(item_id)
            diff & 1 << EST.MODE_TUCK and StalkerModel.update_tuck(self)

    def clear_storage_cache_and_reload_gui(self, trader_name):
        if trader_name not in self.StoredItems:
            return
        del self.StoredItems[trader_name]
        BWPersonality.GUICore.showItemCache(False)

    def on_storage_entry_appended(self, entry):
        self.KnowingStorages.append(entry['TraderName'])
        self.StoredItems[entry['TraderName']] = entry['Items']
        self.NeedToUpdateItemCache()

    def on_storage_entry_deleted(self, trader_name):
        self.KnowingStorages.remove(trader_name)
        if trader_name in self.StoredItems:
            del self.StoredItems
            self.NeedToUpdateItemCache()

    def on_storage_items_deleted_multiple(self, trader_name, indices):
        items = self.StoredItems.get(trader_name)
        if not items:
            return
        for index in sorted(indices, reverse=True):
            del items[index]

        self.NeedToUpdateItemCache()

    def on_storage_item_deleted(self, trader_name, index):
        items = self.StoredItems.get(trader_name)
        if not items:
            return
        del items[index]
        self.NeedToUpdateItemCache()

    def on_storage_item_appended(self, trader_name, item):
        items = self.StoredItems.get(trader_name)
        if items is None:
            return
        else:
            items.append(item)
            self.NeedToUpdateItemCache()
            self._add_play_inventory_put_sound(item['complexItemType'])
            return

    def on_storage_items_extended(self, trader_name, items):
        stored_items = self.StoredItems.get(trader_name)
        if stored_items is None:
            return
        else:
            stored_items.extend(items)
            self.NeedToUpdateItemCache()
            for e in items:
                self._add_play_inventory_put_sound(e['complexItemType'])

            return

    def on_storage_item_changed(self, trader_name, item, index):
        items = self.StoredItems.get(trader_name)
        if not items:
            return
        items[index] = item
        self.NeedToUpdateItemCache()
        if BWPersonality.GUICore.infoWindowManger:
            BWPersonality.GUICore.infoWindowManger.updateCarryingItems([item])

    def got_stored_items(self, entry):
        self.StoredItems[entry['TraderName']] = entry['Items']

    def setActiveItemPollutions(self, part_list):
        self.ActiveItemPollutions = part_list
        if not getattr(self, 'enteredWorld', False):
            return
        if not self.ActiveItemID:
            return
        self.partiallyUpdateInventory(self.ActiveItemID)

    def updateGasMaskFlag(self):
        self._isGasMaskSoundBreathing = False
        self._GasMaskSoundBreathingVolume = 1.0
        for armor in self.EquippedArmor.values():
            if armor['itemType']:
                param = ItemsCatalog.GetItemParam(armor['itemType'])
                if param.get('GasMaskSoundBreathing'):
                    self._isGasMaskSoundBreathing = True
                self._GasMaskSoundBreathingVolume = min(self._GasMaskSoundBreathingVolume, param.get('GasMaskSoundBreathingVolume', 1.0))

    def on_item_to_shop(self, shopped_item):
        self.items_in_shop.append(shopped_item)
        self.NeedToUpdateItemCache()

    def on_item_from_shop(self, complex_item_id):
        self.items_in_shop = filter(lambda item: item['item']['complexItemID'] != complex_item_id, self.items_in_shop)
        self.NeedToUpdateItemCache()

    def update_shopped_items(self, shopped_items):
        self.items_in_shop = list(shopped_items)

    @lazyproperty
    def items_in_shop(self):
        return []

    def checkMsgFromShop(self):
        if self.isDestroyed:
            return
        if not self.isInWorld or not self.worldLoadStatusCode:
            BigWorld.callback(1.5, self.checkMsgFromShop)
            return
        if self.msgFromShop:
            for type_msg, msg in self.msgFromShop:
                if type_msg:
                    gui_jokes.askUserOk(u'', msg)
                else:
                    self.putMessage(CHANNEL_CONSTS.ITEMS, msg)

        self.msgFromShop = []

    def showShopMessage(self, type_msg, index_msg):
        """
        type_msg : 0 -chat, 1 - popup
        """
        print 'showShopMessage', type_msg, index_msg
        msg = ShopResponses.msg[index_msg]
        if not self.isInWorld:
            if not self.isInWorld or not self.worldLoadStatusCode:
                self.msgFromShop = []
            self.msgFromShop.append((type_msg, msg))
            print 'showShopMessage add msgFromShop'
            return
        if type_msg:
            gui_jokes.askUserOk(u'', msg)
        else:
            self.putMessage(CHANNEL_CONSTS.ITEMS, msg)

    def showShopMessageExpand(self, type_msg, index_msg, data):
        print 'showShopMessageExpand', type_msg, index_msg, data
        formatdata = dict(itemname='', bank='', price='', buyerName='')
        formatdata.update(data)
        msg = ShopResponses.msg[index_msg]
        typeID = data['complexItemType']
        itemname = '[???]'
        if typeID:
            itemname = ItemsUtils.GetItemName(typeID, fGetShortName=False)
        if not _NPCs.getName(data['BankName']):
            bank = '???'
            formatdata['itemname'] = itemname
            formatdata['bank'] = bank
            buyerName = formatdata['buyerName'].decode('utf8')
            buyerName = BWPersonality.soGUI.chatConsole_Flash.html_user_name_href(buyerName)
            formatdata['buyerName'] = buyerName
            msg = msg.format(**formatdata)
            if not self.isInWorld or not self.worldLoadStatusCode:
                if not self.msgFromShop:
                    self.msgFromShop = []
                self.msgFromShop.append((type_msg, msg))
                print 'showShopMessageExpand add msgFromShop'
                return
            type_msg and gui_jokes.askUserOk(u'', msg)
        else:
            self.putMessage(CHANNEL_CONSTS.ITEMS, msg)

    def shopContextMenuEvent(self, interface_id, event_id, caption, event, data = None):
        if interface_id != BWPersonality.GUICore.GUI_ID_ITEMCACHE:
            return
        else:
            if event == BWPersonality.soGUI.soContextMenuComponent.EVENT_SELECT:
                if not event_id:
                    return
                try:
                    command, complexItemID = event_id
                except ValueError:
                    command = event_id
                    complexItemID = data['complexItemID']

                if not self.cacheObjectID:
                    return
                npc = BigWorld.entity(self.cacheObjectID)
                if not npc:
                    return
                if not hasattr(npc, 'npcName'):
                    return
                if command == 'item_info':
                    item = data
                    BWPersonality.GUICore.showItemInfo(item, is_in_inventory=False)
                    return
                BankName = npc.npcName
                stored_items = self.StoredItems.get(BankName)
                if not stored_items:
                    return
                if not next((item for item in stored_items if item['complexItemID'] == complexItemID), None):
                    item = ItemsUtils.get_shopped_item(self, complexItemID)
                    if not item:
                        return
                    item_type = item['complexItemType']
                    if command == 'sale':
                        if GiftBankUtils.bank_is_only_read(BankName):
                            self.showShopMessage(1, ShopResponses.READONLY)
                            return
                        additional_slots = ClientSimpleConfigs().get_premium_config(self.prem_id)['AdditionalTradeSlots']
                        shop_slots_amount = Constants.MAX_SHOP_SLOT_DEFAULT + additional_slots
                        if len(self.items_in_shop) >= shop_slots_amount:
                            if additional_slots == 0:
                                self.showShopMessage(1, ShopResponses.SLOT_OVERFLOW0)
                            else:
                                self.showShopMessage(1, ShopResponses.SLOT_OVERFLOW1)
                            return
                        if not ItemsUtils.is_item_placable_at_bb(item):
                            ask = lc('ItemHolder.isnotPlaceableAtBB_msg')
                            gui_jokes.msgBox(u'', ask)
                            return
                        item_param = ItemsCatalog.GetItemParam(item_type)
                        item_ttl = ItemsUtils.GetItemDestroyTime(item, item_param)
                        if item_ttl is not None and item_ttl < 60:
                            ask = lc('Inventory.client.ItemlifeTimeIsOverSellMsg')
                            gui_jokes.msgBox(u'', ask)
                            return
                        show_data = {'item': item,
                         'bank_name': BankName}
                        if BWPersonality.GUICore.itemCacheDataSection:
                            slots_string = BWPersonality.GUICore.itemCacheDataSection.get('slots_string')
                            if slots_string:
                                show_data['slots'] = slots_string
                        BWPersonality.GUICore.showStartSale(True, show_data)
                    if command == 'copy_id':
                        BigWorld.clipboardSetPlainText(str(item['complexItemID']))
                    if command == 'copy_type':
                        BigWorld.clipboardSetPlainText(str(item['complexItemType']))
                    if command == 'cancel_sale':

                        def cancel_sale(event):
                            if event == gui_jokes.askUserYesNo.YES:
                                self.cell.cancelSaleShop(complexItemID, BankName)

                        itemName = ItemsUtils.GetItemName(item_type, fGetShortName=True)
                        ask = lc('ItemHolder.ask_cancel_sale').format(itemName=itemName)
                        gui_jokes.askUserYesNo(u'', ask, cancel_sale)
                    command == ItemsCatalog.CAN_SPARE and self.suggest_spare_item_cache(item)
            return

    def suggest_spare_item_cache(self, complex_item):
        bank_name = BigWorld.entity(self.cacheObjectID).npcName

        def number_check(newStr, wholeText, offset):
            full_text = wholeText[0:offset] + newStr + wholeText[offset:]
            if not full_text.isdigit():
                return False
            if wholeText:
                return bool(0 < int(full_text) < ItemsUtils.GetItemNumber(complex_item))
            return True

        def SpareCalback(event, data):
            if event == MESSAGEBOX.EVENT_BTNPRESS:
                if data['btn'] == MESSAGEBOX.BTN_OK:
                    text = data['add_controls']['edit_box']
                    if text.isdigit():
                        quantity = int(text)
                        if self.ItemLocked(complex_item):
                            return
                        print 'BeginSpare', text, quantity, bank_name
                        self.BeginSpare(complex_item, quantity, bank_name)

        msgbox_templates.input_box_ok_cancel(MESSAGEBOX.MSG_ID_CACHE_SPARE, lc('Inventory.client.DIVIDE_PROCESS'), lc('Inventory.client.HOW_MUCH_ITEMS_DEVIDE'), callback=SpareCalback, default='1', input_validator=number_check)

    def request_shop_item(self, complex_item, sell_count, price, bank_name):
        if ItemsUtils.IsItemFixed(complex_item, entity=self):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnotPlaceableAtBB_msg'))
            return
        self.base.itemToShop2(complex_item['complexItemID'], sell_count, price, bank_name)

    def buyItemFromShop(self, sellerAvatarName, item, price, BankName):
        self.cell.buyItemFromShop(sellerAvatarName, item, price, BankName)

