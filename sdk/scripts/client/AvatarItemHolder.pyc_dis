        pass

    def GetEquippedItemsList(self):
        equip_list = list(ItemsUtils.GetEquipSetIDs(self))
        equip_list.extend(self.EquippedVisibleAttachesIDS.values())
        equipped_item_list = []
        for id in equip_list:
            item = ItemsUtils.GetComplexItemByID(self, id)
            if item:
                equipped_item_list.append(item)

        return equipped_item_list

    def GetTradingItemList(self):
        if self.ExchangeProperties.fOffer:
            trading_list = self.ExchangeProperties.ItemsToExchange
        else:
            trading_list = []
            for trade_item in self.PCTradeItems:
                item = ItemsUtils.GetComplexItemByID(self, trade_item['complexItemID'])
                if item:
                    trading_list.append(item)

        return trading_list

    def store_items0(self, entity_id, items):
        item_ids = [ item['complexItemID'] for item in items ]
        if not all(map(ItemsUtils.is_item_storable, items)):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnonStorable_msg'))
            BWPersonality.GUICore.inventoryGUI.del_block_multiple_items(item_ids)
            return
        else:
            entity = BigWorld.entities.get(entity_id, None)
            if entity and GiftBankUtils.bank_is_only_read(entity.npcName):
                self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.storage_only_read'))
                gui_jokes.msgBox(lc('ItemHolder.storage_only_read_capt'), lc('ItemHolder.storage_only_read'))
                BWPersonality.GUICore.inventoryGUI.del_block_multiple_items(item_ids)
                return
            if not entity or entity.position.distSqrTo(self.position) > SQR_TRADE_RANGE:
                self.ReportFail(ItemsUtils.FAIL_NOT_IN_RANGE)
                BWPersonality.GUICore.inventoryGUI.del_block_multiple_items(item_ids)
                return
            if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                self.ReportFail(ItemsUtils.FAIL_OTHER_ACTION)
                BWPersonality.GUICore.inventoryGUI.del_block_multiple_items(item_ids)
                return
            cur_number, max_number = BWPersonality.GUICore.itemCacheDataSection['slots_string']
            free_number = max_number - cur_number
            if free_number <= 0:
                self.ReportFail(ItemsUtils.FAIL_MAX_STORAGE)
                BWPersonality.GUICore.inventoryGUI.del_block_multiple_items(item_ids)
                return
            if free_number < len(item_ids):
                unlock_item_ids = item_ids[free_number:]
                BWPersonality.GUICore.inventoryGUI.del_block_multiple_items(unlock_item_ids)
                item_ids = item_ids[:free_number]
                BWPersonality.gpd.sendHightMessage(lc('soTradeInterface.tradescreen.BADACTION'), MT.PERSONAL)
            self._store_items_coroutine(entity_id, item_ids).run()
            return

    @BWMemberCoroutine
    def _store_items_coroutine(self, entity_id, item_ids):
        items_per_step = 10
        steps = len(item_ids) / items_per_step + bool(len(item_ids) % items_per_step) - 1
        seconds_per_step = 0.5
        time = steps * seconds_per_step
        if not time:
            self.cell.store_items1(entity_id, item_ids, 0)
            return
        item_ids = copy.copy(item_ids)
        self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, time, lc('Items.GUIStrings.EXECUTING_ACTION'))
        while item_ids:
            store_ids = item_ids[:items_per_step]
            self.cell.store_items1(entity_id, store_ids, time)
            time = 0
            item_ids = item_ids[items_per_step:]
            if item_ids:
                yield BWWaitForPeriod(seconds_per_step)

    def IsEncumbered(self):
        return self.is_encumbered_potentially(self.ItemsWeight)

    def EncumberedState(self):
        return self.potential_encumbered_state(self.ItemsWeight)

    def is_encumbered_potentially(self, potential_weight):
        max_weight = self.GetStatValue(Stats.ch_MaxWeight)
        if potential_weight <= max_weight:
            return 0
        return max_weight / potential_weight

    def potential_encumbered_state(self, potential_weight):
        MAX_OVERWEIGHT = 0.5
        encumbrance = self.is_encumbered_potentially(potential_weight)
        if encumbrance == 0 or self.invulnerable or self.is_pvp_room_transformation():
            return WEIGHT_STATE.NORMAL
        elif encumbrance > MAX_OVERWEIGHT:
            return WEIGHT_STATE.HEAVY
        else:
            return WEIGHT_STATE.STOP

    def can_place_by_weight(self):
        """ \xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xb8 \xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 \xd0\xb2 \xd1\x80\xd1\x8e\xd0\xb4\xd0\xb7\xd0\xb0\xd0\xba\xd0\xb5 \xd0\xbf\xd0\xbe \xd0\xb2\xd0\xb5\xd1\x81\xd1\x83
        """
        if self.EncumberedState() == WEIGHT_STATE.STOP:
            return False
        return True

    def restore_items0(self, npc_id, item_ids, item_types):
        targetEntity = BigWorld.entities[npc_id]
        if not targetEntity or targetEntity.position.distSqrTo(self.position) > SQR_TRADE_RANGE:
            self.ReportFail(ItemsUtils.FAIL_NOT_IN_RANGE)
            BWPersonality.GUICore.itemCacheGUI.on_change_items(item_ids)
            return
        if not self.CanAcceptItemTypesAdvanced(item_types):
            self.ReportFail(ItemsUtils.FAIL_MAX_ITEMS)
            BWPersonality.GUICore.itemCacheGUI.on_change_items(item_ids)
            return
        if not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            BWPersonality.gpd.sendHightMessage(lc('PlayerAvatar.client.FAIL_CHECKRESTRICTION'), MT.PERSONAL)
            return
        self._restore_items_coroutine(npc_id, item_ids, item_types).run()

    @BWMemberCoroutine
    def _restore_items_coroutine(self, npc_id, item_ids, item_types):
        items_per_step = 10
        steps = len(item_ids) / items_per_step + bool(len(item_ids) % items_per_step) - 1
        seconds_per_step = 0.5
        time = steps * seconds_per_step
        if not time:
            self.cell.restore_items1(npc_id, item_ids, item_types, 0)
            return
        item_ids = copy.copy(item_ids)
        item_types = copy.copy(item_types)
        self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, time, lc('Items.GUIStrings.EXECUTING_ACTION'), MT.PERSONAL)
        while item_ids:
            restore_ids = item_ids[:items_per_step]
            restore_types = item_types[:items_per_step]
            self.cell.restore_items1(npc_id, restore_ids, restore_types, time)
            time = 0
            item_ids = item_ids[items_per_step:]
            if item_ids:
                yield BWWaitForPeriod(seconds_per_step)

    def GetReceiptList(self):
        return_list = []
        for recipe in self.KnowingRecipes:
            if recipe not in return_list:
                return_list.append(recipe)

        return return_list

    def startCraft(self, workbench_type, receipt_id, craft_item_ids, kickstart_item_ids, payed):
        self.cancel_action_release()
        if not self.canUse() or self.sprinting:
            return
        if self.is_throwing:
            return
        if self.is_box_moving():
            BWPersonality.gpd.sendHightMessage(lc('PlayerAvatar.client.FAIL_CHECKRESTRICTION'), MT.PERSONAL)
            return
        if self.IsAvatarCrawling() or self.IsAvatarSniping():
            return
        recipe_param = ItemsCatalog.GetItemParam(receipt_id)
        if not recipe_param:
            return
        craft_time = recipe_param.get('CraftTime', 100) / 100.0
        if craft_time <= 0.0:
            print 'DESIGN ERROR:: Bad Craft reciept id[{0}], craftTime:{1}'.format(receipt_id, craft_time)
            craft_time = 0.1
        repairItem = recipe_param.get('RepairItem')
        msg_warning = u''
        msg_parths_warning = u''
        if not repairItem:
            for itemid in craft_item_ids:
                complexItem = ItemsUtils.GetComplexItemByID(self, itemid)
                if not complexItem:
                    return
                itemname = ItemsUtils.GetItemName(complexItem['complexItemType'])
                if ItemsUtils.getTintID(complexItem):
                    msg_warning += lc('ItemHolder.gun_with_camo').format(itemname) + '\n'
                if ItemsUtils.getItemColorise(complexItem):
                    msg_warning += lc('ItemHolder.item_colourise').format(itemname) + '\n'
                if ItemsUtils.getItemEmblem(complexItem):
                    msg_warning += lc('ItemHolder.item_emblem').format(itemname) + '\n'
                if complexItem.itemList:
                    msg_parths_warning = lc('ItemHolder.DONT_CRAFT_ATTACH_ITEMS').format(itemname)

        def doCraft():
            self.restrictShoot(self.ShootRestictions.CRAFTING)
            if self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                self.cell.StartCraft(workbench_type, receipt_id, craft_item_ids, kickstart_item_ids, payed)
                self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, craft_time, lc('Items.GUIStrings.CRAFTING'))

        if msg_parths_warning:
            gui_jokes.msgBox(lc('ItemHolder.caption_lost_emblem_after_craft'), msg_parths_warning)
            self.putMessage(CHANNEL_CONSTS.ITEMS, msg_warning)
            return
        if msg_warning:
            msg_warning += lc('ItemHolder.lost_emblem_after_craft')

            def okey_callback(event):
                if event == gui_jokes.askUserYesNo.YES:
                    doCraft()

            gui_jokes.askUserYesNo(lc('ItemHolder.caption_lost_emblem_after_craft'), msg_warning, okey_callback, large=True)
        else:
            doCraft()

    def onCraftEnded(self):
        self.restrictShoot(self.ShootRestictions.CRAFTING, False)
        self.UpgradeCraft()

    def start_npc_barter0(self, trader_id, index, items_ids_list, custom_desire_quontity):
        """\xd0\x95\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb9\xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb0, \xd0\xbe\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80."""
        try:
            trader = BigWorld.entities[trader_id]
        except KeyError:
            return False

        error = self._check_barter(trader, index, items_ids_list, custom_desire_quontity)
        if error == ItemsUtils.FAIL_NO:
            self.cell.start_npc_barter1(trader_id, index, items_ids_list, custom_desire_quontity)
        else:
            self.ReportFail(error)

    def _check_barter(self, trader, index, items_ids_list, custom_desire_quontity):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbb\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8 \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80 \xd1\x81 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0\xd0\xbc\xd0\xb8."""
        if not self.can_place_by_weight():
            return ItemsUtils.FAIL_OVERWEIGHT
        barter_data = trader.BarterAssortment[index]
        item_ids_filter = set(items_ids_list)
        for item in self.CarryingItems:
            if item['complexItemID'] not in item_ids_filter:
                continue
            check_result = self._check_item_can_barter(item)
            if check_result != ItemsUtils.FAIL_NO:
                return check_result

        item_types = []
        for item_type, count in barter_data['resultItems']:
            if ItemsUtils.isStackedItemType(item_type):
                item_types.append(item_type)
            else:
                item_types.extend([item_type] * count * custom_desire_quontity)

        if not self.CanAcceptItemTypesAdvanced(item_types):
            return ItemsUtils.FAIL_MAX_ITEMS
        return ItemsUtils.FAIL_NO

    def _check_item_can_barter(self, item):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbb\xd0\xb8 \xd1\x81\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x88\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80 \xd1\x81 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xbc"""
        if item is None:
            return ItemsUtils.FAIL_NO_RESOURCE
        item_id = item['complexItemID']
        if ItemsUtils.IsItemEquipped(self, item_id):
            return ItemsUtils.FAIL_ITEM_EQUIPPED
        elif ItemsUtils.IsQuestItem(item):
            return ItemsUtils.FAIL_ITEM_QUEST
        error = ItemsUtils.DetachAllSubItemsFromItem(self, item)
        if ItemsUtils.isItemGoodForSale(item) != ItemsUtils.QUALITY_GOOD:
            return ItemsUtils.FAIL_USED_ITEM
        elif error:
            return error
        else:
            return ItemsUtils.FAIL_NO

    def NPCRepair(self, TraderID, item_id):
        item = ItemsUtils.GetComplexItemByID(self, item_id)
        if item:
            err_code = ItemsUtils.CanItemBeRepaired(self, item)
            if err_code == None:
                self.cell.StartNPCItemPollutionCleaning(item_id, TraderID)
            else:
                self.ReportFail(err_code)
        return

    def NPCRepairWeapon(self, TraderID, item_id):
        item = ItemsUtils.GetComplexItemByID(self, item_id)
        if item:
            err_code = ItemsUtils.CanItemBeRepaired(self, item)
            if err_code == None:
                self.cell.StartNPCItemWeaponRepair(item_id, TraderID)
            else:
                self.ReportFail(err_code)
        return

    def NPCResetWeaponGrades(self, npc_id, item_id):
        import grades_utils
        import colorCodes as cc

        def try_reset():
            if not npc_id or not item_id:
                print '[ERROR] NPCResetWeaponGrades. npc_id=%s item_id=%s' % (npc_id, item_id)
                return
            item = ItemsUtils.GetComplexItemByID(self, item_id)
            if not item:
                print '[ERROR] NPCResetWeaponGrades. not item by item_id:', item_id
                return
            weapon_grades_count = grades_utils.get_total_grades_points(item, self)
            if not weapon_grades_count:
                print '[ERROR] NPCResetWeaponGrades. not weapon_grades_count by item_id:', item_id
                return
            item_name = ItemsUtils.GetItemName(item['complexItemType'])
            reset_weapon_grades_item_name = ItemsUtils.GetItemName(grades_utils.RESET_WEAPON_GRADES_ITEM_TYPE)
            reset_weapon_grades_cost_str = '%s %s' % (groupNumber(grades_utils.RESET_WEAPON_GRADES_COST, sep='`'), lc('GiftGui.return.rub'))
            title = lc('Inventory.client.MAINTENANCE_ANSWER_CAPTION')
            reset_grade_key_word = lc('Inventory.client.RESET_GRADE_KEY_WORD')
            text = cc.inactive_xml + lc('Inventory.client.RESET_GRADE_TEXT').format(cc.active_xml + item_name + cc.inactive_xml, cc.active_xml + str(weapon_grades_count) + cc.inactive_xml, cc.active_xml + reset_weapon_grades_item_name + cc.inactive_xml, cc.active_xml + reset_weapon_grades_cost_str + cc.inactive_xml, cc.active_xml + reset_grade_key_word + cc.inactive_xml)

            def to_reset():
                tool_item = ItemsUtils.GetFirstComplexItemByType(self, grades_utils.RESET_WEAPON_GRADES_ITEM_TYPE)
                if not tool_item:
                    print '[ERROR] NPCResetWeaponGrades. not tool_item'
                    return
                tool_item_id = tool_item['complexItemID']
                self.cell.reset_weapon_grades(item_id, tool_item_id, npc_id)

            def get_error_msg():
                if grades_utils.RESET_WEAPON_GRADES_COST > self.CreditNumber:
                    return lc('Inventory.client.RESET_GRADE_ERR_MSG').format(format_money(grades_utils.RESET_WEAPON_GRADES_COST - self.CreditNumber))
                tool_item = ItemsUtils.GetFirstComplexItemByType(self, grades_utils.RESET_WEAPON_GRADES_ITEM_TYPE)
                if not tool_item:
                    return lc('Inventory.client.RESET_GRADE_ERR_MSG').format(reset_weapon_grades_item_name)
                return u''

            def validator(newStr, wholeText, offset):
                full_text = wholeText[:offset] + newStr + wholeText[offset:]
                return len(full_text) <= len(reset_grade_key_word)

            gui_jokes.confirmation_dialog_box(title, text, to_reset, get_error_msg, width=500, active=True, key_word=reset_grade_key_word, input_validator=validator)
            return True

        if not try_reset():
            self.ReportFail(ItemsUtils.FAIL_RESTRICTION)

