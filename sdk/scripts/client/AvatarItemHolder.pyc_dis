    def BeginSpare(self, item, quantity, source = ''):
        if quantity == 0:
            self.ReportFail(ItemsUtils.FAIL_RESTRICTION)
            return
        elif not ItemsUtils.CheckMaxItemNumber(self, 1):
            self.ReportFail(ItemsUtils.FAIL_TOO_MANY_ITEMS)
            return
        elif ItemsUtils.IsQuestItem(item):
            self.ReportFail(ItemsUtils.FAIL_RESTRICTION)
            return
        else:
            if not ItemsUtils.GetComplexItemByID(self, item['complexItemID']) and self.cacheObjectID:
                entity = BigWorld.entities.get(self.cacheObjectID, None)
                if not entity or entity.position.distSqrTo(self.position) > SQR_TRADE_RANGE:
                    self.ReportFail(ItemsUtils.FAIL_NOT_IN_RANGE)
                    return
            if source:
                self.cell.devide_storage_item(item['complexItemID'], source, quantity)
            else:
                self.cell.DivideItem(item['complexItemID'], quantity)
            return

