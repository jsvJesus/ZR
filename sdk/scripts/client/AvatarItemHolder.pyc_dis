    @property
    def isGasMaskSoundBreathing(self):
        return getattr(self, '_isGasMaskSoundBreathing', False)

    def has_item_in_quick_slots(self, item_type):
        for line in self.quickSlotBars:
            for item_id, i_type, count in line:
                if item_type == i_type and item_id > 0 and count > 0:
                    return True

        return False

    def GetEquippedBinocularType(self):
        if not self.ActiveGadgetList:
            return
        else:
            for gadget in self.ActiveGadgetList:
                if not gadget.GadjetID:
                    continue
                gadget_param = ItemsCatalog.GetItemParam(gadget.GadjetType)
                if gadget_param.get('BinocularSettings', None):
                    return gadget.GadjetType

            return

    def GetEquippedBinocularAbility(self):
        if not self.ActiveGadgetList:
            return
        else:
            for gadget in self.ActiveGadgetList:
                if not gadget.GadjetID:
                    continue
                gadget_param = ItemsCatalog.GetItemParam(gadget.GadjetType)
                zoom = gadget_param.get('Zoom', None)
                if zoom:
                    return zoom

            return

    def GetShootPossibility(self):
        return True

    def SearchInEquipsAndSetToZero(self, itemID):
        return ItemsUtils.SearchIDinEquipsAndSetToZero(self, itemID)

    def onDropItem(self, item):
        if not item:
            return
        if not self.canDrop():
            return
        itemID = item['complexItemID']
        if ItemsUtils.IsItemEquipped(self, itemID):
            print 'onDropItem error, IsItemEquipped'
            return
        if ItemsUtils.dropIsBlocked(item):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnonDropable_msg'))
            return
        if ItemsUtils.IsItemFixed(item, entity=self):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnonDropable_msg'))
            return
        self.cell.dropItem(itemID)
        self.SearchInEquipsAndSetToZero(itemID)
        self.LockItemToDrop(item)
        if self.offline_mode:
            print 'offine delete item', itemID
            ItemsUtils.ItemHolderDeleteItem(self, itemID)
            try:
                import __debug.offline_loader
                __debug.offline_loader.saveAvatarEquip(self)
            except:
                traceback.print_exc()

        self.NeedToUpdateInventory(0.3, True)

    def remove_items_by_server(self, itemIDs):
        for itemID in itemIDs:
            self.SearchInEquipsAndSetToZero(itemID)

        self.checkWeaponSet2()

    def delete_items(self, items):
        item_ids = [ item['complexItemID'] for item in items if item ]
        for item_id in item_ids:
            self.SearchInEquipsAndSetToZero(item_id)
            if self.offline_mode:
                print 'offine delete item', item_id
                ItemsUtils.ItemHolderDeleteItem(self, item_id)
                try:
                    import __debug.offline_loader
                    __debug.offline_loader.saveAvatarEquip(self)
                except:
                    traceback.print_exc()

        self.cell.delete_items(item_ids)
        self.NeedToUpdateInventory()

    def getModelByNamesDict(self, names_dict):
        core_model = None
        if names_dict:
            body_entry = names_dict[ItemsCatalog.BODY]
            try:
                core_model = BigWorld.Model(body_entry[ItemsUtils.MODEL_LIST_POSITION])
            except:
                traceback.print_exc()
                print 'Error load gun model:', self
                print 'names_dict', names_dict
                print 'body_entry', body_entry
                print 'key', ItemsUtils.MODEL_LIST_POSITION
                print 'core_models', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                print
                return

            tint_dict = body_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
            if tint_dict:
                for tint_key in tint_dict:
                    try:
                        setattr(core_model, tint_key, tint_dict[tint_key])
                    except:
                        traceback.print_exc()
                        print 'ERROR set tint model', repr(tint_key), repr(tint_dict[tint_key])
                        print 'models:', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print

            del names_dict[ItemsCatalog.BODY]
            if names_dict:
                for model_entry in names_dict.values():
                    if model_entry[ItemsUtils.MODEL_LIST_POSITION]:
                        try:
                            model = BigWorld.Model(model_entry[ItemsUtils.MODEL_LIST_POSITION])
                        except:
                            traceback.print_exc()
                            print 'ERROR load gun attach model:'
                            print [model_entry[ItemsUtils.MODEL_LIST_POSITION]]
                            print
                            continue

                    else:
                        continue
                    tint_dict = model_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
                    if tint_dict:
                        for tint_key in tint_dict:
                            if hasattr(model, tint_key):
                                setattr(model, tint_key, tint_dict[tint_key])

                    try:
                        setattr(core_model, model_entry[ItemsUtils.MODEL_HP_POSITION], model)
                    except ValueError:
                        print 'Cant attach model at hp', repr(model_entry[ItemsUtils.MODEL_HP_POSITION]), ' model name ', model_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print 'core_model', core_model.sources
                        traceback.print_exc()
                        return core_model
                    except AttributeError:
                        print 'Cant attach model at hp', model_entry[ItemsUtils.MODEL_HP_POSITION], ' model name ', model_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print 'core_model', core_model.sources
                        traceback.print_exc()
                        return core_model

        return core_model

    def fetchModelByNamesDict(self, names_dict, callback):
        if not names_dict:
            callback(None)
            return
        else:
            core_model = []
            attach_models = {}
            count_models = 0
            for model_entry in names_dict.values():
                if model_entry[ItemsUtils.MODEL_LIST_POSITION]:
                    count_models += 1

            def checkResult():
                if not core_model or len(attach_models) != count_models - 1:
                    return
                for model_entry, model in attach_models.items():
                    try:
                        setattr(core_model[0], model_entry, model)
                    except ValueError:
                        print 'Cant attach model at hp', repr(model_entry), ' model', model
                        print 'core_model', core_model.sources
                        traceback.print_exc()
                    except AttributeError:
                        print 'Cant attach model at hp', model_entry, ' model ', model
                        print 'core_model', core_model.sources
                        traceback.print_exc()

                callback(core_model[0])

            def onLoadModel(_model_entry, model):
                if not model:
                    print "Can't load model", _model_entry[ItemsUtils.MODEL_LIST_POSITION]
                tint_dict = _model_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
                if tint_dict:
                    for tint_key in tint_dict:
                        if hasattr(model, tint_key):
                            setattr(model, tint_key, tint_dict[tint_key])

                attach_models[_model_entry[ItemsUtils.MODEL_HP_POSITION]] = model
                checkResult()

            def onLoadCoreModel(model):
                if not model:
                    callback(None)
                core_model.append(model)
                tint_dict = body_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
                if tint_dict:
                    for tint_key in tint_dict:
                        try:
                            setattr(core_model[0], tint_key, tint_dict[tint_key])
                        except:
                            traceback.print_exc()
                            print 'ERROR set tint model', repr(tint_key), repr(tint_dict[tint_key])
                            print 'models:', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                            print

                checkResult()
                return

            body_entry = names_dict[ItemsCatalog.BODY]
            BigWorld.fetchModel(body_entry[ItemsUtils.MODEL_LIST_POSITION], onLoadCoreModel)
            del names_dict[ItemsCatalog.BODY]
            for model_entry in names_dict.values():
                if model_entry[ItemsUtils.MODEL_LIST_POSITION]:
                    try:
                        BigWorld.fetchModel(model_entry[ItemsUtils.MODEL_LIST_POSITION], partial(onLoadModel, model_entry))
                    except:
                        traceback.print_exc()
                        print 'ERROR load gun attach model:'
                        print [model_entry[ItemsUtils.MODEL_LIST_POSITION]]
                        print
                        continue

                else:
                    continue

            return

    def canPutOnItem(self, item, slot_number = 0):
        if not item:
            print 'no item'
            return False
        if not self.canEquip():
            print 'no canEquip'
            return False
        if self.clone_model:
            return False
        itemID = item['complexItemID']
        if not ItemsUtils.GetComplexItemByID(self, itemID):
            print 'not found item'
            return False
        return True

    def removeGadgetSlots(self, count):
        if not BWPersonality.GUICore.charScreen:
            return
        _charScreen = BWPersonality.GUICore.charScreen.component.script
        _ids = _charScreen.getLockedGadgetIds(count)
        _charScreen.lockGadgetSlots(True, count)
        self.cell.removeGadgets(_ids)

    def onUseItem(self, item):
        error_level = ItemsUtils.FAIL_NO
        if self.IsAvatarCrawling() or self.IsAvatarSniping() or not self.checkActiveWeapon():
            return (ItemsUtils.FAIL_OTHER_ACTION, None)
        elif self.is_hoist_flag or self.is_box_moving():
            return (ItemsUtils.FAIL_OTHER_ACTION, None)
        else:
            duration = 0
            if not item:
                error_level = ItemsUtils.FAIL_ITEM_STRUCTURE
                return (error_level, duration)
            item_type = item['complexItemType']
            itemID = item['complexItemID']
            item_class = ItemsCatalog.GetItemClass(item_type)
            item_params = ItemsCatalog.GetItemParam(item_type)
            item_category = ItemsCatalog.GetItemCategory(item_type)
            if item_params.get('isBlackBox'):
                self.cell.useItem(itemID)
                return (ItemsUtils.FAIL_NO, None)
            elif 'MoneyVekselCost' in item_params:
                self.cell.useItem(itemID)
                return (ItemsUtils.FAIL_NO, None)
            if item_class in [ItemsCatalog.BUFF, ItemsCatalog.LOOT]:
                if item_params.get('isSandbag', False) and self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                    raise RuntimeError('deprecated')
                    return (error_level, duration)
                if EffectNames.Suffocation in self.current_effects:
                    return (ItemsUtils.FAIL_IMPOSSIBLE_USE, None)
                if item_params.get('weaponGreaseOilTimeMinutes'):
                    self.ChooseGreaseOilItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                    return (ItemsUtils.FAIL_NO, duration)
                if item_params.get('RepairKitType') or item_params.get('RepairOnlyItemsType'):
                    self.ChooseRepairItem(item)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                    return (ItemsUtils.FAIL_NO, duration)
                if 'Effect' in item_params and ItemsCatalog.EFFECTS_START_FIREWORKS in item_params['Effect'].keys():
                    for i in self.entitiesInRange(Constants.MIN_RADIUS_FIREWORKS, 'FireWorks'):
                        if i.model.visible:
                            self.putMessageSystem(MC.Avatar_firework_radius_error, [], [])
                            return (ItemsUtils.FAIL_NO, duration)

                    self.cell.useItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                elif 'Effect' in item_params and ItemsCatalog.EFFECTS_HEAL in item_params['Effect'].keys():
                    self.cell.useItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                    clan_heal_speed_val = 0
                    clan_heal_speed_stacks = self.getEffectStacks(EffectNames.Clan_Heal_Speed)
                    if clan_heal_speed_stacks > 0:
                        clan_heal_speed_val = clan_heal_speed_stacks * self.get_perk_action_val('CLAN_HEAL_SPEED')
                    heal_speed = 1.0 - self.get_perk_action_val('HEAL_SPEED') - clan_heal_speed_val
                    duration = max(0.5, duration * heal_speed)
                elif 'Effect' in item_params and ItemsCatalog.EFFECTS_RECIPE in item_params['Effect'].keys():
                    self.cell.useItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                elif 'Effect' in item_params and ItemsCatalog.EFFECTS_EAT in item_params['Effect'].keys():
                    self.cell.useItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                elif ItemsUtils.getCookingEffects(item) or ItemsUtils.getCookingSatietyStacks(item):
                    self.cell.useItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                elif 'Premium_id' in item_params:
                    if self.isPremium():
                        return (ItemsUtils.FAIL_OTHER_PREM, None)
                    self.cell.useItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                elif 'Booster_id' in item_params:

                    def accept():
                        self.cell.useItem(itemID)
                        duration = Durations.GetItemUseDuration(self, item_type)
                        duration = item_params.get('Action_use_time', duration)

                    if self.get_boost_id():

                        def callback(event):
                            if event == gui_jokes.askUserYesNo.YES:
                                accept()

                        gui_jokes.askUserYesNo(lc('Inventory.client.REPAIR_ANSWER_CAPTION'), lc('StoreHouse.shopitem.BOOSTWARNING'), callback=callback)
                    else:
                        accept()
                elif item_params.get('is_emblem_badge'):
                    if item_params['emblem_id'] in self.myEmblems:
                        return (ItemsUtils.FAIL_USED_ITEM, None)
                    self.cell.useItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                elif item_category == IC.DOCUMENTS:
                    self.cell.useItem(itemID)
                    duration = Durations.GetItemUseDuration(self, item_type)
                    duration = item_params.get('Action_use_time', duration)
                elif item_params.get('NY_teleport') or item_params.get('art_save_teleport'):
                    duration = item_params.get('Action_use_time', duration)
                elif item_params.get('SetEquipCharge'):
                    if self._set_abils_controller and self._set_abils_controller.request_item_charge(item):
                        self.cell.useItem(itemID)
                        duration = Durations.GetItemUseDuration(self, item_type)
                        duration = item_params.get('Action_use_time', duration)
                    else:
                        return (ItemsUtils.FAIL_NO, None)
            if item_class == ItemsCatalog.GADGET:
                item_param = ItemsCatalog.GetItemParam(item_type)
                if 'waterNumberOfSips' in item_param and ItemsUtils.GetItemCondition(None, item) > 0:
                    duration = item_param.get('Action_use_time', duration)
                    self.cell.useItem(itemID)
                    return (error_level, duration)
                gadget_action = item_param.get('Action')
                self.startGadgetAction(gadget_action, item_params, ItemsUtils.GetComplexItemByID(self, itemID))
            return (error_level, duration)

    def askStartItemRepair(self, kit, item):
        if self.heli_weapon:
            self.ReportFail(ItemsUtils.FAIL_RESTRICTION)
            return False
        err_code = ItemsUtils.CanItemBeRepaired(self, item)
        if err_code:
            self.ReportFail(err_code)
            return False
        kit_id = kit['complexItemID']
        item_id = item['complexItemID']
        text = lc('Inventory.client.MAINTENANCE_ANSWER_TEXT')
        caption = lc('Inventory.client.MAINTENANCE_ANSWER_CAPTION')

        def _continue_oilrepair(event):
            if event == gui_jokes.askUserYesNo.YES:
                self.StartItemRepair(kit_id, item_id)

        gui_jokes.askUserYesNo(caption, text, _continue_oilrepair, enter_btn=gui_jokes.askUserYesNo.YES, default_btn=gui_jokes.askUserYesNo.NO)
        return True

    def StartItemRepair(self, kit_id, item_id):
        self.cancel_action_release()
        if not self.canUse():
            return
        kit = ItemsUtils.GetComplexItemByID(self, kit_id)
        item = ItemsUtils.GetComplexItemByID(self, item_id)
        item_param = ItemsCatalog.GetItemParam(item['complexItemType'])
        if self.ItemLocked(item):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Items.Messages.FAIL_OTHER_ACTION'))
            return
        if item_param.get('isnotRepairable', False):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnotRepairable_msg'))
            return
        if not ItemsUtils.CanRepairByKit(item, kit):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Items.Messages.FAIL_REPAIR_NOT_TYPE'))
            return
        self.to_use_item_ids = [item_id, kit_id]
        self.cell.onItemRepair(item_id, kit_id)

    def askStartWeaponGreaseOil(self, kit, item):
        kit_id = kit['complexItemID']
        item_id = item['complexItemID']
        text = lc('Inventory.client.MAINTENANCE_ANSWER_TEXT')
        caption = lc('Inventory.client.MAINTENANCE_ANSWER_CAPTION')

        def _continue_oilrepair(event):
            if event == gui_jokes.askUserYesNo.YES:
                self.StartWeaponGreaseOil(kit_id, item_id)

        gui_jokes.askUserYesNo(caption, text, _continue_oilrepair, enter_btn=gui_jokes.askUserYesNo.YES, default_btn=gui_jokes.askUserYesNo.NO)
        return True

    def StartWeaponGreaseOil(self, kit_id, item_id):
        kit = ItemsUtils.GetComplexItemByID(self, kit_id)
        item = ItemsUtils.GetComplexItemByID(self, item_id)
        if not ItemsUtils.canGreaseOilWeapon(item['complexItemType'], kit['complexItemType']):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Items.Messages.FAIL_REPAIR_NOT_TYPE'))
            return
        self.cell.onWeaponGreaseOil(item_id, kit_id)

    def canUseItemOnTarget(self, target_id, itemID):
        if not self.canUse() or self.sprinting:
            return
        item = ItemsUtils.GetComplexItemByID(self, itemID)
        if not item:
            return
        item_class = ItemsCatalog.GetItemClass(item['complexItemType'])
        if item_class != ItemsCatalog.BUFF:
            return
        target = BigWorld.entities.get(target_id, None)
        if target is None:
            return
        elif target.__class__.__name__ != 'Avatar':
            if target.__class__.__name__ == 'NPC':
                if target.dead:
                    if not target.can_revived:
                        return
                if target.dead and not ItemsUtils.is_it_medecine_item(item):
                    return
                param = ItemsCatalog.GetItemParam(item['complexItemType'])
                return (not param or not param.get('CanUseOnTarget')) and None
            return self.position.distTo(target.position) > Constants.INTERACTION_DISTANCE and None
        else:
            return True

    def onUseItemOnTarget(self, target_id, itemID):
        if not self.canUse() or self.sprinting:
            return
        item = ItemsUtils.GetComplexItemByID(self, itemID)
        target = BigWorld.entities.get(target_id, None)
        if target is None:
            return
        elif target.dead and not ItemsUtils.is_it_medecine_item(item):
            return
        elif item:
            equippingitemType = item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(equippingitemType)
            duration = Durations.GetItemUseDuration(self, equippingitemType)
            if item_class == ItemsCatalog.BUFF:
                self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, 10, lc('Items.GUIStrings.USING'))
                BWPersonality.GUICore.cast_bar.runUnCast(10)
                self.cell.useItemOnTarget(target_id, itemID)
            return duration
        else:
            return

    def onInFormWeponJammed(self):
        if not self.canInformJamm():
            return
        reload_type = ItemsUtils.GetItemReloadType(self.ActiveItemType, False)
        return reload_type

    def GetEquippedItemsToRepair(self):
        repair_filter = BigWorld.entities[self.last_interlocutor_id].repair_classes

        def FilterRepairItems(item):
            return ItemsUtils.CanItemBeRepaired(self, item, repair_filter) == None

        items_to_repair = self.GetEquippedItemsList()
        items_to_repair = filter(FilterRepairItems, items_to_repair)
        return items_to_repair

    def GetEquipedItemsRepairCost(self):
        items_to_repair = self.GetEquippedItemsToRepair()
        repair_cost = 0
        for item in items_to_repair:
            item_class = ItemsCatalog.GetItemClass(item['complexItemType'])
            repair_filter = BigWorld.entities[self.last_interlocutor_id].repair_classes
            if item_class not in repair_filter:
                continue
            if item_class == ItemsCatalog.WEAPON:
                end_cost, margin = ItemsUtils.GetClearingCost(item, self)
            else:
                end_cost, margin = ItemsUtils.GetRepairCost(item, self)
            repair_cost += end_cost

        return repair_cost

    def onComplexRepairCommit(self, event):
        """ \xd0\xbf\xd1\x80\xd0\xb8\xd0\xbd\xd1\x8f\xd1\x82\xd0\xb8\xd0\xb5 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbb\xd0\xb5\xd0\xba\xd1\x81\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe\xd1\x87\xd0\xb8\xd0\xbd\xd0\xba\xd0\xb5 """
        if event != gui_jokes.askUserYesNo.YES:
            return
        items_to_repair = self.GetEquippedItemsToRepair()
        for item in items_to_repair:
            self.NPCRepair(self.repairman_id, item['complexItemID'])

    def onComplexRepair(self, traderID):
        """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbe \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbb\xd0\xb5\xd0\xba\xd1\x81\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe\xd1\x87\xd0\xb8\xd0\xbd\xd0\xba\xd0\xb5 """
        repair_cost = self.GetEquipedItemsRepairCost()
        if not repair_cost:
            text = lc('Inventory.client.REPAIR_ANSWER_NO_ITEMS')
            gui_jokes.askUserOk(lc('Inventory.client.REPAIR_ANSWER_CAPTION'), text, self.onComplexRepairCommit)
            return
        repair_cost = groupNumber(repair_cost, '`')
        text = lc('Inventory.client.REPAIR_ANSWER_TEXT')
        text += '\n' + lc('Inventory.client.REPAIR_ANSWER_TEXT_MONEY').format(repair_cost)
        self.repairman_id = traderID
        gui_jokes.askUserYesNo(lc('Inventory.client.REPAIR_ANSWER_CAPTION'), text, self.onComplexRepairCommit, enter_btn=gui_jokes.askUserYesNo.YES, default_btn=gui_jokes.askUserYesNo.NO)

