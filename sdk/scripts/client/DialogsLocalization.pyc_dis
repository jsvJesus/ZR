# Embedded file name: ./client/DialogsLocalization.py
import Localization
from QuestDispatcher import get_widestring
import Constants
from Localization import lc

def parse_localized_data():

    def parse_file(name, item):
        dialogs = item.items()
        for dialogTuple in dialogs:
            if dialogTuple[0] == 'Dialog':
                dialog = dialogTuple[1]
                dialogNode = {}
                dialog_id = dialog['ID'].asInt
                dialogNode['Title'] = get_widestring(dialog, 'Title')
                dialogNode['Text'] = get_widestring(dialog, 'Text')
                dialogNode['Holder'] = name
                localizedData[dialog_id] = dialogNode
            elif dialogTuple[0] == 'Title':
                replica = dialogTuple[1]
                replica_id = replica['ID'].asInt
                replica_text = get_widestring(replica, 'Text')
                localized_titles[replica_id] = replica_text
            elif dialogTuple[0] == 'Text':
                replica = dialogTuple[1]
                replica_id = replica['ID'].asInt
                replica_text = get_widestring(replica, 'Text')
                localized_texts[replica_id] = replica_text

    localizedData = {}
    localized_titles = {}
    localized_texts = {}
    for name, item in Localization.localization_object.getDialogData().items():
        parse_file(name, item)

    localizedData[Constants.RESTORE_DIALOG_ID] = dict(Holder='undefined', Title=lc('Dialogs.Interface.RESTORE_DIALOG'), Text=u'')
    localizedData[Constants.TELEPORT_AGREE] = {'Title': lc('Dialogs.Interface.TELEPORT_AGREE'),
     'Holder': 'BASE_Teleporter',
     'Text': lc('Dialogs.Interface.TELEPORT_AGREET')}
    localizedData[Constants.TELEPORT_AGREEEMPTY] = {'Title': lc('Dialogs.Interface.TELEPORT_AGREEEMPTY'),
     'Holder': 'BASE_Teleporter',
     'Text': lc('Dialogs.Interface.TELEPORT_AGREEEMPTYT')}
    localizedData[Constants.TELEPORT_BREAKDIALOG] = {'Title': lc('Dialogs.Interface.TELEPORT_BREAKDIALOG'),
     'Holder': 'BASE_Teleporter'}
    localizedData[Constants.FAREWELL_DIALOG_ID] = {'Title': lc('Dialogs.Interface.OVER_DIALOG')}
    return (localizedData, localized_titles, localized_texts)


is_rus = Localization.Localization.globalLanguage == 'russian'
localizedData, localized_titles, localized_texts = parse_localized_data()

def reload_localization():
    global localized_texts
    global localizedData
    global localized_titles
    Localization.localization_object.reload_lc(force=True)
    localizedData, localized_titles, localized_texts = parse_localized_data()
    print 'Dialogs localization is reloaded'


def get_short_title(dialog_id):
    title = localizedData[dialog_id]['Title']
    if '||' in title:
        title = title.split('||')[0]
    elif '|' in title:
        title = title.split('|')[0]
    return title


def get_long_title(dialog_id):
    title = localizedData[dialog_id]['Title']
    if '||' in title:
        title = title.replace('||', '')
    elif '|' in title:
        title = title.split('|')[1]
    return title


def get_text(dialog_id):
    return localizedData[dialog_id]['Text']


def get_holder(dialog_id):
    return localizedData[dialog_id]['Holder']


def get_auto_text(replica_id):
    return localized_texts[replica_id]


def get_auto_title(replica_id):
    return localized_titles[replica_id]