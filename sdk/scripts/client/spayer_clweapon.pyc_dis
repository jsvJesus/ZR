# Embedded file name: ./client/spayer_clweapon.py
import BigWorld
import traceback
import math_bw
import random
from clweapon import ClWeapon

class AnimManometr:

    def __init__(self, weapon, act_name):
        self.parent_weapon = weapon
        self.act_name = act_name
        self._val = 0
        self._speed = 0

    def setValue(self, floatvalue = 0.0, speed = 0.2):
        if not self.parent_weapon:
            return
        else:
            act = self.parent_weapon._model.action(self.act_name)
            anim_frames = 20
            frame = math_bw.clamp(int(floatvalue * anim_frames), 0, anim_frames)
            framerate = 1.0
            act(0, None, 0, frame, frame, framerate)
            return

    def destroy(self):
        if not self.parent_weapon:
            return
        else:
            if self.parent_weapon._model:
                try:
                    self.parent_weapon._model.action(self.act_name).stop()
                except:
                    traceback.print_exc()

            self.parent_weapon = None
            return


class SpayerClweapon(ClWeapon):

    def __init__(self, *w, **kw):
        ClWeapon.__init__(self, *w, **kw)
        self._sprayer = True
        if self._parent_entity and hasattr(self._parent_entity, 'create_spray_particles'):
            self._parent_entity.create_spray_particles()
        self._l_manom_poison = None
        self._r_manom_gas = None
        self._upd_timer = BigWorld.callback(0.3, self._manometr_tick)
        return

    def _manometr_tick(self):
        self._upd_timer = BigWorld.callback(0.15, self._manometr_tick)
        if not self._model:
            return
        if not self._model.inWorld:
            BigWorld.cancelCallback(self._upd_timer)
            print '[WARNING] _manometr_tick: model not inWorld', self, self._model, self._parent_entity
            return
        if not self._l_manom_poison:
            self._l_manom_poison = AnimManometr(self, 'l_manom_poison')
        if not self._r_manom_gas:
            self._r_manom_gas = AnimManometr(self, 'r_manom_gas')
        self._r_manom_gas.setValue(1.0)
        ammo = self.getAmmoNumber()
        capac = self.getAmmoCapacity()
        val = 0.0
        if ammo and capac:
            val = ammo / float(capac)
        self._l_manom_poison.setValue(val)

    def shoot(self, *w, **kw):
        if not self._r_manom_gas:
            self._manometr_tick()
        ClWeapon.shoot(self, *w, **kw)
        self._r_manom_gas.setValue(random.randrange(0.5, 0.8, int=float))

    def onFireEmpty(self, *w, **kw):
        if not self._r_manom_gas:
            self._manometr_tick()
        ClWeapon.onFireEmpty(self, *w, **kw)
        self._r_manom_gas.setValue(random.randrange(0.6, 0.8, int=float))

    def destroy(self):
        ClWeapon.destroy(self)
        if self._upd_timer:
            BigWorld.cancelCallback(self._upd_timer)
        if self._l_manom_poison:
            self._l_manom_poison.destroy()
        if self._r_manom_gas:
            self._r_manom_gas.destroy()
        self._l_manom_poison = None
        self._r_manom_gas = None
        return