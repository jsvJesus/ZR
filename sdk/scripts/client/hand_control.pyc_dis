def idgenerator():
    x = 0
    while True:
        x += 1
        yield x


idgenerator = idgenerator()

def getMatrix(pos, ypr = None):
    matr = Matrix()
    matr.setTranslate(pos)
    if not ypr:
        return matr
    matr2 = Matrix()
    matr2.setRotateYPR(ypr)
    matr.preMultiply(matr2)
    return matr


def assert_break(isBreak):
    if isBreak and DEBUG:
        if not False:
            raise AssertionError
        return True
    return False


class HandControl:
    _hand_gravity_enabled = False
    _weapon_to_attached = None
    _prev_cheked_key = None
    __climb_command = None
    _is_injured = False
    TO_TRACKER_HAND_DELAY = 0.2
    hand_cotrol_wait_tmp = False
    __isPutOnOffProgress = False
    __isPutOffUnEq = False
    __isEquipProgress = False
    __lock_progress_by_on_hand_weapon = False
    __use_animation_played = False
    __reload_weapon_progress = False
    __reload_weapon_osn_anmation = False
    _getup_animation_played = False
    _left_to_right_played = False
    _belly_to_right_played = False
    h_crawl_left_hand_anim = False
    h_need_attach_left_after_crawl = False
    h_crawl_anim_played = False
    _after_jump_landing_state = False
    __itemType = 0
    _slope_caps = False
