# Embedded file name: ./client/VerticalLadder.py
import Math
import BigWorld
from math import ceil, pi
from math_bw import angle_between_vectors
from Helpers.Caps import CAP_INTERACT
import vertical_ladder_settings
reload(vertical_ladder_settings)
from vertical_ladder_settings import DEF_LADDER_MODEL_HEIGHT
from vertical_ladder_settings import DEF_LADDER_OFFSET
from soGUI.soInworldMarkers import soInworldMarker
from Localization import lc
import BWPersonality
import traceback

class VerticalLadder(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.targetCaps = [CAP_INTERACT]
        self.steps = int(ceil(self.height / DEF_LADDER_MODEL_HEIGHT))
        self.steps = max(1, self.steps)
        self._real_height = self.steps * DEF_LADDER_MODEL_HEIGHT
        self._locked = False

    def getconf(self):
        return vertical_ladder_settings.LADDERS_BY_ID[self.model_type]

    def get_interaction_dist(self):
        return 1.0

    def get_target_mark(self, distance):
        if distance > self.get_interaction_dist():
            return None
        elif not self.canInteract(BigWorld.player()):
            return None
        else:
            return soInworldMarker.MARKER_USE

    def get_mark_name(self):
        try:
            use_key = BWPersonality.settings.keyBindings.getKeyBindForAction('InteractObject')
            return lc('PlayerAvatar.client.use_vert_ladder_mark').format(use_key)
        except:
            traceback.print_exc()
            return 'press F'

    def _playerFromUpper(self, player):
        z = self.position.y + self._real_height - player.position.y
        if z < 0.5:
            return True
        return False

    def get_mark_height(self):
        if self._playerFromUpper(BigWorld.player()):
            return self._real_height + 1.3
        return 1.1

    def canInteract(self, player):
        if not player:
            player = BigWorld.player()
            if self._playerFromUpper(player):
                return True
            dir_ = Math.Vector3()
            dir_.setPitchYaw(0, self.yaw)
            dir2_ = player.position - self.position
            dir2_.y = 0
            angle = angle_between_vectors(dir_, dir2_)
            return angle > pi / 2 and True
        return False

    def interact(self, player):
        if player.is_throwing:
            return
        if not self.canInteract(player):
            return
        if self._locked:
            return
        self._locked = True

        def off_lock():
            self._locked = False

        BigWorld.callback(1, off_lock)
        enterup = self._playerFromUpper(player)
        offset = Math.Vector3()
        offset.setPitchYaw(0, self.yaw)
        offset = offset * DEF_LADDER_OFFSET
        position = self.position - offset
        player.startVerticalLadder(position, self._real_height, self.yaw, enterup=enterup)

    def onEnterWorld(self, prereqs = None):
        interacrt_height = self.steps * DEF_LADDER_MODEL_HEIGHT + 1.7
        self.model = BigWorld.Model('')
        self.model.scale = self.model.newScaleTest = (0.7, interacrt_height, 0.7)
        self.skeletonCollider = BigWorld.SkeletonCollider()
        box = BigWorld.BoxAttachment()
        box.name = 'ladder'
        box.minBounds = (-0.7, 0, -0.3)
        box.maxBounds = (0.7, interacrt_height, 0.3)
        self.model.root.attach(box)
        self.skeletonCollider.addCollider(box)