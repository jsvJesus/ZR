# Embedded file name: ./client/MassQuestObject.py
import BigWorld
import Helpers.Caps
import Constants
from soGUI.soInworldMarkers import soInworldMarker
MODEL_NAME = 'models/bolvan/box_trigger_10x10x20.model'

class MassQuestObject(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.filter = BigWorld.NoneFilter()

    def prerequisites(self):
        return [MODEL_NAME]

    def onEnterWorld(self, prereqs):
        self.model = prereqs[MODEL_NAME]
        self.model.visible = False
        if Helpers.Caps.CAP_CAN_USE not in self.targetCaps:
            self.targetCaps = self.targetCaps + [Helpers.Caps.CAP_CAN_USE]

    def get_target_mark(self, distance):
        if distance > Constants.INTERACTION_DISTANCE:
            return None
        else:
            return soInworldMarker.MARKER_USE

    def activate(self):
        self.cell.activate()