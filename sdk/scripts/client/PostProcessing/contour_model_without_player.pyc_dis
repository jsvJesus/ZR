import contour_model
from PostProcessing import Effect
from PostProcessing.RenderTargets import rt
import PostProcessing
from PostProcessing.RenderTargets import rt
from PostProcessing.Phases import buildBlurPhase
from PostProcessing.FilterKernels import straightTransfer4Tap
from PostProcessing import BW_BLEND_ONE, BW_BLEND_ZERO

class ContourModelToTextueWithoutPlayer(contour_model.ContourModelToTextue):
    """
    todo doc
    """

    def __init__(self, player_texture):
        self.name = 'ContourModelToTextueWithoutPlayer'
        self.pp_id = None
        self._createPostEffect(player_texture)
        return

    def _inputTexture(self):
        return rt('contourRenderToTexture_w_player_2')

    def _createPostEffect(self, player_texture):
        USE_BLUR = 1
        BRIGHTNESS = 1.0
        BLUR_WIDTH = 4
        HIGHT_LEVEL_FILTER = 0
        rt1 = rt('contourRenderToTexture_w_player_1')
        rt2 = self._inputTexture()
        rt3 = rt('contourRenderToTexture_w_player_3')
        rt4 = rt('contourRenderToTexture_w_player_4')
        self.output = rt4
        phases = []
        self._red_phase = contour_model._buildREDPhase(rt2.texture, rt1)
        self._fourtap_phase = contour_model._buildFourTapPhase2(rt1.texture, rt2)
        if USE_BLUR:
            self._blur_phase_h = buildBlurPhase(rt2.texture, rt3, True, filterMode=HIGHT_LEVEL_FILTER, width=BLUR_WIDTH)
            self._blur_phase_v = buildBlurPhase(rt3.texture, rt2, False, filterMode=HIGHT_LEVEL_FILTER, width=BLUR_WIDTH)
            self._blur_phase_h.material.brightness = BRIGHTNESS
            self._blur_phase_v.material.brightness = BRIGHTNESS
        self._subtr_phase = contour_model._buildSUBPhase(rt2.texture, rt1.texture, rt3)
        self._subtr_player_phase = contour_model._buildSUBPhase(rt3.texture, player_texture, rt4)
        phases.append(self._red_phase)
        phases.append(self._fourtap_phase)
        if USE_BLUR:
            phases.append(self._blur_phase_h)
            phases.append(self._blur_phase_v)
        phases.append(self._subtr_phase)
        phases.append(self._subtr_player_phase)
        self.pp_effect = Effect()
        self.pp_effect.name = self.name
        self.pp_effect.phases = phases