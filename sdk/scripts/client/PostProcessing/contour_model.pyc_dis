"""
import PostProcessing
from PostProcessing.RenderTargets import rt
from PostProcessing import Effect
from PostProcessing.Phases import buildPhase, Phase, TransferQuad, Material
from PostProcessing import BW_BLEND_ONE, BW_BLEND_ZERO
from PostProcessing.FilterKernels import straightTransfer4Tap

def _filterKernelsMean9Tap2():
    """\xd1\x82\xd0\xbe\xd0\xbb\xd1\x89\xd0\xb8\xd0\xbd\xd0\xb0 \xd0\xbe\xd0\xb1\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xba\xd0\xb8 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb1\xd1\x8b\xd1\x82\xd1\x8c \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb0 \xd1\x82\xd1\x83\xd1\x82"""
    w = 0.2
    x = 2.5
    y = 2.5
    samples = [(x * -1, y * 1, w),
     (x * -1, y * 1, w),
     (x * -1, y * 1, w),
     (x * -1, y * -1, w),
     (x * -1, y * -1, w),
     (x * -1, y * -1, w),
     (x * 1, y * -1, w),
     (x * 1, y * -1, w),
     (x * 1, y * -1, w),
     (x * 1, y * 1, w),
     (x * 1, y * 1, w),
     (x * 1, y * 1, w)]
    return samples


def _buildREDPhase(input_texture, output_rt, srcBlend = BW_BLEND_ONE, destBlend = BW_BLEND_ZERO):
    """
            \xd1\x84\xd0\xb0\xd0\xb7\xd0\xb0, \xd0\xb7\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x8e\xd1\x88\xd0\xb0\xd1\x8f \xd1\x81\xd0\xbf\xd0\xbb\xd0\xbe\xd1\x88\xd0\xbd\xd1\x8b\xd0\xbc \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82\xd0\xbe\xd0\xbc
    """
    p = buildPhase(input_texture, output_rt, 'shaders/post_processing/redcolor.fx', straightTransfer4Tap, srcBlend, destBlend)
    p.name = 'colorFILL'
    return p


def _buildSUBPhase(input1, input2, output, srcBlend = BW_BLEND_ONE, destBlend = BW_BLEND_ZERO):
    """ 
            \xd1\x84\xd0\xb0\xd0\xb7\xd0\xb0 \xd0\xb2\xd1\x8b\xd1\x87\xd0\xb8\xd1\x82\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb0\xd1\x8f input2 \xd0\xb8\xd0\xb7 input1, \xd1\x80\xd0\xb5\xd0\xb7\xd1\x83\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb0\xd1\x82 \xd0\xb2 output
    """
    f = TransferQuad()
    p = Phase()
    m = Material('shaders/post_processing/substracle_texture.fx')
    m.inputTexture = input1
    m.inputTexture2 = input2
    p.filterQuad = f
    p.material = m
    p.material.srcBlend = srcBlend
    p.material.destBlend = destBlend
    p.renderTarget = output
    p.clearRenderTarget = False
    p.name = 'substracle_texture'
    return p


def _buildFourTapPhase2(input_texture, output_rt):
    p = buildPhase(input_texture, output_rt, 'shaders/post_processing/four-tap_filter.fx', _filterKernelsMean9Tap2, BW_BLEND_ONE, BW_BLEND_ONE)
    p.name = 'FourTapPhase2'
    p.clearRenderTarget = True
    return p


class ContourModelToTextue(object):
    """
    todo doc
    """
    _enabled = False

    def __init__(self, input_texture):
        self.name = 'ContourModelToTextue'
        self.pp_id = None
        self._createPostEffect(input_texture)
        return

    def _createPostEffect(self, input_texture):
        rt1 = rt('contourRenderToTexture_1')
        rt2 = rt('contourRenderToTexture_2')
        rt3 = rt('contourRenderToTexture_3')
        self.output = rt3
        self._red_phase = _buildREDPhase(input_texture, rt1)
        self._fourtap_phase = _buildFourTapPhase2(rt1.texture, rt2)
        self._subtr_phase = _buildSUBPhase(rt2.texture, rt1.texture, rt3)
        self.pp_effect = Effect()
        self.pp_effect.name = self.name
        self.pp_effect.phases = [self._red_phase, self._fourtap_phase, self._subtr_phase]

    def _getColour(self):
        return self._red_phase.material.colourise

    def _setColour(self, color):
        self._red_phase.material.colourise = color

    colour = property(_getColour, _setColour)

    def enable(self):
        if self._enabled or self.pp_id:
            return
        self._enabled = True
        self.pp_id = PostProcessing.addPPChainEffects(self.pp_effect)

    def disable(self):
        if not self._enabled:
            return
        else:
            self._enabled = False
            PostProcessing.removePPChain(self.pp_id)
            self.pp_id = None
            return