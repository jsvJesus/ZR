        return cls.instance

    def __init__(self):
        self.blackCoeff = 1.9
        self._fov_to = -1
        self.blur_enable = False
        self.pp_effect_id = None
        self._show_dof = True
        self.paused = False
        self._is_collimator = False
        self._last_tst_centre_camera = None
        self._is_binocular_mode = False
        self._scope_eff_enable = False
