def onLoadResource(resurce):
    for key in resurce.keys():
        _cache_[key] = resurce.pop(key)


import binoculars_settings
BigWorld.loadResourceListBG(binoculars_settings.get_preresq(), onLoadResource)

def getTextue(key):
    return _cache_.get(key) or key


def draw3dLine(src, dst = None, colour = (1,
 0,
 0,
 1)):
    if dst is None:
        dst = src + Vector3(0, 1.5, 0)
    BigWorld.getGeometricInstance().addLine(src, dst, colour, 0)
    return


def buildScopeScalePhase(input_texture, output, srcBlend = BW_BLEND_SRCALPHA, destBlend = BW_BLEND_INVSRCALPHA):
    p = buildPhase(input_texture, output, 'shaders/post_processing/scope_scale.fx', straightTransfer4Tap, srcBlend, destBlend)
    p.name = 'ScopeScalePhase'
    return p


def buildScopeScaleMaskPhase(input_texture, output, srcBlend = BW_BLEND_SRCALPHA, destBlend = BW_BLEND_INVSRCALPHA):
    p = buildPhase(input_texture, output, 'shaders/post_processing/scope_scale_mask.fx', straightTransfer4Tap, srcBlend, destBlend)
    p.name = 'ScopeScalePhaseMask'
    return p


def buildBinocularsPhase(input_texture, output, srcBlend = BW_BLEND_SRCALPHA, destBlend = BW_BLEND_INVSRCALPHA):
    p = buildPhase(input_texture, output, 'shaders/post_processing/binoculars.fx', straightTransfer4Tap, srcBlend, destBlend)
    p.name = 'BinocularsPhase'
    return p


class _BlurBlend(object):

    def __init__(self):
        self._to = 1.0
        self._val = 1.0

    def setValueTo(self, value):
        self._to = value
        if value > self._val:
            self._val = value

    def updateBlend(self, dtime):
        diff = self._to - self._val
        self._val = self._val + diff * 0.15

    def value(self):
        return self._val

    def valueV4(self):
        return (self._val,
         self._val,
         self._val,
         1.0)


class MyScopeEff(object):
    """
