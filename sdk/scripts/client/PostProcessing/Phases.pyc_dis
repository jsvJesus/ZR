@implementPhaseFactory('Vignette Model', 'Overlay a vignette texture on the screen.', None)
def buildVignetteModelPhase(input):
    transferMesh = VisualTransferMesh()
    transferMesh.resourceID = 'models/bolvan/helpers/vignette.visual'
    p = buildBasePhase(None, 'shaders/post_processing/vignette_model.fx', BW_BLEND_SRCALPHA, BW_BLEND_INVSRCALPHA)
    p.name = 'vignette model'
    p.filterQuad = transferMesh
    p.material.vignetteColour = (0, 0, 0, 0)
    p.material.vingetteIntensity = 0.55
    return p


def fillTaps9(mat, filter):
    taps = filter()
    mat.tap1 = (taps[0][0],
     taps[0][1],
     taps[0][2],
     0)
    mat.tap2 = (taps[1][0],
     taps[1][1],
     taps[1][2],
     0)
    mat.tap3 = (taps[2][0],
     taps[2][1],
     taps[2][2],
     0)
    mat.tap4 = (taps[3][0],
     taps[3][1],
     taps[3][2],
     0)
    mat.tap5 = (taps[4][0],
     taps[4][1],
     taps[4][2],
     0)
    mat.tap6 = (taps[5][0],
     taps[5][1],
     taps[5][2],
     0)
    mat.tap7 = (taps[6][0],
     taps[6][1],
     taps[6][2],
     0)
    mat.tap8 = (taps[7][0],
     taps[7][1],
     taps[7][2],
     0)
    mat.tap9 = (taps[8][0],
     taps[8][1],
     taps[8][2],
     0)


def finiPhases():
    global backBufferCopyCache
    print 'PostProcessing.Phases.fini()'
    backBufferCopyCache = {}