# Embedded file name: ./client/SfxCatalog.py
import BigWorld
import math

class Mat:
    Default = 'default'

    @staticmethod
    def get_material_id_by_name(material_name):
        return getattr(Mat, material_name, None)


for child_id, child_data in BigWorld.getMaterialKinds():
    desc = child_data['desc'].asString
    desc = desc.replace(' ', '_')
    setattr(Mat, desc, child_id)

