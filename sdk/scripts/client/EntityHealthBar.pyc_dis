# Embedded file name: ./client/EntityHealthBar.py
import BigWorld
from tank_parts.tank_mark import TankMarker

class EntityHealthBar:

    def __init__(self):
        self._ui_marker = None
        return

    def get_model_height(self):
        if not self.model:
            return 2
        p1, p2 = self.model.getMinMaxbounds
        return (p2 - p1)[1]

    def get_custom_mark(self, distance):
        if distance > self.get_mark_distance():
            return
        else:
            if self._ui_marker is None:
                self._ui_marker = TankMarker(self, self.get_model_height())
                self._ui_marker.set_ratio(self.health_ratio)
            return self._ui_marker

    def get_mark_distance(self):
        return 70.0

    def set_health_ratio(self, old_value):
        if self._ui_marker:
            self._ui_marker.set_ratio(self.health_ratio)