# Embedded file name: ./client/tank_parts/tank_track_pix.py
import utils
from particles import Pix
from functools import partial

class TrackParticles:

    def __init__(self, tank, model, side = 'LF', purge = False):
        self._ps = {}
        self._tank = tank
        self._current = None
        self._paused = None
        node = model.node(self._tank.conf('TRAKS_NODE')[side])
        for mater in ['gravel', 'mud', 'water']:
            ps_path = self._tank.conf('TRAKS_DIR').rstrip('/\\')
            ps_path += '/' + mater + '/' + side + '.xml'
            self._ps[mater] = Pix(node, ps_path, partial(self._onLoad, mater), purge=purge)

        return

    def _onLoad(self, mater, pix):
        if not self._ps:
            return pix.destroy()
        if self._current == mater and not self._paused:
            self._ps[mater].play()

    def destroy(self):
        for ps in self._ps.values():
            ps.destroy()

        self._ps = {}
        self._tank = None
        return

    def updateMater(self, water_depth, mat_id):
        mater_name = 'water'
        if water_depth <= 0:
            mater_name = utils.get_transport_material_by_id(mat_id)
        self.applyMater(mater_name)

    def setPaused(self, value):
        self._paused = value
        if self._current in self._ps:
            if self._paused:
                self._ps[self._current].pause()
            else:
                self._ps[self._current].play()

    @property
    def mater_name(self):
        return self._current

    def applyMater(self, mater_name):
        if self._current != mater_name:
            if self._current in self._ps:
                self._ps[self._current].pause()
            if mater_name in self._ps and not self._paused:
                self._ps[mater_name].play()
            self._current = mater_name