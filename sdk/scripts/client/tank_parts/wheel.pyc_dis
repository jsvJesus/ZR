# Embedded file name: ./client/tank_parts/wheel.py


class WheelAction(object):

    def __init__(self, model, action_name):
        self.action_name = action_name
        self._action = getattr(model, action_name)
        self._action()
        self._firstFrame = self._action.firstFrame
        self._lastFrame = self._action.lastFrame
        self._frameRate = self._action.frameRate
        self._cur_firstFrame = self._firstFrame
        self._cur_lastFrame = self._lastFrame
        self.paused = False
        self.pause()

    def _getActionCurrentFrame(self):
        cur_frame = self._cur_firstFrame
        anim_perc = 0.0
        for info in self._action.playedInfo():
            if info and info['name_'] == self.action_name:
                anim_perc = 0.0
                if info['duration'] > 0:
                    anim_perc = info['played_'] % info['duration'] / info['duration']
                    frame_count = self._cur_lastFrame - self._cur_firstFrame
                    cur_frame = self._cur_firstFrame + int(frame_count * anim_perc)

        return (cur_frame, anim_perc)

    def _playFromFrame(self, frame, first, last, new_frame_rate = None):
        self._cur_firstFrame = first
        self._cur_lastFrame = last
        frame_count = self._cur_lastFrame - self._cur_firstFrame
        if new_frame_rate:
            self._frameRate = float(new_frame_rate)
        played = 10.0
        if frame_count:
            played = (frame - self._cur_firstFrame) / float(self._frameRate)
        played = abs(played)
        passed = played
        if new_frame_rate:
            self._frameRate = float(new_frame_rate)
        self._action.changeParam(passed, played, first, last, self._frameRate)

    def _playFromPercent(self, perc, first, last, new_frame_rate = None):
        self._cur_firstFrame = first
        self._cur_lastFrame = last
        frame_count = self._cur_lastFrame - self._cur_firstFrame
        if new_frame_rate:
            self._frameRate = float(new_frame_rate)
        duration = frame_count / self._frameRate
        played = perc * duration
        played = abs(played)
        passed = played
        self._action.changeParam(passed, played, first, last, self._frameRate)

    def pause(self):
        if self.paused:
            return
        self.paused = True
        frame, anim_perc = self._getActionCurrentFrame()
        self._playFromFrame(frame, frame, frame)

    def play(self, speed = 60.0):
        self.paused = False
        frame, anim_perc = self._getActionCurrentFrame()
        self._playFromPercent(anim_perc, self._firstFrame, self._lastFrame, new_frame_rate=speed)