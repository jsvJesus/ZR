# Embedded file name: ./client/tank_parts/tank_spash_pix.py
import BigWorld
from particles import Pix
from sounds_manager import playSound

class SplashParticle:

    def __init__(self, tank, model, side = 'LF', purge = False):
        self._isDestroyed = False
        self._isSplash = False
        self._model = model
        self._tank = tank
        node = model.node(self._tank.conf('WATER_SPLASH_NODE'))
        ps_path = self._tank.conf('WATER_SPLASH_PATH')
        self._pix = Pix(node, ps_path, self._onLoad, purge=purge)

    def _onLoad(self, pix):
        if self._isDestroyed:
            return pix.destroy()

    def destroy(self):
        self._isDestroyed = True
        if self._pix:
            self._pix.destroy()
        self._pix = None
        self._model = None
        self._model = None
        return

    def _endSplash(self):
        if self._isDestroyed:
            return
        self._pix.pause()

    def _startSplash(self):
        if self._isDestroyed:
            return
        if not self._isSplash:
            return
        self._pix.play()
        playSound('transport/bmp_tank/splash', self._model)

    def updateMater(self, water_depth, mat_id):
        if not self._isSplash and water_depth >= self._tank.conf('WATER_SPLASH_DEPTH'):
            self._isSplash = True
            BigWorld.callback(self._tank.conf('WATER_SPLASH_DELAY'), self._startSplash)
            BigWorld.callback(self._tank.conf('WATER_SPLASH_TIME'), self._endSplash)
        elif water_depth <= 0:
            self._isSplash = False

    def setPaused(self, value):
        self._paused = value
        if self._pix:
            self._pix.pause()