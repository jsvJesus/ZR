# Embedded file name: ./client/tank_parts/tank_dust_pix.py
import utils
from particles import Pix

class DustParticle:

    def __init__(self, tank, model, purge = False):
        self._current = None
        self._isDestroyed = False
        self._enable = False
        self._paused = False
        self._tank = tank
        node = model.node(self._tank.conf('DUST_NODE'))
        ps_path = self._tank.conf('DUST_PATH')
        self._pix = Pix(node, ps_path, self._onLoad, purge=purge)
        return

    def _onLoad(self, pix):
        if self._isDestroyed:
            return pix.destroy()
        self.update()

    def destroy(self):
        self._isDestroyed = True
        if self._pix:
            self._pix.destroy()
        self._pix = None
        self._tank = None
        return

    def updateMater(self, water_depth, mat_id):
        enable = False
        if water_depth <= 0 and utils.get_transport_material_by_id(mat_id) != 'mud':
            enable = True
        if enable != self._enable:
            self._enable = enable
            self.update()

    def setPaused(self, value):
        self._paused = value
        self.update()

    def update(self):
        if self._isDestroyed:
            return
        if not self._pix:
            return
        if self._paused or not self._enable:
            self._pix.pause()
        else:
            self._pix.play()