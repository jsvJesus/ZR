# Embedded file name: ./client/ui/text.py
from math_bw import clamp
import BigWorld
import GUI
import bisect
from panel import Panel
import colorCodes as CC

class Align:
    Left, Center, Right = xrange(3)
    Top, Center, Bottom = xrange(3)


class Text(Panel):

    def __init__(self, parent_component, name, size = 18, text = '', depth = 0.5):
        Panel.__init__(self, parent_component, name, depth=depth)
        self._size = size
        self._text = text
        self._scalable = True
        self._color = None
        comp = GUI.Text('')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.5)
        comp.multiline = True
        comp.colourFormatting = True
        self.component.addChild(comp, 'text')
        self.set_alignment(Align.Center, Align.Center)
        self._update_text_content()
        return

    def set_color(self, rgba_tuple):
        self._color = rgba_tuple
        self._update_text_content()

    def set_font(self, font_size):
        self._size = font_size

    def set_unscalable(self):
        self._scalable = False
        self.on_size_changed()

    def set_text(self, text):
        self._text = text
        self._update_text_content()

    def _update_text_content(self):
        text = self._text
        if self._color:
            text = CC.rgba_to_hex(self._color) + text
        self.component.text.text = text

    def calc_text_height(self):
        prev_mode = self.component.text.heightMode
        self.component.text.heightMode = 'PIXEL'
        result = self.component.text.height
        self.component.text.heightMode = prev_mode
        return result

    def calc_ratio_text_height(self):
        return self.calc_text_height() / self.transform.pixel_ratio

    def set_alignment(self, horizontal_align, vertical_align):
        comp = self.component.text
        if horizontal_align == Align.Left:
            comp.horizontalAnchor = 'LEFT'
            comp.position[0] = -1
        elif horizontal_align == Align.Center:
            comp.horizontalAnchor = 'CENTER'
            comp.position[0] = 0
        elif horizontal_align == Align.Right:
            comp.horizontalAnchor = 'RIGHT'
            comp.position[0] = 1
        else:
            raise NotImplementedError(horizontal_align)
        if vertical_align == Align.Top:
            comp.verticalAnchor = 'TOP'
            comp.position[1] = 1
        elif vertical_align == Align.Center:
            comp.verticalAnchor = 'CENTER'
            comp.position[1] = 0
        elif vertical_align == Align.Bottom:
            comp.verticalAnchor = 'BOTTOM'
            comp.position[1] = -1
        else:
            raise NotImplementedError(vertical_align)

    def on_size_changed(self):
        self.component.text.font = calc_needed_font(self._size, scalable=self._scalable)

    def get_string_width(self):
        return self.component.text.stringWidth(self.component.text.text)


def calc_needed_font(size, scalable = True, override_base_resolution = None):
    if scalable:
        needed_size = screen_ratio(override_base_resolution) * size
    else:
        needed_size = size
    needed_index = max(0, bisect.bisect_left(_seek_indices, needed_size))
    needed_index = clamp(needed_index, 0, len(_seek_indices) - 1)
    font_size = _seek_indices[needed_index]
    if font_size > needed_size and needed_index > 0:
        if abs(_seek_indices[needed_index - 1] - needed_size) < abs(_seek_indices[needed_index] - needed_size):
            needed_index = needed_index - 1
    return _seek_fonts[needed_index]


def screen_ratio(override_base_resolution = None):
    base_resolution = override_base_resolution or (1920, 1080, 0.5)
    screen_width, screen_height = BigWorld.screenSize()
    return screen_width / base_resolution[0] * (1 - base_resolution[2]) + screen_height / base_resolution[1] * base_resolution[2]


_available_fonts = [(16, 'RobotoCondensedRegular_16.font'),
 (18, 'RobotoCondensedRegular_18.font'),
 (20, 'RobotoCondensedRegular_20.font'),
 (24, 'RobotoCondensedRegular_24.font'),
 (28, 'RobotoCondensedRegular_28.font'),
 (32, 'RobotoCondensedRegular_32.font'),
 (36, 'RobotoCondensedRegular_36.font')]
_seek_indices = [ f[0] for f in _available_fonts ]
_seek_fonts = [ f[1] for f in _available_fonts ]