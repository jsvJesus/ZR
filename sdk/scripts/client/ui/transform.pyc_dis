    @staticmethod
    def calc_pixel_ratio():
        screen_width, screen_height = BigWorld.screenSize()
        return screen_width / _base_resolution[0] * (1 - _base_resolution[2]) + screen_height / _base_resolution[1] * _base_resolution[2]

    def _pixel_ratio(self):
        if self._base_resolution:
            screen_width, screen_height = BigWorld.screenSize()
            return screen_width / self._base_resolution[0] * (1 - self._base_resolution[2]) + screen_height / self._base_resolution[1] * self._base_resolution[2]
        else:
            return 1.0

    @property
    def pixel_ratio(self):
        return self._pixel_ratio()

    @property
    def height(self):
        return self.component.height

    @property
    def width(self):
        return self.component.width

    @property
    def ratio_height(self):
        return self.height / self.pixel_ratio

    @property
    def ratio_width(self):
        return self.width / self.pixel_ratio