    def apply_mode(self):
        if not self._mode:
            raise AssertionError
            pixel_ratio = self._pixel_ratio()
            prev_size = (self.component.width, self.component.height)

            def parent_size():
                parent = self.component.parent
                prev_mode = (parent.widthMode, parent.heightMode)
                parent.widthMode, parent.heightMode = ('PIXEL', 'PIXEL')
                result = (parent.width, parent.height)
                parent.widthMode, parent.heightMode = prev_mode
                return result

            def apply_pixel_mode(_, pivot, clip_pos, size, pixel_pos):
                width, height = parent_size()
                x = width * clip_pos[0] + pixel_pos[0] * pixel_ratio
                y = height * clip_pos[1] + pixel_pos[1] * pixel_ratio
                width, height = size[0] * pixel_ratio, size[1] * pixel_ratio
                x -= width * pivot[0]
                y -= height * pivot[1]
                return (x,
                 y,
                 width,
                 height)

            def apply_clip_mode(_, clip_anchors, pixel_anchors):
                width, height = parent_size()
                x1 = clip_anchors[0] * width + pixel_anchors[0] * pixel_ratio
                y1 = clip_anchors[1] * height + pixel_anchors[1] * pixel_ratio
                x2 = clip_anchors[2] * width + pixel_anchors[2] * pixel_ratio
                y2 = clip_anchors[3] * height + pixel_anchors[3] * pixel_ratio
                return (x1,
                 y1,
                 x2 - x1,
                 y2 - y1)

            def apply_mixed_mode(_, x_params, y_params):
                width, height = parent_size()
                if x_params[0] == _pixel:
                    _, pivot, clip_pos, size, pixel_pos = x_params
                    x = width * clip_pos + pixel_pos * pixel_ratio
                    width = size * pixel_ratio
                    x -= width * pivot
                elif x_params[0] == _clip:
                    _, clip_anchors, pixel_anchors = x_params
                    x = clip_anchors[0] * width + pixel_anchors[0] * pixel_ratio
                    x2 = clip_anchors[1] * width + pixel_anchors[1] * pixel_ratio
                    width = x2 - x
                if y_params[0] == _pixel:
                    _, pivot, clip_pos, size, pixel_pos = y_params
                    y = height * clip_pos + pixel_pos * pixel_ratio
                    height = size * pixel_ratio
