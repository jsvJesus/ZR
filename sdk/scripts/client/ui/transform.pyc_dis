                ratio = float(width) / height
                w, h = self.component.texture.width, self.component.texture.height
                r = float(w) / h
                if ratio > r:
                    h = width / r
                    w = width
                else:
                    w = height * r
                    h = height
                return ((width - w) * 0.5,
                 (height - h) * 0.5,
                 w,
                 h)

            if self._mode[0] == _pixel:
                rect = apply_pixel_mode(*self._mode)
            elif self._mode[0] == _clip:
