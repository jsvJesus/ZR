# Embedded file name: ./client/ui/transform.py
import math_bw
import BigWorld
_base_resolution = (1980, 1020, 0.5)
_pixel, _clip, _mixed, _fill = xrange(4)

def pixel_params(pivot, clip_pos, size, pixel_pos = 0):
    return (_pixel,
     pivot,
     clip_pos,
     size,
     pixel_pos)


def clip_params(clip_anchors, pixel_anchors = (0, 0)):
    return (_clip, clip_anchors, pixel_anchors)


class Transform(object):

    def __init__(self, component):
