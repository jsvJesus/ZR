    def set_screen_pos(self, comp_x, comp_y, screen_x, screen_y):
        if self._mode[0] == _pixel:
            screen_width, screen_height = BigWorld.screenSize()
            local_x, local_y = self.component.localToScreen((0, 0))
            local_x = (local_x + 1.0) * 0.5 * screen_width
            local_y = (local_y + 1.0) * 0.5 * screen_height
            ratio = self._pixel_ratio()
            disp_x = (local_x + comp_x - screen_x) / ratio
            disp_y = (local_y - comp_y - screen_y) / ratio
            if disp_x or disp_y:
                pixel_anchors = self._mode[-1]
                pixel_anchors = (pixel_anchors[0] - disp_x, pixel_anchors[1] + disp_y)
                self._mode[-1] = pixel_anchors
                self.apply_mode()
        elif self._mode[0] == _clip:
            screen_width, screen_height = BigWorld.screenSize()
            local_x, local_y = self.component.localToScreen((0, 0))
            local_x = (local_x + 1.0) * 0.5 * screen_width
            local_y = (local_y + 1.0) * 0.5 * screen_height
            disp_x = (local_x + comp_x - screen_x) / self.component.parent.width
            disp_y = (local_y - comp_y - screen_y) / self.component.parent.height
            if disp_x or disp_y:
                clip_anchors = self._mode[1]
                clip_anchors = (clip_anchors[0] - disp_x,
                 clip_anchors[1] + disp_y,
                 clip_anchors[2] - disp_x,
                 clip_anchors[3] + disp_y)
                self._mode[1] = clip_anchors
                self.apply_mode()
        else:
            raise NotImplementedError

    def set_scale_clamp_scale(self, min_size, max_size):
        if self._mode[0] == _pixel and min_size and max_size:
            size = self._mode[3]
            size_x = math_bw.clamp(size[0], min_size[0], max_size[0])
            size_y = math_bw.clamp(size[1], min_size[1], max_size[1])
            if (size_x, size_y) != size:
                self._mode[3] = (size_x, size_y)
                self.apply_mode()
        self._clamp_size = (min_size, max_size)

    def scale(self, pivot, scale):
        if self._mode[0] == _pixel:
            pixel_ratio = self._pixel_ratio()
            size, pixel_anchors = self._mode[3], self._mode[-1]
            new_size = [size[0] * scale, size[1] * scale]
            aspect = float(size[0]) / size[1]
            if self._clamp_size[0]:
                if self._clamp_size[0][0] > new_size[0]:
                    new_size[0] = self._clamp_size[0][0]
                    new_size[1] = new_size[0] / aspect
                    scale = new_size[0] / size[0]
                if self._clamp_size[0][1] > new_size[1]:
                    new_size[1] = self._clamp_size[0][1]
                    new_size[0] = new_size[1] * aspect
                    scale = new_size[1] / size[1]
            if self._clamp_size[1]:
                if self._clamp_size[1][0] < new_size[0]:
                    new_size[0] = self._clamp_size[1][0]
                    new_size[1] = new_size[0] / aspect
                    scale = new_size[0] / size[0]
                if self._clamp_size[1][1] < new_size[1]:
                    new_size[1] = self._clamp_size[1][1]
                    new_size[0] = new_size[1] * aspect
                    scale = new_size[1] / size[1]
            x, y = pivot[0] / pixel_ratio - size[0] * 0.5, pivot[1] / pixel_ratio - size[1] * 0.5
            pixel_anchors = (pixel_anchors[0] + x * (1 - scale), pixel_anchors[1] + y * (1 - scale))
            self._mode[3], self._mode[-1] = new_size, pixel_anchors
            self.apply_mode()
        else:
            raise NotImplementedError

    def set_pixel_mode(self, pivot, clip_pos, size, pixel_pos = (0, 0)):
        self._mode = [_pixel,
         pivot,
         clip_pos,
         size,
         pixel_pos]
        if self.component.parent:
