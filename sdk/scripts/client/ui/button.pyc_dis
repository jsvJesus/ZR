# Embedded file name: ./client/ui/button.py
import GUI
import BigWorld
import json
from panel import Panel
import Keys
import ResMgr
from text import Text, Align
from sounds_manager import playSound

class Button(Panel):

    def __init__(self, parent_comp, name, depth = 0.5, frame = False):
        component = None
        Panel.__init__(self, parent_comp, name, depth=depth, component=component)
        self.change_interseption(intercept_buttons=True, intercept_moving=True)
        self._hover = False
        self._down_trigger = False
        self._pressed = False
        self._text = None
        self._visual = None
        self._enabled = True
        self._image = None
        self._overidden_background_texture = None
        self._texture_cache = {}
        self.on_click = lambda : None
        self.on_down = lambda : None
        frame_comp = GUI.Frame2('') if frame else GUI.Window('')
        self._frame = Panel(self.component, 'frame', component=frame_comp, depth=1)
        self._frame.transform.set_clip_mode((0, 0, 1, 1))
        self.hover_sound = None
        return

    def set_visual(self, visual):
        self._visual = json.loads(ResMgr.openSection(visual).asBinary)
        self._update_visual()

    def set_enabled(self, enabled):
        if self._enabled == enabled:
            return
        self._enabled = enabled
        self._update_visual()

    def set_text(self, text):
        if not self._text:
            self._text = Text(self.component, 'text')
            self._text.transform.set_clip_mode((0, 0, 1, 1))
        self._text.set_text(text)
        if self._visual:
            self._update_visual()

    def set_font_unscalable(self):
        self._text.set_unscalable()

    def set_image(self, texture, filter_type = 'LINEAR', clip_pos = 0):
        if not self._image:
            self._image = Panel(self.component, 'image', depth=0)
            self._image.component.materialFX = 'BLEND'
            self._image.component.filterType = filter_type
            if texture not in self._texture_cache:
                self._texture_cache[texture] = BigWorld.PyTextureProvider(texture)
        texture = self._texture_cache[texture]
        self._image.component.texture = texture
        self._image.transform.set_pixel_mode((clip_pos, 0.5), (clip_pos, 0.5), (texture.width, texture.height))
        if self._visual:
            self._update_visual()

    def handleMouseButtonEvent(self, comp, event):
        if not self._enabled:
            return True
        self._pressed = event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown()
        self._update_visual()
        if event.key == Keys.KEY_LEFTMOUSE:
            if event.isKeyDown():
                self._down_trigger = True
                self.on_down()
            elif self._down_trigger:
                self._down_trigger = False
                self._on_click()
        return True

    def _on_click(self):
        self.on_click()

    def handleMouseEnterEvent(self, comp):
        Panel.handleMouseEnterEvent(self, comp)
        self._hover = True
        if self.hover_sound:
            playSound('ui/equip_modification/hover')
        self._pressed = False
        if self._enabled:
            self._update_visual()
        return True

    def handleMouseLeaveEvent(self, comp):
        Panel.handleMouseLeaveEvent(self, comp)
        self._down_trigger = False
        self._hover = False
        if self._enabled:
            self._update_visual()
        return True

    def override_background_texture(self, background_texture):
        self._overidden_background_texture = background_texture
        if self._visual:
            self._update_visual()

    def _update_visual(self):
        if not self._enabled:
            style = 'disabled'
        elif self._hover:
            if self._pressed:
                style = 'pressed'
            else:
                style = 'hover'
        else:
            style = 'normal'
        if not self._visual.get(style):
            style = self._visual['normal']
            frame = self.component.frame
            background = style.get('background')
            if background:
                if not self._overidden_background_texture:
                    texture = background.get('texture', 'textures/default/white.dds')
                    if texture not in self._texture_cache:
                        self._texture_cache[texture] = BigWorld.PyTextureProvider(texture)
                    frame.texture = self._texture_cache[texture]
                    colour = background.get('color')
                    if colour:
                        frame.colour = tuple(colour)
                    material = background.get('material')
                    if material:
                        frame.materialFX = str(material)
                    else:
                        frame.materialFX = 'BLEND'
                    mapping = background.get('mapping')
                    if mapping:
                        frame.mapping = tuple(map(tuple, mapping))
                font = style.get('font')
                if font and self._text:
                    colour = font.get('color')
                    if colour:
                        self._text.set_color(tuple(colour))
                    material = font.get('material')
                    if material:
                        self._text.component.text.materialFX = str(material)
                    else:
                        self._text.component.text.materialFX = 'BLEND'
                    size = font.get('size')
                    if size:
                        self._text.set_font(size)
                        self._text.on_size_changed()
                    align = font.get('align')
                    if align:
                        if align == 'RIGHT':
                            align = Align.Right
                        else:
                            align = Align.Left
                        self._text.set_alignment(align, Align.Center)
                image = style.get('image')
                colour = image and self._image and image.get('color')
                self._image.component.colour = colour and tuple(colour)

    @property
    def text(self):
        return self._text

    @property
    def image(self):
        return self._image