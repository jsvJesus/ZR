class RadiationSource:
    """ \xd0\xb8\xd1\x81\xd1\x82\xd0\xbe\xd1\x87\xd0\xbd\xd0\xb8\xd0\xba \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 """

    def __init__(self):
        pass

    def radiation_params(self):
        """
        \xd0\xbf\xd0\xb0\xd1\x80\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80\xd1\x8b \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8, \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82:
                - \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd1\x83\xd1\x81
                - \xd0\xb2\xd0\xbd\xd0\xb5\xd1\x88\xd0\xbd\xd0\xb8\xd0\xb9 \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd1\x83\xd1\x81
                - \xd0\xbc\xd0\xb0\xd0\xba\xd1\x81\xd0\xb8\xd0\xbc\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd1\x82\xd1\x8d\xd0\xba \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8
                - \xd0\xbc\xd0\xb8\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd1\x82\xd1\x8d\xd0\xba \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8
                - \xd1\x81\xd0\xb2\xd0\xbe\xd1\x8e \xd0\xba\xd0\xbe\xd0\xbe\xd1\x80\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x82\xd1\x83
        """
        return None


class Radiometer(GadgetDevice):
    """
    \xd0\xbf\xd1\x80\xd0\xb8\xd0\xb1\xd0\xbe\xd1\x80, \xd0\xbe\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8f\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd1\x83\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd0\xbd\xd1\x8c \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2 \xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xbc \xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8
    \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd1\x83\xd0\xbb \xd1\x80\xd0\xb0\xd1\x81\xd1\x81\xd1\x87\xd1\x91\xd1\x82\xd0\xb0 \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2 \xd1\x81\xd0\xbe\xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd1\x8e\xd1\x89\xd0\xb5\xd0\xbc \xd1\x82\xd0\xb8\xd0\xba\xd0\xb5\xd1\x82\xd0\xb5 (2279)
    """
    TRAP_RADIUS = 20.0
    MAX_BEEP_PERIOD = 5.02
    MIN_BEEP_PERIOD = 0.01
    HEIGHT_FACTOR = 0.5
    BEEP_RANDOM_FACTOR = 0.7757
    ANGLE_FACTOR = 0.6
    SPOIL_RADIATION = 4
    SPOIL_BEEP_FACTOR = 0.95
    MAX_HEAR_SQR_DIST = 36
    BEEP_FREQUENCY = 16.0
    SOUND_TO_BEEP = 'items/radiometer_bella/bella_bip'

    def __init__(self, parent):
        GadgetDevice.__init__(self, parent)
        self.SOUND_SWITCH_ON = 'items/radiometer_bella/bella_switch_on'
        self.SOUND_SWITCH_OFF = 'items/radiometer_bella/bella_switch_on'
        self._trap_id = None
        self._beep_callback_id = None
        self._imitate_callback_id = None
        self._radiators = []
        self._avatars = []
        self._radiation_level = 0
        self._direction = Vector3()
        self._debug_mode = False
        self._beep_period = None
        self._next_beep_time = None
        self._prev_beep_time = None
        self._radiation_accumulator = 0
        self._stop_imitate_timeout = 0
        return

    def onLeaveWorld(self):
        if self._trap_id and self._parent and not self._parent.isDestroyed:
            self._parent.delTrap(self._trap_id)
            self._trap_id = None
        GadgetDevice.onLeaveWorld(self)
        self._radiators = []
        self._avatars = []
        return

    def work_stop(self, item = None, play_sound = True):
        """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xba\xd1\x80\xd0\xb0\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd1\x81\xd0\xba\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 """
        GadgetDevice.work_stop(self, item, play_sound)
        if self._debug_mode:
            print 'Radiometer: turn off'
            self._clear_debug_data()
        if self._trap_id:
            self._parent.delTrap(self._trap_id)
            self._trap_id = None
        if self._beep_callback_id:
            BigWorld.cancelCallback(self._beep_callback_id)
            self._beep_callback_id = None
        return

    def imitate_working(self, beep_period):
        """
        \xd0\xb8\xd0\xbc\xd0\xb8\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd1\x8b \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xbe\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80\xd0\xb0, \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xbe\xd1\x81\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb8\xd1\x85 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0\xd1\x85
        \xd0\xb4\xd0\xbb\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f \xd0\xbe\xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb8 \xd0\xb7\xd0\xb0\xd1\x82\xd0\xba\xd0\xbd\xd1\x91\xd1\x82\xd1\x81\xd1\x8f, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xb2\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 \xd0\xbf\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe\xd1\x8f\xd0\xbd\xd0\xbd\xd0\xbe \xd1\x81 cell-\xd0\xb0
        
        """
        self._beep_period = beep_period
        self._stop_imitate_timeout = time.time() + self.SERVER_LOAD * self.TICK_TIME * 1.2
        if not self._imitate_callback_id:
            self._imitate_beep()

    def work_start(self, play_sound = True):
        """ \xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81\xd0\xba\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 """
        GadgetDevice.work_start(self, play_sound)
        if self._debug_mode:
            print 'Radiometer: turn on'
        self._trap_id = self._parent.addTrap(self.TRAP_RADIUS, self._on_trap)

    def _on_trap(self, entities_inside):
        self._radiators = filter(lambda entity: isinstance(entity, RadiationSource) and entity.radiation_params(), entities_inside)
        self._avatars = filter(lambda entity: entity.__class__.__name__ == 'Avatar', entities_inside)

    def _update_direction_vector(self):
        """ \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb5\xd0\xb5 \xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8f\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb3\xd0\xbe \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0 """
        matrix = Matrix(self._parent.matrix)
        self._direction.setPitchYaw(BigWorld.camera().direction.pitch, matrix.yaw)

    def _beep(self):
        """ \xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c \xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbd \xd1\x80\xd0\xb0\xd0\xb7 """
        if self._parent.worldLoadStatusCode:
            sounds.playSound(self.SOUND_TO_BEEP, self._parent.model)
        next_beep = random.randrange(self._beep_period * (1 - self.BEEP_RANDOM_FACTOR), self._beep_period * (1 + self.BEEP_RANDOM_FACTOR), int=float)
        self._prev_beep_time = time.time()
        self._next_beep_time = self._prev_beep_time + next_beep
        if self.is_working():
            self._beep_callback_id = BigWorld.callback(next_beep, self._beep)

    def _imitate_beep(self):
        """ \xd0\xb8\xd0\xbc\xd0\xb8\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd0\xbe\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbf\xd0\xb8\xd1\x81\xd0\xba, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xbb\xd1\x8b\xd1\x88\xd0\xb0\xd1\x82 \xd1\x81\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd1\x8b """
        if time.time() > self._stop_imitate_timeout:
            self._imitate_callback_id = None
            return
        elif self._parent.isDestroyed:
            return
        else:
            sounds.playSound(self.SOUND_TO_BEEP, self._parent.model)
            next_beep = random.randrange(self._beep_period * (1 - self.BEEP_RANDOM_FACTOR), self._beep_period * (1 + self.BEEP_RANDOM_FACTOR), int=float)
            self._imitate_callback_id = BigWorld.callback(next_beep, self._imitate_beep)
            return

    def _spoil_gadget(self):
        item = ItemsUtils.GetComplexItemByID(self._parent, self._item['complexItemID'])
        if not item:
            BWPersonality.gpd.sendHightMessage('\xd0\xa7\xd1\x82\xd0\xbe-\xd1\x82\xd0\xbe \xd0\xbf\xd0\xbe\xd1\x88\xd0\xbb\xd0\xbe \xd0\xbd\xd0\xb5 \xd1\x82\xd0\xb0\xd0\xba \xd1\x81 \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd1\x86\xd0\xb8\xd0\xb5\xd0\xb9')
            return False
        if self._radiation_accumulator >= self.SPOIL_RADIATION:
            spoil_amount = self._radiation_accumulator / self.SPOIL_RADIATION
            self._radiation_accumulator %= self.SPOIL_RADIATION
            self._parent.cell.BreakGadget(self._item['complexItemID'], spoil_amount)
        return True

    def _send_to_server(self):
        for avatar in self._avatars:
            if avatar.isDestroyed:
                continue
            if avatar.position.distSqrTo(self._parent.position) >= self.MAX_HEAR_SQR_DIST:
                continue
            avatar.cell.radiometer_beep(self._beep_period)

    def _tick(self):
        """ radiation measuring tick """
        GadgetDevice._tick(self)
        self._update_direction_vector()
        self._radiation_level = 0
        for radiator in self._radiators:
            if radiator.isDestroyed:
                continue
            self._radiation_level += self._calculate_factor(radiator)
            self._radiation_accumulator += self._radiation_level

        max_beep_period = self.MAX_BEEP_PERIOD * (1 - self.SPOIL_BEEP_FACTOR * (1 - ItemsUtils.GetItemConditionRatio(None, self._item)))
        if not self._radiation_level:
            self._beep_period = max_beep_period
        else:
            self._beep_period = max(self.MIN_BEEP_PERIOD, min(max_beep_period, 1.0 / (self._radiation_level * self.BEEP_FREQUENCY)))
        if not self._beep_callback_id and self.is_working():
            self._beep()
        suggest_next_beep = self._prev_beep_time + self._beep_period * (1 + self.BEEP_RANDOM_FACTOR)
        if suggest_next_beep < self._next_beep_time:
            BigWorld.cancelCallback(self._beep_callback_id)
            beep_time = max(0, suggest_next_beep - time.time())
            self._beep_callback_id = BigWorld.callback(beep_time, self._beep)
        if self._debug_mode:
            self._draw_result()
            self._draw_trap()
            self._draw_direction()
        return

    def _calculate_factor(self, radiator, _debug = False):
        """ \xd0\xb5\xd1\x89\xd1\x91 \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xb0 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd1\x83\xd0\xbb\xd0\xb0, \xd0\xbd\xd0\xb0 \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd1\x80\xd0\xb0\xd0\xb7 \xd0\xbe\xd1\x82 \xd0\x9f\xd0\xb0\xd1\x88\xd0\xb8 """
        parameters = radiator.radiation_params()
        radius = parameters[0]
        radius_out = parameters[1]
        max_stack = parameters[2]
        min_stack = parameters[3]
        position = parameters[4]
        direction = position - self._parent.position
        dist = direction.length
        direction.normalise()
        if dist <= radius:
            dist_factor = max_stack
        elif dist <= radius_out:
            dist_factor = (radius_out - dist) / (radius_out - radius) * (max_stack - min_stack) + min_stack
        else:
            dist_factor = min_stack / (dist - radius_out + 1) ** 2
        angle_cos_3D = self._direction.dot(direction)
        dir2D_1 = Vector2(self._direction.x, self._direction.z)
        dir2D_2 = Vector2(direction.x, direction.z)
        dir2D_1.normalise()
        dir2D_2.normalise()
        angle_cos_2D = dir2D_1.dot(dir2D_2)
        angle_cos = angle_cos_3D * self.HEIGHT_FACTOR + angle_cos_2D * (1 - self.HEIGHT_FACTOR)
        k = self.ANGLE_FACTOR + 0.5 * (1 - self.ANGLE_FACTOR) * (1 + angle_cos)
        factor_result = k * dist_factor ** 0.5
        if not _debug:
            return factor_result
        else:
            return (factor_result, [angle_cos, k, dist_factor ** 0.5])

    def _calculate_factor_modified(self, radiator):
        """ (\xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x84\xd1\x86\xd1\x86\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xb0\xd1\x8f \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd1\x83\xd0\xbb\xd0\xb0) \xd0\xb2\xd1\x8b\xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xbd\xd1\x82\xd0\xb5\xd0\xbd\xd1\x81\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xbf\xd1\x80\xd0\xb8\xd0\xb1\xd0\xbe\xd1\x80\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd1\x81\xd1\x82\xd0\xbe\xd1\x87\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0 \xd1\x81 \xd1\x83\xd1\x87\xd1\x91\xd1\x82\xd0\xbe\xd0\xbc \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd1\x84\xd0\xb0\xd0\xba\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb2 """
        parameters = radiator.radiation_params()
        max_stack = parameters[2]
        position = parameters[4]
        direction = position - self._parent.position
        dist = direction.length
        direction.normalise()
        angle_cos = self._direction.dot(direction)
        k = self.ANGLE_FACTOR + 0.5 * (1 - self.ANGLE_FACTOR) * (1 + angle_cos)
        return k * max_stack / (dist + 1) ** 2

    def _calculate_factor_original(self, radiator):
        """ (\xd0\xbe\xd1\x80\xd0\xb8\xd0\xb3\xd0\xb8\xd0\xbd\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xb0\xd1\x8f \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd1\x83\xd0\xbb\xd0\xb0) \xd0\xb2\xd1\x8b\xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xbd\xd1\x82\xd0\xb5\xd0\xbd\xd1\x81\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xbf\xd1\x80\xd0\xb8\xd0\xb1\xd0\xbe\xd1\x80\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd1\x81\xd1\x82\xd0\xbe\xd1\x87\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0 \xd1\x81 \xd1\x83\xd1\x87\xd1\x91\xd1\x82\xd0\xbe\xd0\xbc \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd1\x84\xd0\xb0\xd0\xba\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb2 """
        parameters = radiator.radiation_params()
        max_stack = parameters[2]
        position = parameters[4]
        direction = position - self._parent.position
        dist = direction.length
        direction.normalise()
        angle_cos = max(self._direction.dot(direction), 0)
        k = (angle_cos + self.ANGLE_FACTOR) / (1 + self.ANGLE_FACTOR)
        return k * max_stack * (self.TRAP_RADIUS - dist) ** 2

    def debug(self, debug_mode = True, simple_mode = False):
        """ \xd0\xb2\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c (\xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c) \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd0\xb8 """
        self._debug_mode = debug_mode
        self._draw_result = self._draw_result_simple if simple_mode else self._draw_debug_result
        if not debug_mode:
            self._clear_debug_data()

    def _draw_trap(self):
        """ draw trap sphere """
        import DrawPrimitivesUtils
        DrawPrimitivesUtils.clear_drawings()
        DrawPrimitivesUtils.draw_sphere(self._parent.position, self.TRAP_RADIUS)

    def _draw_direction(self):
        """ draw line at the model direction """
        direction = self._direction.scale(self.TRAP_RADIUS)
        height_disp = (0, 1.5, 0)
        BigWorld.getGeometricInstance().addLine(self._parent.position + height_disp, self._parent.position + direction + height_disp, (1, 0, 0, 1), True)

    def _draw_result_simple(self):
        """ \xd0\xb2\xd1\x8b\xd0\xb2\xd0\xbe\xd0\xb4 \xd1\x80\xd0\xb5\xd0\xb7\xd1\x83\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb0\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xbd\xd0\xb0 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd (\xd0\xbd\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xb0\xd1\x8f \xd1\x87\xd0\xb5\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x87\xd0\xb5\xd1\x81\xd0\xba\xd0\xb0\xd1\x8f \xd0\xb2\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd1\x80\xd0\xb5\xd0\xb7\xd1\x83\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb0\xd1\x82\xd0\xbe\xd0\xb2) """
        from gui_const import OBJECTIVE_TRACKER
        import BWPersonality
        SAFE_TIMER_TRACKER_ID = 'RADIOMETER_DEBUG'
        caption = u'radiation level:'
        text = '{0:.6f}'.format(self._radiation_level)
        safe_data = {'caption': caption}
        safe_data['track_data'] = [{'data_type': OBJECTIVE_TRACKER.DATATYPE_PLAINTEXT,
          'data': text}]

    def _draw_debug_result(self):
        """ \xd0\xb2\xd1\x8b\xd0\xb2\xd0\xbe\xd0\xb4 \xd1\x80\xd0\xb5\xd0\xb7\xd1\x83\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb0\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xbd\xd0\xb0 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd (\xd1\x80\xd0\xb0\xd1\x81\xd1\x88\xd0\xb8\xd1\x80\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xb0\xd1\x8f)"""
        from gui_const import OBJECTIVE_TRACKER
        import BWPersonality
        SAFE_TIMER_TRACKER_ID = ['RADIOMETER_DEBUG_RAD', 'RADIOMETER_DEBUG_BIP', 'RADIOMETER_DEBUG_SRC']
        text_radiation_level = {'caption': 'radiation level:',
         'track_data': [{'data_type': OBJECTIVE_TRACKER.DATATYPE_PLAINTEXT,
                         'data': '{0:.6f}'.format(self._radiation_level)}]}
        max_beep_period = self.MAX_BEEP_PERIOD * (1 - self.SPOIL_BEEP_FACTOR * (1 - ItemsUtils.GetItemConditionRatio(None, self._item)))
        text_bips = {'caption': 'audio bips:',
         'track_data': [{'data_type': OBJECTIVE_TRACKER.DATATYPE_PLAINTEXT,
                         'data': '{0:.1f} bip/s, (min, max: [{1:.1f}, {2:.1f}])'.format(1.0 / self._beep_period, 1.0 / max_beep_period, 1.0 / self.MIN_BEEP_PERIOD)}]}
        text_sources = []
        for e, radiator in enumerate((r for r in self._radiators if not r.isDestroyed)):
            f, params = self._calculate_factor(radiator, _debug=True)
            text_sources.append('  f_{0}={1:.6f}: cos_{0}={2:.3f}, k_{0}={3:.3f}, dist_factor_{0}={4:.3f}'.format(e, f, *params))

        text_sources_level = {'caption': 'radiation sources:',
         'track_data': [ {'data_type': OBJECTIVE_TRACKER.DATATYPE_PLAINTEXT,
                        'data': t} for t in text_sources ]}
        return

    def _clear_debug_data(self):
        """ clear debug data of the screen """
        import DrawPrimitivesUtils
        DrawPrimitivesUtils.clear_drawings()
        import BWPersonality
        SAFE_TIMER_TRACKER_ID = 'RADIOMETER_DEBUG'