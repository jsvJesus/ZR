# Embedded file name: ./client/TNTWire.py
import json
import ResMgr
import BigWorld
import Constants
from Localization import lc
from Helpers.Caps import CAP_INTERACT
section = ResMgr.openSection('scripts/common/EnumProps/TNTTrigger.json')
CONFIG = json.loads(section.asBinary)['model_index']['values']

class TNTWire(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._model_path = next((model for index, model in CONFIG if index == self.model_index), None)
        self.model = None
        self.callback_id = None
        self.targetCaps = []
        self.name = lc('TriggerNames.TriggerObject.tnt_wire')
        self.parent = None
        return

    def set_parent(self, parent):
        self.parent = parent

    def set_active(self, value):
        self.active = value
        self.change_caps()
        if not self.model:
            return
        self.model.isObstacle = self.active
        try:
            setattr(self.model, self.model_dye, self.tint_full if self.active else self.tint_none)
        except Exception as e:
            print 'ERROR:TNTWire model{0}, dye:{1}, tints:{2}'.format(self.model.sources, self.model_dye, (self.tint_full, self.tint_none))
            raise e

    def change_caps(self):
        if self.visible and not self.active:
            self.targetCaps = [CAP_INTERACT]
        else:
            self.targetCaps = []

    def set_visible(self, value):
        self.visible = value
        self.change_caps()
        if not self.model:
            return

    def interact(self, player):
        self.parent.on_wire_use(self)

    def prerequisites(self):
        if self._model_path:
            return [self._model_path]
        return []

    def onEnterWorld(self, prereqs):
        if not self._model_path:
            return
        scale = self.scale
        self.model = prereqs[self._model_path]
        self.model.scale = (scale, scale, scale)
        self.model.newScaleTest = (scale, scale, scale)
        self.set_active(self.active)
        self.set_visible(self.visible)

    def setObstacle(self, value):
        self.isObstacle = value
        if self.model:
            self.model.isObstacle = value
            self.model.visible = value

    def onLeaveWorld(self):
        self.model = None
        return

    def get_interaction_dist(self):
        if not self.targetCaps:
            return 0
        return Constants.INTERACTION_DISTANCE ** 2

    def get_hightlight(self, distance):
        if not self.targetCaps or distance > 15:
            return None
        else:
            return True

    def start_destroy(self):
        BigWorld.callback(0, lambda : BigWorld.destroyEntity(self.id))