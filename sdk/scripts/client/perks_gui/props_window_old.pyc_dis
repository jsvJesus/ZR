from achivments import achives_parser

class PropsWindowOld(Panel):

    def __init__(self, component, name, depth = 0.5):
        Panel.__init__(self, component, name, depth=depth)
        self._node = None
        self._cur_buy_node = None
        chars_y = 0.6
        component = GUI.Simple('soGUI/frame/perks/props_back.dds')
        frame = Panel(self.component, 'frame', depth=1.0, component=component)
        component.materialFX = 'BLEND'
        frame.transform.set_clip_mode((0, 0, 1, 1))
        dev_component = Panel(self.component, 'devcomp', depth=0.9)
        dev_component.transform.set_clip_mode((0, 0, 1, 1))
        main_component = Panel(self.component, 'main', depth=0.9)
        main_component.transform.set_clip_mode((0, 0, 1, 1))
        info_panel = Panel(self.component.main, 'info', depth=1)
        info_panel.transform.set_clip_mode((0, 0, 1, 1))
        info_panel.component.visible = False
        self._info_comp = info_panel.component
        description = u'\u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f:\n-\u0422\u0430\u0441\u043a\u0430\u0435\u043c \u043b\u0435\u0432\u043e\u0439 \u043a\u043e\u043d\u043e\u043f\u043a\u043e\u0439\n-\u0418\u043d\u0432\u0435\u0440\u0442\u0438\u0440\u0443\u0435\u043c \u0441\u0432\u044f\u0437\u0438 \u043f\u0440\u0430\u0432\u043e\u0439 \u043a\u043d\u043e\u043f\u043a\u043e\u0439\n-\u041a\u043e\u043f\u0438\u0440\u0443\u0435\u043c \u0438 \u0432\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u0440\u0430\u0434\u0438\u0443\u0441 \u0441 Ctrl\n-\u041a\u043e\u043f\u0438\u0440\u0443\u0435\u043c \u0438 \u0432\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u0443\u0433\u043e\u043b \u0441 Shift\n-\u041e\u0442\u043c\u0435\u043d\u044f\u0435\u043c Ctrl+Z'
        t = Text(self.component.devcomp, 'desc', 18, text=description)
        t.set_alignment(Align.Left, Align.Top)
        t.set_color(CC.inactive_rgba)
        clip_anchors = (0, 0, 1, 1)
        pixel_anchors = (16, 8, 0, 0)
        t.transform.set_clip_mode(clip_anchors, pixel_anchors)
        button = Button(self.component.devcomp, 'load_button', frame=True)
        button.set_text(u'\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0438\u0437 \u0444\u0430\u0439\u043b\u0430')
        button.set_visual('soGUI/frame/buttons/classicbutton.json')
        x_params = clip_params((0, 1), (8, -8))
        y_params = pixel_params(0.5, 0.2, 30)
        button.transform.set_mixed_mode(x_params, y_params)
        button.on_click = lambda : self.on_load_callback()
        button = Button(self.component.devcomp, 'save_button', frame=True)
        button.set_text(u'\u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0432 \u0444\u0430\u0439\u043b')
        button.set_visual('soGUI/frame/buttons/classicbutton.json')
        x_params = clip_params((0, 1), (8, -8))
        y_params = pixel_params(0.5, 0.25, 30)
        button.transform.set_mixed_mode(x_params, y_params)
        button.on_click = lambda : self.on_save_callback()
        clip_mode = (0.05, 0, 0.95, 0)
        self._cap_title = Panel(self._info_comp, 'captitle')
        self._cap_title.transform.set_clip_mode((0, 0, 1, 0))
        cap_frame = GUI.Frame2('soGUI/frame/perks/pixel_frame.dds')
        p = Panel(self._cap_title.component, 'frame', component=cap_frame)
        p.transform.set_clip_mode((0, 0, 1, 1))
        self._cap_text = WrappedText(self._info_comp.captitle, 'caption', size=18)
        self._cap_text.transform.set_clip_mode(clip_mode)
        self._info_text = WrappedText(self._info_comp, 'infodatalabel', size=16, align=Align.Left)
        self._info_text.set_line_space(32)
        self._info_text.transform.set_clip_mode(clip_mode)
        self._achs_text = WrappedText(self._info_comp, 'achivs', size=16, align=Align.Left)
        self._achs_text.transform.set_clip_mode(clip_mode)
        self._desc_text = WrappedText(self._info_comp, 'desc', size=16, align=Align.Left)
        self._desc_text.transform.set_clip_mode(clip_mode)
        self._buy_button = Button(self._info_comp, 'takebutton', frame=True)
        self._buy_button.set_text(lc('Perks.ui.props.buy_button'))
        self._buy_button.set_visual('soGUI/frame/buttons/classicbutton.json')
        pivot = (0.5, 1)
        clip_pos = (0.5, chars_y - 0.04)
        size = (160, 36)
        self._buy_button.transform.set_pixel_mode(pivot, clip_pos, size)
        self._buy_button.on_click = self._on_buy_click
        ch_title = Panel(self.component.main, 'chartitle')
        x_params = clip_params((0, 1))
        y_params = pixel_params(0.5, chars_y, 0)
        ch_title.transform.set_mixed_mode(x_params, y_params)
        ch_frame = GUI.Frame2('soGUI/frame/perks/pixel_frame.dds')
        p = Panel(ch_title.component, 'frame', component=ch_frame)
        p.transform.set_clip_mode((0, 0, 1, 1))
        t = Text(ch_title.component, 'text', text=lc('Perks.ui.props.chars'))
        t.set_color(CC.active_rgba)
        t.transform.set_clip_mode((0, 0, 1, 1))
        text_height = t.calc_ratio_text_height()
        y_params = pixel_params(0.5, chars_y, text_height + 8)
        ch_title.transform.set_mixed_mode(x_params, y_params)
        chars_width = 30
        self._chars = CharsPanel(self.component.main, 'chars')
        self._chars.transform.set_clip_mode((0,
         chars_y,
         1,
         1), (0,
         chars_width / 2,
         0,
         0))
        self.on_load_callback = lambda : None
        self.on_save_callback = lambda : None
        self.on_perk_take_callback = lambda node, callback: None
        return

    def _on_buy_click(self):

        def callback():
            self._cur_buy_node = None
            BigWorld.callback(0, self._update_content)
            return

        sm.playSound('ui/perks/upgrade')
        self.on_perk_take_callback(self._node, callback)
        self._cur_buy_node = self._node.id
        self._update_content()

    def on_show(self, get_free_perks_foo):
        self._get_free_perks_foo = get_free_perks_foo
        self._update_content()

    def on_perks_updated(self):
        self._update_content()

    def on_exp_updated(self):
        self._update_content()

    def set_node(self, node):
        self._node = node
        self._update_content()

    def _update_content(self):
        if not self._node:
            self._info_comp.visible = False
            return
        self._info_comp.visible = True

        def buy_avaiable():
            if self._node.cost is None:
                return False
            elif self._node.condition != Condition.Enabled:
                return False
            elif self._cur_buy_node:
                return False
            elif self._get_free_perks_foo() < self._node.cost:
                return False
            else:
                return True

        self._buy_button.set_enabled(buy_avaiable())
        cpx = clip_params((0.05, 0.95))
        space = 16
        category = lc('Perks.branch.b{0}'.format(self._node.branch))
        text = u'{inactive}{cat}: {active}{0}\n{inactive}{lev}: {active}{1}\n{inactive}{cost}: {active}{2}'.format(category, self._node.level, self._node.cost, inactive=CC.inactive_hex, active=CC.active_hex, cat=lc('Perks.ui.props.category'), lev=lc('Perks.ui.props.level'), cost=lc('Perks.ui.props.cost'))
        self._cap_text.set_text(self._node.name)
        text_height = self._cap_text.ratio_wrapped_height
        x_params = clip_params((0, 1))
        y_params = pixel_params(0.5, 0.5, text_height)
        self._cap_text.transform.set_mixed_mode(x_params, y_params)
        cpy = pixel_params(0, 0, text_height)
        x_params = clip_params((0, 1))
        y_params = pixel_params(0, 0, text_height + 8)
        self._cap_title.transform.set_mixed_mode(x_params, y_params)
        height = self._cap_title.transform.ratio_height + space
        self._info_text.set_text(text)
        text_height = self._info_text.ratio_wrapped_height
        cpy = pixel_params(0, 0, text_height, pixel_pos=height)
        self._info_text.transform.set_mixed_mode(cpx, cpy)
        height += text_height + space
        self._achs_text.component.visible = bool(self._node.achivs)
        if self._node.achivs:
            text = u'{inactive}{t0}: {active}'.format(t0=lc('Perks.ui.props.extraconditions'), inactive=CC.inactive_hex, active=CC.active_hex)
            for ach_id in self._node.achivs:
                desc = achives_parser.get_achiv(ach_id)['description']
                text += u'{0} "{1}",'.format(lc('Perks.ui.props.achivment'), desc)

            text = text[:-1]
            self._achs_text.set_text(text)
            text_height = self._achs_text.ratio_wrapped_height
            cpy = pixel_params(0, 0, text_height, pixel_pos=height)
            self._achs_text.transform.set_mixed_mode(cpx, cpy)
            height += text_height + space
        self._desc_text.set_text(self._node.description)
        text_height = self._desc_text.ratio_wrapped_height
        cpy = pixel_params(0, 0, text_height, pixel_pos=height)
        self._desc_text.transform.set_mixed_mode(cpx, cpy)
        ignore_local_actions = self._node.id == self._cur_buy_node
        self._chars.set_node(self._node, ignore_local_actions)

    def set_dev_mode(self, mode):
        self.component.devcomp.visible = mode
        self.component.main.visible = not mode

    def on_size_changed(self):
        self._update_content()