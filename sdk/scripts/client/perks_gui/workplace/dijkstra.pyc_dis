# Embedded file name: ./client/perks_gui/workplace/dijkstra.py
from perks_system import perks_parser
from collections import defaultdict

class Graph:

    def __init__(self, nodes, edges):
        self._children = defaultdict(list)
        self._parents = defaultdict(list)
        for e in edges:
            self._children[e.node0].append(e.node1)
            self._parents[e.node1].append(e.node0)
            if e.twoway:
                self._children[e.node1].append(e.node0)
                self._parents[e.node0].append(e.node1)

        node_by_pid = {}
        for n in nodes:
            node_by_pid[n.alias] = n

    def get_all_valid_parents(self, node_id, validator):
        return filter(validator, self._parents[node_id])

    def get_all_valid_children(self, node_id, validator):
        return filter(validator, self._children[node_id])

    def are_all_parents_valid(self, node_id, validator):
        return all(map(validator, self._parents[node_id]))

    def get_zone_outer_border(self, start_id, validator):
        """ validator(node_id) - \xd0\xb4\xd0\xbe\xd1\x88\xd1\x91\xd0\xbb \xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xbe\xd0\xb4 \xd0\xb4\xd0\xbe \xd0\xbd\xd0\xb0\xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f """
        checked = set()
        frontier = set([start_id])
        next_frontier = set()
        result = set()
        while frontier:
            for node_id in frontier:
                for child_id in self._children.get(node_id, []):
                    if child_id in checked:
                        continue
                    if child_id in frontier:
                        continue
                    if validator(child_id):
                        next_frontier.add(child_id)
                    else:
                        result.add(child_id)

            checked |= frontier
            frontier = next_frontier
            next_frontier = set()

        return result