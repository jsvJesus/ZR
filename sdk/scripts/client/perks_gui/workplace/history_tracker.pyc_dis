# Embedded file name: ./client/perks_gui/workplace/history_tracker.py


class HistoryTracker:

    def __init__(self, nodes, edges):
        for n in nodes:
            n.add_node_start_change_callback(self._before_element_changed)

        for e in edges:
            e.add_edge_start_change_callback(self._before_element_changed)

        self._history = []
        self._restoring = False

    def _before_element_changed(self, element):
        if not self._restoring:
            self._history.append((element, element.get_state()))

    def pop_change(self):
        if not self._history:
            return
        element, state = self._history.pop()
        self._restoring = True
        element.restore_state(state)
        self._restoring = False