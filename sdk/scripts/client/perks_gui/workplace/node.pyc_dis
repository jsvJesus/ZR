_condition_params = {Condition.Dev: {'base_color': node_colors['dev'],
                 'hover_color': node_colors['dev'],
                 'border_color': border_colors['dev'],
                 'icon_color': icon_colors['dev'],
                 'galo': False},
 Condition.Disabled: {'base_color': node_colors['disabled'],
