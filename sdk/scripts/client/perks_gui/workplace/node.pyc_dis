_sizes_params = {PV.Original: node_sizes['original'],
 PV.Epic: node_sizes['epic'],
 PV.Base: node_sizes['base'],
 PV.Key: node_sizes['key'],
 PV.Normal: node_sizes['normal'],
 PV.Hidden: node_sizes['hidden']}
node_colors = visuals['node_colors']
