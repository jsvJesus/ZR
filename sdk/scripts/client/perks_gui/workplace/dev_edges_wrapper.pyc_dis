# Embedded file name: ./client/perks_gui/workplace/dev_edges_wrapper.py
import GUI
from edge import Edge
import Keys

class DevEdgesWrapper(object):

    def __init__(self, parent_comp, edges_data, nodes):
        line_width = 0.005
        base_color = (0.5, 0.5, 1, 0.5)
        fill_color = (1.0, 0.5, 0.5, 1)
        gl = GUI.LineComponent()
        gl.horizontalPositionMode, gl.verticalPositionMode = ('CLIP', 'CLIP')
        gl.horizontalAnchor, gl.verticalAnchor = ('CENTER', 'CENTER')
        gl.widthMode, gl.heightMode = ('CLIP', 'CLIP')
        gl.width, gl.height = (2, -2)
        gl.position = (0, 0, 1.0)
        gl.baseColor = base_color
        gl.fillColor = fill_color
        gl.curveWidth = (line_width, line_width, line_width)
        self._gl = gl
        parent_comp.addChild(gl, 'dlines')
        gc = GUI.CurveComponent()
        gc.horizontalPositionMode, gc.verticalPositionMode = ('CLIP', 'CLIP')
        gc.horizontalAnchor, gc.verticalAnchor = ('CENTER', 'CENTER')
        gc.widthMode, gc.heightMode = ('CLIP', 'CLIP')
        gc.width, gc.height = (2, -2)
        gc.baseColor = base_color
        gc.fillColor = fill_color
        gc.curveWidth = (line_width, line_width, line_width)
        gc.position = (0, 0, 0.9)
        self._gc = gc
        parent_comp.addChild(gc, 'dcurves')
        self._edges = []
        for edge in edges_data:
            e = Edge(edge, parent_comp, nodes[edge['node0']], nodes[edge['node1']])
            e.on_shapes_updated_callback = self._update_single_shape_from_edge
            self._edges.append(e)

        self.mouse_button_interseptor = lambda edge, part, event: False
        self._update_all_shapes_from_edges()

    def handleMouseButtonEvent(self, component, event):
        if event.key in (Keys.KEY_LEFTMOUSE, Keys.KEY_RIGHTMOUSE) and event.isKeyDown():
            for edge in self._edges:
                selected_part = edge.get_selected_part()
                if selected_part:
                    if event.key == Keys.KEY_LEFTMOUSE:
                        if self.mouse_button_interseptor(edge, selected_part, event):
                            return True
                        edge.start_drag()
                    elif event.key == Keys.KEY_RIGHTMOUSE:
                        edge.invert()
                    return True

        return False

    def set_visible(self, visible):
        self._gl.visible = visible
        self._gc.visible = visible

    def get_edge_by_nodes(self, node0_id, node1_id):
        for edge in self._edges:
            if edge.node0 == node0_id and edge.node1 == node1_id or edge.node0 == node1_id and edge.node1 == node0_id:
                return edge

    def _update_all_shapes_from_edges(self):
        lshapes = []
        cshapes = []
        a_lshapes = []
        a_cshapes = []
        for e in self._edges:
            lshapes.extend(e.lshapes)
            cshapes.extend(e.cshapes)
            a_lshapes.extend(e.a_lshapes)
            a_cshapes.extend(e.a_cshapes)

        gl = self._gl
        gl.setShapes(lshapes)
        gl.setShapeActives(a_lshapes)
        gc = self._gc
        gc.setShapes(cshapes)
        gc.setShapeActives(a_cshapes)
        self._dirty = True

    def mark_undirty(self):
        self._dirty = False

    def _update_single_shape_from_edge(self, edge):
        self._update_all_shapes_from_edges()

    @property
    def edges(self):
        return self._edges

    @property
    def dirty(self):
        return self._dirty