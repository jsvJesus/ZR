# Embedded file name: ./client/perks_gui/workplace/base_circle.py
import BigWorld
from functools import partial
import math
from Math import Vector2
import GUI
from visuals import visuals
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
import math_bw

class BaseCircle(object):
    """ \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd1\x83\xd0\xb6\xd0\xb5 \xd0\xbd\xd0\xb5 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xb5\xd0\xbd \xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f, \xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd1\x81\xd1\x82\xd0\xbe\xd1\x80\xd0\xb8\xd0\xb8
    """

    def __init__(self, node, parent_comp):
        base_color = visuals['line_colors']['base']
        fill_color = visuals['line_colors']['fill']
        min_size_in_pixels = visuals['line_sizes']['min_pixel']
        line_width_base = visuals['line_sizes']['base']
        line_width_galo = visuals['line_sizes']['galo']
        gc = GUI.CurveComponent()
        gc.horizontalPositionMode, gc.verticalPositionMode = ('CLIP', 'CLIP')
        gc.horizontalAnchor, gc.verticalAnchor = ('CENTER', 'CENTER')
        gc.widthMode, gc.heightMode = ('CLIP', 'CLIP')
        gc.width, gc.height = (2, -2)
        gc.baseColor = base_color
        gc.fillColor = fill_color
        gc.curveWidth = (line_width_base, 0, line_width_galo)
        gc.minCurveSizeInPixels = min_size_in_pixels
        gc.position = (0, 0, 0.9)
        parent_comp.addChild(gc, 'base_circle')
        distance = Vector2(node.pos).length
        angle = math.atan2(node.pos[1], node.pos[0])
        gc.setShapes([((angle, angle + math.pi * 0.99), distance), ((angle, angle - math.pi * 0.99), distance)])
        self._gc = gc
        self.filled = False
        self._animation_coroutine = None
        self._update_after_anmiation = None
        return

    def animate_fill(self, delay, animation_time):
        if self._animation_coroutine:
            self._animation_coroutine.stop()
        self._animation_coroutine = self._animation_coroutine_runner(delay, animation_time)
        self._animation_coroutine.run()

    @BWMemberCoroutine
    def _animation_coroutine_runner(self, delay, animation_time):
        yield BWWaitForPeriod(delay)
        start_time = BigWorld.time()
        while BigWorld.time() < start_time + animation_time:
            ratio = math_bw.clamp((BigWorld.time() - start_time) / animation_time)
            self._gc.setShapeActives([(0, ratio), (0, ratio)])
            yield BWWaitForPeriod(0)

        if self._update_after_anmiation:
            self._update_after_anmiation()
            self._update_after_anmiation = None
        self._animation_coroutine = None
        return

    def update_visual(self, filled):
        if self._animation_coroutine:
            self._update_after_anmiation = partial(self.update_visual, filled)
            return
        self.filled = filled
        value = int(filled)
        self._gc.setShapeActives([(0, value), (0, value)])