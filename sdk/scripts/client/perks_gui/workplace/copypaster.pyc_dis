# Embedded file name: ./client/perks_gui/workplace/copypaster.py
import Keys

class Copypaster:

    def __init__(self):
        self._selected = None
        self._last_select_modifier = None
        self.reset()
        return

    def element_clicked(self, element, part, modifier):
        if self._selected:
            if self._selected['element'] != element:
                if self._last_select_modifier == Keys.MODIFIER_CTRL:
                    radius = self._selected['element'].get_radius(self._selected['part'])
                    if radius is not None:
                        element.paste_radius(radius, part)
                elif self._last_select_modifier == Keys.MODIFIER_SHIFT:
                    angle = self._selected['element'].get_angle(self._selected['part'])
                    if angle is not None:
                        element.paste_angle(angle, part)
        else:
            self._last_select_modifier = modifier
            self._select(element, part)
        return

    def reset(self):
        self._select(None)
        return

    def _select(self, element, part = None):
        if self._selected:
            self._selected['element'].set_selected(False, self._selected['part'])
        self._selected = {'element': element,
         'part': part} if element else None
        if self._selected:
            self._selected['element'].set_selected(True, self._selected['part'])
        return