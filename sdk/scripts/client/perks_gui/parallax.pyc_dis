# Embedded file name: ./client/perks_gui/parallax.py
import BigWorld
import BWPersonality
from ui.panel import Panel
from Helpers.PyGUI import Utils
import math_bw

class Parallax(Panel):

    def __init__(self, parent_component, name, depth = 0.5):
        Panel.__init__(self, parent_component, name, depth=depth)
        self._back0 = Panel(self.component, 'back0', depth=1)
        self._back0.component.textureName = 'soGUI/frame/perks/background.dds'
        self._back0.transform.set_base_resolution(None)
        self._back0.transform.set_clip_mode((0, 0, 1, 1))
        self._back1 = Panel(self.component, 'back1', depth=0.8)
        self._back1.component.textureName = 'soGUI/frame/perks/parallax1.dds'
        self._back1.component.materialFX = 'BLEND'
        self._back1.component.tiled = True
        self._back1.transform.set_base_resolution(None)
        self._back1.transform.set_clip_mode((0, 0, 1, 1))
        self._back2 = Panel(self.component, 'back2', depth=0.8)
        self._back2.component.textureName = 'soGUI/frame/perks/parallax2.dds'
        self._back2.component.materialFX = 'BLEND'
        self._back2.component.tiled = True
        self._back2.transform.set_base_resolution(None)
        self._back2.transform.set_clip_mode((0, 0, 1, 1))
        self._back3 = Panel(self.component, 'back3', depth=0.8)
        self._back3.component.textureName = 'soGUI/frame/perks/parallax3.dds'
        self._back3.component.materialFX = 'BLEND'
        self._back3.component.tiled = True
        self._back3.transform.set_base_resolution(None)
        self._back3.transform.set_clip_mode((0, 0, 1, 1))
        self._tick_handler = None
        self._transform_data = {}
        return

    def on_size_changed(self):
        Panel.on_size_changed(self)
        pivot = (0.5, 0.5)
        clip_pos = (0.5, 0.5)
        screen_width, screen_height = BigWorld.screenSize()

        def prepare_panel(panel, parallax_value):
            texture_width, texture_height = panel.component.texture.width, panel.component.texture.height
            horizontal_margin = screen_width * parallax_value
            vertical_margin = screen_height * parallax_value
            target_texture_width = screen_width + horizontal_margin * 2
            target_texture_height = screen_height + vertical_margin * 2
            scale = max(float(target_texture_width) / texture_width, float(target_texture_height) / texture_height)
            size = (texture_width * scale, texture_height * scale)
            self._transform_data[panel] = {'pivot': pivot,
             'clip_pos': clip_pos,
             'size': size,
             'horizontal_margin': horizontal_margin,
             'vertical_margin': vertical_margin}

        prepare_panel(self._back0, 0.005)
        prepare_panel(self._back1, 0.01)
        size = self._transform_data[self._back1]['size']
        self._back1.component.tileWidth = size[0] * 0.5
        self._back1.component.tileHeight = size[1] * 0.5
        prepare_panel(self._back2, 0.015)
        size = self._transform_data[self._back2]['size']
        self._back2.component.tileWidth = size[0] * 0.5
        self._back2.component.tileHeight = size[1] * 0.5
        prepare_panel(self._back3, 0.02)
        size = self._transform_data[self._back3]['size']
        self._back3.component.tileWidth = size[0] * 0.5
        self._back3.component.tileHeight = size[1] * 0.5
        self._apply_parallax()

    def _tick(self):
        if not Utils.is_visible_in_hierarchy(self.component):
            return
        self._apply_parallax()
        self._tick_handler = BigWorld.callback(0, self._tick)

    def _apply_parallax(self):
        x, y = BWPersonality.game.mcursor.position
        x, y = -math_bw.clamp(x, -1, 1), math_bw.clamp(y, -1, 1)

        def apply_panel(panel):
            data = self._transform_data[panel]
            pivot, clip_pos, size, horizontal_margin, vertical_margin = (data['pivot'],
             data['clip_pos'],
             data['size'],
             data['horizontal_margin'],
             data['vertical_margin'])
            pixel_pos = (horizontal_margin * x, vertical_margin * y)
            panel.transform.set_pixel_mode(pivot, clip_pos, size, pixel_pos=pixel_pos)

        apply_panel(self._back0)
        apply_panel(self._back1)
        apply_panel(self._back2)
        apply_panel(self._back3)

    def on_show(self):
        if self._tick_handler:
            BigWorld.cancelCallback(self._tick_handler)
            self._tick_handler = None
        self._tick_handler = BigWorld.callback(0, self._tick)
        self._apply_parallax()
        return

    def on_hide(self):
        if self._tick_handler:
            BigWorld.cancelCallback(self._tick_handler)
            self._tick_handler = None
        return