# Embedded file name: ./client/perks_gui/chars_panel_old.py
import BigWorld
import colorCodes as cc
from ui.panel import Panel
from ui.text import Text, Align
from ui.transform import pixel_params, clip_params
from perks_system import perks_parser
from workplace.node import Condition
import player_speed_settings
_health, _regen, _stamina, _stamina_regen, _speed, _maxweight = xrange(6)
_char_data = [(_health, u'\u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435:'),
 (_regen, u'\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f:'),
 (_stamina, u'\u0412\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c:'),
 (_stamina_regen, u'\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u0438:'),
 (_speed, u'\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0431\u0435\u0433\u0430:'),
 (_maxweight, u'\u0413\u0440\u0443\u0437\u043e\u043f\u043e\u0434\u044a\u0451\u043c\u043d\u043e\u0441\u0442\u044c:')]

class CharsPanelOld(Panel):

    def __init__(self, parent_comp, name):
        Panel.__init__(self, parent_comp, name)
        self._node = None
        self._char_comps = {}
        top = 16
        step = 32
        height = 32
        for i, (char_id, l) in enumerate(_char_data):
            t = Text(self.component, 'line' + str(i), size=16, text=l)
            t.set_color(cc.inactive_rgba)
            t.set_alignment(Align.Left, Align.Center)
            cpx = clip_params((0.05, 0.95))
            cpy = pixel_params(0, 0, height, pixel_pos=step * i + top)
            t.transform.set_mixed_mode(cpx, cpy)
            p = Panel(self.component, 'arrow' + str(i))
            p.component.textureName = 'soGUI/frame/perks/Arrow.dds'
            p.component.materialFX = 'BLEND'
            p.transform.set_pixel_mode((0.5, 0.5), (0.75, 0), (16, 12), pixel_pos=(0, step * i + top + height * 0.5))
            p.component.visible = False
            t = Text(self.component, 'value' + str(i), size=16)
            t.set_alignment(Align.Right, Align.Center)
            t.transform.set_mixed_mode(cpx, cpy)
            cpx = clip_params((0.6, 0.95))
            gt = Text(self.component, 'gvalue' + str(i), text=u'???', size=16)
            gt.set_alignment(Align.Left, Align.Center)
            gt.set_color(cc.green_rgba)
            gt.transform.set_mixed_mode(cpx, cpy)
            self._char_comps[char_id] = (p, t, gt)

        self._update_content()
        return

    def set_node(self, node, ignore_local_actions):
        self._node = node
        self._update_content(ignore_local_actions)

    def _update_content(self, ignore_local_actions = False):
        add_health = 0
        add_regen = 0
        add_stamina_regen = 0
        add_stamina = 0
        add_speed = 0
        add_weight = 0
        if not ignore_local_actions and self._node and self._node.condition != Condition.Bought:
            for action in self._node.actions:
                alias = perks_parser.get_action_alias_by_id(action['id'])
                if alias == 'HP_MAX':
                    add_health += action['value'][0]
                elif alias == 'HP_REGEN':
                    add_regen += action['value'][0]
                elif alias == 'STAMINA_INC':
                    add_stamina += action['value'][0]
                elif alias == 'SPEED_MOD':
                    add_speed += action['value'][0] * 0.01 * self._speed
                elif alias == 'MAX_WEIGHT':
                    add_weight += action['value'][0]
                elif alias == 'ST_REGEN':
                    add_stamina_regen += action['value'][0]

        def set_value(index, value, changevalue):
            arrow, text, gtext = self._char_comps[index]
            text.set_text(value)
            if changevalue:
                gtext.set_text(changevalue)
                gtext.component.visible = True
                arrow.component.visible = True
            else:
                gtext.component.visible = False
                arrow.component.visible = False

        value = str(self._max_health)
        gvalue = str(self._max_health + add_health) if add_health > 0 else None
        set_value(_health, value, gvalue)
        value = str(self._regen_value)
        gvalue = str(self._regen_value + add_regen) if add_regen > 0 else None
        set_value(_regen, value, gvalue)
        value = str(self._stamina)
        gvalue = str(self._stamina + add_stamina) if add_stamina > 0 else None
        set_value(_stamina, value, gvalue)
        value = str(self._stamina_regen)
        gvalue = str(self._stamina_regen + add_stamina_regen) if add_stamina_regen > 0 else None
        set_value(_stamina_regen, value, gvalue)
        value = str(round(self._speed))
        gvalue = str(round(self._speed + add_speed, 1)) if add_speed > 0 else None
        set_value(_speed, value, gvalue)
        value = str(self._max_weight)
        gvalue = str(self._max_weight + add_weight) if add_weight > 0 else None
        set_value(_maxweight, value, gvalue)
        return

    @property
    def _max_health(self):
        return self._user.getMaxHealth()

    @property
    def _regen_value(self):
        return self._user.getRegenValue()

    @property
    def _stamina(self):
        return self._user.GetMaxStamina()

    @property
    def _stamina_regen(self):
        return self._user.getStaminaRegen()

    @property
    def _speed(self):
        return player_speed_settings.MAX_SPEED.SPRINT * self._user.GetSprintSpeedModifyer()

    @property
    def _max_weight(self):
        return self._user.getMaxWeight()

    @property
    def _user(self):
        return BigWorld.player()