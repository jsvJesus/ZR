# Embedded file name: ./client/perks_gui/exp_block.py
import math_bw
from ui.panel import Panel
from ui.text import Text, Align
import colorCodes as CC
from perks_system import perks_parser
from Localization import lc
from ui.transform import clip_params, pixel_params
from Helpers.PyGUI.PyGUIBase import roundComponentPos

class HoverText(Text):

    def __init__(self, *args, **kargs):
        Text.__init__(self, *args, **kargs)
        self.change_interseption(intercept_moving=True)
        self.component.text.visible = False

    def handleMouseEnterEvent(self, comp):
        self.component.text.visible = True
        return Text.handleMouseEnterEvent(self, comp)

    def handleMouseLeaveEvent(self, comp):
        self.component.text.visible = False
        return Text.handleMouseLeaveEvent(self, comp)


class ExpBlock(Panel):

    def __init__(self, component, name, depth = 0.5):
        Panel.__init__(self, component, name, depth=depth)
        self._free_perks = 0
        self.component.isClip = False
        base_panel = Panel(self.component, 'base_panel')
        cpx = pixel_params(0, 0, 300, pixel_pos=0)
        cpy = clip_params((0, 1))
        base_panel.transform.set_mixed_mode(cpx, cpy)
        base_panel.component.isClip = False
        points_panel = Panel(self.component, 'points_panel')
        cpx = pixel_params(1, 1, 300)
        cpy = clip_params((0, 1))
        points_panel.transform.set_mixed_mode(cpx, cpy)
        vert_border = 0.2
        line_panel_height = 0.3
        text_panel_height = (1 - line_panel_height) / 2.5
        top_line_border = 0.35
        base_font_size = 20
        level_points_font_size = 17
        level_exp_font_size = 15
        level_text_font_size = 15
        point_font_size = 40
        t = Text(self.component.base_panel, 't_0', size=point_font_size)
        t.set_alignment(Align.Right, Align.Center)
        t.transform.set_clip_mode((0,
         0,
         vert_border * 0.9,
         0.52))
        self._level_text = t
        t = Text(self.component.base_panel, 't1_1', size=level_text_font_size, text=u'{0}{1}'.format(CC.inactive_hex, lc('Perks.ui.expblock.level')))
        t.transform.set_clip_mode((vert_border,
         0,
         1,
         0.33))
        t.component.isClip = False
        t.set_alignment(Align.Left, Align.Center)
        t = Text(self.component.base_panel, 't1_2', size=level_exp_font_size)
        t.component.isClip = False
        t.transform.set_base_resolution(None)
        t.transform.set_clip_mode((0.0, 0, 1, 0.33))
        t.set_alignment(Align.Left, Align.Center)
        self._next_level_text = t
        p2 = Panel(self.component.base_panel, 'p2')
        p2.transform.set_clip_mode((vert_border,
         0,
         1,
         0.52))
        stripe = Panel(p2.component, 'panel')
        stripe.component.textureName = 'soGUI/frame/paint/white.dds'
        stripe.component.materialFX = 'SOLID'
        stripe.component.colour = (50, 50, 50, 255)
        stripe.transform.set_clip_mode((0, 0.47, 0.9, 0.82))
        filler = Panel(stripe.component, 'filler')
        filler.component.textureName = 'soGUI/frame/paint/white.dds'
        filler.component.materialFX = 'SOLID'
        filler.component.colour = CC.inactive_rgba
        filler.transform.set_clip_mode((0, 0, 1, 1))
        self._filler = filler
        t = Text(self.component, 't3', text=lc('Perks.ui.expblock.maxlevel'), size=base_font_size)
        t.transform.set_clip_mode((0.25, 0, 0.75, 1))
        t.set_alignment(Align.Center, Align.Top)
        t.set_color((165, 45, 0, 255))
        self._max_exp_text = t
        t = HoverText(stripe.component, 't3', size=level_points_font_size)
        t.transform.set_clip_mode((0, 0.1, 1, 1.14))
        t.set_alignment(Align.Center, Align.Center)
        self._exp_text = t
        t = Text(self.component.points_panel, 't4', text=lc('Perks.ui.expblock.available'), size=base_font_size)
        t.transform.set_clip_mode((0, 0, 0.75, 0.47))
        t.set_color(CC.inactive_rgba)
        t.set_alignment(Align.Right, Align.Bottom)
        t = Text(self.component.points_panel, 't5', size=point_font_size)
        t.transform.set_clip_mode((0.77, 0, 1, 0.52))
        t.set_alignment(Align.Left, Align.Bottom)
        self._perks_text = t
        return

    def get_free_perks(self):
        return self._free_perks

    def update(self, exp, perks):
        spended = perks_parser.calc_perks_count(perks)
        level, remain, to_next_level = perks_parser.exp_to_level(exp)
        self._level_text.set_text(CC.active_hex + str(level))
        self._perks_text.set_text(text=unicode(level - spended))
        self._free_perks = level - spended
        if to_next_level is None:
            self._next_level_text.component.visible = False
            self._exp_text.set_text(text=u'{0}{1}/{2}'.format(CC.active_hex, perks_parser.MAX_EXP_VALUE, perks_parser.MAX_EXP_VALUE))
            self._filler.transform.set_clip_mode((0, 0, 1, 1))
            self._max_exp_text.component.visible = True
        else:
            self._next_level_text.component.visible = True
            self._next_level_text.set_text(u'{active}{0} {inactive}{1} {active}{2}'.format(to_next_level - remain, lc('Perks.ui.expblock.tolevel'), level + 1, active=CC.active_hex, inactive=CC.inactive_hex))
            self._exp_text.set_text(text=u'{0}{1}/{2}'.format(CC.active_hex, remain, to_next_level))
            self._filler.transform.set_clip_mode((0,
             0,
             math_bw.clamp(float(remain) / to_next_level),
             1))
            self._max_exp_text.component.visible = False
        self._realign_texts()
        roundComponentPos(self)
        return

    def _realign_texts(self):
        pos_x = self.component.base_panel.t1_1.script.get_string_width()
        self._next_level_text.transform.set_clip_mode((0.2, 0, 1, 0.33), pixel_anchors=(pos_x,
         0,
         0,
         0))

    def on_size_changed(self):
        Panel.on_size_changed(self)
        self._realign_texts()
        roundComponentPos(self)