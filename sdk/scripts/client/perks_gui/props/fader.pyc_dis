# Embedded file name: ./client/perks_gui/props/fader.py
import math
import BigWorld
import math_bw
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
from Helpers.PyGUI import Utils

class Fader(object):

    def __init__(self, component):
        self.component = component
        self._coroutine = None
        self._desired_alpha = 0.0
        self._alpha = -1.0
        self.alpha = 0.0
        return

    def show(self):
        if self.component.visible:
            return
        self._desired_alpha = 1.0
        if not self._coroutine:
            self._coroutine = self._fade_coroutine()
            self._coroutine.run()

    def hide(self):
        if not self.component.visible:
            return
        self._desired_alpha = 0.0
        if not self._coroutine:
            self._coroutine = self._fade_coroutine()
            self._coroutine.run()

    @BWMemberCoroutine
    def _fade_coroutine(self):
        if Utils.is_visible_in_hierarchy(self.component.parent):
            speed = 5
            while self.alpha != self._desired_alpha:
                yield BWWaitForPeriod(0.01)
                self.alpha = math_bw.move_towards(self.alpha, self._desired_alpha, BigWorld.getTimeDelta() * speed)

        else:
            self._desired_value = 0.0
            self.alpha = 0.0
        self._coroutine = None
        return

    @property
    def alpha(self):
        return self._alpha

    @alpha.setter
    def alpha(self, value):
        potential_value = math_bw.clamp(value)
        if self._alpha == potential_value:
            return
        self._alpha = potential_value
        self.component.visible = self._alpha > 0.0

        def rec_set(component):
            component.materialFX = 'BLEND'
            component.colour[3] = self._alpha * 255.0
            for _, child in component.children:
                rec_set(child)

        rec_set(self.component)