# Embedded file name: ./client/perks_gui/props/chars_panel.py
from math import sqrt
import BigWorld
from perks_system import perks_parser as ps
import player_speed_settings
from Config.Damage import DamageTypes
from perks_system.actions_utils import DamageTypesFilter
from ui.text import Text, Align
from ui.transform import clip_params, pixel_params
from ui.panel import Panel
import colorCodes as CC
from Localization import lc
from ..workplace.node import Condition
_health, _regen, _stamina, _stamina_regen, _speed, _maxweight, _melee, _psy, _explosion, _chemical, _radiation, _bio, _infrared, _electrostatic, _gravitation, _fall, _cold, _sturdiness = xrange(18)
_char_data = [(_health, lc('Perks.ui.chars.health')),
 (_regen, lc('Perks.ui.chars.regen')),
 (_stamina, lc('Perks.ui.chars.stamina')),
 (_stamina_regen, lc('Perks.ui.chars.stamina_regen')),
 (_speed, lc('Perks.ui.chars.speed')),
 (_maxweight, lc('Perks.ui.chars.maxweight')),
 (_melee, lc('Perks.ui.chars.melee')),
 (_psy, lc('Perks.ui.chars.psy')),
 (_explosion, lc('Perks.ui.chars.explosion')),
 (_chemical, lc('Perks.ui.chars.chemical')),
 (_radiation, lc('Perks.ui.chars.radiation')),
 (_bio, lc('Perks.ui.chars.bio')),
 (_infrared, lc('Perks.ui.chars.infrared')),
 (_electrostatic, lc('Perks.ui.chars.electrostatic')),
 (_gravitation, lc('Perks.ui.chars.gravitation')),
 (_fall, lc('Perks.ui.chars.fall')),
 (_cold, lc('Perks.ui.chars.cold')),
 (_sturdiness, lc('Perks.ui.chars.sturdiness'))]

class CharsLine(Panel):

    def __init__(self, parent_comp, name):
        Panel.__init__(self, parent_comp, name)
        self._caption_text = Text(self.component, 'caption', size=16)
        self._caption_text.set_alignment(Align.Left, Align.Center)
        self._caption_text.transform.set_clip_mode((0, 0, 1, 1))
        self._total_text = Text(self.component, 'total', size=16)
        self._total_text.set_alignment(Align.Left, Align.Center)
        self._total_text.transform.set_clip_mode((0.85, 0, 1, 1))
        self._total_text.set_color(CC.green_rgba)
        self._cur_text = Text(self.component, 'cur', size=16)
        self._cur_text.set_alignment(Align.Right, Align.Center)
        self._cur_text.transform.set_clip_mode((0, 0, 0.75, 1))
        self._arrow = Panel(self.component, 'arrow')
        self._arrow.component.textureName = 'soGUI/frame/perks/Arrow.dds'
        self._arrow.component.materialFX = 'BLEND'
        self._arrow.component.filterType = 'LINEAR'
        self._arrow.transform.set_pixel_mode((0.5, 0.5), (0.8, 0.5), (16, 12), pixel_pos=(0, -2))

    def set_data(self, ignore_local_actions, index, value, delta_value, round_to = None):
        self._caption_text.set_text(_char_data[index][1])
        new_value = value + delta_value
        if round_to is not None:
            value = round(value, round_to)
            new_value = round(new_value, round_to)
        if ignore_local_actions:
            self._arrow.component.visible = False
            self._cur_text.component.visible = False
            self._total_text.set_text(str(value))
            self._total_text.set_color(CC.active_rgba)
        else:
            self._arrow.component.visible = True
            self._total_text.set_text(str(new_value))
            self._cur_text.component.visible = True
            self._cur_text.set_text(str(value))
            self._total_text.set_color(CC.green_rgba)
        return


class CharsPanel(Panel):

    def __init__(self, parent_comp, name):
        Panel.__init__(self, parent_comp, name)

    def set_node(self, node, ignore_local_actions):
        for _, child_comp in self.component.children:
            child_comp.visible = False

        ignore_local_actions = ignore_local_actions or not node or node.condition == Condition.Bought
        args = []
        for action in node.actions:
            alias = ps.get_action_alias_by_id(action['id'])
            if alias == 'HP_MAX':
                add_health = action['value'][0]
                args.append((_health, self._max_health, add_health))
            elif alias == 'HP_REGEN':
                add_regen = action['value'][0]
                args.append((_regen, self._regen_value, add_regen))
            elif alias == 'STAMINA_INC':
                add_stamina = action['value'][0]
                args.append((_stamina, self._stamina, add_stamina))
            elif alias == 'ST_REGEN':
                add_stamina_regen = action['value'][0]
                args.append((_stamina_regen, self._stamina_regen, add_stamina_regen))
            elif alias == 'SPEED_MOD':
                add_speed = action['value'][0] * 0.01 * player_speed_settings.MAX_SPEED.SPRINT
                print (_speed,
                 self._speed,
                 add_speed,
                 1)
                args.append((_speed,
                 self._speed,
                 add_speed,
                 1))
            elif alias == 'MAX_WEIGHT':
                add_weight = action['value'][0]
                args.append((_maxweight, self._max_weight, add_weight))
            elif alias == 'STURDINESS':
                add_sturd = action['value'][0]
                cur_value = self._user.get_perk_action_val(alias)
                args.append((_sturdiness, cur_value, add_sturd))
            elif alias == 'DEFENCE_DAMAGE_TYPE':
                filters = action['filters'][0]

                def check_and_compile_args(damage_type, index):
                    if filters & DamageTypesFilter.bits[damage_type]:
                        cur_value = self._user.get_perk_action_val(alias, damage_type=damage_type)
                        new_value = sqrt(cur_value * cur_value + action['value'][0] * action['value'][0])
                        add_value = new_value - cur_value
                        args.append((index,
                         cur_value,
                         add_value,
                         1))

                check_and_compile_args(DamageTypes.MELEE, _melee)
                check_and_compile_args(DamageTypes.PSY, _psy)
                check_and_compile_args(DamageTypes.EXPLOSION, _explosion)
                check_and_compile_args(DamageTypes.CHEMICAL, _chemical)
                check_and_compile_args(DamageTypes.RADIATION, _radiation)
                check_and_compile_args(DamageTypes.BIO, _bio)
                check_and_compile_args(DamageTypes.INFRARED, _infrared)
                check_and_compile_args(DamageTypes.ELECTROSTATIC, _electrostatic)
                check_and_compile_args(DamageTypes.GRAVITATION, _gravitation)
                check_and_compile_args(DamageTypes.FALL, _fall)
                check_and_compile_args(DamageTypes.COLD, _cold)

        height = 26
        unscaled_height = len(args) * height
        for _, child_comp in self.component.children:
            if not args:
                break
            child_comp.visible = True
            child_comp.script.set_data(ignore_local_actions, *args.pop(0))

        for arg in args:
            index = len(self.component.children)
            line = CharsLine(self.component, 'text_' + str(index))
            line.component.colour = (100, 100, 100, 255)
            cpx = clip_params((0, 1))
            cpy = pixel_params(0, 0, height, pixel_pos=index * height)
            line.transform.set_mixed_mode(cpx, cpy)
            line.set_data(ignore_local_actions, *arg)

        return unscaled_height

    @property
    def _max_health(self):
        return self._user.getMaxHealth()

    @property
    def _regen_value(self):
        return self._user.getRegenValue()

    @property
    def _stamina(self):
        return self._user.GetMaxStamina()

    @property
    def _stamina_regen(self):
        return self._user.getStaminaRegen()

    @property
    def _max_weight(self):
        return self._user.getMaxWeight()

    @property
    def _speed(self):
        return player_speed_settings.MAX_SPEED.SPRINT * self._user.GetSprintSpeedModifyer()

    @property
    def _user(self):
        return BigWorld.player()