# Embedded file name: ./client/perks_gui/tooltiper.py
import GUI
from Math import Vector2
import BigWorld
from ui.panel import EventType as ET
_time_delay = 0.5

class Tooltiper:

    def __init__(self, carrier_panel):
        self._current_provider = None
        self._controller_id = None
        self._mouse_pos = None
        self._timer = 0.0
        self._visible = None
        self._carrier_panel = carrier_panel
        self._update_content()
        return

    def extend_tootip_providers(self, providers):
        for provider in providers:
            provider.add_callback(self._on_provider_event)

    def _on_provider_event(self, provider, event_type, data):
        if event_type == ET.MouseEnter:
            self._current_provider = provider
            if not self._controller_id:
                self._mouse_pos = Vector2(GUI.mcursor().position)
                self._timer = BigWorld.time() + _time_delay
                self._controller_id = BigWorld.callback(0, self._pend_tick)
        elif event_type == ET.MouseLeave:
            self._current_provider = None
        return

    def on_win_hide(self):
        self._current_provider = None
        return

    def _pend_tick(self):
        if self._current_provider:
            mouse_pos = Vector2(GUI.mcursor().position)
            if mouse_pos.distTo(self._mouse_pos) > 0.005:
                self._mouse_pos = mouse_pos
                self._timer = BigWorld.time() + _time_delay
            self._controller_id = BigWorld.callback(0, self._pend_tick)
        else:
            self._controller_id = None
        self._update_content()
        return

    def _update_content(self):
        visible = bool(self._current_provider and self._timer < BigWorld.time() and self._controller_id)
        if visible != self._visible:
            self._visible = visible
            if self._visible:
                panel = self._current_provider.get_tooltip_panel()
                self._carrier_panel.transform.set_child(panel.transform, 'tooltip')
                width, height = BigWorld.screenSize()
                x = (self._mouse_pos[0] + 1.0) * 0.5 * width
                y = (1.0 - (self._mouse_pos[1] + 1.0) * 0.5) * height
                panel.transform.set_pixel_mode((0, 0), (0, 0), (width * 0.15, panel.wrapped_height), (x, y))
                panel.transform.set_pixel_mode((0, 0), (0, 0), (width * 0.15, panel.wrapped_height), (x, y))
            else:
                self._carrier_panel.component.delChild('tooltip')