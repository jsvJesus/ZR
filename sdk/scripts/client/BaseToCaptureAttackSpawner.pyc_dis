# Embedded file name: ./client/BaseToCaptureAttackSpawner.py
import time
import BigWorld
import BWPersonality
import ChatChannelConfig
import Constants
import GUI
import Helpers.Caps
import random
import Math
import colorCodes
import UCManager
import sounds_manager
from Localization import lc
from soGUI.soInworldMarkers import soInworldMarker
MODEL_PATH = 'models/misc/fireplace/bonfire_city/bonfire_city.model'
PARTICLES_NAME = 'particles/_bonfire.xml'
PARTICLES_NAME_OFF = 'particles/fire_place_nofire.xml'

class BaseToCaptureAttackSpawner(BigWorld.Entity):

    def __init__(self):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        BigWorld.Entity.__init__(self)
        self.particle = None
        self.name = lc('TriggerNames.attack_spawner')
        self.sound = None
        self.light = None
        self.light_timer_id = None
        return

    def prerequisites(self):
        return [MODEL_PATH, PARTICLES_NAME]

    def onEnterWorld(self, prereqs):
        if self.mode:
            return
        else:
            self.model = prereqs[MODEL_PATH]
            self.particle = prereqs[PARTICLES_NAME]
            self.set_active(None)
            self.light = light = BigWorld.PyChunkLight()
            self.light_start_position = self.position + (0, 1.3, 0)
            light.innerRadius = 2.0
            light.outerRadius = 7.0
            light.position = self.light_start_position
            light.specular = 1
            light.diffuse = 1
            light.visible = 1
            self._light_blink()
            return

    def onLeaveWorld(self):
        if self.light:
            self.light.visible = False
        if self.light_timer_id:
            BigWorld.cancelCallback(self.light_timer_id)
        if self.sound:
            self.sound.stop()
            self.sound = None
        return

    def onClanChangeEmblemID(self, emblemID):
        pass

    def set_active(self, old_value):
        self.update_particle(self.active)

    def update_particle(self, value):
        if self.mode:
            return
        else:
            for fire in self.model.root.attachments:
                self.model.root.detach(fire)

            if value:
                self.model.root.attach(self.particle)
                if not self.sound:
                    self.sound = sounds_manager.playSound('environment/fire_campfire', self.model)
                elif self.sound:
                    self.sound.stop()
                    self.sound = None
            return

    def _light_blink(self):
        delay = random.random() * 0.15
        self.light_timer_id = BigWorld.callback(delay, self._light_blink)

        def r():
            return random.randrange(-1000, 1000) * 9.1e-05

        self.light.position = self.light_start_position + Math.Vector3(r(), r(), r())