    def _apply(self):
        price = self.component.NumberBox.script.rawText
        try:
            price = int(price)
        except:
            price = 0

        if price < hunt_utils.MIN_PRICE:
            ask = lc('HeadHunter.submitwin.pricelimit').format(hunt_utils.MIN_PRICE)
            gui_jokes.askUserOk(u'', ask)
            self.component.NumberBox.script.activate(False)
            return
        money = BigWorld.player().CreditNumber
        total_money = int(price * hunt_utils.COMISSION) + price
        if money < total_money:
            ask = lc('HeadHunter.submitwin.nomoney').format(money, total_money)
            gui_jokes.askUserOk(u'', ask)
            return
        self.last_close_result = price
        self.hide()

    def _on_value_changed(self, byuser):
        price = self.component.NumberBox.script.rawText
        try:
            price = int(price)
        except:
            price = 0

        tax = int(price * hunt_utils.COMISSION)
        money = BigWorld.player().CreditNumber
        rubles = lc('HeadHunter.submitwin.rubles')
        self.component.mymoney.text = groupNumber(money) + ' ' + rubles
        self.component.label_tax.text = groupNumber(tax) + ' ' + rubles
        if price < hunt_utils.MIN_PRICE:
            self.component.allcost.text = lc('HeadHunter.submitwin.pricelimit2').format(hunt_utils.MIN_PRICE)
            self.component.allcost.colour = cc.red_rgba
        else:
            self.component.allcost.text = groupNumber(tax + price) + ' ' + rubles
            self.component.allcost.colour = cc.red_rgba if money < tax + price else cc.active_rgba

    def show(self, killer_name, killer_clan_name, close_callback = None):
        self.component.label_capt.text = lc('HeadHunter.submitwin.title')
        self._show(killer_name, killer_clan_name, close_callback)

    def show_donate(self, killer_name, killer_clan_name, close_callback = None):
        self.component.label_capt.text = lc('HeadHunter.submitwin.title2')
        self._show(killer_name, killer_clan_name, close_callback)

    def _show(self, killer_name, killer_clan_name, close_callback):
        self._close_callback = close_callback
        self.last_close_result = None
        self.component.visible = True
        self.component.crossFocus = True
        self.component.moveFocus = True
        if killer_clan_name:
            killer_name = killer_clan_name.decode('utf8') + ':' + killer_name
        self.component.killerName.text = killer_name
        self.component.NumberBox.script.clear()
        self.component.NumberBox.script.activate()
        return

    def hide(self):
        self.component.visible = False
        self.component.moveFocus = False
        self.component.crossFocus = False
        self.component.NumberBox.script.activate(False)
        if self._close_callback:
            self._close_callback(self.last_close_result)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)