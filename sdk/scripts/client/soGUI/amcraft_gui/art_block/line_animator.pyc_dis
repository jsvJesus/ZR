# Embedded file name: ./client/soGUI/amcraft_gui/art_block/line_animator.py
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
import time
import math_bw

class LineAnimator(object):

    def __init__(self, line_comp):
        self._animation_coroutine = None
        self._lc = line_comp
        return

    def animate(self, sync_time, line_indices):
        self.stop_all()
        if line_indices:
            self._animation_coroutine = self._animation_coroutine_runner(sync_time, line_indices)
            self._animation_coroutine.run()

    def stop_all(self):
        if self._animation_coroutine:
            self._animation_coroutine.stop()
            self._animation_coroutine = None
            self._lc.setShapeActives([(0, 0)] * 3)
        return

    @BWMemberCoroutine
    def _animation_coroutine_runner(self, sync_time, line_indices):
        bright_color = 0.6
        none_color = 0.2
        self._lc.fillColor = (bright_color,
         bright_color,
         bright_color,
         1)

        def apply_progress(progress):
            shapes = [(0, 0), (0, 0), (0, 0)]
            color = bright_color
            if progress < 0.5:
                sub_progress = progress * 2.0
                shape = (0, sub_progress)
            else:
                sub_progress = (progress - 0.5) * 2.0
                shape = (1 - sub_progress, 1)
            if progress > 0.7:
                sub_progress = (progress - 0.7) / 0.3
                alpha = 1 - sub_progress
            elif 0.2 < progress < 0.5:
                sub_progress = (progress - 0.2) / 0.3
                alpha = 1 - sub_progress
            else:
                alpha = 1
            color = math_bw.lerp(none_color, bright_color, alpha)
            self._lc.fillColor = (color,
             color,
             color,
             1)
            for i in line_indices:
                shapes[i] = shape

            self._lc.setShapeActives(shapes)

        period = 2.0
        apply_progress(0)
        while True:
            time_elapsed = time.time() - sync_time
            progress = time_elapsed % period / period
            yield BWWaitForPeriod(0)
            apply_progress(progress)