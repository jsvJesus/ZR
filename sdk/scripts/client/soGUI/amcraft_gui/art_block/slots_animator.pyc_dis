# Embedded file name: ./client/soGUI/amcraft_gui/art_block/slots_animator.py
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
import math_bw
import time

class SlotsAnimator(object):

    def __init__(self, slots):
        self._lcs = [ s.component.lines for s in slots ]
        self._animation_coroutine = None
        return

    def animate(self, sync_time, indices):
        self.stop_all()
        if indices:
            self._animation_coroutine = self._animation_coroutine_runner(sync_time, indices)
            self._animation_coroutine.run()

    @BWMemberCoroutine
    def _animation_coroutine_runner(self, sync_time, indices):
        bright_color = 0.6
        none_color = 0.2
        for l in self._lcs:
            l.fillColor = (bright_color,
             bright_color,
             bright_color,
             1)

        empty = [(0, 0)] * 4

        def apply_progress(progress):
            shapes = [(0, 0)] * 4
            for i, factor in enumerate((0.25, 0.5, 0.75, 1)):
                b_min = factor - 0.25
                b_max = factor
                sub_progress = math_bw.clamp(progress, b_min, b_max)
                sub_progress = math_bw.inverse_lerp(b_min, b_max, sub_progress)
                shapes[i] = (0, sub_progress)

            if progress < 0.25:
                sub_progress = progress / 0.25
                alpha = math_bw.lerp(0, 1, sub_progress)
            elif progress < 0.75:
                alpha = 1.0
            else:
                sub_progress = 1 - (progress - 0.75) / 0.25
                alpha = math_bw.lerp(0, 1, sub_progress)
            color = math_bw.lerp(none_color, bright_color, alpha)
            color = (color,
             color,
             color,
             1)
            for i, l in enumerate(self._lcs):
                l.fillColor = color
                if i in indices:
                    l.setShapeActives(shapes)
                else:
                    l.setShapeActives(empty)

        period = 2.0
        apply_progress(0)
        while True:
            time_elapsed = time.time() - sync_time
            progress = time_elapsed % period / period
            yield BWWaitForPeriod(0)
            apply_progress(progress)

    def stop_all(self):
        if self._animation_coroutine:
            self._animation_coroutine.stop()
            self._animation_coroutine = None
            empty = [(0, 0)] * 4
            for l in self._lcs:
                l.setShapeActives(empty)

        return