class AmuletSlot(soItemSlot):
    factoryString = 'soGUI.Craft.AmuletSlot'

    def __init__(self, size):
        self.SLOTWIDTH, self.SLOTHEIGHT = size, size
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.SLOTWIDTH, self.SLOTHEIGHT
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.5)
        soItemSlot.__init__(self, comp, 0, centerDProxy=True)
        comp.dragFocus = True
        comp.dropFocus = True
        comp.crossFocus = True
        comp.moveFocus = True
        comp.mouseButtonFocus = True
        self.dragProxy = self.component.dragProxy
        self.proxyHolder = self.component
        self.proxyName = 'dragProxy'
        self._onDragStart = self.onDragStart
        self._onDragStop = self.onDragStop
        self.on_content_changed = lambda item: None

    def on_out_screen_drop(self):
        self.setContent(None)
        return

    def onDragStart(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        return True

    def slotEvent(self, event, data):
        soItemSlot.slotEvent(self, event, data)
        return True

    def handleDropEvent(self, comp, dropped):
        if dropped.script is None:
            return False
        elif getattr(dropped.script, 'factoryString') != 'soGUI.soInventorySlot2':
            return False
        else:
            item = dropped.script.itemData
            if not item:
                return False
            category = ItemsCatalog.GetItemCategory(item['complexItemType'])
            if category != ItemCategories.AMULET:
                return False
            self.setContent(dropped.script.itemData)
            return True

    def setContent(self, item):
        if item != self.itemData:
            soItemSlot.setContent(self, item)
            self.on_content_changed(item)

    def _applyItemData(self):
        if self.haveItem():
            icon_name = ItemsUtils.GetIconName(self.itemData) or 'nottexture.dds'
            self.component.icon.texture = BWPersonality.GUICore.get_icon_from_cache(icon_name)
        else:
            self.component.icon.texture = None
            self.component.icon.textureName = ''
        self.dragProxy.texture = self.component.icon.texture
        return

    def clear(self):
        self.setContent(None)
        return

    def setupContent(self):
        comp = GUI.Frame2('soGUI/items/cell.dds')
        comp.verticalPositionMode, comp.horizontalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.materialFX = 'SOLID'
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'frameCmp')
        comp = GUI.Simple('')
        comp.verticalPositionMode, comp.horizontalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.8)
        comp.filterType = 'LINEAR'
        self.component.addChild(comp, 'icon')
        comp = GUI.Simple('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.SLOTWIDTH, self.SLOTHEIGHT
        comp.colour = (255, 255, 255, 128)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.5)
        comp.visible = False
        self.component.addChild(comp, 'dragProxy')


class AmuletDesc:

    def __init__(self, width, height):
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width, height
        comp.position = (0, 0, 0.5)
        self.component = comp
        comp = GUI.Frame2('soGUI/items/cell.dds')
        comp.verticalPositionMode, comp.horizontalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor = 'CENTER'
        comp.verticalAnchor = 'CENTER'
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.materialFX = 'SOLID'
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'frameCmp')
        line_height = 18
        left_margin = 8
        top_margin = 6

        def create_line(index):
            comp = GUI.Text(u'')
            comp.colourFormatting = True
            comp.font = 'RobotoCondensedRegular_16.font'
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = self.component.width - left_margin, line_height
            comp.position = (left_margin, top_margin + index * line_height, 0.5)
            self.component.addChild(comp, 'line' + str(index))
            return comp

        self._tick_controller_id = None
        self._item = None
        self._external_arts = []
        self._makeup_text = create_line(0)
        self._condition_text = create_line(1)
        self._time_text = create_line(2)
        self._capacity_text = create_line(3)
        return

    def set_external_arts(self, external_arts):
        self._external_arts = external_arts
        self._update_content()

    def set_amulet(self, item):
        self._item = item
        if self._tick_controller_id:
            BigWorld.cancelCallback(self._tick_controller_id)
            self._tick_controller_id = None
        if self._item:
            self._tick_controller_id = BigWorld.callback(1, self._tick)
        self._update_content()
        return

    def _update_content(self):
        if self._item:
            amulet = AmuletWrapper(self._item)
            materials = u''
            for i, m_id in enumerate(amulet.materials_list):
                if i > 0:
                    materials += ', '
                materials += lc('CraftWin.amulet.material.id_' + unicode(m_id))

            self._makeup_text.text = cc.inactive_hex + lc('CraftWin.amulet.makup_l') + ' ' + cc.active_hex + materials
            self._condition_text.text = cc.inactive_hex + lc('CraftWin.amulet.condition_l') + ' ' + cc.active_hex + unicode(amulet.condition)
            time = amulet.time_to_live
            self._time_text.text = cc.inactive_hex + lc('CraftWin.amulet.time_l') + ' ' + cc.active_hex + unicode(int(time))
            if self._external_arts:
                capacity = amulet.calc_capacity_from_adding_artefacts(len(self._external_arts))
            else:
                capacity = amulet.capacity
            self._capacity_text.text = cc.inactive_hex + lc('CraftWin.amulet.capacity_l') + ' ' + cc.active_hex + unicode(capacity)
        else:
            self._makeup_text.text = u''
            self._condition_text.text = u''
            self._time_text.text = u''
            self._capacity_text.text = u''

    def _tick(self):
        self._tick_controller_id = None
        if Utils.is_visible_in_hierarchy(self.component):
            self._tick_controller_id = BigWorld.callback(1, self._tick)
        self._update_content()
        return


class AmuletBlock(object):

    def __init__(self, parent_comp):
        self.component = parent_comp
        content_height = 128
        content_margin = 64
        self._am_slot = AmuletSlot(content_height)
        self._am_slot.component.position[0] = content_margin
        self._am_slot.on_content_changed = self._on_slot_content_changed
        parent_comp.addChild(self._am_slot.component, 'amslot')
        self._desc = AmuletDesc(316, content_height)
        self._desc.component.position[0] = parent_comp.width - content_margin
        parent_comp.addChild(self._desc.component, 'desc')
        self.on_content_changed = lambda amulet_item: None
        self._item = None
        return

    def set_external_arts(self, external_arts):
        self._desc.set_external_arts(external_arts)

    def _on_slot_content_changed(self, amulet):
        self._desc.set_amulet(amulet)
        if amulet != self._item:
            if self._item:
                self._user.release_craft_items([self._item['complexItemID']])
            self._item = PY(amulet)
            if amulet:
                self._user.capture_craft_item(amulet['complexItemID'])
        self.on_content_changed(amulet)

    def validate_items(self):
        if not self._item:
            return True
        user_item = ItemsUtils.GetComplexItemByID(self._user, self._item['complexItemID'])
        return PY(user_item) == PY(self._item)

    def clear(self):
        self._am_slot.clear()

    @property
    def _user(self):
        return BigWorld.player()

    @property
    def item(self):
        return self._item