    def _payment_acception(self, accept_callback, item_types, factor = 1):

        def callback(event):
            if event == gui_jokes.askUserYesNo.YES:
                if BigWorld.player().CreditNumber < money:
                    BigWorld.player().ReportFail(ItemsUtils.FAIL_NO_MONEY)
                else:
                    accept_callback()

        money = 0
        for item_type in item_types:
            money += ItemsCatalog.GetItemParam(item_type)['Cost']

        gui_jokes.askUserYesNo(u'', lc('CraftWin.notification.payed_craft').format(int(money * factor)), callback=callback)

    def _on_craft_click(self):
        external_items = self._art_block.get_external_slot_items()

        def apply_craft():
            self._user.craft_amulet(self._amulet_block.item, external_items, self._kickstart_block.compile_item_ids(), self._payed)

        if self._payed:
            item_types = [ it['complexItemType'] for it in external_items if it ]
            self._payment_acception(apply_craft, item_types)
        else:
            apply_craft()

    def _on_extract_click(self):

        def apply_extract():
            self._user.extract_amulet(self._amulet_block.item, self._kickstart_block.compile_item_ids(), self._payed)

        if self._payed:
            item_types = AmuletWrapper(self._amulet_block.item).artefacts
            self._payment_acception(apply_extract, item_types, EXTRACT_PRICE_FACTOR)
        else:
            apply_extract()

    def _on_kickstart_content_changed(self):
        self._update_buttons()

    def _on_amulet_slot_content_changed(self, amulet_item):
        self._art_block.set_amulet(amulet_item)
        self._desc_block.set_amulet(amulet_item)
        self._actions_block.set_amulet(amulet_item)
        self._update_buttons()

    def _on_artblock_content_changed(self):
        self._update_buttons()
        external_slot_items = self._art_block.get_external_slot_items()
        filtered_external_slot_items = filter(lambda s: s, external_slot_items)
        self._desc_block.set_external_arts(filtered_external_slot_items)
        self._amulet_block.set_external_arts(filtered_external_slot_items)
        self._actions_block.set_external_arts(external_slot_items)

    def _update_buttons(self):
        amulet_item = self._amulet_block.item
        external_slot_items = any(self._art_block.get_external_slot_items())
        kb_filled = self._kickstart_block.filled
        self._create_btn.setDisabledState(external_slot_items and amulet_item and not kb_filled)
        internal_slot_items = any(self._art_block.get_internal_slot_items())
        self._extract_btn.setDisabledState(internal_slot_items and amulet_item and not kb_filled)

    def show(self, need_kickstart_set = False, payed = False):
        if self.visible:
            return
        self._user.add_craft_event_listener(self)
        self._clear()
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        self._payed = payed
        self._kickstart_block.show(WorkbenchTypes.AMULET, True)
        self._update_buttons()

    def _clear(self):
        self._amulet_block.clear()
        self._art_block.clear()
        self._desc_block.set_amulet(None)
        return

    def on_craft_event(self, event_type, data, craft_user):
        if event_type == ET.ItemsChanged:
            if not self._validate_items():
                self._clear()

    def _validate_items(self):
        items = chain([self._amulet_block.item], self._art_block.get_external_slot_items())
        if not self._user.check_all_items_in_inventory(items):
            return False
        if not self._amulet_block.validate_items():
            return False
        return True

    def hide(self):
        if not self.visible:
            return
        self._user.remove_craft_event_listener(self)
        self._kickstart_block.on_hide()
        self._clear()
        self.component.visible = False
        BWPersonality.GUICore.setBestCursor()

    @property
    def visible(self):
        return self.component.visible

    @property
    def _user(self):
        return BigWorld.player()