# Embedded file name: ./client/soGUI/amcraft_gui/actions_block.py
import GUI
from amulets_utils import AmuletWrapper, ActionsExtractor
import InventoryNames
import EffectUtils
from Stats import CharacteristicsNames
from Localization import lc
import colorCodes as cc
from soGUI.soTextField import soTextField2, soTxtFieldPropsStructure

class ActionsBlock:

    def __init__(self, parent_comp):
        comp = GUI.Frame2('soGUI/frame/craft/craft_frame2.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = parent_comp.width, parent_comp.height
        comp.position = (0, 0, 0.9)
        parent_comp.addChild(comp, 'frame')
        margin = 8
        self._text = soTextField2(GUI.Window(), soTxtFieldPropsStructure(autoSize=False, borderWidth=0, autoScroll=False, width=parent_comp.width - margin * 2, height=parent_comp.height - margin * 2, hideScroll=True, font='RobotoCondensedRegular_16.font'))
        comp = self._text.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = parent_comp.width - margin * 2, parent_comp.height - margin * 2
        comp.position = (margin, margin, 0.1)
        parent_comp.addChild(comp, 'text')
        self._amulet_item = None
        self._external_arts = [None] * 3
        return

    def set_amulet(self, amulet_item):
        self._amulet_item = amulet_item
        self._update_content()

    def set_external_arts(self, external_arts):
        self._external_arts = external_arts or [None] * 3
        self._update_content()
        return

    def _update_content(self):
        if not self._amulet_item:
            self._text.setText('')
            return
        amulet = AmuletWrapper(self._amulet_item)
        slot_artefacts = amulet.slot_artefacts
        art_types = []
        for i in xrange(3):
            art_types.append(slot_artefacts[i] or self._external_arts[i] and self._external_arts[i]['complexItemType'])

        actions = ActionsExtractor(art_types, amulet.slot_mats)

        def indent_lines(text):
            lines = []
            for line in text.split('\n'):
                lines.append('\t\t' + line)

            return '\n'.join(lines)

        def compile_absorb():
            text = ''
            for eff_id, absorb_value in actions.get_all_absorbs(show_hidden=False).items():
                text += u'{0}: {1} {2}\n'.format(EffectUtils.getEffectLcName(eff_id), absorb_value, lc('CraftWin.amulet.absorbunit'))

            caption = cc.inactive_hex + lc('CraftWin.amulet.absorb')
            if text:
                return caption + '\n' + cc.active_hex + indent_lines(text.strip())
            else:
                return caption

        def compile_shield():
            text = ''
            for damage_type, protect_value in actions.get_all_shields(show_hidden=False).items():
                text += u'{0}: {1}{2}\n'.format(InventoryNames.DamageNames_1[damage_type], int(protect_value * 100), lc('CraftWin.amulet.shieldunit'))

            caption = cc.inactive_hex + lc('CraftWin.amulet.shield')
            if text:
                return caption + '\n' + cc.active_hex + indent_lines(text.strip())
            else:
                return caption

        def compile_stats():
            text = ''
            for stat_id, stat_value in actions.get_all_stats(show_hidden=False).items():
                try:
                    stat_name = CharacteristicsNames[stat_id]
                except:
                    stat_name = u'???notlocalized???'

                text += u'{0}: {1} {2}\n'.format(stat_name, stat_value, lc('CraftWin.amulet.statunit'))

            caption = cc.inactive_hex + lc('CraftWin.amulet.stat')
            if text:
                return caption + '\n' + cc.active_hex + indent_lines(text.strip())
            else:
                return caption

        text = cc.inactive_hex + lc('CraftWin.amulet.stat') + '\n'
        text += indent_lines(compile_absorb()) + '\n'
        text += indent_lines(compile_shield()) + '\n'
        text += indent_lines(compile_stats())
        if actions.has_hidden_actions:
            text += '\n' + cc.inactive_hex + lc('CraftWin.amulet.bonus') + ' ' + cc.active_hex + lc('CraftWin.amulet.hidden_actions')
        self._text.setText(text)