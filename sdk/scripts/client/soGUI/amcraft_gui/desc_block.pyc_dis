# Embedded file name: ./client/soGUI/amcraft_gui/desc_block.py
import BigWorld
import colorCodes as cc
from Localization import lc
import GUI
from Items import ItemsCatalog
import math_bw
from amulets_utils import AmuletWrapper

class DescBlock(object):

    def __init__(self, parent_comp):
        self.component = parent_comp
        self._amulet_item = None
        self._art_items = []
        line_height = 20
        comp = GUI.Text('')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.colourFormatting = True
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = 200, line_height
        comp.position = (32, 0, 0.5)
        self.component.addChild(comp, 'effsum')
        comp = GUI.Text('')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.colourFormatting = True
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = 200, line_height
        comp.position = (32, line_height, 0.5)
        self.component.addChild(comp, 'needskill')
        comp = GUI.Text('')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.colourFormatting = True
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = 200, line_height
        comp.position = (32, line_height * 2, 0.5)
        self.component.addChild(comp, 'cchance')
        return

    def set_amulet(self, amulet_item):
        self._amulet_item = amulet_item
        self._update_content()

    def set_external_arts(self, art_items):
        self._art_items = art_items
        self._update_content()

    def _update_content(self):
        if self._amulet_item:
            effsum = 0
            amulet = AmuletWrapper(self._amulet_item)
            for art_type in amulet.artefacts:
                effsum += ItemsCatalog.GetItemParam(art_type).get('Might', 0)

            for art in self._art_items:
                effsum += ItemsCatalog.GetItemParam(art['complexItemType']).get('Might', 0)

            needskill = self._user.get_perk_action_val('CRAFT_AMULET')
            chance = math_bw.clamp(float(needskill) / effsum) if effsum > 0 else 1
            self.component.effsum.text = cc.inactive_hex + lc('CraftWin.amulet.effectsum') + cc.active_hex + u' ' + str(effsum)
            self.component.needskill.text = cc.inactive_hex + lc('CraftWin.amulet.neededskill') + cc.active_hex + u' ' + str(needskill)
            self.component.cchance.text = u'{0}{1}{2} {3}%'.format(cc.inactive_hex, lc('CraftWin.amulet.craftchance'), cc.active_hex, int(chance * 100))
        else:
            self.component.effsum.text = ''
            self.component.needskill.text = ''
            self.component.cchance.text = ''

    @property
    def _user(self):
        return BigWorld.player()