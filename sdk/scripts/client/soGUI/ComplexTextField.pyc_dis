# Embedded file name: ./client/soGUI/ComplexTextField.py
import GUI
from soTextField import soTextField3
from BB_Viewer import BB_Viewer
from Grade_Viewer import Grade_Viewer
import math
from Items import ItemsCatalog
import colorCodes

class ComplexTextField(soTextField3):
    INTERFACE_ID = 'soGUI.ComplexTextField'

    def __init__(self, width, height, bb_context_win_comp):
        soTextField3.__init__(self, GUI.Window(), width=width, height=height, textWidth=-1, hScroll=False, vScroll=True, hideScroll=1, borderWidth=0, vOffset=5, hOffset=5, textureless=1, autosize=0)
        self._bb_context_win_comp = bb_context_win_comp
        self.grade_comp = None
        self._item = None
        return

    def setText(self, text, item_type_or_bb):
        if hasattr(self.component, 'bb_win'):
            self.component.delChild(self.component.bb_win)
        if hasattr(self.component, 'grade_win'):
            self.component.delChild(self.component.grade_win)
        self._bb_win = self._create_bb_component(item_type_or_bb)
        self._grade_win = None
        if '<grade>' in text:
            self._grade_win = self._create_grade_component()
            self._grade_win.position = (0, 0, 1)
            self.component.addChild(self._grade_win, 'grade_win')
            self._grade_win.visible = False
        if self._bb_win:
            bb_lines_amount = int(math.ceil(self._bb_win.height / self.string_height))
            soTextField3.setText(self, text + '\n' * bb_lines_amount)
            self.component.addChild(self._bb_win, 'bb_win')
        else:
            soTextField3.setText(self, text)
        return

    def renderText(self):
        soTextField3.renderText(self)
        if self._bb_win:
            pos = (len(self.hMap) - self.scrollCursor[1]) * self.string_height - self._bb_win.height
            self._bb_win.script.set_y_pos(pos)
            self._bb_win.visible = True
        if self._grade_win:
            index = self.rawText.split('<n>').index('<grade>', 0)
            scroll = self.scrollCursor[1]
            ypos = (index - scroll) * self.string_height
            self._grade_win.position[1] = float(ypos)
            self._grade_win.visible = True

    @property
    def string_height(self):
        if not getattr(self, '_string_height', None):
            self._string_height = self._getTxtDims('W', soTextField3.DEFAULT_FONT)[1]
        return self._string_height

    def text_height(self):
        return self.string_height * len(self.hMap)

    def disp(self):
        return self.component.position[1]

    def setGradeItem(self, item):
        self._item = item
        if not self.grade_comp:
            return
        if not self.grade_comp.script:
            return
        self.grade_comp.script.set_weapon(item)

    def _create_grade_component(self, item_type_or_item = None):
        comp = Grade_Viewer(item_type_or_item).component
        self.grade_comp = None
        if not comp:
            return
        else:
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.widthMode = 'PIXEL'
            comp.heightMode = 'PIXEL'
            comp.horizontalAnchor = 'LEFT'
            comp.verticalAnchor = 'TOP'
            comp.visible = True
            self.grade_comp = comp
            if self._item:
                self.grade_comp.script.set_weapon(self._item)
            return comp

    def _create_bb_component(self, item_type_or_bb):
        if isinstance(item_type_or_bb, (int, float, long)):
            item_param = ItemsCatalog.GetItemParam(item_type_or_bb)
            if not item_param.get('isBlackBox', False):
                return None
        comp = BB_Viewer(item_type_or_bb, self._bb_context_win_comp, colorCodes.gray_text, colorCodes.bb_color_chance, 'RobotoCondensedRegular_16.font', self.INTERFACE_ID).component
        if not comp:
            return None
        else:
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.widthMode = 'CLIP'
            comp.verticalAnchor = 'TOP'
            comp.position = (0, 0, 0.5)
            comp.width = 2.0
            comp.visible = False
            return comp