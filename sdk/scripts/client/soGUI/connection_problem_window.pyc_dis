class ConnectionProblemWindow(PyGUIBase):
    factoryString = 'soGUI.ConnectionProblemWindow'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        self._isActive = True
        self._pongCtr = 0
        self._max_pong_ctr = 0
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = 'PIXEL'
        cmp.heightMode = 'PIXEL'
        cmp.colour = (40, 40, 40, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = 50
        cmp.width = 600
        cmp.visible = False
        cmp.textureName = 'textures/default/white.dds'
        cmp.position = (0, 0.99, 0.01)

    def setupContent(self):
        ctext = GUI.Text('asdasd')
        ctext.horizontalPositionMode = ctext.verticalPositionMode = 'CLIP'
        ctext.horizontalAnchor = 'CENTER'
        ctext.verticalAnchor = 'CENTER'
        ctext.font = 'RobotoCondensedRegular_16.font'
        ctext.text = 'te2'
        ctext.colour = (255, 255, 255, 255)
        ctext.position = (0, 0, 0.3)
        self.component.addChild(ctext, 'ctext')
        activity = GUI.Simple('textures/default/white.dds')
        activity.horizontalPositionMode = activity.verticalPositionMode = 'PIXEL'
        activity.horizontalAnchor = 'LEFT'
        activity.verticalAnchor = 'TOP'
        activity.widthMode = 'PIXEL'
        activity.heightMode = 'PIXEL'
        activity.height = 10
        activity.width = 10
        activity.colour = (255, 0, 0, 255)
        activity.position = (2, 2, 0.3)
        self.component.addChild(activity, 'activity')

    def show(self):
        if not self.component.parent:
            BWPersonality.GUICore.worldLayer.delChild('ConnectionProblemWindow')
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'ConnectionProblemWindow')
        self.component.visible = True

    def hide(self):
        self.component.visible = False
        self._isActive = True
        self._pongCtr = 0
        self._max_pong_ctr = 0
        self.component.ctext.text = u''

    def onActivityWarning(self, isActive):
        self._isActive = isActive
        self._update()

    def onPongNotReceived(self, pongCtr, max_pong_ctr):
        self._pongCtr = pongCtr
        self._max_pong_ctr = max_pong_ctr
        self._update()

    def _update(self):
        if not self._pongCtr:
            return self.hide()
        self.component.activity.visible = not self._isActive
        if self._pongCtr:
            self.component.ctext.text = 'connection problem  %s/%s' % (self._pongCtr, self._max_pong_ctr)
        else:
            self.component.ctext.text = 'connection problem ...'
        if not self.component.visible:
            self.show()