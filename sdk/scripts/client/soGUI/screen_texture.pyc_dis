# Embedded file name: ./client/soGUI/screen_texture.py
import BigWorld
import BWPersonality
import GUI
from Helpers.PyGUI import PyGUIBase

class ScreenTexture(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._hide_id = 0
        self._tidstart = 0
        self._startFade_id = 0
        self.setupRoot()
        self.setupContent()
        self.component.visible = True

    def setupRoot(self):
        cmp = self.component
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.width = cmp.height = 2
        cmp.position = (0, 0, 0.01)

    def setupContent(self):
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.colour = (255, 255, 255, 10)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2
        cmp.position = (0, 0, 0.3)
        self.component.addChild(cmp, 'screen_texture')

    def show(self, texture_name, alpha = 255):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild('ScreenTexture')
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'ScreenTexture')
        self.component.screen_texture.textureName = str(texture_name)
        self.component.screen_texture.colour = (255,
         255,
         255,
         alpha)
        self.component.visible = True
        return

    def hide(self):
        self.component.visible = False