# Embedded file name: ./client/soGUI/revive_win/revive_button.py
import GUI
import Keys
import BigWorld
from soGUI import soButton
from Localization import lc
from Helpers.PyGUI.PyGUIBase import PyGUIBase
path_attack = 'soGUI/GUIs/attack.dds'
path_defence = 'soGUI/GUIs/defense.dds'

class revive_icon(PyGUIBase):

    def __init__(self, is_deffender):
        component = GUI.Window()
        PyGUIBase.__init__(self, component)
        component.script = self
        self.component.focus = True
        self.component.moveFocus = True
        self.component.crossFocus = True
        self.component.mouseButtonFocus = True
        self.is_deffender = is_deffender
        self.is_mouse_over = False
        self.enabled = True
        self.selected = False
        cmp = GUI.Simple('')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = 28
        cmp.height = 28
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.5)
        cmp.texture = None
        cmp.visible = True
        self.component.addChild(cmp, 'icon')
        self.load_icon()
        return

    def handleMouseEnterEvent(self, comp):
        self.is_mouse_over = True
        self.update_colors()
        return True

    def handleMouseLeaveEvent(self, comp):
        self.is_mouse_over = False
        self.update_colors()
        return True

    def handleMouseButtonEvent(self, comp, event):
        if not self.enabled:
            return False
        if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
            if self.selected:
                self.deselect()
            else:
                self.select()
        return True

    def update_colors(self):
        if not self.enabled:
            self.component.icon.colour = (45, 45, 45, 255)
            return
        if self.selected:
            self.component.icon.colour = (0, 255, 0, 255)
            return
        if self.is_mouse_over:
            self.component.icon.colour = (210, 210, 210, 255)
        else:
            self.component.icon.colour = (255, 255, 255, 255)

    def select(self):
        pass

    def deselect(self):
        pass

    def load_icon(self):
        texture_name = path_defence if self.is_deffender else path_attack

        def on_texture_loaded(resource):
            if not hasattr(self.component, 'icon'):
                return
            self.component.icon.texture = resource[texture_name]
            self.update_colors()

        BigWorld.loadResourceListBG([texture_name], on_texture_loaded)


class revive_button(PyGUIBase):

    def __init__(self, index, is_deffender):
        component = GUI.Window()
        PyGUIBase.__init__(self, component)
        component.script = self
        self.index = index
        self.is_deffender = is_deffender
        self.setupRoot()

    def disabled(self):
        self.icon.enabled = False
        self.update_colors()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 28
        cmp.height = 28
        cmp.position = (0.0, 0.0, 1.5)
        cmp.textureName = ''
        self.icon = revive_icon(self.is_deffender)
        self.icon.select = self.select
        self.icon.deselect = self.deselect
        cmp = self.icon.component
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = 28
        cmp.height = 28
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.5)
        cmp.texture = None
        cmp.visible = True
        self.component.addChild(cmp, 'icon')
        return

    def update_text(self, count, max_count):
        if count >= max_count:
            self.icon.enabled = False
        self.icon.update_colors()
        if self.icon.selected and not self.icon.enabled:
            self.icon.selected = False
            self.on_select(-1)

    def update_colors(self):
        self.icon.update_colors()

    def select(self):
        self.icon.selected = True
        self.on_select(self.index)
        self.update_colors()

    def deselect(self):
        self.icon.selected = False
        self.on_select(-1)
        self.update_colors()

    def on_select(self, index):
        pass


