from utils import letters_gen
from functools import partial
from Helpers.PyGUI.PyGUIBase import DragWin
from revive_button import revive_button, revive_button_right
from soGUI.base_to_capture_gui.flag_indicator import flag_indicator
PATH = 'scripts/client/data/BaseToCapture/base_spawners_data.pyson'
PATH_SPAWNERS = 'scripts/common/data/BaseToCapture/B2C_spawners.json'
section = ResMgr.openSection(PATH)
SPAWN_DATA = pyson.loads(section.asBinary)
section = ResMgr.openSection(PATH_SPAWNERS)
COORDS_DATA = json.loads(section.asBinary)

class ImageView:

    def __init__(self, component):
        self.component = component
        self._path = None
        return

    def _on_image_loaded(self, path, image):
        if self._path != path:
            return
        self.component.texture = image.produce(0)

    def set_image(self, path):
        self._path = path
        self.component.texture = None
        self.component.textureName = ''
        if self._path:
            BigWorld.loadResourceListBG([path], partial(self._on_image_loaded, self._path))
        return


