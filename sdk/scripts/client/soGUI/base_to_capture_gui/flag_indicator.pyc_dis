    def update_value(self):
        self.component.value_indicator.height = int((self.size - 1) * self._value / 100.0)

    def update_colors(self):
        if self._is_invader:
            self.set_frame_color(COLOR_MY)
            self.component.value_indicator.colour = BACK_COLOR_MY
        else:
            self.set_frame_color(COLOR_ENEMY)
            self.component.value_indicator.colour = BACK_COLOR_ENEMY
        if self._is_owner:
            self.component.letter.colour = COLOR_MY
        else:
            self.component.letter.colour = COLOR_ENEMY

    def set_value(self, value):
        self._value = value
        self.update_value()

    def set_data(self, name, owner, invader):
        self.component.letter.text = name
        self._is_owner = owner
        self._is_invader = invader
        self.update_colors()

