# Embedded file name: ./client/soGUI/soBaseFlagIndicator.py
from Localization import lc
import BigWorld
import GUI
import soGUI
import Helpers.PyGUI as PyGUI
import BWPersonality
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from soGUI.soButton import soButton, soButtonWFT
from soGUI.soList import soList
from soGUI.soList_optimized import soList_optimized
from soGUI.soTextField import soTextField2
from soGUI.soTextField import soTextField3
from soGUI.soTextField import soTxtFieldPropsStructure
from Helpers.PyGUI import PyGUIEvent

class soFlagIndicatorBuying(PyGUIBase):
    factoryString = 'soGUI.soFlagIndicator'
    HEIGHT = 60
    WIDTH = 197

    def __init__(self, component, nameID, attributes):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.name = nameID
        self._have_camera = attributes['camera']
        self._active = attributes['active']
        self._current_cam = attributes['current_camera']
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.WIDTH
        cmp.height = self.HEIGHT
        cmp.position = (0, 0, 0.1)
        cmp.textureName = ''
        cmp.visible = True

    def setupContent(self):
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.colour = (0, 0, 0, 26)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0.0, 1.0)
        self.component.addChild(cmp, 'background')
        cmp.width = 2
        cmp.height = 2
        cmp = GUI.Simple('soGUI/frame/inworld_markers/flagIndicator.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 50
        cmp.position = (0, int(self.HEIGHT / 2 - cmp.height / 2), 0.2)
        self.component.addChild(cmp, 'flagIndicatorPict')
        txt = soTextField2(GUI.Window(), soTxtFieldPropsStructure(autoSize=False, height=24, width=24, vScroll=False, textureless=True, font='arial.ttf'))
        cmp = txt.component
        cmp.verticalPositionMode = cmp.horizontalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.position = (26 - cmp.width // 2, int(self.HEIGHT / 2 - cmp.height / 2 - 2), 0.1)
        txt.onBound()
        txt.setText(self.name)
        self.component.addChild(cmp, 'flagID')

        def onbye():
            self.component.buyBtn.script.setVisualState('disabled')
            self.component.buyBtn.script.setDisabledState(True)
            BWPersonality.GUICore.baseToCaptureGUI.buy_flag(self.name)

        if not self._active:
            btn = soButton(GUI.Window())
            btn.initVSC('soGUI/elements/button_1.xml')
            btn.onClick = onbye
            cmp = btn.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.width = 70
            cmp.height = 24
            cmp.position = (127, int(self.HEIGHT / 2 - cmp.height / 2), 0.2)
            cmp.label.text = lc('BaseToCapture.BUY')
            self.component.addChild(cmp, 'buyBtn')
            btn.onBound()
            btn._updateVisualState()
        if self._have_camera:
            cameraBtn = soButton(GUI.Window())
            cmp = cameraBtn.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.width = 70
            cmp.height = 24
            cmp.position = (55, int(self.HEIGHT / 2 - cmp.height / 2), 0.2)
            if self._current_cam:
                cmp.label.text = lc('BaseToCapture.BACK')
                cameraBtn.onClick = lambda *e: BWPersonality.GUICore.baseToCaptureGUI.go_to_main_plan()
            else:
                cmp.label.text = lc('BaseToCapture.SHOW')
                cameraBtn.onClick = lambda *e: BWPersonality.GUICore.baseToCaptureGUI.go_to_flag(self.name)
            cameraBtn.initVSC('soGUI/elements/button_1.xml')
            cameraBtn.onBound()
            cameraBtn.setVisualState('normal')
            self.component.addChild(cmp, 'cameraBtn')

    def show(self):
        if self.component.parent is None:
            a = 'soFlagIndicator' + self.name
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'soFlagIndicator' + self.name)
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        return

    def hide(self):
        self.component.visible = False