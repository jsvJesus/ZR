    def updateEmblemList(self, data):
        self._emblems_ids = data
        if 0 in data:
            items = [ {'id': x} for x in data[0] ]
            self.itemViewAll.setItems(items)
        if 1 in data:
            items = [ {'id': x} for x in data[1] ]
            self.itemViewMy.setItems(items)

    def _changeEmblem(self):
        self.setStatus(2)

    def _reset(self):
        self.setStatus(1)
        if self._itemID in self._modifieds:
            if 'EMBLEM' in self._modifieds[self._itemID]:
                del self._modifieds[self._itemID]['EMBLEM']
            if not self._modifieds[self._itemID]:
                del self._modifieds[self._itemID]
        self.parent.resetEmblemToStock(self._itemID)
        emblemID = self.model_stok_param['EMBLEMID']
        if emblemID:
            UCManager.ucmanager.loadImg(emblemID, self._drawIcon)
        else:
            self._drawIcon(None)
        return

    def setStatus(self, statusID = 0):
        layers = ['frDisable', 'FrAdd', 'frChange']
        for i, layer in enumerate(layers):
            getattr(self.component, layer).visible = statusID == i

    def onSelectItem(self, itemID, item = None, modifieds = None, model_stok_param = False):
        self._itemID = itemID
        self._item = item
        self._modifieds = modifieds
        self.model_stok_param = model_stok_param
        if not itemID or not item or not model_stok_param:
            self.setStatus(0)
            return
        else:
            emblemID = self._modifieds.get(self._itemID, {}).get('EMBLEM')
            if emblemID:
                self.setStatus(2)
            elif item['MisEmblem']:
                self.setStatus(1)
            else:
                self.setStatus(0)
                return
            self._drawIcon(None)
            if emblemID:
                UCManager.ucmanager.loadImg(emblemID, self._drawIcon)
                return
            if model_stok_param:
                emblemID = model_stok_param['EMBLEMID']
                if emblemID:
                    UCManager.ucmanager.loadImg(emblemID, self._drawIcon)
                    return
            return

    def _drawIcon(self, imgID, feedName = '', texture = None):
        try:
            my_emb = self._emblems_ids.get(1, [])
            if not imgID:
                imgtype = lc('colourItemWindow.TYPE_NONE')
            elif imgID in my_emb:
                imgtype = lc('colourItemWindow.TYPE_MY')
            else:
                imgtype = lc('colourItemWindow.TYPE_STANDART')
            text = colorCodes.inactive_text_color
            text += lc('colourItemWindow.TYPE_CAPTION') + ' '
            text += colorCodes.active_text_color
            text += imgtype
            self.component.FrAdd.emblem_type.text = text
        except:
            traceback.print_exc()

        if imgID and texture:
            self.component.FrAdd.noimg.visible = False
            self.component.FrAdd.loadedTexture.visible = True
            self.component.FrAdd.loadedTexture.texture = texture
        else:
            self.component.FrAdd.noimg.visible = True

    def _openTab(self, show_tab):
        getattr(self.component.frChange, show_tab).visible = True
        self.component.frChange.bStandart.script.setToggleState(False)
        self.component.frChange.bMyPict.script.setToggleState(False)
        self.component.frChange.bNewImg.script.setToggleState(False)
        for tab in self._tabs:
            if tab != show_tab:
                getattr(self.component.frChange, tab).visible = False

        self.component.frChange.frame_itog.visible = show_tab != 'embl_view_upload'
        if show_tab == 'embl_view_upload':
            self.component.frChange.bNewImg.script.setToggleState(True)
        elif show_tab == 'embl_view_my':
            self.component.frChange.bMyPict.script.setToggleState(True)
        elif show_tab == 'embl_view_stand':
            self.component.frChange.bStandart.script.setToggleState(True)

    def emblViewHandler(self, *e):
        pass

    def changeFeed(self, feedName, texture):
        self.parent._drawIcon(-1, feedName, texture)

    def onloadEmblemOk(self, emblemID):
        self.onSelectemblemID(emblemID)
        self._openTab('embl_view_my')

    def emblSlotHandler(self, eventID, slot, isMyPicture = False):
        if ITSLOT.SLOTEVENT_LCLICK != eventID:
            return False
        if isinstance(slot, list):
            return False
        if slot.haveItem():
            emblemID = slot.itemData['id']
            if not emblemID:
                return
            if UCManager.ucmanager.isBannedEmblem(emblemID):
                return
            self.onSelectemblemID(emblemID)

    def onSelectemblemID(self, emblemID):
        if not emblemID:
            return
        else:
            avatar = BigWorld.player()
            model_stok_param = avatar.emblems_colors.get(self._itemID)
            emblemID = int(emblemID)
            if self._itemID not in self._modifieds:
                self._modifieds[self._itemID] = {}
            if 'EMBLEM' not in self._modifieds[self._itemID]:
                self._modifieds[self._itemID]['EMBLEM'] = 0
            self._modifieds[self._itemID]['EMBLEM'] = emblemID
            feedName = UCManager.ucmanager.loadImg(emblemID, self._drawIcon)
            StalkerModel.setFeed(self.parent.dummy_window.getModel(), None, model_stok_param['dye'], feedName)
            return


class EmblemSlot(soItemCacheSlot):
    factoryString = 'soGUI.EmblemSlot'
    mark_state = False

    def take(self):
        pass

    def onRClick(self):
        pass

    def setEmblemIcon(self, imgID, feedName, texture):
        if self.haveItem():
            if texture and self.itemData['id'] == imgID:
                self.component.itemIcon.texture = texture
                self.component.itemIcon.visible = True

    def _applyItemData(self):
        if self.haveItem():
            tid = self.itemData['id']
            self.component.itemIcon.visible = False
            UCManager.ucmanager.loadImg(tid, self.setEmblemIcon)
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemCount.text = ''
            self.component.itemLockInShop.visible = False
            self.component.frameCmp.colour = (255, 255, 255, 255)
            self.lockSlot(False)
            self.item_lock_in_shop = False


class FrameChangeClanEmblemImage(FrameChangeImage):

    def __init__(self, component, parent):
        FrameChangeImage.__init__(self, component, None, parent)
        return

    def onSelectemblemID(self, emblemID):
        if not emblemID:
            return
        emblemID = int(emblemID)
        UCManager.ucmanager.loadImg(emblemID, self.parent._drawIcon)

    def _reset(self):
        self.setStatus(1)
        self.parent._drawIcon(0)

    def LockBtn(self):
        if self.component.FrAdd.bAddImg:
            self.component.FrAdd.bAddImg.script.setDisabledState(True)

    def unLockBtn(self):
        if self.component.FrAdd.bAddImg:
            self.component.FrAdd.bAddImg.script.setDisabledState(False)

    def updateConsumables(self):
        self._uploader.updateConsumables()

    def updatePlayerMoney(self, money):
        text = groupNumber(money) + ' ' + lc('tmplocal.strings.RUB')
        self.component.frChange.frame_itog.my_money.text = text