SORT_ABC = 2
SORT_ABC_REV = 3

class ListPropsStructure(object):

    def __init__(self, width = 200, height = 400, topOffset = 5, leftOffset = 5, lineOffset = 0, elemHeight = 20, scrollWidth = 16, listFont = 'RobotoCondensedRegular_16.font', elemStyle = 'soGUI/elements/listElement.xml', isMultiSel = True, needScroll = True, selectCallBack = None, nuSelectionCB = None, sorted = True, colorFont = (175, 166, 112, 255)):
