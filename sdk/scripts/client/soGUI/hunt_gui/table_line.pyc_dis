# Embedded file name: ./client/soGUI/hunt_gui/table_line.py
import colorCodes as cc
import GUI
from soGUI.soButton import soButton
from soGUI.soTextField import soTextField3
from Localization import lc
from utils import groupNumber
from soGUI.textMoney import getColorMoney
from space_utils import get_short_space_name_by_id, getLokalizedSpaceNameByName
from utils import Listenable

class EventType:
    OnOrderClick, OnCancelClick, OnDonateClick = ((r, 'hunt.table.line') for r in range(3))


class TableLine(soButton, Listenable):

    def __init__(self, component, widths):
        Listenable.__init__(self)
        soButton.__init__(self, component)
        self.initVSC('soGUI/elements/button_1.xml')
        self.onBound()

        def pos_from_index(pos_index):
            pos = 0
            for i in range(pos_index):
                pos += widths[i]

            return pos

        def create_text_field(pos_index):
            comp = GUI.Window()
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.position = (pos_from_index(pos_index), 0, 0.1)
            comp.width, comp.height = widths[pos_index], self.component.height
            self.component.addChild(comp)
            comp.heightMode = 'PIXEL'
            comp.visible = comp.width > 0
            return soTextField3(comp, comp.width, comp.height, comp.width, hScroll=False, vScroll=False, borderWidth=0, vOffset=0, hOffset=0)

        def create_text(pos_index):
            comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
            comp.width, comp.height = widths[pos_index], 2
            comp.colourFormatting = True
            comp.position = (pos_from_index(pos_index) + widths[pos_index] * 0.5, 0, 0.1)
            self.component.addChild(comp)
            comp.visible = comp.width > 0
            return comp

        self._name_text = create_text_field(0)
        self._status_text = create_text(1)
        self._victim_text = create_text_field(2)
        self._hunters_text = create_text(3)
        self._money_text = create_text(4)
        self._time_text = create_text(5)
        self._time_text.colour = cc.active_rgba
        self._space_text = create_text(6)
        self._space_text.colour = cc.highlighted2_rgba
        margin = 12
        space = 12
        width = (widths[7] - margin * 2 - space) / 2
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width, 32
        comp.materialFX = 'BLEND'
        comp.position = (pos_from_index(7) + widths[7] - margin, 0, 0)
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        btn.onBound()
        self._order_btn = btn
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width, 32
        comp.materialFX = 'BLEND'
        comp.position = (pos_from_index(7) + margin, 0, 0)
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        btn.onBound()
        btn.onClick = self._on_donate_click
        comp.label.text = lc('HeadHunter.ui.donate')
        self.component.addChild(comp)

    def _on_donate_click(self):
        data = {'wanted': self._data['wanted'],
         'clan': self._data['clan']}
        self.notify_listeners(EventType.OnDonateClick, data)

    def _on_cancel_click(self):
        data = {'wanted': self._data['wanted']}
        self.notify_listeners(EventType.OnCancelClick, data)

    def _on_order_click(self):
        data = {'wanted': self._data['wanted'],
         'online': bool(self._data['space_id']),
         'reward': self._data['reward']}
        self.notify_listeners(EventType.OnOrderClick, data)

    def set_data(self, data):
        self._data = data
        text = '<font=RobotoCondensedRegular_16.font><alignment=center>' + cc.highlighted_xml + data['wanted']
        if data['clan']:
            text += u'\n{0} {1}'.format(cc.inactive_xml + lc('HeadHunter.ui.clan'), cc.active_xml + data['clan'].decode('utf8'))
        self._name_text.setText(text, immidiate=True)
        self._name_text.component.height = self._name_text.calc_real_pixel_height()
        if data['space_id']:
            self._status_text.text = lc('HeadHunter.ui.online')
            self._status_text.colour = cc.green_rgba
        else:
            self._status_text.text = lc('HeadHunter.ui.offline')
            self._status_text.colour = cc.inactive_rgba
        text = u'<font=RobotoCondensedRegular_16.font><alignment=center>{0}{1}'.format(cc.highlighted_xml, data['victim'])
        if data['vcount'] > 1:
            text += u'\n{0}{1} {2}{3}'.format(cc.inactive_xml, lc('HeadHunter.ui.vcount'), cc.active_xml, data['vcount'])
        self._victim_text.setText(text, immidiate=True)
        self._victim_text.component.height = self._victim_text.calc_real_pixel_height()
        self._hunters_text.text = u'{0} {1}'.format(cc.inactive_hex + lc('HeadHunter.ui.hcount'), cc.active_hex + str(data['hcount']))
        self._money_text.text = groupNumber(data['reward'], "'") + ' ' + lc('tmplocal.strings.RUB')
        self._money_text.colour = getColorMoney(data['reward'])
        self._time_text.text = unicode(data['time']) + ' ' + lc('HeadHunter.ui.hours')
        if data['space_id']:
            self._space_text.text = getLokalizedSpaceNameByName(get_short_space_name_by_id(data['space_id']))
        else:
            self._space_text.text = u'-'
        if data['ordered']:
            self._order_btn.component.label.text = lc('HeadHunter.ui.cancelorder')
            self._order_btn.onClick = self._on_cancel_click
            self.onClick = self._on_cancel_click
        else:
            self._order_btn.component.label.text = lc('HeadHunter.ui.takeorder')
            self._order_btn.onClick = self._on_order_click
            self.onClick = self._on_order_click