# Embedded file name: ./client/soGUI/hunt_gui/hunt_table.py
import GUI
from table_line import TableLine, EventType as LineET
from utils import Listenable
_line_height = 68

class HuntTable(Listenable):

    def __init__(self, component, widths):
        Listenable.__init__(self)
        self.component = component
        self._lines = []
        lines_count = int(self.component.height) / _line_height
        pos_y = 0
        for i in range(lines_count):
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
            comp.width, comp.height = 2, _line_height
            comp.position = (0, pos_y, 0.9)
            pos_y += _line_height
            line = TableLine(comp, widths)
            line.add_listener(self._on_line_event)
            comp.visible = False
            self.component.addChild(comp)
            self._lines.append(line)

    def _on_line_event(self, event_type, data):
        if event_type in (LineET.OnOrderClick, LineET.OnCancelClick, LineET.OnDonateClick):
            self.notify_listeners(event_type, data)

    def set_lines(self, lines_data):
        index = 0
        for line_data in lines_data:
            if index >= len(self._lines):
                break
            self._lines[index].component.visible = True
            self._lines[index].set_data(line_data)
            index += 1

        for i in range(index, len(self._lines)):
            self._lines[i].component.visible = False

    @property
    def rows_count(self):
        return len(self._lines)

    def release(self):
        Listenable.release(self)
        for line in self._lines:
            line.release()