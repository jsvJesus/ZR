# Embedded file name: ./client/soGUI/hunt_gui/header_block.py
import BigWorld
import GUI
from soGUI.soButton import soButton
from Constants import BoardSort
from Localization import lc
from functools import partial
import colorCodes as cc
from soGUI.sales.filters.ui_elements import BilboardEditText
_headers = [{'min_width': 260.0,
  'pref_width': 384.0,
  'text': lc('HeadHunter.ui.header.killer'),
  'sort': BoardSort.Wanted},
 {'min_width': 86.0,
  'pref_width': 185.0,
  'text': lc('HeadHunter.ui.header.status'),
  'sort': BoardSort.Status},
 {'min_width': 128,
  'pref_width': 212,
  'text': lc('HeadHunter.ui.header.victims'),
  'sort': BoardSort.Victims},
 {'min_width': 115,
  'pref_width': 200,
  'text': lc('HeadHunter.ui.header.hunters'),
  'sort': BoardSort.Hunters},
 {'min_width': 125,
  'pref_width': 218,
  'text': lc('HeadHunter.ui.header.reward'),
  'sort': BoardSort.Reward},
 {'min_width': 160,
  'pref_width': 180,
  'text': lc('HeadHunter.ui.header.time'),
  'sort': BoardSort.Elapsed},
 {'min_width': 180,
  'pref_width': 230,
  'text': lc('HeadHunter.ui.header.location'),
  'sort': BoardSort.Location},
 {'min_width': 300,
  'pref_width': 380,
  'text': u'',
  'text': lc('HeadHunter.ui.header.search'),
  'sort': BoardSort.Search}]

class HeaderBlock:

    def __init__(self, component):
        self.component = component
        self._elements = []
        self.on_mode_changed_callback = lambda : None
        for i, data in enumerate(_headers):
            if data['sort'] == BoardSort.Search:
                break
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.width, comp.height = (0, 2)
            comp.position = (0, 0, 0.9)
            btn = soButton(comp)
            comp.label.text = data['text']
            btn.initVSC('soGUI/elements/sale_inactive.xml')
            btn.onBound()
            btn.sort_type = data['sort']
            btn.onClick = partial(self._on_btn_click, btn)
            self.component.addChild(comp)
            text_btn = btn
            string_width = comp.label.stringDimensions(data['text'])[0]
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = (18, 18)
            comp.position = (string_width * 0.5 + 2, 0.1, 0.4)
            btn = soButton(comp)
            btn.setVisualState('normal')
            btn.onBound()
            btn.sort_type = data['sort']
            btn.onClick = partial(self._on_btn_click, btn)
            self.component.addChild(comp)
            arrow_btn = btn
            self._elements.append({'text': text_btn,
             'arrow': arrow_btn})

        pref_widths = [ h['pref_width'] for h in _headers ]
        min_widths = [ h['min_width'] for h in _headers ]
        screen_width = BigWorld.screenWidth()
        total_pref_width = sum(pref_widths)
        total_min_width = sum(min_widths)
        for index in (BoardSort.Hunters, BoardSort.Victims):
            if screen_width < total_min_width:
                total_pref_width -= pref_widths[index]
                total_min_width -= min_widths[index]
                pref_widths[index] = 0
                min_widths[index] = 0

        if screen_width >= total_pref_width:
            change_factor = 1 + (screen_width - total_pref_width) / total_pref_width
            widths = [ w * change_factor for w in pref_widths ]
        elif screen_width >= total_min_width:
            factors = [ pref_widths[i] - min_widths[i] for i in range(len(_headers)) ]
            f_sum = sum(factors)
            factors = [ f / f_sum for f in factors ]
            widths = [ w + factors[i] * (screen_width - total_min_width) for i, w in enumerate(min_widths) ]
        else:
            widths = min_widths
        pos = 0
        for i, element in enumerate(self._elements):
            comp = element['text'].component
            comp.width = widths[i]
            comp.position[0] = pos
            comp.visible = widths[i] > 0
            element['arrow'].component.position[0] += comp.position[0] + comp.width * 0.5
            pos += comp.width

        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.width, comp.height = widths[-1], 2
        comp.position = (pos, 0, 0.9)
        self.component.addChild(comp)
        s_comp = comp
        s_left_margin = 16
        s_space = 8
        s_right_margin = 24
        comp = GUI.Text(_headers[-1]['text'], 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (s_left_margin, 0, 0.5)
        comp.colour = cc.active_rgba
        s_width = comp.stringWidth(comp.text)
        s_comp.addChild(comp)
        width, height = widths[-1] - s_width - s_left_margin - s_space - s_right_margin, 24
        self._edit_text = BilboardEditText(width, height, callback=self._on_filter_callback, vOffset=4)
        comp = self._edit_text.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (s_width + s_left_margin + s_space, 0, 0.5)
        s_comp.addChild(comp)
        self.widths = widths
        self.mode = (None, None, None)
        self.set_mode(BoardSort.Wanted, BoardSort.Forward, None)
        return

    def _on_filter_callback(self, text):
        self.set_mode(self.mode[0], self.mode[1], text and text.lower() or None)
        return

    def set_mode(self, sort_type, direction, filt):
        if self.mode == (sort_type, direction, filt):
            return
        self.mode = (sort_type, direction, filt)
        for element in self._elements:
            if element['text'].sort_type != self.mode[0]:
                element['text'].initVSC('soGUI/elements/sale_inactive.xml')
                element['arrow'].component.visible = False
            else:
                element['text'].initVSC('soGUI/elements/sale_active.xml')
                element['arrow'].component.visible = True
                if direction == BoardSort.Forward:
                    element['arrow'].initVSC('soGUI/elements/sale_arrow_down.xml')
                else:
                    element['arrow'].initVSC('soGUI/elements/sale_arrow_up.xml')
                element['arrow']._updateVisualState()
            element['text']._updateVisualState()

        self.on_mode_changed_callback()

    def _on_btn_click(self, btn):
        if self.mode[0] == btn.sort_type:
            direction = BoardSort.Forward if self.mode[1] == BoardSort.Backward else BoardSort.Backward
            self.set_mode(btn.sort_type, direction, self.mode[2])
        else:
            self.set_mode(btn.sort_type, BoardSort.Forward, self.mode[2])

    def on_hide(self):
        self._edit_text.activate(False)