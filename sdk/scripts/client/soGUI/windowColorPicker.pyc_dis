            self.component.addChild(cmp, 'outcolorLeft_%s' % x)
            leftofset -= cmp.width + 2

    def _set_colors(self, colors):
        self._colors = colors
        self.rgb = self._colors[0]
        self._scroll.setSteps(len(self._colors) - 1)

    def scrollHandler(self, event, data):
        if event == 'RIGHT':
            self.cursor += 1
        elif event == 'LEFT':
            self.cursor -= 1
        elif event == 'hMOVE':
            self.cursor = data
        self.cursor = max(0, min(self.cursor, len(self._colors) - 1))
        self.rgb = self._colors[self.cursor]
        self.component.hScrollR.script.setValue(self.cursor)
        self.out_color = tuple(list(self.rgb) + [255])
        self.component.outcolor.colour = self.out_color
        for x in xrange(1, self.lensubw):
            cmp = getattr(self.component, 'outcolorRight_%s' % x)
            try:
                rcolor = tuple(list(self._colors[self.cursor + x]) + [(self.lensubw - x) * 90])
            except IndexError:
                rcolor = (0, 0, 0, 0)

            cmp.colour = rcolor

        for x in xrange(1, self.lensubw):
            cmp = getattr(self.component, 'outcolorLeft_%s' % x)
            if self.cursor - x >= 0:
                rcolor = tuple(list(self._colors[self.cursor - x]) + [(self.lensubw - x) * 90])
            else:
                rcolor = (0, 0, 0, 0)
            cmp.colour = rcolor

        self.callback_update(self.out_color)
        self.component.txt.text = ','.join(map(str, self.out_color[:3]))

    def setColor(self, colorRGBA):
        self.out_color = colorRGBA
        self.save_color = colorRGBA
        self.rgb = tuple(colorRGBA[:3])
        try:
            self.cursor = self._colors.index(self.rgb)
        except ValueError:
            self.cursor = 0

        self.scrollHandler('hMOVE', self.cursor)

    def handleMouseEvent(self, cmp, event):
        return False

    def handleMouseButtonEvent(self, comp, event):
        key = event.key
        down = event.isKeyDown()
        if key == Keys.KEY_RIGHTMOUSE:
            self._right_handled = down
            return True
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def show(self, colorRGBA, colors, callback_res, callbackUpdate):
        self._set_colors(colors)
        self.callback_res = callback_res
        self.callback_update = callbackUpdate
        self.setColor(colorRGBA)
        self.component.visible = 1

    def forgotCallback(self):
        self.callback_res = lambda *e: 0
        self.callback_update = lambda *e: 0

    def _apply(self):
        self.callback_res(self.out_color)
        self.component.visible = False

    def _cancel(self):
        self.callback_res(None)
        self.component.visible = False
        return

    def hide(self):
        self.component.visible = False