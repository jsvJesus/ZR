        cmp.text = lc('GUI.event_starter.reward')
        self.component.wndFrame.addChild(cmp, 'titleLabel')
        closeBox = soButton(GUI.Window())
        cmp = closeBox.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.component.width - 26, 6, 0.3)
        cmp.script.onClick = self.hide
        closeBox.initVSC('soGUI/elements/closeBox.xml')
        closeBox.onBound()
        closeBox.setVisualState('normal')
        self.component.addChild(cmp, 'closeBox')
        rewards = []
        for key, value in self.reward_data.items():
            if key in ('sender', 'bank'):
                continue
            if not self.reward_data[key]['blackbox']:
                continue
            rewards.append((key, self.reward_data[key]['blackbox']))

        rewards.sort(key=lambda x: x[0])
        index = 0
        for index, (rank, bb_name) in enumerate(rewards):
            cmp = RewardItem(GUI.Window(), rank, bb_name).component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (175, 166, 112, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (10, 38 + 71 * index, 0.3)
            cmp.width = 350
            cmp.height = 64
            self.component.addChild(cmp, 'frame_rank_{0}'.format(index))

        txt = soTextField2(GUI.Window(), soTxtFieldPropsStructure(height=200, width=self.component.width - 20, vScroll=False, textureless=True))
        cmp = txt.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (146, 146, 146, 255)
        cmp.position = (10, 38 + 71 * (index + 1), 0.5)
        txt.setText(colorCodes.gray_text + lc('GUI.event_starter.description'))
        self.component.wndFrame.addChild(cmp, 'description')

    def on_icon_rank_click(self, rank, bb_name):
        if self.reward_info_window:
            self.reward_info_window.hide()
        if rank == u'other':
            reward_text = lc('GUI.event_starter.reward_text_other')
        else:
            reward_text = lc('GUI.event_starter.reward_text').format(rank)
        self.reward_info_window = RewardInfo(GUI.Window(), bb_name, reward_text)
        self.reward_info_window.show()
        return False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'eventReward')
        self.component.visible = True
        return

    def hide(self):
        self.component.visible = False
        if self.reward_info_window:
            self.reward_info_window.hide()
            self.reward_info_window = None
        if self.component.parent:
            BWPersonality.GUICore.worldLayer.delChild('eventReward')
        return


class RewardItem(PyGUIBase):

    def __init__(self, component, rank, bb_name):
        PyGUIBase.__init__(self, component)
        component.script = self
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = 64
        cmp.width = 350
        self.rank = rank
        self.blackbox = bb_name
        self.component.focus = True
        self.component.mouseButtonFocus = True
        self.component.moveFocus = True
        self.component.crossFocus = True
        cmp = GUI.Frame2('soGUI/items/cell.dds')
        cmp.verticalPositionMode = cmp.horizontalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 64
        cmp.height = 64
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.9)
        cmp.visible = True
        self.component.addChild(cmp, 'frameCmp')
        icon_path = EventInWorldUtils.get_reward_icon(rank)
        cmp = GUI.Simple(icon_path)
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 64
        cmp.height = 64
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.3)
        cmp.visible = True
        self.component.addChild(cmp, 'icon_rank')
        if self.rank == u'other':
            reward_text = lc('GUI.event_starter.reward_text_other')
        else:
            reward_text = lc('GUI.event_starter.reward_text').format(self.rank)
        cmp = GUI.Text(reward_text)
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (192, 127, 50, 255)
        cmp.materialFX = 'BLEND'
        cmp.visible = True
        cmp.position = (74, 0, 0.3)
        self.component.addChild(cmp, 'label_reward')

    def handleMouseButtonEvent(self, comp, event):
        if event.isKeyDown():
            self.component.parent.script.on_icon_rank_click(self.rank, self.blackbox)
        return True


