class soEventStartGUI(soReceiveItemsGUI):
    factoryString = 'soGUI.soEventStartGUI'

    def __init__(self, component):
        self.last_time = None
        self.reward_list_window = None
        self.__update_timer_id = None
        self.__start_timer_id = None
        self.__last_start_time = None
        soReceiveItemsGUI.__init__(self, component)
        self.available = False
        return

    def setupControls(self):
        soReceiveItemsGUI.setupControls(self)
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.colour = (146, 146, 146, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, self.component.height - 92, 0.3)
        cmp.text = lc('GUI.event_starter.event_cooldown').format('00:00:00')
        self.component.wndFrame.addChild(cmp, 'cooldown_text')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.colour = (146, 146, 146, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, self.component.height - 55, 0.3)
        self.component.wndFrame.addChild(cmp, 'count_text')
        btn = soButton(GUI.Window())
        cmp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.label.font = 'RobotoCondensedRegular_16.font'
        cmp.label.text = lc('GUI.event_starter.reward')
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 131
        cmp.height = 25
        cmp.position = (0, self.component.height - 168, 0.1)
        cmp.script.onClick = self.show_reward
        self.component.addChild(cmp, 'button_reward')
        btn.onBound()
        btn = soButton(GUI.Window())
        cmp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.label.font = 'RobotoCondensedRegular_16.font'
        cmp.label.text = lc('GUI.event_starter.start')
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 131
        cmp.height = 25
        cmp.position = (0, self.component.height - 17, 0.1)
        cmp.script.setDisabledState(True)
        cmp.script.onClick = self.start_event
        self.component.addChild(cmp, 'button_start')
        btn.onBound()
        descr = '<alignment=center>' + tf3_text_color_gray + lc('GUI.event_starter.decriprion')
        self.component.wndFrame.description.script.setText(descr)

    def start_event(self):
        if not self.current_event or self.current_event.isDestroyed:
            return
        if self.current_event.start_delay > 0:
            self.component.button_start.script.setDisabledState(True)
        self.current_event.cell.check_start()

    def show_reward(self):
        if not self.current_event or self.current_event.isDestroyed:
            return
        data = EventInWorldUtils.get_events_data(self.current_event.event_name)
        if not data or not data.has_key('reward'):
            return
        count = 0
        for key, value in data['reward'].items():
            if key in ('sender', 'bank'):
                continue
            if not value['blackbox']:
                continue
            count += 1

        if not count:
            gui_jokes.askUserOk(lc('GUI.event_starter.reward'), lc('GUI.event_starter.reward_none'))
            return
        self.reward_list_window = EventRewardListWindow(GUI.Window(), data['reward'])
        self.reward_list_window.show()

    def update_positions(self):
        soReceiveItemsGUI.update_positions(self)
        self.component.button_start.position.y = self.component.height - 17
        self.component.button_reward.position.y = self.component.height - 198
        self.component.wndFrame.cooldown_text.position.y = self.component.height - 80
        self.component.wndFrame.count_text.position.y = self.component.height - 50

    def hide(self):
        self.stop_update_timer()
        if self.reward_list_window:
            self.reward_list_window.hide()
            self.reward_list_window = None
        soReceiveItemsGUI.hide(self)
        return

    def update_start_timer(self):
        if not self.__last_start_time:
            return
        if not self.current_event:
            return
        time_left = self.current_event.start_delay - (BigWorld.time() - self.__last_start_time)
        self.component.wndFrame.cooldown_text.colour = (146, 146, 146, 255)
        self.component.wndFrame.cooldown_text.text = lc('GUI.event_starter.start_timer').format(ItemsUtils.timeToStringSec(time_left))
        if time_left > 0:
            self.__start_timer_id = BigWorld.callback(1, self.update_start_timer)
        else:
            self.stop_start_timer(self.current_event)

    def update_left_counter(self, event_starter):
        if self.current_event != event_starter:
            return
        if self.current_event.starters_count > 1:
            self.component.wndFrame.count_text.text = lc('GUI.event_starter.left_count').format(self.current_event.starters_left, self.current_event.starters_count)
            self.component.wndFrame.count_text.colour = (146, 146, 146, 255)
        if self.available and self.current_event.starters_left == 0:
            self.component.button_start.script.setDisabledState(False)

    def set_last_time(self):
        self.stop_update_timer()
        if not self.current_event or self.current_event.isDestroyed:
            return
        if self.__start_timer_id:
            return
        time_left = max(0, self.current_event.cooldown + BWPersonality.gpd.time_diff - time())
        self.component.button_start.script.setDisabledState(True)
        self.available = False
        self.component.wndFrame.cooldown_text.colour = (146, 146, 146, 255)
        self.component.wndFrame.cooldown_text.text = ''
        if self.current_event.cooldown == -1:
            self.component.wndFrame.cooldown_text.text = lc('GUI.event_starter.event_now')
            return
        if time_left == 0:
            self.update_left_counter(self.current_event)
            if self.remaining_items == 0 and (self.current_event.starters_left == 0 or self.current_event.starters_count == 1):
                self.component.button_start.script.setDisabledState(False)
            self.available = True
            self.component.wndFrame.cooldown_text.text = lc('GUI.event_starter.event_available')
            self.component.wndFrame.cooldown_text.colour = (0, 255, 0, 255)
        else:
            self.component.wndFrame.cooldown_text.text = lc('GUI.event_starter.event_cooldown').format(ItemsUtils.timeToStringSec(time_left))
            self.__update_timer_id = BigWorld.callback(1, self.set_last_time)

    def stop_update_timer(self):
        if self.__update_timer_id:
            BigWorld.cancelCallback(self.__update_timer_id)
            self.__update_timer_id = None
        return

    def stop_start_timer(self, event_starter):
        if event_starter != self.current_event:
            return
        else:
            if self.__start_timer_id:
                BigWorld.cancelCallback(self.__start_timer_id)
                self.__start_timer_id = None
            self.__last_start_time = None
            self.set_last_time()
            return

    def start_start_timer(self):
        self.__last_start_time = BigWorld.time()
        self.update_start_timer()

    def update(self, event_starter):
        soReceiveItemsGUI.update(self, event_starter)
        self.set_last_time()

    def on_fail_start(self, event_starter):
        if event_starter != self.current_event:
            return
        self.component.wndFrame.cooldown_text.colour = (255, 0, 0, 255)
        self.component.wndFrame.cooldown_text.text = lc('GUI.event_starter.fail_text')


