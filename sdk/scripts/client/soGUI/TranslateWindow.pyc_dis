    def ruToEng(self):
        text = self.component.edit.script.getRaw().strip()
        if not text:
            return
        trtext = self.translator.translate(text, 'en').decode('utf-8')
        self._translated_text = trtext
        self.component.trtext.script.setText(trtext)

    def engToRu(self):
        text = self.component.edit.script.getRaw().strip()
        if not text:
            return
        trtext = self.translator.translate(text, 'ru').decode('utf-8')
        self._translated_text = trtext
        self.component.trtext.script.setText(trtext)

    def toChat(self):
        BWPersonality.GUICore.showChatConsole()

    def handleDragEnterEvent(self, component, position):
        return True

    def handleDragLeaveEvent(self, component, position):
        return True

    def handleDragStartEvent(self, component):
        x, y = BWPersonality.game.mcursor.position
        self._deltacursor = (x - self.component.position[0], y - self.component.position[1])
        self._repeatMoveToCursor()
        return True

    def handleDragStopEvent(self, component):
        BigWorld.cancelCallback(self._clbID)
        return True

    def handleDropEvent(self, component, position):
        return True

    def _moveToCursor(self):
        x, y = BWPersonality.game.mcursor.position
        x = min(1, max(x - self._deltacursor[0], -1))
        y = min(1, max(y - self._deltacursor[1], -1))
        self.component.position = (x, y, 1.0)

    def _repeatMoveToCursor(self):
        if not self.component.visible:
            return
        elif self.component.parent is None:
            return
        else:
            self._moveToCursor()
            self._clbID = BigWorld.callback(0.01, self._repeatMoveToCursor)
            return

    def show(self, text):
        if localization_object.globalLanguage == 'russian':
            self.hide()
            return
        else:
            if self.component.parent is None:
                BWPersonality.GUICore.worldLayer.delChild('translateWindow')
                BWPersonality.GUICore.worldLayer.addChild(self.component, 'translateWindow')
            self.component.visible = True
            self.component.trtext.script.setText('')
            self._translated_text = ''
            self.component.edit.script.activate(True)
            self.component.edit.script.setValue(text)
            BWPersonality.GUICore.chatConsole.onEditActive(1)
            BWPersonality.GUICore.setBestCursor()
            self.component.position = (0, 0, 1.0)
            self.component.dropFocus = True
            return

    def hide(self):
        self.component.visible = False
        self.component.edit.script.activate(False)
        BWPersonality.GUICore.setBestCursor()
        BigWorld.cancelCallback(self._clbID)