    @FlashTeamWorker.exchanging_method
    def default_settings(self):
        """\xd0\xa1\xd0\xb1\xd1\x80\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xb8\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0."""
        for i in [self._abs_user_settings_path, self._sound_settings_path]:
            if os.path.exists(i):
                try:
                    os.remove(i)
                except Exception:
                    traceback.print_exc()

        return self._default_settings()

    @FlashTeamWorker.exchanging_method
    def sound_settings(self):
        s_list = set(CHANNEL_CONST.sounds.keys())
        full_lits = set(CHANNEL_CONST.const_names.keys())
        self.__sound_settings_cache['active'] = [CHANNEL_CONST.WHISPER]
        if os.path.exists(self._sound_settings_path):
            with open(self._sound_settings_path, 'rb') as fh:
                self.__sound_settings_cache = pyson.loads(fh.read())
        return {'active': self.__sound_settings_cache['active'],
         'locked': list(full_lits - s_list)}

    def externalInterfaceHandler(self, *args, **kws):
        FlashTeamWorker.externalInterfaceHandler(self, *args, **kws)

