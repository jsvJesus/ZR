    @if_it_is_visible
    @if_mouse_cursor_is_free
    def handleKeyEvent(self, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        if not event.isMouseButton() and not self.is_fully_visible:
            return False
        result = super(ChatConsoleFlash, self).handleKeyEvent(event)
        if event.isMouseButton() and event.isKeyUp():
            return False
        if self.is_modal:
            return True
        if self.is_fully_visible:
            return result
        if event.isMouseButton() and self.is_transparent:
            return result
        return False

    def handleMouseButtonEvent(self, comp, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        result = super(ChatConsoleFlash, self).handleMouseButtonEvent(comp, event)
        return result

    def handleMouseEvent(self, comp, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        _result = super(ChatConsoleFlash, self).handleMouseEvent(comp, event)
        if event.dz:
            return _result
        if self.is_modal:
            return True
        if self.is_fully_visible:
            return _result
        return False

    def hide(self):
        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88-\xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82"""
        self.visible = False
        self.component.focus = False

    @FlashTeamWorker.sending_method
