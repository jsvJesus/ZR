def html_user_name_href(user_name):
    """\xd0\xa7\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xb8\xd0\xbc\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f \xd0\xb1\xd1\x8b\xd0\xbb\xd0\xbe \xd1\x81\xd1\x81\xd1\x8b\xd0\xbb\xd0\xba\xd0\xbe\xd0\xb9 \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb5."""
    if isinstance(user_name, str):
        return "<font color='#0082ff'><a href='event:{name}'>{name}</a></font>".format(name=user_name)
    else:
        return u"<font color='#0082ff'><a href='event:{name}'>{name}</a></font>".format(name=user_name)


