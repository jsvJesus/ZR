        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd1\x87\xd0\xb0\xd1\x82."""
        if self.is_modal:
            return None
        else:
            BWPersonality.GUICore.setBestCursor()
            return True

