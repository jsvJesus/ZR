    @FlashTeamWorker.sending_method
    def put_to_chat(self, string):
        """\xd0\x92\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82 \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82."""
        if self.debug_print_off:
            return False
        return string

    @FlashTeamWorker.sending_method
    def print_msg(self, channel_id, text, sender = '', additional = u''):
        """\xd0\x92\xd1\x8b\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb5."""
        if self.debug_print_off:
            return False
        data = self._msg_manager.print_msg(channel_id, text, sender, additional)
        sound_name = CHANNEL_CONST.sounds.get(channel_id)
        if sound_name and channel_id in self.__sound_settings_cache['active']:
            sounds.playSound(sound_name)
        return data

    def print_msg_to_chat(self, channel_id, text, sender = '', additional = u''):
        if self.debug_print_off:
            return False
        if self.is_ready:
            self.print_msg(channel_id, text, sender, additional)
        else:
            self._message_cache.append((channel_id,
             text,
             sender,
             additional))
            BigWorld.callback(1.5, self.check_ready_chat)

    def check_ready_chat(self):
        if self.is_ready:
            for channel_id, text, sender, additional in self._message_cache:
                self.print_msg(channel_id, text, sender, additional)

            self._message_cache = []
        else:
            BigWorld.callback(1.5, self.check_ready_chat)

    @FlashTeamWorker.exchanging_method
    def read_user_settings(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xb8\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0."""

        def appendNewChannels(pickle_data):
            _defaults = self._default_settings()
            channels_default = map(int, _defaults['MainWindow']['channals'])
            channels_known = pickle_data['MainWindow'].get('channels_known', [])
            if channels_known:
                channels_missing = set(channels_default) - set(channels_known)
            else:
                channels_missing = set(channels_default) - set(xrange(11))
                pickle_data['MainWindow']['channels_known'] = channels_default
            pickle_data['MainWindow']['channals'].extend(channels_missing)
            return pickle_data

        user_data = None
        if os.path.exists(self._abs_user_settings_path):
            try:
                with open(self._abs_user_settings_path, 'rb') as fh:
                    loaded_data = pyson.loads(fh.read())
                    user_data = appendNewChannels(loaded_data)
            except Exception:
                traceback.print_exc()

        if user_data is None:
            user_data = self._default_settings()
        print '!!!read_user_settings!!!'
        return user_data

    @FlashTeamWorker.exchanging_method
    def get_colors(self):
        """\xd0\x9d\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0."""
        py_data_section = ResMgr.openSection(self._colors_path)
        data = json.loads(py_data_section.asBinary)
        return data

    @FlashTeamWorker.exchanging_method
    def get_commands(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x89\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xba\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb4 \xd0\xb2 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5 json."""
        return Localization.localization_object.getCommandList()

    @FlashTeamWorker.receiving_method
    def ready(self):
        """\xd0\xa4\xd0\xbb\xd1\x8d\xd1\x88 \xd0\xb2\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x8d\xd1\x82\xd1\x83 \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8e, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xb3\xd0\xbe\xd1\x82\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb8\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd1\x8b."""
        self.hide_chat()
        self.show_notification(' _  ', 0.2)
        self._print_msg_about_help()
        self.is_ready = True
        self.access_level()
        self.sound_settings()

    @FlashTeamWorker.receiving_method
    def set_cursor(self, cursor_data):
        """\xd0\xa3\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xbe\xd1\x80 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x80\xd0\xb5\xd1\x81\xd0\xb0\xd0\xb9\xd0\xb7\xd0\xb0 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0"""
        if cursor_data == 'default':
            if self._current_cursor:
                MouseShaper.set_shape(self._current_cursor)
                self._current_cursor = ''
        else:
            if not self._current_cursor:
                self._current_cursor = 'arrow'
            MouseShaper.set_shape(cursor_data)

    @FlashTeamWorker.sending_method
    def returned_msg(self, msg_data):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xb8\xd0\xb7 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5."""
        return msg_data

    @FlashTeamWorker.receiving_method
    def run_command(self, text):
        """\xd0\x92\xd1\x8b\xd0\xbf\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb4\xd1\x83."""
        text = text.decode('utf-8')
        command_data = text.split()
        if len(command_data) > 1 and command_data[1].lower() in ('/?', '?', '-h', '--help'):
            info = Localization.localization_object.helpForCommand(command_data[0])
            self.print_msg(CHANNEL_CONST.SYSTEM, info)
            return
        player = BigWorld.player()
        player.runCommand(text)

    @FlashTeamWorker.receiving_method
    def report(self, user):
        BWPersonality.GUICore.show_wimp_win(user.decode('utf-8'))

    @FlashTeamWorker.receiving_method
    def update_sounds_settings(self, data):
        self.__sound_settings_cache['active'] = data

    @FlashTeamWorker.receiving_method
    def save_user_settings(self, user_data):
        """\xd0\xa1\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xb8\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0."""
        settings_dir = os.path.dirname(self._abs_user_settings_path)
        if not os.path.exists(settings_dir):
            os.makedirs(settings_dir)
        with open(self._abs_user_settings_path, 'wb') as fh:
            fh.write(pyson.dumps(user_data))
        with open(self._sound_settings_path, 'wb') as fh:
            fh.write(pyson.dumps(self.__sound_settings_cache))

    @FlashTeamWorker.sending_method
    def save_settings(self):
        """\xd0\x9f\xd1\x80\xd0\xb8\xd0\xbd\xd1\x83\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb5 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0"""
        return True

    @FlashTeamWorker.sending_method
    def show_notification(self, text, show_time = 0):
        """\xd0\xbe\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x83\xd0\xb2\xd0\xb5\xd0\xb4\xd0\xbe\xd0\xbc\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88\xd0\xb0 \xd1\x81\xd0\xb2\xd0\xb5\xd1\x80\xd1\x85\xd1\x83 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0"""
        return {'text': text,
         'show_time': show_time}

    @FlashTeamWorker.receiving_method
    def send_msg(self, channel_id, text, receiver = ''):
        """\xd0\x9e\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb8\xd0\xb7 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0."""
        self._msg_manager.send_msg(channel_id, text, receiver)
        self.hideChatOnEnter()

    @FlashTeamWorker.receiving_method
    def set_chatabuse(self, allow):
        """\xd0\xa3\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe\xd1\x8f\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xbc\xd0\xb0\xd1\x82\xd0\xb0."""
        self._msg_manager.chatabuse = allow

    def show(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88-\xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82"""
        self.visible = True
        self.component.focus = True

    def show_chat(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0."""
        self.change_mode('chat')
        BWPersonality.GUICore.setBestCursor()

    def set_cross_focus(self):
        if self.is_half_hidden:
            self.component.crossFocus = False
            self.component.moveFocus = False
            return None
        else:
            self.component.moveFocus = True
            self.component.crossFocus = True
            return None

    @FlashTeamWorker.receiving_method
    def translate(self, text, to_lang):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82."""

        def trans(text, to_lang):
            trtext = self._translator.translate(text, to_lang)
            self._send_translated_text(trtext)

        print 'threading+  chat translate'
        thread = threading.Thread(target=trans, args=(text, to_lang))
        thread.start()

    @FlashTeamWorker.sending_method('translate')
    def _send_translated_text(self, text):
        """\xd0\x92\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x81 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb2\xd0\xb5\xd0\xb4\xd1\x91\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd0\xb0."""
        return text.replace('"', '').strip()

    def _default_settings(self):
        """\xd0\x9d\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0."""
        py_data_section = ResMgr.openSection(self._default_settings_path)
        data = json.loads(py_data_section.asBinary)
        return data

    def _print_msg_about_help(self):
        """\xd0\xa1\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbe \xd1\x82\xd0\xbe\xd0\xbc, \xd1\x87\xd1\x82\xd0\xbe /help \xd1\x80\xd0\xb0\xd1\x81\xd1\x81\xd0\xba\xd0\xb0\xd0\xb6\xd0\xb5\xd1\x82, \xd1\x87\xd1\x82\xd0\xbe \xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb0\xd1\x82\xd1\x8c."""
        help_advice = Localization.lc('PlayerAvatar.client.MSG1')
        self.print_msg(CHANNEL_CONST.SYSTEM, help_advice)

    @FlashTeamWorker.receiving_method
    def on_paste_warning(self):
        warning_msg = Localization.lc('PlayerAvatar.client.chat_msg_paste_warning')
        self.print_msg(CHANNEL_CONST.SYSTEM, warning_msg)

    @FlashTeamWorker.receiving_method
    def showError(self, text):
        pass

    @FlashTeamWorker.receiving_method
    def set_radio_mode(self, value):
        """\xd0\xa3\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe\xd1\x8f\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xbc\xd0\xb0\xd1\x82\xd0\xb0."""
        player = BigWorld.player()
        if not player or player.__class__.__name__ != 'PlayerAvatar':
            return
        player.onRadioSayStart() if value else player.onRadioSayStop()

    @FlashTeamWorker.receiving_method
    def set_ime_mode(self, value):
        """\xd0\xa4\xd0\xbe\xd0\xba\xd1\x83\xd1\x81 \xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xb5 \xd0\xb2\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb0, \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb2\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c/\xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c IME"""
        BigWorld.ime.enabled = value

    @FlashTeamWorker.sending_method
    def ime_event(self, text, candidates, selected_index):
        return {'candidates': candidates,
         'selectedIndex': selected_index,
         'composition': text}