    @FlashTeamWorker.exchanging_method
    def access_level(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x83\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd0\xbd\xd1\x8c \xd0\xb4\xd0\xbe\xd1\x81\xd1\x82\xd1\x83\xd0\xbf\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f."""
        access_level = 0
        player = BigWorld.player()
        if not player or not hasattr(player, 'UserFromMasterPassword'):
            print 'error chat access_level for ', player
            traceback.print_stack()
        if player:
            access_level = player.clientAccessLevel or player.UserFromMasterPassword
        return access_level

