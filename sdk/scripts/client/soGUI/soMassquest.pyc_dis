# Embedded file name: ./client/soGUI/soMassquest.py
import BigWorld
import BWPersonality
import GUI
from Localization import lc
from soGUI.soButton import soButton
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from Helpers.PyGUI import Utils
from Helpers.PyGUI.DraggableComponent import DraggableComponent
import math

class soMassquest(PyGUIBase, DraggableComponent):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        component.script = self
        self._timer_handler = None
        self._reopen_time = None
        self.setupRoot()
        self.setupContent()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 400
        cmp.height = 600
        cmp.position = (0.0, 0.0, 0.1)
        cmp.textureName = ''
        cmp.visible = False
        cmp.filterType = 'POINT'
        cmp.pixelSnap = False
        cmp.dragFocus = True
        self.component.mouseButtonFocus = 1

    def setupContent(self):

        def create_text(text, text_id, position_x, position_y, multiline = False, font = 'RobotoCondensedRegular_16.font'):
            cmp = GUI.Text('')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.verticalAnchor = 'TOP'
            cmp.horizontalAnchor = 'LEFT'
            cmp.font = font
            cmp.colourFormatting = True
            cmp.multiline = multiline
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (position_x, position_y, 0.2)
            cmp.text = text
            self.component.wndFrame.addChild(cmp, text_id)

        def create_stripe(height, stripe_id):
            cmp = GUI.Simple('soGUI/white.dds')
            cmp.colour = (255, 255, 255, 100)
            cmp.materialFX = 'BLEND'
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.width = 340
            cmp.height = 1
            cmp.position = (200, height, 0.2)
            self.component.wndFrame.addChild(cmp, stripe_id)

        cmp = GUI.Frame2('soGUI/frame/basic_frame_1.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.component.width
        cmp.height = self.component.height
        cmp.position = (0, 0, 1.0)
        self.component.addChild(cmp, 'wndFrame')
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/elements/closeBox.xml')
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (393, 6, 0.2)
        btn.onClick = self.onClose
        self.component.wndFrame.addChild(cmp, 'closeBox')
        btn.onBound()
        btn._updateVisualState()
        create_text(u'', 'caption', 50, 40)
        create_stripe(75, 'stripe0')
        create_text(u'', 'status', 50, 90)
        cmp = GUI.Simple('soGUI/frame/massquest/pimp.dds')
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = cmp.height = 15
        cmp.position = (350, 100, 0.3)
        self.component.wndFrame.addChild(cmp, 'pimp')
        create_stripe(120, 'stripe1')
        create_text(lc('Quests.MassQuests.Board.PARTICIPANTS'), 'participants', 50, 140)
        create_text(u'', 'results', 50, 180, multiline=True, font='RobotoCondensedRegular_16.font')
        rewardBtn = soButton(GUI.Window())
        cmp = rewardBtn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = 130
        cmp.height = 29
        cmp.position = (self.component.width - 180, 140, 0.2)
        rewardBtn.initVSC('soGUI/elements/button_1.xml')
        rewardBtn.onBound()
        rewardBtn.setVisualState('normal')
        rewardBtn.onClick = self.onReward
        cmp.label.text = lc('Quests.MassQuests.Board.REWARD_BUTTON')
        self.component.wndFrame.addChild(cmp, 'rewardBtn')
        okBtn = soButton(GUI.Window())
        cmp = okBtn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = 50
        cmp.height = 29
        cmp.position = (self.component.width / 2 - 25, self.component.height - 75, 0.2)
        okBtn.initVSC('soGUI/elements/button_1.xml')
        okBtn.onBound()
        okBtn.setVisualState('normal')
        okBtn.onClick = self.onClose
        cmp.label.text = u'OK'
        self.component.wndFrame.addChild(cmp, 'okBtn')

    def _timer_tick(self):
        self._timer_handler = None
        if not Utils.is_visible_in_hierarchy(self.component) or not self._reopen_time:
            return
        else:
            self._apply_timer_text()
            if BigWorld.time() < self._reopen_time:
                self._timer_handler = BigWorld.callback(1, self._timer_tick)
            return

    def _apply_timer_text(self):
        if self._reopen_time:
            time_to_reopen = max(0, self._reopen_time - BigWorld.time())
            hours = int(math.floor(time_to_reopen / 3600.0))
            time_to_reopen -= hours * 60.0 * 60.0
            minutes = int(math.floor(time_to_reopen / 60.0))
            if time_to_reopen > 0 and not hours and not minutes:
                minutes = 1.0
            self.component.wndFrame.status.text = lc('Quests.MassQuests.Board.STATUS_TIMER').format(hours, minutes)
        else:
            self.component.wndFrame.status.text = lc('Quests.MassQuests.Board.STATUS_COMPLETED')

    def show(self, result, contest_name, is_active, is_completed, mq_id, has_reward, progress, reopen_time):
        self._reopen_time = None
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'massquestScreen')
        self.component.visible = True
        contest_local = lc('Quests.MassQuests.{0}'.format(contest_name if contest_name else 'DEFAULT_NAME'))
        self.component.wndFrame.caption.text = contest_local
        self.component.wndFrame.rewardBtn.script.setDisabledState(not bool(has_reward))
        self.mq_id = mq_id
        if self._timer_handler:
            BigWorld.cancelCallback(self._timer_handler)
            self._timer_handler = None
        if is_active:
            if progress < 0.25:
                local_text_key = 'Quests.MassQuests.Board.STATUS_ACTIVE0'
            elif progress < 0.5:
                local_text_key = 'Quests.MassQuests.Board.STATUS_ACTIVE1'
            elif progress < 0.75:
                local_text_key = 'Quests.MassQuests.Board.STATUS_ACTIVE2'
            else:
                local_text_key = 'Quests.MassQuests.Board.STATUS_ACTIVE3'
            self.component.wndFrame.status.text = lc(local_text_key).format(int(progress * 100))
            self.component.wndFrame.pimp.colour = (0, 150, 0, 255)
        elif is_completed:
            if reopen_time > 0:
                self._reopen_time = BigWorld.time() + reopen_time
                self._timer_tick()
            else:
                self.component.wndFrame.status.text = lc('Quests.MassQuests.Board.STATUS_COMPLETED')
            self.component.wndFrame.pimp.colour = (150, 0, 0, 255)
        else:
            self.component.wndFrame.status.text = lc('Quests.MassQuests.Board.STATUS_PENDIND')
            self.component.wndFrame.pimp.colour = (150, 150, 0, 255)
        self.component.wndFrame.results.text = result.decode('utf-8')
        return

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def onClose(self):
        self.hide()

    def onReward(self):
        self.component.wndFrame.rewardBtn.script.setDisabledState(True)
        BigWorld.player().base.give_massquest_reward(self.mq_id)

    def hide(self):
        self._reopen_time = None
        if self._timer_handler:
            BigWorld.cancelCallback(self._timer_handler)
            self._timer_handler = None
        self.component.visible = False
        BWPersonality.GUICore.mouseAltMode = False
        BWPersonality.GUICore.setBestCursor()
        return