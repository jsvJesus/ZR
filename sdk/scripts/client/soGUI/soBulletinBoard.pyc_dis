# Embedded file name: ./client/soGUI/soBulletinBoard.py
import GUI
import BigWorld
import BWPersonality
from soGUI.soButton import soButton
from Localization import lc
from soGUI.QuestsBoard import QuestsBoard
from soGUI.season_score_board import SeasonScoreBoard
from soGUI.pvp_board import PVPBoard
from soGUI.sales.sales_tab import SalesTab
from soGUI.hunt_gui.hunt_tab import HuntTab
from Helpers.PyGUI.PyGUIBase import Interceptor, WinBehaviour

class soBulletinBoard(Interceptor):
    factoryString = 'soGUI.soBulletinBoard'
    bdata = ('quests', 'sale', 'hunt', 'pvpboard', 'seasonscore')
    DISABLED_BUTTON = ()
    bNames = dict([ (x, lc('soBulletinBoard.%s' % x)) for x in bdata ])

    def __init__(self, component):
        Interceptor.__init__(self, component, interscept_keys=True)
        self.set_behaviours(WinBehaviour.Full)
        self.setupRoot()
        self.setupContent()
        self.curentTab = self.bdata[1]

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        sW, sH = BigWorld.screenSize()
        cmp.width = sW
        cmp.height = sH
        cmp.position = (0, 0, 0.2)
        cmp.dragFocus = True
        self.component.mouseButtonFocus = True
        self.component.focus = True
        cmp.crossFocus = True

    def handleDragEnterEvent(self, *args):
        return True

    def handleDragLeaveEvent(self, *args):
        return True

    def handleDragStartEvent(self, component):
        return True

    def handleDragStopEvent(self, component):
        return True

    def handleDropEvent(self, *args):
        return True

    def handleMouseLeaveEvent(self, cmp):
        return True

    def handleMouseEnterEvent(self, cmp):
        return True

    def handleMouseEvent(self, cmp, event):
        dz = event.dz
        if dz > 0:
            self.scrollCurentTab(1)
            return True
        if dz < 0:
            self.scrollCurentTab(0)
            return True
        return True

    def scrollCurentTab(self, up):
        cmp = getattr(self.component, self.curentTab, None)
        if not cmp:
            return
        else:
            if up:
                if hasattr(cmp.script, 'scrolledUP'):
                    cmp.script.scrolledUP()
            elif hasattr(cmp.script, 'scrolledDOWN'):
                cmp.script.scrolledDOWN()
            return

    def setupContent(self):
        sW, sH = BigWorld.screenSize()
        w = sW
        h = sH - 70
        posw = 0
        FRAME_TEXTURE = 'soGUI/frame/basic_frame_1.dds'
        self.frameCmp = GUI.Frame2(FRAME_TEXTURE)
        self.frameCmp.horizontalPositionMode = self.frameCmp.verticalPositionMode = 'PIXEL'
        self.frameCmp.widthMode = self.frameCmp.heightMode = 'PIXEL'
        self.frameCmp.horizontalAnchor = 'LEFT'
        self.frameCmp.verticalAnchor = 'TOP'
        self.frameCmp.visible = True
        self.frameCmp.colour = (255, 255, 255, 255)
        self.frameCmp.materialFX = 'BLEND'
        self.frameCmp.width = sW
        self.frameCmp.height = sH
        self.frameCmp.position = (0, 0, 0.5)
        self.component.addChild(self.frameCmp, 'frame1')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.text = lc('soBulletinBoard.bulletin')
        cmp.multiline = True
        cmp.position = (sW // 2, 5, 0.5)
        cmp.multiline = True
        self.component.addChild(cmp, 'label_name')
        self.createTabButtons(self.bdata, posw, w)
        closeBox = soButton(GUI.Window())
        cmp = closeBox.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (w - 5, 5, 0)
        cmp.script.onClick = lambda : BWPersonality.GUICore.showBulletinBoard(False)
        closeBox.initVSC('soGUI/elements/closeBox.xml')
        closeBox.onBound()
        closeBox.setVisualState('normal')
        self.component.addChild(cmp, 'closeBox')
        self.quest_board = QuestsBoard()
        self.component.addChild(self.quest_board.component, 'quests')
        self._sales = SalesTab()
        self.component.addChild(self._sales.component, 'sale')
        self._hunt = HuntTab()
        self.component.addChild(self._hunt.component, 'hunt')
        self.pvpboard = PVPBoard(GUI.Window())
        self.component.addChild(self.pvpboard.component, 'pvpboard')
        self.seasonscore = SeasonScoreBoard(GUI.Window())
        self.component.addChild(self.seasonscore.component, 'seasonscore')

    def createTabButtons(self, butParam, posw, w):
        bwidth = w / len(butParam)
        for i, name in enumerate(butParam):
            btn = soButton(GUI.Window())
            cmp = btn.component
            btn.initVSC('soGUI/elements/button_1.xml')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.label.font = 'RobotoCondensedRegular_16.font'
            cmp.label.text = self.bNames.get(name, '???')
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.width = bwidth
            cmp.height = 25
            cmp.position = (posw + i * bwidth, 30, 0.3)
            cmp.script.onClick = lambda name = name: self.setViewTab(name)
            cmp.script.setDisabledState(name in self.DISABLED_BUTTON)
            self.component.addChild(cmp, 'button_%s' % name)
            btn.onBound()
            cmp = GUI.Simple('textures/default/bright_gray.dds')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (255, 255, 255, 120)
            cmp.materialFX = 'BLEND'
            cmp.width = bwidth - 5
            cmp.height = 1
            cmp.position = (posw + i * bwidth + 3, 55, 0.3)
            self.component.addChild(cmp, 'frame_button_%s' % name)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'soBulletinBoard')
        super(soBulletinBoard, self).show()
        self.setViewTab(self.curentTab)
        BWPersonality.game.disable_world_drawing()
        return

    def ready_to_close(self):
        if self.curentTab == 'sale':
            return self._sales.ready_to_close()
        return True

    def hide_private_room_wins(self):
        BWPersonality.GUICore.showCreateRoom(0)
        BWPersonality.GUICore.showFindRoom(0)
        BWPersonality.GUICore.showPVPRooms(0)

    def hide(self):
        if self.component.visible:
            BigWorld.worldDrawEnabled(True)
        self.component.visible = False
        for name in self.bdata:
            cmp_text = getattr(self.component, name, None)
            if not cmp_text:
                continue
            try:
                cmp_text.script.hide()
            except:
                pass

        self.hide_private_room_wins()
        return

    def setViewTab(self, tabname):
        if tabname not in self.bdata:
            raise ValueError, tabname
        self.hide_private_room_wins()
        self.curentTab = tabname
        for name in self.bdata:
            cmp_bframe = getattr(self.component, 'frame_button_%s' % name, None)
            cmp_bframe.colour.alpha = 255 if name == tabname else 120
            cmp_text = getattr(self.component, name, None)
            if not cmp_text:
                continue
            cmp_text.visible = name == tabname
            if cmp_text.visible:
                if hasattr(cmp_text.script, 'show'):
                    cmp_text.script.show()
            elif hasattr(cmp_text.script, 'hide'):
                cmp_text.script.hide()

        return

    def doReposition(self):
        quests_save_data = self.quest_board.save_blob
        sW, sH = BigWorld.screenSize()
        self.component.width = sW
        self.component.height = sH
        for name in self.bdata:
            cmp_text = getattr(self.component, name, None)
            if cmp_text:
                if hasattr(cmp_text.script, 'hide'):
                    cmp_text.script.hide()
                if hasattr(cmp_text.script, 'release'):
                    cmp_text.script.release()

        self.clearAllChildren(self.component)
        self.setupContent()
        self.quest_board.save_blob = quests_save_data
        self.setViewTab(self.curentTab)
        self.updatePVP()
        self.updatePVPSeasonalEventsBoard()
        return

    def hunt_notify(self, code, str_args, int_args):
        self._hunt.hunt_notify(code, str_args, int_args)

    def got_catalog_filtered1(self, *args):
        self._sales.got_catalog_filtered2(*args)

    def updatePVP(self):
        self.pvpboard.setData(BWPersonality.GUICore.bulletinBoardPVPDataSection)

    def updatePVPRooms(self):
        if BWPersonality.GUICore.rooms_win:
            BWPersonality.GUICore.rooms_win.setData(BWPersonality.GUICore.bulletinBoardPVPRoomsDataSection)

    def updatePVPSeasonalEventsBoard(self):
        pass

    def updateRatingPage(self):
        self.seasonscore.update()