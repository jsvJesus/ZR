        cmp.verticalAnchor = 'TOP'
        cmp.label.font = 'RobotoCondensedRegular_16.font'
        cmp.label.text = lc('builder_menu.button_open')
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 120
        cmp.height = 28
        cmp.position = (15, self.component.height - 40, 0.1)
        cmp.script.setDisabledState(False)
        self.component.addChild(cmp, 'button_open')
        btn.onClick = self.open
        btn.onBound()
        btn = soButton(GUI.Window())
        cmp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.label.font = 'RobotoCondensedRegular_16.font'
        cmp.label.text = lc('builder_menu.button_leave')
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 140
        cmp.height = 28
        cmp.position = (self.component.width - 15, self.component.height - 40, 0.1)
        cmp.script.setDisabledState(False)
        self.component.addChild(cmp, 'button_leave')
        btn.onClick = self.leave
        btn.onBound()
        self.settings_window = SettingsBuild(GUI.Window(), self)
        self.settings_window.onBound()
        self.component.addChild(self.settings_window.component, 'settings_window')
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.component.width - 5
        cmp.height = 3
        cmp.colour = (255, 255, 255, 10)
        cmp.materialFX = 'BLEND'
        cmp.position = (2, 2, 0.4)
        self.component.addChild(cmp, 'color_line')
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.width = 2
        cmp.height = 2
        cmp.colour = (255, 255, 255, 200)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.05)
        cmp.visible = False
        self.component.addChild(cmp, 'hide_all')
        return

    def onShowSettings(self, visible = True):
        self.component.hide_all.visible = visible

    def onSelectedTeam(self, team):
        BigWorld.player().box_spawn_color = team
        self.component.color_line.colour = RESP_FLAGS.color(team)

    def itemViewHandler(self, event, data):
        return False

    def update(self):
        self.updateViewer()
        if BigWorld.player().hook_alt_keys:
            self.component.hook_keys.script.setActive()
        else:
            self.component.hook_keys.script.setInactive()

    def updateQuantityBlock(self, quantity = 0):
        self.component.label_quantity.text = 'block: %s' % quantity

    def onStartLoadTimer(self, fromAvatar):
        self._fromAvatar_load = fromAvatar
        if self._load_timer_id:
            BigWorld.cancelCallback(self._load_timer_id)
            self._load_timer_id = 0
        self._load_timer_caption = Constants.TIMEOUT_BUILD + 1
        self._timerWaitOnLoad()

    def _timerWaitOnLoad(self):
        self._load_timer_caption -= 1
        if self._load_timer_caption <= 0:
            self.component.iLabel.text = lc('builder_menu.TITLE_MENU')
            return
        self.component.iLabel.text = lc('builder_menu.TITLE_MENU_WAIT').format(int(self._load_timer_caption), self._fromAvatar_load)
        self._load_timer_id = BigWorld.callback(1.0, self._timerWaitOnLoad)

    def onCancelStartLoadTimer(self, fromAvatar):
        self.component.iLabel.text = lc('builder_menu.TITLE_MENU')
        if self._load_timer_id:
            BigWorld.cancelCallback(self._load_timer_id)
            self._load_timer_id = 0

    def showRemainLoad(self, remain):
        if not remain:
            remain = ''
        self.component.iLabel.text = lc('builder_menu.TITLE_MENU') + u' {0}'.format(remain)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.visible = True
        self.component.position = (0.7, 0.5, 0.3)
        self.setActiveBoxID(0)
        self.update()
        self.component.hook_keys.script.setInactive()
        team = BigWorld.player().box_spawn_color
        self.onSelectedTeam(team)
        return

    def setActiveBoxID(self, active_id):
        self._active_id = active_id
        BigWorld.player().setActiveBoxID(active_id)

    def hide(self):
        self.component.visible = False
        if self._last_camera_node:
            self._last_camera_node = None
            BigWorld.player().resetCamera()
        BWPersonality.GUICore.worldLayer.targettingGUI.visible = True
        return

    def doReposition(self):
        self.component.position = (1, 0.5, 0.3)

    def invite(self):

        def callback(avatar_name):
            if not avatar_name:
                return
            roomID = BigWorld.player().buildRoomID
            if not roomID:
                return
            print 'invitebuild', [avatar_name, roomID]
            BigWorld.player().runCommand(u'/invitebuild %s %s' % (roomID, avatar_name))

        if not BigWorld.player().buildRoomID:
            print 'invitebuild error buildRoomID'
            return
        gui_jokes.inputBox(lc('builder_menu.invite_friend'), subtitle=lc('builder_menu.name_pers'), callback=callback, active=True)

    def leave(self):

        def callback(e):
            if e == gui_jokes.GuiHandler.YES:
                print 'leavebuild'
                BigWorld.player().runCommand(u'/leavebuild')

        gui_jokes.askUserYesNo(lc('builder_menu.exit'), lc('builder_menu.ask_exit'), callback)

    def onHookCbtnChange(self):
        state = self.component.hook_keys.script.isChecked()
        BigWorld.player().hook_alt_keys = state

    def save(self):
        BigWorld.player().saveBuidData(self._fname)

    def saveAs(self):

        def callback_saveas(fname):
            if not fname:
                return
            fname = ''.join((char for char in fname if char not in '\\/:*?<>|%^@"\''))
            fname = u'%s.boxs2' % fname
            full_path = os.path.join(SAVE_PATH, fname)
            if not os.path.exists(full_path):
                self._save(fname)
                return

            def callback_override(e):
                if e == gui_jokes.GuiHandler.YES:
                    self._save(fname)
                else:
                    BigWorld.callback(0, self.saveAs)

            gui_jokes.askUserYesNo(u'', lc('builder_menu.ask_rewrite').format(fname), callback_override)

        gui_jokes.inputBox(lc('builder_menu.label_save_as'), subtitle=lc('builder_menu.subtitle_fname'), callback=callback_saveas, active=True)

    def _save(self, fname):
        self._fname = fname
        self.component.save_name.text = fname
        self.component.button_save.script.setDisabledState(False)
        self.save()

    def _clear_all(self):

        def callback_clear(e):
            if e == gui_jokes.GuiHandler.YES:
                BigWorld.player().clearBuidData()

        gui_jokes.askUserYesNo(u'', lc('builder_menu.ask_clear'), callback_clear)

    def open(self):
        dialog = OpenFileDialog(GUI.Window())
        dialog.show(callback=self._onOpenFile, init_dir=SAVE_PATH, filters=['.boxs', '.boxs2'])

    def _onOpenFile(self, path):
        print '_onOpenFile', [path]
        if not path:
            return
        try:
            BigWorld.player().loadBuidData(path)
        except:
            traceback.print_exc()
            gui_jokes.askUserOk(lc('builder_menu.ERROR'), lc('builder_menu.error_open').format(path))
            return

        fname = os.path.basename(path)
        self._fname = fname
        self.component.save_name.text = fname
        self.component.button_save.script.setDisabledState(False)

    def updateViewer(self):
        self.itemView.setItems(self._blocs_or_cam)

    def slotHandler(self, event, data):
        if event == ITSLOT.SLOTEVENT_LCLICK:
            if data.itemData:
                active_id = data.itemData['boxID']
            else:
                active_id = 0
            if data.itemData and data.itemData.get('camera', False):
                self.setActiveBoxID(0)
                pl = BigWorld.player()
                if active_id:
                    udo = self.camera_nodes[active_id]
                    pl.playCamera(udo)
                    pl.camera_speed = self._speed
                else:
                    pl.resetCamera()
                self._last_camera_node = active_id
            else:
                self.setActiveBoxID(active_id)
            self.updateViewer()
        return False

    def swithTabToFly(self, fly):
        self._isFly = fly
        self.component.bTabBox.script.buttonActive = not fly
        self.component.bTabCam.script.buttonActive = fly
        self.component.bTabBox.script._updateVisualState()
        self.component.bTabCam.script._updateVisualState()
        BWPersonality.GUICore.worldLayer.targettingGUI.visible = not self._isFly
        if not self._isFly:
            self._blocs_or_cam = BOXS
        else:
            if self._speed <= 0:
                self._speed = 0.01
            if self._speed > 10:
                self._speed = 3.5
            self.MouseScrollEvent(0)
            self.camera_nodes = [ (cn.name, cn) for cn in BigWorld.userDataObjects.values() if isinstance(cn, CameraNode.CameraNode) and cn.name and cn.name != 'cs_camera' ]
            self.camera_nodes = dict(self.camera_nodes)
            cameras = self.camera_nodes.keys()
            cameras.sort()
            self._blocs_or_cam = []
            cam_item = {'icon': 'soGUI/maps/Icons/event/box_builder/icon_human.dds',
             'name': 'stop',
             'camera': True,
             'boxID': None}
            self._blocs_or_cam.append(cam_item)
            for cam in cameras:
                cam_item = {'icon': 'soGUI/maps/Icons/misc/icon_camera.dds',
                 'name': cam,
                 'camera': True,
                 'boxID': cam}
                self._blocs_or_cam.append(cam_item)

        if self._last_camera_node:
            self._last_camera_node = None
            BigWorld.player().resetCamera()
        self.setActiveBoxID(0)
        self.updateViewer()
        return

    def MouseScrollEvent(self, val):
        if not self._isFly:
            return False
        step = 0.1
        if BigWorld.isKeyDown(BigWorld.stringToKey('KEY_LCONTROL')):
            step = 0.5
        if BigWorld.isKeyDown(BigWorld.stringToKey('LSHIFT')):
            step = 1.0
        if BigWorld.isKeyDown(BigWorld.stringToKey('LALT')):
            step = 0.01
        if val > 0:
            self._speed += step
        elif val < 0:
            self._speed -= step
        if self._speed < 0:
            self._speed = 0
        if self._speed > 100:
            self._speed = 100.0
        BigWorld.player().camera_speed = self._speed
        self.component.label_speed.text = 'cam speed: %.2f' % self._speed
        if self._speed > 0:
            self.component.label_speed.colour = (175, 166, 112, 255)
        else:
            self.component.label_speed.colour = (200, 100, 100, 255)
        return True