    def _applyItemData(self):
        if self.haveItem():
            self.component.itemIcon.textureName = self.itemData['icon']
            self.component.itemName.text = self.itemData['name']
            if isSelectedBox(self.itemData['boxID']):
                self.component.frameCmpSelect.visible = 1
            else:
                self.component.frameCmpSelect.visible = 0
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemName.text = ''
            self.component.frameCmpSelect.visible = 0

    def take(self):
        pass

    def onDragStart(self):
        return False

    def onDragStop(self):
        return False


