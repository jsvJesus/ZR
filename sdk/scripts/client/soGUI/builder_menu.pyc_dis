        closeBox.onBound()
        closeBox.onClick = self.hide
        closeBox.setVisualState('normal')
        self.component.addChild(cmp, 'closeBox')

    def handleKeyEvent(self, event):
        if event.key == Keys.KEY_ESCAPE:
            self.hide()
            return True
        return False

    def changeTeam(self, ch, team):
        new_team = ch and team
        BWPersonality.GUICore._builder_menu.onSelectedTeam(new_team)

    def onStickyCbtnChange(self):
        state = self.component.sticky_box.script.isChecked()
        BigWorld.player().sticky_box = state

    def onSelectedAngles(self, value):
        BigWorld.player().angle_box = value

    def onSelectedGrid(self, value):
        BigWorld.player().grid_box = value

    def onSelectedColor(self, value):
        component = BWPersonality.GUICore.targettingGUI.component
        component.heapCENTER.colour = value

    def show(self):
        if self.component.visible:
            return
        self.component.visible = True
        player = BigWorld.player()
        if player.sticky_box:
            self.component.sticky_box.script.setActive()
        else:
            self.component.sticky_box.script.setInactive()
        self.component.grid_list.script.setSelectionByValue(player.grid_box, silent=True)
        self.component.angles_list.script.setSelectionByValue(player.angle_box, silent=True)
        team = BigWorld.player().box_spawn_color
        self.changeTeam(0, 0)
        for index in xrange(1, 5):
            rb = getattr(self.component, 'radio_%s' % index)
            if team == index:
                rb.script.setActive()
                self.changeTeam(True, team)

        self._paren_wind.onShowSettings(True)
        self.component.focus = True

    def hide(self):
        self.component.visible = False
        self.component.grid_list.script.showList(False)
        self.component.angles_list.script.showList(False)
        self.component.sh_color.script.showList(False)
        self._paren_wind.onShowSettings(False)
        self.component.focus = False


