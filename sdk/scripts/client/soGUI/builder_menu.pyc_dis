def isSelectedBox(boxID):
    player = BigWorld.player()
    if player and boxID == player.getActiveBoxID():
        return True
    if BWPersonality.GUICore._builder_menu and BWPersonality.GUICore._builder_menu._last_camera_node == boxID:
        return True


