        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.width = 160
        comp.height = 25
        comp.position = (sW / 2 + comp.width / 2 + 10, self.component.height - 90, 0.5)
        self.component.addChild(comp, 'btn_join_room')
        btn.onBound()
        btn.onClick = self._onBtnGoToJoinRoom
        return

    def _onBtnGoToCreateRoom(self):
        BWPersonality.GUICore.showCreateRoom()

    def _onBtnGoToJoinRoom(self):
        BWPersonality.GUICore.showPVPRooms()

    def show(self):
        if not self.component.visible:
            return
        if not self.component.parent.visible:
            return
        self.component.qposition_text.text = ''
        BigWorld.player().getBoardPVPInfo()
        if self._tid:
            BigWorld.cancelCallback(self._tid)
        if self._tid2:
            BigWorld.cancelCallback(self._tid2)
        self._tid = BigWorld.callback(5, self._askQposition)
        self._tid2 = BigWorld.callback(1, self._updateText)

    def _askQposition(self):
        if not self.component.visible:
            return
        if not self.component.parent:
            return
        if not self.component.parent.visible:
            return
        self._tid = BigWorld.callback(5, self._askQposition)
        BigWorld.player().getBoardPVPInfo()

    def _updateText(self):
        if not self.component.visible:
            return
        if not self.component.parent:
            return
        if not self.component.parent.visible:
            return
        self._tid2 = BigWorld.callback(1, self._updateText)
        self.roomView.setItems(self._rooms_info)

    def setData(self, data):
        self._rooms_info = []
        if not data:
            self.roomView.setItems([])
            self.info.setText(u'')
            self.component.qposition_text.text = ''
            return
        for pvpConfID in data['pvp_ids']:
            self._rooms_info.append({'pvpConfID': pvpConfID,
             'is_rating': pvpConfID == data['rating_game'],
             'is_registered': pvpConfID == data['i_registered_id'],
             'season_start': data['season_start']})

        self.roomView.setItems(self._rooms_info)
        datestart = ''
        if data['season_start']:
            datestart = datetime.fromtimestamp(data['season_start'] + BWPersonality.gpd.time_diff).strftime('%d.%m.%Y %H:%M')
        dateend = ''
        if data['season_end']:
            dateend = datetime.fromtimestamp(data['season_end'] + BWPersonality.gpd.time_diff).strftime('%d.%m.%Y %H:%M')
        player = BigWorld.player()
        if player and player.isEventsSpace():
            info = lc('soFlashPVP.new_year_seasoninfo')
        elif data['rating_game']:
            info = lc('soFlashPVP.seasoninfo').format(data['season'], datestart, dateend)
        elif data['season_start'] > BWPersonality.gpd.server_time:
            info = lc('soFlashPVP.seasoninfo_expected').format(data['season'], datestart)
        else:
            info = lc('soFlashPVP.seasoninfo_end').format(data['season'])
        self.info.setText(info)
        qpos_text = ''
        if data['i_registered_id']:
            qpos_text = lc('soFlashPVP.queue_pos')
            title = pvp_inst_config.configs[data['i_registered_id']]['title']
            title = lc(title)
            qpos_text = qpos_text.format(title=title, all=data['queue_size'])
        self.component.qposition_text.text = qpos_text

    def slotHandler(self, *e):
        pass

    def viewHandler(self, *e):
        pass