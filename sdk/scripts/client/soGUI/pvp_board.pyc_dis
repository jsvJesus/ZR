        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (0, 0, 0, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 2
        cmp.height = 2
        cmp.position = (0, 0, 1)
        self.component.addChild(cmp, 'bg')
        PVPSlot.SLOTWIDTH = sW - 20
        rows = int((self.component.height - 10) // PVPSlot.SLOTHEIGHT)
        rows = max(1, rows)
        self.roomView = soItemView(GUI.Window(), PVPSlot, slot_eventsHandler=self.slotHandler, eventsHandler=self.viewHandler, rowWidth=1, cols=1, rows=rows, vScroll=True, hScroll=False, borderWidth=0, parent_script=self)
        comp = self.roomView.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.position = (3, 3, 0.5)
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'room_view')
        self.roomView.onBound()
        self.roomView.setRestrictingComponent(None)
        self.roomView.setItems(None)
        self.info = soTextField3(GUI.Window(), width=sW - 20, height=60, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=1, vOffset=2, hOffset=2, textureless=0, autosize=0)
        cmp = self.info.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (20, self.component.height - 60, 0.2)
        self.component.addChild(cmp, 'info')
        self.info.onBound()
        comp = GUI.Text(u'\u0412\u044b \u0437\u0430\u043f\u0438\u0441\u0430\u043b\u0438\u0441\u044c \u043d\u0430 \u0417\u0430\u0445\u0432\u0430\u0442 \u0444\u043b\u0430\u0433\u0430. \u0412\u0430\u0448\u0430 \u043f\u043e\u0437\u0438\u0446\u0438\u044f N/N')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'CENTER'
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.colour = (100, 100, 100, 255)
        comp.materialFX = 'BLEND'
        comp.position = (25, self.component.height - 70, 0.1)
        self.component.addChild(comp, 'qposition_text')
        btn = soButton(GUI.Window())
        comp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('soFlashPVP.btn_create_room')
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.width = 160
        comp.height = 25
        comp.position = (sW / 2 - comp.width / 2 - 10, self.component.height - 90, 0.5)
        self.component.addChild(comp, 'btn_create_room')
        btn.onBound()
        btn.onClick = self._onBtnGoToCreateRoom
        btn = soButton(GUI.Window())
        comp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
