        self.desc = soTextField3(GUI.Window(), width=self.SLOTWIDTH - 300, height=self.SLOTHEIGHT - 30, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=1, vOffset=2, hOffset=2, textureless=0, autosize=0)
        cmp = self.desc.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (232, 28, 0.2)
        self.component.addChild(cmp, 'desc')
        self.desc.onBound()
        self.desc.setText(u'')
        btn = soButton(GUI.Window())
        cmp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.label.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 100
        cmp.height = 25
        cmp.position = (115, 140, 0.1)
        cmp.script.setDisabledState(False)
        self.component.addChild(cmp, 'button_reg')
        btn.onBound()
        btn.onClick = self._on_btn_registerPVP

    def _on_btn_registerPVP(self):
        if not self.haveItem():
            return
        player = BigWorld.player()
        if self.itemData['is_registered']:
            player.base.unregisterPVP()
        else:
            if player.in_party():
                player._registerPVP_func = partial(player.base.registerPartyPVP, self.itemData['pvpConfID'])
            else:
                player._registerPVP_func = partial(player.base.registerPVP, self.itemData['pvpConfID'])
            player._registerPVP_func()

    def _applyItemData(self):
        self.component.label.text = u''
        self.component.desc.visible = False
        self.component.button_reg.visible = False
        self.component.img.visible = False
        self.component.is_rating.visible = False
        if self.haveItem():
            self.component.desc.visible = True
            self.component.img.visible = True
            pvpConfID = self.itemData['pvpConfID']
            self.component.is_rating.visible = self.itemData['is_rating']
            conf = pvp_inst_config.configs[pvpConfID]
            self.component.img.textureName = conf['icon']
            self.component.label.text = lc(conf['title'])
            season_start = self.itemData['season_start']
            time_diff = BWPersonality.gpd.time_diff
            geometry_info = pvp_inst_config.getGeometryInfo(pvpConfID, -time_diff, season_start)
            desc = lc(conf['desc'])
            space = lc(geometry_info['geometry_lc'])
            time_left = ''
            if geometry_info['change_delay'] > 0:
                time_left = ItemsUtils.timeToStringSec(geometry_info['change_delay'])
            desc = desc.format(space=space, time_left=time_left)
            self.desc.setText(desc)
            self.component.button_reg.visible = True
            if self.itemData['is_registered']:
                self.component.button_reg.label.text = lc('soFlashPVP.btn_unreg')
            else:
                self.component.button_reg.label.text = lc('soFlashPVP.btn_reg')


class PVPBoard(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        self._tid = None
        self._tid2 = None
        self._rooms_info = []
        component.script = self
        self.setupContent()
        return

    def setupContent(self):
        sW, sH = BigWorld.screenSize()
        up = 56
        self.component.widthMode = 'PIXEL'
