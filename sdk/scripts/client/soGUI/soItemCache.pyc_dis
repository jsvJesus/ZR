        self.create_droplet()
        self._create_multiselector()

    def setupColoredEmblem(self):
        if not hasattr(self.component, 'itemColored'):
            cmp = GUI.Simple('soGUI/maps/Icons/icon_item_painted.dds')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'RIGHT'
            cmp.verticalAnchor = 'TOP'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.width = self.component.width / 5
            cmp.height = self.component.height / 5
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (self.component.width, cmp.height / 2, 0.7)
            cmp.visible = 0
            self.component.addChild(cmp, 'itemColored')
        if not hasattr(self.component, 'itemEmblem'):
            cmp = GUI.Simple('soGUI/maps/Icons/icon_item_label.dds')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'RIGHT'
            cmp.verticalAnchor = 'TOP'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.width = self.component.width / 5
            cmp.height = self.component.height / 5
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (self.component.width - 12, cmp.height / 2, 0.0)
            cmp.visible = 0
            self.component.addChild(cmp, 'itemEmblem')

    def checkTransferItem(self):
        if itemInGiftSend(self.itemData):
            self.component.frameCmp.colour = (150, 255, 150, 255)
            return True
        self.component.frameCmp.colour = (255, 255, 255, 255)

    def _applyItemData(self):
        soItemSlot._applyItemData(self)
        self.component.corner.visible = False
        if self.haveItem():
            item_type = self.itemData['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            item_params = ItemsCatalog.GetItemParam(item_type)
            if not ItemsUtils.GetIconName(self.itemData):
                iconName = 'nottexture.dds'
                if BWPersonality.GUICore.iconTextures is not None:
                    if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                        if BWPersonality.GUICore.iconTextures.has_key(iconName):
                            self.component.itemIcon.texture = BWPersonality.GUICore.iconTextures[iconName]
                        else:
                            self.component.itemIcon.textureName = iconName
                else:
                    self.component.itemIcon.textureName = iconName
                countStr = ItemsUtils.GetDisplayValue(self.itemData)
                player = BigWorld.player()
                item_lock = player.ItemLocked(self.itemData)
                item_lock_in_shop = player.ItemLockedByShop(self.itemData)
                self.component.itemCount.text = countStr
                self.item_lock_in_shop = item_lock_in_shop
                in_send_gift = self.checkTransferItem()
                self.lockSlot(item_lock or item_lock_in_shop or in_send_gift)
                if item_lock_in_shop:
                    self.component.itemLockInShop.visible = True
                    self.component.drop.visible = False
                if ItemsUtils.IsQuestItem(self.itemData):
                    self.component.corner.colour = (255, 138, 0, 255)
                    self.component.corner.visible = True
                elif ItemsUtils.IsDungeonItem(self.itemData):
                    self.component.corner.colour = (66, 161, 255, 255)
                    self.component.corner.visible = True
                elif ItemsUtils.IsItemFixed(self.itemData, entity=player) or ItemsUtils.dropIsBlocked(self.itemData):
                    self.component.corner.colour = (255, 0, 0, 255)
                    self.component.corner.visible = True
                if self.itemData.get('complexItemID', 0) > 0:
                    item_state = ItemsUtils.GetItemConditionRatio(player, self.itemData)
                    if item_state <= 0.5:
                        self.component.itemBroken.visible = True
                    else:
                        self.component.itemBroken.visible = False
                if item_class == ItemsCatalog.ARTIFACT:
                    depleet_time = ItemsUtils.GetArtefactDepleetionTime(self.itemData, item_params, BWPersonality.gpd.time_diff)
                    inconstantParam = ItemsUtils.GetComplexItemInconstanParams(self.itemData)
                    self.component.itemBroken.visible = (inconstantParam.get(ItemsCatalog.INC_ARTEFACT_DEAD, 0) or depleet_time < 0.0 or depleet_time is None) and True
            emblem = ItemsUtils.getItemEmblem(self.itemData)
            colorise = ItemsUtils.getItemColorise(self.itemData)
            self.component.itemColored.visible = bool(colorise) or bool(ItemsUtils.getTintID(self.itemData))
            self.component.itemEmblem.visible = bool(emblem)
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemCount.text = ''
            self.component.itemLockInShop.visible = False
            self.component.itemBroken.visible = False
            self.component.frameCmp.colour = (255, 255, 255, 255)
            self.lockSlot(False)
            self.item_lock_in_shop = False
            self.component.itemColored.visible = False
            self.component.itemEmblem.visible = False
        self.set_drag_proxy_visual(self.component.itemIcon.texture, self.multiselected)
        return

    def take(self):
        data = {'item_ids': [self.itemData['complexItemID']]}
        BWPersonality.GUICore.itemCacheEvent(ITEM_CACHE.EVENT_TAKE, data)

    def onDragStart(self):
        if self.haveItem():
            self.set_drag_proxy_visual(self.component.itemIcon.texture, self.multiselected)
            self.dragProxy.visible = True
            return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        return True

    def lockSlot(self, doLock):
        soItemSlot.lockSlot(self, doLock)
        if self.locked:
            self.component.itemIcon.colour = (125, 125, 125, 255)
        else:
            self.component.itemIcon.colour = (255, 255, 255, 255)

    def handleMouseLeaveEvent(self, comp):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        return soItemSlot.handleMouseLeaveEvent(self, comp)

    def handleMouseEnterEvent(self, comp):
        if self.haveItem():
            from Inventory import Inventory
            item_string = Inventory.GetItemString(self.itemData)
            if not item_string:
                return soItemSlot.handleMouseEnterEvent(self, comp)
            BWPersonality.GUICore.showToolTip(cc.tf3_regular_text_color + item_string, delay=0)
        elif BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        return soItemSlot.handleMouseEnterEvent(self, comp)


