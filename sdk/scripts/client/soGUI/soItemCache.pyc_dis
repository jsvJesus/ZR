class soItemCacheScreen(PyGUIBase, DraggableComponent, GUIPositions):
    factoryString = 'soGUI.soItemCacheScreen'
    ROWS = 5
    COLS = 6

    @property
    def window_name(self):
        return 'itemCache'

    def __init__(self, component):
        self.cache_mode = 0
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        GUIPositions.__init__(self)
        component.script = self
        self._selected_npc = None
        self.ROWS = BWPersonality.settings.GUISettings.getStoreSize()[1]
        self.COLS = BWPersonality.settings.GUISettings.getStoreSize()[0]
        self.WIDTH = 24 + self.COLS * 64
        self.HEIGTH = 134 + self.ROWS * 64 + line_width * 2
        self._saved_scrolling = {}
        self._blocked_items = {}
