def itemInGiftSend(item):
    if BWPersonality.GUICore.item_in_gift_send(item):
        return True
    return False


def itemFilterFunction(item_sequence, filter_integer, filter_text, sort):
    """\xd0\xa4\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd1\x80\xd1\x82\xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbf\xd0\xbe \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xb0\xd0\xbc.
    item_sequence - \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9 (\xd0\xb2\xd0\xb8\xd0\xb4 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8f \xd1\x81\xd0\xbc\xd0\xbe\xd1\x82\xd1\x80\xd0\xb5\xd1\x82\xd1\x8c \xd0\xb2 ItemsUtils.CreateComplexItem)
    filter_integer - \xd0\xb1\xd0\xb8\xd1\x82\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xbc\xd0\xb0\xd1\x81\xd0\xba\xd0\xb0 \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xbe\xd0\xb2
    """

    def is_valid_filtertext(_filter_text, item_type):
        if not _filter_text:
            return True
        else:
            is_filter_short = BWPersonality.settings.optionalSettings.items_filter_search_in_short
            friendly_name_long = ItemsUtils.GetItemName(item_type, fGetShortName=False).lower()
            if not is_filter_short:
                return _filter_text in friendly_name_long
            friendly_name_short = ItemsUtils.GetItemName(item_type, fGetShortName=True).lower()
            return _filter_text in friendly_name_short or _filter_text in friendly_name_long

    filter_text = filter_text.lower()
    item_list = []
    for item in item_sequence:
        item_category = ItemsCatalog.GetItemCategory(item['complexItemType'])
        if ItemsUtils.IsQuestItem(item):
            item_category = 'quest_item_category'
        filter_bit = IC.get_filter(item_category)
        if (filter_bit is None or filter_integer & filter_bit) and is_valid_filtertext(filter_text, item['complexItemType']):
            item_list.append(item)

    player = BigWorld.player()

    def _sort_items(items):

        def comparator(item):
            item_param = ItemsCatalog.GetItemParam(item['complexItemType'])
            value = item_param.get('SortID', 0)
            if player.ItemLockedByShop(item):
                value -= ItemsCatalog.sort_ids_number
            return value

        return sorted(items, key=comparator)

    if sort:
        return _sort_items(item_list)
    else:
        return item_list


class soItemCacheSlot(soItemSlot):
    factoryString = 'soGUI.soItemCacheSlot'
    SLOTWIDTH = 64
    SLOTHEIGHT = 64
    show_special_context_actions = True

    def __init__(self, component, slotIndex, itemData = None):
        soItemSlot.__init__(self, component, slotIndex, itemData, centerDProxy=True)
        self.item_lock_in_shop = False
        self.cache_mode = -1
        component.script = self
        self.interfaceID = BWPersonality.GUICore.GUI_ID_ITEMCACHE
        self.dragProxy = self.component.dragProxy
        self.proxyHolder = self.component
        self.proxyName = 'dragProxy'
        self._onDragStart = self.onDragStart
        self._onDragStop = self.onDragStop
        self.toolTip = None
        self.setupColoredEmblem()
        return

    def hideToolTip(self):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()

    def showToolTip(self):
        player = BigWorld.player()
        if not player:
            return
        if not self.itemData:
            self.hideToolTip()
            return

    def onRClick(self):
        if not self.itemData:
            return
        if BigWorld.player().cacheMode != ItemsUtils.CACHE_MODE_SAFEBOX:
            return
        if self.itemData['fromEntityID'] != 0:
            return
        complexItemID = self.itemData['complexItemID']
        item_type = self.itemData['complexItemType']
        actions = {('item_info', complexItemID): lc('Inventory.INFO')}
        if not itemInGiftSend(self.itemData) and self.show_special_context_actions:
            if BWPersonality.GUICore.itemCacheGUI.isCurrentTrader():
                if self.item_lock_in_shop:
                    actions['cancel_sale', complexItemID] = lc('GUI.itemCache.cancelSale')
                else:
                    if not ItemsUtils.IsItemFixed(self.itemData, entity=BigWorld.player()):
                        actions['sale', complexItemID] = lc('GUI.itemCache.sale')
                    item_inconstant_param = ItemsUtils.GetComplexItemInconstanParams(self.itemData)
                    item_class = ItemsCatalog.GetItemClass(item_type)
                    if item_class in [ItemsCatalog.AMMO, ItemsCatalog.EXPLOSION]:
                        if item_inconstant_param.get(ItemsCatalog.INC_ROUND_NUMBER, 0) > 1:
                            actions[ItemsCatalog.CAN_SPARE, complexItemID] = lc('Inventory.client.DIVIDE')
                    elif item_class == ItemsCatalog.LOOT:
                        if item_inconstant_param.get(ItemsCatalog.INC_WARE_NUMBER, 0) > 1:
                            actions[ItemsCatalog.CAN_SPARE, complexItemID] = lc('Inventory.client.DIVIDE')
        if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and BigWorld.player().isAdminAccess():
            actions['copy_id', complexItemID] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c ItemID %s' % complexItemID
            actions['copy_type', complexItemID] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c ItemType %s' % item_type
            actions['copy_itemNameLC', complexItemID] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u043c\u044f'
            var_name = ItemsCatalog.GetItemVarName(item_type)
            if var_name:
                actions['copy_itemName', complexItemID] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c %s' % var_name
        interfaceID = self.interfaceID
        BWPersonality.GUICore.showContextMenu(interfaceID, actions, self.itemData)

    def setupRoot(self):
        cmp = self.component
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.SLOTWIDTH
        cmp.height = self.SLOTHEIGHT
        cmp.dragFocus = True
        cmp.dropFocus = True
        cmp.crossFocus = True
        cmp.moveFocus = True
        cmp.mouseButtonFocus = True

