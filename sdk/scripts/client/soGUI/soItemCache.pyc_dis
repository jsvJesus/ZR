        component.height = 50
        component.materialFX = 'BLEND'
        self._filter_box = FilterSet(component, self._filter_changed, quests_button=True)
        self.component.addChild(component)

    def _filter_text_changed(self, text):
        self.filterText = text
        self.redrawItems()

    def _check_box_click(self):
        self._sort = self._autosort_checkbox.isChecked()
        BWPersonality.settings.setSetting('itemcache_autosort', self._sort)
        self.redrawItems()

    def _filter_changed(self, filter_mask):
        self.filterMask = ~filter_mask
        self.redrawItems()

    def onSelectedTo(self, attachment):
        selected_npc = self.elements[attachment][1]
        if selected_npc == self._selected_npc:
            return
        self._selected_npc = selected_npc
        if BWPersonality.GUICore.is_gifts_win_visible():
            BWPersonality.GUICore._gifts_win.on_cur_bank_changed()
        x, y = self._saved_scrolling.get(self._selected_npc, [0, 0])
        self.component.itemView.script.setScroll(x, y)
        current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', 'None')
        if BWPersonality.GUICore.inventoryGUI:
            lock_invent = self._selected_npc != current_trader_name
            BWPersonality.GUICore.inventoryGUI.lockWindow(lock_invent)
        self.update()

    def setListNPCNames(self):
        npc_name_list = self.component.npc_name_list.script
        npc_name_list.clear()
        if BWPersonality.GUICore.itemCacheDataSection is None:
            return
        else:
            current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', 'None')
            if not _NPCs.getProfession(current_trader_name):
                current_trader_name_lc = current_trader_name
                self.component.current_trader_name.text = lc('GUI.itemCache.current_vendor') + u' {0}'.format(current_trader_name_lc)
                data = []
                selected_id = 0
                index = -1
                currenr_found = False
                player = BigWorld.player()
                if not player or player.__class__.__name__ != 'PlayerAvatar':
                    return
                for index, trader_name in enumerate(player.KnowingStorages):
                    if not _NPCs.getProfession(trader_name):
                        npc_localise = trader_name
                        data.append([index, npc_localise, trader_name])
                        selected_id = trader_name == current_trader_name and index
                        currenr_found = True

                selected_id = currenr_found or index + 1
                data.append([selected_id, current_trader_name_lc, current_trader_name])
            self.elements = dict(map(lambda x: (x[0], x[1:]), data))
            npc_name_list.addElements(data)
            npc_name_list.setSelectionByValue(selected_id)
            self._npc_list_callback = 0
            return

    def slotHandler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DRAGENTER:
            if data[1].factoryString in ('soGUI.soInventorySlot2', 'soGUI.soTransferItemSlot', 'soGUI.ItemGiftSlot'):
                return True
            return False
        if event == ITSLOT.SLOTEVENT_DROP:
            slot = data[1]
            if slot.factoryString == 'soGUI.soTransferItemSlot':
                slot.take()
                return True
            elif slot.factoryString == 'soGUI.soInventorySlot2':
                if slot.haveItem():
                    item_ids = slot.get_multiselection()
                    if item_ids:
                        if self.cache_mode not in [ItemsUtils.CACHE_MODE_CONTAIER, ItemsUtils.CACHE_MODE_CREATURE] and self._check_reading_bank():
                            BWPersonality.GUICore.inventoryGUI.add_block_multiple_items(item_ids)
                            if item_ids[0]:
                                BWPersonality.GUICore.inventoryGUI.ignore_unblock_trigger = item_ids[0]
                    items = ItemsUtils.get_multiple_items_by_ids(BigWorld.player(), item_ids)
                    if items:
                        BWPersonality.GUICore.itemCacheEvent(ITEM_CACHE.EVENT_GIVE, items)
                return True
            elif slot.factoryString == 'soGUI.ItemGiftSlot':
                slot.on_itemcache_drop()
                return True
            else:
                return False
        if event == ITSLOT.SLOTEVENT_DRAGSTART:
            if data.factoryString == 'soGUI.soItemCacheSlot':
                data.lockSlot(True)
                return True
        if event == ITSLOT.SLOTEVENT_DRAGSTOP:
            if data.factoryString == 'soGUI.soItemCacheSlot':
                if data.itemData and data.itemData['complexItemID'] not in self._blocked_items:
                    data.lockSlot(False)
                return True
        if event == ITSLOT.SLOTEVENT_MOUSEBUTTON:
            player = BigWorld.player()
            if player.cacheMode != ItemsUtils.CACHE_MODE_SAFEBOX:
                return
            if data[1].key == Keys.KEY_MIDDLEMOUSE:
                if data[1].isKeyDown() and data[0].itemData:
                    complex_item = data[0].itemData
                    item_class = ItemsCatalog.GetItemClass(complex_item['complexItemType'])
                    if item_class in (ItemsCatalog.EXPLOSION, ItemsCatalog.LOOT, ItemsCatalog.AMMO):
                        if ItemsUtils.GetItemNumber(complex_item) > 1 and ItemsUtils.CheckMaxItemNumber(player, 1):
                            player.suggest_spare_item_cache(complex_item)
        return False

    def itemViewHandler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DRAGENTER:
            if data[1].factoryString in ('soGUI.soInventorySlot2', 'soGUI.soTransferItemSlot', 'soGUI.ItemGiftSlot'):
                return True
        if event == ITSLOT.SLOTEVENT_DROP:
            if data[1].factoryString in ('soGUI.soInventorySlot2', 'soGUI.soTransferItemSlot', 'soGUI.ItemGiftSlot'):
                return True
        return False

    def _check_reading_bank(self):
        p = BigWorld.player()
        bank_id = p.cacheObjectID
        entity = BigWorld.entities.get(bank_id, None)
        if entity and GiftBankUtils.bank_is_only_read(entity.npcName):
            return False
        else:
            return True

    def _setItems(self, items):
        self.component.itemView.script.setItems(items)

    def on_change_items(self, item_ids):
        for item_id in item_ids:
            if item_id in self._blocked_items:
                del self._blocked_items[item_id]
                slot = self.component.itemView.script.find_slot_by_multiselection_identifier(item_id)
                if slot:
                    slot.lockSlot(False)

    def onChangeItem(self, item):
        self.on_change_items([item['complexItemID']])

    def del_block_multiple_items(self, item_ids):
        for item_id in item_ids:
            if item_id in self._blocked_items:
                del self._blocked_items[item_id]
            slot = self.component.itemView.script.find_slot_by_multiselection_identifier(item_id)
            if slot:
                slot.lockSlot(False)

    def add_block_multiple_items(self, item_ids):
        for item_id in item_ids:
            self._blocked_items[item_id] = BigWorld.time()
            slot = self.component.itemView.script.find_slot_by_multiselection_identifier(item_id)
            if slot:
                slot.lockSlot(True)

    def find_items_by_ids(self, item_ids):
        item_ids = set(item_ids)
        return [ item for item in self.component.itemView.script.items if item['complexItemID'] in item_ids ]

    def isCurrentTrader(self):
        current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', None)
        return self._selected_npc == current_trader_name

    def update(self, need_redraw_name = False):
        self.component.lockLayer.visible = False
        if self.cache_mode == ItemsUtils.CACHE_MODE_SAFEBOX and need_redraw_name and hasattr(self.component, 'npc_name_list'):
            self.component.npc_name_list.visible = True
            if self._npc_list_callback:
                BigWorld.cancelCallback(self._npc_list_callback)
            self._npc_list_callback = BigWorld.callback(0.0, self.setListNPCNames)
        if not BWPersonality.GUICore.itemCacheDataSection:
            return
        else:
            current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', None)
            if self._selected_npc and self._selected_npc != current_trader_name:
                player = BigWorld.player()
                items = ItemsUtils.get_shopped_items(player, self._selected_npc)
                if self._selected_npc not in player.StoredItems:
                    player._open_stored_items_when_got = {'npc_name': self._selected_npc}
                    player.base.get_stored_items(self._selected_npc)
                else:
                    stored_items = player.StoredItems[self._selected_npc]
                    if stored_items:
                        items.extend(stored_items)
                data = {'items': items}
            else:
                data = BWPersonality.GUICore.itemCacheDataSection
            if not data:
                return
            if data.has_key('items'):
                items = data['items']
                items = list(items)
                self._items = items
                self.redrawItems()
            slots_string = data.get('slots_string')
            if slots_string:
                self.component.slotLabel.text = '{0}/{1}'.format(*slots_string)
            self.component.slotLabel.visible = bool(slots_string)
            if data.has_key('caption'):
                self.component.iLabel.text = data['caption']
            return

    def redrawItems(self):
        filter_mask = self.filterMask if self._filter_box.component.visible else INV_CONST.FILT_ALL
        items = itemFilterFunction(self._items, filter_mask, self.filterText, self._sort)
        self._setItems(items)

    def stopDragging(self):
        GUIPositions.stopDragging(self)
        DraggableComponent.stopDragging(self)

    @property
    def gui_positions_id(self):
        return self.cache_mode

    def handleMouseButtonEvent(self, comp, event):
        if hasattr(self.component, 'npc_name_list'):
            self.component.npc_name_list.script.showList(False)
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleKeyEvent(self, event):
        key = event.key
        down = event.isKeyDown()
        use_key = BWPersonality.settings.keyBindings.getBindingsForAction('InteractObject')[0][0]

        def checkKey(_use_key, _key):
            if isinstance(_use_key, tuple):
                return _key in _use_key
            if isinstance(_use_key, int):
                return _key == _use_key

        if down and self.cache_mode in (ItemsUtils.CACHE_MODE_CREATURE, ItemsUtils.CACHE_MODE_CONTAIER) and checkKey(use_key, key):
            if self.component.button_take_all.visible and not self.component.button_take_all.script.buttonDisabled:
                self.onTakeAllItems()
                return True
        return False

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def show(self, cache_mode):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.window_name)
        self.cache_mode = cache_mode
        GUIPositions.show(self)
        if hasattr(self, '_autosort_checkbox'):
            checked = self._autosort_checkbox.isChecked()
            if checked != self._sort:
                if checked:
                    self._autosort_checkbox.setInactive()
                else:
                    self._autosort_checkbox.setActive()
        self.component.visible = True
        self._selected_npc = None
        BWPersonality.GUICore.setBestCursor()
        self.component.itemView.script.setCacheMode(cache_mode)
        self.component.itemView.script.resetScroll()
        if BWPersonality.GUICore.inventoryGUI:
            BWPersonality.GUICore.inventoryGUI.lockWindow(False)
        if cache_mode == ItemsUtils.CACHE_MODE_SAFEBOX:
            self.component.button_show_gift.visible = True
        else:
            self.component.button_show_gift.visible = False
        if cache_mode in [ItemsUtils.CACHE_MODE_CREATURE, ItemsUtils.CACHE_MODE_CONTAIER]:
            self.component.button_take_all.label.text = lc('GUI.itemCache.TAKE_ALL') % BWPersonality.settings.keyBindings.getKeyBindForAction('InteractObject')
            self._filter_box.component.visible = False
        else:
            self._filter_box.component.visible = True
        self.component.button_take_all.visible = cache_mode in [ItemsUtils.CACHE_MODE_CREATURE, ItemsUtils.CACHE_MODE_CONTAIER]
        self.component.itemView.script.on_show()
        return

    def hide(self):
        if self.component.visible:
            BigWorld.player().onCloseItemCache()
            if self.cache_mode == ItemsUtils.CACHE_MODE_SAFEBOX and BigWorld.player().explorePot:
                BigWorld.delPot(BigWorld.player().explorePot)
                BWPersonality.GUICore.showStartSale(False)
        self.component.visible = False
        self._selected_npc = None
        self._saved_scrolling = {}
        if hasattr(self.component, 'npc_name_list'):
            self.component.npc_name_list.script.showList(False)
        BWPersonality.GUICore.setBestCursor()
        BWPersonality.GUICore.showGiftListWindow(False)
        if BWPersonality.GUICore.inventoryGUI:
            BWPersonality.GUICore.inventoryGUI.lockWindow(False)
        self.component.itemView.script.on_hide()
        return

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('button_take_all', 'onClick')
    def onTakeAllItems(self):
        data = {'item_ids': [],
         'item_types': []}
        for item in self._items:
            data['item_ids'].append(item['complexItemID'])
            data['item_types'].append(item['complexItemType'])

        BWPersonality.GUICore.itemCacheEvent(ITEM_CACHE.EVENT_TAKE_ALL, data)

    @PyGUIEvent('button_show_gift', 'onClick')
    def onShowGift(self):
        if hasattr(self.component, 'npc_name_list'):
            self.component.npc_name_list.script.showList(False)
        BWPersonality.GUICore.showGiftListWindow(True)

    def onScroll(self):
        if self._selected_npc:
            self._saved_scrolling[self._selected_npc] = self.component.itemView.script.cursor
        BWPersonality.GUICore.hideToolTip(self.interfaceID)

    def setSize(self, rows, cols):
        self.ROWS = rows
        self.COLS = cols
        self.component.height = 134 + self.ROWS * 64 + line_width * 2
        self.component.width = 24 + self.COLS * 64
        self.component.iFrame.height = self.component.height
        self.component.iFrame.width = self.component.width
        self.component.itemView.script.deleteSlots()
        self.component.itemView.script.rowWidth = self.COLS
        self.component.itemView.script.rows = self.ROWS
        self.component.itemView.script.cols = self.COLS
        self.component.itemView.script.setupSlots()
        self.component.itemView.script.setupScrolls()
        self.component.itemView.script._updateMaxScroll()
        self.component.itemView.script._applyItems()
        self.component.closeBox.position = (self.component.width - 6 - self.component.closeBox.width, 6, 0.3)
        self.component.npc_name_list.position = (self.component.width - 5, 62 + line_width, 0.5)
        self.component.npc_name_list.script.setWidth(self.component.width - 90)
        self._filter_edit.component.position = (self.component.width - 5, 2 + line_width, 0.5)
        self._filter_edit.component.width = self.component.width - 90
        self._filter_edit.do_reposition()
        self.component.lockLayer.height = self.component.height - 127
        self.component.lockLayer.width = self.component.width - 7
        self.component.slotLabel.position[0] = self.component.width - 5
        self.component.button_show_gift.position = (self.component.width - 10, self.component.height - 7, 0.1)
        self.component.button_take_all.position = (self.component.width - 10, self.component.height - 7, 0.1)
        self._filter_box.component.position = (self.component.width - 17, 1, 0.5)
        GUIPositions.on_size_changed(self)


class soItemLootCacheScreen(soItemCacheScreen):

    @property
    def window_name(self):
        return 'itemLootCache'

    def __init__(self, component):
        self.ROWS = 4
        self.COLS = 4
        self.HEIGTH = 326
        self.WIDTH = 283
        self.cache_mode = 0
        self._sort = BWPersonality.settings.getSetting('itemcache_autosort', False)
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        GUIPositions.__init__(self)
        component.script = self
        self._selected_npc = None
        self._saved_scrolling = {}
        self._blocked_items = {}
        self.interfaceID = BWPersonality.GUICore.GUI_ID_ITEMLOOTCACHE
        self.filterMask = INV_CONST.FILT_ALL
        self.filterText = ''
        self.component.focus = True
        self.component.dragFocus = True
        self.component.dropFocus = True
        self.component.crossFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.setupRoot()
        self.setupItemView()
        self.setupContent()
        self.component.lockLayer.height = self.component.height - 63
        self.component.lockLayer.position = (5, 30, 0.1)
        return

    def setupItemView(self):
        itemView = soItemView(GUI.Window(), soItemCacheSlot, slot_eventsHandler=self.slotHandler, eventsHandler=self.itemViewHandler, rows=self.ROWS, rowWidth=self.ROWS, cols=self.COLS, hScroll=0, borderWidth=0)
        itemView.set_multiselectable()
        cmp = itemView.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (5, 30, 0.5)
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        self.component.addChild(cmp, 'itemView')
        itemView.onBound()
        itemView.setRestrictingComponent(None)
        itemView.setItems(None)
        itemView.onScroll = self.onScroll
        itemView.onAddItem = self.onChangeItem
        itemView.onRemoveItem = self.onChangeItem
        return

    def slotHandler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DROP:
            if self.cache_mode == ItemsUtils.CACHE_MODE_CONTAIER:
                return False
        return soItemCacheScreen.slotHandler(self, event, data)

    def doReposition(self):
        pass