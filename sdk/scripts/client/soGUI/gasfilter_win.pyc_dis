# Embedded file name: ./client/soGUI/gasfilter_win.py
from Items import ItemsCatalog
import BigWorld
import GUI
from Helpers.PyGUI.PyGUIBase import DragWin
from soGUI.GUIPositions import GUIPositions
from math_bw import linear_map, clamp

class GasfilterWin(DragWin, GUIPositions):

    def __init__(self):
        comp = GUI.Window()
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.position = self._get_default_position()
        DragWin.__init__(self, comp)
        GUIPositions.__init__(self)
        comp = GUI.Window('soGUI/frame/munitions/gasmask_filtr_broke.dds')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.materialFX = 'BLEND'
        comp.filterType = 'LINEAR'
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'back_img')
        shader = GUI.ClipShader()
        shader.speed = 0
        shader.value = 0
        shader.mode = 'DOWN'
        comp.addShader(shader, 'clipper')
        comp = GUI.Window('soGUI/frame/munitions/gasmask_filtr.dds')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.materialFX = 'BLEND'
        comp.filterType = 'LINEAR'
        comp.colour = (220, 220, 220, 255)
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'img')
        shader = GUI.ClipShader()
        shader.speed = 0
        shader.value = 0
        shader.mode = 'UP'
        comp.addShader(shader, 'clipper')
        comp = GUI.Text(u'')
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'txt')
        self._ratio = None
        return

    def _get_default_position(self):
        return (433, 46, 0.9)

    @property
    def ratio(self):
        return self._ratio

    @ratio.setter
    def ratio(self, value):
        if self._ratio == value:
            return
        self._ratio = value
        self.component.txt.text = str(clamp(int(round(self._ratio * 100)), 0, 100)) + '%'
        self.component.img.clipper.value = self._ratio
        self.component.back_img.clipper.value = 1 - self._ratio

    def show(self):
        self.component.visible = True
        self._check_size()
        GUIPositions.show(self)

    def update_ratio(self, filter_type, cond):
        if filter_type:
            filter_max_cond = ItemsCatalog.MAX_CONDITION_VALUE
            self.ratio = float(cond) / filter_max_cond
        else:
            self.ratio = 0

    def hide(self):
        self.component.visible = False

    def reset_position(self):
        self.component.position = self._get_default_position()

    def _check_size(self):
        sh = BigWorld.screenHeight()
        scale = linear_map(sh, 768, 1080, 0.8, 1.2)
        comp = self.component.img
        comp.width, comp.height = comp.texture.width * scale, comp.texture.height * scale
        img_comp = comp
        comp = self.component.back_img
        comp.width, comp.height = img_comp.width, img_comp.height
        comp = self.component.txt
        comp.font = 'RobotoCondensedRegular_16.font' if sh < 1000 else 'RobotoCondensedRegular_18.font'
        comp.position[1] = img_comp.position[1] + img_comp.height + 2
        txt_width, txt_height = comp.stringDimensions('999%')
        txt_comp = comp
        comp = self.component
        comp.width, comp.height = max(txt_width, img_comp.width), txt_comp.position[1] + txt_height
        GUIPositions.on_size_changed(self)

    def onParentSizeChanged(self, component):
        self._check_size()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)