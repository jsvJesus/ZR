    def handleMouseButtonEvent(self, component, event):
        return True

    def openFile(self):
        from soGUI.file_finder.file_finder import BlackStyle
        BWPersonality.GUICore.file_finder.show(BWPersonality.GUICore.worldLayer, self.onOpenFile, style=BlackStyle, depth=0.05)

    def set_file_path(self, path):
        self.onOpenFile(path)

    def onOpenFile(self, fullpath):
        finder_hide = BWPersonality.GUICore.file_finder.hide
        if not fullpath:
            finder_hide()
            return
        elif fullpath is InvalidPath:
            gui_jokes.askUserOk(u'', lc('PaintScreen.emblems.INVALID_PATH'))
            return
        else:
            self._fullpath = fullpath
            self._uppath = None
            self.component.fname.text = colorCodes.inactive_text_color + lc('emblemWindow.file_label')
            self.component.fsize.text = colorCodes.inactive_text_color + lc('emblemWindow.size')
            self.component.loadedTexture.texture = self._texture_noimg
            self._uploadtexture = None
            succes, tmppath, errormsg = UCManager.ucmanager.converToDDS(fullpath)
            if not succes:
                gui_jokes.askUserOk(u'ERROR', errormsg)
                return
            self._uppath = tmppath
            if os.path.exists(self._uppath):
                txtr = BigWorld.PyTextureProvider(self._uppath, 3)
            else:
                txtr = BigWorld.PyTextureProvider('../' + self._uppath, 3)
            strsize = '%sx%s' % (txtr.width, txtr.height)
            if txtr.height > 128 or txtr.width > 128:
                self._uppath = None
                self.component.loadedTexture.texture = self._texture_noimg
                gui_jokes.askUserOk(lc('colourItemWindow.ERROR'), lc('colourItemWindow.ERROR_SIZE').format(strsize))
                return
            self._uploadtexture = txtr
            self.component.loadedTexture.texture = self._uploadtexture
            fullpath = utils.force_unicode(fullpath)
            self.component.fname.text = colorCodes.inactive_text_color + lc('emblemWindow.file_label') + ' ' + colorCodes.active_text_color + os.path.basename(fullpath)
            self.component.fsize.text = colorCodes.inactive_text_color + lc('emblemWindow.size') + ' ' + colorCodes.active_text_color + strsize
            self._uploadtexture = txtr
            self.parent.changeFeed('tmp_set_emblem', txtr)
            finder_hide()
            return

    def upload(self):
        print 'upload Emblem', [self._uppath]
        if not self._uppath:
            return
        pl = BigWorld.player()
        if not pl or not pl.__class__.__name__ == 'PlayerAvatar':
            return
        ticket_type = DyeConstant.COST_UPLOAD_EMBLEM.keys()[0]
        ticket_count = DyeConstant.COST_UPLOAD_EMBLEM.values()[0]
        ticket_name = ItemsUtils.GetItemName(ticket_type)
        need_ticket = ticket_count - pl.current_paint_consumables
        if need_ticket > 0:

            def toShop(e):
                if e == gui_jokes.GuiHandler.YES:
                    BWPersonality.GUICore.storehouse_screen.show_bin({ticket_type: need_ticket})

            gui_jokes.askUserYesNo(lc('colourItemWindow.ERROR'), lc('colourItemWindow.NEED_CONSUM').format(ticket_name, need_ticket), toShop)
            return

        def callback(e):
            if e == gui_jokes.GuiHandler.OK:
                if UCManager.ucmanager.uploadImage(self._uppath, callbackUnlock=self.unlock, onUploadImage=self.onUploadImage):
                    self.lock()

        gui_jokes.askUserOk(lc('colourItemWindow.UPLOAD_EMBLEM'), lc('colourItemWindow.UPLOAD_EMBLEM_COST').format(ticket_name, ticket_count), callback)

    def onUploadImage(self, res):
        print 'onUploadImage', [res]
        newImageID = int(res.strip())
        UCManager.download(newImageID)
        self.parent.onloadEmblemOk(newImageID)

    def lock(self):
        self.component.bOpen.script.setDisabledState(True)
        self.component.bUpload.script.setDisabledState(True)
        self.component.bOpen.script._updateVisualState()
        self.component.bUpload.script._updateVisualState()

    def unlock(self):
        self.component.bOpen.script.setDisabledState(False)
        self.component.bUpload.script.setDisabledState(False)
        self.component.bOpen.script._updateVisualState()
        self.component.bUpload.script._updateVisualState()

    def updateConsumables(self):
        count = BigWorld.player().current_paint_consumables
        self.component.frame_itog.my_count.text = str(count) + ' ' + lc('emblemWindow.pcs')