        cmp.text = u''
        self.component.addChild(cmp, 'charName')
        closeBox = soButton(GUI.Window())
        cmp = closeBox.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.component.width - 25, 6, 0.3)
        closeBox.initVSC('soGUI/elements/closeBox.xml')
        closeBox.onBound()
        closeBox.setVisualState('normal')
        closeBox.onClick = self.hide
        self.component.addChild(cmp, 'closeBox')
        eqWnd = soGUI.soCharacterScreen.soEquipmentWindow(GUI.Window(), self._slot_handler, soInspectSlot)
        cmp = eqWnd.component
        self.component.addChild(cmp, 'wnd')
        self.slots, self._equipment_slots, _ = eqWnd.setupSlots()
        cmp.widthMode = 'PIXEL'
        cmp.heightMode = 'PIXEL'
        cmp.width = self.component.width
        cmp.height = self.component.height

    def _slot_handler(self, event, data):
        if not self.current_target_id:
            return False
        if BigWorld.player().clientAccessLevel < 6:
            return False
        if event == ITSLOT.SLOTEVENT_RCLICK:
            item = data.itemData
            if not item:
                return False
            BWPersonality.GUICore.showItemInfo(item)
        return True

    def _slotHandler(self, event, data):
        pass

    def show(self, target):
        if BigWorld.player().clientAccessLevel < 6:
            return
        else:
            if self.component.parent is None:
                BWPersonality.GUICore.worldLayer.addChild(self.component, 'EquipScreenDebug')
            self.current_target_id = target.id
            self.component.visible = True
            BWPersonality.GUICore.setBestCursor()
            self.component.charName.text = get_entity_name(target, utf8=True)
            self.update_weapon_slots(target)
            self.update_equipment_slots(target)
            return

    def hide(self):
        self.current_target_id = 0
        self.component.visible = False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def update_weapon_slots(self, target):
        from soGUI.soCharacterScreen import soCharacterScreen2
        for key, draw_slot in self.slots.items():
            draw_slot.setContent(None)

        weap = {soCharacterScreen2.INDEX_PRIMARY: 'PrimarySlot',
         soCharacterScreen2.INDEX_PRIMARY2: 'Primary2Slot',
         soCharacterScreen2.INDEX_SECONDARY: 'SecondarySlot'}
        for key, weapon_key in weap.items():
            slot = target.ActiveWeaponSet2[weapon_key]
            if slot['itemID']:
                inconstant_dict = dict()
                inconstant_dict[ItemsCatalog.INC_COLORISE_A] = slot['COLORISEA']
                inconstant_dict[ItemsCatalog.INC_COLORISE_B] = slot['COLORISEB']
                item = ItemsUtils.createNewItem(slot['itemType'], slot['itemID'], inconstant_dict=inconstant_dict)
                item['itemList'] = []
                for att_slot in slot['upgr']:
                    item['itemList'].append(createSubItemFromSlotUpgr(att_slot))

                self.slots[key].setContent(item)

        return

    def update_equipment_slots(self, target):
        colors = {}
        for col_embl in getattr(target, 'coloriseEmblems', []):
            colors[col_embl['ItemID']] = {ItemsCatalog.INC_COLORISE_A: col_embl['COLORISE_A'],
             ItemsCatalog.INC_COLORISE_B: col_embl['COLORISE_B']}

        for slot in self._equipment_slots:
            needed_item = EST.get_slot_data(target, slot.slot_type)
            if needed_item['itemType']:
                inconstant_dict = {}
                if needed_item['itemID'] in colors:
                    inconstant_dict.update(clientColorEmblToInconstant(colors[needed_item['itemID']]))
                item = ItemsUtils.createNewItem(needed_item['itemType'], needed_item['itemID'], inconstant_dict=inconstant_dict)
                slot.setContent(item)
            else:
                slot.setContent(None)

        return


def createSubItemFromSlotUpgr(upgr_slot):
    sub_item = {}
    sub_item['itemType'] = upgr_slot['itemType']
    sub_item['itemID'] = upgr_slot['itemID']
    sub_item['creationTime'] = 0.0
    inc_param = {}
    inc_param[ItemsCatalog.INC_COLORISE_A] = upgr_slot['COLORISEA']
    inc_param[ItemsCatalog.INC_COLORISE_B] = upgr_slot['COLORISEB']
    inc_param[ItemsCatalog.INC_WEAPON_ATTACH_PARENT_ID] = upgr_slot['parentItemID']
    inc_param[ItemsCatalog.INC_WEAPON_ATTACH_PARENT_NODE] = upgr_slot['parentNode']
    inc_param[ItemsCatalog.INC_WEAPON_ATTACH_POSY] = int(upgr_slot['attachPosY'] * ItemsUtils.ATTACH_POSY_MULT)
    keys, values = ItemsUtils.packItemDict(inc_param)
    sub_item['itemParametresKeys'] = keys
    sub_item['itemParametresValues'] = values
    return sub_item


def clientColorEmblToInconstant(clrs):
    if 'COLORISE_A' not in clrs or 'COLORISE_B' not in clrs:
        return clrs
    colors, tintid, emblem = ItemsUtils.unpackColoriseClient(clrs)
    colors = ItemsUtils.colors44ToDicts3(colors)
    c1, c2, c3, c4 = colors
    inconstant_params = {}
    inconstant_params[ItemsCatalog.INC_COLORISE_A] = ItemsUtils.ColorAndTintToINT64(c1['r'], c1['g'], c1['b'], c2['r'], c2['g'], c2['b'], tintid)
    inconstant_params[ItemsCatalog.INC_COLORISE_B] = ItemsUtils.ColorAndTintToINT64(c3['r'], c3['g'], c3['b'], c4['r'], c4['g'], c4['b'], 0)
    return inconstant_params