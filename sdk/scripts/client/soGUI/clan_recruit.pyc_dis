class RecrList(soList_optimized):

    def __init__(self, comp, width, height, watch_callback):
        props = ListPropsStructure(width=width, height=height, isMultiSel=False, leftOffset=4, selectCallBack=None, sorted=False, elemHeight=32)
        soList_optimized.__init__(self, comp, props, default_frame_skin='soGUI/frame/basic_frame_1.dds')
        self._watch_callback = watch_callback
        return

    def get_elem_class(self):
        return Element

    def initElements(self):
        soList_optimized.initElements(self)
        col = 80
        for i, elem_comp in enumerate(self.elemComps):
            comp = GUI.Window('soGUI/frame/paint/white.dds')
            comp.materialFX = 'SOLID'
            comp.colour = (col,
             col,
             col,
             255)
            comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
            comp.ha, comp.va = ('LEFT', 'BOTTOM')
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.width, comp.height = (754, 1)
            comp.position = (1, 36 + 32 * i, 0.5)
            self.component.addChild(comp)

    def _on_watch_requested(self, elem):
        attachment = self.attachments[elem.component.label.text]
        self._watch_callback(attachment)

    def toggleElement(self, elemNum, silent = False):
        for elem in self.elements:
            self.elements[elem] = 0

        self.applyElements(False)

    def toggleByCaption(self, elemCaption):
        for elem in self.elements:
            self.elements[elem] = 0

        self.applyElements(False)

    def apply_single_element(self, i, elem):
        element = self.elemComps[i].component.script
        element.initVSC('soGUI/elements/listRelElementFav.xml')
        soList_optimized.apply_single_element(self, i, elem)
        attachment = self.attachments[self.indexes[elem]]
        element.apply(attachment)


class ClanRecruitList(Interceptor):
    _request_id = 0

    def __init__(self, comp):
        Interceptor.__init__(self, comp)
        btn = Button(self.component, 'back_button', frame=True)
        btn.set_visual('soGUI/frame/buttons/linkbutton.json')
        btn.set_image('soGUI/frame/left_arrow.dds')
        btn.on_click = self.hide
        pivot = (1, 1)
        clip_pos = (1, 1)
        pixel_pos = (-32, -5)
        btn.transform.set_base_resolution(None)
        btn.set_text(lc('GUI.QuestLog.BACK_BTN'))
        btn.set_font_unscalable()
        string_width = btn.text.get_string_width()
        image_width = btn.image.component.width
        size = (string_width + image_width + 6, 35)
        btn.transform.set_pixel_mode(pivot, clip_pos, size, pixel_pos=pixel_pos)
        width, height = (778, 326)
        comp = GUI.Window()
        self._rec_list = RecrList(comp, width, height, self._on_watch_requested)
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width, height
        comp.position = (8, 32, 0.5)
        self.component.addChild(comp)
        self._rec_list.onBound()
        height = 16
        comp = GUI.Text(lc('GUI.ClanGUI.RECRUITING.Name'), 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (200, height, 0.5)
        comp.colour = cc.active_rgba
        self.component.addChild(comp)
        comp = GUI.Text(lc('GUI.ClanGUI.RECRUITING.Level'), 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (408, height, 0.5)
        comp.colour = cc.active_rgba
        self.component.addChild(comp)
        self._watch_letter_win = None
        return

    def show(self):
        if not self.component.visible:
            self.component.visible = True
            self._on_show()

    def _on_show(self):
        BigWorld.player().got_recruit_letters0 = self._got_recruit_letters
        ClanRecruitList._request_id = 120 % (ClanRecruitList._request_id + 1)
        BigWorld.player().base.get_recruit_letters0(ClanRecruitList._request_id)

    def _on_watch_requested(self, data):
        if not self._watch_letter_win:
            self._watch_letter_win = WatchLetterWin()
            self._watch_letter_win.add_listener(self._on_watch_win_event)
            BWPersonality.GUICore.worldLayer.addChild(self._watch_letter_win.component, 'ClanRecruitWatchLetterWin')
        self._watch_letter_win.show(data)

    def _on_watch_win_event(self, event_type, data):

        def del_row(db_id):
            db_id = data['db_id']
            for caption_id, attachment in self._rec_list.attachments.items():
                if attachment['dbid'] == db_id:
                    self._rec_list.removeElement(caption_id)
                    break

        if event_type == WatchET.OnAcceptRequested:
            db_id, name = data['db_id'], data['name']
            del_row(db_id)
            BigWorld.player().cell.accept_recruiting0(db_id, name)
        elif event_type == WatchET.OnRefuseRequested:
            db_id = data['db_id']
            del_row(db_id)
            BigWorld.player().base.refuse_recruiting0(db_id)

    def _got_recruit_letters(self, data, request_id):
        if request_id != ClanRecruitList._request_id:
            return
        self._rec_list.clear()
        for i, row in enumerate(data):
            self._rec_list.addElement(unicode(i), attachment=row, delayedRender=True)

        self._rec_list.applyElements()

    def hide(self):
        if self.component.visible:
            self.component.visible = False
            self._on_hide()

    def _on_hide(self):
        BigWorld.player().got_recruit_letters0 = lambda *args: None
        BigWorld.player().base.check_recr_letters0()
        self._rec_list.clear()
        if self._watch_letter_win:
            self._watch_letter_win.hide()

    @property
    def visible(self):
        return self.component.visible