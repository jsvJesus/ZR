# Embedded file name: ./client/soGUI/LentDiagramma.py
import BigWorld
import GUI
from Helpers.PyGUI.PyGUIBase import PyGUIBase

class LentValue(PyGUIBase):

    def __init__(self, component, name = '', colour = (255, 255, 255, 255), value = 0):
        PyGUIBase.__init__(self, component)
        component.script = self
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.colour = colour
        cmp.position = (0, 0, 1)
        cmp.height = cmp.width = 2.0
        cmp.visible = True
        self.component.visible = True
        self.name = name
        self.value = value
        self.component.addChild(cmp, 'background')
        self.component.focus = True
        self.component.crossFocus = True
        self.component.mouseButtonFocus = True

    def handleMouseEnterEvent(self, component):
        self.onMouseEnter(self.name, self.value)
        return True

    def handleMouseButtonEvent(self, component, event):
        self.onMouseClick()
        return False

    def handleMouseLeaveEvent(self, component):
        self.onMouseLeave()
        return True

    def handleMouseEvent(self, component, event):
        return True

    def onMouseEnter(self, name, value):
        pass

    def onMouseLeave(self):
        pass


class LentDiagramma(PyGUIBase):

    def __init__(self, component, name = '', legend = True):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.__legend = legend
        self.__frame = None
        self.__data = None
        self.__data_limit = None
        self.__min_limit = None
        self.__name = name
        self.__name_cmp = None
        self.__limit_error_cmp = None
        self.__childs_cmp = []
        self.component.visible = True
        self.setup_root()
        self.setup_component()
        return

    def setup_root(self):
        cmp = GUI.Frame2('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.colour = (0, 0, 0, 0)
        cmp.materialFX = 'BLEND'
        cmp.width, cmp.height = (2.0, 2.0)
        cmp.position = (0, 0, 1)
        cmp.visible = True
        self.component.addChild(cmp, 'frame')
        self.component.horizontalAnchor = 'LEFT'
        self.component.widthMode = 'PIXEL'
        self.component.heightMode = 'PIXEL'
        self.component.focus = True
        self.component.moveFocus = True
        self.component.crossFocus = True
        self.component.width = 700
        self.component.height = 45

    def setup_component(self):
        self.__frame = GUI.Frame2('soGUI/items/cell.dds')
        self.__frame.verticalPositionMode = self.__frame.horizontalPositionMode = 'PIXEL'
        self.__frame.widthMode = 'PIXEL'
        self.__frame.heightMode = 'PIXEL'
        self.__frame.horizontalAnchor = 'LEFT'
        self.__frame.verticalAnchor = 'TOP'
        self.__frame.position = (120, 25, 1)
        self.__frame.colour = (255, 255, 255, 155)
        self.__frame.height = 15
        self.__frame.width = 430
        self.__frame.visible = True
        self.__frame.materialFX = 'BLEND'
        self.component.frame.addChild(self.__frame, 'frameCmp')
        self.__name_cmp = GUI.Text(self.__name)
        self.__name_cmp.horizontalAnchor = 'LEFT'
        self.__name_cmp.verticalAnchor = 'TOP'
        self.__name_cmp.verticalPositionMode = 'PIXEL'
        self.__name_cmp.horizontalPositionMode = 'PIXEL'
        self.__name_cmp.font = 'ruRU_Verdana_14.font'
        self.__name_cmp.position = (3, 20, 0)
        self.__name_cmp.colour = (255, 255, 255, 255)
        self.__name_cmp.visible = True
        self.component.frame.addChild(self.__name_cmp, 'name')
        self.__limit_val_cmp = GUI.Text('')
        self.__limit_val_cmp.horizontalAnchor = 'LEFT'
        self.__limit_val_cmp.verticalAnchor = 'TOP'
        self.__limit_val_cmp.verticalPositionMode = 'PIXEL'
        self.__limit_val_cmp.horizontalPositionMode = 'PIXEL'
        self.__limit_val_cmp.font = 'ruRU_Verdana_14.font'
        self.__limit_val_cmp.position = (self.__frame.position.x + self.__frame.width, self.__frame.position.y - 5, 0.1)
        self.__limit_val_cmp.colour = (255, 255, 255, 255)
        self.__limit_val_cmp.visible = True
        self.component.frame.addChild(self.__limit_val_cmp, 'limit_val')
        self.__val_cmp = GUI.Text('')
        self.__val_cmp.horizontalAnchor = 'LEFT'
        self.__val_cmp.verticalAnchor = 'TOP'
        self.__val_cmp.verticalPositionMode = 'PIXEL'
        self.__val_cmp.horizontalPositionMode = 'PIXEL'
        self.__val_cmp.font = 'ruRU_Verdana_14.font'
        self.__val_cmp.position = (120, 0, 0)
        self.__val_cmp.colour = (255, 255, 255, 255)
        self.__val_cmp.visible = True
        self.component.frame.addChild(self.__val_cmp, 'val')
        self.__limit_error_cmp = GUI.Simple('textures/default/white.dds')
        self.__limit_error_cmp.horizontalPositionMode = self.__limit_error_cmp.verticalPositionMode = 'PIXEL'
        self.__limit_error_cmp.horizontalAnchor = 'LEFT'
        self.__limit_error_cmp.verticalAnchor = 'TOP'
        self.__limit_error_cmp.widthMode = self.__limit_error_cmp.heightMode = 'PIXEL'
        self.__limit_error_cmp.colour = (255, 0, 0, 155)
        self.__limit_error_cmp.width = self.__frame.width
        self.__limit_error_cmp.height = self.__frame.height
        self.__limit_error_cmp.position = self.__frame.position
        self.__limit_error_cmp.position.z = 0.01
        self.__limit_error_cmp.materialFX = 'BLEND'
        self.__limit_error_cmp.visible = False
        self.component.frame.addChild(self.__limit_error_cmp, 'limit_error_cmp')

    def set_data(self, data, limit = None, min_limit = None):
        self.__data = data
        self.__data_limit = limit
        self.__min_limit = min_limit
        self.draw_diagramma()

    def onMouseEnter(self, name, value):
        if name == 'System mem':
            value = self._formatMemory(value, 'b')
        self.__val_cmp.text = u'{0} {1}'.format(name, value)

    def onMouseLeave(self):
        self.__val_cmp.text = ''

    def onMouseClick(self):
        self.__limit_error_cmp.visible = False

    def format(self, value):
        if self.__name == 'Sysmem':
            return self._formatMemory(int(value), 'b')
        else:
            return self._formatOther(int(value))

    def _formatMemory(self, value, units):
        value = int(value)
        if value < 1024:
            return value
        elif value < 1048576:
            value /= 1024
            return str(value) + ' K' + units
        else:
            value /= 1048576
            return str(value) + ' M' + units

    def _formatOther(self, value):
        result = str(int(value))
        count = int(len(result) / 3)
        if len(result) % 3 == 0:
            count -= 1
        last_index = len(result)
        for i in xrange(count):
            result = result[:last_index - 3] + '.' + result[last_index - 3:]
            last_index -= 3

        return result

    def draw_diagramma(self):
        if not self.__data:
            return
        for val_cmp in self.__childs_cmp:
            self.component.delChild(val_cmp)

        self.__childs_cmp = []
        summ = 0
        for obj in self.__data:
            name, value, colour = obj
            if name == 'empty':
                continue
            summ += value

        if self.__data_limit:
            maxx = self.__data_limit + self.__data_limit * 0.05
        else:
            maxx = summ + summ * 0.3
            self.__data_limit = maxx
        if not self.__min_limit:
            self.__min_limit = 0
        self.__limit_error_cmp.visible = not self.__min_limit <= summ <= self.__data_limit or self.__limit_error_cmp.visible
        start_x = self.__frame.position.x
        self.__data_empty = max(self.__data_limit - summ, 0)
        self.__data_empty = self.format(self.__data_empty)
        self.__limit_val_cmp.text = self.format(summ)

        def create_diag(_index, _name, _value, _colour, _width, _start_pos_x):
            val_cmp = LentValue(GUI.Window(), _name or self.__name, _colour, _value)
            val_cmp.component.horizontalPositionMode = 'PIXEL'
            val_cmp.component.verticalPositionMode = 'PIXEL'
            val_cmp.component.horizontalAnchor = 'LEFT'
            val_cmp.component.verticalAnchor = 'TOP'
            val_cmp.component.widthMode = val_cmp.component.heightMode = 'PIXEL'
            val_cmp.component.width = _width
            val_cmp.component.height = self.__frame.height
            val_cmp.component.position = (_start_pos_x, self.__frame.position.y, 0.2)
            val_cmp.component.materialFX = 'BLEND'
            val_cmp.component.focus = True
            val_cmp.component.crossFocus = True
            val_cmp.onMouseEnter = self.onMouseEnter
            val_cmp.onMouseLeave = self.onMouseLeave
            val_cmp.onMouseClick = self.onMouseClick
            self.component.frame.addChild(val_cmp.component, 'cmp_val{0}'.format(_index))
            self.__childs_cmp.append(val_cmp.component)

        for index, obj in enumerate(self.__data):
            name, value, colour = obj
            w = value / maxx * self.__frame.width
            value = self.format(value)
            create_diag(index, name, value, colour, w, start_x)
            start_x += w