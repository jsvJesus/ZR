class FriendGUIDelegateDebugger:

    def delete_friendship(self, friend_name):
        print 'delete', friend_name

    def add_friend_request(self, friend_name):
        print 'add friend', friend_name

    def add_black_request(self, black_name):
        print 'add black', black_name

    def delete_black(self, black_name):
        print 'delete', black_name

    def is_in_group(self, friend_name):
        return False

    def on_notify_changed(self, checked):
        print 'notify changed', checked

    @property
    def friends_online(self):
        return set([ 'friend_online' + str(i) for i in xrange(4) ])

    @property
    def friends_offline(self):
        return set([ 'friend_offline' + str(i) for i in xrange(30) ])

    @property
    def blacks(self):
        return set([ 'black' + str(i) for i in xrange(50) ])


class FriendGUI(PyGUIBase, DraggableComponent, GUIPositions):

