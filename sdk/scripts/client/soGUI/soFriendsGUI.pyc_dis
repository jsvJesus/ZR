    def _update_title(self):
        action_key = BWPersonality.get_action_key('FriendList')
        if self._cur_tab == self._black_tab['tab']:
            self._title.text = lc('GUI.FriendList.BlackList') + action_key
        else:
            self._title.text = lc('GUI.FriendList.FriendList') + action_key

    def _tab_select(self, tab):
        self._cur_tab = tab
        self._update_title()
        if tab == self._black_tab['tab']:
            tab = self._black_tab
            oppose_tab = self._friend_tab
        else:
            tab = self._friend_tab
            oppose_tab = self._black_tab
        tab['wnd'].visible = True
        oppose_tab['wnd'].visible = False
        tab['tab'].script.buttonActive = True
        oppose_tab['tab'].script.buttonActive = False
        tab['tab'].script._updateVisualState()
        oppose_tab['tab'].script._updateVisualState()
        tab['tab'].position = (tab['tab'].position[0], tab['tab'].position[1], 0.1)
        oppose_tab['tab'].position = (oppose_tab['tab'].position[0], oppose_tab['tab'].position[1], 0.3)
        tab['tab'].parent.reSort()
        oppose_tab['tab'].parent.reSort()

    def show(self):
        self._update_title()
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'soFriendGUI')
        self.component.visible = True
        self._update_friends()
        self._update_blacks()
        GUIPositions.show(self)
        return

    def on_blacks_updated(self):
        if not self.visible:
            return
        self._update_blacks()

    def on_friends_updated(self):
        if not self.visible:
            return
        self._update_friends()
        self._update_blacks()

    def _on_black_element_event(self, col, row, event, data):
        if event == 'LEFTMOUSE':
            self._black_tab['table'].clearSelection()
            self._black_tab['table'].selectRow(row)
        elif event == 'RIGHTMOUSE':
            self._black_tab['table'].clearSelection()
            self._black_tab['table'].selectRow(row)
            self._selected_black = self._black_tab['table'].getRowByIndex(row)['name']['data']['text'].encode('utf8')
            actions = {EVENT_DEL_FROM_BLACKLIST: lc('GUI.FriendList.delFromBlackList')}
            BWPersonality.GUICore.removeListener('contextMenuEvent', self._black_context_menu_event)
            BWPersonality.GUICore.addListener('contextMenuEvent', self._black_context_menu_event)
            BWPersonality.GUICore.showContextMenu(BWPersonality.GUICore.GUI_ID_BLACKLISTPOPUP, actions)

    def _on_friend_element_event(self, col, row, event, data):
        if event == 'LEFTMOUSE':
            self._friend_tab['table'].clearSelection()
            self._friend_tab['table'].selectRow(row)
        elif event == 'RIGHTMOUSE':
            self._friend_tab['table'].clearSelection()
            self._friend_tab['table'].selectRow(row)
            self._selected_friend = self._friend_tab['table'].getRowByIndex(row)['name']['data']['text'].encode('utf8')
            actions = {EVENT_DEL_FRIEND: lc('GUI.FriendList.delFriend'),
             EVENT_COPY_NAME: lc('GUI.FriendList.COPY_NAME')}
            if row < len(self.delegate.friends_online):
                actions.update({EVENT_SEND_MESSAGE: lc('GUI.FriendList.sendMessage'),
                 EVENT_ADD_TO_CLAN: lc('GUI.FriendList.addToClan')})
                if self.delegate.can_be_invited_to_party(self._selected_friend):
                    actions[EVENT_ADD_TO_PARTY] = lc('GUI.FriendList.addToGroup')
            BWPersonality.GUICore.removeListener('contextMenuEvent', self._friend_context_menu_event)
            BWPersonality.GUICore.addListener('contextMenuEvent', self._friend_context_menu_event)
            BWPersonality.GUICore.showContextMenu(BWPersonality.GUICore.GUI_ID_FRIENDLISTPOPUP, actions)

    def _black_context_menu_event(self, interface_id, event_id, caption, event, data = None):
        if interface_id is not BWPersonality.GUICore.GUI_ID_BLACKLISTPOPUP:
            return
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            if event_id == EVENT_DEL_FROM_BLACKLIST:
                self.delegate.delete_black(self._selected_black)
            BWPersonality.GUICore.removeListener('contextMenuEvent', self._black_context_menu_event)
        elif event == soGUI.soContextMenuComponent.EVENT_CANCEL:
            BWPersonality.GUICore.removeListener('contextMenuEvent', self._black_context_menu_event)

    def _friend_context_menu_event(self, interface_id, event_id, caption, event, data = None):
        if interface_id is not BWPersonality.GUICore.GUI_ID_FRIENDLISTPOPUP:
            return
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            if event_id == EVENT_SEND_MESSAGE:
                BWPersonality.GUICore.putToChat('@' + self._selected_friend)
            elif event_id == EVENT_DEL_FRIEND:

                def delete_callback(event):
                    if event == gui_jokes.askUserYesNo.YES:
                        self.delegate.delete_friendship(self._selected_friend)

                text = lc('GUI.FriendList.deletingFromFriendList1') + ' ' + self._selected_friend.decode('utf8') + ' ' + lc('GUI.FriendList.deletingFromFriendList2')
                gui_jokes.askUserYesNo(lc('GUI.FriendList.delFriend'), text, delete_callback, enter_btn=gui_jokes.askUserYesNo.YES, default_btn=gui_jokes.askUserYesNo.NO)
            elif event_id == EVENT_ADD_TO_GROUP:
                BigWorld.player().inviteInGroup((u'/invite', unicode(self._selected_friend.decode('utf-8'))))
            elif event_id == EVENT_ADD_TO_PARTY:
                BigWorld.player().send_invitation1(unicode(self._selected_friend.decode('utf-8')))
            elif event_id == EVENT_ADD_TO_CLAN:
                BigWorld.player().inviteFriendToClan(self._selected_friend)
            elif event_id == EVENT_COPY_NAME:
                BigWorld.clipboardSetPlainText(force_unicode(self._selected_friend))
            BWPersonality.GUICore.removeListener('contextMenuEvent', self._friend_context_menu_event)
        elif event == soGUI.soContextMenuComponent.EVENT_CANCEL:
            BWPersonality.GUICore.removeListener('contextMenuEvent', self._friend_context_menu_event)

    def _on_add_black_click(self):

        def callback(text):
            self.delegate.add_black_request(text.encode('utf-8'))

        gui_jokes.inputBox(lc('GUI.FriendList.addToBlackListCaption'), lc('GUI.FriendList.readFriendNameCaption'), callback, active=True)

    def _on_add_friend_click(self):

        def callback(text):
            self.delegate.add_friend_request(text.encode('utf-8'))

        gui_jokes.inputBox(lc('GUI.FriendList.addToFriendListCaption'), lc('GUI.FriendList.readFriendNameCaption'), callback, active=True)

    def _update_blacks(self):
        rows = []
        blacks = sorted(self.delegate.blacks)
        for black in blacks:
            rows.append([(20, 'MIDDLE'), {'name': {'props': soTableElemPropsStructure(dataStyles=OFFLINE_STYLE),
                       'data': {'text': black.decode('utf8')}}}])

        self._black_tab['table'].clearTable()
        self._black_tab['table'].addRows(rows)
        self._black_tab['amount'].text = '{0}/{1}'.format(len(rows), Constants.MAX_IGNORE)

    def _update_friends(self):
        rows = []
        online_friends = sorted(self.delegate.friends_online)
        for friend in online_friends:
            rows.append([(20, 'MIDDLE'), {'name': {'props': soTableElemPropsStructure(dataStyles=ONLINE_STYLE),
                       'data': {'text': friend.decode('utf8')}}}])

        offline_friends = sorted(self.delegate.friends_offline)
        for friend in offline_friends:
            rows.append([(20, 'MIDDLE'), {'name': {'props': soTableElemPropsStructure(dataStyles=OFFLINE_STYLE),
                       'data': {'text': friend.decode('utf8')}}}])

        self._friend_tab['table'].clearTable()
        self._friend_tab['table'].addRows(rows)
        self._friend_tab['amount'].text = '{0}/{1}'.format(len(rows), Constants.MAX_FRIENDS)

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.setBestCursor()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def _on_check_state_change(self):
        Settings().setNotifyFriendList(self.notify_checked)
        self.delegate.on_notify_changed(self.notify_checked)

    @property
    def notify_checked(self):
        return self.component.isNotify.script.isChecked()

    @property
    def visible(self):
        return self.component.visible

    def stopDragging(self):
        DraggableComponent.stopDragging(self)
        GUIPositions.stopDragging(self)