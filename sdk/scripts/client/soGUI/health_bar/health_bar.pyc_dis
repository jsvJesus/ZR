class Leader(Interceptor):

    def handleMouseEnterEvent(self, comp):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        BWPersonality.GUICore.showToolTip(cc.active_xml + lc('extendedGUI.RootWindow.healthleader'))
        return Interceptor.handleMouseEnterEvent(self, comp)

    def handleMouseLeaveEvent(self, comp):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        return Interceptor.handleMouseLeaveEvent(self, comp)


