# Embedded file name: ./client/soGUI/health_bar/scholar_health_bar.py
import BigWorld
from math import sin
import GUI
from copy import deepcopy
from health_bar import HealthBar
from open_world_events_config import NPC_DECOMPOSED_VALUE

class ScholarHealthBar(HealthBar):

    def __init__(self):
        HealthBar.__init__(self)
        self.info = None
        self.component.name.font = 'RobotoCondensedShadow_16.font'
        self.component.wm = 'CLIP'
        self.component.vpm = 'PIXEL'
        self.component.spbarback.visible = False
        self.component.width = 2
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.width, comp.height = (18, 18)
        comp.position = (0, 28, 0.2)
        comp.visible = False
        self.component.addChild(comp, 'image')
        return

    def set_info(self, info):
        if self.info == info:
            return
        self.info = deepcopy(info)
        self.hp_max = 100.0
        self.sp_max = 100.0
        self.sp_value = 0.0
        if self.info:
            self.name = self.info['name']
        self._update_ratio()

    def _update_ratio(self):
        if not (self.info and self.info['ratio']):
            ratio = 0
            image = self.component.image
            image.visible = ratio == NPC_DECOMPOSED_VALUE and True
            image.textureName = 'soGUI/frame/events/dead.dds'
            self.hp_value = 0
        elif ratio == 0:
            image.visible = True
            image.textureName = 'soGUI/frame/events/medkit.dds'
            self.hp_value = ratio
        else:
            image.visible = False
            self.hp_value = ratio

    def update_ratio(self, ratio):
        if self.info:
            self.info['ratio'] = ratio
        self._update_ratio()

    def on_tick(self):
        if self.component.image.visible:
            alpha = abs(sin(BigWorld.time() * 2))
            self.component.image.colour[3] = 255.0 * alpha

    def handleMouseButtonEvent(self, comp, event):
        return False

    def handleMouseEnterEvent(self, comp):
        return False

    def handleMouseLeaveEvent(self, comp):
        return False

    @property
    def entity_id(self):
        return self.info and self.info['entity_id'] or None

    def _do_reposition(self):
        hp_stretch, sp_stretch = HealthBar._do_reposition(self)
        comp = self.component
        comp.height = 42
        pos_x = 20
        comp = self.component.hpbarback
        comp.position = (pos_x, 24, 0.7)
        comp.width, comp.height = 208 * hp_stretch, 12
        comp = self.component.name
        comp.position = (pos_x, 4, 0.5)