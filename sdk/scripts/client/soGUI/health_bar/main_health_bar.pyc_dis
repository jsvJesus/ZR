# Embedded file name: ./client/soGUI/health_bar/main_health_bar.py
from Localization import lc
import math
from Helpers.PyGUI.PyGUIBase import DragWin
import BigWorld
import colorCodes as cc
from Helpers.PyGUI import Utils
import GUI
from time import time
import BWPersonality
from math_bw import move_towards
from PremiumAccountConfigs import PREMIUM_OFF, ClientSimpleConfigs
from soGUI.GUIPositions import GUIPositions
from health_bar import HealthBar
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
