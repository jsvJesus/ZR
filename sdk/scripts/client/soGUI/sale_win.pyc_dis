        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width, 30
        self._money.move_money_icon_height(-4)
        self.component.base.addChild(comp)
        self.component.base.height = comp.position[1] + comp.height + 16

    def _money_validator(self, new_str, whole_text, offset):
        full_text = whole_text[0:offset] + new_str + whole_text[offset:]
        num = full_text.replace('`', '')
        if not num.isdigit():
            return False
        max_num = 1073741824 / self._item_count
        return int(num) < max_num

    def _count_validator(self, new_str, whole_text, offset):
        full_text = whole_text[0:offset] + new_str + whole_text[offset:]
        num = full_text.replace('`', '')
        if not num.isdigit():
            return False
        return int(num) <= self._item_count

    def _on_value_changed(self, by_user):
        self._update_content()

    def _update_content(self):
        self.count = self._edit_count.getInt() if self._item_count > 1 else 1
        single_price = self._edit_money.getRaw().replace('`', '')
        single_price = int(single_price) if single_price.isdigit() else 0
        self.total_price = self.count * single_price
        self.component.base.txt_total.text = cc.inactive_hex + lc('soStartSale.win.total').format(cc.active_hex + groupNumber(self.total_price, "'") + cc.inactive_hex)
        self.component.base.comission.text = lc('soStartSale.win.comission')
        percent, tax = ItemsUtils.calcTaxShop(self.total_price)
        percent_isprem, tax_isprem = ItemsUtils.calcTaxShop(self.total_price, True)
        if BigWorld.player().isPremium():
            tax = tax_isprem
        self.component.base.comission.text = lc('soStartSale.win.comission').format(percent, percent_isprem)
        self._money.setValue(tax)
        self._update_callback()

    def set_data(self, complex_item):
        self._item_count = ItemsUtils.GetItemNumber(complex_item)
        if self._item_count > 1:
            self.component.counts.visible = True
            self.component.base.position[1] = self.component.counts.height
            self._edit_count.setValue(unicode(self._item_count))
        else:
            self.component.counts.visible = False
            self.component.base.position[1] = 0
        self._edit_money.setValue(0)
        self.component.height = self.component.base.height + self.component.base.position[1]
        self._update_content()

    def deactivate(self):
        self._edit_count.activate(0)
        self._edit_money.activate(0)


class Section(NameSection):

    def update(self, item):
        NameSection.update(self, item)
        base_comp = self._base_slot.component
        base_comp.position[1] = self.component.name.height + 8
        comp_height = base_comp.position[1] + base_comp.height
        items_count = len(item['complexItem'].get('itemList', []))
        if items_count:
            rows = []
            while items_count > 0:
                rows.append(min(items_count, 8))
                items_count -= rows[-1]

            slot_index = 0
            for row_index, row in enumerate(rows):
                width = row * self._mini_slot_size + self._slot_space * (row - 1)
                x_pos = (300 - width) * 0.5
                y_pos = 102 + row_index * 34
                for i in range(row):
                    slot = self._slots[slot_index]
                    if not slot.component.visible:
                        break
                    slot.component.position = (x_pos, y_pos, 0.5)
                    x_pos += self._mini_slot_size + self._slot_space
                    slot_index += 1

            comp_height += 8 + 34 * len(rows)
        self.component.height = comp_height


