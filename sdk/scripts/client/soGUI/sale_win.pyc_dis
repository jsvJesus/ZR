        btn.onClick = self.hide
        btn.onBound()

    def _on_apply_click(self):
        self._values.deactivate()
        total_price = self._values.total_price
        if total_price <= 10:
            ask = lc('tmplocal.strings.str40')
            gui_jokes.askUserOk(u'', ask)
            return
        money = BigWorld.player().CreditNumber
        percent, price_tax = ItemsUtils.calcTaxShop(total_price, BigWorld.player().isPremium())
        if money < price_tax:
            ask = lc('tmplocal.strings.str41') % (money, price_tax)
            gui_jokes.askUserOk(u'', ask)
            return
        if self._values.count < ItemsUtils.GetItemNumber(self._item):
            if not self._can_split:
                gui_jokes.askUserOk(u'', lc('soStartSale.CANT_SPLIT'))
                return

        def agree_callback(event):
            if event != gui_jokes.askUserYesNo.YES:
                return
            BigWorld.player().request_shop_item(self._item, self._values.count, total_price, self._bank_name)
            self.hide()

        count = cc.active_xml + unicode(self._values.count)
        item_name = ItemsUtils.GetItemName(self._item['complexItemType'], fGetShortName=True) + cc.inactive_xml
        price_text = cc.active_xml + groupNumber(total_price, "'") + cc.inactive_xml
        confirm_text = cc.inactive_xml + lc('soStartSale.CONFIRM_TEXT').format(count, item_name, price_text)
        gui_jokes.askUserYesNo(lc('soStartSale.CONFIRM_TITLE'), confirm_text, agree_callback)

    def _update_ok_btn(self):
        self.component.btn_ok.script.setDisabledState(not self._values.total_price)

    def _apply_item_name_to_text(self, item_name, text_comp):
        text = text_comp.script
        text.height = 200
        text.setText(cc.highlighted2_xml + u'<alignment=center><font=RobotoCondensedRegular_16.font>' + item_name, immidiate=True)
        text.recalc_auto_height()

    def show(self, data):
        self._item = data['item']
        self._can_split = data['slots'][0] < data['slots'][1]
        self._bank_name = data['bank_name']
        self.component.visible = True
        item = {'complexItem': PY(self._item)}
        self._name_section.update(item)
        name_comp = self._name_section.component
        comp = self._values.component
        comp.position[1] = name_comp.position[1] + name_comp.height + 8
        self._values.set_data(self._item)
        self.component.height = comp.position[1] + comp.height + 48
        btn_y = self.component.height - 22
        self.component.btn_ok.position[1] = btn_y
        self.component.btn_cancel.position[1] = btn_y

    def hide(self):
        self.component.visible = False
        self._values.deactivate()