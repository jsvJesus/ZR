            comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
            comp.width, comp.height = button_size, button_size
            comp.position = (margin + i * x_disp, pos_y, 0.5)
            button = PaintButton(comp, visual_state='soGUI/frame/loginwin/loginwinImageButton.xml')
            button.image = _login_data[login_type]['pic']
            button.on_click = partial(self._on_login_click, login_type)
            button.do_reposition()
            self.component.addChild(comp)

        pos_y += comp.height
        spec_login_type = LoginType.NONE
        if BigWorld.auth.is_enable_steam_button:
            spec_login_type = LoginType.STEAM
        elif BigWorld.auth.is_enable_mygames_button:
            spec_login_type = LoginType.VK_PLAY
        if spec_login_type:
            pos_y += 20
            comp = GUI.Window()
            comp.materialFX = 'BLEND'
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.ha, comp.va = ('CENTER', 'TOP')
            comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
            comp.width, comp.height = center_width, button_size
            comp.position = (0, pos_y, 0.5)
            button = PaintButton(comp, visual_state='soGUI/frame/loginwin/loginwinImageButton.xml')
            button.on_click = partial(self._on_login_click, spec_login_type)
            button.do_reposition()
            self.component.addChild(comp, 'specbtn')
            comp = GUI.Window(_login_data[spec_login_type]['pic'])
            comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
