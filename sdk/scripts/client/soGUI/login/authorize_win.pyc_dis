        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = line_size, line_height
        comp.position = (self.component.width - margin, pos_y, 0.5)
        self.component.addChild(comp)
        pos_y += 20
        button_size = 40
        count = len(_base_buttons)
