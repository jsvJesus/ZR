 LoginType.VK_PLAY: {'pic': 'soGUI/frame/loginwin/vkplay.dds',
                     'btn_text': 'LoginWin.login.loginvkplay'},
 LoginType.STEAM: {'pic': 'soGUI/frame/loginwin/steam.dds',
