            comp.ha, comp.va = ('CENTER', 'CENTER')
            comp.position = (button_size * 0.5, 0, 0.5)
            comp.colour = grayish_color
            comp.width, comp.height = comp.texture.width, comp.texture.height
            self.component.specbtn.addChild(comp)
            comp = GUI.Text(lc(_login_data[spec_login_type]['btn_text']), 'RobotoCondensedRegular_24.font')
            comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
            comp.ha, comp.va = ('CENTER', 'CENTER')
            comp.colour = grayish_color
            comp.position = ((self.component.specbtn.width - button_size) * 0.5 + button_size, 0, 0.5)
            self.component.specbtn.addChild(comp)
            pos_y += self.component.specbtn.height
        pos_y += 20
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.colour = dark_color
        comp.materialFX = 'SOLID'
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = center_width, line_height
        comp.position = (0, pos_y, 0.5)
        self.component.addChild(comp)
        pos_y += comp.height
        pos_y += 20
        self._toggle = Toggle()
        self._toggle.on_state_changed = self._on_remember_toggled
        comp = self._toggle.component
        comp.position = (margin, pos_y, 0.5)
        self.component.addChild(comp, 'toggle')
        comp = GUI.Text(lc('LoginWin.login.remember'), 'RobotoCondensedRegular_18.font')
        comp.colour = RED_COLOUR
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        pos_x = self.component.toggle.width + self.component.toggle.position[0] + 16
        comp.position = (pos_x, pos_y + self.component.toggle.height * 0.5, 0.5)
        self.component.addChild(comp)
        pos_y += self.component.toggle.height
        pos_y += 20
        btn_text = lc(_login_data[LoginType.COMMON]['btn_text'])
        self._login_btn, pos_y = self._create_button(pos_y, center_width, btn_text)
        self._login_btn.on_click = partial(self._on_login_click, LoginType.COMMON)
        pos_y += 16
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = center_width, 24
        comp.position = (margin, pos_y, 0.5)
        self.component.addChild(comp)
        btn = PaintButton(comp, visual_state='soGUI/frame/loginwin/loginwinLineButton.xml')
        btn.text = lc('LoginWin.login.register')
        btn.on_click = self._on_register_click
        btn.do_reposition()
        pos_y += comp.height
        pos_y += 8
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = center_width, 24
        comp.position = (margin, pos_y, 0.5)
        self.component.addChild(comp)
        btn = PaintButton(comp, visual_state='soGUI/frame/loginwin/loginwinLineButton.xml')
        btn.text = lc('LoginWin.login.forgot')
        btn.on_click = self._on_password_click
        btn.do_reposition()
        pos_y += comp.height
        pos_y += 8
        comp = GUI.Text(u'', 'RobotoCondensedRegular_18.font')
        comp.colour = RED_COLOUR
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = center_width, 24
        comp.position = (margin, pos_y, 0.5)
        self.component.addChild(comp)
        self._error_text = comp
        pos_y += comp.height
        pos_y += 32
        return pos_y

    def _login_validator(self, new_str, whole_text, offset):
        result = self._text_validator(new_str, whole_text, offset)
        if not result:
            self._show_error_text(lc('LoginWin.login.badlogin'))
        return result

    def _password_validator(self, new_str, whole_text, offset):
        result = self._text_validator(new_str, whole_text, offset)
        if not result:
            self._show_error_text(lc('LoginWin.login.badpassword'))
        return result

    def _text_validator(self, new_str, whole_text, offset):
        try:
            result = str(new_str + whole_text)
        except:
            return False

        return len(result) <= MAX_TEXT_LENGTH

    def _on_login_tab(self):
        self._password_box.activate(True)

    def _on_key_event(self, event):
        if event.isKeyDown():
            if event.key == Keys.KEY_CAPSLOCK:
                self._check_caps_influence()
            elif event.key in (Keys.KEY_RETURN, Keys.KEY_NUMPADENTER):
                if self._login_btn.enabled and not self._notify_win.has_any() and not self.has_load():
                    self._on_login_click(LoginType.COMMON)
        return False

    def _check_caps_influence(self):
        self._errors[0] = lc('LoginWin.login.caps') if BigWorld.isCapsLockOn() else None
        self._update_error_text()
        return

    def on_show(self):
        BaseWin.on_show(self)
        BWPersonality.register_key_event_interceptor(self._on_key_event, high_priority=True)
        self._check_caps_influence()
        state = State.On if BigWorld.auth.save_enable else State.Off
        self._toggle.set_state(state, animated=False, notify=False)
        self._cancel_callback_and_clear_text()
        if not self._last_login_shown:
            self._last_login_shown = True
            if BigWorld.auth.last_login:
                self._login_box.setValue(BigWorld.auth.last_login)

    def _on_remember_toggled(self, state):
        BigWorld.auth.save_enable = state == State.On

    def on_hide(self):
        BWPersonality.unregister_key_event_interceptor(self._on_key_event)
        self._cancel_callback_and_clear_text()
        self._toggle.on_hide()
        self._deactivate_edits()

    def _deactivate_edits(self):
        self._login_box.activate(False)
        self._password_box.activate(False)

    def _on_load_cancel_click(self):
        BigWorld.auth.logout()

    def _provide_cancel_comp_example(self):
        return self._login_btn.component

    def _on_editbox_event(self, event_type, data):
        if event_type == EditBoxET.OnEmptyChanged:
            self._update_login_enable()

    def _update_error_text(self):
        self._error_text.text = self._errors[1] or self._errors[0] or u''

    def _show_error_text(self, text):
        self._errors[1] = text
        self._update_error_text()
        if self._clear_text_callback:
            BigWorld.cancelCallback(self._clear_text_callback)
        self._clear_text_callback = BigWorld.callback(3.0, self._cancel_callback_and_clear_text)

    def _cancel_callback_and_clear_text(self):
        self._errors[1] = None
        self._update_error_text()
        if self._clear_text_callback:
            BigWorld.cancelCallback(self._clear_text_callback)
            self._clear_text_callback = None
        return

    def _update_login_enable(self):
        enabled = False
        login = self._login_box.text_value
        password = self._password_box.text_value
        if login and password:
            try:
                str(login)
                str(password)
                if len(login) <= MAX_TEXT_LENGTH and len(password) <= MAX_TEXT_LENGTH:
                    enabled = True
            except:
                pass

        self._login_btn.enabled = enabled

    def _on_password_click(self):
        self._deactivate_edits()
        BWPersonality.GUICore.showWebEmbdeded(True, get_restore_password_url())

    def _on_register_click(self):
        self._deactivate_edits()
        BigWorld.auth.showRegisterWindow()

    def _on_login_click(self, login_type):
        self._deactivate_edits()
        data = {'login_type': login_type}
        if login_type == LoginType.COMMON:
            data['login'] = self._login_box.text_value
            data['password'] = self._password_box.text_value
        elif login_type in (LoginType.GOOGLE,
         LoginType.YANDEX,
         LoginType.VK,
         LoginType.OK,
         LoginType.MAIL):
            data['account_type'] = _login_data[login_type]['ac_type']
        self.notify_listeners(EventType.OnLoginRequest, data)