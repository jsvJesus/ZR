# Embedded file name: ./client/soGUI/login/myname.py
import BWPersonality
from math_bw import move_towards
import BigWorld
import GUI
import colorCodes as cc
from soGUI.UtilsGUI.PaintButton import PaintButton
from Localization import lc
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
from utils import force_unicode
from authentication.auth_client import EventType as AuthET
auth = BigWorld.auth

class TwoFButton(PaintButton):

    def __init__(self, comp):
        PaintButton.__init__(self, comp, visual_state='soGUI/frame/loginwin/2faButton.xml')
        comp = GUI.Simple('soGUI/frame/loginwin/largepip.dds')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (0.7, 0.7, 0.1)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'pip')
        self.component.isClip = False
        comp = GUI.Window()
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.height = 38
        comp.position = (1, -0.8, 0.4)
        comp.visible = False
        self.component.parent.addChild(comp, 'tooltip')
        self._tooltip = comp
        comp = GUI.Frame2('soGUI/frame/frame_tooltip.dds')
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.9)
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        self._tooltip.addChild(comp, 'frame')
        comp = GUI.Text(u'', 'RobotoCondensedRegular_18.font')
        comp.colour = cc.active_rgba
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.5)
        self._tooltip.addChild(comp, 'text')
        self._protected = True
        self._coroutine = None
        self._desired_alpha = 0.0
        self.alpha = 0.0
        return

    def handleMouseEnterEvent(self, comp):
        result = PaintButton.handleMouseEnterEvent(self, comp)
        if self._protected:
            txt_append = lc('LoginWin.notify.twoftt.on')
        else:
            txt_append = lc('LoginWin.notify.twoftt.off')
        self._tooltip.text.text = lc('LoginWin.notify.twoftt') + u' ' + txt_append
        self._tooltip.width = self._tooltip.text.width + 32
        self.desired_alpha = 1.0
        return result

    def handleMouseLeaveEvent(self, comp):
        result = PaintButton.handleMouseLeaveEvent(self, comp)
        self.desired_alpha = 0.0
        return result

    def on_show(self, protected):
        self.component.pip.visible = not protected
        self._protected = protected
        self._desired_alpha = 0.0
        self.alpha = 0.0

    def on_hide(self):
        if self._coroutine:
            self._coroutine.stop()
            self._coroutine = None
        return

    @BWMemberCoroutine
    def _fade_coroutine(self):
        speed = 5.0
        while self.alpha != self.desired_alpha:
            self.alpha = move_towards(self.alpha, self.desired_alpha, BigWorld.getTimeDelta() * speed)
            yield BWWaitForPeriod(0)

        self.alpha = self.desired_alpha
        self._coroutine = None
        return

    @property
    def alpha(self):
        return self._alpha

    @alpha.setter
    def alpha(self, value):
        self._alpha = value

        def colorise_comp(comp, acolor):
            comp.colour[3] = acolor
            for _, child in comp.children:
                colorise_comp(child, acolor)

        colorise_comp(self._tooltip, self._alpha * 255.0)
        self._tooltip.visible = self._alpha > 0

    @property
    def desired_alpha(self):
        return self._desired_alpha

    @desired_alpha.setter
    def desired_alpha(self, value):
        if value == self._desired_alpha:
            return
        self._desired_alpha = value
        if not self._coroutine:
            self._coroutine = self._fade_coroutine()
            self._coroutine.run()


class MyName:

    def __init__(self):
        comp = GUI.Window()
        comp.isClip = False
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.position = (0, 1, 0.5)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (0, 64)
        comp.visible = False
        self.component = comp
        self._cpy_coroutine = None
        comp = GUI.Simple(u'')
        self.component.addChild(comp, 'bcomp')
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.width, comp.height = (28, 28)
        comp.position = (10, 0, 0.5)
        self.component.bcomp.addChild(comp, 'cbtn')
        btn = PaintButton(comp, visual_state='soGUI/frame/loginwin/copyButton.xml')
        btn.do_reposition()
        btn.on_click = self._on_cpy_click
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.width, comp.height = (32, 32)
        comp.position = (10, 0, 0.5)
        self.component.bcomp.addChild(comp, 'tbtn')
        self._towf_btn = TwoFButton(comp)
        self._towf_btn.on_click = self._on_towf_click
        self._towf_btn.do_reposition()
        comp = GUI.Window()
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.colour = cc.active_rgba
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.5)
        self.component.bcomp.addChild(comp, 'image')
        comp = GUI.Text(u'', 'RobotoCondensedRegular_24.font')
        comp.colour = cc.active_rgba
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (0, 0, 0.5)
        self.component.bcomp.addChild(comp, 'text')
        comp = GUI.Text(lc('LoginWin.notify.copied'), 'RobotoCondensedRegular_18.font')
        comp.colour = cc.active_rgba
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.position = (0, -1, 0.5)
        comp.visible = False
        self.component.bcomp.addChild(comp, 'txtcpy')
        return

    @BWMemberCoroutine
    def _cpy_txt_coroutine_precedure(self):
        comp = self.component.bcomp.txtcpy
        comp.visible = True
        comp.colour[3] = 0
        speed = 2000
        while comp.colour[3] < 255.0:
            yield BWWaitForPeriod(0)
            comp.colour[3] = move_towards(comp.colour[3], 255.0, BigWorld.getTimeDelta() * speed)

        yield BWWaitForPeriod(2.0)
        while comp.colour[3] > 0:
            yield BWWaitForPeriod(0)
            comp.colour[3] = move_towards(comp.colour[3], 0.0, BigWorld.getTimeDelta() * speed)

        comp.visible = False
        self._cpy_coroutine = None
        return

    def show(self, image, name, protected):
        width = 0
        comp = self.component.bcomp.image
        if image:
            comp.visible = True
            comp.textureName = image
            comp.width, comp.height = comp.texture.width, comp.texture.height
            width += comp.width + 8
        else:
            comp.visible = False
        comp = self.component.bcomp.text
        if name:
            name = force_unicode(name)
            comp.visible = True
            comp.position[0] = width
            comp.text = name
            width += comp.stringDimensions(name)[0]
            width += 8
        else:
            comp.visible = False
        comp = self.component.bcomp.cbtn
        comp.position[0] = width
        width += comp.width
        comp = self.component.bcomp.tbtn
        comp.position[0] = width
        width += comp.width
        self.component.width = width
        self.component.visible = True
        self._towf_btn.on_show(protected)

    def _on_towf_click(self):
        if not auth.isOTP2FA:
            auth.add_listener(self._on_auth_event)
            error_text = auth.enable2FAOTP()
            if error_text:
                caption = lc('LoginWin.notify.twoftt_caption')
                BWPersonality.GUICore.loginFlash.alert(caption, error_text)

    def _on_auth_event(self, event_type, data):
        if event_type == AuthET.OnOtpFaChanged:
            self._towf_btn.on_show(auth.isOTP2FA)
            if auth.isOTP2FA:
                auth.remove_listener(self._on_auth_event)

    def _on_cpy_click(self):
        text = 'Login: {1}, Name: {0},  LoginID: {2}'.format(BigWorld.auth.visible_name, BigWorld.auth.login, BigWorld.auth.LoginID)
        BigWorld.clipboardSetPlainText(force_unicode(text))
        if not self._cpy_coroutine:
            self._cpy_coroutine = self._cpy_txt_coroutine_precedure()
            self._cpy_coroutine.run()

    def make_invisible(self, invisible):
        self.component.bcomp.visible = not invisible

    def hide(self):
        self.component.visible = False
        self._towf_btn.on_hide()
        auth.remove_listener(self._on_auth_event)