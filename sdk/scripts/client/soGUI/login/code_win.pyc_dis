        return 400

    def show(self, data):
        BigWorld.zim = data
        BaseWin.show(self)
        self.set_load(False)
        show_repeat_code = data['2fa_can_resend_code']
        show_period = data['2fa_can_resend_code']
        fa_type = data['2fa_typeconfirm']
        if fa_type == TYPE_CONFIRM_ACC.PHONE:
            text = lc('LoginWin.code.phone_result').format(data['2fa_sent_to'])
            self._alt_btn.text = lc('LoginWin.code.email')
        elif fa_type == TYPE_CONFIRM_ACC.EMAIL:
            text = lc('LoginWin.code.email_result').format(data['2fa_sent_to'])
            self._alt_btn.text = lc('LoginWin.code.sms')
        elif fa_type == TYPE_CONFIRM_ACC.OTP2FA:
            show_repeat_code = False
            show_period = False
            text = lc('LoginWin.code.twof_result').format(data['2fa_sent_to'])
        else:
            raise RuntimeError
        if show_repeat_code:
            self.component.repeat.visible = True
            self._tbutton.on_show(data['2fa_send_code_cooldown'])
        else:
            self.component.repeat.visible = False
        self._tf_code.setText(cc.active_xml + '<font=RobotoCondensedRegular_24.font>' + text, immidiate=True)
        self._tf_code.height = 1000
        self._tf_code.recalc_auto_height()
        pos_y = self._tf_code.component.position[1] + self._tf_code.component.height
        pos_y += 16
        self._editbox.component.position[1] = pos_y
        self.component.entercode.position[1] = pos_y + self._editbox.component.height / 2
        self._okbutton.component.position[1] = pos_y
        pos_y += self._editbox.component.height
        pos_y += 32
        self._txt_attempts.position[1] = pos_y
        self._txt_attempts.text = lc('LoginWin.code.attempts') + u' ' + unicode(data['2fa_code_attempts_left'])
        pos_y += self._txt_attempts.height
        if show_period:
            self._txt_period.visible = True
            self._txt_period.position[1] = pos_y
            pos_y += self._txt_period.height
        else:
            self._txt_period.visible = False
        pos_y += 16
        self.component.support.position[1] = pos_y
        pos_y += self.component.support.height
        if not show_repeat_code:
            self.component.black.height = pos_y
            self.component.height = pos_y + 16
            return
        pos_y += 8
        self.component.repeat.line.position[1] = pos_y
        pos_y += self.component.repeat.line.height
        pos_y += 32
        self.component.repeat.codemore.position[1] = pos_y
        pos_y += self.component.repeat.codemore.height
        pos_y += 16
        acomp = self.component.repeat.altern
        acomp.position[1] = pos_y
        lcomp = self._alt_btn.component.label
        comp = self._alt_btn.component
        comp.width, comp.height = lcomp.width, lcomp.height
        x = acomp.position[0] + acomp.width + 8
        comp.position = (x, pos_y, 0.5)
        pos_y += acomp.height
        self.component.black.height = pos_y - self.component.black.position[1] + 16
        pos_y += 48
        self._tbutton.component.position[1] = pos_y
        pos_y += self._tbutton.component.height
        self.component.height = pos_y

    def on_error(self):
        if not self.visible:
            return
        self.set_load(False)

    def _on_support_click(self):
        import webbrowser
        webbrowser.open(get_support_url())

    def _on_alt_click(self):
        self.set_load(True)
        self.notify_listeners(EventType.ToggleAlt)

    def _on_new_code_click(self):
        self.set_load(True)
        self.notify_listeners(EventType.OnNewCodeRequest)

    def _on_exit_click(self):
        self.notify_listeners(EventType.OnExitRequest)

    def _on_ok_click(self):
        self._editbox.activate(False)
        self.set_load(True)
        self.notify_listeners(EventType.OnCodeEntered, self._editbox.text_value)

    def _on_editbox_event(self, event_type, data):
        if event_type == EditBoxET.OnEmptyChanged:
            self._okbutton.enabled = bool(self._editbox.text_value)

    def on_hide(self):
        BaseWin.on_hide(self)
        self._tbutton.on_hide()
        self._editbox.clear()
        self._editbox.activate(False)