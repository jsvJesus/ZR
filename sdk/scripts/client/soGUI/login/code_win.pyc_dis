class EventType:
    OnExitRequest, OnCodeEntered, OnNewCodeRequest, ToggleAlt = ((r, 'codewin') for r in range(4))


class TimerButton(PaintButton, Tickable):

    def __init__(self, comp):
        Tickable.__init__(self, 1)
        PaintButton.__init__(self, comp, visual_state='soGUI/frame/loginwin/loginwinTextButton3.xml')
        self._time = 0

    def can_tick(self):
        return Utils.is_visible_in_hierarchy(self.component)

    def on_show(self, time):
        self._time = BigWorld.time() + time
        if time > 0:
            self.start_tick()
        self._update_text()

    def on_check_tick(self):
        self._update_text()
        return not self.enabled

    def _update_text(self):
        time_remain = self._time - BigWorld.time()
        time_remain = int(round(time_remain))
        if time_remain > 0:
            self.text = u'{0} ({1})'.format(lc('LoginWin.code.request'), time_remain)
            self.enabled = False
        else:
            self.text = lc('LoginWin.code.request')
            self.enabled = True

    def on_hide(self):
        self.stop_tick()


