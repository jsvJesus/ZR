# Embedded file name: ./client/soGUI/login/servwin/serv_line.py
from Localization import lc
import GUI
import Keys
from utils import Listenable
from Helpers.PyGUI.PyGUIBase import Interceptor
from auth_common import ONLINE_GAME_SERVER_STATUS as STATUS
from ..tooltip import TooltipProviderLoginWin as TooltipProvider
import colorCodes as cc
back_colour = (220, 220, 220, 225)
hover_color = (195, 195, 195, 225)
selected_color = (161, 161, 161, 225)

class EventType:
    OnEnter, OnLeave, OnClick = ((r, 'servline') for r in range(3))


class ServLine(Interceptor, TooltipProvider, Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        Interceptor.__init__(self, component)
        self.component.script = self
        self._hovered = False
        self._selected = None
        self._tooltip_data = u''
        self._status = None
        self.uid = None
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'SOLID'
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'BOTTOM')
        comp.wm, comp.hm = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 1)
        comp.position = (0, -1, 0.5)
        self.component.addChild(comp)
        comp = GUI.Text(u'', 'RobotoCondensedRegular_24.font')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.position = (16, 0, 0.5)
        comp.colour = (0, 0, 0, 255)
        self.component.addChild(comp, 'txtName')
        comp = GUI.Window('soGUI/frame/loginwin/indicator.dds')
        comp.materialFX = 'BLEND'
        comp.filterType = 'LINEAR'
        comp.colour = (255, 0, 0, 255)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.position = (220, 0, 0.5)
        comp.width, comp.height = comp.texture.width, comp.texture.height
        self.component.addChild(comp, 'pip')
        comp = GUI.Text(u'', 'RobotoCondensedRegular_18.font')
        comp.colour = (0, 0, 0, 255)
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.position = (self.component.width, 0, 0.5)
        self.component.addChild(comp, 'stat')
        self._update_visual()
        return

    def get_tooltip_text(self):
        if self._status == STATUS.GREEN:
            return u'{0}{1}\n\\c1e8000ff;{2}'.format(cc.active_hex, lc('LoginWin.servers.load'), lc('LoginWin.servers.load.GREEN'))
        elif self._status == STATUS.YELLOW:
            return u'{0}{1}\n\\c84a700ff;{2}'.format(cc.active_hex, lc('LoginWin.servers.load'), lc('LoginWin.servers.load.YELLOW'))
        elif self._status == STATUS.RED:
            return u'{0}{1}\n\\c8c0007ff;{2}'.format(cc.active_hex, lc('LoginWin.servers.load'), lc('LoginWin.servers.load.RED'))
        else:
            return None
            return None

    def handleMouseEnterEvent(self, comp):
        TooltipProvider.on_mouse_enter(self)
        result = Interceptor.handleMouseEnterEvent(self, comp)
        data = {'line': self}
        self.notify_listeners(EventType.OnEnter, data)
        return result

    def handleMouseLeaveEvent(self, comp):
        TooltipProvider.on_mouse_leave(self)
        result = Interceptor.handleMouseLeaveEvent(self, comp)
        data = {'line': self}
        self.notify_listeners(EventType.OnLeave, data)
        return result

    def handleMouseButtonEvent(self, comp, event):
        result = Interceptor.handleMouseButtonEvent(self, comp, event)
        if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
            data = {'line': self}
            self.notify_listeners(EventType.OnClick, data)
        return result

    def handleMouseEvent(self, comp, event):
        Interceptor.handleMouseEvent(self, comp, event)
        return False

    def _update_visual(self):
        if self._selected:
            self.component.colour = selected_color
        elif self._hovered:
            self.component.colour = hover_color
        else:
            self.component.colour = back_colour

    def set_hovered(self, value):
        self._hovered = value
        self._update_visual()

    def set_selected(self, value):
        self._selected = value
        self._update_visual()

    def set_data(self, data):
        self.uid = data['uid']
        self.component.txtName.text = data['name']
        self._status = data['color_status']
        pip = self.component.pip
        stat = self.component.stat
        if self._status == STATUS.GREEN:
            pip.visible = True
            pip.colour = (30, 128, 0, 255)
            stat.colour = (30, 128, 0, 255)
            stat.text = u'Online'
        elif self._status == STATUS.RED:
            pip.visible = True
            pip.colour = (140, 0, 7, 255)
            stat.colour = (30, 128, 0, 255)
            stat.text = u'Online'
        elif self._status == STATUS.YELLOW:
            pip.visible = True
            pip.colour = (132, 167, 0, 255)
            stat.colour = (30, 128, 0, 255)
            stat.text = u'Online'
        else:
            pip.visible = False
            stat.colour = (140, 0, 7, 255)
            stat.text = u'Offline'