# Embedded file name: ./client/soGUI/login/tooltip.py
import BigWorld
from soGUI.donat_shop.window.element import Tickable
import GUI
from Helpers.PyGUI import Utils
from soGUI.soTextField import soTextField3

class TooltipProvider:

    def on_mouse_enter(self):
        global _instances
        _instances[self._tooltip_instance_id].push(self)

    def on_mouse_leave(self):
        _instances[self._tooltip_instance_id].pop(self)

    def get_tooltip_text(self):
        raise NotImplementedError


class TooltipProviderLoginWin(TooltipProvider):
    _tooltip_instance_id = 'LoginWin'


class TooltipProviderShopWin(TooltipProvider):
    _tooltip_instance_id = 'ShopWin'


_instances = {}

class Tooltip(object, Tickable):

    def __init__(self, instance_id):
        Tickable.__init__(self)
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.2)
        comp.visible = False
        self.component = comp
        self._provider = None
        comp = GUI.Frame2('soGUI/frame/frame_tooltip.dds')
        comp.materialFX = 'BLEND'
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.99)
        self.component.addChild(comp)
        _instances[instance_id] = self
        return

    def push(self, provider):
        self.provider = provider

    def pop(self, provider):
        if self.provider == provider:
            self.provider = None
        return

    def _update_content(self, text):
        raise NotImplementedError

    @property
    def provider(self):
        return self._provider

    @provider.setter
    def provider(self, value):
        if value == self._provider:
            return
        else:
            self._provider = value
            text = None
            if self._provider:
                text = self._provider.get_tooltip_text()
            if text:
                self._update_content(text)
                if not self.component.visible:
                    self.component.visible = True
                    self.start_tick()
            elif self.component.visible:
                self.component.visible = False
                self.stop_tick()
            return

    def on_tick(self):
        cursor_pos = GUI.mcursor().position
        x_pos, y_pos = cursor_pos[0], cursor_pos[1]
        screen_width, screen_height = BigWorld.screenSize()
        comp_width = float(self.component.width) / screen_width
        comp_height = float(self.component.height) / screen_height
        if x_pos + comp_width * 2 > 1:
            x_pos -= comp_width * 2
        if y_pos - comp_height * 2 < -1:
            y_pos += comp_height * 2
        self.component.position = (x_pos, y_pos, self.component.position[2])

    def can_tick(self):
        return Utils.is_visible_in_hierarchy(self.component)


class TextTooltip(Tooltip):

    def __init__(self, instance_id):
        Tooltip.__init__(self, instance_id)
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.position = (8, 8, 0.5)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.multiline = True
        comp.colourFormatting = True
        self.component.addChild(comp, 'text')

    def _update_content(self, text):
        size = self.component.text.stringDimensions(text)
        comp = self.component.text
        comp.width, comp.height = size
        comp.text = text
        self.component.width, self.component.height = size[0] + 16, size[1] + 16


class TextFieldTooltip(Tooltip):

    def __init__(self, instance_id, width):
        Tooltip.__init__(self, instance_id)
        self._width = width
        self._margin = 16
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width - self._margin * 2, 1000
        comp.position = (self._margin, self._margin, 0.5)
        self.component.addChild(comp)
        self._tf = soTextField3(comp, width=width, textWidth=comp.width, height=1000, hScroll=False, vScroll=False, vOffset=0, hOffset=0)

    def _update_content(self, text):
        self.component.width, self.component.height = self._width, 1000
        self._tf.setText(text, immidiate=True)
        self._tf.recalc_auto_height()
        self.component.height = self._tf.height + 2 * self._margin