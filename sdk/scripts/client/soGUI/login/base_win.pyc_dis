# Embedded file name: ./client/soGUI/login/base_win.py
import GUI
from Helpers.PyGUI.PyGUIBase import DragWin
from utils import Listenable
from Helpers.PyGUI.PyGUIBase import Interceptor
import colorCodes as cc
from soGUI.UtilsGUI.PaintButton import PaintButton
from Localization import lc

class EventType:
    OnShow, OnHide = ((r, 'loginbasewin') for r in range(2))


class BaseWin(DragWin, Listenable):

    def __init__(self, width = 380, margin = 40):
        Listenable.__init__(self)
        self._load_channels = set()
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.colour = (255, 255, 255, 220)
        comp.materialFX = 'BLEND'
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width = width
        comp.position = (0, 0, 0.9)
        comp.visible = False
        DragWin.__init__(self, comp)
        center_width = self.component.width - margin * 2
        self.component.height = self._create_content(margin, center_width)
        self._create_load_pane()

    def _provide_cancel_comp_example(self):
        return None

    def _create_load_pane(self):
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.colour = (255, 255, 255, 220)
        comp.materialFX = 'BLEND'
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0)
        self.component.addChild(comp, 'load')
        comp.visible = False
        Interceptor(comp)
        comp = GUI.Simple('soGUI/maps/loadingScreen/loadingCircle/loadingCircle.texanim')
        comp.materialFX = 'BLEND'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (0, 0, 0.1)
        self.component.load.addChild(comp)
        ex_comp = self._provide_cancel_comp_example()
        if ex_comp:
            comp = GUI.Window()
            comp.hpm, comp.vpm = ex_comp.hpm, ex_comp.vpm
            comp.ha, comp.va = ex_comp.ha, ex_comp.va
            comp.wm, comp.hm = ex_comp.wm, ex_comp.hm
            comp.width, comp.height = ex_comp.width, ex_comp.height
            comp.position = ex_comp.position
            self.component.load.addChild(comp, 'btnCancel')
            btn = PaintButton(comp, visual_state='soGUI/frame/loginwin/loginwinTextButtonRed.xml')
            btn.text = lc('LoginWin.cancel')
            btn.on_click = self._on_load_cancel_click
            btn.do_reposition()

    def _on_load_cancel_click(self):
        pass

    @property
    def visible(self):
        return self.component.visible

    def show(self):
        if not self.component.visible:
            self.component.visible = True
            self.on_show()

    def on_show(self):
        data = {'window': self}
        self.notify_listeners(EventType.OnShow, data)

    def hide(self):
        if self.component.visible:
            self.component.visible = False
            self.on_hide()

    def on_hide(self):
        data = {'window': self}
        self.notify_listeners(EventType.OnHide, data)

    def _create_content(self, margin, center_width, caption_text):
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'SOLID'
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.wm, comp.hm = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 50)
        comp.position = (0, 0, 1)
        self.component.addChild(comp, 'caption')
        pos_y = comp.height + comp.position[0]
        comp = GUI.Text(caption_text, 'RobotoCondensedRegular_24.font')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (self.component.width * 0.5, 0, 0.5)
        comp.colour = cc.active_rgba
        self.component.caption.addChild(comp, 'text')
        return pos_y

    def _create_button(self, pos_y, width, text, visual = 'soGUI/frame/loginwin/loginwinTextButton.xml'):
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width, 54
        comp.position = (self.component.width * 0.5, pos_y, 0.5)
        self.component.addChild(comp)
        btn = PaintButton(comp, visual_state=visual)
        btn.text = text
        btn.do_reposition()
        pos_y += comp.height
        return (btn, pos_y)

    def has_load(self):
        return bool(self._load_channels)

    def set_load(self, value, channel = None):
        if value:
            self._load_channels.add(channel)
        elif channel in self._load_channels:
            self._load_channels.remove(channel)
        self.component.load.visible = bool(self._load_channels)