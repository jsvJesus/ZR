class EventType:
    OnEmptyChanged, = ((r, 'auth.editbox') for r in range(1))


class EditBox(soEditBox2, Listenable):
    FRAME_PASSIVE = BigWorld.PyTextureProvider('soGUI/frame/paint/gray.dds')
    FRAME_ACTIVE = BigWorld.PyTextureProvider('soGUI/frame/paint/white.dds')
    FRAME_ERROR = BigWorld.PyTextureProvider('soGUI/frame/paint/reddark.dds')

    def __init__(self, component, mask_char = None, placeholder = None, input_validator = None):
        Listenable.__init__(self)
        soEditBox2.__init__(self, component, component.width, component.height, font='RobotoCondensedRegular_24.font', autosize=False, hOffset=12, vOffset=5, color=(0, 0, 0, 255), maskChar=mask_char, placeholder=placeholder, inputValidator=input_validator or self._input_validator)
        self.SELECTION_BG = (150, 150, 150, 255)
        self.component.textPlane.cursor.colour = (0, 0, 0, 255)
        self.setEnableCopyPaste(True)
        self._text_value = u''

    def _input_validator(self, new_str, whole_text, offset):
        return True

    def runErrorNotify(self):
        if self.errorNotifier:
            self.errorNotifier.stop()
        self.errorNotifier = self._special_erroneous_state()
        self.errorNotifier.run()

    @BWMemberCoroutine
    def _special_erroneous_state(self):
        for i in range(4):
            self.erroneous = True
            self.updateVisuals()
            yield BWWaitForPeriod(0.05)
            self.erroneous = False
            self.updateVisuals()
            yield BWWaitForPeriod(0.05)

        self.errorNotifier = None
        return

    def onValueChange(self, by_user):
        self.text_value = self.getRaw()

    @property
    def text_value(self):
        return self._text_value

    @text_value.setter
    def text_value(self, value):
        if value == self._text_value:
            return
        self._text_value = value
        self.notify_listeners(EventType.OnEmptyChanged)