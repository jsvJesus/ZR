# Embedded file name: ./client/soGUI/soEventGUI.py
import GUI
import BigWorld
import ItemsUtils
import BWPersonality
from time import time
from Localization import lc
from Helpers.PyGUI import PyGUIBase
from soGUI.GUIPositions import GUIPositions
from client_utils import pixels_to_clip
from Helpers.PyGUI.DraggableComponent import DraggableComponent

class soEventGUI(PyGUIBase, GUIPositions, DraggableComponent):
    factoryString = 'soGUI.soEventGUI'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, 0, 0)
        GUIPositions.__init__(self)
        component.script = self
        self.saved_time = 0
        self.update_timer_id = None
        self.setupRoot()
        self.setupContent()
        self.doReposition()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.textureName = 'textures/default/white.dds'
        cmp.colour = (0, 0, 0, 36)
        cmp.materialFX = 'BLEND'
        cmp.width = 240
        cmp.height = 85
        cmp.position = (0, 1, 0.9)

    def reset_position(self):
        self.component.position = (0, 1, 0.9)

    def setupContent(self):
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.font = 'RobotoCondensedRegular_20.font'
        cmp.position = (15, 10, 0.5)
        cmp.text = '00:00:00'
        self.component.addChild(cmp, 'time')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.multiline = True
        cmp.font = 'RobotoCondensedRegular_20.font'
        cmp.position = (15, 33, 0.5)
        cmp.text = u'0'
        self.component.addChild(cmp, 'count')

    def stopDragging(self):
        GUIPositions.stopDragging(self)
        DraggableComponent.stopDragging(self)

    def handleMouseButtonEvent(self, comp, event):
        if not event.isMouseButton():
            return False
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def update_cooldown(self):
        saved_time = BWPersonality.GUICore.eventDataSection.get('saved_time')
        if not self.component.visible or not saved_time:
            self.component.time.text = ''
            return
        time_left = max(saved_time - time(), 0)
        self.component.time.text = lc('GUI.event_gui.time_left').format(ItemsUtils.timeToStringSec(time_left))
        if time_left:
            self.update_timer_id = BigWorld.callback(1, self.update_cooldown)

    def update_count(self):
        mob_count = BWPersonality.GUICore.eventDataSection.get('mob_count', 0)
        mob_all = BWPersonality.GUICore.eventDataSection.get('mob_all', 0)
        killed = BWPersonality.GUICore.eventDataSection.get('killed', 0)
        table_position = BWPersonality.GUICore.eventDataSection.get('table_position', 0)
        phase = BWPersonality.GUICore.eventDataSection.get('phase', 0)
        lines = []
        if phase:
            lines.append(lc('GUI.event_gui.phase').format(phase))
        if killed or mob_all:
            lines.append(lc('GUI.event_gui.killed').format(killed, mob_all))
        if mob_count:
            lines.append(lc('GUI.event_gui.enemies').format(mob_count))
        if table_position:
            lines.append(lc('GUI.event_gui.table_position').format(table_position))
        self.component.count.text = '\n'.join(lines)
        self.component.height = 45 + len(lines) * 25

    def set_cooldown(self, cooldown):
        if self.update_timer_id:
            BigWorld.cancelCallback(self.update_timer_id)
            self.update_timer_id = None
        if cooldown == -1:
            self.saved_time = None
        self.saved_time = time() + cooldown
        self.update()
        return

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'eventGUI')
        GUIPositions.show(self)
        self.component.visible = True
        self.update_cooldown()
        self.update_count()
        return

    def hide(self):
        self.component.visible = False