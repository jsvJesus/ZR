# Embedded file name: ./client/soGUI/clan_perks/exp_line.py
import GUI
from math_bw import clamp
from Localization import lc
import colorCodes as cc
import ClanSettings as CS

class ExpLine:

    def __init__(self, component, create_header = True):
        comp = component
        comp.isClip = False
        comp.materialFX = 'SOLID'
        comp.colour = (21, 24, 27, 255)
        self.component = comp
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.materialFX = 'SOLID'
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.colour = cc.active_rgba
        comp.height = 2
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (-1, 0, 0.9)
        self.component.addChild(comp, 'filler')
        self._txt_level = None
        if create_header:
            space = 8
            comp = GUI.Text(lc('GUI.ClanGUI.PERKS.Level'), 'RobotoCondensedRegular_20.font')
            comp.colour = cc.inactive_rgba
            comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
            comp.ha, comp.va = ('RIGHT', 'CENTER')
            comp.position = (-space, 0, 0.5)
            self.component.addChild(comp)
            width = comp.stringDimensions(comp.text)[0]
            comp = GUI.Text(u'', 'RobotoCondensedRegular_20.font')
            comp.colour = cc.active_rgba
            comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
            comp.ha, comp.va = ('RIGHT', 'CENTER')
            comp.position = (-width - space - 2, 0, 0.5)
            self.component.addChild(comp)
            self._txt_level = comp
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.colour = cc.inactive_rgba
        comp.position = (0, 0, 0.1)
        self.component.addChild(comp, 'exp')
        return

    def clear_data(self):
        if self._txt_level:
            self._txt_level.visible = False

    def set_data(self, level, clan_points):
        total_points = CS.get_upgrade_cost(level)[1]
        points_ratio = clamp(float(clan_points) / total_points)
        level_size = 1.0 / CS.get_max_level()
        line_ratio = (level - 1 + points_ratio) * level_size
        self.component.filler.width = line_ratio * 2
        if self._txt_level:
            self._txt_level.visible = True
            self._txt_level.text = str(level)
        self.component.exp.text = '{0}/{1}'.format(clan_points, total_points)