from perks_system import perks_parser as pp

class EventType:
    OnLearnClick, OnHide = ((r, 'clanperkinfo') for r in range(2))


class InfoWin(DragWin, Listenable):

    def __init__(self, depth):
        Listenable.__init__(self)
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.colour = (255, 255, 255, 220)
        comp.visible = False
        comp.materialFX = 'BLEND'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.width, comp.height = (300, 400)
        comp.position = (0, 0, depth)
        BWPersonality.GUICore.worldLayer.addChild(comp, 'clan_perks_info')
        self._perk_id = None
        DragWin.__init__(self, comp)
        comp = GUI.Window()
        close_btn = soButton(comp)
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.width, comp.height = (18, 18)
        comp.position = (self.component.width - 6, 6, 0.3)
        close_btn.onClick = self.hide
        close_btn.initVSC('soGUI/elements/closeBox.xml')
        close_btn.setVisualState('normal')
        close_btn.onBound()
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (220, 100)
        comp.position = (0, 20, 0.5)
        self.component.addChild(comp, 'caption')
        self._caption = soTextField3(comp, width=comp.width, textWidth=comp.width, height=100, borderWidth=0, vOffset=0, hOffset=0, hScroll=False, vScroll=False)
        left_pos = 22
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.colour = cc.active_rgba
        comp.position = (left_pos, 0, 0.5)
        self.component.addChild(comp, 'txt_uses')

        def create_line(caption_lc, comp_name, comp_level_name):
            comp = GUI.Text(lc(caption_lc), 'RobotoCondensedRegular_16.font')
            comp.ha, comp.va = ('LEFT', 'TOP')
            comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
            comp.colour = cc.inactive_rgba
            comp.position = (left_pos, 0, 0.5)
            self.component.addChild(comp, comp_name)
            txt_comp = comp
            comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
            comp.ha, comp.va = ('LEFT', 'TOP')
            comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
            comp.colour = cc.active_rgba
            pos_x = txt_comp.position[0] + txt_comp.stringDimensions(txt_comp.text)[0] + 8
            comp.position = (pos_x, 0, 0.5)
            self.component.addChild(comp, comp_level_name)

        create_line('GUI.ClanGUI.PERKS.InfoLevel', 'txt_level', 'txt_level_value')
        create_line('GUI.ClanGUI.PERKS.CPget', 'txt_cpget', 'txt_cpget_value')
        create_line('GUI.ClanGUI.PERKS.CPcost', 'txt_cpcost', 'txt_cpcost_value')
        create_line('GUI.ClanGUI.PERKS.MoneyCost', 'txt_moneycost', 'txt_moneycost_value')
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width - 2 * left_pos, 100
        comp.position = (left_pos, 0, 0.5)
        self.component.addChild(comp, 'description')
        self._description = soTextField3(comp, width=comp.width, textWidth=comp.width, height=100, borderWidth=0, vOffset=0, hOffset=0, hScroll=False, vScroll=False)
        comp = GUI.Window('')
        btn = soButton(comp)
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.width, comp.height = (180, 29)
        comp.position = (0, 0, 0.4)
        comp.label.text = lc('GUI.ClanGUI.PERKS.LearnPerk')
        btn.initVSC('soGUI/elements/button_1.xml')
        btn.onBound()
        btn.onClick = self._on_learn_click
        self.component.addChild(comp, 'btn_learn')
        return

    def show(self, perk_id, is_pathed, level, personal_points, available):
        self._perk_id = perk_id
        perk_name = lc('PerksSystem.name.id{0}'.format(self._perk_id))
        text = u'<alignment=center><font=RobotoCondensedRegular_16.font><color={0}>{1}'.format(cc.active_hex, perk_name)
        pos_y = self._caption.component.position[1]
        self._caption.height = 1000
        self._caption.setText(text, immidiate=True)
        self._caption.recalc_auto_height()
        pos_y += self._caption.component.height
        pos_y += 16
        if is_pathed:
            self.component.txt_uses.text = lc('GUI.ClanGUI.PERKS.Used')
        else:
            self.component.txt_uses.text = lc('GUI.ClanGUI.PERKS.Unused')
        self.component.txt_uses.position[1] = pos_y
        pos_y += 28
        self.component.txt_level.position[1] = pos_y
        self.component.txt_level_value.text = str(level)
        self.component.txt_level_value.position[1] = pos_y
        pos_y += 28
        self.component.txt_cpget.position[1] = pos_y
        total_points = pp.get_cost(self._perk_id)
        self.component.txt_cpget_value.text = u'{0}/{1}'.format(personal_points, total_points)
        self.component.txt_cpget_value.position[1] = pos_y
        pos_y += 28
        self.component.txt_cpcost.position[1] = pos_y
        self.component.txt_cpcost_value.text = str(CS.get_perk_buy_cp_cost(level))
        self.component.txt_cpcost_value.position[1] = pos_y
        pos_y += 28
        self.component.txt_moneycost.position[1] = pos_y
        self.component.txt_moneycost_value.text = str(CS.get_perk_buy_money_cost(level))
        self.component.txt_moneycost_value.position[1] = pos_y
        pos_y += 28
        perk_name = lc('PerksSystem.desc.id{0}'.format(self._perk_id))
        text = u'<alignment=left><font=RobotoCondensedRegular_16.font><color={0}>{1}'.format(cc.active_hex, perk_name)
        self._description.component.position[1] = pos_y
        self._description.height = 1000
        self._description.setText(text, immidiate=True)
        self._description.recalc_auto_height()
        pos_y += self._description.component.height
        pos_y += 28
        comp = self.component.btn_learn
        if available:
            comp.visible = True
            comp.position[1] = pos_y
            pos_y += comp.height
            pos_y += 18
        else:
            comp.visible = False
        self.component.height = pos_y
        self.component.visible = True

    def _on_learn_click(self):
        data = {'perk_id': self._perk_id}
        self.notify_listeners(EventType.OnLearnClick, data)

    def hide(self):
        self._perk_id = None
        self.component.visible = False
        self.notify_listeners(EventType.OnHide)
        return

    def on_release(self):
        BWPersonality.GUICore.addChild(self.component, 'clan_perks_info')