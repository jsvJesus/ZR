# Embedded file name: ./client/soGUI/npc_reload_ui/mag_view.py
from Items import ItemsCatalog
import BigWorld
import GUI
from soGUI.soItemView import soItemView
from model import EventType as ModelET
from gui_const import ITSLOT
import ItemsUtils
from slot import Slot

class MagSlot(Slot):

    def setupContent(self):
        Slot.setupContent(self)
        self._create_multiselector()

    def _is_mag_valid(self):
        if not self._model.bullet:
            return True
        bullet_params = ItemsCatalog.GetItemParam(self._model.bullet['complexItemType'])
        mag_params = ItemsCatalog.GetItemParam(self.itemData['complexItemType'])
        return mag_params['AmmoClass'] == bullet_params['AmmoClass']

    def _applyItemData(self):
        Slot._applyItemData(self)
        if self.haveItem():
            self._icon.colour = (255, 255, 255, 255) if self._is_mag_valid() else (255, 0, 0, 255)


class MagView(soItemView):

    def __init__(self, model):
        self._model = model
        self._model.add_listener(self._on_model_event)
        comp = GUI.Window()
        soItemView.__init__(self, comp, MagSlot, rows=5, cols=6, slot_eventsHandler=self._slot_events_handler, hScroll=False, vScroll=False, borderWidth=0)
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'TOP')
        self.onBound()
        self.set_multiselectable()
        self.setItems(self._model.items)

    def _on_model_event(self, event_type, data):
        if event_type in (ModelET.OnCleared, ModelET.OnExtended, ModelET.OnRemoved):
            self.setItems(self._model.items)
        elif event_type == ModelET.OnBullet:
            self._applyItems()

    def on_outdrop(self, slot):
        self._model.remove_items(slot.get_multiselection())

    def _slot_events_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DROP:
            slot = data[1]
            if slot.factoryString == 'soGUI.soInventorySlot2':
                item_ids = slot.get_multiselection()
                items = ItemsUtils.get_multiple_items_by_ids(BigWorld.player(), item_ids)
                self._model.extend_items(items)
        return True