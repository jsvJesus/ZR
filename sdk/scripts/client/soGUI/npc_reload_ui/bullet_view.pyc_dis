# Embedded file name: ./client/soGUI/npc_reload_ui/bullet_view.py
import ItemsUtils
from soGUI import soContextMenuComponent as CMC
from Localization import lc
import BWPersonality
import Keys
import GUI
from soGUI.soItemView import soItemView
from model import EventType as ModelET
from slot import Slot
from gui_const import ITSLOT, MESSAGEBOX
import msgbox_templates

class BulletSlot(Slot):
    pass


class BulletView(soItemView):
    factoryString = 'npcreload.BulletView'
    DEVIDE_ACTION = 0

    def __init__(self, model):
        self._model = model
        self._model.add_listener(self._on_model_event)
        self._msg_box = None
        comp = GUI.Window()
        soItemView.__init__(self, comp, BulletSlot, rows=1, cols=1, slot_eventsHandler=self._slot_events_handler, hScroll=False, vScroll=False, borderWidth=0)
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'TOP')
        self.onBound()
        self.setItems([])
        return

    def _on_model_event(self, event_type, data):
        if event_type in (ModelET.OnBullet, ModelET.OnCleared):
            self.setItems([self._model.bullet])
            if self._msg_box:
                self._msg_box.internalClose()
                self._msg_box = None
        return

    def on_show(self):
        BWPersonality.GUICore.addListener('contextMenuEvent', self._context_menu_event)

    def on_hide(self):
        BWPersonality.GUICore.removeListener('contextMenuEvent', self._context_menu_event)
        if self._msg_box:
            self._msg_box.internalClose()
            self._msg_box = None
        return

    def _context_menu_event(self, interface_id, eventid, caption, event, data = None):
        if event == CMC.EVENT_SELECT and interface_id == self.factoryString:
            if eventid == BulletView.DEVIDE_ACTION:
                self._invoke_devision()

    def _invoke_devision(self):

        def number_check(newStr, wholeText, offset):
            full_text = wholeText[0:offset] + newStr + wholeText[offset:]
            if not full_text.isdigit():
                return False
            if wholeText:
                return 0 < int(full_text) < ItemsUtils.GetItemNumber(self._model.bullet)
            return True

        def callback(event, data):
            if event == MESSAGEBOX.EVENT_BTNPRESS:
                self._msg_box = None
                if data['btn'] == MESSAGEBOX.BTN_OK:
                    text = data['add_controls']['edit_box']
                    if text.isdigit():
                        devide_count = int(text)
                        cur_number = ItemsUtils.GetItemNumber(self._model.bullet)
                        self._model.set_bullet_count(cur_number - devide_count)
            return

        self._msg_box = msgbox_templates.input_box_ok_cancel(MESSAGEBOX.MSG_ID_CACHE_SPARE, lc('Inventory.client.DIVIDE_PROCESS'), lc('Inventory.client.HOW_MUCH_ITEMS_DEVIDE'), callback=callback, default='1', input_validator=number_check)

    def _slot_events_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DROP:
            slot = data[1]
            if slot.factoryString == 'soGUI.soInventorySlot2':
                self._model.bullet = slot.itemData
        elif event == ITSLOT.SLOTEVENT_MOUSEBUTTON:
            if self._model.bullet and data[1].isKeyDown() and not data[1].isRepeatedEvent():
                if data[1].key == Keys.KEY_MIDDLEMOUSE:
                    self._invoke_devision()
                elif data[1].key == Keys.KEY_RIGHTMOUSE:
                    BWPersonality.GUICore.showContextMenu(self.factoryString, {BulletView.DEVIDE_ACTION: lc('Inventory.client.DIVIDE')})
        return True

    def on_outdrop(self, slot):
        self._model.bullet = None
        return