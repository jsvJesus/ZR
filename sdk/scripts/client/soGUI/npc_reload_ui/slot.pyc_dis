        comp = GUI.Simple(u'')
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'container')

    def setupContent(self):
        comp = GUI.Frame2('soGUI/items/cell.dds')
        comp.vpm, comp.hpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
