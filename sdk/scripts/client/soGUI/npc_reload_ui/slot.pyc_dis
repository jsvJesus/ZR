        self._icon = comp
        comp = GUI.Text('', 'ArialNarrow_10.family')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.colour = cc.highlighted2_rgba
        comp.position = (self.SLOTWIDTH - 3, 1, 0.3)
        self.component.container.addChild(comp, 'itemCount')
        self._create_multidrag_proxy()

    def _applyItemData(self):
        soItemSlot._applyItemData(self)
        container = self.component.container
        if self.haveItem():
            icon_name = ItemsUtils.GetIconName(self.itemData) or 'nottexture.dds'
            self._icon.textureName = icon_name
            container.visible = True
            container.itemCount.text = ItemsUtils.GetDisplayValue(self.itemData)
        else:
            container.visible = False
        self.set_drag_proxy_visual(self._icon.texture, self.multiselected)

    @property
    def _model(self):
        return self.parent_view._model

    def on_drag_start(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def on_drag_stop(self):
        self.dragProxy.visible = False
        return True

    def on_out_screen_drop(self):
        self.parent_view.on_outdrop(self)

    def on_inventory_drop(self):
        self.parent_view.on_outdrop(self)