    def show(self):
        self._npc_id = BigWorld.player().last_interlocutor_id
        if self._npc_id:
            npc = BigWorld.entities.get(self._npc_id)
            if npc:
                self._bullet_price = AP.get_npc_load_price(npc.npcName)
        if not self.component.visible:
            self.component.visible = True
            self._on_show()

    def _get_default_position(self):
        return (0, 0, 0.9)

    def reset_position(self):
        self.component.position = self._get_default_position()

    def _on_show(self):
        BWPersonality.GUICore.setBestCursor()
        self._bullet_view.on_show()
        self._update_content()
        GUIPositions.show(self)
        if self._npc_id:
            self.start_tick()

    def _update_content(self):
        if not self._model.items:
            reset_enabled = self._model.bullet
            self.component.btn_reset.script.setDisabledState(not reset_enabled)
            mags_valid = True
            bullets_count1 = 0
            bullets_count2 = 0
            bullets_counter = 0
            mags2 = []
            if self._model.bullet:
                bullet_type = self._model.bullet['complexItemType']
                bullet_param = ItemsCatalog.GetItemParam(bullet_type)
                bullet_ammo_class = bullet_param.get('AmmoClass')
                bullets_count1 = ItemsUtils.GetItemNumber(self._model.bullet)
                bullets_count2 = min(bullets_count1, int(BigWorld.player().CreditNumber) / int(self._bullet_price))
                for mag in self._model.items:
                    mag_param = ItemsCatalog.GetItemParam(mag['complexItemType'])
                    if bullet_ammo_class != mag_param.get('AmmoClass'):
                        mags_valid = False
                        continue
                    mag_inc = ItemsUtils.GetComplexItemInconstanParams(mag)
                    ammo_type = mag_inc.get(ItemsCatalog.INC_LOADED_MUNITION_TYPE, 0)
                    ammo_number = mag_inc.get(ItemsCatalog.INC_MUNITION_NUMBER, 0)
                    ammo_max = mag_param.get('AmmoCapacity', 0)
                    if bullet_type == ammo_type:
                        ammo_need = ammo_max - ammo_number
                    else:
                        ammo_need = ammo_max
                    if ammo_need <= 0:
                        continue
                    if bullets_counter < bullets_count2:
                        mags2.append(mag['complexItemID'])
                    bullets_counter += ammo_need

            bullets_count1 = min(bullets_count1, bullets_counter)
            bullets_count2 = min(bullets_count2, bullets_counter)
            if mags_valid:
                text = bullets_count2 < bullets_count1 and cc.inactive_xml + lc('npcreloadui.NotAll')
            else:
                text = cc.inactive_xml + lc('npcreloadui.PlaceMags')
        else:
            text = cc.red_xml + lc('npcreloadui.RemoveMags')
        self._tf.height = 100
        self._tf.setText(text, immidiate=True)
        self._tf.recalc_auto_height()
        price1 = bullets_count1 * self._bullet_price
        price2 = bullets_count2 * self._bullet_price
        self.component.total.text = cc.inactive_hex + lc('npcreloadui.Total').format(cc.active_hex + unicode(price1))
        can_load = bullets_count2 > 0 and mags_valid and self._bullet_price > 0
        self.component.btn_load.script.setDisabledState(not can_load)
        self._last_used_data = {'mags': mags2,
         'bullets': bullets_count2,
         'price': price2}

    def _on_model_event(self, event_type, data):
        if event_type in (ModelET.OnCleared,
         ModelET.OnExtended,
         ModelET.OnRemoved,
         ModelET.OnBullet):
            BigWorld.callback(0, BWPersonality.GUICore.inventoryGUI.update)
            self._update_content()
        if event_type in (ModelET.OnCleared, ModelET.OnBullet):
            item = self._model.bullet
            if item:
                item_name = ItemsUtils.GetItemName(item['complexItemType'], fGetShortName=True)
                self._bullet_name.text = item_name
            else:
                self._bullet_name.text = u''

    def _on_reset_click(self):
        self._model.clear()

    def _on_load_click(self):
        mags_count = len(self._last_used_data['mags'])
        bullets_count = self._last_used_data['bullets']
        price = self._last_used_data['price']
        text = cc.inactive_xml + lc('npcreloadui.Confirm.Text0').format(cc.active_xml + unicode(mags_count)) + '\n' + cc.inactive_xml + lc('npcreloadui.Confirm.Text1').format(cc.active_xml + unicode(bullets_count)) + '\n' + cc.inactive_xml + lc('npcreloadui.Confirm.Text2').format(cc.active_xml + unicode(price)) + '\n' + cc.inactive_xml + lc('npcreloadui.Confirm.Text3')

        def callback(event):
            self._confirm_win = None
            if event == gui_jokes.askUserYesNo.YES:
                p = BigWorld.player()
                if p.CreditNumber < price:
                    p.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Items.Messages.FAIL_NO_MONEY'))
                    return
                mag_ids = self._last_used_data['mags']
                bullet_id = self._model.bullet['complexItemID']
                mags = ItemsUtils.get_multiple_items_by_ids(p, mag_ids)
                bullet = ItemsUtils.GetComplexItemByID(p, bullet_id)
                if not all(mags) or not bullet:
                    p.putMessageSystem(MC.Items_Messages_FAIL_NOT_ITEMS, [], [])
                    return
                item_bullets_count = ItemsUtils.GetItemNumber(bullet)
                if item_bullets_count < bullets_count:
                    p.putMessageSystem(MC.Items_Messages_FAIL_NOT_ITEMS, [], [])
                    return
                p.cell.npc_load_ammo(bullet_id, mag_ids, bullets_count, price)
                self._model.clear()
            return

        self._confirm_win = gui_jokes.askUserYesNo(lc('npcreloadui.Confirm.Title'), text, callback=callback)

    def on_money_changed(self):
        if self.visible:
            self._update_content()

    def hide(self):
        if self.component.visible:
            self.component.visible = False
            self._on_hide()

    def _on_hide(self):
        BWPersonality.GUICore.setBestCursor()
        self._model.clear()
        self._bullet_view.on_hide()
        self._last_used_data = None
        self._bullet_price = None
        self._npc_id = None
        self.stop_tick()
        if self._confirm_win:
            self._confirm_win.close()
            self._confirm_win = None
        return

    def on_tick(self):
        npc = BigWorld.entities.get(self._npc_id)
        if not npc or npc.isDestroyed or BigWorld.player().isDestroyed:
            self.hide()
            return
        if npc.position.distSqrTo(BigWorld.player().position) >= QuesterConsts.MAX_DIALOG_DISTANCE:
            self.hide()
            return

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)

    def can_tick(self):
        return Utils.is_visible_in_hierarchy(self.component)

    def is_item_locked(self, item_id):
        return self._model.has_item(item_id)

    @property
    def visible(self):
        return self.component.visible