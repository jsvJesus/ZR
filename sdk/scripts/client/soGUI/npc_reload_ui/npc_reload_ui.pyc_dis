        self._bullet_price = None
        self._npc_id = None
        self._confirm_win = None
        self._model = Model()
        self._model.add_listener(self._on_model_event)
        self._bullet_view = BulletView(self._model)
        self._bullet_view.component.position = (0, 66, 0.5)
        self.component.addChild(self._bullet_view.component)
        mag_view = MagView(self._model)
        mag_view.component.position = (0, 188, 0.5)
