        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.visible = False
        self.component.addChild(comp, 'loadpane')
        Interceptor(comp)
        pos_x = left_margin
        block_size = (self.component.width - left_margin * 2.0) / CS.get_max_level()
        self._blocks = []
        for i in range(CS.get_max_level()):
            comp = GUI.Window()
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.ha, comp.va = ('LEFT', 'TOP')
            comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
            comp.width, comp.height = block_size, 320
            comp.position = (pos_x, 64, 0.5)
            block = Block(comp, i + 1)
            block.add_listener(self._on_block_event)
            self.component.addChild(block.component)
            self._blocks.append(block)
            if i > 0:
                comp = GUI.Window('soGUI/frame/paint/white.dds')
                comp.wm, comp.hm = ('PIXEL', 'PIXEL')
                comp.width, comp.height = (2, 324)
                comp.ha, comp.va = ('CENTER', 'TOP')
                comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
                comp.materialFX = 'SOLID'
