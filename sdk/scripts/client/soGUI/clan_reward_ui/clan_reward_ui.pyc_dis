class BlockEventType:
    OnRewardRequested, = ((r, 'RewardBlock') for r in range(1))


class ImageButtonEventType:
    OnMouseEnter, OnMouseLeft = ((r, 'RewardImageButton') for r in range(2))


class ImageButton(Interceptor, Listenable):

    def __init__(self, component, item_type):
        Listenable.__init__(self)
        Interceptor.__init__(self, component)
        self._item_type = item_type

    def set_hovered(self, hovered):
        if hovered:
            self.component.textureName = 'soGUI/frame/stuff/backhover.dds'
        else:
            self.component.textureName = ''
            self.component.texture = None
        return

    def handleMouseClickEvent(self, component):
        item = ItemsUtils.CreateFakeItem(self._item_type)
        BWPersonality.GUICore.showItemInfo(item, is_in_inventory=False)
        return True

    def handleMouseEnterEvent(self, comp):
        self.notify_listeners(ImageButtonEventType.OnMouseEnter)
        return False

    def handleMouseLeaveEvent(self, comp):
        self.notify_listeners(ImageButtonEventType.OnMouseLeft)
        return False


