                comp.position = (pos_x, 88, 0.2)
                self.component.addChild(comp)
            pos_x += block_size

        comp = GUI.Simple('soGUI/maps/loadingScreen/loadingCircle/loadingCircle.texanim')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.materialFX = 'BLEND'
        comp.width, comp.height = (20, 20)
        comp.position = (5, 5, 0.01)
        self.component.loadpane.addChild(comp)
        return

    def show(self):
        if not self.component.visible:
            self.component.visible = True
            self._on_show()

    def _on_block_event(self, event_type, data):
        if event_type == BlockEventType.OnRewardRequested:
            level = data['level']
            self.component.loadpane.visible = True
            p = BigWorld.player()
            p.request_clan_rate_reward(level)
            p.get_available_rewards_count()
        elif event_type == ImageButtonEventType.OnMouseEnter:
            self.hovered_block = data['block']
        elif event_type == ImageButtonEventType.OnMouseLeft:
            if self.hovered_block == data['block']:
                self.hovered_block = None
        return

    @property
    def hovered_block(self):
        return self._hovered_block

    @hovered_block.setter
    def hovered_block(self, value):
        if self.hovered_block:
            self.hovered_block.set_hovered(False)
        self._hovered_block = value
        if self.hovered_block:
            self.hovered_block.set_hovered(True)

    def _clear_data(self):
        self._exp_line.clear_data()
        for block in self._blocks:
            block.clear_data()

    def _set_data(self, clan_level, clanpoints, counts):
        self._exp_line.set_data(clan_level, clanpoints)
        self.component.txtlevel.text = cc.inactive_hex + lc('clan_win.RewardWin.Level') + ' ' + cc.active_hex + unicode(clan_level)
        points = BigWorld.player().clanRoster['members'][BigWorld.player().name][2]
        taken = 0
        for block, count in zip(self._blocks, counts):
            taken += block.set_data(count, points, clan_level)

        remain = Constants.CLAN_REWARD_COUNT - taken
        if remain <= 0:
            for block in self._blocks:
                block.set_disabled()

        self.component.txtlimit.text = cc.inactive_hex + lc('clan_win.RewardWin.Limit') + ' ' + cc.active_hex + '{0}/{1}'.format(remain, Constants.CLAN_REWARD_COUNT)

    def _on_show(self):
        self._clear_data()
        BWPersonality.GUICore.setBestCursor()
        p = BigWorld.player()
        if not p.clanID:
            return
        self.component.loadpane.visible = True
        p.send_available_clan_reward = self._on_got_reward_count
        p.get_available_rewards_count()

    def _on_got_reward_count(self, counts):
        self.component.loadpane.visible = False
        p = BigWorld.player()
        self._set_data(p.clan_level, p.clanpoints, counts)

    def hide(self):
        if self.component.visible:
            self.component.visible = False
            self._on_hide()

    def _on_hide(self):
        BigWorld.player().send_available_clan_reward = lambda *args: None
        BWPersonality.GUICore.setBestCursor()

    @property
    def visible(self):
        return self.component.visible