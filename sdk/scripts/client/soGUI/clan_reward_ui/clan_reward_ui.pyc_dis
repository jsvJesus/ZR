        self.component.addChild(comp, 'needed')
        pos_y += comp.height + 32
        comp = GUI.Window('')
        btn = soButton(comp)
        comp.vpm, comp.hpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.width, comp.height = self.component.width - 8, 29
        comp.position = (4, pos_y, 0.4)
        comp.label.text = lc('clan_win.RewardWin.TakeReward')
        btn.initVSC('soGUI/elements/button_1.xml')
        btn.onBound()
        btn.onClick = self._on_reward_click
        self.component.addChild(comp)
        self._btn = btn

    def set_hovered(self, hovered):
        self._ibtn.set_hovered(hovered)

    def _on_imgbtn_event(self, event_type, data):
        data = {'block': self}
        self.notify_listeners(event_type, data)

    def clear_data(self):
        self._btn.setDisabledState(True)

    def _on_reward_click(self):
        data = {'level': self._level}
        self.notify_listeners(BlockEventType.OnRewardRequested, data)

    def set_disabled(self):
        self._btn.setDisabledState(True)

    def set_data(self, count, points, clan_level):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xba\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbd\xd0\xb0\xd0\xb3\xd1\x80\xd0\xb0\xd0\xb4 \xd0\xb2\xd0\xb7\xd1\x8f\xd1\x82\xd0\xbe """
        config_data = CS.get_clan_reward_data()[self._level]
        self.component.available.text = u'{0}{1} {2}{3}/{4}'.format(cc.inactive_hex, lc('clan_win.RewardWin.Available'), cc.active_hex, count, config_data['count'])
        cost = CS.get_clan_reward_data()[self._level]['cost']
        self.component.needed.text = '{0}/{1}'.format(points, cost)
        self.component.image.textureName = config_data['image']
        if clan_level >= self._level:
            self.component.image.colour = (255, 255, 255, 255)
        else:
            self.component.image.colour = (255, 255, 255, 100)
        enabled = count > 0 and points >= cost and clan_level >= self._level
        self._btn.setDisabledState(not enabled)
        return config_data['count'] - count


