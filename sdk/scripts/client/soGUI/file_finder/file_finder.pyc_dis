# Embedded file name: ./client/soGUI/file_finder/file_finder.py
import colorCodes as cc
import GUI
from Helpers.PyGUI.PyGUIBase import Interceptor
from file_win import FileWin, EventType as FWEventType

class WhiteStyle:
    background = (255, 250, 230, 255)
    base = (37, 41, 43, 255)
    image = base
    basescroll = base[:3] + (125,)
    basehover = base[:3] + (50,)
    baseselect = base[:3] + (100,)
    imagehex = cc.rgba_to_hex(image)


class BlackStyle:
    background = (0, 0, 0, 255)
    base = (37, 41, 43, 255)
    image = (220, 220, 220, 255)
    basescroll = base[:3] + (125,)
    basehover = (70, 70, 70, 255)
    baseselect = (130, 130, 130, 255)
    imagehex = cc.rgba_to_hex(image)


class InvalidPath:
    pass


class FileFinder(Interceptor):

    def __init__(self):
        self._adapt_size = None
        self._callback = None
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (255, 255, 255, 100)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0)
        comp.visible = False
        Interceptor.__init__(self, comp, interscept_keys=False)
        self._file_win = FileWin()
        self._file_win.add_listener(self._on_fwin_event)
        self.component.addChild(self._file_win.component)
        return

    @property
    def visible(self):
        return self.component.visible

    def _check_size(self):
        parent = self.component.parent
        if not parent:
            return
        prev_mode = (parent.wm, parent.hm)
        parent.wm, parent.hm = ('PIXEL', 'PIXEL')
        pw, ph = parent.width, parent.height
        parent.wm, parent.hm = prev_mode
        if self._adapt_size == (pw, ph):
            return
        self._adapt_size = (pw, ph)
        self._do_reposition()

    def show(self, parent_layer, callback, style = WhiteStyle, depth = 0):
        self.component.position[2] = depth
        if not parent_layer.hasChild(self.component, False):
            if self.component.parent:
                self.component.parent.delChild(self.component)
            parent_layer.addChild(self.component)
        self.component.visible = True
        self._callback = callback
        self._check_size()
        self._on_show(style)

    def _on_show(self, style):
        self._file_win.on_show(style)

    def _on_fwin_event(self, event_type, data):
        if event_type == FWEventType.OnCloseRequested:
            self.hide()
        elif event_type == FWEventType.OnPathRequested:
            if self._callback:
                self._callback(data['path'])
        elif event_type == FWEventType.OnPathInvalid:
            if self._callback:
                self._callback(InvalidPath)

    def hide(self):
        if self.component.visible:
            self.component.visible = False
            self._on_hide()

    def _on_hide(self):
        self._callback = None
        self._file_win.on_hide()
        return

    def _do_reposition(self):
        comp = self.component
        comp.width, comp.height = self._adapt_size
        self._file_win.do_reposition()

    def on_new_device(self):
        self._check_size()