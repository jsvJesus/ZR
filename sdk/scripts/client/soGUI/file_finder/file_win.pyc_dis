        self._disclamer = txt

    def _set_path(self, path):
        self._view.set_path(path)
        self.component.path.text = unicode(path or u'')

    def _open_file(self, path):
        data = {'path': path}
        self.notify_listeners(EventType.OnPathRequested, data)

    def _on_back_click(self):
        path = self._backbtn.pop()
        self._set_path(path)

    def _on_view_event(self, event_type, data):
        if event_type == ViewET.OnPathRequested:
            path = data['path']
            self._backbtn.push(path)
            self._set_path(path)
        elif event_type == ViewET.OnFileRequested:
            path = data['path']
            self._open_file(path)
        elif event_type in (ViewET.OnSelectionChanged, ViewET.OnLoadChanged):
            self._update_openbtn()
        elif event_type == ViewET.OnPathInvalid:
            path = self._backbtn.pop()
            self.component.path.text = unicode(path or u'')
            self.notify_listeners(EventType.OnPathInvalid)

    def _on_close_click(self):
        self.notify_listeners(EventType.OnCloseRequested)

    def _on_open_click(self):
        element = self._view.selected_element()
        if not element:
            return
        if element.type in (ElementType.Disc, ElementType.Folder):
            self._backbtn.push(element.path)
            self._set_path(element.path)
        else:
            self._open_file(element.path)

    def _update_openbtn(self):
        enabled = bool(self._view.selected_element() and not self._view.loading)
        self._open_btn.set_enabled(enabled)

    def on_show(self, style):
        self.component.colour = style.background
        self.component.wbox.edge.colour = style.base
        self.component.path.colour = style.image
        self.component.dbox.colour = style.base
        self.component.wbox.fbox.formats.script.set_color(style.imagehex)
        self._view.on_show(style)
        self._set_path(self._backbtn.peek())
        self._update_openbtn()

    def on_hide(self):
        pass

    def do_reposition(self):
        ratio = 0.78
        comp = self.component
        comp.height = comp.parent.height * 0.77
        comp.width = comp.height * ratio
        self.component.dbox.height = self.component.height
        self._disclamer.transform.apply_mode()
        comp = self.component.dbox
        comp.height = self._disclamer.wrapped_height
        comp = self.component.wbox
        comp.height = self.component.height - self._disclamer.wrapped_height
        for r in self._repositions:
            r.transform.apply_mode()

        self.component.wbox.fbox.height = self.component.wbox.height
        fbox = self.component.wbox.fbox
        txt = fbox.formats.script
        txt.transform.apply_mode()
        fbox.height = txt.wrapped_height
        fbox.position[1] = self.component.wbox.btnopen.position[1]
        comp = self._view.component
        comp.position = (0, 48, 0.9)
        comp.height = fbox.position[1] - fbox.height - comp.position[1]
        self._view.do_reposition()
        comp = self._backbtn.component
        comp.position[1] = self._view.component.position[1] * 0.5
        comp.height = 30
        bbtn_comp = self._backbtn.component
        comp = self.component.path
        comp.position[1] = bbtn_comp.position[1]
        comp.position[0] = bbtn_comp.position[0] + bbtn_comp.width + 8