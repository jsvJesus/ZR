from soGUI.equip_paint.eqp_button import EqpButton

class BackBtn(EqpButton):

    def __init__(self, component):
        EqpButton.__init__(self, component)
        self._history_stack = []
        comp = self.component.txt
        self.component.width = comp.stringDimensions(comp.text)[0] + 16
        self._update_visible()

    def _create_content(self):
        text = u'<< ' + lc('PaintScreen.browser.RETURN')
        comp = GUI.Text(text, 'RobotoCondensedRegular_18.font')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'txt')

    def update_visual(self, hovered, pressed):
        comp = self.component.txt
        if pressed:
            comp.colour = (150, 0, 0, 255)
        elif hovered:
            comp.colour = (150, 0, 0, 150)
        else:
            comp.colour = (150, 0, 0, 255)

    def push(self, path):
        self._history_stack.append(path)
        self._update_visible()

    def peek(self):
        return self._history_stack and self._history_stack[-1] or None

    def pop(self):
        if self._history_stack:
            self._history_stack.pop()
            self._update_visible()
            if self._history_stack:
                return self._history_stack[-1]
        return None

    def _update_visible(self):
        if self.component.visible == bool(self._history_stack):
            return
        if self._history_stack:
            self.component.visible = True
            self._update_visual()
        else:
            self.component.visible = False


class EventType:
    OnCloseRequested, OnPathRequested, OnPathInvalid = ((r, 'FileWin') for r in range(3))


