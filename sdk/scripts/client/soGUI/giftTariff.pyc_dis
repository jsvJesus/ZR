    def _updateCaprion(self, data):
        if data.get('return_gift'):
            name = data['return_gift']['toAvatar']
            caption = lc('GUI.itemCache.CAPTION_TRANSFER_PRICES_RETURN')
            caption = caption.format(name=name)
            self.component.iLabel.text = caption
        else:
            self.component.iLabel.text = lc('GUI.itemCache.CAPTION_TRANSFER_PRICES')

    def show(self, data, parent, callback_on_send = None):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.visible = True
        self.callback_on_send = callback_on_send
        try:
            self._updateCaprion(data)
        except:
            traceback.print_exc()

        self.sendData = data
        self._parent = parent
        for tariff_id, elem in self._tariff_elem.items():
            elem.updateCost(self.sendData)

        init_tariff = TRANSFER_TYPE_BASE
        if BigWorld.player().isPremium():
            init_tariff = TRANSFER_TYPE_GOLD
        self.choiseTariff(init_tariff)
        return

    def hide(self):
        self.component.visible = False

    def choiseTariff(self, choice_tariff_id):
        if choice_tariff_id == TRANSFER_TYPE_GOLD and not BigWorld.player().isPremium():

            def callback(event):
                if event == gui_jokes.askUserYesNo.YES:
                    BWPersonality.GUICore.storehouse_screen.show_shop()
                    BWPersonality.GUICore.storehouse_screen.set_premium_filter()

            gui_jokes.askUserYesNo(lc('GUI.giftwindow.TITLE_NEED_PREMIUM'), lc('GUI.giftwindow.TEXT_NEED_PREMIUM'), callback=callback, large=False)
            return
        self._selected_index_tariff = choice_tariff_id
        for tariff_id, elem in self._tariff_elem.items():
            if tariff_id == choice_tariff_id:
                elem.select()
            else:
                elem.deselect()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseLeaveEvent(self, cmp):
        return True

    def handleMouseEnterEvent(self, cmp):
        return True

    def handleMouseEvent(self, cmp, event):
        return True

    def handleDragStartEvent(self, cmp):
        return True

    def handleDragStopEvent(self, cmp):
        return True

    def handleDragEnterEvent(self, cmp, dragged):
        return True

    def handleDragLeaveEvent(self, cmp, dragged):
        return True

    def handleDropEvent(self, cmp, dropped):
        return True

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('button_cancel', 'onClick')
    def cancel(self):
        self.hide()

    def send(self):
        if not self.sendData:
            return
        total_cost_value = self._tariff_elem[self._selected_index_tariff].total_cost_value
        player = BigWorld.player()
        needed_money = total_cost_value
        if not self.sendData.get('return_gift'):
            needed_money += self.sendData['money']
        if player.CreditNumber < needed_money:
            gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_ERROR'), lc('Codes.GiftResponses.ERROR_SEND_CREDIT'))
            return
        if self._selected_index_tariff == TRANSFER_TYPE_GOLD and not player.isPremium():
            gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_ERROR'), lc('Codes.GiftResponses.ERROR_PREMIUM'))
            return
        if self.sendData.get('return_gift'):
            giftID = self.sendData['return_gift']['giftID']
            BigWorld.player().base.returnGiftUser(giftID, self._selected_index_tariff)
        else:
            to_avatar = self.sendData['to_avatar']
            from_bank = self.sendData['from_bank']
            to_bank = self.sendData['to_bank']
            comment = self.sendData['comment']
            lstIitemID = [ item['complexItemID'] for item in self.sendData['items'] ]
            money = self.sendData['money']
            comment = comment.encode('utf8')
            BigWorld.player().cell.sendGift(to_avatar, from_bank, to_bank, lstIitemID, money, total_cost_value, comment, self._selected_index_tariff)
        self.hide()
        self._parent.wait()
        if self.callback_on_send:
            self.callback_on_send()