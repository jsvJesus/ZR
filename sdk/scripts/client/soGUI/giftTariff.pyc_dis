        cmp.height = 2
        cmp.width = 2
        cmp.position = (0, 0, 0.84)
        cmp.visible = False
        self.component.addChild(cmp, 'bg')
        btn = soButton(GUI.Window())
        cmp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.label.font = 'RobotoCondensedRegular_16.font'
        cmp.label.text = caption
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.component.width - 4
        cmp.height = 26
        cmp.position = (half_width, 5, 0.1)
        self.component.addChild(cmp, 'button_tariff')
        btn.onBound()
        btn.onClick = lambda : parent.choiseTariff(tariff_id)
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = time_color
        cmp.materialFX = 'BLEND'
        cmp.position = (half_width, 52, 0.2)
        cmp.text = '???'
        self.component.addChild(cmp, 'label_tariff_time')
        self.basel_cost = SimpeTextMoney(GUI.Text(), font='RobotoCondensedRegular_16.font')
        cmp = self.basel_cost.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (half_width, 75, 0.2)
        self.component.addChild(cmp, 'base_cost')
        self.basel_cost.onBound()
        self.basel_cost.setValue(0)
        self.tax_cost = SimpeTextMoney(GUI.Text(), font='RobotoCondensedRegular_16.font')
        cmp = self.tax_cost.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (half_width, 96, 0.2)
        self.component.addChild(cmp, 'tax_cost')
        self.tax_cost.onBound()
        self.tax_cost.setValue(0)
        self.total_cost = SimpeTextMoney(GUI.Text(), font='RobotoCondensedRegular_16.font')
        cmp = self.total_cost.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (half_width, 182, 0.2)
        self.component.addChild(cmp, 'total_cost')
        self.total_cost.onBound()
        self.total_cost.setValue(0)

    def updateCost(self, data):
        base_cost = GiftBankUtils.getBaseCost(self.tariff_id, data['from_bank'], data['to_bank'])
        self.basel_cost.setValue(base_cost)
        tax = GiftBankUtils.getAllTax(self.tariff_id, data['money'], data['items'], data['from_bank'], data['to_bank'])
        self.tax_cost.setValue(tax)
        self.total_cost_value = GiftBankUtils.getFullCost(self.tariff_id, data['money'], data['items'], data['from_bank'], data['to_bank'])
        self.total_cost.setValue(self.total_cost_value)
        time_transf = GiftBankUtils.getTimeTransfer(self.tariff_id, data['from_bank'], data['to_bank'])
        self.component.label_tariff_time.text = ItemsUtils.timeToString(time_transf)

    def select(self):
        self.component.bg.visible = True
        self.total_cost.component.visible = True

    def deselect(self):
        self.component.bg.visible = False
        self.total_cost.component.visible = False


