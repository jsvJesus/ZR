 BoxStatus.COMPLETE: 'soGUI/maps/Icons/misc/icon_box_done.dds'}

class BoxElement(PyGUIBase):

    def __init__(self, component, status):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.status = status
        self.setupRoot()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
