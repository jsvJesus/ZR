        cmp.colour = (255, 255, 255, 255)
        cmp.position = (0.0, 0.0, 1)
        cmp.materialFX = 'BLEND'
        self.width = cmp.width = 40
        self.height = cmp.height = 40
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode, cmp.verticalPositionMode = ('CLIP', 'CLIP')
        cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'CENTER')
        cmp.widthMode, cmp.heightMode = ('CLIP', 'CLIP')
        cmp.width, cmp.height = (2, 2)
