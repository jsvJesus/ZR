    def set_value(self, val_name, val):
        cmp = getattr(self.component.frame.wnd, val_name + '_edit', None)
        if val_name == 'emblem':
            cmp = self.component.frame.emblem_edit
            self.loadClanIcon(cmp, val)
            return
        else:
            class_name = cmp.__class__.__name__
            if class_name == 'Text':
                try:
                    cmp.text = u'{0}'.format(val)
                except Exception as e:
                    print val_name, repr(val)
                    raise e

            elif class_name == 'Simple':
                cmp.texture = val
            if val_name in ('motto', 'message'):
                text = u'{0}'.format(val)
                cmp.script.setValue(val)
                cmp = getattr(self.component.frame.wnd, val_name + '_label', None)
                if val_name == 'message':
                    cmp.script.setText(u'<font=RobotoCondensedRegular_16.font><alignment=center>' + text)
                else:
                    cmp.text = text
            return

    def set_data_info(self, data):
        for tag in data:
            self.set_value(tag, data[tag])

        self.update_XP_bar(data['level'], data['clanpoints'])

    def update_XP_bar(self, level, clan_points):
        money, cp, players_count = ClanSettings.get_upgrade_cost(level)
        self.component.frame.wnd.xb_bar.width = min(1, clan_points / float(cp)) * 661
        self.component.frame.wnd.xb_bar_text.text = '{0}/{1}'.format(int(clan_points), int(cp))
        self.component.frame.wnd.from_next_level_end.visible = 1
        self.component.frame.wnd.from_next_level_label.visible = 1
        self.component.frame.wnd.from_next_level_edit.visible = 1
        self.component.frame.wnd.level_up_btn.script.toolTipID = level
        if level >= ClanSettings.get_max_level():
            self.component.frame.wnd.from_next_level_end.visible = 0
            self.component.frame.wnd.from_next_level_label.visible = 0
            self.component.frame.wnd.from_next_level_edit.visible = 0
        else:
            self.component.frame.wnd.from_next_level_end.text = str(level + 1)
            txt = self.component.frame.wnd.from_next_level_end
            w, h = txt.stringDimensions(txt.text)
            self.component.frame.wnd.from_next_level_label.position.x = txt.position.x - w - 2
            txt = self.component.frame.wnd.from_next_level_label
            w, h = txt.stringDimensions(txt.text)
            self.component.frame.wnd.from_next_level_edit.position.x = txt.position.x - w - 2
            self.component.frame.wnd.from_next_level_edit.text = str(max(0, cp - clan_points))

    def set_bases(self, clan_bases):
        self.clan_bases = clan_bases
        self.update_bases()

    def set_donat_bases(self, clan_bases):
        self.clan_donat_bases = clan_bases
        self.update_bases()

    def update_locks(self):
        if self.component.frame.wnd.motto_edit:
            self.component.frame.wnd.motto_btn.visible = bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_CHANGE_MOTD))
        if self.component.frame.wnd.message_edit:
            self.component.frame.wnd.message_btn.visible = bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_CHANGE_CLANMSG))
        if self.component.frame.wnd.load_icon_btn:
            self.component.frame.wnd.load_icon_btn.visible = bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_CHANGE_ICON))
        if self.component.frame.wnd.level_up_btn:
            vis = BigWorld.player().clan_level != ClanSettings.get_max_level()
            self.component.frame.wnd.level_up_btn.visible = vis and bool(BigWorld.player().checkClanRights(Clan.FLAG_CLAN_OWNER))

    def update_bases(self):
        for index, comps in enumerate(self.list_bases):
            self.component.frame.wnd.delChild('base_name%s' % index)
            self.component.frame.wnd.delChild('base_time%s' % index)

        self.list_bases = []

        def get_text_cmp():
            cmp = GUI.Text('')
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalPositionMode = 'PIXEL'
            cmp.font = 'RobotoCondensedRegular_16.font'
            cmp.visible = True
            return cmp

        i = 0
        y = 288
        for base in self.clan_bases:
            name = lc('BaseToCaptureNames.%s' % base['base_name'])
            name = name.replace('\n', ' ').replace('\r', '')
            comp_name = get_text_cmp()
            comp_name.position = (8, y + i * 20, 0)
            comp_name.colour = (175, 166, 112, 255)
            comp_name.text = name
            w, h = comp_name.stringDimensions(name)
            comp_time = get_text_cmp()
            comp_time.position = (10 + w, y + i * 20, 0)
            comp_time.colour = (220, 220, 220, 255)
            comp_time.text = ''
            self.component.frame.wnd.addChild(comp_name, 'base_name%s' % i)
            self.component.frame.wnd.addChild(comp_time, 'base_time%s' % i)
            self.list_bases.append((comp_name, comp_time))
            i += 1

        for base in self.clan_donat_bases:
            name = lc('DonateBases.name.%s' % base['base_name'])
            comp_name = get_text_cmp()
            comp_name.position = (8, y + i * 20, 0)
            comp_name.colour = (175, 166, 112, 255)
            comp_name.text = name
            w, h = comp_name.stringDimensions(name)
            comp_time = get_text_cmp()
            comp_time.position = (10 + w, y + i * 20, 0)
            comp_time.colour = (220, 220, 220, 255)
            comp_time.text = ''
            self.component.frame.wnd.addChild(comp_name, 'base_name%s' % i)
            self.component.frame.wnd.addChild(comp_time, 'base_time%s' % i)
            self.list_bases.append((comp_name, comp_time))
            i += 1

        if self.component.visible:
            self.bases_time_tick()
        self.update_tax()
        self.component.frame.wnd.height = 267 + (3 + i) * 20
        self.scrollStep = 10
        scrollStepCount = (self.component.frame.wnd.height - 380) / float(self.scrollStep)
        if scrollStepCount > 0:
            self.scroll.setSteps(math.ceil(scrollStepCount))
        else:
            self.scroll.setSteps(0)
            self.component.frame.wnd.position.y = 0

    def update_tax(self):
        i = len(self.list_bases)
        self.component.frame.wnd.no_bases_text.visible = not i
        cost = ClanSettings.get_mounthly_cost(BigWorld.player().clan_level)
        self.component.monthly_tax.text = lc('GUI.ClanInfo.tax').format(self.get_next_mounhly_tax_time(), cost)

    def bases_time_tick(self):
        for i, base in enumerate(self.clan_bases):
            comp_name, comp_time = self.list_bases[i]
            next_time = ItemsUtils.timeToString(base['under_atack_time'])
            comp_time.text = next_time
            base['under_atack_time'] = max(base['under_atack_time'] - 1, 0)

        for i, base in enumerate(self.clan_donat_bases):
            index = i + len(self.clan_bases)
            comp_name, comp_time = self.list_bases[index]
            next_time = ItemsUtils.timeToString(base['have_time'])
            comp_time.text = next_time
            base['have_time'] = max(base['have_time'] - 1, 0)

        if self.component.visible:
            self.callback_id = BigWorld.callback(1, self.bases_time_tick)

    def _drawIcon(self, component, imgID, feedName = '', texture = None):
        if imgID and texture:
            component.visible = True
            component.texture = texture
        else:
            component.visible = False
            component.texture = None
        return

    def loadClanIcon(self, component, iconID):
        pl = BigWorld.player()
        if pl:
            if iconID != 0:
                UCManager.ucmanager.loadImg(iconID, partial(self._drawIcon, component))
            else:
                self._drawIcon(component, 0)

    def hide(self):
        self.component.visible = False
        if self.callback_id:
            BigWorld.cancelCallback(self.callback_id)
            self.callback_id = 0
        self.clan_bases = []
        self.clan_donat_bases = []
        self.update_bases()

    def show(self):
        self.component.visible = True
        self.update_tax()

    def on_change_motto(self, by_user):
        pass

    def on_change_message(self, by_user):
        pass

    def on_save_motto(self):
        if not self.component.frame.wnd.motto_edit.visible:
            self.component.frame.wnd.motto_edit.visible = True
            self.component.frame.wnd.motto_label.visible = False
            return
        self.component.frame.wnd.motto_label.visible = True
        self.component.frame.wnd.motto_edit.visible = False
        self.component.frame.wnd.motto_edit.script.activate(False)
        text = self.component.frame.wnd.motto_edit.script.getRaw()
        BigWorld.player().clan_motto_change(text.encode('utf8'))

    def on_save_message(self):
        if not self.component.frame.wnd.message_edit.visible:
            self.component.frame.wnd.message_edit.visible = True
            self.component.frame.wnd.message_label.visible = False
            return
        self.component.frame.wnd.message_label.visible = True
        self.component.frame.wnd.message_edit.visible = False
        self.component.frame.wnd.message_edit.script.activate(False)
        text = self.component.frame.wnd.message_edit.script.getRaw()
        BigWorld.player().clan_message_change(text.encode('utf8'))

    def on_open_emblem_window(self):
        BWPersonality.GUICore.showClanEmblemsScreen(True)

    def on_level_up_click(self):
        BigWorld.player().clan_level_up()

    def _set_scroll_value(self, value):
        value = clamp(value, 0, self.scroll.steps)
        if self.scroll.getValue() == value:
            return
        self.scroll.setValue(value)
        self._scroll_changed()

    def _scroll_changed(self):
        pos_y = -self.scroll.getValue() * self.scrollStep
        self.component.frame.wnd.position.y = min(pos_y, 0)

    def handleMouseEnterEvent(self, comp):
        self.wheelFocus = True
        return True

    def handleMouseLeaveEvent(self, comp):
        self.wheelFocus = False
        return True

    def handleMouseEvent(self, component, event):
        dz = event.dz
        if dz > 0:
            self.scrollUp()
            return True
        if dz < 0:
            self.scrollDown()
            return True
        return False

    def handleMouseButtonEvent(self, comp, event):
        return True

    def scrollUp(self):
        self._set_scroll_value(self.scroll.getValue() - 1)

    def scrollDown(self):
        self._set_scroll_value(self.scroll.getValue() + 1)

    def scrollMoved(self, value):
        self._set_scroll_value(value)

    def get_next_mounhly_tax_time(self):
        from datetime import date, timedelta
        from calendar import monthrange
        import time
        import ItemsUtils
        days_in_month = lambda dt: monthrange(dt.year, dt.month)[1]
        today = date.today()
        first_day = today.replace(day=1) + timedelta(days_in_month(today))
        time_end = time.mktime(time.strptime(first_day.isoformat() + ' 7:00', '%Y-%m-%d %H:%M')) - BWPersonality.gpd.time_diff
        return ItemsUtils.timeToString(time_end - time.time() - BWPersonality.gpd.time_diff)