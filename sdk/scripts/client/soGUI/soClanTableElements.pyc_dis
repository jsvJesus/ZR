# Embedded file name: ./client/soGUI/soClanTableElements.py
import GUI
import Keys
import soGUI
from soGUI.soCheckBox import soCheckBox
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from soGUI.soDropDownList import soDropDownList2

class TableItemElement(PyGUIBase):

    def __init__(self, component, row_parent, width, height, row_index, col_index, props):
        component.script = self
        PyGUIBase.__init__(self, component)
        self.row_parent = row_parent
        self.props = props
        self.row_index = row_index
        self.col_index = col_index
        self.selected = False
        self.mouseHover = False
        self.disabled = False
        self.background = None
        self.width = width
        self.height = height
        self.setupRoot()
        self.setupContent()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = 'PIXEL'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.materialFX = 'BLEND'
        cmp.width = self.width
        cmp.height = self.height
        cmp.colour = (255, 255, 255, 255)
        cmp.position = (0, 0, 0)
        cmp.mouseButtonFocus = True

    def setupContent(self):
        cmp = GUI.Simple('soGUI/white.dds')
        color = (0, 0, 0, 0)
        if self.props.dataStyles.has_key('color'):
            color = self.props.dataStyles['color']
        cmp.colour = color
        cmp.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.width = cmp.height = 2
        cmp.position = (0, 0, 0.5)
        self.component.addChild(cmp, 'background')

    def handleMouseButtonEvent(self, comp, event):
        down = event.isKeyDown()
        key = event.key
        modifiers = event.modifiers
        if down:
            if key == Keys.KEY_LEFTMOUSE:
                self.row_parent.elementEvent(self.row_index, self.col_index, 'LEFTMOUSE', None)
            elif key == Keys.KEY_RIGHTMOUSE:
                self.row_parent.elementEvent(self.row_index, self.col_index, 'RIGHTMOUSE', None)
        return True

    def handleMouseEnterEvent(self, component):
        return False

    def handleMouseLeaveEvent(self, component):
        return False

    def updateVisual(self):
        color = (0, 0, 0, 0)
        if self.selected or self.mouseHover:
            if self.props.dataStyles.has_key('selectColor'):
                color = self.props.dataStyles['selectColor']
            self.component.background.colour = color
            return
        if self.props.dataStyles.has_key('color'):
            color = self.props.dataStyles['color']
        self.component.background.colour = color

    def setValue(self, data):
        pass

    def setProps(self, props):
        self.props = props
        self.updateVisual()

    def setSelected(self, value):
        if self.selected == value:
            return
        self.selected = value
        self.updateVisual()

    def select(self):
        self.selected = True
        self.updateVisual()

    def deselect(self):
        self.selected = False
        self.updateVisual()

    def hover(self, mouseIn = True):
        self.mouseHover = mouseIn
        self.updateVisual()


class TableLabel(TableItemElement):

    def __init__(self, component, row_parent, width, height, row_index, col_index, props, align = 'CENTER'):
        self.align = align
        self.__content_color = None
        TableItemElement.__init__(self, component, row_parent, width, height, row_index, col_index, props)
        return

    def setupContent(self):
        cmp = GUI.Text('')
        cmp.font = self.props.dataStyles['font']
        color = (255, 255, 255, 255)
        if self.props.dataStyles.has_key('contentColor'):
            color = self.props.dataStyles['contentColor']
        cmp.colour = color
        cmp.multiline = False
        cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalPositionMode = 'CLIP'
        cmp.horizontalAnchor = self.align
        cmp.verticalAnchor = 'CENTER'
        cmp.position = (0, 0, 0.1)
        cmp.materialFX = 'BLEND'
        self.component.addChild(cmp, 'label')
        TableItemElement.setupContent(self)
        self.updateVisual()

    def updateVisual(self):
        TableItemElement.updateVisual(self)
        color = (0, 0, 0, 0)
        if self.props.dataStyles.has_key('contentColor'):
            color = self.props.dataStyles['contentColor']
        if self.selected and self.props.dataStyles.has_key('contentColorSelect'):
            color = self.props.dataStyles['contentColorSelect']
        elif self.mouseHover and self.props.dataStyles.has_key('contentColorHover'):
            color = self.props.dataStyles['contentColorHover']
        if self.__content_color:
            color = self.__content_color
        self.component.label.colour = color
        self.component.label.horizontalPositionMode = 'PIXEL'
        try:
            self.align = self.props.align[self.col_index]
        except Exception as e:
            print self.component.label.text, self.col_index, self.props.align
            raise e

        if self.align == 'CENTER':
            self.component.label.horizontalPositionMode = 'CLIP'
        self.component.label.horizontalAnchor = self.align
        self.component.label.position = (0, 0, 0.1)

    def setValue(self, data):
        if isinstance(data, unicode):
            self.component.label.text = data
        elif isinstance(data, dict):
            self.component.label.text = data['text']
        TableItemElement.setValue(self, data)
        self.updateVisual()

    def setColor(self, color):
        self.__content_color = color
        self.updateVisual()

    def get_dimensions(self):
        return self.component.label.stringDimensions(self.component.label.text)


class TableCheckBox(TableItemElement):

    def __init__(self, component, row_parent, width, height, row_index, col_index, props, align = 'LEFT'):
        self.align = align
        TableItemElement.__init__(self, component, row_parent, width, height, row_index, col_index, props)
        self.component.horizontalAnchor = self.align

    def setupContent(self):
        ddl = soCheckBox(GUI.Window(), soGUI.CheckBoxPropsStructure(labelText=u''))
        cmp = ddl.component
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = self.align
        cmp.verticalAnchor = 'CENTER'
        cmp.materialFX = 'BLEND'
        cmp.width = self.width
        cmp.height = self.height
        color = (255, 255, 255, 255)
        if self.props.dataStyles.has_key('contentColor'):
            color = self.props.dataStyles['contentColor']
        ddl.labelColour = color
        if self.align == 'LEFT':
            cmp.position = (-1, 0, 0.1)
        elif self.align == 'CENTER':
            cmp.position = (0, 0, 0.1)
        elif self.align == 'RIGHT':
            cmp.position = (0, 0, 0.1)
        ddl.onChange = self.onCheckElement
        self.component.addChild(cmp, 'checkbox')
        TableItemElement.setupContent(self)
        cmp = GUI.Text('')
        cmp.font = self.props.dataStyles['font']
        color = (255, 255, 255, 255)
        if self.props.dataStyles.has_key('contentColor'):
            color = self.props.dataStyles['contentColor']
        cmp.colour = color
        cmp.multiline = False
        cmp.visible = False
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.position = (0, 0, 0.1)
        cmp.materialFX = 'BLEND'
        self.component.addChild(cmp, 'label')

    def setData(self, data):
        pass

    def set_active(self, value):
        self.component.checkbox.script.set_active(value)

    def setValue(self, value):
        if isinstance(value, (list, tuple)):
            name, checked = value
        else:
            name = value
            checked = False
        self.component.checkbox.visible = True
        self.component.checkbox.script.setLabel(name)
        self.component.checkbox.script.set_active(checked)
        self.component.label.text = name
        TableItemElement.setValue(self, name)

    def setColor(self, color):
        self.__content_color = color
        self.updateVisual()

    def onCheckElement(self, value):
        self.row_parent.elementEvent(self.row_index, self.col_index, 'CHECK', {'value': value})

    def get_dimensions(self):
        return self.component.checkbox.script.label.stringDimensions(self.component.checkbox.script.label.text)


class TableDropDown(TableItemElement):

    def setupContent(self):
        VS = 'soGUI/elements/drop_down_list_clan.xml'
        ddl = soDropDownList2(GUI.Window(), width=self.width, height=self.height, colorFont=(220, 220, 220, 220), VS=VS)
        cmp = ddl.component
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.1)
        ddl.onSelectedElement = self.onSelectedElement
        self.component.addChild(cmp, 'data_list')
        cmp = GUI.Text('')
        cmp.font = self.props.dataStyles['font']
        color = (255, 255, 255, 255)
        if self.props.dataStyles.has_key('contentColor'):
            color = self.props.dataStyles['contentColor']
        cmp.colour = color
        cmp.multiline = False
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.position = (0, 0, 0.1)
        cmp.materialFX = 'BLEND'
        self.component.addChild(cmp, 'label')
        TableItemElement.setupContent(self)

    def setData(self, data):
        self.component.data_list.script.clear()
        self.component.data_list.script.addElements(data)

    def setValue(self, value):
        if isinstance(value, (int, long)):
            self.component.data_list.visible = True
            self.component.label.visible = False
            self.component.data_list.script.setSelectionByValue(value, True)
        elif isinstance(value, (unicode, str)):
            self.component.data_list.visible = False
            self.component.label.visible = True
            self.component.label.text = value
        TableItemElement.setValue(self, value)

    def onSelectedElement(self, value):
        self.row_parent.elementEvent(self.row_index, self.col_index, 'SELECT_LIST', {'value': value})