class TableRowElement(PyGUIBase):

    def __init__(self, component, width, height, position, parentTable, parentRowIndex, props = soTableElemPropsStructure(), ratio = None, cols = 3):
        component.script = self
        PyGUIBase.__init__(self, component)
        self.props = props
        self.width = width
        self.height = height
        self.position = position
        self.columns_count = cols
        self.ratio = ratio
        self.parentTable = parentTable
        self.parentRowIndex = parentRowIndex
        if not self.ratio:
            self.ratio = [ 1.0 / self.columns_count for i in xrange(self.columns_count) ]
        if len(self.ratio) < cols:
            print 'EROR RowItemH', len(self.ratio), cols, self.ratio
            traceback.print_stack()
            return
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = self.width
        cmp.height = self.height
        cmp.materialFX = 'BLEND'
        if self.props.dataStyles.has_key('color'):
            color = self.props.dataStyles['color']
        cmp.colour = color
        cmp.position = self.position
        cmp.pixelSnap = False
        cmp.mouseButtonFocus = True
        cmp.crossFocus = True
        cmp.moveFocus = True

    def setupContent(self):
        cur_pos_x = 0
        if len(self.ratio) != self.columns_count:
            traceback.print_stack()
            return
        for i in xrange(self.columns_count):
            w = min(self.ratio[i] * self.width, self.width - cur_pos_x)
            if isinstance(self.props, (list, tuple)):
                props = self.props[i]
            else:
                props = self.props
            try:
                if self.props.data_types[i] == 'text':
                    item = TableLabel(GUI.Window(), self, w, self.height, self.parentRowIndex, i, props)
                elif self.props.data_types[i] == 'checkbox':
                    item = TableCheckBox(GUI.Window(), self, w, self.height, self.parentRowIndex, i, props)
                elif self.props.data_types[i] == 'l_text':
                    item = TableLabel(GUI.Window(), self, w, self.height, self.parentRowIndex, i, props, align='LEFT')
                elif self.props.data_types[i] == 'list':
                    item = TableDropDown(GUI.Window(), self, w, self.height, self.parentRowIndex, i, props)
                    item.setData(self.props.list_data[i])
            except Exception as e:
                print i, self.columns_count, len(self.props.data_types), self.props.data_types, self.props
                raise e

            cmp = item.component
            if self.props.data_types[i] == 'checkbox':
                cmp.position = (0, self.height / 2, 0.1)
            else:
                cmp.position = (cur_pos_x + w / 2, self.height / 2, 0.1)
            cur_pos_x += self.ratio[i] * self.width
            self.component.addChild(cmp, 'column%s' % i)

    def elementEvent(self, row_index, col_index, event, data):
        if data is None:
            data = {'name': self.getName()}
        else:
            data['name'] = self.getName()
        self.parentTable.elementEvent(row_index, col_index, event, data)
        return

    def delElem(self):
        self.parentTable = None
        return

    def setLabels(self, data):
        for i in xrange(len(data)):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                if isinstance(data[i], dict):
                    col.script.setValue(data[i]['text'])
                    col.script.setColor(data[i].get('color'))
                else:
                    col.script.setValue(data[i])
                    col.script.setColor(None)

        return

    def setProps(self, props):
        self.props = props
        for i in xrange(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.script.setProps(props)

        return

    def setSelected(self, value):
        for i in xrange(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.script.setSelected(value)

        return

    def getName(self, num = 0):
        col = getattr(self.component, 'column%s' % num, None)
        if col:
            return col.label.text
        else:
            return u''

    def clear(self):
        for i in xrange(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.label.text = u''

        return

    def handleMouseEnterEvent(self, component):
        for i in xrange(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.script.hover(True)

        return False

    def handleMouseLeaveEvent(self, component):
        for i in xrange(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.script.hover(False)

        return False


class tablePropsStructure(object):

    def __init__(self, width = 600, visibleRows = 10, hScroll = False, vScroll = True, readOnly = True, rowHeight = 25, colCaptionHeight = 30, selType = 'ROW'):
        self.width = width
        self.visibleRows = visibleRows
        self.hScroll = hScroll
        self.vScroll = vScroll
        self.readOnly = readOnly
        self.rowHeight = rowHeight
        self.colCaptionHeight = colCaptionHeight
        self.selType = selType
        self.offset = 1


class ClanTableComponent(soList_optimized):
    factoryString = 'soGUI.ClanTableComponent'
    STUBROW_HEIGHT = 25

    def __init__(self, component, props = ListPropsStructure(), default_frame_skin = 'soGUI/frame/basic_frame_1.dds', element_props = soTableElemPropsStructure(), ratio = None):
        self.element_props = element_props
        self.ratio = ratio
        soList_optimized.__init__(self, component, props, default_frame_skin)
        self.selectedElems = []
        self.wheelFocus = True
        self.component.focus = True
        self.component.moveFocus = True

    def applyElements(self, needSort = True):
        elemList = self.indexes
        self.fixOffset()
        start = self.offset + 1
        if len(elemList) >= self.visibleCount:
            end = self.offset + self.visibleCount
        else:
            end = len(elemList)
        for elemID, elem in self.elementHolder.children:
            elem.visible = False

        self.elementHolder.children[0][1].script.setProps(elemList[0]['props'])
        self.elementHolder.children[0][1].script.setLabels(elemList[0]['data'])
        self.elementHolder.children[0][1].visible = True
        i = 1
        for elem in xrange(start, end):
            self.elementHolder.children[i][1].script.setProps(elemList[elem]['props'])
            self.elementHolder.children[i][1].script.setLabels(elemList[elem]['data'])
            self.elementHolder.children[i][1].script.setSelected(elem in self.selectedElems)
            self.elementHolder.children[i][1].visible = True
            i += 1

        screenH = BigWorld.screenHeight()
        itemH = self.elementHeight + self.lineOffset

        def setMaxScroll():
            elementsHeight = len(self.elements) * itemH
            holderHeight = elementsHeight
            heightDiff = itemH / screenH * len(self.elements) - holderHeight / screenH
            if heightDiff > 0.0:
                self.elementHolder.maxScroll = (0.0, heightDiff * 2)
            maxScrl = len(self.elements) - self.visibleCount
            if maxScrl > 0:
                self.maxScroll = maxScrl
            else:
                self.maxScroll = 0

        def setMinScroll():
            self.elementHolder.minScroll = (0.0, 0.0)
            self.minScroll = 0

        setMaxScroll()
        setMinScroll()
        self.scrollStep = 2.0 / (screenH / itemH)
        scrollStepCount = (itemH * len(self.elements) - self.elementHolder.height) / float(itemH)
        if scrollStepCount > 0:
            self.vScroll.setSteps(round(scrollStepCount))
        else:
            self.vScroll.setSteps(0)
        self.onElementsRedraw()

    def initElements(self):
        self.clearAllChildren(self.elementHolder)
        self.elemComps = []
        i = 0
        COLS = len(self.ratio)
        elemList = self.indexes
        for elem in xrange(0, self.visibleCount):
            props = self.element_props
            if elem == 0:
                props = soTableCaptionPropsStructure(columns=COLS)
            pos = (-1.0, 1.0 - soGUI.getPixelHeight(self.elementHolder) * self.elementHeight * i, 0.0)
            elemComp = TableRowElement(GUI.Window(), self.elementHolder.width - self.leftOffset, self.elementHeight, pos, self, elem, ratio=self.ratio, cols=COLS, props=props)
            elemComp.component.visible = False
            self.elemComps.append(elemComp)
            self.elementHolder.addChild(elemComp.component, 'element' + str(i))
            if elem == 0:
                i += 1
                continue
            cmp = GUI.Simple('soGUI/elements/divider_grey.dds')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.pixelSnap = False
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'CENTER'
            cmp.tiled = True
            cmp.tileHeight = 1
            cmp.tileWidth = 1
            cmp.width = self.elementHolder.width
            cmp.height = 1
            cmp.position = (0, self.elementHeight * (i + 1) + 3, 0.4)
            cmp.materialFX = 'BLEND'
            cmp.colour = (255, 255, 255, 255)
            self.component.addChild(cmp, 'h_line%s' % i)
            i += 1

        cur_pos_x = -1

    def get_element(self, elementCaption):
        caption = elementCaption
        if isinstance(elementCaption, (tuple, list)):
            caption = elementCaption[0]
        for i in self.elements:
            if isinstance(i, tuple):
                if caption == i[0]:
                    return i
            if i == caption:
                return i

        return None

    def get_key(self, element):
        if isinstance(element['data'][0], (unicode, str)):
            return element['data'][0]
        if isinstance(element['data'][0], (tuple, list)):
            return element['data'][0][0]
        if isinstance(element['data'][0], dict):
            return element['data'][0]['text']

    def addElement(self, element, attachment = None, delayedRender = False):
        text = self.get_key(element)
        try:
            if text in self.elements:
                return False
        except Exception as e:
            print element['data']
            raise e

        self.selectedElems = []
        self.elements[text] = 0
        self.attachments[text] = attachment
        self.indexes.append(element)
        if not delayedRender:
            self.applyElements(False)
        return True

    def removeElement(self, elementCaption):
        element_key = self.get_element(elementCaption)
        if element_key:
            self.selectedElems = []
            del self.elements[element_key]
            del self.attachments[element_key]
            for index, element in enumerate(self.indexes):
                if elementCaption == element['data'][0]:
                    self.indexes.remove(element)

            self.applyElements(False)
            return True
        else:
            return False

    def rewriteCaption(self, new_data):
        for i in xrange(0, len(new_data['data'])):
            self.indexes[0]['data'][i] = new_data['data'][i]

        self.applyElements(False)

    def rewriteRow(self, new_data):
        if not new_data:
            return
        for element in self.indexes:
            if self.get_key(element) == self.get_key(new_data):
                for i in xrange(0, len(new_data['data'])):
                    element['data'][i] = new_data['data'][i]
                    element['props'] = new_data['props']

                break

        self.applyElements()

    def clearRowRange(self, start = 0, end = -1):
        if end < 0:
            end = len(self.indexes) - 1
        i = end
        while i >= start:
            element_key = self.get_key(self.indexes[i])
            if element_key and element_key in self.elements:
                del self.elements[element_key]
                del self.attachments[element_key]
            self.indexes.pop(i)
            i -= 1

        self.selectedElems = []
        self.applyElements(False)

    def removeRows(self, deleted_names):
        for element in self.indexes:
            element_key = self.get_key(element)
            if element_key:
                del self.elements[element_key]
                del self.attachments[element_key]

        self.indexes = []
        self.selectedElems = []
        self.applyElements(False)

    def onElementEvent(self, col, row, event, data):
        return None

    def elementEvent(self, row_index, col_index, event, data):
        self.onElementEvent(col_index, row_index, event, data)
        if event == 'LEFTMOUSE':
            pass
        elif event == 'RIGHTMOUSE':
            pass
        elif event == 'SELECT_LIST':
            pass
        elif event == 'CHECK':
            self.indexes[row_index + self.offset]['data'][0] = (data['name'], data['value'])

    def clearSelection(self):
        self.selectedElems = []
        self.applyElements()

    def selectRow(self, rowIndex, doSelect = True):
        self.selectedElems = [rowIndex]
        self.applyElements()

    def get_label_row_position(self, row, col):
        row_element = self.elemComps[row]
        x = row_element.component.position.x
        label = getattr(row_element.component, 'column%s' % col)
        w, h = label.script.get_dimensions()
        if label.script.align == 'CENTER':
            w = w / 2.0
        return label.position.x + w

    def select_all_checkboxes(self):
        for i in self.elemComps:
            checkbox = getattr(i.component, 'column0')
            if not checkbox:
                continue
            if isinstance(checkbox.script, TableCheckBox):
                checkbox.script.set_active(True)

        for i, data in enumerate(self.indexes):
            if i == 0:
                continue
            name, value = data['data'][0]
            self.indexes[i]['data'][0] = (name, True)
            self.onElementEvent(0, i, 'CHECK', {'name': name,
             'value': True})

    def deselect_all_checkboxes(self):
        for i in self.elemComps:
            checkbox = getattr(i.component, 'column0')
            if not checkbox:
                continue
            if isinstance(checkbox.script, TableCheckBox):
                checkbox.script.set_active(False)

        for i, data in enumerate(self.indexes):
            if i == 0:
                continue
            name, value = data['data'][0]
            self.indexes[i]['data'][0] = (name, False)
            self.onElementEvent(0, i, 'CHECK', {'name': name,
             'value': False})

    def addRows(self, rows):
        for row in rows:
            self.addElement(row, delayedRender=True)

        self.applyElements(False)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def scrollUp(self):
        newVal = self.vScroll.getValue() - 1
        if newVal >= self.minScroll:
            self.vScroll.setValue(newVal)
            self.offset = newVal
            self.applyElements(False)

    def scrollDown(self):
        newVal = self.vScroll.getValue() + 1
        if newVal <= self.maxScroll:
            self.vScroll.setValue(newVal)
            self.offset = newVal
            self.applyElements(False)

    @PyGUIEvent('listFrame.vScroll', 'scrollMoved')
    def vScrollMoved(self, newVal):
        self.offset = newVal
        self.vScroll.setValue(newVal)
        self.applyElements(False)