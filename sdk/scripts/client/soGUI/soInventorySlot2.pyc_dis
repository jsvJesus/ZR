    def hide_item(self):
        self.hidden = True
        self._applyItemData()

    def show_item(self):
        self.hidden = False
        self._applyItemData()

    def _applyItemData(self):
        self.cancelForceRedrawAfter()
        soItemSlot._applyItemData(self)
        player = BigWorld.player()
        if player.__class__.__name__ != 'PlayerAvatar':
            return
        else:
            item_highlight = False
            self._onLeaveDrag()
            self.clearMarkAsAttachable()
            self.component.thumb.visible = False
            self.component.oil.visible = False
            self.component.itemGrade.visible = False
            self.component.corner.visible = False
            if self.haveItem():
                self._trade_ignore = False
                if player.is_trading and self.trade_sensitive:
                    self._trade_ignore = not player.validate_item(self.itemData)
                elif BWPersonality.GUICore.isUserFireVisible():
                    self.component.drop.visible = False
                    if ItemsUtils.isUFFireWoodItem(self.itemData):
                        self.component.thumb.visible = True
                        self.component.thumb.texture = fuel_ico
                    elif ItemsUtils.isUFFood(self.itemData):
                        self.component.thumb.visible = True
                        self.component.thumb.texture = food_ico
                    else:
                        self._trade_ignore = True
                item_type = self.itemData['complexItemType']
                item_class = ItemsCatalog.GetItemClass(item_type)
                item_params = ItemsCatalog.GetItemParam(item_type)
                if not ItemsUtils.GetIconName(self.itemData):
                    iconName = 'nottexture.dds'
                    if BWPersonality.GUICore.iconTextures is not None:
                        if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                            if BWPersonality.GUICore.iconTextures.has_key(iconName):
                                self.component.itemIcon.texture = BWPersonality.GUICore.iconTextures[iconName]
                            else:
                                self.component.itemIcon.textureName = iconName
                    else:
                        self.component.itemIcon.textureName = iconName
                    countStr = ItemsUtils.GetDisplayValue(self.itemData)
                    item_highlight = self.itemData['complexItemID'] in player._target_items
                    if not player.ItemLocked(self.itemData):
                        item_lock = soGUI.soInventoryScreen.tempBlocked(self.itemData)
                        self.component.itemBroken.visible = ItemsUtils.is_item_broken(self.itemData, entity=player)
                        self.component.itemCount.text = countStr
                        self.lockSlot(item_lock)
                        if item_class == ItemsCatalog.WEAPON:

                            def filter_magaz(subitem):
                                sub_prop = ItemsCatalog.GetItemParam(subitem['itemType'])
                                return sub_prop and sub_prop.get('PartType') != ItemsCatalog.MAGAZINE

                            sub_items_count = len(filter(filter_magaz, self.itemData['itemList']))
                            if ItemsUtils.IsItemGraded(self.itemData):
                                self.component.itemGrade.visible = True
                        else:
                            sub_items_count = len(self.itemData['itemList'])
                        self.component.haveAttachedParts.visible = bool(sub_items_count)
                        if 'IsArtefactContainer' in item_params:
                            self.component.haveAttachedParts.text = str(sub_items_count)
                        else:
                            self.component.haveAttachedParts.text = '+'
                        emblem = ItemsUtils.getItemEmblem(self.itemData)
                        colorise = ItemsUtils.getItemColorise(self.itemData)
                        if not bool(colorise):
                            self.component.itemColored.visible = bool(ItemsUtils.getTintID(self.itemData))
                            self.component.itemEmblem.visible = bool(emblem)
                            inconstantParam = ItemsUtils.GetComplexItemInconstanParams(self.itemData)
                            if item_class == ItemsCatalog.ARTIFACT:
                                depleet_time = ItemsUtils.GetArtefactDepleetionTime(self.itemData, item_params, BWPersonality.gpd.time_diff)
                                if inconstantParam.get(ItemsCatalog.INC_ARTEFACT_DEAD, 0) or depleet_time < 0.0 or depleet_time is None:
                                    self.component.itemBroken.visible = True
                                else:
                                    self.component.itemBroken.visible = False
                            if ItemsUtils.IsQuestItem(self.itemData):
                                self.component.corner.colour = (255, 138, 0, 255)
                                self.component.corner.visible = True
                            elif ItemsUtils.IsDungeonItem(self.itemData):
                                self.component.corner.colour = (66, 161, 255, 255)
                                self.component.corner.visible = True
                            elif ItemsUtils.IsItemFixed(self.itemData, inconstantParam, player) or ItemsUtils.dropIsBlocked(self.itemData):
                                self.component.corner.colour = (255, 0, 0, 255)
                                self.component.corner.visible = True
                            oil_time_left = item_class == ItemsCatalog.WEAPON and ItemsUtils.getGreaseOilWeaponLeftTime(self.itemData, inconstantParam, BWPersonality.gpd.time_diff)
                            self.component.oil.visible = oil_time_left and True
                            self.forceRedrawAfter(oil_time_left + 3.0)
                else:
                    self.component.itemIcon.textureName = ''
                    self.component.itemCount.text = ''
                    self.component.itemBroken.visible = False
                    self.component.itemColored.visible = False
                    self.component.itemEmblem.visible = False
                    self.component.haveAttachedParts.visible = False
                    self.lockSlot(False)
                self.highlighted = item_highlight
                self.draggedIcon and self.isDragging and self.set_drag_proxy_visual(self.draggedIcon, self.multiselected)
            else:
                self.set_drag_proxy_visual(self.component.itemIcon.texture, self.multiselected)
            return

    def equipItem(self, slotIndex = 0):
        if self.isDragging and self.draggedData is not None:
            data = self.draggedData
        else:
            data = self.itemData
        BWPersonality.GUICore.inventoryEvent(INV_CONST.A_EQUIP, data, index=slotIndex)
        return

    def on_out_screen_drop(self):
        self.wannaDrop()

    def wannaDrop(self):
        items_to_delete = ItemsUtils.get_multiple_items_by_ids(BigWorld.player(), self.get_multiselection())
        if items_to_delete:
            BWPersonality.GUICore.inventoryEvent(INV_CONST.A_DROP, items_to_delete)

    def toActionBar(self, slotN, slot_element = None):
        prev_item_id = slot_element.itemData['item_id']
        prev_item_type = slot_element.itemData['item_type']
        if self.isDragging and self.draggedData is not None:
            data = self.draggedData
        else:
            data = self.itemData
        BWPersonality.GUICore.inventoryEvent(INV_CONST.A_TOQUICKBAR, [self.itemData,
         slotN,
         prev_item_id,
         prev_item_type])
        return

    def onDragStart(self):
        if self.haveItem():
            self.isDragging = True
            self.draggedData = self.itemData
            self.draggedIcon = self.component.itemIcon.texture
            self.dragProxy.visible = True
            BWPersonality.GUICore.inventoryEvent(INV_CONST.A_DRAG_START, self.itemData)
            return True
        return False

    def onDragStop(self):
        self.isDragging = False
        self.dragProxy.visible = False
        self.draggedData = None
        self.draggedIcon = None
        BWPersonality.GUICore.inventoryEvent(INV_CONST.A_DRAG_STOP, self.itemData)
        return True

    def lockSlot(self, doLock):
        soItemSlot.lockSlot(self, doLock)
        self.update_item_color()

    def _onLeaveDrag(self, dragged = None):
        self.component.itemIcon.width = self.SLOTWIDTH
        self.component.itemIcon.position[0] = self.SLOTWIDTH

    def _onEnterDrag(self, dragged):
        self._onLeaveDrag()
        if dragged and dragged.haveItem() and dragged != self:
            if BigWorld.isKeyDown(Keys.KEY_LSHIFT) or BigWorld.isKeyDown(Keys.KEY_RSHIFT) or dragged.multiselected:
                self.component.itemIcon.width = self.SLOTWIDTH * 0.8
                if self._slotIndex < dragged._slotIndex:
                    self.component.itemIcon.position[0] = self.SLOTWIDTH + 10
                else:
                    self.component.itemIcon.position[0] = self.SLOTWIDTH - self.SLOTWIDTH * 0.19999999999999996

    @property
    def highlighted(self):
        return getattr(self, '_highlighted', False)

    @highlighted.setter
    def highlighted(self, value):
        if self.highlighted == value:
            return
        self._highlighted = value
        self._update_attachable_color()

    @property
    def marked(self):
        return getattr(self, '_marked', False)

    @marked.setter
    def marked(self, value):
        if self.marked == value:
            return
        self._marked = value
        self._update_attachable_color()

    def update_item_color(self):
        if self.locked:
            self.component.itemIcon.colour = LOCKED_COLOR2
        elif self._trade_ignore:
            self.component.itemIcon.colour = LOCKED_COLOR
        elif BigWorld.player() and BigWorld.player().isFadedItem(self.itemData):
            self.component.itemIcon.colour = LOCKED_COLOR
        else:
            self.component.itemIcon.colour = WHITE_COLOR

    def _update_attachable_color(self):
        if not self.marked and not self.highlighted:
            self.component.mark_attachable.visible = False
            return
        self.component.mark_attachable.visible = True
        if self.marked:
            self.component.mark_attachable.colour = MARKED_COLOR
            return
        self.component.mark_attachable.colour = HIGHTLIGHT_COLOR

    def clearMarkAsAttachable(self):
        self.marked = False

    def checkMarkAsAttachable(self, attachingItem):
        if not self.itemData:
            return
        entity = BigWorld.player()
        if ItemsUtils.CheckPossibleAttach(entity, self.itemData, attachingItem):
            self.marked = True