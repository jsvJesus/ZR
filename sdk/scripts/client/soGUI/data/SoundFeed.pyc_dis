# Embedded file name: ./client/soGUI/data/SoundFeed.py
import ResMgr
from sounds_manager import playSound

class SoundFeeder(object):

    def __init__(self):
        self.soundCfg = ResMgr.openSection('scripts/client/soGUI/data/GUISounds.xml')

    def getSound(self, controlName, eventName):
        xmlKey = controlName + '/' + eventName
        return self.soundCfg.readString(xmlKey, '')

    def playSoundControl(self, controlName, eventName):
        soundName = self.getSound(controlName, eventName)
        if soundName:
            playSound(soundName)


soundFeed = SoundFeeder()