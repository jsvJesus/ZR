         'debuff_thirst_heavy',
         'debuff_thirst',
         'buff_pvp',
         'buff_createfire']
        self.buffMap = {}
        for i, buff in enumerate(self.buffList):
            row = int(floor(i / ICONROW_WIDTH))
            col = i - row * ICONROW_WIDTH
            x = ORIGIN[0] + ICON_WIDTH * col + ICON_HSPACING * col
            y = ORIGIN[1] + ICON_HEIGHT * row + ICON_VSPACING * row
            mapping = [(x, y),
             (x, y + ICON_HEIGHT),
             (x + ICON_WIDTH, y + ICON_HEIGHT),
             (x + ICON_WIDTH, y)]
            self.buffMap[buff] = [self.buffsTextureProvider, mapping]

    def getBuffTexture(self, buffName):
        if self.buffMap.has_key(buffName):
            return self.buffMap[buffName]
        else:
            print 'There is no texture in the buffFeeder for the buffname you have provided - ', buffName
            return None
            return None


buffFeed = BuffFeeder()