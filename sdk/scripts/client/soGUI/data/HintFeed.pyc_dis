# Embedded file name: ./client/soGUI/data/HintFeed.py
import random
from Localization import localization_object

class HintFeeder(object):

    def __init__(self):
        self.hintMap = []
        for entry in localization_object.getXMLData('HintFeed')['data'].values():
            self.hintMap.append(entry.asString.decode('utf-8'))

    def getHint(self):
        if not self.hintMap:
            return ''
        return random.choice(self.hintMap)