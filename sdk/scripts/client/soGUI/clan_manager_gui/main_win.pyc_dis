        comp.width, comp.height = (268, 2)
        comp.position = (-1, 0, 0.5)
        self.component.base_container.addChild(comp)
        self._info_block = InfoBlock(comp)
        self._info_block.history_btn.onClick = self._on_history_click
        info_comp = comp
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.width, comp.height = self.component.width - info_comp.width, 2
        comp.position = (1, 0, 0.5)
        self.component.base_container.addChild(comp)
        comp.heightMode = 'PIXEL'
        self._items_block = ItemsBlock(comp)
        self._items_block.add_listener(self._on_items_block_event)
        self._history_win = None
        return

    def _on_items_block_event(self, event_type, data):
        if ItemsET.OnMoneyChanged == event_type:
            self._info_block.on_money_changed(self._items_block.money)

    def _on_history_click(self):
        if not self._history_win:
            comp = GUI.Window()
            comp.position = (0, 0, 0.4)
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.width, comp.height = self.component.width, self.component.height
            self._history_win = HistoryWin(comp)
            self._history_win.back_btn.onClick = self._on_history_click
            self.component.addChild(comp)
        if self._history_win.visible:
            self._history_win.hide()
            self.component.base_container.visible = True
        elif self._base_name and BigWorld.player().clanID:
            self.component.base_container.visible = False
            self._history_win.show(self._base_name)
        else:
            print ('ClanWin(ERROR):', self._base_name, BigWorld.player().clanID)
            raise RuntimeError()

    @property
    def visible(self):
        return self.component.visible

    def show(self, npc_id):
        self.component.visible = True
        self.component.base_container.visible = True
        if self._history_win:
            self._history_win.hide()
        BigWorld.player().StartItemCache(npc_id, ItemsUtils.CACHE_MODE_WAREHOUSE)
        BWPersonality.GUICore.setBestCursor()
        BigWorld.player().cell.getDonateBaseData(npc_id)
        self._info_block.clear(npc_id)
        self._items_block.on_show()
        GUIPositions.show(self)

    def update_info(self, base_name, time_lost, has_guard, has_conductor):
        self._base_name = base_name
        self._info_block.update_info(base_name, time_lost, has_guard, has_conductor)

    def hide(self):
        self.component.visible = False
        self._items_block.on_hide()
        if self._history_win:
            self._history_win.hide()
        BWPersonality.GUICore.setBestCursor()

    def got_warehouse_data3(self, *args):
        if self.component.visible:
            self._items_block.got_warehouse_data4(*args)

    def on_item_appended3(self, *args):
        if self.component.visible:
            self._items_block.on_item_appended4(*args)

    def on_item_removed3(self, *args):
        if self.component.visible:
            self._items_block.on_item_removed4(*args)

    def on_money_changed2(self, *args):
        if self.component.visible:
            self._items_block.on_money_changed3(*args)

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)

    def reset_position(self):
        """ \xd1\x81\xd0\xb1\xd1\x80\xd0\xb0\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd """
