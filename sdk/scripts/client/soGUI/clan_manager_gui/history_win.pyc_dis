# Embedded file name: ./client/soGUI/clan_manager_gui/history_win.py
import BigWorld
import GUI
from Localization import lc
import colorCodes as cc
from soGUI.soButton import soButton
from threading import Thread
import requests
from renderer import Renderer
import ResMgr
import json

class HistoryWin(object):

    def __init__(self, comp):
        self._shown_request = None
        comp.visible = False
        self.component = comp
        left, right, top, bottom = (16, 16, 54, 8)
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.colour = (255, 255, 255, 0)
        comp.width, comp.height = self.component.width - left - right, self.component.height - top - bottom
        comp.position = (left, top, 0.9)
        self.component.addChild(comp, 'renderer')
        self._renderer = Renderer(comp)
        comp = GUI.Text(lc('GUI.DonateBase.hist.caption'), 'RobotoCondensedRegular_16.font')
        comp.colour = cc.active_rgba
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 22)
        comp.position = (0, 8, 0.9)
        self.component.addChild(comp, 'caption')
        comp = GUI.Text(lc('GUI.DonateBase.hist.info'), 'RobotoCondensedRegular_16.font')
        comp.colour = cc.inactive_rgba
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 22)
        comp.position = (16, 32, 0.9)
        self.component.addChild(comp)
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('GUI.DonateBase.hist.btnback')
        comp.width, comp.height = (122, 25)
        comp.position = (self.component.width - 16, 26, 0.5)
        self.component.addChild(comp)
        btn.onBound()
        self.back_btn = btn
        return

    def _on_show(self):
        server = None
        servers_data = json.loads(ResMgr.openSection('scripts/client/data/servers_config.json').asBinary)
        for servers in servers_data.itervalues():
            for server_data in servers:
                if BigWorld.server() == server_data['host']:
                    server = str(server_data['uid'])
                    break

            if server:
                break

        req_id = 0
        apikey = 126789
        request = 'http://k-el.stalker.so:8033/api/getlog?reqid={0}&apikey={1}&server={2}&base={3}&clanid={4}'.format(req_id, apikey, server, self._base_name, BigWorld.player().clanID)
        if self._shown_request == request:
            return
        else:
            self._shown_request = request
            self._renderer.set_loading(True)

            def callback(code, headers, body):
                self._renderer.set_data(body)
                self._renderer.set_loading(False)

            def error_callback(error_string):
                self._renderer.set_loading(False)
                print 'ClanWIN ERROR', error_string

            def get_thread(server_command, callback, error_callback, args):
                r = requests.get(server_command)
                status_code = r.status_code
                text, headers = r.text, r.headers
                r.raw.release_conn()
                if status_code == 200:
                    callback(status_code, headers, text)
                else:
                    error_callback(str(status_code))

            Thread(target=get_thread, args=(request,
             callback,
             error_callback,
             {})).start()
            return

    def show(self, base_name):
        self._base_name = base_name
        if not self.component.visible:
            self.component.visible = True
            self._on_show()

    @property
    def visible(self):
        return self.component.visible

    def hide(self):
        self.component.visible = False