    def _on_guards_click(self):
        if not BigWorld.player().checkClanRights(Clan.FLAG_CAN_BASE_BUY_ENTITIES):
            gui_jokes.askUserOk(lc('GUI.DonateBase.title'), lc('GUI.DonateBase.text_access_error'))
            return

        def okey_callback(event):
            if event == gui_jokes.askUserYesNo.YES:
                BigWorld.player().guards_activate(self.npc_id, self._potential_guard_price)

                def updateInfo():
                    BigWorld.player().cell.getDonateBaseData(self.npc_id)

                BigWorld.callback(1.0, updateInfo)

        text = cc.inactive_xml + lc('GUI.DonateBase.recr_text').format(cc.active_xml + groupNumber(self._potential_guard_price) + cc.inactive_xml)
        gui_jokes.askUserYesNo(lc('GUI.DonateBase.guards'), text, okey_callback)

    def on_money_changed(self, money):
        self._money = money

    def _on_conductor_click(self):

        def okey_callback(event):
            if event == gui_jokes.askUserYesNo.YES:
                p = BigWorld.player()
                if p.clanpoints < DB.conductor_points:
                    p.tellAboutClanStatus([], [], Clan.STATUS_CONDUCTOR_NO_POINTS)
                    return
                if self._money < DB.conductor_price:
                    p.tellAboutClanStatus([], [], Clan.STATUS_CONDUCTOR_NO_MONEY)
                    return
                if self._base_name:
                    self._conductor_btn.setDisabledState(True)
                    BigWorld.player().cell.conductor_activate0(self.npc_id, self._base_name)

        text = cc.inactive_xml + lc('GUI.DonateBase.cond_text').format(cc.active_xml + str(DB.conductor_points) + cc.inactive_xml, cc.active_xml + str(DB.conductor_price) + cc.inactive_xml)
        gui_jokes.askUserYesNo(lc('GUI.DonateBase.cond_caption'), text, okey_callback)

    def clear(self, npc_id):
        self._has_conductor = None
        self._base_name = None
        self._money = 0
        self.npc_id = npc_id
        self.component.basename.text = u''
        self.component.renttime.text = cc.inactive_hex + lc('GUI.DonateBase.rentTime')
        self.component.guardtime.text = cc.inactive_hex + lc('GUI.DonateBase.guard')
        self._guard_btn.setDisabledState(True)
        self._conductor_btn.setDisabledState(True)
        self.history_btn.setDisabledState(True)
        return

    def update_info(self, base_name, time_lost, has_guard, has_conductor):
        self._base_name = base_name
        self.component.basename.text = lc('DonateBases.name.{0}'.format(base_name))
        self.component.renttime.text = cc.inactive_hex + lc('GUI.DonateBase.rentTime') + u' ' + cc.active_hex + time_to_string(time_lost)
        guard_text = cc.inactive_hex + lc('GUI.DonateBase.guard') + ' ' + cc.active_hex
        if has_guard:
            guard_text += lc('GUI.DonateBase.guard_on')
            self._guard_btn.setDisabledState(True)
        else:
            guard_text += lc('GUI.DonateBase.guard_off')
            self._potential_guard_price = int(float(time_lost) / DB.ownership_time * DB.rp_war)
            self._guard_btn.setDisabledState(False)
        self.component.guardtime.text = guard_text
        self.history_btn.setDisabledState(False)
        self._conductor_btn.setDisabledState(has_conductor)