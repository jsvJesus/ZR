class Slot(soItemSlot):
    factoryString = 'soGUI.WarehouseScreenSlot'
    SLOTWIDTH = 64
    SLOTHEIGHT = 64

    def __init__(self, component, slotIndex, itemData = None):
        soItemSlot.__init__(self, component, slotIndex, itemData, centerDProxy=True)
        component.script = self
        comp = component
        comp.dragFocus = True
        comp.dropFocus = True
        comp.crossFocus = True
        comp.moveFocus = True
        comp.mouseButtonFocus = True
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = Slot.SLOTWIDTH, Slot.SLOTHEIGHT
        self.dragProxy = self.component.dragProxy
        self.proxyHolder = self.component
        self.proxyName = 'dragProxy'
        self._onDragStart = self._on_drag_start
        self._onDragStop = self._on_drag_stop

    def lockSlot(self, doLock):
        soItemSlot.lockSlot(self, doLock)
        self.component.icon.colour = (125, 125, 125, 255) if self.locked else (255, 255, 255, 255)

    def setupContent(self):
        comp = GUI.Frame2('soGUI/items/cell.dds')
        comp.verticalPositionMode, comp.horizontalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = (2, 2)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'frame')
        comp = GUI.Simple('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.4)
        self.component.addChild(comp, 'icon')
        comp = GUI.Text('...')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.font = 'ruRU_Cyrvetica_Extra_10i.font'
        comp.colour = (175, 166, 112, 255)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.3)
        self.component.addChild(comp, 'loadIcon')
        comp = GUI.Simple('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = Slot.SLOTWIDTH, Slot.SLOTHEIGHT
        comp.colour = (255, 255, 255, 128)
        comp.materialFX = 'BLEND'
        comp.visible = False
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'dragProxy')
        comp = GUI.Text('??')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.font = 'ArialNarrow_12.family'
        comp.colour = (175, 166, 112, 255)
        comp.materialFX = 'BLEND'
        comp.position = (self.SLOTWIDTH - 5, 5, 0.3)
        self.component.addChild(comp, 'count')

    def _on_drag_start(self):
        if not self._have_loaded_item():
            return False
        self.dragProxy.visible = True
        self.lockSlot(True)
        return True

    def _on_drag_stop(self):
        self.dragProxy.visible = False
        self.lockSlot(False)
        return True

    def _applyItemData(self):
        if self.haveItem():
            item_type = self.itemData['complexItemType']
            if item_type:
                self.component.loadIcon.visible = False
                self.component.frame.colour = (255, 255, 255, 255)
                self.component.icon.visible = True
                count = ItemsUtils.GetItemNumber(self.itemData)
                icon_name = ItemsUtils.GetIconName(self.itemData, item_type, count)
                self.component.icon.textureName = icon_name
                if count > 1:
                    self.component.count.text = str(count)
                    self.component.count.visible = True
                else:
                    self.component.count.visible = False
            else:
                self.component.loadIcon.visible = True
                self.component.frame.colour = (120, 120, 120, 255)
                self.component.icon.visible = False
                self.component.count.visible = False
        else:
            self.component.loadIcon.visible = False
            self.component.frame.colour = (255, 255, 255, 255)
            self.component.icon.visible = False
            self.component.count.visible = False
        self.dragProxy.texture = self.component.icon.texture

    def handleMouseLeaveEvent(self, comp):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        return soItemSlot.handleMouseLeaveEvent(self, comp)

    def _have_loaded_item(self):
        return bool(self.haveItem() and self.itemData['complexItemType'])

    def handleMouseEnterEvent(self, comp):
        if self._have_loaded_item():
            from Inventory import Inventory
            item_string = Inventory.GetItemString(self.itemData)
            BWPersonality.GUICore.showToolTip(cc.tf3_regular_text_color + item_string, delay=0)
        elif BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        return soItemSlot.handleMouseEnterEvent(self, comp)


class WarehouseView(PyGUIBase):
    ROWS = 4
    COLS = 5

    def __init__(self, component):
        comp = component
        PyGUIBase.__init__(self, comp)
        self.component.script = self
        self.on_slots_visible = lambda index_from, index_to: None
