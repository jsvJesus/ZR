        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.materialFX = 'BLEND'
        comp.position = (0, 6, 0.3)
        self.component.addChild(comp, 'title')
        edit_width = 140

        def cost_check(newStr, wholeText, offset):
            full_text = wholeText[0:offset] + newStr + wholeText[offset:]
            return full_text.isdigit() and len(full_text) < 10

        comp = GUI.Window()
        edit = soEditBox(comp, width=edit_width, height=19, font='RobotoCondensedRegular_14.font', hOffset=4, vOffset=2, color=(212, 169, 113, 255))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (5, 300, 0.9)
        self.component.addChild(comp, 'edit')
        edit.onBound()
        edit.setValue(u'0')
        edit.setValidator(cost_check)
        comp = GUI.Window()
        btn = soButton(comp)
        comp.verticalPositionMode, comp.horizontalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.width, comp.height = edit_width, 25
        comp.position = (4, self.component.height - 8, 0.9)
        btn.initVSC('soGUI/elements/button_1.xml')
        btn.onBound()
        btn.setVisualState('normal')
        btn.onClick = lambda : self._on_money_apply(edit.getInt())
        comp.label.text = lc('GUI.DonateBase.put_money')
        self.component.addChild(comp, 'moneyDeposit')
        btn_comp = comp
        self._put_money_btn = btn
        comp = GUI.Window()
        btn = soButton(comp)
        comp.verticalPositionMode, comp.horizontalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'BOTTOM')
        comp.width, comp.height = edit_width, btn_comp.height
        comp.position = (self.component.width - 18, btn_comp.position[1], 0.9)
        btn.initVSC('soGUI/elements/button_1.xml')
        btn.onBound()
        btn.setVisualState('normal')
        btn.onClick = lambda : self._on_money_apply(-edit.getInt())
        comp.label.text = lc('GUI.DonateBase.take_money')
        self.component.addChild(comp, 'moneyWithdraw')
        btn_comp = comp
        self._take_money_btn = btn
        comp = GUI.Window()
        tm = TextMoney(comp, font='RobotoCondensedRegular_16.font')
        comp.verticalPositionMode, comp.horizontalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = edit_width, btn_comp.height
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.position = (btn_comp.position[0], 304, 0.3)
        self.component.addChild(comp, 'money')
        tm.move_money_icon_height(-6)
        return

    def _on_money_apply(self, money):
        if money:
            self.on_money_apply(money)
            self.component.edit.script.setValue('0')

    def set_items(self, items):
        self.component.item_view.script.setItems(items)
        self.on_slots_visible(0, self.ROWS * self.COLS - 1)

    def _on_scroll(self):
        self.on_slots_visible(*self.cur_slots_visible)

    def _slot_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DRAGENTER:
            if data[1].factoryString == 'soGUI.soInventorySlot2':
                return data[1].itemData
            event == ITSLOT.SLOTEVENT_DROP and data[1].itemData and self.on_slot_to_inventory_drop(data[1].itemData)
            return True

    def set_money(self, money):
        self._money = money
        self.component.money.script.setValue(money)

    def get_money(self):
        return self._money

    @property
    def cur_slots_visible(self):
        top_row = self.component.item_view.script.cursor[1]
        bottom_row = top_row + self.ROWS
        index_from = top_row * self.COLS
        index_to = bottom_row * self.COLS - 1
        return (index_from, index_to)

    @property
    def visible(self):
        return self.component.visible


class ItemsBlock(Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        self._view = WarehouseView(component)
        self._view.on_slots_visible = self._on_slots_visible
        self._view.on_slot_to_inventory_drop = self._on_slot_to_inventory_drop
        self._view.on_money_apply = self._on_money_apply
        self._view.component.edit.script.onValueChange = self._on_money_edit_changed
        self._stored_items = None
        self._money = None
        self._on_items_updated()
        self._pending = False
        return

    def on_show(self):
        self._pending = False
        self._stored_items = None
        self._on_items_updated()
        self.money = 0
        self._view.component.edit.script.setValue(u'0')
        self._request_data(0)
        return

    def on_hide(self):
        self._stored_items = None
        self._on_items_updated()
        return

    def _on_slots_visible(self, from_index, to_index):
        self._check_need_load()

    def _on_money_apply(self, money):
        if self._pending:
            return
        player = BigWorld.player()
        if not player:
            return
        base_money = self._view.get_money()
        if money > 0:
            if money > player.CreditNumber:
                player.systemMsgChat(lc('GUI.DonateBase.error_nomoney'))
                return
        elif abs(money) + player.CreditNumber > MAX_MONEY_VAL:
            player.systemMsgChat(lc('GUI.DonateBase.error_max_money').format(MAX_MONEY_VAL))
            money = -(MAX_MONEY_VAL - player.CreditNumber)
        success = base_money + money >= 0
        self._player.change_money1(money, success)

    def _on_slot_to_inventory_drop(self, complex_item):
        success = len(self._stored_items) < Constants.MAX_WAREHOUSE_SIZE
        self._player.put_item_to_warehouse1(complex_item, success)

    def _check_need_load(self):
        if not self._stored_items:
            return
        elif self._pending:
            return
        else:
            from_index, to_index = self._view.cur_slots_visible
            for index in xrange(from_index, min(to_index + 1, len(self._stored_items))):
                if self._stored_items[index]['complexItemType'] is None:
                    self._request_data(index)
                    return

            return

    def on_item_appended4(self):
        self._stored_items.append({'complexItemType': None,
         'complexItemID': None})
        self._on_items_updated()
        self._check_need_load()
        return

    def on_money_changed3(self, money):
        self.money = money

    def on_item_removed4(self, item_index):
        del self._stored_items[item_index]
        self._on_items_updated()
        self._check_need_load()

    def _request_data(self, index):
        self._pending = True
        self._owner.request_warehouse_data1(index, self._view.COLS * self._view.ROWS)

    def got_warehouse_data4(self, items, index, total, money):
        self.money = money
        if self._stored_items is None or total != len(self._stored_items):
            self._stored_items = [{'complexItemType': None,
              'complexItemID': None}] * total
        self._stored_items[index:index + len(items)] = items
        self._on_items_updated()
        self._pending = False
        self._check_need_load()
        return

    def _on_money_edit_changed(self, by_user):
        self._update_buttons_availability()

    def _update_buttons_availability(self):
        empty_text_money = self._view.component.edit.script.getInt() == 0
        self._view._take_money_btn.setDisabledState(self._view.get_money() == 0 or empty_text_money)
        self._view._put_money_btn.setDisabledState(empty_text_money)

    def _on_items_updated(self):
        self._view.set_items(self._stored_items)

    @property
    def _player(self):
        return BigWorld.player()

    @property
    def _owner(self):
        return BigWorld.entities[self._player.cacheObjectID]

    @property
    def money(self):
        return self._money

    @money.setter
    def money(self, value):
        if value == self._money:
            return
        self._money = value
        self._view.set_money(value)
        self._update_buttons_availability()
        self.notify_listeners(EventType.OnMoneyChanged)