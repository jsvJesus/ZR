from listwin import ListWin, EventType as ListET
from image_panel import ImagePanel

class Previewer:

    def __init__(self, component):
        self.component = component
        border = 0.23
        self._list_panel = ListWin(self.component)
        self._list_panel.transform.set_clip_mode((0,
         0,
         border,
         1))
        self._list_panel.add_listener(self._on_list_event)
        self._image_panel = ImagePanel(self.component)
        self._image_panel.transform.set_clip_mode((border,
         0,
         1,
         1))
        self._image_panel.set_config(self._list_panel.get_selected_config())

    def _on_list_event(self, event_type, data):
        if event_type == ListET.OnSelected:
            self._image_panel.set_config(self._list_panel.get_selected_config())

    def get_selected_config(self):
        return self._list_panel.get_selected_config()

    def do_reposition(self):
        self._list_panel.transform.apply_mode()
        self._image_panel.transform.apply_mode()
        return self._image_panel.component