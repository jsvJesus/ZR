# Embedded file name: ./client/soGUI/cutscenes/cutscenelist.py
import BigWorld
from Localization import lc
import BWPersonality
import GUI
from previewer import Previewer
from Helpers.PyGUI.PyGUIBase import Interceptor
from ui.panel import Panel
from ui.button import Button
from ui.text import Text, Align
from ui.transform import Transform
from Helpers.PyGUI.Utils import pixelperfect_component

class CutsceneList(Interceptor):

    def __init__(self):
        comp = GUI.Window()
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.05)
        comp.visible = False
        Interceptor.__init__(self, comp, interscept_keys=True)
        comp = GUI.Window('soGUI/frame/donatshop/background.dds')
        comp.materialFX = 'SOLID'
        self._panel = Panel(self.component, 'background', component=comp, depth=0.95)
        self._panel.transform.set_clip_mode((0, 0, 1, 1))
        left = 120
        t = Text(self._panel.component, 'header', text=lc('CutscenesGui.header'), size=32)
        t.set_alignment(Align.Left, Align.Center)
        t.transform.set_pixel_mode((0, 0.5), (0, 0), (240, 40), pixel_pos=(left, 32))
        comp = GUI.Window('soGUI/frame/donatshop/headlight.dds')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'TOP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.1)
        self._panel.component.addChild(comp, 'headlight')
        p = Panel(self._panel.component, 'content')
        p.transform.set_clip_mode((0, 0, 1, 1), pixel_anchors=(left,
         60,
         -74,
         -110))
        comp = GUI.Window()
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        self._panel.component.content.addChild(comp, 'previewer')
        self._previewer = Previewer(comp)
        btn = Button(self._panel.component, 'btnrun', frame=True)
        btn.set_text(lc('CutscenesGui.run'))
        btn.set_visual('soGUI/frame/buttons/cutscenebutton.json')
        btn.transform.set_pixel_mode((0.5, 0.5), (0.5, 0), (100, 100))
        btn.on_click = self._run
        btnclose = Button(self._panel.component, 'btnclose')
        btnclose.set_visual('soGUI/frame/buttons/wincross.json')
        btnclose.transform.set_pixel_mode((1, 0), (1, 0), (36, 36), pixel_pos=(-16, 16))
        btnclose.component.frame.filterType = 'LINEAR'
        btnclose.on_click = self.hide

    def show(self):
        if not self.component.visible:
            self.component.visible = True
            self._on_show()

    def _on_show(self):
        self._do_reposition()

    def hide(self):
        if self.component.visible:
            self.component.visible = False
            self._on_hide()

    def _on_hide(self):
        pass

    def _run(self):
        config = self._previewer.get_selected_config()
        BWPersonality.GUICore.show_cutscene(config, self.component, 0.1)

    @property
    def visible(self):
        return self.component.visible

    def _do_reposition(self):
        self._panel.transform.apply_mode()
        tcomp = self._panel.component.header
        width = tcomp.script.get_string_width()
        comp = self._panel.component.headlight
        comp.position = (tcomp.position[0] + width * 0.5, 0, 0.1)
        ratio = float(comp.texture.width) / comp.texture.height
        width *= 2.0
        comp.width, comp.height = width, width / ratio
        content_comp = self._panel.component.content
        content_ratio = float(content_comp.width) / content_comp.height
        need_ratio = 2.3
        comp = self._previewer.component
        if need_ratio >= content_ratio:
            comp.width = content_comp.width
            comp.height = comp.width / need_ratio
        else:
            comp.height = content_comp.height
            comp.width = comp.height * need_ratio
        image_comp = self._previewer.do_reposition()
        btnrun = self._panel.component.btnrun.script
        pixel_ratio = Transform.calc_pixel_ratio()
        width, height = (150, 40)
        screen_pos = image_comp.localToScreen((image_comp.width * 0.5, image_comp.height))
        screen_pos[0] = (screen_pos[0] + 1) * 0.5 * BigWorld.screenWidth() / pixel_ratio
        screen_pos[1] = (1 - screen_pos[1]) * 0.5 * BigWorld.screenHeight() / pixel_ratio + 16
        btnrun.transform.set_pixel_mode((0.5, 0), (0, 0), (width, height), pixel_pos=screen_pos)
        pixelperfect_component(self.component)

    def handle_space(self, event):
        if BWPersonality.GUICore.cutscene_visible():
            BWPersonality.GUICore._cutscene.handleKeyEvent(event)

    def handle_esc(self):
        if BWPersonality.GUICore.cutscene_visible():
            return
        self.hide()

    def doReposition(self):
        self._do_reposition()