# Embedded file name: ./client/soGUI/cutscenes/cs_dwin.py
import ResMgr
import BWPersonality
import os
import GUI
from Helpers.PyGUI.PyGUIBase import DragWin
from soGUI.soButton import soButton
from soGUI.soDropDownList import soDropDownList2
from cs_utils import cutscenes_path
from soGUI.cutscenes.cswin import EventType as WinET

class DebugWin(DragWin):

    def __init__(self):
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'SOLID'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width = 220
        comp.position = (0, 0, 0.9)
        comp.visible = False
        DragWin.__init__(self, comp)
        comp = GUI.Window()
        btn = soButton(comp)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.width, comp.height = (18, 18)
        comp.position = (self.component.width - 8, 8, 0.2)
        self.component.addChild(comp, 'closeBox')
        btn.onBound()
        btn.initVSC('soGUI/elements/closeBox.xml')
        btn.onClick = self.hide
        space = 4
        pos_y = [8]
        comp = GUI.Window()
        self._configs_ddl = soDropDownList2(comp, width=180, height=26)
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.position = (8, pos_y[0], 0.5)
        self.component.addChild(comp)
        pos_y[0] += comp.height + space
        self._configs_ddl.onSelectedElement = self._on_config_selected

        def create_button(text, callback):
            comp = GUI.Window()
            btn = soButton(comp)
            btn.initVSC('soGUI/elements/button_1.xml')
            comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.ha, comp.va = ('LEFT', 'TOP')
            comp.label.font = 'RobotoCondensedRegular_16.font'
            comp.label.text = text
            comp.width, comp.height = (180, 25)
            comp.position = (8, pos_y[0], 0.1)
            btn.onClick = callback
            self.component.addChild(comp)
            btn.onBound()
            pos_y[0] += comp.height + space
            return btn

        create_button(u'\u043e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u043a\u043e\u043d\u0444\u0438\u0433\u0438', self._repopulate_configs)
        self._run_button = create_button(u'\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c', self._run)
        self._stop_button = create_button(u'\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c', self._stop)
        create_button(u'\u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e', self._reload_local)
        self.component.height = pos_y[0]

    def _reload_local(self):
        from Localization import localization_object
        localization_object.loaded_dialog_files.clear()
        localization_object.loaded_loc_files.clear()
        localization_object.commands.clear()
        localization_object.reload_lc(True)

    def _repopulate_configs(self):
        prev_selection = self._configs_ddl.getSelection()[1]
        self._configs_ddl.clear()
        ddl_elements = []
        folder_path = os.path.join(os.getcwd(), '../res', cutscenes_path)
        for file_path in os.listdir(folder_path):
            full_path = os.path.normpath(os.path.join(folder_path, file_path))
            if not os.path.isfile(full_path):
                continue
            file_name, extension = os.path.splitext(file_path)
            if extension != '.pyson':
                continue
            ddl_elements.append((full_path, file_name))
            res_path = os.path.join(cutscenes_path, file_name + '.pyson')
            ResMgr.purge(res_path, True)

        self._configs_ddl.addElements(ddl_elements)
        if prev_selection:
            self._configs_ddl.setSelectionByValue(prev_selection, silent=True)

    def _on_config_selected(self, config):
        self._update_buttons()

    def show(self):
        if self.component.visible:
            return
        self.component.visible = True
        self._repopulate_configs()
        self._update_buttons()

    def _update_buttons(self):
        has_config = bool(self._configs_ddl.getSelection()[0])
        self._run_button.setDisabledState(not has_config)
        self._stop_button.setDisabledState(not self._win or not self._win.visible)

    def _stop(self):
        if self._win:
            self._win.close()

    @property
    def _win(self):
        return BWPersonality.GUICore._cutscene

    def _run(self):
        config = self._configs_ddl.getSelection()[0] + '.pyson'
        BWPersonality.GUICore.show_cutscene(config, BWPersonality.GUICore.systemLayer, 1.0)
        self._win.remove_listener(self._on_win_event)
        self._win.add_listener(self._on_win_event)
        self._update_buttons()

    def _on_win_event(self, event_type, data):
        if event_type == WinET.OnClose:
            self._update_buttons()

    def hide(self):
        self.component.visible = False