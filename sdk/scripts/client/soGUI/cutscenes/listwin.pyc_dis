# Embedded file name: ./client/soGUI/cutscenes/listwin.py
import GUI
import Keys
from utils import Listenable
from Localization import lc
from ui.text import Text, Align
from ui.panel import Panel
from ui.transform import pixel_params, clip_params
from cs_utils import configs

class EventType:
    OnSelected, = ((r, 'listwin') for r in range(1))


class LineET:
    OnEnter, OnLeave, OnClick = ((r, 'cutline') for r in range(3))


class Line(Text, Listenable):

    def __init__(self, component, index):
        Listenable.__init__(self)
        self.index = index
        self._hovered = False
        self._selected = False
        self._disabled = False
        text = lc('CutscenesGui.list.' + configs[self.index][0])
        Text.__init__(self, component, 'line' + str(self.index), size=24, text=text)
        self.set_alignment(Align.Left, Align.Center)
        if configs[self.index][1] is None:
            self._set_disabled(True)
            comp = GUI.Window('soGUI/frame/paint/lock.dds')
            image = Panel(self.component, 'lock', component=comp)
            comp.materialFX = 'BLEND'
            comp.colour = (52, 52, 52, 255)
            image.transform.set_pixel_mode((0, 0.5), (0, 0.5), (comp.texture.width, comp.texture.height))
            self.component.text.position[0] = -0.9
        else:
            self.change_interseption(intercept_buttons=True, intercept_moving=True)
        self._update_visual()
        return

    def _update_visual(self):
        if self._disabled:
            self.set_color((52, 52, 52, 255))
        elif self._selected:
            self.set_color((220, 220, 220, 255))
        elif self._hovered:
            self.set_color((180, 180, 180, 255))
        else:
            self.set_color((146, 146, 146, 255))

    def _set_disabled(self, disabled):
        self._disabled = True
        self._update_visual()

    def set_hovered(self, hovered):
        self._hovered = hovered
        self._update_visual()

    def set_selected(self, selected):
        self._selected = selected
        self._update_visual()

    def handleMouseEnterEvent(self, comp):
        result = Text.handleMouseEnterEvent(self, comp)
        data = {'line': self}
        self.notify_listeners(LineET.OnEnter, data)
        return result

    def handleMouseLeaveEvent(self, comp):
        result = Text.handleMouseLeaveEvent(self, comp)
        data = {'line': self}
        self.notify_listeners(LineET.OnLeave, data)
        return result

    def handleMouseButtonEvent(self, comp, event):
        result = Text.handleMouseButtonEvent(self, comp, event)
        if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
            data = {'line': self}
            self.notify_listeners(LineET.OnClick, data)
        return result


class ListWin(Panel, Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        Panel.__init__(self, component, 'list')
        self._hovered = None
        self._selected = None
        height = 48
        for i in range(len(configs)):
            line = Line(self.component, i)
            if not self.selected:
                self.selected = line
            cpx = clip_params((0.0, 1))
            cpy = pixel_params(0, 0, height, pixel_pos=i * height)
            line.transform.set_mixed_mode(cpx, cpy)
            line.add_listener(self._on_line_event)

        return

    def _on_line_event(self, event_type, data):
        if event_type == LineET.OnEnter:
            self.hovered = data['line']
        elif event_type == LineET.OnLeave:
            if self.hovered == data['line']:
                self.hovered = None
        elif event_type == LineET.OnClick:
            self.selected = data['line']
        return

    def get_selected_config(self):
        return configs[self.selected.index][1]

    @property
    def hovered(self):
        return self._hovered

    @hovered.setter
    def hovered(self, value):
        if value == self._hovered:
            return
        if self._hovered:
            self._hovered.set_hovered(False)
        self._hovered = value
        if self._hovered:
            self._hovered.set_hovered(True)

    @property
    def selected(self):
        return self._selected

    @selected.setter
    def selected(self, value):
        if value == self._selected:
            return
        if self._selected:
            self._selected.set_selected(False)
        self._selected = value
        if self._selected:
            self._selected.set_selected(True)
        self.notify_listeners(EventType.OnSelected)