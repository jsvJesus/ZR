# Embedded file name: ./client/soGUI/cutscenes/image_panel.py
import GUI
from functools import partial
import pyson
from os.path import join
from cs_utils import cutscenes_path
from ui.panel import Panel
import ResourceLoader

class ImagePanel(Panel):

    def __init__(self, component):
        Panel.__init__(self, component, 'image')
        self._load_id = 0
        comp = GUI.Simple('soGUI/frame/journal/load_anim/load_pips')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.visible = False
        self.component.addChild(comp, 'loadpip')

    def _on_config_load(self, load_id, prereqs):
        if self._load_id != load_id:
            return
        data = pyson.loads(prereqs.produce(0).asBinary)
        image_path = data['frames'][0]['image']
        ResourceLoader.asyncLoad([(ResourceLoader.TEXTURE, image_path)], partial(self._on_dds_loaded, load_id))

    def _on_dds_loaded(self, load_id, prereqs):
        if self._load_id != load_id:
            return
        self.component.texture = prereqs.produce(0)
        self.component.loadpip.visible = False

    def set_config(self, config):
        self.component.textureName = ''
        self.component.loadpip.visible = True
        self._load_id += 1
        config_path = join(cutscenes_path, config)
        ResourceLoader.asyncLoad([(ResourceLoader.DATA_SECTION, config_path)], partial(self._on_config_load, self._load_id))