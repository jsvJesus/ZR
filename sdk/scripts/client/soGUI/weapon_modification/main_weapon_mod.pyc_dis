def gen_bb():
    while True:
        for bb in ('true', 'false'):
            for ms in (0, 1):
                yield (ms, bb)


gen_bb = gen_bb()

class WeaponMod(PyGUIBase):
    factoryString = 'soGUI.WeaponMod'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        self.set_behaviours(WinBehaviour.Full)
        component.script = self
        self.weapon = None
        self._hook_hide = False
        self._original_attachments_count = 0
        self.setupRoot()
        self.setupContent()
        self.setupBtns()
        self.setupDebugBtns()
        self.component.reSort()
        return

    def doReposition(self):
        self.width, self.height = BigWorld.screenSize()
        self.component.bApply.position = ((self.width - 330) / 2, -0.99, 0.01)
        self.component.closeBox.position = (self.width - 10, 6, 0.01)
        self.inventory_panel.doReposition()
        self._rw.updateSize(update_model=self.component.visible)
        if self._hook_hide:
            return

