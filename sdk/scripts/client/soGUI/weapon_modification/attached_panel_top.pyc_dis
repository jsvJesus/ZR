# Embedded file name: ./client/soGUI/weapon_modification/attached_panel_top.py
import BigWorld
import BWPersonality
import GUI
from Items import ItemsCatalog
import ItemsUtils
import traceback
from Localization import lc
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from soGUI.soItemView import soItemView
from gui_const import ITSLOT
import soGUI

class AttachedPanelTop(PyGUIBase):
    SLOT_COLS = 8

    def __init__(self, component, parent):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.parent = parent
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 210)
        cmp.materialFX = 'BLEND'
        cmp.width = attachedItemSlot.SLOTWIDTH * self.SLOT_COLS + 3
        cmp.height = 84

    def setupContent(self):
        sW, sH = BigWorld.screenSize()
        itemView = soItemView(GUI.Window(), attachedItemSlot, slot_eventsHandler=self.slotHandler, eventsHandler=self.itemViewHandler, rowWidth=self.SLOT_COLS, cols=self.SLOT_COLS, hScroll=1, borderWidth=0, rows=1, vScroll=0, scroll_auto_hide=True)
        cmp = itemView.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (1, 1, 0.5)
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        self.component.addChild(cmp, 'attach_view')
        itemView.onBound()
        itemView.setRestrictingComponent(None)
        itemView.setItems(None)
        self.attach_view = itemView
        return

    def onWeaponChange(self):
        self.updateAttacedView()

    def onSelectedAttachID(self, itemID):
        self.updateAttacedView(itemID)

    def onRMBAttach(self, item, attach):
        self.createContextMenu(item, attach)

    def updateAttacedView(self, selected_itemID = None):
        self.attach_view.setRestrictingComponent(None)
        items = self._weapon.getTmpAttachedItems()
        for item in items:
            item['selected'] = item['complexItemID'] == selected_itemID

        self.attach_view.rowWidth = max(self.SLOT_COLS, len(items))
        self.attach_view.setItems(items)
        return

    def show(self, weapon):
        self._weapon = weapon
        self.updateAttacedView()

    def doReposition(self):
        pass

    def apply(self):
        pass

    def slotHandler(self, eventID, slot):
        if ITSLOT.SLOTEVENT_LCLICK == eventID:
            if slot.haveItem():
                self._weapon.onClickID(slot.itemData['complexItemID'])
        if ITSLOT.SLOTEVENT_RCLICK == eventID:
            if slot.haveItem():
                self.createContextMenu(slot.itemData)
        return False

    def itemViewHandler(self, *e):
        return False

    context_menu_item = None

    def createContextMenu(self, item, attach = None):
        self.context_menu_item = item
        actions = {ItemsCatalog.CAN_INFO: lc('Inventory.client.INFO'),
         'detach_item': lc('Inventory.client.REMOVE')}
        if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and BigWorld.player().isAdminAccess():
            actions['copy_id'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c ItemID %s' % item['complexItemID']
            actions['copy_type'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c ItemType %s' % item['complexItemType']
            actions['copy_itemNameLC'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u043c\u044f'
            if attach:
                self._last_attachPosY = attach._attachPosY
                actions['copy_attachPosY'] = u'attachPosY %.3f' % attach._attachPosY
            var_name = ItemsCatalog.GetItemVarName(item['complexItemType'])
            if var_name:
                actions['copy_itemName'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c %s' % var_name
        BWPersonality.GUICore.addListener('contextMenuEvent', self.contextMenuEvent)
        BWPersonality.GUICore.showContextMenu(777, actions)

    def contextMenuEvent(self, interface_id, evid, caption, event, data):
        if interface_id not in (777,):
            return
        else:
            if event == soGUI.soContextMenuComponent.EVENT_SELECT:
                item = self.context_menu_item
                if item:
                    if evid == 'detach_item':
                        self._weapon.detachNodeByID(item['complexItemID'])
                    elif evid == ItemsCatalog.CAN_INFO:
                        BWPersonality.GUICore.showItemInfo(item)
                    elif evid == 'copy_id':
                        BigWorld.clipboardSetPlainText(str(item['complexItemID']))
                    elif evid == 'copy_type':
                        BigWorld.clipboardSetPlainText(str(item['complexItemType']))
                    elif evid == 'copy_itemName':
                        BigWorld.clipboardSetPlainText(ItemsCatalog.GetItemVarName(item['complexItemType']))
                    elif evid == 'copy_itemNameLC':
                        BigWorld.clipboardSetPlainText(ItemsUtils.GetItemName(item['complexItemType']))
                    elif evid == 'copy_attachPosY':
                        BigWorld.clipboardSetPlainText('%.3f' % self._last_attachPosY)
                self.context_menu_item = None
                BWPersonality.GUICore.removeListener('contextMenuEvent', self.contextMenuEvent)
            elif event == soGUI.soContextMenuComponent.EVENT_SHOW:
                pass
            elif event == soGUI.soContextMenuComponent.EVENT_CANCEL:
                self.context_menu_item = None
                try:
                    BWPersonality.GUICore.removeListener('contextMenuEvent', self.contextMenuEvent)
                except:
                    traceback.print_exc()

            return


class attachedItemSlot(soGUI.InvSlot):
    factoryString = 'soGUI.EquipedItemSlot'

    def take(self):
