# Embedded file name: ./client/soGUI/space_load_fade.py
import BigWorld
import BWPersonality
import GUI
from Helpers.PyGUI import PyGUIBase
DEF_UNFADE_BLACK_TIME = 0.4
DEF_UNFADE_SPEED = 5.0
DEF_UNFADE_HIDE_TIME = 15.0

class ScreenUnFader(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._hide_id = 0
        self._tidstart = 0
        self._startFade_id = 0
        self.setupRoot()
        self.setupContent()
        BWPersonality.GUICore.generalLayer.addChild(component, 'ScreenUnFader')

    def setupRoot(self):
        cmp = self.component
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.width = cmp.height = 2.1
        cmp.position = (0, 0, 0.51)
        cmp.visible = False

    def setupContent(self):
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.colour = (0, 0, 0, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2.1
        cmp.position = (0, 0, 0.3)
        self.component.addChild(cmp, 'fader')
        shad = GUI.AlphaShader()
        self.component.fader.addShader(shad)
        self.shad = shad
        comp = GUI.Simple('soGUI/maps/loadingScreen/loadingCircle/loadingCircle.texanim')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0)
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.visible = False
        self.component.fader.addChild(comp, 'load_circle')

    def unFade(self, unfade_speed = DEF_UNFADE_SPEED, hide_time = DEF_UNFADE_HIDE_TIME, after_time = DEF_UNFADE_BLACK_TIME):
        self._unfade_speed = unfade_speed
        self._unfade_hide_time = hide_time
        self._unfade_after_time = after_time
        circle_visible = self.component.fader.load_circle.visible
        self.hide()
        self.component.visible = True
        self.component.fader.load_circle.visible = circle_visible
        self.shad.mode = 'ALL'
        self.shad.start = 1.0
        self.shad.stop = 1.0
        self.shad.alpha = 0.5
        self.shad.speed = 0.0
        self.shad.value = 1.0
        self._tidstart = BigWorld.callback(self._unfade_after_time, self._startUnFade)

    def _startUnFade(self):
        self.shad.speed = self._unfade_speed
        self.shad.value = 0.0
        self._hide_id = BigWorld.callback(self._unfade_hide_time, self.hide)

    def fade(self, afterTime = 0, visible_time = 15, fade_speed = 10, show_circle = False):
        """ aterTime - \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0
                visible_time - \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xb2\xd1\x81\xd1\x91 \xd0\xb2\xd0\xbe\xd1\x81\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f (None, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xb2\xd0\xbe\xd1\x81\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c)
                fade_speed - \xd0\xb2\xd0\xb5\xd0\xbb\xd0\xb8\xd1\x87\xd0\xb8\xd0\xbd\xd0\xb0 \xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd0\xbd\xd0\xb0\xd1\x8f (!!!) \xd1\x81\xd0\xba\xd0\xbe\xd1\x80\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xb7\xd0\xb0\xd1\x82\xd1\x83\xd1\x85\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f
        """
        self.hide()
        self._fade_speed = fade_speed
        self._visible_time = visible_time
        self.shad.value = 0.0
        self.shad.speed = 0.0
        self.shad.start = 0.0
        self.shad.stop = 0.0
        self.shad.alpha = 0.0
        self.component.visible = True
        self.component.fader.load_circle.visible = show_circle
        self._startFade_id = BigWorld.callback(afterTime, self._startFade)

    def _startFade(self):
        self.shad.speed = self._fade_speed
        self.shad.value = 1.0
        if self._visible_time != None:
            self._hide_id = BigWorld.callback(self._visible_time, self.hide)
        return

    def hide(self):
        self.component.visible = False
        self.component.fader.load_circle.visible = False
        BigWorld.cancelCallback(self._hide_id)
        BigWorld.cancelCallback(self._tidstart)
        BigWorld.cancelCallback(self._startFade_id)