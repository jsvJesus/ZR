    def prepare_answer(self, req_name, answer = None):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xb2 \xd1\x82\xd0\xb0\xd0\xba\xd0\xbe\xd0\xbc \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb5, \xd0\xb2 \xd0\xba\xd0\xb0\xd0\xba\xd0\xbe\xd0\xbc \xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xb6\xd0\xb8\xd0\xb4\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88."""
        result = {'event_name': req_name,
         'data': answer if answer is not None else dict()}
        return result

    def ready(self):
        self.setLoginSteamMode(steam_client_api.STEAM_MODE)
        self.showGoldBalance(False)
        mem = psutil.virtual_memory()
        if mem.total < BWPersonality.game.Constants.CRITICAL_MEMORY_LIMIT1:
            BWPersonality.GUICore.loginFlash.show_dialog_message(lc('BWPersonality.client.LOW_MEMORY_HEADER'), lc('BWPersonality.client.LOW_MEMORY_CONTENT'))

    @BWMemberCoroutine
    def _autologin_and_run_debug(self):
        print '  ZIM: autologin0'
        authenticate_args = sys.argv[2:6]
        authenticate_args[2] = int(authenticate_args[2])
        bot_config = None
        if len(sys.argv) > 6:
            bot_config = sys.argv[6]
        login_error = [False]
        yield BWWaitForPeriod(0)
        yield BWWaitForCondition(lambda : bool(self.login_actions.servers_by_id))
        print '  ZIM: autologin1'
        if BWPersonality.GUICore._web_browser:
            BWPersonality.GUICore._web_browser.hide()
        self.login_actions.authenticateUser(*authenticate_args)

        def overridden_state_of_connect(state, msg):
            if state == 'ERROR':
                login_error[0] = True
                print '  ZIM: autologin error'
                return
            state_of_connect(state, msg)

        state_of_connect = BWPersonality.GUICore.loginFlash.state_of_connect
        BWPersonality.GUICore.loginFlash.state_of_connect = overridden_state_of_connect
        yield BWWaitForPeriod(0)
        print '  ZIM: autologin2'
        if BWPersonality.GUICore._web_browser:
            BWPersonality.GUICore._web_browser.hide()
        while True:
            if hasattr(BigWorld, 'nologin_until'):
                del BigWorld.nologin_until
            if getattr(BigWorld.player(), 'dummy', None) and not BWPersonality.GUICore.connectionWindow and getattr(BigWorld.player(), 'characterList', None):
                print '  ZIM: autologin dummy found', BigWorld.player().characterList
                break
            if login_error[0]:
                BWPersonality.GUICore.loginFlash.state_of_connect = state_of_connect
                yield BWWaitForPeriod(1)
                self._autologin_and_run_debug().run()
                return
            yield BWWaitForPeriod(0)

        self.account_actions.play_game(None)
        if BWPersonality.GUICore._web_browser:
            BWPersonality.GUICore._web_browser.hide()
        print '  ZIM: autologin3'
        if bot_config:

            def wait_contition():
                if BigWorld.player().__class__.__name__ != 'PlayerAvatar':
                    return False
                if not BigWorld.player().enteredWorld:
                    return False
                if BigWorld.spaceLoadStatus() < 1.0:
                    return False
                return True

            yield BWWaitForCondition(wait_contition)
            from test_bot import test_bot_main
            test_bot_main.run()
            bot_win = test_bot_main._instance._test_bot_win
            bot_win.select_config(bot_config + '.txt')
            bot_win._on_run_clicked()
        BWPersonality.GUICore.loginFlash.state_of_connect = state_of_connect
        return

    def return_in_game(self):
        """\xd0\x92\xd0\xb5\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xb2 \xd0\xb8\xd0\xb3\xd1\x80\xd1\x83 \xd0\xb8\xd0\xb7 \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8e."""
        self.hide()

    def onShowNewsForFlash(self):
        """\xd0\x9e\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbe \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88, \xd1\x87\xd1\x82\xd0\xbe \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8, \xd0\xbf\xd0\xbe \xd0\xb8\xd0\xbd\xd0\xb8\xd1\x86\xd0\xb8\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb2\xd0\xb5 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb0."""
        self.send_to_flashscript('showNews')

    def show_news(self):
        """\xd0\xb8\xd0\xb7 \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb8\xd1\x88\xd0\xbb\xd0\xbe, \xd1\x87\xd1\x82\xd0\xbe \xd0\xb3\xd0\xbe\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8"""
        url = self.get_news_path()
        BWPersonality.GUICore.showWebEmbdeded(True, url, close_callback=self.close_news)

    def close_news(self):
        """\xd0\xb1\xd1\x80\xd0\xb0\xd1\x83\xd0\xb7\xd0\xb5\xd1\x80 \xd1\x81 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd1\x8f\xd0\xbc\xd0\xb8 \xd0\xb1\xd1\x8b\xd0\xbb \xd0\xb7\xd0\xb0\xd0\xba\xd1\x80\xd1\x8b\xd1\x82, \xd1\x83\xd0\xb1\xd0\xb5\xd1\x80\xd0\xb8 '\xd0\xb7\xd0\xb0\xd1\x89\xd0\xb8\xd1\x82\xd1\x83' \xd0\xb2\xd0\xbe \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88\xd0\xb5"""
        self.send_to_flashscript('closeNews')

    def send_to_flashscript(self, event, answer = None):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd1\x8b \xd0\xb2\xd0\xbe \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88."""
        result = self.prepare_answer(event, answer)
        callback = functools.partial(self.viewX.invoke, ('externalInterfaceTransmit', result))
        BigWorld.callback(0.0, callback)

    def send_checked_nickname(self, nick, result, message):
        self.account_actions.send_checked_nickname(nick, result, message)

    def set_steam_trusted(self, value):
        self.account_actions.set_steam_trusted(value)

    def send_password_text(self, text):
        self.send_to_flashscript('send_password_text', {'text': text})

    def all_characters_info(self):
        """\xd0\x98\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd0\xbe \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x85."""
        info = self.account_actions.all_characters_info()
        self.send_to_flashscript('allCharactersInfo', info)
        if self.account_actions.get_characters_count() == 0:
            BWPersonality.game.show_char_maker()
            self.send_to_flashscript('activateFirstCharWindow')
            account = BigWorld.player()
            if hasattr(account, 'onLoadDummyModelComplete'):
                account.onLoadDummyModelComplete(None)
        return

    def showDeveloperServer(self):
        self.login_actions.showDeveloperServer()

    def show_ingame_menu(self):
        """\xd0\xa1\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8e."""
        self.send_to_flashscript('gameMenu')

    def show_dialog_message(self, title, text):
        """\xd0\xa1\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe\xd0\xb9 messagebox \xd0\xb2 \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8e."""
        self.send_to_flashscript('show_dialog', {'title': title,
         'text': text})

    def show_dialog_shield(self):
        """\xd0\x94\xd0\xbb\xd1\x8f \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0 \xd1\x87\xd0\xb5\xd0\xb3\xd0\xbe-\xd1\x82\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x85 \xd0\xb3\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8e, \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88 \xd0\xb1\xd0\xbb\xd0\xbe\xd0\xba\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f"""
        self.send_to_flashscript('show_dialog_shield')

    def hide_dialog_shield(self):
        """\xd0\x94\xd0\xbb\xd1\x8f \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0 \xd1\x87\xd0\xb5\xd0\xb3\xd0\xbe-\xd1\x82\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x85 \xd0\xb3\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8e, \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88 \xd0\xb1\xd0\xbb\xd0\xbe\xd0\xba\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f"""
        self.send_to_flashscript('hide_dialog_shield')

    def on_disconnect(self):
        self.send_to_flashscript('ActionsWithLogin.authenticateUser', error)

    def state_of_connect(self, state, msg = ''):
        error = self.login_actions.state_of_connect(state, msg)
        print '\t\tstate_of_connect', error
        if error is not None:
            self.send_to_flashscript('ActionsWithLogin.authenticateUser', error)
        return

    def show_dummy(self):
        dummy = getattr(BigWorld.player(), 'dummy', None)
        if dummy:
            dummy.show_dummy()
        return

    def hide_dummy(self):

        def hide():
            dummy = getattr(BigWorld.player(), 'dummy', None)
            if dummy:
                dummy.hide_dummy()
            return

        BigWorld.callback(0.5, hide)

    def onMouseRightDrag(self, x, y):
        DummyRotating().rotate_model(x, y)

    def onMouseLeftDrag(self, x, y):
        DummyRotating().rotate(x, y)

    def open_settings(self):
        """\xd0\x9e\xd1\x82\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd0\xb2\xd0\xbd\xd1\x83\xd1\x82\xd1\x80\xd0\xb8\xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xb2\xd1\x8b\xd1\x85 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba."""
        self.send_to_flashscript('open_settings')

    def close_settings(self):
        BWPersonality.GUICore.showIngameSettings(False)
        self.send_to_flashscript('close_settings')

    def setLoginSteamMode(self, value):
        """\xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd1\x82\xd1\x8c \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xb2 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f Steam"""
        self.send_to_flashscript('steam_mode', {'is_steam': value})

    def setUserParams(self, login):
        """\xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb8\xd0\xbc\xd1\x8f \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd1\x82\xd0\xb8\xd0\xbc\xd0\xb0"""
        self.send_to_flashscript('user_params', {'login': login})

    def showGoldBalance(self, value):
        self.send_to_flashscript('gold_visible', {'visible': value})