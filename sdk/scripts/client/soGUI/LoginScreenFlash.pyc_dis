        if self._char_menu_mode == 'cloth':
            BigWorld.player().dummy.on_group_chosen(cloth)

    def update_full_character_view(self, data, init = False):
        """ \xd0\x9f\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbe\xd0\xb4\xd0\xb5\xd0\xb6\xd0\xb4\xd1\x8b \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0 """
        if self._char_menu_mode == 'main':
            self._full_update_data['char_data'] = data
