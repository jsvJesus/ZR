    def update_premium_account_data(self, account = None):
        """\xd0\x9e\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbe \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88 \xd0\xb8\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbe \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb8\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xbc \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xb5."""
        account = account or BigWorld.player()
        premium_id = account.premium_data['premium_id']
        frize_id = account.premium_frozen['premium_id']
        premium_configs = ClientPremiumConfigs(premium_id, [])
        configs_list = premium_configs.all_order_configs()
        data = {}
        data['premiums'] = configs_list
        data['boosters'] = BoosterConfigParser.get_all_icons()
        premium_time = round(account.premium_data['end_time'] - (time() - account.time_diff))
        data['current'] = premium_id if premium_time > 0 else -1
        data['remaining_time'] = premium_time if premium_time > 0 else -1
        data['frize'] = frize_id
        data['no_premium_icon_path'] = premium_configs.no_premium_icon_path
        data['booster_id'] = account.get_boost_id()
        config = BoosterConfigParser.get_config(data['booster_id'])
        remaining_time = int(account.boost_data['end_time'] - (time() - account.time_diff))
        data['booster_time'] = remaining_time if remaining_time > 0 else -1
        data['booster_name'] = lc(config['name']) if data['booster_id'] else ''
        self._receiver.send_to_flashscript('premiumAccountData', data)

    def not_enough_money(self, title, text):
        """\xd0\xa1\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88, \xd0\xbe \xd1\x82\xd0\xbe\xd0\xbc, \xd1\x87\xd1\x82\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x82\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb8\xd1\x83\xd0\xbc \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xbd\xd0\xb5 \xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xb3."""
        message = {'result': 0,
