    def _loadConfig(self):
        dataSection = ResMgr.openSection(CONFIG_FILE)
        self.default_char_config = json.loads(dataSection.asBinary)

    def on_change_sound_devices(self):
        devices = BWPersonality.settings.getSoundDeviceNamesDict()
        current_device_guid = BWPersonality.settings.getCurrentSoundDeviceGuid()
        data = {'data': devices}
        data['setting'] = 'audio'
        data['type'] = 'sound_device'
        data['value'] = current_device_guid
        self.send_to_flashscript('update_one_setting', data)
        if current_device_guid == '':
            BWPersonality.settings.setSoundDevice(current_device_guid)
            return
        for value, name in devices.items():
            if current_device_guid == value:
                break
        else:
            current_device_guid = ''

        BWPersonality.settings.setSoundDevice(current_device_guid)

    def activate_account_window(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2\xd0\xbe \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xb0."""
        BWPersonality.GUICore.showLoginFlash(True)
        self.login_actions.connected = True
        self.send_to_flashscript('activateAccountWindow')

    def update_current_event_data(self, caption, description, picture_path, end_time):
        data = {}
        data['caption'] = caption
        data['decription'] = description
        data['picture_path'] = picture_path
        data['end_time'] = end_time
        self.send_to_flashscript('updateEvent', data)

