    def handleMouseButtonEvent(self, comp, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        if event.key == KEY_LEFTMOUSE:
            self.left_mouse_down = event.isKeyDown()
        elif event.key == KEY_RIGHTMOUSE:
            self.right_mouse_down = event.isKeyDown()
        return self.component.movie.handleMouseButtonEvent(event)

    def handleMouseEvent(self, comp, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        if event.dz:
            DummyCameraFlyer().zoom(event.dz)
        return self.component.movie.handleMouseEvent(event)

    def handleKeyEvent(self, event):
        key = event.key
        mods = event.modifiers
        down = event.isKeyDown()
        if key == KEY_V and mods == MODIFIER_CTRL and down:
            text = BigWorld.clipboardGetPlainText()
            self.send_to_flashscript('controlV', {'clipboard': text})
        return self.component.movie.handleKeyEvent(event)

    def rotate_dummy(self, dx, dy = 0):
        """\xd0\x92\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0."""
        DummyRotating().rotate(dx * 0.3)

