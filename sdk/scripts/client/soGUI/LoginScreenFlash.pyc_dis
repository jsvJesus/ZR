    def receive_random_personality(self, data, first, force_face):
        """ \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 \xd0\xb4\xd1\x91\xd1\x80\xd0\xb3\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 BWPersonality.GUICore.loginFlash.send_to_flashscript('generate_random_personality')
                \xd0\xb8\xd0\xb7 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0 \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0
                \xd0\xbb\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xb5\xd1\x82 dummy, \xd0\xbd\xd0\xbe \xd0\xbf\xd1\x80\xd0\xb8 \xd1\x8d\xd1\x82\xd0\xbe\xd0\xbc \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb \xd1\x81 \xd0\xbf\xd1\x80\xd0\xb5\xd1\x81\xd0\xb5\xd1\x82\xd0\xbe\xd0\xbc
                \xd1\x81\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb0\xd0\xbd\xd0\xbe \xd0\xba\xd1\x80\xd0\xb8\xd0\xb2\xd0\xbe - \xd0\xb2\xd1\x81\xd1\x91 \xd1\x80\xd0\xb0\xd0\xb2\xd0\xbd\xd0\xbe \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbd \xd1\x80\xd0\xb0\xd0\xb7
        """
        from EquipSlotsConfigs import EquipSlotTypes as EST

        def npc_name_iterator():
            from NPCByName import npc_list
            for name in npc_list().names_by_npcName.keys():
                yield name

        if not hasattr(self, '_npc_names'):
            self._npc_names = npc_name_iterator()
        dummy = BigWorld.player().dummy

        def file_save(file_name):
            path = os.path.join('D:\\SO_GIT\\res\\headpresets', file_name)
            with open(path, 'w+') as f:
                personality = dummy.read_personality()
                face_parts = {}
                for slot_type in EST.get_face_slots():
                    face_parts[slot_type] = EST.get_slot_data(dummy, slot_type)

                json.dump((personality, face_parts), f)

        BigWorld.player().dummy.full_update_face_from_GUI(data)
        try:
            file_save(self._npc_names.next() + '.fcd')
        except StopIteration:
            return False

        return True

    def on_char_menu_mode(self, mode):
        if mode == 'main' and self._char_menu_mode not in ('face', 'cloth'):
            self._receiver.send_to_flashscript('lock_char_buttons', {'value': True})
        if self._char_menu_mode != mode:
            self._char_menu_mode = mode
            DummyCameraFlyer().center(mode == 'face')
            BigWorld.player().dummy.on_char_menu_mode(mode)

