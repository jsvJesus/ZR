    def get_settings(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xb8\xd0\xb3\xd1\x80\xd1\x8b."""

        def keybind_value_to_list(keybind_data):
            dct = {}
            for keybind, value in keybind_data.items():
                result = ''
                for index, key in enumerate(value.split()):
                    if index:
                        result += ' + '
                    result += BWKeyBindings.key_names.get(key, key)

                dct[keybind] = [result]
                if keybind.endswith('Weapon'):
                    dct[keybind + '_long_'] = [result + ' ' + lc('KeyBinds.Names.long_key')]

            return dct

        graphic_additional_settings = OrderedDict()
        setttings = BWPersonality.settings.getSetting('settings')
        graphic_additional_settings = self._default_additional_video_options()
        if setttings is not None:
            for label, value in setttings.items():
                graphic_additional_settings[label] = value

        data = {'video': {'main_settings': {'resolution': BWPersonality.settings.getResolution()['id'],
                                     'quality': BWPersonality.settings.getGraphicsPresetIndex(),
                                     'screen_mode': BWPersonality.settings.screen_mode,
                                     'contrast': BWPersonality.settings.getContrast(),
                                     'brightness': BWPersonality.settings.getBrightness(),
                                     'maxFrameRate': BWPersonality.settings.getMaxFrameRate(),
                                     'ASYNC_TASK_ENABLED': BWPersonality.settings.getAsyncTask(),
                                     'DEFERRED_RENDER': BWPersonality.settings.getDeferredRender(),
                                     'taskbar_visible': BWPersonality.settings.getTaskbarVisible()},
                   'additional_settings': graphic_additional_settings},
         'audio': {'environment': BWPersonality.settings.getEnvironmentVolume() * 100.0,
                   'music': BWPersonality.settings.getMusicVolume() * 100.0,
                   'voice': BWPersonality.settings.getVoiceVolume() * 100.0,
                   'all': BWPersonality.settings.getMainVolume() * 100.0,
                   'sound_device': BWPersonality.settings.getCurrentSoundDeviceGuid()},
         'mouse': {'sensivity': BWPersonality.settings.getMouseSensitivity() * 100,
                   'invert': int(BWPersonality.settings.getMouseInvert()),
                   'scope_sensivity': BWPersonality.settings.getMouseSensitivity(Settings.MOUSE_SCOPE) * 100},
         'keybinds': keybind_value_to_list(BWPersonality.settings.getKeybindingsDict()),
         'gui': {'inventory_size': BWPersonality.settings.GUISettings.inventory_size,
                 'item_cache_size': BWPersonality.settings.GUISettings.item_cache_size,
                 'reset_position': 'btn',
                 'map_size': BWPersonality.settings.GUISettings.map_size,
                 'gui_highlight': BWPersonality.settings.GUISettings.gui_highlight,
                 'fps_visible': BWPersonality.settings.GUISettings.fps_visible,
                 'weightwin_visible': BWPersonality.settings.GUISettings.weightwin_visible,
                 'actbar_type': BWPersonality.settings.GUISettings.actbar_type,
                 'castbar_type': BWPersonality.settings.GUISettings.castbar_type,
                 'compas_visible': BWPersonality.settings.GUISettings.compas_visible,
                 'dialog_not_close_by_interact_object': BWPersonality.settings.GUISettings.dialog_not_close_by_interact_object}}
        return data

    def keybind_localize_table(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x82\xd0\xb0\xd0\xb1\xd0\xbb\xd0\xb8\xd1\x86\xd1\x83 \xd0\xbd\xd0\xb0\xd0\xb7\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb9 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x88 \xd0\xba \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8."""
        keybind_table_path = 'scripts/client/data/actions_display_names.xml'
        py_data_section = ResMgr.openSection(keybind_table_path)
        result = {}
        for action in py_data_section.values():
            internal_name = action.readString('internal_name')
            display_name = action.readString('display_name')
            result[internal_name] = display_name

        return result

    def range_of_settings(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba."""
        self.graphic_resolutions = dict(((dct['id'], dct['name']) for dct in BWPersonality.settings.getResolutionList()))
        graphic_additional_settings = collections.defaultdict(dict)
        others_settings = collections.defaultdict(dict)
        for label, _index, options, _desc in BigWorld.graphicsSettings():
            if label in self.SETTINGS_LIST:
                for i, opts in enumerate(options):
                    if not opts[1]:
                        continue
                    graphic_additional_settings[label][str(i)] = Settings.lc_setting_value(opts[2])

            else:
                if not opts[1]:
                    continue
                others_settings[label][str(i)] = Settings.lc_setting_value(opts[2])

        additionals_settings = collections.defaultdict(dict)
        for key, value in BWPersonality.settings.getAdditionOptionValue().items():
            for name, bool_ in zip(value[1], value[2]):
                additionals_settings[str(key)][str(int(bool_))] = name

        graphic_additional_settings.update(additionals_settings)
        data = {'video': {'main_settings': {'resolution': dict(((str(key), v) for key, v in self.graphic_resolutions.items())),
                                     'quality': dict(((str(key), v) for key, v in self.VIDEO_QUALITIES.items())),
                                     'screen_mode': dict(((str(key), Settings.lc_setting_value(v)) for key, v in Settings.SCREEN_MODE_CODE_TO_NAME.items())),
                                     'contrast': [0, 100.0],
                                     'brightness': [0, 100.0],
                                     'maxFrameRate': [60, 999.0],
                                     'ASYNC_TASK_ENABLED': {'1': lc('Settings.client.On'),
                                                            '0': lc('Settings.client.Off')},
                                     'DEFERRED_RENDER': {'1': lc('Settings.client.On'),
                                                         '0': lc('Settings.client.Off')},
                                     'taskbar_visible': {'1': lc('Settings.client.On'),
                                                         '0': lc('Settings.client.Off')}},
                   'additional_settings': OrderedDict(sorted(graphic_additional_settings.items()))},
         'audio': {'environment': [0, 100.0],
                   'music': [0, 100.0],
                   'voice': [0, 100.0],
                   'all': [0, 100.0],
                   'sound_device': BWPersonality.settings.getSoundDeviceNamesDict() or {'': '--'}},
         'mouse': {'sensivity': [1, 100],
                   'scope_sensivity': [1, 100],
                   'invert': {'1': lc('Settings.client.On'),
                              '0': lc('Settings.client.Off')}},
         'gui': {'inventory_size': dict(((str(key), v) for key, v in BWPersonality.settings.GUISettings.getAllSizes().items())),
                 'item_cache_size': dict(((str(key), v) for key, v in BWPersonality.settings.GUISettings.getAllSizes().items())),
                 'map_size': BWPersonality.settings.GUISettings.getMapSizes(),
                 'reset_position': 'btn',
                 'gui_highlight': {'1': lc('Settings.client.On'),
                                   '0': lc('Settings.client.Off')},
                 'fps_visible': {'1': lc('Settings.client.On'),
                                 '0': lc('Settings.client.Off')},
                 'weightwin_visible': {'1': lc('Settings.client.On'),
                                       '0': lc('Settings.client.Off')},
                 'castbar_type': {str(Settings.CASTBAR_TYPE.CIRCLE): lc('Settings.client.CastbarCircle'),
                                  str(Settings.CASTBAR_TYPE.BAR): lc('Settings.client.CastbarBar')},
                 'actbar_type': {str(Settings.ACTIONBAR_TYPE.CLASSIC): lc('Settings.client.ActbarClassic'),
                                 str(Settings.ACTIONBAR_TYPE.CIRCLE): lc('Settings.client.ActbarCircle'),
                                 str(Settings.ACTIONBAR_TYPE.BOTH): lc('Settings.client.ActbarBoth')},
                 'dialog_not_close_by_interact_object': {'1': lc('Settings.client.Off'),
                                                         '0': lc('Settings.client.On')},
                 'compas_visible': {'1': lc('Settings.client.On'),
                                    '0': lc('Settings.client.Off')}}}
        return data

    def set_language(self, args):
        """\xd0\xa3\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x8f\xd0\xb7\xd1\x8b\xd0\xba \xd0\xb2 \xd0\xb8\xd0\xb3\xd1\x80\xd0\xb5."""
        self.language = args['id']
        BWPersonality.settings.applyLanguage(self.language)
        self._receiver.game_restart()

    def settings_update(self, data):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85."""
        self._rotation(data)
        self._check_need_restart()

    def show_options_menu(self):
        """\xd0\x9e\xd1\x82\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd0\xbe\xd0\xbf\xd1\x86\xd0\xb8\xd0\xb9 \xd0\xb8\xd0\xb7 \xd0\xb8\xd0\xb3\xd1\x80\xd1\x8b."""
        self._receiver.send_to_flashscript('showOptionsMenu')

    def _check_need_restart(self):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbb\xd0\xb8 \xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7\xd0\xb0\xd0\xb3\xd1\x80\xd1\x83\xd0\xb7\xd0\xba\xd1\x83 \xd0\xb8\xd0\xb3\xd1\x80\xd1\x8b \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba."""
        self.need_restart = False

    def _default_additional_video_options(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbe."""
        preference = BigWorld.prefs
        dct_pref = OrderedDict()
        for key, option in preference.items():
            if key != 'graphicsPreferences':
                continue
            for key, entry in option.items():
                if key != 'entry':
                    continue
                label = entry['label'].asString
                activeOption = entry['activeOption'].asInt
                dct_pref[label] = activeOption

        return dct_pref

    def _default_audio_options(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb0\xd1\x83\xd0\xb4\xd0\xb8\xd0\xbe."""
        data_section = ResMgr.openSection('scripts/client/data/audio_and_mouse_default.xml')
        pref = data_section['audioPreferences']
        all_ = pref['all'].asFloat * 100
        music = pref['music'].asFloat * 100
        enviroment = pref['environment'].asFloat * 100
        voice = pref['voice'].asFloat * 100
        return {'all': all_,
         'music': music,
         'environment': enviroment,
         'voice': voice,
         'sound_device': BWPersonality.settings.getCurrentSoundDeviceGuid()}

    def _default_keybindings_options(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xb8\xd0\xb0\xd1\x82\xd1\x83\xd1\x80\xd1\x8b."""
        path = 'scripts/client/data/default_key_bindings.xml'
        default_binds = ResMgr.openSection(path)
        keybinds = {}
        patt = re.compile('\t+')
        i = 0
        for value in default_binds.values():
            name = value['name'].asString
            keys = value.readStrings('keys')[:1]
            actions = [ self.check_key(patt.sub(' ', key).strip()) for key in keys ]
            alt_actions = [ action.replace(' ', ' + ') for action in actions if action.startswith('ALT ') or action.startswith('SHIFT ') ]
            if alt_actions:
                actions[:] = alt_actions
            keybinds[name] = {'actions': actions,
             'id': i}
            if name.endswith('Weapon'):
                copy_actions = copy(actions)
                i += 1
                for index, act in enumerate(copy_actions):
                    copy_actions[index] += ' ' + lc('KeyBinds.Names.long_key')

                keybinds[name + '_long_'] = {'actions': copy_actions,
                 'id': i}
            i += 1

        return keybinds

    def _default_main_video_options(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb3\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbe."""
        resolution = min(self.graphic_resolutions, key=lambda key: self.graphic_resolutions[key])
        preference = BigWorld.prefs
        full_screen = not preference['devicePreferences']['windowed'].asBool
        quality = VIDEO_QUALITIES.VIDEO_QUALITY_NORMAL
        scrn_mode = Settings.SCREEN_MODE_NAME_TO_CODE
        return {'quality': quality,
         'resolution': resolution,
         'screen_mode': scrn_mode['fullScreen'] if full_screen else scrn_mode['windowed'],
         'contrast': Settings.DEFAULT_CONTRAST,
         'brightness': Settings.DEFAULT_BRIGHTNESS,
         'maxFrameRate': Settings.DEFAULT_MAX_FRAMERATE}

    def _default_mouse_options(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbc\xd1\x8b\xd1\x88\xd0\xb8."""
        data_section = ResMgr.openSection('scripts/client/data/audio_and_mouse_default.xml')
        pref = data_section['mousePreferences']
        sensivity = pref['sensivity'].asFloat * 100
        invert = pref['invert'].asInt
        return {'sensivity': sensivity,
         'invert': invert,
         'scope_sensivity': sensivity}

    def _default_interface_options(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd0\xbd\xd1\x82\xd0\xb5\xd1\x80\xd1\x84\xd0\xb5\xd0\xb9\xd1\x81\xd0\xb0."""
        inv_size = BWPersonality.settings.default_settings['inventory_size']
        item_size = BWPersonality.settings.default_settings['item_cache_size']
        map_size = BWPersonality.settings.default_settings['map_size']
        return {'inventory_size': inv_size,
         'item_cache_size': item_size,
         'map_size': map_size,
         'reset_position': 'btn',
         'dialog_not_close_by_interact_object': False,
         'gui_highlight': True,
         'fps_visible': False,
         'weightwin_visible': True,
         'actbar_type': Settings.ACTIONBAR_TYPE.CLASSIC,
         'castbar_type': Settings.CASTBAR_TYPE.CIRCLE,
         'compas_visible': True}

    def _key_hook(self, event):
        """\xd0\x92\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xb8\xd0\xb7 GUICore, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd1\x83\xd1\x8e \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x88\xd1\x83."""
        key_codes = (event.key,)

        def isAltKey(key):
            return key in [KEY_RSHIFT,
             KEY_LSHIFT,
             KEY_RCONTROL,
             KEY_LCONTROL,
             KEY_RALT,
             KEY_LALT]

        if event.key == KEY_NUMPADENTER:
            return
        if isAltKey(event.key):
            if event.isKeyDown():
                return
        else:
            if event.isShiftDown():
                key_codes = (KEY_RSHIFT,) + key_codes
            if event.isCtrlDown():
                key_codes = (KEY_RCONTROL,) + key_codes
            if event.isAltDown():
                key_codes = (KEY_RALT,) + key_codes
        self._register_key_hook(False)
        self._new_action_key(key_codes)
        return True

    def check_key(self, key_name):
        return BWKeyBindings.key_names.get(key_name, key_name)

    def _new_action_key(self, key_codes):
        """\xd0\xa1\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88 \xd0\xbe \xd0\xbf\xd1\x80\xd0\xb8\xd1\x81\xd0\xb2\xd0\xbe\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd1\x8e \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb9 \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x88\xd0\xb8."""
        key_code_strings = ['']
        for index, key_code in enumerate(key_codes):
            key_code_string = BigWorld.keyToString(key_code)
            key_code_string = self.check_key(key_code_string)
            if index:
                key_code_strings[0] += ' + '
            key_code_strings[0] += key_code_string

        key_code_strings[0] = key_code_strings[0].strip()
        self._receiver.send_to_flashscript('getNewKeybind', {'key_names': key_code_strings})

    def _register_key_hook(self, register):
        """\xd0\xa0\xd0\xb5\xd0\xb3\xd0\xb5\xd1\x81\xd1\x82\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xbb\xd0\xb8 \xd0\xbe\xd1\x82\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8e, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xb0\xd1\x8f \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7\xd0\xb0\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8\xd0\xb2\xd1\x8f\xd0\xb7\xd0\xba\xd1\x83 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8 \xd0\xba \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd1\x8e."""
        if register:
            BWPersonality.GUICore.registerKeyHook(self._key_hook)
        else:
            BWPersonality.GUICore.registerKeyHook(None)
        return

    def _set_key_bindings(self, data):
        print '_set_key_bindings'
        for action_name, key_names in data.items():
            key_name = key_names[0]
            print '\t', key_name
            keys = tuple()
            for index, key in enumerate(key_name.split(' + ')):
                if key in BWKeyBindings.keyAliases:
                    key_code = BWKeyBindings.keyAliases[key][0]
                else:
                    key_code = BigWorld.stringToKey(key)
                keys += (key_code,)

            BWPersonality.settings.keyBindingsOptionsHandler(action_name, 0, keys)

        BWPersonality.GUICore.key_binding_changed(data)
        if BigWorld.player().__class__.__name__ == 'PlayerAvatar':
            BigWorld.player().UpdateQuickBar()
            BigWorld.player().UpdateWeaponIcon()

    def _rotation(self, data):
        """\xd0\x9a\xd0\xb0\xd0\xb6\xd0\xb4\xd0\xbe\xd0\xb9 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb9 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb5 \xd0\xb2\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd1\x8e\xd1\x89\xd1\x83\xd1\x8e \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8e."""

        def dct_value_to_int(dct):
            """\xd0\x9c\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xba\xd1\x83 \xd0\xbd\xd0\xb0 \xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd0\xbe \xd0\xb2 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8."""
            for key in dct:
                value = int(dct[key])
                dct[key] = value

            return dct

        for key, value in data.items():
            if key == 'video':
                self.need_restart = True
                for key, value in data['video'].items():
                    value = dct_value_to_int(value)
                    self.video_functions[key](value)

            elif key == 'audio':
                for key, value in data['audio'].items():
                    self.audio_functions[key](value)

            elif key == 'keybinds':
                self._set_key_bindings(value)
            elif key == 'mouse':
                for key, value in data['mouse'].items():
                    if key == 'invert':
                        value = int(value)
                    self.mouse_functions[key](value)

            elif key == 'gui':
                for key, value in data['gui'].items():
                    self.gui_functions[key](value)


class ActionsWithAccount(object):
    """\xd0\xa4\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xbb \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xbf\xd0\xb5\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb9 \xd1\x81 \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xbe\xd0\xbc."""

    def __init__(self, receiver):
        self._receiver = receiver
        self._play_game_coroutine = None
        self._full_update_data = {}
        self._char_menu_mode = 'main'
        return

    def all_characters_info(self):
        """\xd0\x98\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd0\xbe \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x85."""
        player = BigWorld.player()
        if not player:
            return
        elif isinstance_ext(player, 'PlayerAvatar'):
            return
        else:
            chars = player.characterList
            lst = []
            for i, char in enumerate(chars):
                dct = {'name': char['name'],
                 'id': i,
                 'is_old': char['version'] < Constants.LEVEL1,
                 'last_space': getLokalizedSpaceNameByName(char['last_space']),
                 'last_money': char['last_money']}
                additional_keys = ('deletion_remaining_time',)
                for key in additional_keys:
                    dct[key] = char[key]

                lst.append(dct)

            current_id = BWPersonality.game.char_select_mgr.selected_id
            if current_id is None:
                last_name = player.lastCharacterName
                for i, char in enumerate(chars):
                    if char['name'] == last_name:
                        current_id = i
                        break
                else:
                    current_id = 0

            return {'list': lst,
             'currentId': current_id}

    def get_characters_count(self):
        player = BigWorld.player()
        if isinstance_ext(player, 'PlayerAvatar'):
            return 0
        return len(player.characterList)

    def create_new_character(self):
        """\xd0\x9e\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6."""
        BWPersonality.GUICore.charMakerEvent(CHAR_MAKER.EVENT_FINISH, {})

    def update_old_chatacter(self):
        """\xd0\xa8\xd0\xbb\xd1\x91\xd1\x82 \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xb0 \xd0\xb2 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe"""
        BWPersonality.GUICore.charMakerEvent(CHAR_MAKER.EVENT_MIGRATE, {})

    def donate_face_change(self):
        """\xd0\x97\xd0\xb0\xd0\xba\xd0\xbe\xd0\xbd\xd1\x87\xd0\xb8\xd0\xbb \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbb\xd0\xb8\xd1\x86\xd0\xb0"""
        BWPersonality.GUICore.charMakerEvent(CHAR_MAKER.EVENT_DONATE_FACE_EDIT, {})

    def donate_paint_change(self):
        if BigWorld.player().is_admin_and_f2():
            BWPersonality.GUICore.menu_paint_screen.show()
        else:
            BWPersonality.GUICore.show_equip_paint_screen()

    def open_survey(self):
        surveys.open_surv()

    def hide_survey(self):
        self._receiver.send_to_flashscript('hideSurvey')

    def show_survey(self, title, description, end_time, icon_path = '../soGUI/maps/Login/test.dds'):
        data = {}
        data['title'] = title
        data['description'] = description
        data['icon_path'] = icon_path
        data['end_time'] = end_time
        self._receiver.send_to_flashscript('callSurvey', data)

    def cancel(self):
        """\xd0\x9e\xd1\x82\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0"""
        BWPersonality.GUICore.charMakerEvent(CHAR_MAKER.EVENT_CANCEL, {})

    def check_valid_nickname(self, nick):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbd\xd0\xb8\xd0\xba \xd0\xbd\xd0\xb0 \xd0\xb2\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb4\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c."""
        data = {'nick': nick['nick'].decode('utf-8')}
        BWPersonality.GUICore.charMakerEvent(CHAR_MAKER.EVENT_NICKNAME, data)

    def set_face_mode(self, value):
        BigWorld.player().dummy.set_face_mode(value)

    def show_need_pay_window(self):
        self._receiver.send_to_flashscript('show_need_pay_window')

    def try_pay(self):
        raise Exception

    def generate_random_face_in_flash(self):
