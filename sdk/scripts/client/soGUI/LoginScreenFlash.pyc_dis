    def play_game(self, data):
        """\xd0\x97\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb3\xd1\x80\xd1\x83."""
        if self._play_game_coroutine:
            return
        BWPersonality.music.stopAllMusic()
        sounds.playSound('ui/start_game')
        print "play_game, sounds.playSound('ui/start_game')"

        @BWCoroutine
        def play_game_coroutine():
            account = BigWorld.player()
            if not account.can_play:
                print 'can_play false'
                self._play_game_coroutine = None
                return
            else:
                if account.dummy:
                    account.dummy.on_play_game()
                yield BWWaitForPeriod(0)
                BWPersonality.game.showDummyLoadingGUI()
                char_select_mgr = BWPersonality.game.char_select_mgr
                try:
                    yield BWWaitForCondition(lambda : char_select_mgr.selected_id is not None, 5.0, 0)
                except BWCoroutineTimeoutException:
                    print 'char_select_mgr.selected_id is None'
                    self._play_game_coroutine = None
                    BigWorld.disconnect()
                    return

                char_name = char_select_mgr.chars[char_select_mgr.selected_id]
                account.base.beginPlay(char_name)
                BWPersonality.GUICore.showLoginFlash(False)
                print 'account.base.beginPlay', [char_name]
                yield BWWaitForPeriod(2.0)
                self._play_game_coroutine = None
                return

        BWPersonality.GUICore.on_play_game_click()
        self._play_game_coroutine = play_game_coroutine()
        self._play_game_coroutine.run()

    def restore_character(self):
        """\xd0\x92\xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0 \xd0\xbe\xd0\xb6\xd0\xb8\xd0\xb4\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb3\xd0\xbe \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f."""
