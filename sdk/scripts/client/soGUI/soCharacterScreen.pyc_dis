text_color_highlight = u'<color=255255255255>'
main_color = colorCodes.tf3_gray_text

def hightlight(text, *params):
    params = list(params)
    params[0] = text_color_highlight + unicode(params[0])
    return text.format(*params) + main_color


def wrap_hightlight(text):
    return text_color_highlight + text + main_color


