    def setupTabBtns(self):
        width = 588.0
        button_width = width / 4

        def create_tab(x_pos, active, tab_type, name):
            btn = soButtonWFT(GUI.Window(''))
            comp = btn.component
            comp.verticalPositionMode, comp.horizontalPositionMode = ('PIXEL', 'PIXEL')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.width, comp.height = button_width, 21
            comp.position = (x_pos, 30, 0.4)
            btn.buttonStyle = soButton.TOGGLEBUTTON_STYLE
            btn.initVSC('soGUI/elements/tab_2.xml')
            btn.onBound()
            btn.buttonActive = active
            btn._updateVisualState()
            btn.onClick = partial(self._switchToTab, tab_type)
            comp.label.text = self.tabLabels[tab_type]
            self.component.addChild(comp, name)

        create_tab(button_width * 0, True, self.TAB_EQUIPMENT, 'equipmentTab')
        create_tab(button_width * 1, False, self.TAB_ACHIVS, 'achivesTab')
        create_tab(button_width * 2, False, self.TAB_PVPSTATS, 'pvpTab')
        create_tab(button_width * 3, False, self.TAB_DEFENCE, 'statDefenceTab')

    def update_equipment_slots(self, force_update = False):
        p = BigWorld.player()
        for slot in self._equipment_slots:
            if slot.itemData:
                cur_item_id = slot.itemData['complexItemID']
                if not EST.get_slot_data(p, slot.slot_type)['itemID']:
                    needed_item_id = None
                    update_lock = True
                    if needed_item_id:
                        if cur_item_id != needed_item_id or force_update and needed_item_id:
                            item = ItemsUtils.GetComplexItemByID(p, needed_item_id)
                            if not item:
                                print "soCharacterScreen (ERROR): can't update euqipment slots, bad item", needed_item_id
                                return
                            slot.setContent(item)
                            slot_types = ItemsCatalog.GetItemParam(item['complexItemType'])['SlotType']
                            slot_type = slot_types and slot_types[0]
                            slot.set_secondary(slot_type != slot.slot_type)
                            update_lock = False
                    elif cur_item_id:
                        slot.setContent(None)
                        update_lock = False
                    update_lock and slot.haveItem() and slot.lockSlot(BigWorld.player().ItemLocked(slot.itemData))
                else:
                    slot.lockSlot(True)

        return

    def lockGadgetSlots(self, lock = False, count = 0):
        _gadget_slots = copy(self.GADGET_SLOTS)
        if not count:
            lock = False
        if lock:
            _gadget_slots.reverse()
        for i, slotIndex in enumerate(_gadget_slots):
            if lock and i >= count:
                break
            self.slots[slotIndex].lockSlot(lock)

    def getLockedGadgetIds(self, count):
        _ids = []
        _gadget_slots = copy(self.GADGET_SLOTS)
        _gadget_slots.reverse()
        for i, slotIndex in enumerate(_gadget_slots):
            if i >= count:
                break
            _id = self.slots[slotIndex].itemData.get('complexItemID', None)
            if _id:
                _ids.append(_id)

        return _ids

    def upldateLockItems(self):
        for slot in self.slots:
            self.slots[slot].updateLock()

        self._updateLockGadgets()

    def partially_update(self, data):
        if data.has_key('items'):
            self._partiallyUpdateItems(data['items'])
        if data.has_key('attachSlots'):
            self._partiallyUpdateAttachSlots(data['attachSlots'])

    def _partiallyUpdateItems(self, items):
        for slot in itertools.chain(self.slots.values(), self._equipment_slots):
            if not slot.haveItem():
                continue
            for item in items:
                if item['complexItemID'] != slot.itemData['complexItemID']:
                    continue
                slot.setContent(item)

    def _updateItems(self, data):
        for slot_id, item in data.items():
            if slot_id in self.slots:
                self.slots[slot_id].setContent(item)

        self._updateLockGadgets()

    def _partiallyUpdateAttachSlots(self, items):
        for slot_id in self._visible_attaches_slots:
            slot = self._visible_attaches_slots[slot_id]
            if not slot.haveItem():
                continue
            for item in items:
                if item['complexItemID'] != slot.itemData['complexItemID']:
                    continue
                slot.setContent(item)

    def _updateAttachSlots(self, data):
        for slot in self._visible_attaches_slots.values():
            slot.component.visible = False

        for slot_id, item in data.items():
            if slot_id in self._visible_attaches_slots:
                self._visible_attaches_slots[slot_id].component.visible = True
                self._visible_attaches_slots[slot_id].setContent(item)

    def _updateName(self):
        self.component.charName.text = self._char_name + BWPersonality.get_action_key('ToggleCharacterGUI')

    def _updatePvP(self, data):
        pvpWnd = getattr(self.component, 'wnd' + str(self.TAB_PVPSTATS))
        getattr(pvpWnd, 'elem_1').text = lc('soCharacterScreen.soGUI.killedInPVP')
        getattr(pvpWnd, 'val_1').text = str(data[0])
        getattr(pvpWnd, 'val_1').visible = 1
        getattr(pvpWnd, 'elem_1').visible = 1
        getattr(pvpWnd, 'elem_2').text = lc('soCharacterScreen.soGUI.killedInPK')
        getattr(pvpWnd, 'val_2').text = str(data[1])
        getattr(pvpWnd, 'val_2').visible = 1
        getattr(pvpWnd, 'elem_2').visible = 1
        getattr(pvpWnd, 'elem_3').text = lc('soCharacterScreen.soGUI.karma')
        getattr(pvpWnd, 'val_3').text = str(data[2])
        getattr(pvpWnd, 'val_3').visible = 1
        getattr(pvpWnd, 'elem_3').visible = 1

    def _setPvPExpireTime(self, t):
        self.pvpFlagTimer = t
        if self.pvpTicker:
            self.pvpTicker.stop()
        self.pvpTicker = self.pvpFlagTicker()
        self.pvpTicker.run()

    def _switchToTab(self, tab):
        self.component.equipmentTab.script.buttonActive = False
        self.component.pvpTab.script.buttonActive = False
        self.component.statDefenceTab.script.buttonActive = False
        self.component.achivesTab.script.buttonActive = False
        for i in xrange(self.TAB_COUNT):
            self.get_comp(i).visible = False

        self.get_comp(tab).visible = True
        if tab is self.TAB_EQUIPMENT:
            self.component.equipmentTab.script.buttonActive = True
        elif tab is self.TAB_PVPSTATS:
            self.component.pvpTab.script.buttonActive = True
        elif tab is self.TAB_DEFENCE:
            self.component.statDefenceTab.script.buttonActive = True
            self.updateDefenceWindow()
        elif tab is self.TAB_ACHIVS:
            self.component.achivesTab.script.buttonActive = True
        self.component.equipmentTab.script._updateVisualState()
        self.component.pvpTab.script._updateVisualState()
        self.component.statDefenceTab.script._updateVisualState()
        self.component.achivesTab.script._updateVisualState()
        script = self.get_script(self.currentTab)
        if hasattr(script, 'on_hide'):
            script.on_hide()
        self.currentTab = tab
        script = self.get_script(self.currentTab)
        if hasattr(script, 'on_show'):
            script.on_show()

    def get_comp(self, index):
        return getattr(self.component, 'wnd' + str(index))

    def get_script(self, index):
        return self.get_comp(index).script

    def updateSlotsColour(self):
        for slot in self._equipment_slots:
            slot.update_item_color()

        for slot in self._visible_attaches_slots.values():
            slot.update_item_color()

        for slot in self.slots.values():
            slot.update_item_color()

    def update(self, force_update = False):
        data = BWPersonality.GUICore.characterScreenDataSection
        if not data:
            return
        if data.has_key('items'):
            try:
                self._updateItems(data['items'])
            except:
                import traceback
                traceback.print_exc()

        if data.has_key('displayName'):
            self._char_name = data['displayName']
            self._updateName()
        if data.has_key('pvp'):
            self._updatePvP(data['pvp'])
        if data.has_key('attachSlots'):
            self._updateAttachSlots(data['attachSlots'])
        self._updateLockGadgets()
        self.update_equipment_slots(force_update=force_update)

    def _updateLockGadgets(self):
        p = BigWorld.player()
        if not p:
            return
        count = ItemsUtils.MAX_GADGET_EQUIP - ItemsUtils.GetMaximumGadgetSlots(p)
        if count >= 0:
            self.lockGadgetSlots(True, count)
        else:
            self.lockGadgetSlots(False, count)

    def updateDefenceWindow(self):
        text = colorCodes.tf3_gray_text
        entity = BigWorld.player()
        if not entity or not entity.__class__.__name__ == 'PlayerAvatar':
            self.defenceTxt.setText(u'')
            return
        text += lc('soCharacterScreen.soGUI.STATS_LIST') + u'\n\n'
        text += lc('soCharacterScreen.soGUI.HP_VALUE') + wrap_hightlight('  %.1f  /  %.1f\n' % (entity.GetStatValue(Stats.ch_HitPoints), entity.GetStatValue(Stats.ch_MaxHitPoints)))
        text += lc('soCharacterScreen.soGUI.HP_REGEN') + wrap_hightlight(u'  %.1f\n' % entity.GetStatValue(Stats.ch_HitPointsRegeneration))
        text += lc('soCharacterScreen.soGUI.STAMINA_VALUE') + wrap_hightlight(u'  %.1f  /  %.1f\n' % (entity.GetStatValue(Stats.ch_Stamina), entity.GetStatValue(Stats.ch_MaxStamina)))
        text += lc('soCharacterScreen.soGUI.STAMINA_REGEN') + wrap_hightlight(u'  %.1f\n' % entity.GetStatValue(Stats.ch_StaminaRegeneration))
        text += lc('soCharacterScreen.soGUI.SPEED_VALUE') + wrap_hightlight(u'  %.1f\n' % entity._last_maxSpeed)
        text += lc('soCharacterScreen.soGUI.MAX_WEIGHT_VALUE') + wrap_hightlight(u'  %.1f\n' % entity.GetStatValue(Stats.ch_MaxWeight))
        text += lc('soCharacterScreen.soGUI.HUNGRY_VALUE') + wrap_hightlight(u'  %.1f%%\n' % (entity.hungry * 100))
        text += lc('soCharacterScreen.soGUI.THIRST_VALUE') + wrap_hightlight(u'  %.1f%%\n' % (entity.thirst * 100))
        text += '\n\n'
        text += lc('soCharacterScreen.soGUI.DEFENCES_LIST') + '\n\n'
        defenc = {}
        try:
            defenc = entity.GetStatValue(Stats.ch_Defence)
        except:
            print '-------'
            traceback.print_exc()
            print '-------'

        effects = entity.current_effects
        sturdiness_mod = 0
        for effect_id, data in effects.items():
            for sub in EffectUtils.getEffect(effect_id)['passive']:
                if sub['className'] == 'SturdinessMod':
                    sturdiness_mod += sub['value'] * data['stacks']

        def getBodyDef(body_part):
            res = u''
            part_defence_dict = defenc.get(body_part, {})
            sturdiness = sturdiness_mod + entity.get_perk_action_val('STURDINESS')
            armor_item_type, armor_item_id = ItemsUtils.get_armor_on_body_zone(entity, body_part)
            if armor_item_type:
                item = ItemsUtils.GetComplexItemByID(entity, armor_item_id)
                param = ItemsCatalog.GetItemParam(armor_item_type)
                cond_ratio = ItemsUtils.GetItemConditionRatio(entity, item)
                cond_ratio = min(1, cond_ratio / 0.7)
                sturdiness += int(round(param.get('bodyzone_sturdiness', {}).get(body_part, 0) * cond_ratio))
            if sturdiness:
                res += '|   + ' + hightlight(lc('Inventory.client.STURDINESS'), sturdiness) + '\n'
            for damage_type in InventoryNames.DamageNames.keys():
                if damage_type == DamageTypes.BULLET:
                    continue
                perk_defence = entity.get_perk_action_val('DEFENCE_DAMAGE_TYPE', damage_type=damage_type)
                if part_defence_dict.get(damage_type) or perk_defence:
                    defence = part_defence_dict.get(damage_type, 0) / 10
                    defence = sqrt(defence ** 2 + perk_defence ** 2)
                    defence = min(70.0, defence)
                    res += u'|   + ' + entity.GetDamageName(damage_type)
                    res += text_color_highlight
                    res += u' : %.1f%%\n' % defence
                    res += main_color

            return res

        for body_part in InventoryNames.VisibleParts:
            res = getBodyDef(body_part)
            if res:
                text += '| ' + entity.GetBodyPartName(body_part) + u' : \n'
                text += res + u'\n'

        self.defenceTxt.setText(text)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'charScreen')
        self._updateName()
        GUIPositions.show(self)
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        if self.component.statDefenceTab.script.buttonActive:
            self.updateDefenceWindow()
        self._updateLockGadgets()
        if not self.defenceTimerID:
            self.defenceTimerID = BigWorld.callback(1, self._updateRepeat)
        script = self.get_script(self.currentTab)
        if hasattr(script, 'on_show'):
            script.on_show()
        return

    def reset_position(self):
        self.component.position = (0.01, 0.02, 0.5)

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.setBestCursor()
        BigWorld.cancelCallback(self.defenceTimerID)
        self.defenceTimerID = 0
        script = self.get_script(self.currentTab)
        if hasattr(script, 'on_hide'):
            script.on_hide()

    def doReposition(self):
        self.component.position = (0.01, 0.02, 0.5)

    def _updateRepeat(self):
        self.defenceTimerID = 0
        defenceWnd = getattr(self.component, 'wnd' + str(self.TAB_DEFENCE))
        if self.component.visible and defenceWnd and defenceWnd.visible:
            self.updateDefenceWindow()
        self.defenceTimerID = BigWorld.callback(1, self._updateRepeat)

    def _slot_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DRAGENTER:
            return True
        elif event == ITSLOT.SLOTEVENT_DRAGLEAVE:
            return True
        else:
            if event == ITSLOT.SLOTEVENT_DROP:
                char_slot, invent_slot = data
                if not hasattr(invent_slot, 'itemData'):
                    return True
                if invent_slot.itemData:
                    item_type = invent_slot.itemData.get('complexItemType')
                    if getattr(char_slot, 'itemData', None):
                        char_slot_item_type = char_slot.itemData.get('complexItemType')
                        item_class = ItemsCatalog.GetItemClass(item_type)
                        item_category = ItemsCatalog.GetItemCategory(item_type)
                        player = BigWorld.player()
                        if item_class == ItemsCatalog.CLOTH:
                            if not hasattr(char_slot, 'slot_type'):
                                return False
                            BWPersonality.GUICore.inventoryEvent(INV_CONST.A_EQUIP, invent_slot.itemData, index=char_slot.slot_type)
                            return True
                        if item_class == ItemsCatalog.PART:
                            if not getattr(invent_slot, 'itemData', None):
                                return False
                            if not getattr(char_slot, 'itemData', None):
                                return False
                            BWPersonality.GUICore.inventoryEvent(INV_CONST.A_ATTACH, (invent_slot.itemData, char_slot.itemData))
                        else:
                            if isinstance(char_slot, soVisibleAttachSlot) and player and item_category in CASC.get_possible_categories(char_slot.slot_type):
                                player.equipVisibleAttach(invent_slot.itemData['complexItemID'], char_slot.slot_type)
                                return True
                            if ItemsUtils.canGreaseOilWeapon(char_slot_item_type, item_type) and player:
                                player.askStartWeaponGreaseOil(invent_slot.itemData, char_slot.itemData)
                                return True
                            if ItemsUtils.CanRepairByKit(char_slot.itemData, invent_slot.itemData) and player:
                                player.askStartItemRepair(invent_slot.itemData, char_slot.itemData)
                                return True
                            if hasattr(invent_slot, 'equipItem') and char_slot.weaponID:
                                invent_slot.equipItem(char_slot.weaponID)
                                return True
                    if event == ITSLOT.SLOTEVENT_RCLICK:
                        if data.itemData and data.itemData.get('complexItemID') > 0:
                            BWPersonality.GUICore.charScreenEvent(self.EVENT_CONTEXT, data.itemData)
                        return True
                    if event == ITSLOT.SLOTEVENT_MOUSEENTER:
                        if BWPersonality.GUICore.repairMode and data.haveItem():
                            MouseShaper.set_shape('repair')
                        BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_SHOW)
                        return True
                    if event == ITSLOT.SLOTEVENT_MOUSELEAVE:
                        MouseShaper.set_shape('arrow')
                        BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_HIDE)
                        return True
                    if event == ITSLOT.SLOTEVENT_DBLCLICK:
                        BWPersonality.GUICore.charScreenEvent(self.EVENT_USE, data.itemData)
                        return True
                    event == ITSLOT.SLOTEVENT_LCLICK and BWPersonality.GUICore.repairMode and BWPersonality.GUICore.charScreenEvent(self.EVENT_REPAIR, data.itemData)
                    return True
            return

    def handleDragEnterEvent(self, cmp, dragged):
        if dragged.script is None:
            return False
        elif getattr(dragged.script, 'factoryString') != 'soGUI.soInventorySlot2':
            return False
        else:
            return True

    def handleMouseLeaveEvent(self, cmp):
        if cmp in self.statLabelCmps:
            BWPersonality.GUICore.toolTipEvent(self.statLabelCmps[cmp], self.interfaceID, soToolTipComponent.EVENT_HIDE)
        return True

    def handleMouseEnterEvent(self, cmp):
        if cmp in self.statLabelCmps:
            BWPersonality.GUICore.toolTipEvent(self.statLabelCmps[cmp], self.interfaceID, soToolTipComponent.EVENT_SHOW)
        return True

    def _alignWnd(self):
        sW, sH = BigWorld.screenSize()
        psX = (sW + self.component.width) / 2.0
        psY = (sH + self.component.height) / 2.0
        self.component.position = (psX, psY, 0.5)

    def timeToString(self, secs):
        if secs < 0:
            return u''
        hours = floor(secs / 3600.0)
        minutes = floor((secs - hours * 3600.0) / 60.0)
        seconds = secs - (hours * 3600.0 + minutes * 60.0)
        outH = str(int(hours)) if hours > 9 else u'0' + str(int(hours))
        outM = str(int(minutes)) if minutes > 9 else u'0' + str(int(minutes))
        outS = str(int(seconds)) if seconds > 9 else u'0' + str(int(seconds))
        return outH + u':' + outM + u':' + outS

    @BWMemberCoroutine
    def pvpFlagTicker(self):
        pvpWnd = getattr(self.component, 'wnd' + str(self.TAB_PVPSTATS))
        pvpWnd.val_2_1.text = self.timeToString(self.pvpFlagTimer)
        while self.pvpFlagTimer:
            yield BWWaitForPeriod(1.0)
            self.pvpFlagTimer -= 1
            pvpWnd.val_2_1.text = self.timeToString(self.pvpFlagTimer)

        pvpWnd.val_2_1.text = self.timeToString(self.pvpFlagTimer)
        self.pvpTicker = None
        return

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('hintBox', 'onClick')
    def onHintBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        BWPersonality.GUICore.openGUIHelp('soCharacterScreen')

    def stopDragging(self):
        GUIPositions.stopDragging(self)
        DraggableComponent.stopDragging(self)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)