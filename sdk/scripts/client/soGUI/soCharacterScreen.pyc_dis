class soEquipSlot(soCharacterSlot):

    def handleDropEvent(self, comp, dropped):
        if dropped.script is None:
            return False
        elif getattr(dropped.script, 'factoryString') != 'soGUI.soInventorySlot2':
            return False
        else:
            if self.itemData and dropped.script.itemData:
                if BigWorld.player().charge_gadget_with_item(self.itemData, dropped.script.itemData):
                    return True
            return soCharacterSlot.handleDropEvent(self, comp, dropped)


class soGadgetSlot(soCharacterSlot):

    def __init__(self, component, slotIndex, itemData = None):
        soCharacterSlot.__init__(self, component, slotIndex, itemData)
        self.component.dropFocus = True

    def lockSlot(self, doLock):
        soItemSlot.lockSlot(self, doLock)
        if self.locked:
            if self.fake:
                self.component.itemIcon.colour = (255, 255, 255, 255)
                self.component.itemIcon.texture = LOADED_TEXTURES.get(LOCK_ICON, None)
            else:
                if self.fake_icon:
                    self.component.itemIcon.texture = self.fake_icon
                self.component.itemIcon.colour = (125, 125, 125, 255)
        else:
            self.component.itemIcon.colour = (255, 255, 255, 255)
        return

    def handleDragEnterEvent(self, comp, dragged):
        return True

    def handleDragLeaveEvent(self, comp, dragged):
        return True

    def on_out_screen_drop(self):
        self.unequip()

    def handleDropEvent(self, comp, dropped):
        if dropped.script is None:
            return False
        elif getattr(dropped.script, 'factoryString') != 'soGUI.soInventorySlot2':
            return False
        elif self.checkChargeEquippedItem(self.itemData, dropped.script.itemData):
            return True
        else:
            dropped.script.equipItem()
            return True

    def checkChargeEquippedItem(self, item_battery, item_charge):
        if not item_battery or not item_charge:
            return False
        if BigWorld.player().charge_gadget_with_item(item_battery, item_charge):
            return True
        return False


