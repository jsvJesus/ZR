        cmp.materialFX = 'BLEND'
        cmp.height = 375
        cmp.width = 800
        cmp.position = (3, 50, 0.8)
        eqWnd.addChild(cmp, 'dFrame')
        cmp.dropFocus = True
        cmp.crossFocus = True
        cmp.dragFocus = True
        cmp.texture = LOADED_TEXTURES.get('soGUI/frame/tt_frame_2.dds')
        cmp.script = self
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 554
        cmp.height = 531
        cmp.position = (16, 51, 0.7)
        eqWnd.addChild(cmp, 'charDoll')
        cmp.texture = LOADED_TEXTURES.get('soGUI/frame/equipment/background.dds')
        cmp = GUI.Window('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 570
        cmp.height = 93
        cmp.position = (4, 510, 0.1)
        eqWnd.addChild(cmp, 'gadgetsWnd')
        cmp.dropFocus = True
        cmp.script = self

    def setupSlots(self):
        eqWnd = self.component
        posMap = {soCharacterScreen2.INDEX_PRIMARY: (330, 288, 0.5),
         soCharacterScreen2.INDEX_PRIMARY2: (331, 356, 0.5),
         soCharacterScreen2.INDEX_SECONDARY: (191, 356, 0.5)}
        slot_index = 105
        _equipment_slots = []

        def create_slot(slot_type, position):
            slot = soEquipSlot(GUI.Window(), slot_type)
            slot.component.position = position
            slot.slotEvent = self.slot_handler
            slot.slot_type = slot_type
            eqWnd.addChild(slot.component)
            _equipment_slots.append(slot)

        _visible_attaches_slots = {}

        def create_attaches_slot(slot_type):
            slot = soVisibleAttachSlot(GUI.Window(), slot_type)
            position = CASC.get_slot_position(slot_type)
            slot.component.position = position
            slot.slotEvent = self.slot_handler
            slot.slot_type = slot_type
            slot.visible = False
            eqWnd.addChild(slot.component)
            _visible_attaches_slots[slot_type] = slot

        for i in xrange(4):
            create_slot(slot_index, (158 + i * 69, 66, 0.5))
            slot_index += 1

        for j in xrange(3):
            for i in xrange(2):
                create_slot(slot_index, (21 + 68 * i, 152 + 68 * j, 0.5))
                slot_index += 1

        for j in xrange(5):
            for i in xrange(2):
                create_slot(slot_index, (434 + 68 * i, 152 + 68 * j, 0.5))
                slot_index += 1

        create_slot(slot_index, (191, 220, 0.5))
        slot_index += 1
        create_slot(slot_index, (191, 288, 0.5))
        slot_index += 1
        create_slot(slot_index, (330, 152, 0.5))
        slot_index += 1
        create_slot(133, (330, 220, 0.5))
        for slot_type in CASC.CLOTH_ATTACH_SLOTS_CONFIG.keys():
            create_attaches_slot(slot_type)

        slots = {}
        for slotIndex in posMap.keys():
            slot = self.slotClass(GUI.Window(), slotIndex)
            slot.weaponID = soCharacterScreen2.WEPONIDMAP.get(slotIndex, 0)
            slot.slotEvent = self.slot_handler
            cmp = slot.component
            cmp.position = posMap[slotIndex]
            eqWnd.addChild(cmp, 'slot' + str(slotIndex))
            slots[slotIndex] = slot

        for i, slotIndex in enumerate(soCharacterScreen2.GADGET_SLOTS):
            slot = soGadgetSlot(GUI.Window(), slotIndex)
            slot.slotEvent = self.slot_handler
            cmp = slot.component
            cmp.position = (16 + i * 69, 0, 0.3)
            eqWnd.gadgetsWnd.addChild(cmp, 'slot' + str(slotIndex))
            slots[slotIndex] = slot

        return (slots, _equipment_slots, _visible_attaches_slots)


class soCharacterScreen2(PyGUIBase, DraggableComponent, GUIPositions):
    factoryString = 'soGUI.soCharacterScreen2'
    TAB_COUNT = 4
    TAB_EQUIPMENT, TAB_ACHIVS, TAB_PVPSTATS, TAB_DEFENCE = xrange(TAB_COUNT)
    INDEX_HEAD = 1
    INDEX_BACKPACK = 4
    INDEX_PALMS = 5
    INDEX_ARMOR = 6
    INDEX_CHEST = 7
    INDEX_LEGS = 8
    INDEX_FEET = 9
    INDEX_GADGET1 = 10
    INDEX_GADGET2 = 11
    INDEX_GADGET3 = 12
    INDEX_GADGET4 = 13
    INDEX_GADGET5 = 14
    INDEX_GADGET6 = 15
    INDEX_GADGET7 = 16
    INDEX_GADGET8 = 17
    INDEX_FACE = 16
    INDEX_PRIMARY = 50
    INDEX_PRIMARY2 = 51
    INDEX_SECONDARY = 52
    GADGET_SLOTS = [INDEX_GADGET1,
     INDEX_GADGET2,
     INDEX_GADGET3,
     INDEX_GADGET4,
     INDEX_GADGET5,
     INDEX_GADGET6,
     INDEX_GADGET7,
     INDEX_GADGET8]
    WEPONIDMAP = {INDEX_PRIMARY: ItemsUtils.getWeaponSlotIDByName('PrimarySlot'),
     INDEX_PRIMARY2: ItemsUtils.getWeaponSlotIDByName('Primary2Slot'),
     INDEX_SECONDARY: ItemsUtils.getWeaponSlotIDByName('SecondarySlot')}
    INDEX_NUM = 16
    EVENT_UNEQUIP = 0
    EVENT_USE = 1
    EVENT_CONTEXT = 2
    EVENT_REPAIR = 3
    CHARSTATID_STRENGTH = 0
    CHARSTATID_INTELLECT = 1
    CHARSTATID_DEXTIRITY = 2
    CHARSTATID_CONSTITUTION = 3
    CHARSTATID_PERCEPTION = 4
    CHARSTATID_PSIONICS = 5
    charStatsColMap = {'normal': Vector4(175, 166, 112, 255),
     'lowered': Vector4(145, 65, 50, 255),
     'buffed': Vector4(100, 140, 25, 255)}
    tabLabels = {TAB_EQUIPMENT: lc('soCharacterScreen.soGUI.EQUIPMENT_TAB_LABEL'),
     TAB_ACHIVS: lc('soCharacterScreen.soGUI.ACHIVS_TAB_LABEL'),
     TAB_PVPSTATS: lc('soCharacterScreen.soGUI.PVP_STATISTICS_TAB_LABEL'),
     TAB_DEFENCE: lc('soCharacterScreen.soGUI.STATS_TAB')}

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, 1, 1, 1)
        GUIPositions.__init__(self)
        self.defenceTimerID = 0
        component.script = self
        self.interfaceID = BWPersonality.GUICore.GUI_ID_CHARSCREEN
        self.slots = {}
        self.statLabelCmps = {}
        self.pvpFlagTimer = 0
        self._char_name = u''
        self.pvpTicker = None
        self.currentTab = self.TAB_EQUIPMENT
        self.statsTab = None
        self.setupRoot()
        right_slots_border = 588
        bottom_slots_border = 438
        bottom_space = 192
        self.component.width = right_slots_border
        self.component.height = bottom_slots_border + bottom_space
        self.setupContent()
        self.setupTabBtns()
