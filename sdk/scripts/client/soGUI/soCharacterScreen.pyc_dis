    def on_out_screen_drop(self):
        self.unequip()

    def handleDropEvent(self, comp, dropped):
        if dropped.script is None:
            return False
        elif getattr(dropped.script, 'factoryString') != 'soGUI.soInventorySlot2':
            return False
        else:
            return soItemSlot.handleDropEvent(self, comp, dropped)

    def update_frameCmp(self):
        self.component.frameCmp.visible = self.haveItem()

    def _applyItemData(self):
        self.cancelForceRedrawAfter()
        self.update_frameCmp()
        self.component.oil.visible = False
        if self.haveItem():
            item_type = self.itemData['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            item_params = ItemsCatalog.GetItemParam(item_type)
            if not ItemsUtils.GetIconName(self.itemData):
                iconName = 'nottexture.dds'
                if BWPersonality.GUICore.iconTextures is not None:
                    if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                        if BWPersonality.GUICore.iconTextures.has_key(iconName):
                            self.component.itemIcon.texture = BWPersonality.GUICore.iconTextures[iconName]
                        else:
                            self.component.itemIcon.textureName = iconName
                else:
                    self.component.itemIcon.textureName = iconName
                self.fake_icon = self.component.itemIcon.texture
                countStr = ItemsUtils.GetDisplayValue(self.itemData)
                fake = BigWorld.player().IsItemFake(self.itemData)
                item_state = ItemsUtils.GetItemConditionRatio(BigWorld.player(), self.itemData)
                if item_state <= 0.5 and not fake:
                    self.component.itemBroken.visible = True
                else:
                    self.component.itemBroken.visible = False
                if item_class == ItemsCatalog.ARTIFACT:
                    depleet_time = ItemsUtils.GetArtefactDepleetionTime(self.itemData, item_params, BWPersonality.gpd.time_diff)
                    inconstantParam = ItemsUtils.GetComplexItemInconstanParams(self.itemData)
                    if inconstantParam.get(ItemsCatalog.INC_ARTEFACT_DEAD, 0) or depleet_time < 0.0 or depleet_time is None:
                        self.component.itemBroken.visible = True
                    else:
                        self.component.itemBroken.visible = False
                item_lock = BigWorld.player().ItemLocked(self.itemData)
                self.component.marker_on.visible = BigWorld.player().it_is_active_gadget(self.itemData['complexItemID'])
                self.component.itemCount.text = countStr
                if item_class == ItemsCatalog.WEAPON:
                    oil_time_left = ItemsUtils.getGreaseOilWeaponLeftTime(self.itemData, diffTime=BWPersonality.gpd.time_diff)
                    self.component.oil.visible = oil_time_left and True
                    self.forceRedrawAfter(oil_time_left + 3.0)
            self.fakeSlot(fake)
            self.lockSlot(item_lock)
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemCount.text = ''
            self.fake_icon = None
            self.fakeSlot(True)
            self.lockSlot(True)
            self.component.itemBroken.visible = False
            self.component.marker_on.visible = False
        self.dragProxy.texture = self.component.itemIcon.texture
        return

    def updateLock(self):
        if self.haveItem():
            item_lock = BigWorld.player().ItemLocked(self.itemData)
            fake = BigWorld.player().IsItemFake(self.itemData)
            self.fakeSlot(fake)
            self.lockSlot(item_lock)
        else:
            self.fakeSlot(True)
            self.lockSlot(True)

    def unequip(self):
        BWPersonality.GUICore.charScreenEvent(soCharacterScreen2.EVENT_UNEQUIP, self.itemData)

    def equipItem(self, *e):
        pass

    def onDragStart(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def handleDragStartEvent(self, cmp):
        if self.fake:
            return False
        handled = soItemSlot.handleDragStartEvent(self, cmp)
        return bool(handled)

    def onDragStop(self):
        self.dragProxy.visible = False
        return True

    def fakeSlot(self, isFake = False):
        self.fake = isFake
        self.update_item_color()

    def toActionBar(self, slotN, slot_element = None):
        prev_item_id = 0
        prev_item_type = 0
        BWPersonality.GUICore.inventoryEvent(INV_CONST.A_TOQUICKBAR, [self.itemData,
         slotN,
         prev_item_id,
         prev_item_type])

    def lockSlot(self, doLock):
        soItemSlot.lockSlot(self, doLock)
        self.update_item_color()

    def set_secondary(self, secondary):
        self._secondary = secondary
        self.update_item_color()

    def update_item_color(self):
        if self.itemData and self.itemData.get('error_item', False):
            self.component.itemIcon.colour = (255, 100, 100, 100)
        elif self.locked:
            self.component.itemIcon.colour = (125, 125, 125, 255)
        elif self.fake:
            self.component.itemIcon.colour = (255, 255, 255, 128)
        elif self._secondary:
            self.component.itemIcon.colour = (255, 255, 255, 60)
        elif BigWorld.player() and BigWorld.player().isFadedItem(self.itemData):
            self.component.itemIcon.colour = LOCKED_COLOR
        else:
            self.component.itemIcon.colour = (255, 255, 255, 255)

    def handleMouseButtonEvent(self, cmp, event):
        if not event.isMouseButton():
            return False
        if event.isKeyDown():
            if event.key == KEY_LEFTMOUSE or event.key == KEY_RIGHTMOUSE:
                self.pressed = True
                if BigWorld.time() - self.lastPressed <= BWPersonality.GUICore.mouseDoubleClickSpeed:
                    self.onDblClick()
                self.lastPressed = BigWorld.time()
        if event.isKeyUp() and self.pressed:
            if event.key == KEY_LEFTMOUSE:
                self.onLClick()
            elif event.key == KEY_RIGHTMOUSE and not self.locked:
                self.onRClick()
        return True


