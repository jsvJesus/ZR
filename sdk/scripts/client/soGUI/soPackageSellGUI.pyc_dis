    def rewardSlotHandler(self, event, data):
        if event == ITSLOT.SLOTEVENT_MOUSEENTER:
            if isinstance(data, soPackageRewardSlot):
                BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_SHOW)
                return True
        if event == ITSLOT.SLOTEVENT_MOUSELEAVE:
            if isinstance(data, soPackageRewardSlot):
                BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_HIDE)
                return True
        if event == ITSLOT.SLOTEVENT_RCLICK:
            if isinstance(data, soPackageRewardSlot):
                BWPersonality.GUICore.packageSellEvent(PACKAGE_SELL.EVENT_ITEMCONTEXT, [data.itemData, PACKAGE_SELL.REWARD_ITEM])
                return True

    def rewardItemViewHandler(self, event, data):
        return False

    def paySlotHandler(self, event, data):
        from soInventorySlot2 import soInventorySlot2
        if event == ITSLOT.SLOTEVENT_DRAGENTER:
            if isinstance(data[1], soInventorySlot2):
                return True
        if event == ITSLOT.SLOTEVENT_DROP:
            if isinstance(data[1], soInventorySlot2):
                BWPersonality.GUICore.packageSellEvent(EVENT_ITEMADD, data[1].itemData)
        if event == ITSLOT.SLOTEVENT_MOUSEENTER:
            if isinstance(data, soPackagePaySlot):
                BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_SHOW)
                return True
        if event == ITSLOT.SLOTEVENT_MOUSELEAVE:
            if isinstance(data, soPackagePaySlot):
                BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_HIDE)
                return True
        if event == ITSLOT.SLOTEVENT_DBLCLICK:
            if isinstance(data, soPackagePaySlot):
                BWPersonality.GUICore.packageSellEvent(EVENT_ITEMREMOVE, data.itemData)
                return True
        if event == ITSLOT.SLOTEVENT_RCLICK:
            if isinstance(data, soPackagePaySlot):
                BWPersonality.GUICore.packageSellEvent(PACKAGE_SELL.EVENT_ITEMCONTEXT, [data.itemData, PACKAGE_SELL.PAY_ITEM])
                return True
        return False

    def payItemViewHandler(self, event, data):
        return False

    def _onPackListElem(self):
        selection = self.component.packages.script.getSelection()[-1]
        data = self.component.packages.script.getAttachment(selection)
        BWPersonality.GUICore.packageSellEvent(EVENT_PACKSELECT, data)

    def _alignWnd(self):
        invCmp = getattr(BWPersonality.GUICore.worldLayer, 'inventory', None)
        sW, sH = BigWorld.screenSize()
        if not invCmp:
            psX = (sW + self.component.width) / 2.0
            psY = (sH + self.component.height) / 2.0
            self.component.position = (psX, psY, 0.5)
            return
        else:
            iX = invCmp.position.x - invCmp.width - 10
            iY = invCmp.position.y + invCmp.height + 10
            self.component.position = (iX, iY, 0.5)
            return

    def _updatePacks(self, data):
        self.component.packages.script.clear()
        for pack in data:
            isLast = pack == data[-1]
            self.component.packages.script.addElement(pack[1], pack[0], not isLast)

    def _updateReward(self, data):
        self.component.rewardItemView.script.setItems(data)

    def _updatePay(self, data):
        self.component.payItemView.script.setItems(data)

    def update(self):
        print 'soPackageSellGUI::update'
        data = BWPersonality.GUICore.packageSellDataSection
        try:
            print data['payItems'][0].items()
        except IndexError:
            pass

        if data.has_key('hideUnaffordable'):
            if data['hideUnaffordable']:
                self.component.hideUnaffordable.script.setActive()
            else:
                self.component.hideUnaffordable.script.setInactive()
        if data.has_key('autofill'):
            if data['autofill']:
                self.component.autofill.script.setActive()
            else:
                self.component.autofill.script.setInactive()
        if data.has_key('packs'):
            self._updatePacks(data['packs'])
        if data.has_key('rewardItems'):
            self._updateReward(data['rewardItems'])
        if data.has_key('payItems'):
            self._updatePay(data['payItems'])

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'packageSell')
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        return

    def hide(self):
        sendEvent = self.component.visible
        self.component.visible = False
        if sendEvent:
            BWPersonality.GUICore.packageSellEvent(EVENT_CLOSE, None)
        BWPersonality.GUICore.setBestCursor()
        return

    @PyGUIEvent('hideUnaffordable', 'onStateChange', 0)
    @PyGUIEvent('autofill', 'onStateChange', 1)
    def onCBs(self, cbN):
        if cbN == 0:
            state = self.component.hideUnaffordable.script.isChecked()
            BWPersonality.GUICore.packageSellEvent(EVENT_HIDEUNAFFORDABLE, state)
        elif cbN == 1:
            state = self.component.autofill.script.isChecked()
            BWPersonality.GUICore.packageSellEvent(EVENT_AUTOFILL, state)

    @PyGUIEvent('buyBtn', 'onClick')
    def onBuyBtn(self):
        BWPersonality.GUICore.packageSellEvent(EVENT_BUY, None)
        return

    @PyGUIEvent('clearBtn', 'onClick')
    def onClearBtn(self):
        BWPersonality.GUICore.packageSellEvent(EVENT_CLEAR, None)
        return

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    def handleDragStartEvent(self, component):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd0\xb5\xd1\x88\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        x, y = BWPersonality.game.mcursor.position
        sW, sH = BigWorld.screenSize()
        mouse_position_x = sW * (x + 1) / 2
        mouse_position_y = sH - sH * (y + 1) / 2
        delta_x = self.component.position[0] - mouse_position_x
        delta_y = self.component.position[1] - mouse_position_y
        self._deltaposition = (delta_x, delta_y)
        self._repeatMoveToCursor()
        return True

    def handleDragStopEvent(self, component):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xbe\xd1\x82\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x88\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        BigWorld.cancelCallback(self._clbID)
        return True

    def _moveToCursor(self):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xbe\xd1\x80\xd0\xb0 \xd0\xbc\xd0\xb8\xd1\x88\xd0\xb8."""
        x, y = BWPersonality.game.mcursor.position
        sW, sH = BigWorld.screenSize()
        mouse_position_x = sW * (x + 1) / 2
        mouse_position_y = sH - sH * (y + 1) / 2
        x_position = self._deltaposition[0] + mouse_position_x
        x = min(sW, max(x_position, self.component.width))
        y_position = self._deltaposition[1] + mouse_position_y
        y = min(sH, max(y_position, self.component.height))
        self.component.position = (x, y, 1.0)

    def _repeatMoveToCursor(self):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xb8\xd0\xbd\xd1\x82\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb0\xd0\xbb."""
        if not self.component.visible:
            return
        elif self.component.parent is None:
            return
        else:
            self._moveToCursor()
            self._clbID = BigWorld.callback(0.01, self._repeatMoveToCursor)
            return