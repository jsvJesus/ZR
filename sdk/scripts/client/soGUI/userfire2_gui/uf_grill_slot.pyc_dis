import BigWorld
import BWPersonality
import GUI
import traceback
from soGUI.soItemView import soItemSlot
import ItemsUtils
from gui_const import ITEM_CACHE
from uf_result_slot import UFResultSlot

class UFGrillSlot(UFResultSlot):
    factoryString = 'UFGrillSlot'
    EMPTY_TEXTURE = BigWorld.PyTextureProvider('soGUI/maps/userfire/marker.dds')
    EMPTY_COLOUR = (255, 255, 255, 100)

    def setupContent(self):
        UFResultSlot.setupContent(self)
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.SLOTWIDTH - 4
        cmp.height = self.SLOTHEIGHT
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (2, 0, 0.8)
        cmp.visible = False
        cmp.texture = BigWorld.PyTextureProvider('soGUI/items/cooking.dds')
        self.component.addChild(cmp, 'cookingProgress')

    def updateSlot(self, data, cook_colour = None):
        self.component.cookingProgress.visible = False
        if self.itemData:
            complexItemID = long(self.itemData['complexItemID'])
            if data.has_key(complexItemID):
                perc = data.get(complexItemID, 0)
                h = int(self.SLOTHEIGHT * perc)
                self.component.cookingProgress.position = (2, max(2, h), 0.8)
                self.component.cookingProgress.visible = True