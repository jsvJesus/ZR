    def getTooltipText(self, item):
        if not item:
            return
        if not self.objId:
            return
        userfire = BigWorld.entity(self.objId)
        if not userfire:
            return
        complexItemID = item['complexItemID']
        if complexItemID not in userfire.dict_items:
            return
        perc = int(100 - userfire.dict_items[complexItemID] * 100)
        perc = min(perc, 99)
        return lc('soGUICore.soGUI.STRING_UserFire_willingness').format(perc)

    def slotHandlerPot(self, event, data):
        if event == ITSLOT.SLOTEVENT_DROP:
            if isinstance(data[1], soInventorySlot2) and data[1].itemData:
                item = data[1].itemData
                slot = data[0].slotIndex
                BWPersonality.GUICore.itemCacheUserFireEvent(ITEM_CACHE.EVENT_GIVE_COOKINGPOT, [item, slot])
                return True
            else:
                return False
        return self.slotHandler(event, data)

    def slotHandler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DRAGENTER:
            return True
        if event == ITSLOT.SLOTEVENT_DROP:
            if isinstance(data[1], soInventorySlot2) and data[1].itemData:
                BWPersonality.GUICore.itemCacheUserFireEvent(ITEM_CACHE.EVENT_GIVE, [data[1].itemData])
                return True
            else:
                return False
        if event == ITSLOT.SLOTEVENT_MOUSELEAVE:
            BWPersonality.GUICore.hideToolTip()
        if event == ITSLOT.SLOTEVENT_MOUSEENTER:
            text = ''
            if isinstance(data, UFGrillSlot):
                text = self.getTooltipText(data.itemData)
            elif isinstance(data, UFCookingPotMainSlot):
                text = self.getTooltipText(data.itemData)
            if text:
                text = colorCodes.tf3_regular_text_color + text
                BWPersonality.GUICore.showToolTip(text, '', delay=0.1)
            return True
        return False

    def itemViewHandler(self, event, data):
        from soGUI.soInventorySlot2 import soInventorySlot2
        if event == ITSLOT.SLOTEVENT_DRAGENTER:
            if isinstance(data[1], soInventorySlot2):
                return True
        if event == ITSLOT.SLOTEVENT_DROP:
            if isinstance(data[1], soInventorySlot2):
                return True
        return False

    def _setItems(self, items):
        self.component.itemView.script.setItems(items)

    def updateAccessBtns(self):
        userfire = BigWorld.entity(self.objId)
        if not userfire:
            return
        else:
            access_enabeld = self.access_enabeld()
            cookingpot = userfire.getCookingPotItem()
            if cookingpot and any(userfire.getIngredienItems()):
                enable_start = ItemsUtils.GetItemCondition(None, cookingpot) > 0
                self.component.btn_start_cooking.script.setDisabledState(not enable_start or not access_enabeld)
                self.component.take_done.script.setDisabledState(not access_enabeld)
                self.component.take_all.script.setDisabledState(not access_enabeld)
                self.component.extinguish.script.setDisabledState(not access_enabeld)
                if userfire.isPublicAcces:
                    self.component.publ_access.script.setActive()
                else:
                    self.component.publ_access.script.setInactive()
                userfire.isItemSteamBlockedInside() and self.component.publ_access.script.disable()
            else:
                self.component.publ_access.script.enable()
            empty = userfire.isEmpty()
            self.component.take_done.visible = not empty
            self.component.take_all.visible = not empty
            self.component.extinguish.visible = empty
            return

    def updateUserFireWindow(self):
        if not self.objId:
            return False
        userfire = BigWorld.entity(self.objId)
        if not userfire:
            return
        self.component.iLabel.text = userfire.name
        self.component.grillItems.script.setItems(userfire.getinTheProcessItems())
        self.component.resultItems.script.setItems(userfire.CarryingItems)
        self.component.grillItems.script.updateSlotsItems(userfire.dict_items)
        UFIngredientSlot.markAssEnable(bool(userfire.getCookingPotItem()))
        self.component.IngredientView.script.setItems(userfire.getIngredienItems())
        self.mainSlot.setContent(userfire.getCookingPotItem())
        self.updateAccessBtns()
        cooking_text = lc('soGUICore.soGUI.STRING_UserFire_start_cooking')
        if userfire.cookingpot_items['end_time']:
            cooking_text = lc('soGUICore.soGUI.STRING_UserFire_stop_cooking')
        self.component.btn_start_cooking.label.text = cooking_text
        if len(userfire.CarryingItems) >= userfire.max_slot:
            self.showUserFireMsg(lc('soGUICore.soGUI.STRING_UserFire_max_result'))

    def checkOferflow(self):
        if not self.objId:
            return False
        userfire = BigWorld.entity(self.objId)
        if not userfire:
            return
        if len(userfire.CarryingItems) >= userfire.max_slot:
            self.showUserFireMsg(lc('soGUICore.soGUI.STRING_UserFire_max_result'))

    def update(self):
        pass

    def access_enabeld(self):
        if not self.objId:
            return False
        userfire = BigWorld.entity(self.objId)
        if not userfire:
            return False
        if not userfire.isPublicAcces and userfire.pOwnerName != utils.force_unicode(BigWorld.player().name):
            return False
        return True

    def show_access_disabled(self):
        msg = lc('soGUICore.soGUI.UserFire_access_disabled')
        BWPersonality.GUICore.showToolTip(msg, autoWidth=False, style=soToolTipWindow.STYLE_FIXED_FROM_CURSOR, delay=0, delayStop=3.0, tooltipID='userfire_access')

    def show(self, objId):
        self.objId = objId
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'userFireGui')
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        self.startLoopPool()
        if not self.objId:
            return
        else:
            userfire = BigWorld.entity(self.objId)
            if not userfire:
                return
            self.updateUserFireWindow()
            self.component.publ_access.visible = False
            if userfire.pOwnerName == utils.force_unicode(BigWorld.player().name):
                self.component.publ_access.visible = True
            GUIPositions.show(self)
            self._updateCenterMsg()
            return

    def _hide(self):
        BWPersonality.GUICore.showUserFire(False)

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.setBestCursor()
        BigWorld.player().onCloseItemCache()
        self.endLoopPool()

    def startLoopPool(self):
        self.endLoopPool()
        self._hd_loop = BigWorld.callback(0.2, self._loop)

    def endLoopPool(self):
        if self._hd_loop:
            BigWorld.cancelCallback(self._hd_loop)
        self._hd_loop = None
        return

    def _loop(self):
        if not self.objId:
            return
        try:
            userfire = BigWorld.entities[self.objId]
        except KeyError:
            return self._hide()

        if not userfire:
            return self._hide()
        self.component.label_life.text = '%s/%s' % (int(userfire.left_time), userfire.max_life_time)
        perc = userfire.left_time / userfire.max_life_time
        self._slider_shader.value = perc
        percframe = max(0.5, perc)
        self.component.frame.colour = (255 * percframe,
         255 * percframe,
         255 * percframe,
         255)
        self.component.grillItems.script.updateSlotsItems(userfire.dict_items)
        self.mainSlot.updateSlot(userfire.dict_items)
        blink = True
        blink_slider = True
        if BigWorld.time() <= self._end_blink_time:
            blink = self._blink.next()
        elif perc <= 0.1:
            blink = blink_slider = self._blink.next()
        self.component.label_life.colour = LABEL_LIFE_COLOR if blink_slider else LABEL_LIFE_COLOR_D
        for comp in self.msg_text.component.textRendererPlane.children:
            comp[1].colour = LABEL_LIFE_COLOR if blink else LABEL_LIFE_COLOR_D

        self.startLoopPool()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def stopDragging(self):
        DraggableComponent.stopDragging(self)
        GUIPositions.stopDragging(self)

    def doReposition(self):
        self.updatePosition()

    def updatePosition(self):
        sW, sH = BigWorld.screenSize()
        if BWPersonality.GUICore.inventoryGUI:
            inventory = BWPersonality.GUICore.inventoryGUI.component
            self.component.position.x = inventory.position.x - 2 * float(inventory.width) / sW - 0.001
            self.component.position.y = inventory.position.y
        else:
            self.component.position = (1 - 2 * float(24 + 320) / sW, 0.33, 0.5)
        self.restrictPosition()

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self._hide()

    @PyGUIEvent('helpBox', 'onClick')
    def onHelpBox(self):
        BWPersonality.GUICore.openGUIHelp('userfire')

    @PyGUIEvent('publ_access', 'onStateChange')
    def changePublAccess(self):
        userfire = BigWorld.entities[self.objId]
        userfire.cell.setPublicAcces(self.component.publ_access.script.isChecked())

    @PyGUIEvent('btn_start_cooking', 'onClick')
    def startStopCooking(self):
        userfire = BigWorld.entities[self.objId]
        player = BigWorld.player()
        if userfire.cookingpot_items['end_time']:
            player.cell.stopCookingPot(self.objId)
        else:
            player.cell.startCookingPot(self.objId)

    @PyGUIEvent('extinguish', 'onClick')
    def _extinguish(self):
        userfire = BigWorld.entities[self.objId]
        userfire.cell.extinguish()

    @PyGUIEvent('take_all', 'onClick')
    def _take_all(self):
        userfire = BigWorld.entities[self.objId]
        player = BigWorld.player()
        player.GetItemsFromContainer(self.objId, [ item['complexItemID'] for item in userfire.CarryingItems ])
        player.GetItemsFromContainer(self.objId, [ item['complexItemID'] for item in userfire.getinTheProcessItems() ])
        player.GetItemsFromContainer(self.objId, [ item['complexItemID'] for item in userfire.getIngredienItems() if item ])
        if userfire.getCookingPotItem():
            player.GetItemsFromContainer(self.objId, [userfire.getCookingPotItem()['complexItemID']])

    @PyGUIEvent('take_done', 'onClick')
    def _take_done(self):
        userfire = BigWorld.entities[self.objId]
        player = BigWorld.player()
        player.GetItemsFromContainer(self.objId, [ item['complexItemID'] for item in userfire.CarryingItems ])

    def showUserFireErrorCode(self, err_code):
        msg = codesMsg.msg.get(err_code)
        self.showUserFireMsg(msg)

    def showUserFireMsg(self, msg, timeout = 4):
        if getattr(self, '_msg_callb', None):
            BigWorld.cancelCallback(self._msg_callb)
        self._msg_callb = BigWorld.callback(timeout, self._updateCenterMsg)
        if msg:
            self._end_blink_time = BigWorld.time() + 3.0
            self._updateCenterMsg(msg)
        return

    def _updateCenterMsg(self, msg = None):
        if not msg:
            self._end_blink_time = 0
            msg = lc('soGUICore.soGUI.STRING_UserFire_help')
        textparam = u'<font=RobotoCondensedRegular_16.font><alignment=center>'
        textparam += u'<color=#f3b757>'
        self.msg_text.setText(textparam + msg)