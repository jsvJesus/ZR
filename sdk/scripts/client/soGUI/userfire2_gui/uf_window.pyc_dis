        self.objId = None
        self._hd_loop = None
        component.script = self
        self.interfaceID = BWPersonality.GUICore.GUI_ID_ITEMCACHE
        self._blink = _blinkGEnerator()
        self._end_blink_time = 0
        self.setupRoot()
        self.setupContent()
