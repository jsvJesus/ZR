    def handleDragEnterEvent(self, cmp, dragged):
        if dragged.script is None:
            return False
        else:
            handled = self.itemViewHandler(ITSLOT.SLOTEVENT_DRAGENTER, [self, dragged.script])
            return bool(handled)

    def handleDragLeaveEvent(self, cmp, dragged):
        if dragged.script is None:
            return False
        else:
            handled = self.itemViewHandler(ITSLOT.SLOTEVENT_DRAGLEAVE, [self, dragged.script])
            return bool(handled)

    def handleDropEvent(self, cmp, dropped):
        if dropped.script is None:
            return False
        else:
            self.slotHandler(ITSLOT.SLOTEVENT_DROP, [self, dropped.script])
            return True

