# Embedded file name: ./client/soGUI/userfire2_gui/uf_result_slot.py
import BigWorld
import BWPersonality
import GUI
import traceback
from soGUI.soItemView import soItemSlot
import ItemsUtils
from gui_const import ITEM_CACHE

class UFResultSlot(soItemSlot):
    factoryString = 'UFResultSlot'
    EMPTY_TEXTURE = None
    EMPTY_COLOUR = (10, 10, 10, 70)
    FRAME = None
    SLOTWIDTH = 64
    SLOTHEIGHT = 64

    def __init__(self, component, slotIndex, itemData = None):
        soItemSlot.__init__(self, component, slotIndex, itemData, centerDProxy=True)
        component.script = self
        self.dragProxy = self.component.dragProxy
        self.proxyHolder = self.component
        self.proxyName = 'dragProxy'
        self._onDragStart = self.onDragStart
        self._onDragStop = self.onDragStop
        self._last_itemIcon_colour = None
        return

    def setupRoot(self):
        cmp = self.component
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.SLOTWIDTH
        cmp.height = self.SLOTHEIGHT
        cmp.dragFocus = True
        cmp.dropFocus = True
        cmp.crossFocus = True
        cmp.moveFocus = True
        cmp.mouseButtonFocus = True

    def setupContent(self):
        if self.FRAME:
            cmp = GUI.Frame2(self.FRAME)
            cmp.verticalPositionMode = cmp.horizontalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.width = self.SLOTWIDTH
            cmp.height = self.SLOTHEIGHT
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (0, 0, 0.9)
            self.component.addChild(cmp, 'frameCmp')
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.SLOTWIDTH
        cmp.height = self.SLOTHEIGHT
        cmp.colour = (255, 255, 255, 128)
        cmp.materialFX = 'BLEND'
        cmp.position = (32, 0, 0.5)
        cmp.visible = False
        cmp.filterType = 'LINEAR'
        self.component.addChild(cmp, 'dragProxy')
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.SLOTWIDTH
        cmp.height = self.SLOTHEIGHT
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.4)
        cmp.filterType = 'LINEAR'
        self.component.addChild(cmp, 'itemIcon')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'ArialNarrow_12.font'
        cmp.colour = (175, 166, 112, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (self.SLOTWIDTH - 5, 5, 0.3)
        self.component.addChild(cmp, 'itemCount')

    def _applyItemData(self):
        if self.haveItem():
            if not ItemsUtils.GetIconName(self.itemData, texture_size=self.SLOTWIDTH):
                iconName = 'nottexture.dds'
                texture = ItemsUtils.getCachedTextureIcon(iconName)
                self.component.itemIcon.texture = texture and texture
            else:
                self.component.itemIcon.textureName = iconName
            self.component.itemIcon.colour = (255, 255, 255, 255)
            countStr = ItemsUtils.GetDisplayValue(self.itemData)
            self.component.itemCount.text = countStr
        elif self.EMPTY_TEXTURE:
            self.component.itemIcon.texture = self.EMPTY_TEXTURE
            self.component.itemIcon.colour = self.EMPTY_COLOUR
            self.dragProxy.texture = None
            self.component.itemCount.text = ''
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemCount.text = ''
            self.lockSlot(False)
        self._last_itemIcon_colour = tuple(self.component.itemIcon.colour)
        self.dragProxy.texture = self.component.itemIcon.texture
        return

    def take(self):
        BWPersonality.GUICore.itemCacheUserFireEvent(ITEM_CACHE.EVENT_TAKE, [self.itemData])

    def onDragStart(self):
        if self.haveItem():
            self.dragProxy.visible = True
            self._last_itemIcon_colour = tuple(self.component.itemIcon.colour)
            self.component.itemIcon.colour = (50, 50, 50, 150)
            return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        colour = self._last_itemIcon_colour or (255, 255, 255, 255)
        try:
            self.component.itemIcon.colour = colour
        except:
            print 'colour', repr(colour)
            traceback.print_exc()

        return True

    def updateSlot(self, *w, **kw):
        pass