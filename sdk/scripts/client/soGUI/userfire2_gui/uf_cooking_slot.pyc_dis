# Embedded file name: ./client/soGUI/userfire2_gui/uf_cooking_slot.py
import BigWorld
import ItemsUtils
from Items import ItemsCatalog
from uf_result_slot import UFResultSlot
from uf_grill_slot import UFGrillSlot
marker = BigWorld.PyTextureProvider('soGUI/maps/userfire/marker.dds')
mainbg = BigWorld.PyTextureProvider('textures/default/white.dds')

class UFIngredientSlot(UFResultSlot):
    factoryString = 'UFIngredientSlot'
    EMPTY_TEXTURE = marker
    EMPTY_COLOUR = (255, 255, 255, 100)
    FRAME = None

    @staticmethod
    def markAssEnable(enable = True):
        UFIngredientSlot.EMPTY_TEXTURE = marker if enable else None
        return

    def _applyItemData(self):
        UFResultSlot._applyItemData(self)
        if self.haveItem():
            param = ItemsCatalog.GetItemParam(self.itemData['complexItemType'])
            number = ItemsUtils.GetItemNumber(self.itemData)
            max_number = param.get('CookingPotIngredientMaxStack', 1)
            self.component.itemCount.text = '%s/%s' % (number, max_number)


class UFCookingPotMainSlot(UFGrillSlot):
    factoryString = 'UFCookingPotMainSlot'
    SLOTWIDTH = 128
    SLOTHEIGHT = 128
    FRAME = 'soGUI/items/cell.dds'
    EMPTY_TEXTURE = None

    def _applyItemData(self):
        self.component.frameCmp.visible = bool(self.haveItem())
        UFGrillSlot._applyItemData(self)