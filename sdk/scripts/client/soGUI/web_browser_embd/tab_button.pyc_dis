import GUI
import BigWorld
from Math import Matrix
from Helpers.PyGUI import PyGUIBase
from soGUI.soButton import soButton

class TabButton(PyGUIBase):

    def __init__(self, parent_browser, page_id, active_color, deactive_color, hover_color):
        component = GUI.Window('textures/default/white.dds')
        PyGUIBase.__init__(self, component)
        component.script = self
        self.parent_browser = parent_browser
        self.page_id = page_id
        self._is_active = False
        self._is_hover = False
        self._active_color = active_color
        self._deactive_color = deactive_color
        self._hover_color = hover_color
        self._width = 160
        self._title = ''
        self.setupRoot()

    @property
    def width(self):
        return self._width

    @width.setter
    def width(self, value):
        self._width = value
        self.component.width = self._width
        self.component.close_btn.position = (self._width - 9, 7, 0.1)
        self._updateTitle()

    def setupRoot(self):
        self.component.mouseButtonFocus = True
        self.component.crossFocus = True
        self.component.horizontalPositionMode = self.component.verticalPositionMode = 'PIXEL'
        self.component.horizontalAnchor = 'LEFT'
        self.component.verticalAnchor = 'BOTTOM'
        self.component.widthMode = self.component.heightMode = 'PIXEL'
        self.component.colour = self._active_color
        self.component.materialFX = 'BLEND'
        self.component.height = 25
        self.component.width = self._width
        self.component.position = (0, 0, 0.5)
        self._label = GUI.Text(self.page_id)
        self._label.colour = (200, 200, 200, 255)
        self._label.font = 'RobotoCondensedRegular_14.font'
        self._label.position = (0, 0, 0.8)
        self.component.addChild(self._label)
        close_btn = soButton(GUI.Window())
        cmp = close_btn.component
        cmp.horizontalPositionMode = 'PIXEL'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.filterType = 'LINEAR'
        cmp.width = 12
        cmp.height = 12
        cmp.position = (self.component.width - 9, 9, 0.1)
        close_btn.initVSC('soGUI/visual_styles/btn_web_close_page.xml')
        close_btn.onBound()
        close_btn.setVisualState('normal')
        close_btn.onClick = self._close_after
        self.component.addChild(cmp, 'close_btn')

    def setTitle(self, title):
        self._title = title
        self._updateTitle()

    def setHilight(self, hilight):
        self._is_active = hilight
        self.updateColour()

    def updateColour(self):
        if self._is_active:
            self.component.colour = self._active_color
        elif self._is_hover:
            self.component.colour = self._hover_color
        else:
            self.component.colour = self._deactive_color

    def handleMouseButtonEvent(self, comp, event):
        if event.isKeyDown():
            self.parent_browser.selelctPage(self.page_id)
        return True

    def handleMouseEnterEvent(self, *e):
        self._is_hover = True
        self.updateColour()
        return True

    def handleMouseLeaveEvent(self, *e):
        self._is_hover = False
        self.updateColour()
        return True

    def destroy(self):
        if self.component:
            self.component.script = None
        self.component = None
        self.parent_browser = None
        self._label = None
        return

    def _updateTitle(self):
        max_symbols = self._getMaxSumbolsTitle()
        title = self._title
        if len(title) > max_symbols:
            title = title[:max_symbols - 1] + '..'
        self._label.text = title

    def _close_after(self):
        print '_close_after'
        BigWorld.callback(0, self._close)

    def _close(self):
        if self.parent_browser:
            self.parent_browser.tryClosePage(self.page_id)

    def _getMaxSumbolsTitle(self):
        max_symbols = int(self._width * 0.15)
        return max(5, max_symbols)