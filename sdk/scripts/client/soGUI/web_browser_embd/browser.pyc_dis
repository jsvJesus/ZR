    def handleMouseEvent(self, *e):
        return True

    def handleMouseEnterEvent(self, *e):
        return True

    def handleMouseLeaveEvent(self, *e):
        return True

    def handleMouseButtonEvent(self, *e):
        return True

    def handleMouseClickEvent(self, *e):
        return True

    def show(self, url = '', close_callback = None, open_external_callback = None):
        self._init_url = url
        if self.component.parent is None:
            BWPersonality.GUICore.systemLayer.addChild(self.component, 'WebBrowser')
        self.component.visible = True
        if not self._listener_signed:
            BWPersonality.game.addListener('onRecreateDevice', self._onRecreateDevice)
            BWPersonality.game.addListener('onFini', self._game_onFini)
            self._listener_signed = True
        if url:
            self._addPage(url, new_page=None)
        if close_callback:
            self._close_listeners.append(close_callback)
        if open_external_callback:
            self._op_ext_listeners.append(open_external_callback)
        self._updateSize()
        self.updatePageBG()
        return

    def hide(self):
        if self.component:
            self.component.visible = False
        for callback in self._close_listeners:
            callback()

        self._close_listeners = []
        self._op_ext_listeners = []
        if self._listener_signed:
            BWPersonality.game.removeListener('onRecreateDevice', self._onRecreateDevice)
            BWPersonality.game.removeListener('_game_onFini', self._game_onFini)
            self._listener_signed = False
        BWPersonality.GUICore.systemLayer.delChild('WebBrowser')
        for page_id in self._pages.keys():
            self._closePage(page_id, update_bar=False)

        self._current_page_id = None
        return

    def destroy(self):
        self.hide()
        self.component = None
        return

    def onUrlEventEscape(self):
        self.updateNaviBar()

    def goFromUrlEdit(self):
        self._url_edit.activate(False)
        if DISABLE_URL_EDIT:
            return
        url = self._url_edit.getRaw().strip()
        self._getcurrentPage().loadURL(url)

    def goBack(self):
        self._getcurrentPage().goBack()

    def goFwd(self):
        self._getcurrentPage().goForward()

    def reloadPage(self):
        self._getcurrentPage().reload()

    def selelctPage(self, page_id):
        self._current_page_id = page_id
        self._updatePageBar()

    def tryClosePage(self, page_id):
        self._closePage(page_id)
        if not self._pages:
            self.hide()

    def updateNaviBar(self):
        self.updatePageBG()
        if self._current_page_id not in self._pages:
            return
        tab, page = self._pages[self._current_page_id]
        self._url_edit.setValue(page.getUrl(), check_validity=False)
        self.btn_back.setDisabledState(not page.canGoBack)
        self.btn_fwd.setDisabledState(not page.canGoForward)
        self.btn_reload.setDisabledState(page.isLoading)
        if self._url_edit.active:
            self._url_edit.activate(False)
        if page.is_https_error:
            self.component.body.https_icon.visible = True
            self.component.body.https_icon.colour = (255, 0, 0, 255)
        elif page.is_https:
            self.component.body.https_icon.visible = True
            self.component.body.https_icon.colour = (0, 150, 0, 255)
        else:
            self.component.body.https_icon.visible = False

    def updatePageBG(self):
        colour = PAGE_BG_COLOR_LOADING
        if self._current_page_id in self._pages:
            tab, page = self._pages[self._current_page_id]
            if not page.isLoading and page.liveTime > 0.1:
                colour = PAGE_BG_COLOR
        self.component.body.page_bg.colour = colour

    def pageOnAfterCreated(self, page_id, new_page):
        self._addPage('', new_page)

    def onMouseButtonPageEvent(self, page, *e):
        if self._url_edit.active:
            self._url_edit.activate(False)

    def _openExternal(self):
        import webbrowser
        print '_openExternal', repr(self._init_url)
        webbrowser.open(self._init_url)
        for calb in self._op_ext_listeners:
            calb()

    def _updatePageBar(self):
        if not self._pages:
            return
        width = self.component.body.width
        tab_btn_width = int(width / (len(self._pages) + 1))
        tab_btn_width = min(300, tab_btn_width)
        for index, (tab, page) in enumerate(self._pages.values()):
            z_pos = 0.1 if page.page_id == self._current_page_id else 0
            tab.width = tab_btn_width
            tab.component.position = (index * (tab_btn_width + 9) + 2, 31, z_pos)
            page.component.position = (PAGE_BORDER, self._page_pos_y, z_pos)
            page.component.visible = page.page_id == self._current_page_id
            tab.setHilight(page.page_id == self._current_page_id)

        self.component.reSort()
        self.updateNaviBar()

    def _addPage(self, url, new_page = None, after_page_id = None):
        page_id = 'page_%s' % self._next_page_id.next()
        tab = TabButton(self, page_id, ACTIVE_PAGE_COLOR, TABBTN_DEACTIVE_COLOR, TABBTN_HOVER_COLOR)
        page = WebPage(self, page_id, tab, component=new_page)
        self.component.body.tab_holder.addChild(tab.component, page_id)
        self.component.body.addChild(page.component, page_id)
        self._pages[page_id] = (tab, page)
        self._current_page_id = page_id
        self._updateSize()
        page.loadURL(url)

    def _closePage(self, page_id, update_bar = True):
        tab, page = self._pages.pop(page_id)
        self.component.body.delChild(page_id)
        self.component.body.tab_holder.delChild(page_id)
        tab.destroy()
        page.destroy()
        if self._current_page_id == page_id:
            if self._pages:
                self._current_page_id = self._pages.keys()[-1]
            else:
                self._current_page_id = None
        if update_bar:
            self._updatePageBar()
        return

    def _getcurrentPage(self):
        if self._current_page_id in self._pages:
            return self._pages[self._current_page_id][1]

    def _onRecreateDevice(self):
        callbackHe(self._updateSize, 0.1, cancel_existing=True)

    def _game_onFini(self, *e):
        self.destroy()

    def _updateSize(self):
        if not self.component:
            return
        width, height = BigWorld.screenSize()
        width = int(width * 0.88)
        height = int(height * 0.88)
        width = max(1, width)
        height = max(1, height)
        self.component.body.width = width
        self.component.body.height = height
        self.component.body.tab_holder.width = width
        self.component.body.navi_holder.width = width
        self.component.body.position = (0, 0, 0.05)
        self.component.body.closeBox.position = (width - 5, 5, 0.05)
        self.component.body.btn_ext.position = (5, height - 5, 0.05)
        self.component.body.page_bg.position = (PAGE_BORDER, self._page_pos_y, 0.9)
        self._url_edit.setWidth(width - self._url_edit.component.position[0] - 3)
        page_height = height - self._page_pos_y - 30
        page_height = max(1, int(page_height))
        page_width = width - PAGE_BORDER * 2
        page_width = max(1, int(page_width))
        self.component.body.page_bg.width = page_width
        self.component.body.page_bg.height = page_height
        for tab, page in self._pages.values():
            page.component.width = page_width
            page.component.height = page_height

        self._updatePageBar()