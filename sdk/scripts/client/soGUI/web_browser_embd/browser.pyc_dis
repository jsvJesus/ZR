def clear_cookies_files():
    for fname in ['Cookies', 'Cookies-journal']:
        fullpath = os.path.abspath('web/cache/Network/' + fname)
        if os.path.isfile(fullpath):
            try:
                os.remove(fullpath)
            except:
                traceback.print_exc()


clear_cookies_files()

