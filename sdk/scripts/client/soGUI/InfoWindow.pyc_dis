class InfoWindow(PyGUIBase, DraggableComponent):
    factoryString = 'soGUI.InfoWindow'

    def __init__(self, component, imanger = None, WID = 'WID', is_inventory_item = True):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, 1, 1, 1, xoffset=0.9, yoffset=0.9)
        self._isDebugInfo = False
        self._is_new_window = True
        self._half_height = Settings().getSetting('info_win_half_height', True)
        self._dummy_win_mode = DummyWinMode.Inside
        component.script = self
        self.WID = WID
        self.imanger = imanger
        self.component.visible = False
        self.component.dragFocus = 1
        self.component.mouseButtonFocus = 1
        self.component.focus = 1
        self.component.crossFocus = 1
        self.component.propagateAnyway = True
        self._isAttach = False
        self._is_inventory_item = is_inventory_item
        self.last_depth = 0.0
        self.setupRoot()
        self.setupContent()
        self.createTextNode()
        self.doReposition()
        self.onBound()

    def doReposition(self):
        self.component.closeBox.position = (self.width - 25, 7, 0.0)
        self.component.btnToggleHeight.position = (self.width - 29, 7, 0.0)
        try:
            self.component.dev_button.position = (self.width - 50, 70, 0.0)
        except:
            pass

        self.component.slotitem.position = (2, 30, 0)
        self._do_dummy_win_reposition()
        sW, sH = BigWorld.screenSize()
        old = self.component.height
        height = max(sH - 30, 50)
        if self._half_height:
            height = height / 2.0
        self.height = self.component.height = height
        if old != height:
            self.component.delChild('ctext')
            self.createTextNode()
            if self._item:
                text = ItemInfoText(self._item, isAttach=self._isAttach, isDebugInfo=self._isDebugInfo, color_text=colorCodes.tf3_gray_text)
                text = client_utils.colorise_text(text)
                self.component.ctext.script.setText(text, self._item['complexItemType'])
                BigWorld.callback(0.2, functools.partial(self.component.ctext.script.setGradeItem, self._item))
        self.onBound()

