    def _on_list_event(self, event_type, data):
        if event_type == ListEventType.SelectionChanged:
            self._update_buttons()

    def _on_send_click(self):
        self.component.base_comp.visible = False
        self.component.result_pane.visible = True
        cause = self._causes_list.selected_cause()
        comment = self._ebox.getRaw()
        BWPersonality.GUICore.on_wimp_win_report_requested(cause + 1, self._abuser_name, comment)

    def _update_buttons(self):
        self._send_btn.setDisabledState(self._causes_list.selected_cause() is None)
        return

    def show(self, abuser_name):
        if not self.component.visible:
            self.component.visible = True
        self.component.base_comp.visible = True
        self.component.result_pane.visible = False
        self._ebox.setValue(u'')
        self._apply(abuser_name)
        BWPersonality.GUICore.setBestCursor()
        pixelperfect_component(self.component)

    def hide(self):
        if self.component.visible:
            self.component.visible = False
        BWPersonality.GUICore.setBestCursor()
        self._abuser_name = None
        self._ebox.activate(False)
        return

    def _apply(self, abuser_name):
        self._abuser_name = abuser_name
        self.component.base_comp.name.text = abuser_name
        self._update_buttons()

    @property
    def visible(self):
        return self.component.visible