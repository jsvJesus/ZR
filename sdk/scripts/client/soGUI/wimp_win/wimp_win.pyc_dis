class LineEventType:
    OnClick, = range(1)


class ListEventType:
    SelectionChanged, = range(1)


class ListLine(PyGUIBase, Listenable):

    def __init__(self, cause, text, comp):
        Listenable.__init__(self)
        PyGUIBase.__init__(self, comp)
        self.component.script = self
        self._hovered = False
        self.pressed = False
        self.cause = cause
        self.component.mouseButtonFocus = True
        self.component.crossFocus = True
        comp = GUI.Text(text, 'RobotoCondensedRegular_16.font')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.position = (8, 0, 0.5)
        self.component.addChild(comp, 'text')
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'background')
        self._update_visual()

    def set_pressed(self, pressed):
        self.pressed = pressed
        self._update_visual()

    def handleMouseEnterEvent(self, comp):
        self._hovered = True
        result = PyGUIBase.handleMouseEnterEvent(self, comp)
        self._update_visual()
        return result

    def handleMouseLeaveEvent(self, comp):
        self._hovered = False
        result = PyGUIBase.handleMouseLeaveEvent(self, comp)
        self._update_visual()
        return result

    def handleMouseButtonEvent(self, comp, event):
        if Keys.KEY_RIGHTMOUSE and event.isKeyDown():
            self.notify_listeners(LineEventType.OnClick, self)
        result = PyGUIBase.handleMouseButtonEvent(self, comp, event)
        return result

    def _update_visual(self):
        if self.pressed:
            self.component.text.colour = (250, 250, 250, 255)
            self.component.background.colour = (99, 10, 10, 255)
            self.component.background.visible = True
        elif self._hovered:
            self.component.text.colour = (170, 170, 170, 255)
            self.component.background.colour = (66, 66, 66, 255)
            self.component.background.visible = True
        else:
            self.component.text.colour = (146, 146, 146, 255)
            self.component.background.visible = False


class List(Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        self.component = component
        self._selected_line = None
        causes = ['CHEATING',
         'EXPLOITING',
         'OFFENSIVE',
         'ABUSE',
         'SCAMMING',
         'SPAMMING',
         'OTHER']
        self._lines = []
        height = 24
        space = 4
        pos_y = 0
        for cause in causes:
            comp = GUI.Window()
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
            comp.position = (0, pos_y, 0.5)
            comp.width, comp.height = 2, height
            comp.materialFX = 'SOLID'
            text = lc('soGUICore.wimpwin.causes.' + cause)
            line = ListLine(getattr(RC, cause), text, comp)
            line.add_listener(self._on_line_event)
            self.component.addChild(comp)
            pos_y += height + space
            self._lines.append(line)

        self.height = pos_y - space
        return

    @property
    def selected_line(self):
        return self._selected_line

    @selected_line.setter
    def selected_line(self, value):
        if self._selected_line == value:
            return
        if self._selected_line:
            self._selected_line.set_pressed(False)
        self._selected_line = value
        if self._selected_line:
            self._selected_line.set_pressed(True)
        self.notify_listeners(ListEventType.SelectionChanged)

    def _on_line_event(self, event_type, line):
        if event_type == LineEventType.OnClick:
            if self.selected_line == line:
                self.selected_line = None
            else:
                self.selected_line = line
        return

    def selected_cause(self):
        return self._selected_line and self._selected_line.cause


