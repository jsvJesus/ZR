    def clear_target(self):
        global PP
        if self.render_target:
            self.render_target.dynamic = 0
            self.render_target.externalEmbodiments = []
        if self.render_player:
            self.render_player.dynamic = 0
            self.render_player.externalEmbodiments = []
        self.component.render.textureName = ''
        self._render_model = None
        if PP:
            PP.disable()
            if self._enabled:
                self._enabled = False
        if self._render_timer:
            BigWorld.cancelCallback(self._render_timer)
            self._render_timer = None
        self.component.visible = False
        return

    def init_render(self):
        global PP
        if PP:
            PP.disable()
            PP.pp_effect.preTickDebug = None
            PP = None
        w, h = BigWorld.screenSize()
        self.render_target = BigWorld.PyModelRenderer(int(w), int(h))
        self.render_player = BigWorld.PyModelRenderer(int(w), int(h))
        self.render_target.dynamic = 0
        self.render_target.addAmbientColor((1, 1, 1, 1))
        self.render_target.useMainRenderCamera = True
        self.render_target.disableParticleInEmbodiment = True
        self.render_player.dynamic = 0
        self.render_player.addAmbientColor((1, 1, 1, 1))
        self.render_player.useMainRenderCamera = True
        self.render_player.disableParticleWorldEmbodiment = True
        player_texture = self.render_player.texture
        try:
            PP = PostProcessing.contour_model_without_player.ContourModelToTextueWithoutPlayer(player_texture)
        except:
            traceback.print_stack()
            traceback.print_exc()
            return

        self.render_target.secondRT = PP._inputTexture()
        PP.colour = self.COLOR
        PP.enable()
        PP.pp_effect.forceDraw()
        self.component.texture = PP.output.texture
        self.onChangeViewMode()
        return

    def change_color(self, color):
        if self.COLOR == color:
            return
        self.COLOR = color
        if not PP:
            return
        PP.colour = self.COLOR
        PP.enable()
        PP.pp_effect.forceDraw()

    def onChangeViewMode(self):
        if not PP:
            return
        if not self.render_target:
            return
        if not self.render_player:
            return
        player = BigWorld.player()
        if not player:
            return
        if BigWorld.player().isFPSmode():
            player_texture = myscope.prender.renderTarget.texture
        else:
            player_texture = self.render_player.texture
        PP._subtr_player_phase.material.inputTexture2 = player_texture

    def set_target(self, model):
        if not self._render_model and not model:
            return
        self._render_model = model
        if not self._render_model:
            self.clear_target()
            if PP:
                PP.disable()
            return
        self.component.visible = True
        self._enabled = True
        if not self.render_target or not self.render_player:
            self.init_render()
        if not PP:
            return
        PP.enable()
        if isinstance(self._render_model, (list, tuple)):
            self.render_target.externalEmbodiments = self._render_model
        else:
            self.render_target.externalEmbodiments = [self._render_model]
        self.render_player.externalEmbodiments = [BigWorld.player().model]
        self.render_target.dynamic = True
        self.render_player.dynamic = True