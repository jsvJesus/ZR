def getBtnLabel(btn):
    """
    \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe \xd0\xb5\xd1\x91 \xd1\x82\xd0\xb8\xd0\xbf\xd1\x83
    """
    if btn == MESSAGEBOX.BTN_OK:
        return lc('GUI.MessageBoxes.OK_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_CANCEL:
        return lc('GUI.MessageBoxes.CANCEL_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_YES:
        return lc('GUI.MessageBoxes.YES_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_NO:
        return lc('GUI.MessageBoxes.NO_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_UNDO:
        return lc('GUI.MessageBoxes.UNDO_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_APPLY:
        return lc('GUI.MessageBoxes.APPLY_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_RESET:
        return lc('GUI.MessageBoxes.RESET_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_CONFIRM:
        return lc('GUI.MessageBoxes.CONFIRM_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_SAVE:
        return lc('GUI.MessageBoxes.SAVE_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_ALL:
        return lc('GUI.MessageBoxes.SAVE_BUTTON_ALL')
    if btn == MESSAGEBOX.BTN_PAYEDRESET:
        return lc('GUI.MessageBoxes.PAYED_RESET_BUTTON')
    if btn == MESSAGEBOX.BTN_BUY:
        return lc('GUI.MessageBoxes.BUY_BUTTON_LABEL')
    if btn == MESSAGEBOX.BTN_ACCEPT:
        return lc('GUI.MessageBoxes.ACCEPT')
    if btn == MESSAGEBOX.BTN_DECLINE:
        return lc('GUI.MessageBoxes.DECLINE')
    return lc('GUI.MessageBoxes.SAVE_BUTTON_LABEL')


def isClosingBtn(btn):
    """
    \xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82, \xd1\x8f\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbb\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb0 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xbe\xd0\xb9 \xd0\xb7\xd0\xb0\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0
    """
    return btn in [MESSAGEBOX.BTN_OK,
     MESSAGEBOX.BTN_CANCEL,
     MESSAGEBOX.BTN_YES,
     MESSAGEBOX.BTN_NO,
     MESSAGEBOX.BTN_CONFIRM,
     MESSAGEBOX.BTN_PAYEDRESET,
     MESSAGEBOX.BTN_BUY,
     MESSAGEBOX.BTN_DECLINE]


class soMsgBoxMgr(PyGUIBase):
    """\xd0\x9c\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xb4\xd0\xb6\xd0\xb5\xd1\x80 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xbe\xd0\xb2\xd1\x8b\xd1\x85 \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd. \xd0\xa3\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc, \xd0\xbe\xd1\x82\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xb8 \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd"""
    MIN_DEPTH = 0.0
    MAX_DEPTH = 1.0

    def __init__(self):
        """\xd0\x98\xd0\xbd\xd0\xb8\xd1\x86\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xb4\xd0\xb6\xd0\xb5\xd1\x80\xd0\xb0 \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd"""
        self.modalState = False
        self.msgBoxes = {}
        self.msgBoxesOrder = []
        self.generalRenderPlane = None
        self.systemRenderPlane = None
        self.msgHistory = {}
        self.setupRenderPlanes()
        PyGUIBase.__init__(self, self.generalRenderPlane)
        return

    def setupRenderPlanes(self):
        cmp = GUI.Window('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.06)
        cmp.script = self
        BWPersonality.GUICore.generalLayer.addChild(cmp, 'msgBoxRenderPlane')
        self.generalRenderPlane = cmp
        cmp = GUI.Window('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.06)
        cmp.script = self
        BWPersonality.GUICore.systemLayer.addChild(cmp, 'msgBoxRenderPlane')
        self.systemRenderPlane = cmp

    def has_cursor_windows(self):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd0\xbb\xd0\xb8\xd1\x87\xd0\xb8\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd, \xd1\x82\xd1\x80\xd0\xb5\xd0\xb1\xd1\x83\xd1\x8e\xd1\x89\xd0\xb8\xd1\x85 \xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xbe\xd1\x80\xd0\xb0"""
        for msg in self.msgBoxes.itervalues():
            if getattr(msg, 'need_cursor', False):
                return True

        return False

    def updateModalState(self):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe\xd1\x8f\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xb0"""
        modalID = None
        for msgID in self.msgBoxesOrder:
            if self.msgBoxes[msgID].isModal:
                modalID = msgID

        if modalID is not None:
            self.setActiveMsgBox(msgID)
            self.goModal(True)
        else:
            self.goModal(False)
        return

    def goModal(self, goModal = True):
        """\xd0\x92\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82/\xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc"""
        self.modalState = goModal
        self.generalRenderPlane.crossFocus = goModal
        self.generalRenderPlane.mouseButtonFocus = goModal
        self.generalRenderPlane.focus = goModal
        self.generalRenderPlane.moveFocus = goModal
        self.generalRenderPlane.dragFocus = goModal
        self.generalRenderPlane.dropFocus = goModal

    def setActiveMsgBox(self, id):
        """\xd0\xa3\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe"""
        if self.modalState:
            return False
        elif self.msgBoxes.has_key(id):
            self.msgBoxesOrder.remove(id)
            self.msgBoxesOrder.append(id)
            self.updateDepth()
            return True
        else:
            return False

    def addMsgBox(self, msgBox):
        """\xd0\x94\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe"""
        if self.msgBoxes.has_key(msgBox.msgBoxID):
            return False
        self.msgBoxes[msgBox.msgBoxID] = msgBox
        msgBox.msgBoxEvent = self.msgBoxEventRepeater
        bg_component = msgBox.getBGcomponent()
        self.msgBoxesOrder.append(msgBox.msgBoxID)
        renderPlane = self.generalRenderPlane
        if msgBox.isSystem:
            renderPlane = self.systemRenderPlane
        if bg_component:
            renderPlane.addChild(bg_component, 'bg_component_{0}'.format(msgBox.msgBoxID))
        renderPlane.addChild(msgBox.component, 'msgBox_{0}'.format(msgBox.msgBoxID))
        if not msgBox.forcePos:
            if self.msgHistory.has_key(msgBox.msgBoxID):
                msgBox.setPos(self.msgHistory[msgBox.msgBoxID][0], self.msgHistory[msgBox.msgBoxID][1])
            else:
                self.msgHistory[msgBox.msgBoxID] = [msgBox.x, msgBox.y]
        self.updateDepth()
        self.updateModalState()
        BWPersonality.GUICore.setBestCursor()
        return True

    def delMsgBox(self, id):
        """\xd0\xa3\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd0\xbf\xd0\xbe \xd0\xb5\xd0\xb3\xd0\xbe ID"""
        if self.is_msg_box_active(id):
            self.msgHistory[id] = [self.msgBoxes[id].component.position.x, self.msgBoxes[id].component.position.y]
            msgBox = self.msgBoxes[id]
            renderPlane = self.generalRenderPlane
            if msgBox.isSystem:
                renderPlane = self.systemRenderPlane
            renderPlane.delChild('msgBox_{0}'.format(id))
            renderPlane.delChild('bg_component_{0}'.format(id))
            self.msgBoxes[id].fini()
            del self.msgBoxes[id]
            self.msgBoxesOrder.remove(id)
            self.updateDepth()
            self.updateModalState()
            BWPersonality.GUICore.setBestCursor()
            return True
        else:
            return False

    def is_msg_box_active(self, id):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82, \xd1\x81\xd1\x83\xd1\x89\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xb8 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd1\x81 \xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc ID"""
        return self.msgBoxes.has_key(id)

    def getDnDHolderPlane(self, msgBox):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbb\xd0\xbe\xd1\x81\xd0\xba\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x82\xd0\xb0\xd1\x81\xd0\xba\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0"""
        if msgBox.isSystem:
            return self.systemRenderPlane
        return self.generalRenderPlane

    def setAddControlData(self, msgBoxID, controlID, data):
        """\xd0\xa3\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb4\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd1\x83\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f"""
        if self.msgBoxes.has_key(msgBoxID):
            self.msgBoxes[msgBoxID].setAddControlData(controlID, data)

    def setBtnData(self, msgBoxID, btn_type, data):
        """\xd0\xa3\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8"""
        if self.msgBoxes.has_key(msgBoxID):
            self.msgBoxes[msgBoxID].setBtnData(btn_type, data)

    def updateDepth(self):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbe\xd1\x80\xd1\x8f\xd0\xb4\xd0\xbe\xd0\xba \xd0\xbe\xd1\x82\xd1\x80\xd0\xb8\xd1\x81\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb8 \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd (\xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xbd\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb5 \xd0\xb1\xd1\x8b\xd0\xbb\xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x85 \xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd1\x8b\xd1\x85)"""
        depth = 1.0
        for msgID in self.msgBoxesOrder:
            box = self.msgBoxes.get(msgID)
            if not box:
                continue
            renderPlane = self.generalRenderPlane
            if box.isSystem:
                renderPlane = self.systemRenderPlane
            cmp = getattr(renderPlane, 'bg_component_{0}'.format(msgID), None)
            if cmp:
                depth -= 0.01
                cmp.position.z = depth
            cmp = getattr(renderPlane, 'msgBox_{0}'.format(msgID), None)
            if cmp:
                depth -= 0.01
                cmp.position.z = depth

        GUI.reSort()
        return

    def onGameModeChange(self, mode):
        ids = self.msgBoxes.keys()
        for msgID in ids:
            self.msgBoxes[msgID].internalClose()

    def msgBoxEventRepeater(self, event, data):
        BWPersonality.GUICore.msgBoxEvent(event, data)
        if event == MESSAGEBOX.EVENT_BTNPRESS:
            boxId = data['id']
            btn = data['btn']
            if isClosingBtn(btn):
                self.delMsgBox(boxId)
        if event == MESSAGEBOX.EVENT_CLOSE or event == MESSAGEBOX.EVENT_CLOSE_NONUSER:
            boxId = data['id']
            self.delMsgBox(boxId)

    def updateParentVisibility(self):
        ids = self.msgBoxes.keys()
        for msgID in ids:
            if self.msgBoxes[msgID].parentGUI is not None:
                if self.msgBoxes[msgID].parentGUI not in BWPersonality.GUICore.getGUIMap(return_id=True):
                    self.msgBoxes[msgID].internalClose()

        return

    def onEscapeKey(self):
        ids = self.msgBoxes.keys()
        handled = False
        if ids:
            for msgID in ids:
                handled = self.msgBoxes[msgID].onEscapeKey()

        return bool(handled)

    def onReturnKey(self):
        if self.msgBoxesOrder:
            return self.msgBoxes[self.msgBoxesOrder[-1]].onReturnKey()

    def handleMouseEvent(self, comp, event):
        return True

    def handleMouseButtonEvent(self, comp, event):
        return True

    def handleMouseClickEvent(self, component):
        return True

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def handleDragStartEvent(self, comp):
        return True

    def handleDragStopEvent(self, comp):
        return True

    def handleDragEnterEvent(self, comp, dragged):
        return True

    def handleDragLeaveEvent(self, comp, dragged):
        return True

    def handleDropEvent(self, comp, dropped):
        return True

    def fini(self):
        pass


class soEditBoxMB(soEditBox):
    """
    \xd0\x9a\xd0\xb0\xd1\x81\xd1\x82\xd0\xbe\xd0\xbc\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xb5 \xd0\xb2\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb0
    \xd0\x9e\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f Enter \xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8c\xd1\x88\xd0\xb5 (\xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb1\xd1\x8b\xd0\xbb\xd0\xbe \xd0\xb7\xd0\xb0\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd0\xbf\xd0\xbe Enter)
    \xd1\x82\xd0\xb0\xd0\xba \xd0\xb6\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb2\xd0\xbe\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81\xd0\xb2\xd0\xbe\xd0\xb9 \xd0\xb2\xd0\xb2\xd0\xbe\xd0\xb4 (\xd0\xba\xd0\xbe\xd1\x81\xd1\x82\xd1\x8b\xd0\xbb\xd1\x8c \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0 \xd1\x81 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xbe\xd0\xb9 \xd0\x92\xd1\x81\xd0\xb5(F))
    """

    def __init__(self, *args, **kargs):
        soEditBox.__init__(self, *args, **kargs)
        self.keys_interceptor = None
        return

    def handleKeyEvent(self, event):
        if self.keys_interceptor and self.keys_interceptor(event):
            return True
        handled = soEditBox.handleKeyEvent(self, event)
        if event.key in (KEY_RETURN, KEY_NUMPADENTER):
            handled = False
        return handled


class soMessageBox(Interceptor, DraggableComponent):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0. \xd0\xa0\xd0\xb5\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xbe\xd1\x81\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbd\xd1\x83\xd1\x8e \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c"""
    factoryString = 'soGUI.soMessageBox'
    LEFT_ORIGIN = 20
    TOP_ORIGIN = 41
    ADDS_INTERVAL = 5

    def __init__(self, component, id, isModal, x, y, width, caption, forcePos, parent_gui_id, bind_to_parent, btn_set, timeout, closeBox, defaultAction, addControls, callback = lambda event, data: None, isSystem = False, bg_color = None, font_color = None, hlink_listener = None):
        """
        \xd0\x98\xd0\xbd\xd0\xb8\xd1\x86\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0
        :param component: GUI \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82
        :param id: \xd1\x83\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9 ID \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0
        :param isModal: \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8
        :param x, y: \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0
        :param width: \xd1\x88\xd0\xb8\xd1\x80\xd0\xb8\xd0\xbd\xd0\xb0 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0
        :param caption: \xd0\xb7\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xba \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0
        :param forcePos: \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb8\xd0\xbd\xd1\x83\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x83\xd1\x8e \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e (\xd0\xbd\xd0\xb5 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x8f\xd1\x82\xd1\x8c \xd0\xb2 \xd0\xb8\xd1\x81\xd1\x82\xd0\xbe\xd1\x80\xd0\xb8\xd0\xb8)
        :param parent_gui_id: ID \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xbe\xd0\xb3\xd0\xbe GUI
        :param bind_to_parent: \xd0\xbf\xd1\x80\xd0\xb8\xd0\xb2\xd1\x8f\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xba \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xbe\xd0\xbc\xd1\x83 GUI
        :param btn_set: \xd0\xbd\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x80 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xba
        :param timeout: \xd1\x82\xd0\xb0\xd0\xb9\xd0\xbc\xd0\xb0\xd1\x83\xd1\x82 \xd0\xb0\xd0\xb2\xd1\x82\xd0\xbe-\xd0\xb7\xd0\xb0\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f
        :param closeBox: \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd1\x83 \xd0\xb7\xd0\xb0\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f
        :param defaultAction: \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e (\xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 Enter)
        :param addControls: \xd0\xb4\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd1\x8b \xd1\x83\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f
        :param callback: \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0
        :param isSystem: \xd1\x81\xd0\xb8\xd1\x81\xd1\x82\xd0\xb5\xd0\xbc\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe
        :param bg_color: \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbe\xd0\xbd\xd0\xb0
        :param font_color: \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd0\xb0
        :param hlink_listener: \xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd1\x87\xd0\xb8\xd0\xba \xd0\xb3\xd0\xb8\xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd1\x81\xd1\x8b\xd0\xbb\xd0\xbe\xd0\xba
        """
        Interceptor.__init__(self, component, interscept_keys=isModal)
        DraggableComponent.__init__(self, 1, 1, 1)
        component.script = self
        if len(set([ (c['ID'], c['type']) for c in addControls ])) != len(addControls):
            print 'soMessageBoxGUI (ERROR): controls id duplication', addControls
            raise RuntimeError
        self.x = x
        self.y = y
        self.width = width
        self.height = 0
        self.caption = caption
        self.forcePos = forcePos
        self.addControls = addControls
        self.btns = btn_set
        self.parentGUI = parent_gui_id
        self.msgBoxID = id
        self.timeout = timeout
        self.defaultAction = defaultAction
        self.closeBox = closeBox
        self.isModal = isModal
        self.callback = callback
        self.hlink_listener = hlink_listener
        self.parentBind = bind_to_parent
        self.isSystem = isSystem
        self._bg_component = None
        self.font_color = font_color
        self.timer_text_pattern = ''
        if bg_color and self.isModal:
            self._bg_component = GUI.Simple('soGUI/white.dds')
            self._bg_component.horizontalPositionMode = self._bg_component.verticalPositionMode = 'CLIP'
            self._bg_component.widthMode = 'CLIP'
            self._bg_component.heightMode = 'CLIP'
            self._bg_component.materialFX = 'BLEND'
            self._bg_component.colour = bg_color
            self._bg_component.position = (0, 0, 0)
            self._bg_component.width = 4
            self._bg_component.height = 4
        self.controlWidth = self.width - self.LEFT_ORIGIN * 2
        self.autoHeight = True if self.height <= 0 else False
        self.ticker = None
        self.dragProxy = self.component
        self.proxyHolder = BWPersonality.GUICore.msgBoxMgr.getDnDHolderPlane(self)
        self.proxyName = 'msgBox_{0}'.format(self.msgBoxID)
        self._onDragStop = self.onDragStop
        self.setupRoot()
        self.setupContent()
        self.setupAddControls()
        self.setupBtns()
        self.updateBinding()
        if self.timeout > 0:
            self.ticker = self.timeoutTickerWithText() if self.timer_text_pattern else self.timeoutTicker()
            self.ticker.run()
        if self.hlink_listener:
            BWPersonality.GUICore.addListener('hlinkEvent', self.hlink_listener)
        return

    def getBGcomponent(self):
        return self._bg_component

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        if isinstance(self.x, int):
            cmp.horizontalPositionMode = 'PIXEL'
        if isinstance(self.y, int):
            cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.width
        cmp.height = self.height
        cmp.position.x = self.x
        cmp.position.y = self.y
        cmp.position.z = 0.5
        cmp.mouseButtonFocus = True
        cmp.dragFocus = True
        cmp.moveFocus = True
        cmp.crossFocus = True

    def setupContent(self):
        cmp = GUI.Frame2('soGUI/frame/messagebox_frame.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp, 'dFrame')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode, cmp.verticalPositionMode = ('CLIP', 'PIXEL')
        cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'TOP')
        cmp.widthMode, cmp.heightMode = ('CLIP', 'PIXEL')
        cmp.font = 'RobotoCondensedRegular_18.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.multiline = False
        cmp.colourFormatting = False
        cmp.text = self.caption
        cmp.position = (0, 3, 0.8)
        cmp.width = 2
        self.component.addChild(cmp, 'caption')
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = 'PIXEL'
        cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.width
        cmp.height = 28
        cmp.position = (0.0, 1.0, 0.3)
        cmp.dragFocus = True
        cmp.moveFocus = True
        cmp.script = self
        self.component.addChild(cmp, 'dragPlane')

    def setupAddControls(self):
        lastHeight = self.TOP_ORIGIN
        for addControl in self.addControls:
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_EDIT:
                lastHeight += self._makeEdit(addControl, lastHeight) + self.ADDS_INTERVAL
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_CHECKBOX:
                lastHeight += self._makeCheckBox(addControl, lastHeight) + self.ADDS_INTERVAL
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_RADIO:
                lastHeight += self._makeRadio(addControl, lastHeight) + self.ADDS_INTERVAL
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_TEXTFIELD:
                lastHeight += self._makeText(addControl, lastHeight) + self.ADDS_INTERVAL
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_TIMERFIELD:
                lastHeight += self._makeTimerField(addControl, lastHeight) + self.ADDS_INTERVAL
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_LABEL:
                lastHeight += self._makeLabel(addControl, lastHeight) + self.ADDS_INTERVAL
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_SPACING_T1:
                lastHeight += self._makeSpacing1(addControl, lastHeight) + self.ADDS_INTERVAL
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_SPACING_T2:
                lastHeight += self._makeSpacing2(addControl, lastHeight) + self.ADDS_INTERVAL
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_LIST:
                print 'soMessageBox::_makeList is NYI'
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_DDL:
                print 'soMessageBox::_makeDDL is NYI'
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_SLIDER:
                print 'soMessageBox::_makeSlider is NYI'

        self.component.height = lastHeight + 15

    def setupBtns(self):
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/elements/closeBox.xml')
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.width - 8, 8, 0.2)
        self.component.addChild(cmp, 'closeBox')
        btn.onClick = self.onCloseBoxClick
        btn.onBound()
        btn.buttonDisabled = not self.closeBox
        btn._updateVisualState()
        cmp.dragFocus = True
        if len(self.btns) > 0:
            self.component.height += 32
        for index, btn_ in enumerate(self.btns):
            btn = soButton(GUI.Window())
            btn.initVSC('soGUI/elements/button_1.xml')
            cmp = btn.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'CENTER'
            cmp.verticalAnchor = 'BOTTOM'
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            btnWidth = (self.controlWidth - (len(self.btns) + 1) * 10) / (len(self.btns) * 1.0)
            if btn_.has_key('width'):
                if btn_['width'] > 0:
                    btnWidth = btn_['width']
            cmp.width = btnWidth
            cmp.height = 29
            if btn_.has_key('caption'):
                cmp.label.text = btn_['caption']
            else:
                cmp.label.text = getBtnLabel(btn_['type'])
            if btn_.has_key('enabled'):
                btn.buttonDisabled = not btn_['enabled']
            hPos = self.LEFT_ORIGIN + self.controlWidth / (len(self.btns) * 1.0) * index + self.controlWidth / (len(self.btns) * 1.0) / 2.0
            cmp.position = (int(hPos), self.component.height - 11, 0.2)
            self.component.addChild(cmp, 'btn_{0}'.format(btn_['type']))
            btn.onClick = partial(self.btnHandler, btn_['type'], True)
            btn.onBound()
            btn._updateVisualState()

    def updateBinding(self):
        if self.parentGUI is not None:
            if self.parentBind:
                if self.parentGUI == GUI_ID.GUI_ID_INVENTORY:
                    self.setRestrictingComponent(BWPersonality.GUICore.worldLayer.inventory)
        return

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def handleDragStartEvent(self, cmp):
        if not self.component:
            print 'BUG HERE SP3, ', self.component, cmp
            print 'stack:'
            traceback.print_stack()
            return False
        if cmp == self.component.closeBox:
            print 'handleDragStartEvent'
        if cmp != self.component.dragPlane:
            return False
        self._wantFocus()
        return True

    def handleDragStopEvent(self, cmp):
        if cmp == self.component:
            return False
        return True

    def handleMouseEvent(self, cmp, event):
        return True

    def handleMouseButtonEvent(self, comp, event):
        self._wantFocus()
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleKeyEvent(self, event):
        result = False
        if self._intercept_keys:
            result = event.key not in (KEY_SYSRQ, KEY_TAB)
        if result:
            if BWPersonality.is_event_move_action(event):
                result = False
        return result

    def onDragStop(self):
        GUI.delRoot(self.dragProxy)
        self.proxyHolder.addChild(self.component, self.proxyName)
        return True

    def mouseWheel(self, up = True):
        for addControl in self.addControls:
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_TEXTFIELD:
                cmp = getattr(self.component, 'txt_{0}'.format(addControl['ID']), None)
                if cmp:
                    if up:
                        cmp.script.scrollHandler('UP', None)
                    else:
                        cmp.script.scrollHandler('DOWN', None)

        return

    def _makeEdit(self, addControl, height):
        validator = lambda newStr, wholeText, offset: True
        if addControl.has_key('input_validator'):
            validator = addControl['input_validator']
        font = 'RobotoCondensedRegular_14.font'
        if addControl.has_key('font'):
            font = addControl[6]
        width = self.controlWidth
        if addControl.has_key('width'):
            width = addControl['width']
        edit = soEditBoxMB(GUI.Window(), width=width, height=10, autosize=True, font=font, hOffset=3, vOffset=3, inputValidator=validator)
        cmp = edit.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        hA = MESSAGEBOX.ANCHOR_LEFT
        if addControl.has_key('hAnchor'):
            hA = addControl['hAnchor']
        cmp.horizontalAnchor = hA
        cmp.verticalAnchor = 'TOP'
        hPos = self.LEFT_ORIGIN
        if hA == MESSAGEBOX.ANCHOR_CENTER:
            hPos = self.component.width // 2
        elif hA == MESSAGEBOX.ANCHOR_RIGHT:
            hPos = self.component.width - 20
        cmp.position.x = hPos
        cmp.position.y = height
        cmp.position.z = 0.5
        self.component.addChild(cmp, 'edit_{0}'.format(addControl['ID']))
        edit.onBound()
        if addControl.has_key('default'):
            edit.setValue(addControl['default'])
        if addControl.has_key('active'):
            if addControl['active']:
                edit.activate(True)
        edit.onValueChange = partial(self._editFieldsHandler, addControl['ID'])
        return cmp.height

    def _makeCheckBox(self, addControl, height):
        label = u''
        if addControl.has_key('caption'):
            label = addControl['caption']
        color = (175, 166, 112, 255)
        if addControl.has_key('color'):
            color = addControl['color']
        font = 'RobotoCondensedRegular_14.font'
        if addControl.has_key('font'):
            font = addControl['font']
        cb = soCheckBox(GUI.Window(), soGUI.CheckBoxPropsStructure(labelText=label, labelColour=color, font=font))
        cmp = cb.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        hA = MESSAGEBOX.ANCHOR_LEFT
        if addControl.has_key('hAnchor'):
            hA = addControl['hAnchor']
        cmp.horizontalAnchor = hA
        cmp.verticalAnchor = 'TOP'
        hPos = self.LEFT_ORIGIN
        if hA == MESSAGEBOX.ANCHOR_CENTER:
            hPos = self.component.width // 2
        elif hA == MESSAGEBOX.ANCHOR_RIGHT:
            hPos = self.component.width - 20
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (hPos, height, 0.5)
        self.component.addChild(cmp, 'check_{0}'.format(addControl['ID']))
        cb.onBound()
        if addControl.has_key('default'):
            if addControl['default']:
                cb.setActive()
            else:
                cb.setInactive()
        cb.onStateChange = partial(self.addControlsHandler, addControl['ID'])
        return cmp.height

    def _makeRadio(self, addControl, height):
        label = u''
        if addControl.has_key('caption'):
            label = addControl['caption']
        color = (175, 166, 112, 255)
        if addControl.has_key('color'):
            color = addControl['color']
        font = 'RobotoCondensedRegular_14.font'
        if addControl.has_key('font'):
            font = addControl['font']
        rb = soRadioButton2(GUI.Window(), radioGroup='msg_box_{0}'.format(self.msgBoxID), labelText=label, labelColour=color, font=font)
        cmp = rb.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        hA = MESSAGEBOX.ANCHOR_LEFT
        if addControl.has_key('hAnchor'):
            hA = addControl['hAnchor']
        cmp.horizontalAnchor = hA
        cmp.verticalAnchor = 'TOP'
        hPos = self.LEFT_ORIGIN
        if hA == MESSAGEBOX.ANCHOR_CENTER:
            hPos = self.component.width // 2
        elif hA == MESSAGEBOX.ANCHOR_RIGHT:
            hPos = self.component.width - 20
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (hPos, height, 0.5)
        self.component.addChild(cmp, 'radio_{0}'.format(addControl['ID']))
        rb.onBound()
        if addControl.has_key('default'):
            if addControl['default']:
                rb.setActive()
            else:
                rb.setInactive()
        rb.onStateChange = partial(self.addControlsHandler, addControl['ID'])
        return cmp.height

    def _makeText(self, addControl, height):
        anchor = '<alignment=center>'
        if addControl.has_key('hAnchor'):
            if addControl['hAnchor'] == 'LEFT':
                anchor = '<alignment=left>'
            elif addControl['hAnchor'] == 'RIGHT':
                anchor = '<alignment=right>'
        text = anchor + '<font=RobotoCondensedRegular_16.font>' + (self.font_color if self.font_color else cc.inactive_xml)
        if addControl.has_key('text'):
            text += addControl['text']
        width = self.controlWidth
        if addControl.has_key('width'):
            width = addControl['width']
        autosize = True
        if addControl.has_key('autosize'):
            autosize = addControl['autosize']
        _height = 100
        if addControl.has_key('height'):
            _height = addControl['height']
        txt = soTextField3(GUI.Window(), height=_height, textWidth=-1, hScroll=False, vScroll=not autosize, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=True, autosize=False, width=width)
        cmp = txt.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
        pos_x = (self.component.width - self.controlWidth) / 2
        cmp.position = (pos_x, height, 0.5)
        self.component.addChild(cmp, 'txt_{0}'.format(addControl['ID']))
        txt.onBound()
        txt.setText(text)
        if autosize:
            txt.recalc_auto_height()
        return cmp.height

    def _makeTimerField(self, addControl, height):
        height += 15
        anchor = '<alignment=center>'
        if addControl.has_key('hAnchor'):
            if addControl['hAnchor'] == 'LEFT':
                anchor = '<alignment=left>'
            elif addControl['hAnchor'] == 'RIGHT':
                anchor = '<alignment=right>'
        text = anchor + '<font=RobotoCondensedRegular_16.font>' + (self.font_color if self.font_color else cc.inactive_xml)
        if addControl.has_key('text'):
            text += addControl['text']
        self.timer_text_pattern = text
        width = self.controlWidth
        if addControl.has_key('width'):
            width = addControl['width']
        autosize = True
        if addControl.has_key('autosize'):
            autosize = addControl['autosize']
        _height = 100
        if addControl.has_key('height'):
            _height = addControl['height']
        txt = soTextField3(GUI.Window(), height=_height, textWidth=-1, hScroll=False, vScroll=not autosize, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=True, autosize=False, width=width)
        cmp = txt.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
        pos_x = (self.component.width - self.controlWidth) / 2
        cmp.position = (pos_x, height, 0.5)
        self.component.addChild(cmp, MESSAGEBOX.ADDCONTROL_TIMERFIELD)
        txt.onBound()
        txt.setText(text)
        if autosize:
            txt.recalc_auto_height()
        txt.setText('')
        return cmp.height + 15

    def _makeLabel(self, addControl, height):
        text = u''
        if addControl.has_key('text'):
            text = addControl['text']
        color = (175, 166, 112, 255)
        if addControl.has_key('color'):
            color = addControl['color']
        font = 'RobotoCondensedRegular_14.font'
        if addControl.has_key('font'):
            font = addControl['font']
        hA = MESSAGEBOX.ANCHOR_LEFT
        if addControl.has_key('hAnchor'):
            hA = addControl['hAnchor']
        cmp = GUI.Text('')
        cmp.horizontalPositionMode, cmp.verticalPositionMode = ('PIXEL', 'PIXEL')
        cmp.horizontalAnchor, cmp.verticalAnchor = hA, 'TOP'
        cmp.font = font
        cmp.colour = color
        cmp.multiline = False
        cmp.colourFormatting = True
        cmp.text = text
        hPos = self.LEFT_ORIGIN
        if hA == MESSAGEBOX.ANCHOR_CENTER:
            hPos = self.component.width // 2
        elif hA == MESSAGEBOX.ANCHOR_RIGHT:
            hPos = self.component.width - 20
        cmp.position.x = hPos
        cmp.position.y = height
        cmp.position.z = 0.5
        self.component.addChild(cmp, 'label_{0}'.format(addControl['ID']))
        return cmp.stringDimensions('W')[1]

    def _makeSpacing1(self, addControl, height):
        h = 15
        if addControl.has_key('height'):
            h = addControl['height']
        return h

    def _makeSpacing2(self, addControl, height):
        color = (38, 38, 38, 255)
        if addControl.has_key('color'):
            color = addControl['color']
        h = 15
        if addControl.has_key('height'):
            h = addControl['height']
        cmp = GUI.Simple('soGUI/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = color
        cmp.materialFX = 'BLEND'
        cmp.height = 1
        cmp.width = self.controlWidth
        cmp.position.x = self.width // 2
        cmp.position.y = height + h // 2
        cmp.position.z = 0.5
        rndI = randint(0, 10000000)
        while getattr(self.component, 'spacing2_{0}'.format(rndI), None):
            rndI = randint(0, 10000000)

        self.component.addChild(cmp, 'spacing2_{0}'.format(rndI))
        return h

    def setPos(self, x, y):
        self.component.position.x = self.x = x
        self.component.position.y = self.y = y

    def sendEvent(self, event, data):
        try:
            self.callback(event, data)
        except:
            traceback.print_exc()

        BWPersonality.GUICore.msgBoxEvent(event, data)

    def show(self):
        self.component.visible = True

    def hide(self):
        self.component.visible = False
        if self.hlink_listener:
            BWPersonality.GUICore.removeListener('hlinkEvent', self.hlink_listener)

    def internalClose(self):
        try:
            self.callback(MESSAGEBOX.EVENT_CLOSE_NONUSER, {'id': self.msgBoxID})
        except:
            traceback.print_exc()

        if self.msgBoxEvent:
            self.msgBoxEvent(MESSAGEBOX.EVENT_CLOSE_NONUSER, {'id': self.msgBoxID})

    def userClose(self):
        try:
            self.callback(MESSAGEBOX.EVENT_CLOSE, {'id': self.msgBoxID})
        except:
            traceback.print_exc()

        if self.msgBoxEvent:
            self.msgBoxEvent(MESSAGEBOX.EVENT_CLOSE, {'id': self.msgBoxID})

    def msgBoxEvent(self, event, data):
        return None

    def _wantFocus(self):
        BWPersonality.GUICore.msgBoxMgr.setActiveMsgBox(self.msgBoxID)

    def _editFieldsHandler(self, id, byUser):
        if byUser:
            self.addControlsHandler(id)

    def addControlsHandler(self, id):
        self._wantFocus()
        controlData = self._getControlData(id)
        if controlData is not None:
            try:
                self.callback(MESSAGEBOX.EVENT_ADDCONTROL, {'id': self.msgBoxID,
                 'add_control_id': id,
                 'add_control_data': controlData})
            except:
                traceback.print_exc()

            self.msgBoxEvent(MESSAGEBOX.EVENT_ADDCONTROL, {'id': self.msgBoxID,
             'add_control_id': id,
             'add_control_data': controlData})
        return

    def setAddControlData(self, controlID, data):
        for addControl in self.addControls:
            if addControl.has_key('ID'):
                if addControl['ID'] == controlID:
                    if addControl['type'] == MESSAGEBOX.ADDCONTROL_EDIT:
                        cmp = getattr(self.component, 'edit_{0}'.format(addControl['ID']), None)
                        if cmp:
                            cmp.script.setValue(data)
                    if addControl['type'] == MESSAGEBOX.ADDCONTROL_CHECKBOX:
                        cmp = getattr(self.component, 'check_{0}'.format(addControl['ID']), None)
                        if cmp:
                            if data:
                                cmp.script.setActive()
                            else:
                                cmp.script.setInactive()
                    if addControl['type'] == MESSAGEBOX.ADDCONTROL_RADIO:
                        cmp = getattr(self.component, 'radio_{0}'.format(addControl['ID']), None)
                        if cmp:
                            if data:
                                cmp.script.setActive()
                            else:
                                cmp.script.setInactive()
                    if addControl['type'] == MESSAGEBOX.ADDCONTROL_TEXTFIELD:
                        cmp = getattr(self.component, 'txt_{0}'.format(addControl['ID']), None)
                        if cmp:
                            anchor = '<alignment=center>'
                            if addControl.has_key('hAnchor'):
                                if addControl['hAnchor'] == 'LEFT':
                                    anchor = '<alignment=left>'
                                elif addControl['hAnchor'] == 'RIGHT':
                                    anchor = '<alignment=right>'
                            text = anchor + '<font=RobotoCondensedRegular_16.font>' + (self.font_color if self.font_color else cc.inactive_xml)
                            cmp.script.setText(text + data)
                    if addControl['type'] == MESSAGEBOX.ADDCONTROL_LABEL:
                        cmp = getattr(self.component, 'label_{0}'.format(addControl['ID']), None)
                        if cmp:
                            cmp.text = data

        return

    def setBtnData(self, btn_type, data):
        for btn in self.btns:
            if btn['type'] == btn_type:
                btnCmp = getattr(self.component, 'btn_{0}'.format(btn_type), None)
                if btnCmp:
                    if data.has_key('width'):
                        btnCmp.width = data['width']
                    if data.has_key('caption'):
                        btnCmp.label.text = data['caption']
                    if data.has_key('enabled'):
                        btnCmp.script.buttonDisabled = not data['enabled']
                        btnCmp.script._updateVisualState()

        return

    def _getControlData(self, id):
        controlsData = self._getControlsData()
        if controlsData.has_key(id):
            return controlsData[id]
        else:
            return None

    def _getControlsData(self):
        controlsData = {}
        for addControl in self.addControls:
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_EDIT:
                cmp = getattr(self.component, 'edit_{0}'.format(addControl['ID']), None)
                if cmp:
                    controlsData[addControl['ID']] = cmp.script.getRaw()
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_CHECKBOX:
                cmp = getattr(self.component, 'check_{0}'.format(addControl['ID']), None)
                if cmp:
                    controlsData[addControl['ID']] = cmp.script.isChecked()
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_RADIO:
                cmp = getattr(self.component, 'radio_{0}'.format(addControl['ID']), None)
                if cmp:
                    controlsData[addControl['ID']] = cmp.script.isChecked()

        return controlsData

    def btn_pre_handler(self, btn, byUser):
        return False

    def btnHandler(self, btn, byUser):
        if self.btn_pre_handler(btn, byUser):
            return
        try:
            self.callback(MESSAGEBOX.EVENT_BTNPRESS, {'id': self.msgBoxID,
             'btn': btn,
             'add_controls': self._getControlsData()})
        except:
            traceback.print_exc()

        if self.msgBoxEvent:
            self.msgBoxEvent(MESSAGEBOX.EVENT_BTNPRESS, {'id': self.msgBoxID,
             'btn': btn,
             'add_controls': self._getControlsData()})

    def onCloseBoxClick(self):
        self.userClose()

    def onEscapeKey(self):
        if self.closeBox:
            self.userClose()
            return True
        return False

    def onReturnKey(self):
        if self.defaultAction is not None:
            self.btnHandler(self.defaultAction, True)
            return True
        else:
            return False

    @BWMemberCoroutine
    def timeoutTicker(self):
        if self.defaultAction is not None:
            cmp = getattr(self.component, 'btn_{0}'.format(self.defaultAction), None)
            if cmp:
                btnName = cmp.label.text.split()[0]
                cmp.label.text = u'{0} ({1})'.format(btnName, self.timeout)
        while self.timeout > 0:
            yield BWWaitForPeriod(1.0)
            self.timeout -= 1
            if self.defaultAction is not None:
                cmp = getattr(self.component, 'btn_{0}'.format(self.defaultAction), None)
                if cmp:
                    btnName = cmp.label.text.split()[0]
                    cmp.label.text = u'{0} ({1})'.format(btnName, self.timeout)

        self.ticker = None
        if self.defaultAction is not None:
            self.btnHandler(self.defaultAction, False)
        else:
            self.internalClose()
        return

    def set_timer_text(self):
        if self.timer_text_pattern:
            cmp = getattr(self.component, MESSAGEBOX.ADDCONTROL_TIMERFIELD, None)
            if cmp:
                cmp.script.setText(self.timer_text_pattern.format(self.timeout))
        return

    @BWMemberCoroutine
    def timeoutTickerWithText(self):
        self.set_timer_text()
        while self.timeout > 0:
            yield BWWaitForPeriod(1.0)
            self.timeout -= 1
            self.set_timer_text()

        self.ticker = None
        if self.defaultAction is not None:
            self.btnHandler(self.defaultAction, False)
        else:
            self.internalClose()
        return

    def fini(self):
        self._bg_component = None
        self.stopDragging()
        self.handleDragStopEvent(self.component)
        for addControl in self.addControls:
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_EDIT:
                cmp = getattr(self.component, 'edit_{0}'.format(addControl['ID']), None)
                if cmp:
                    cmp.script.fini()
            if addControl['type'] == MESSAGEBOX.ADDCONTROL_TEXTFIELD:
                cmp = getattr(self.component, 'txt_{0}'.format(addControl['ID']), None)
                if cmp:
                    cmp.script.fini()

        self.msgBoxEvent = None
        self.clearAllChildren(self.component)
        self.component = None
        if self.ticker is not None:
            self.ticker.stop()
            self.ticker = None
        return