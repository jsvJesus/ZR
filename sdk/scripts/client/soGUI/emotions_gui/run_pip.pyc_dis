# Embedded file name: ./client/soGUI/emotions_gui/run_pip.py
import BigWorld
import GUI
from math import sin
frequency = 5.0

class RunPip(object):

    def __init__(self):
        comp = GUI.Window('soGUI/frame/paint/point.dds')
        comp.materialFX = 'BLEND'
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (-6, 0.3, 0.1)
        self.component = comp
        self._visible = False
        self._time = 0
        self.alpha = 0

    def set_parent(self, comp):
        if self.component.parent == comp:
            return
        if self.component.parent:
            self.component.parent.delChild(self.component)
        comp.addChild(self.component)
        self.alpha = 0

    def tick(self):
        self._time += BigWorld.getTimeDelta() * frequency
        factor = sin(self._time)
        self.alpha = factor * factor

    @property
    def alpha(self):
        return self.component.colour[3]

    @alpha.setter
    def alpha(self, value):
        prev_value = self.alpha
        if not self._visible:
            if value > prev_value:
                value = 0.0
        self.component.colour = (0,
         255,
         0,
         value * 255)

    def run(self):
        if not self._visible:
            self._visible = True
            self._time = 0
            self.alpha = 0

    def stop(self):
        if self._visible:
            self._visible = False

    def on_hide(self):
        self._visible = False
        self._time = 0
        self.alpha = 0