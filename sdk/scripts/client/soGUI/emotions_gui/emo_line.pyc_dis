# Embedded file name: ./client/soGUI/emotions_gui/emo_line.py
import GUI
import Keys
from Helpers.PyGUI.PyGUIBase import Interceptor
from utils import Listenable
import colorCodes as cc
from emo_utils import Mode
from keys_data import keys_data
from Localization import lc

class EventType:
    OnEnter, OnLeft, OnClick = ((r, 'EmoWin.LineET') for r in range(3))


class Line(Interceptor, Listenable):

    def __init__(self, emotion_id):
        Listenable.__init__(self)
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.materialFX = 'SOLID'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.width, comp.height = (270, 22)
        comp.isClip = False
        Interceptor.__init__(self, comp)
        comp = GUI.Text(keys_data.get_local_name(emotion_id), 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'text')
        comp = GUI.Simple('soGUI/frame/paint/attention.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (155, 0, 0, 255)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (self.component.width, 0, 0.5)
        comp.visible = False
        self.component.addChild(comp, 'attention')
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.position = (self.component.width, 0, 0.5)
        comp.colour = cc.active_rgba
        self.component.addChild(comp, 'keyText')
        keys_data.add_listener(self._on_keys_data_event)
        self._hovered = False
        self._selected = False
        self._mode = None
        self.emotion_id = emotion_id
        self._update_content()
        return

    def _on_keys_data_event(self, event_type, data):
        if self.emotion_id == data:
            self._update_content()

    def handleMouseEnterEvent(self, comp):
        self.notify_listeners(EventType.OnEnter, self)
        return Interceptor.handleMouseEnterEvent(self, comp)

    def handleMouseLeaveEvent(self, comp):
        self.notify_listeners(EventType.OnLeft, self)
        return Interceptor.handleMouseEnterEvent(self, comp)

    def handleMouseButtonEvent(self, comp, event):
        result = Interceptor.handleMouseButtonEvent(self, comp, event)
        if not event.isRepeatedEvent() and event.isKeyDown() and event.key == Keys.KEY_LEFTMOUSE:
            self.notify_listeners(EventType.OnClick, self)
        return result

    def handleMouseEvent(self, comp, event):
        Interceptor.handleMouseEvent(self, comp, event)
        return False

    def _update_content(self):
        key_name = keys_data.get_short_keyname(self.emotion_id)
        if key_name:
            self.component.keyText.visible = True
            self.component.attention.visible = False
            self.component.keyText.text = key_name
        else:
            self.component.keyText.visible = False
            self.component.attention.visible = True
        if self._mode == Mode.Base:
            self.component.text.colour = cc.active_rgba if self._hovered else cc.inactive_rgba
            self.component.colour = (0, 0, 0, 255)
        else:
            if self._selected:
                self.component.colour = (99, 10, 10, 255)
                self.component.keyText.text = lc('EmotionsGUI.notset')
            elif self._hovered:
                self.component.colour = (66, 66, 66, 255)
            else:
                self.component.colour = (0, 0, 0, 255)
            self.component.text.colour = cc.inactive_rgba

    def set_hovered(self, hovered):
        self._hovered = hovered
        self._update_content()

    def set_selected(self, selected):
        self._selected = selected
        self._update_content()

    def set_mode(self, mode):
        self._mode = mode
        self._update_content()