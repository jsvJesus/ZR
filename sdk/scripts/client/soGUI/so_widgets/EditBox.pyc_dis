# Embedded file name: ./client/soGUI/so_widgets/EditBox.py
import GUI
from soGUI.soEditField import soEditBox2
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod

class EditBox(soEditBox2):
    SELECTION_BG = (0, 120, 215, 255)

    def __init__(self, h_anchor, v_anchor, width, position, on_value_changed, masc_char = None, pholder = None, max_chars = 5, allowed_characters = None):
        comp = GUI.Window()
        soEditBox2.__init__(self, comp, width=width, height=0, hOffset=5, font='RobotoCondensedRegular_16.font', autosize=True, maskChar=masc_char, placeholder=pholder)
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor, comp.verticalAnchor = h_anchor, v_anchor
        comp.position = position
        self.onBound()
        self._copypaste_enable = True
        self._on_value_changed = on_value_changed

        def is_valid(newStr, wholeText, offset):
            full_text = wholeText[:offset] + newStr + wholeText[offset:]
            if len(full_text) > max_chars:
                return False
            if allowed_characters:
                return all((c in allowed_characters for c in full_text))
            return all((c.isdigit() for c in full_text if not 'a' <= c <= 'z' if not 'A' <= c <= 'Z'))

        self.setValidator(is_valid)

    def runErrorNotify(self):
        if self.errorNotifier:
            self.errorNotifier.stop()
        self.errorNotifier = self._special_erroneous_state()
        self.errorNotifier.run()

    @BWMemberCoroutine
    def _special_erroneous_state(self):
        for i in xrange(4):
            self.erroneous = True
            self.updateVisuals()
            yield BWWaitForPeriod(0.05)
            self.erroneous = False
            self.updateVisuals()
            yield BWWaitForPeriod(0.05)

        self.errorNotifier = None
        return

    def on_hide(self):
        self.activate(False)

    _is_lock = None

    def onValueChange(self, byUser):
        if self._is_lock:
            return
        if self._on_value_changed:
            self._on_value_changed(byUser, self.getRaw())

    def set_text(self, text):
        self._is_lock = True
        soEditBox2.setValue(self, text)
        self._is_lock = False


class NumBox(soEditBox2):

    def __init__(self, width = 35, max_chars = 4):
        comp = GUI.Window()
        soEditBox2.__init__(self, comp, width=width, height=35, font='RobotoCondensedRegular_12.font', hOffset=4, vOffset=4)
        self.onBound()
        allowed_characters = '0123456789.'

        def is_valid(newStr, wholeText, offset):
            full_text = wholeText[:offset] + newStr + wholeText[offset:]
            return len(full_text) <= max_chars and all((c in allowed_characters for c in full_text))

        self.setValidator(is_valid)