# Embedded file name: ./client/soGUI/so_widgets/TextButton.py
import GUI
import BWPersonality
from soGUI.soButton import soButton

class TextButton(soButton):
    factoryString = 'soGUI.TextButton'
    interface_id = 'soGUI.TextButton'

    def __init__(self, h_anchor, v_anchor, w, h, position, font = 'RobotoCondensedRegular_16.font', text = '', on_click = None):
        soButton.__init__(self, GUI.Window(), fontLabel=font, isOptions=True)
        cmp = self.component
        self.initVSC('soGUI/elements/button_1.xml')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = h_anchor, v_anchor
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = w
        cmp.height = h
        cmp.position = position
        cmp.label.text = text
        if on_click is not None:
            cmp.script.onClick = on_click
        self.onBound()
        self._tooltip = None
        return

    def set_tooltip(self, text):
        self._tooltip = text

    def handleMouseEnterEvent(self, cmp):
        soButton.handleMouseEnterEvent(self, cmp)
        if self._tooltip:
            BWPersonality.GUICore.showToolTip(self._tooltip, tooltipID=self.interface_id, gui_layer=BWPersonality.GUICore.generalLayer)
        return True

    def handleMouseLeaveEvent(self, cmp):
        soButton.handleMouseLeaveEvent(self, cmp)
        if self._tooltip:
            BWPersonality.GUICore.hideToolTip(self.interface_id)
        return True