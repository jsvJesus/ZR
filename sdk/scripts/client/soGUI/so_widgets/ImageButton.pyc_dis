# Embedded file name: ./client/soGUI/so_widgets/ImageButton.py
import BigWorld
import Keys
import GUI
import BWPersonality
from Helpers.PyGUI.PyGUIBase import PyGUIBase
import copy
IMAGE_BUTTON_DEFAULT_CONFIG = {'normal': {'color': (255, 255, 255, 220)},
 'hover': {'color': (255, 255, 255, 255)},
 'pressed': {'color': (255, 255, 255, 220)},
 'disabled': {'color': (255, 255, 255, 50)}}

class ImageButton(PyGUIBase):
    factoryString = 'soGUI.ImageButton'
    interface_id = 'soGUI.ImageButton'

    def __init__(self, image_path, h_anchor, v_anchor, position, on_click, width = None, height = None):
        cmp = GUI.Window()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = h_anchor, v_anchor
        cmp.materialFX = 'BLEND'
        cmp.position = position
        self._on_click = on_click
        self._width = width
        self._height = height
        cmp.script = self
        cmp.crossFocus = True
        cmp.mouseButtonFocus = True
        PyGUIBase.__init__(self, cmp)
        self.config = copy.deepcopy(IMAGE_BUTTON_DEFAULT_CONFIG)
        self.set_state_icon('normal', image_path)
        self._enabled = True
        self._hover = None
        self._pressed = None
        self._toggled = None
        self._state = None
        self._update_state()
        self._tooltip = None
        return

    def set_state_icon(self, state, image_path):
        self.config[state]['icon'] = BigWorld.PyTextureProvider(image_path)

    def set_tooltip(self, text):
        self._tooltip = text

    def handleMouseButtonEvent(self, cmp, event):
        if event.key == Keys.KEY_LEFTMOUSE:
            if event.isKeyDown() and self._enabled:
                self._on_click()
        self._pressed = event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown()
        self._update_state()
        return True

    def handleMouseEnterEvent(self, cmp):
        self._hover = True
        self._update_state()
        if self._tooltip:
            BWPersonality.GUICore.showToolTip(self._tooltip, tooltipID=self.interface_id, gui_layer=BWPersonality.GUICore.generalLayer)
        return True

    def handleMouseLeaveEvent(self, cmp):
        self._hover = False
        self._pressed = False
        self._update_state()
        BWPersonality.GUICore.hideToolTip(self.interface_id)
        return True

    def set_enable(self, value):
        self._enabled = value
        self._update_state()

    def set_toggle(self, value):
        self._toggled = value
        self._update_state()

    def _apply_state(self):
        state = self._state
        color = self.config[state]['color']
        icon = self.config[state].get('icon')
        if not icon:
            icon = self.config['normal'].get('icon')
        cmp = self.component
        cmp.texture = icon
        if self._width is not None and self._height is not None:
            cmp.width, cmp.height = self._width, self._height
        else:
            cmp.width, cmp.height = cmp.texture.width, cmp.texture.height
        cmp.colour = color
        return

    def _update_state(self):
        if not self._enabled:
            state = 'disabled'
        elif self._pressed or self._toggled:
            state = 'pressed'
        elif self._hover:
            state = 'hover'
        else:
            state = 'normal'
        if self._state != state:
            self._state = state
            self._apply_state()