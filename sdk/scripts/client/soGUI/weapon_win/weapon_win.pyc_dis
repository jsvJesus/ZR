# Embedded file name: ./client/soGUI/weapon_win/weapon_win.py
from Math import Vector3
import BWPersonality
import BigWorld
import GUI
from Helpers.PyGUI.PyGUIBase import DragWin
from weapon_block import WeaponBlock
from grenade_block import GrenadeBlock
from utils import Tickable
from Helpers.PyGUI import Utils
from soGUI.GUIPositions import GUIPositions
from sounds_manager import playSound

class VisibilityMode:
    All, Single, Hidden = range(3)


class WeaponWin(DragWin, GUIPositions, Tickable):
    factoryString = 'CollapsableWeaponWin'

    def __init__(self):
        Tickable.__init__(self)
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = (0, 0)
        comp.visible = False
        comp.position = self._get_default_position()
        DragWin.__init__(self, comp)
        GUIPositions.__init__(self)
        self._collapsed = False
        self._blocks = []
        block = GrenadeBlock()
        comp = block.component
        comp.position = (1, 0, 0.5)
        self.component.addChild(comp)
        self._blocks.append(block)
        block = WeaponBlock()
        comp = block.component
        comp.position = (1, 0, 0.5)
        self.component.addChild(comp)
        self._blocks.append(block)
        block = WeaponBlock()
        comp = block.component
        comp.position = (1, 0, 0.5)
        self.component.addChild(comp)
        self._blocks.append(block)
        block = WeaponBlock()
        comp = block.component
        comp.position = (1, 0, 0.5)
        self.component.addChild(comp)
        self._blocks.append(block)

    def show(self):
        if self.is_visible():
            return
        self.component.visible = True
        self._on_show()

    def hide(self):
        if not self.is_visible():
            return
        self.component.visible = False
        self._on_hide()

    def can_tick(self):
        if not Utils.is_visible_in_hierarchy(self.component):
            return False
        return True

    def on_tick(self):
        width, height = (0, 0)
        p = BigWorld.player()
        if self._collapsed:
            if p.active_weapon:
                active_slot = p.active_weapon.slot_name
                if active_slot:
                    visibility_mode = VisibilityMode.Single
                    isolate_weapon_block = None
                    for i in range(1, len(self._blocks)):
                        if self._blocks[i].slot_key == active_slot:
                            isolate_weapon_block = self._blocks[i]
                            break

                else:
                    visibility_mode = VisibilityMode.Hidden
            else:
                visibility_mode = VisibilityMode.All
            for i, block in enumerate(self._blocks):
                if i == 0:
                    block.on_tick(True)
                elif visibility_mode == VisibilityMode.All:
                    block.on_tick(True)
                elif visibility_mode == VisibilityMode.Hidden:
                    block.on_tick(False)
                elif visibility_mode == VisibilityMode.Single:
                    block.on_tick(isolate_weapon_block == block)
                comp = block.component
                width = max(width, comp.width)
                comp.position[1] = height
                height += comp.height
                comp.visible = comp.height > 0 and comp.width > 0

            self.component.width, self.component.height = (self.component.width != width or self.component.height != height) and width, height
            self.on_size_changed()
        return

    def _on_show(self):
        GUIPositions.show(self)
        self.on_size_changed()
        self._blocks[0].on_show()
        self._blocks[1].on_show('Primary2Slot', 'Primary2Weapon')
        self._blocks[2].on_show('PrimarySlot', 'PrimaryWeapon')
        self._blocks[3].on_show('SecondarySlot', 'SecondaryWeapon')
        BWPersonality.GUICore.addListener('key_binding_changed', self._on_binding_changed)
        self.start_tick()

    def _on_binding_changed(self, data):
        for block in self._blocks:
            block._on_binding_changed(data)

    def get_save_data(self):
        return (tuple(self.component.position), self._collapsed)

    def toggle_collapse(self):
        self._collapsed = not self._collapsed
        playSound('ui/gun_switch')
        self.flush()

    def apply_save_data(self, data):
        try:
            position, collapsed = data
        except:
            position, collapsed = self._get_default_position(), True

        self._collapsed = collapsed
        self.component.position = Vector3(position[0], position[1], self.component.position[2])

    def reset_position(self):
        self.component.position = self._get_default_position()
        self.on_size_changed()

    def _get_default_position(self):
        return (0.9, -0.5, 0.9)

    def _on_hide(self):
        BWPersonality.GUICore.removeListener('key_binding_changed', self._on_binding_changed)
        self.stop_tick()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)