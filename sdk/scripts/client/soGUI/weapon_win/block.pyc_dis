# Embedded file name: ./client/soGUI/weapon_win/block.py
import BigWorld
from math_bw import inverse_lerpclam, lerp, smooth_damp
from soGUI.UtilsGUI.TextScaler import get_nearest_roboto_font

class Block(object):
    _screen_height = None
    _scale = None
    _small_font = None
    _large_font = None

    def __init__(self):
        self._velocity_x = 0.0
        self._velocity_y = 0.0
        self._desired_width = 0.0
        self._desired_height = 0.0

    def on_show(self):
        self._prev_data = None
        return

    def on_tick(self, visible):
        data = self._gather_data() if visible else None
        self._update_content(data, self._prev_data)
        self._prev_data = data
        if self.component.width != self.desired_width:
            self.component.width, self._velocity_x = smooth_damp(self.component.width, self.desired_width, self._velocity_x, 0.1, 10000000000.0, BigWorld.getTimeDelta())
            if abs(self._velocity_x) < 0.001 or abs(self.component.width - self.desired_width) < 0.01:
                self.component.width = self.desired_width
                self._velocity_x = 0.0
        if self.component.height != self.desired_height:
            self.component.height, self._velocity_y = smooth_damp(self.component.height, self.desired_height, self._velocity_y, 0.1, 10000000000.0, BigWorld.getTimeDelta())
            if abs(self._velocity_y) < 0.001 or abs(self.component.height - self.desired_height) < 0.01:
                self.component.height = self.desired_height
                self._velocity_y = 0.0
        return

    @staticmethod
    def _recalc_scales():
        sh = BigWorld.screenHeight()
        if sh == Block._scale:
            return
        factor = inverse_lerpclam(768, 1440, sh)
        Block._scale = lerp(0.74, 1.4, factor)
        Block._small_font = get_nearest_roboto_font(max(16, lerp(14, 20, factor)))
        Block._large_font = get_nearest_roboto_font(min(32, lerp(24, 36, factor)))

    def get_small_font(self):
        Block._recalc_scales()
        return Block._small_font

    def get_large_font(self):
        Block._recalc_scales()
        return Block._large_font

    def calc_scale(self):
        Block._recalc_scales()
        return Block._scale

    def _gather_data(self):
        raise NotImplementedError

    def _update_content(self, data, prev_data):
        raise NotImplementedError

    def _on_binding_changed(self, data):
        raise NotImplementedError

    @property
    def desired_width(self):
        return self._desired_width

    @desired_width.setter
    def desired_width(self, value):
        self._desired_width = value

    @property
    def desired_height(self):
        return self._desired_height

    @desired_height.setter
    def desired_height(self, value):
        self._desired_height = value