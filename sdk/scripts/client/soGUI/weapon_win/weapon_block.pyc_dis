 ItemsCatalog.SHOOTING_MODE_1: 'soGUI/frame/munitions/shot1.dds',
 ItemsCatalog.SHOOTING_MODE_2: 'soGUI/frame/munitions/shot2.dds',
 ItemsCatalog.SHOOTING_MODE_3: 'soGUI/frame/munitions/shot3.dds',
 ItemsCatalog.SHOOTING_MODE_7: 'soGUI/frame/munitions/shot3.dds',
 ItemsCatalog.SHOOTING_MODE_LAUNCH: 'soGUI/frame/munitions/throw.dds',
 'rocket': 'soGUI/frame/munitions/rpg7_rocket.dds'}

class WeaponBlock(Block):

    def __init__(self):
        Block.__init__(self)
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
