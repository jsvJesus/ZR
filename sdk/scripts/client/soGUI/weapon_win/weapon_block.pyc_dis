        self.component.htk.addChild(comp, 'txt')
        self._ammo_names = {}

    def _update_htk(self):
        key = BWPersonality.settings.keyBindings.getKeyBindForAction(self._action_name)
        comp = self.component.htk.txt
        if key:
            comp.text = unicode(key)
            comp.visible = True
        else:
            comp.text = u'-'
            comp.visible = False

    def _on_binding_changed(self, data):
        self._update_htk()

    def on_show(self, slot_key, action_name):
        Block.on_show(self)
        self.slot_key = slot_key
        self._action_name = action_name
        self._update_htk()

    def _update_content(self, data, prev_data):
        if not data:
            self.desired_height = 0
            self.desired_width = 0
            return
        else:
            scale_dirty, image_dirty, capacity_dirty, ammo_count_dirty, ammo_name_dirty, font_dirty, realign_all, shooting_mode_dirty, active_dirty, htk_dirty = (True,
             True,
             True,
             True,
             True,
             True,
             False,
             True,
             True,
             True)
            if prev_data:
                if data['image_path'] == prev_data['image_path']:
                    image_dirty = False
                if data['scale'] == prev_data['scale']:
                    scale_dirty = False
                if data['capacity'] == prev_data['capacity']:
                    capacity_dirty = False
                if data['ammo_count'] == prev_data['ammo_count']:
                    ammo_count_dirty = False
                if data['ammo_name'] == prev_data['ammo_name']:
                    ammo_name_dirty = False
                if data['font'] == prev_data['font']:
                    font_dirty = False
                if data['shooting_mode'] == prev_data['shooting_mode'] and data['ammo_type'] == prev_data['ammo_type']:
                    shooting_mode_dirty = False
                if data['active'] == prev_data['active']:
                    active_dirty = False
                if data['htkwidth'] == prev_data['htkwidth']:
                    htk_dirty = False
            if scale_dirty:
                comp = self.component.htk
                comp.width, comp.height = (15, 15)
                realign_all = True
            if active_dirty:
                comp = self.component.image
                if data['active']:
                    comp.materialFX = 'BLEND'
                    comp.colour = (255, 255, 255, 255)
                    self.component.txtAmmoCount.colour = cc.active_rgba
                    self.component.mode.colour = cc.active_rgba
                    comp.topimage.visible = False
                else:
                    comp.materialFX = 'ALPHA_COLORED_SMOOTH'
                    comp.colour = (40, 40, 40, 100)
                    self.component.txtAmmoCount.colour = cc.inactive_rgba
                    self.component.mode.colour = cc.inactive_rgba
                    comp.topimage.visible = True
                font_dirty = True
                realign_all = True
            if capacity_dirty:
                count = data['capacity']
                if count <= 0:
                    count = '-'
                self.component.txtCapacity.text = u'/' + unicode(count)
                realign_all = True
            if ammo_count_dirty:
                count = data['ammo_count']
                if count is None:
                    count = '-'
                self.component.txtAmmoCount.text = unicode(count)
                realign_all = True
            if ammo_name_dirty:
                if data['ammo_name']:
                    self.component.txtAmmoName.text = data['ammo_name']
                    self.component.txtAmmoName.visible = True
                else:
                    self.component.txtAmmoName.visible = False
                realign_all = True
            if shooting_mode_dirty:
                shooting_mode = data['shooting_mode']
                image = _shoot_mode_icons.get(shooting_mode)
                if shooting_mode == ItemsCatalog.SHOOTING_MODE_LAUNCH:
                    ammo_params = ItemsCatalog.GetItemParam(data['ammo_type'])
                    if ammo_params:
                        if not ammo_params.get('SilhouetteIconName'):
                            image = image
                        else:
                            image = None
                    comp = self.component.mode
                    if image:
                        comp.textureName = image
                        comp.visible = True
                        comp.width, comp.height = comp.texture.width, comp.texture.height
                    else:
                        comp.visible = False
                    realign_all = True
                if htk_dirty:
                    realign_all = True
                if font_dirty:
                    small_font, large_font = data['font']
                    self.component.txtCapacity.font = small_font
                    self.component.txtAmmoCount.font = large_font if data['active'] else small_font
                    self.component.txtAmmoName.font = small_font
                    self.component.htk.txt.font = small_font
                    realign_all = True
                if image_dirty:
                    comp = self.component.image
                    comp.textureName = data['image_path']
                    comp.topimage.textureName = data['image_path']
                    realign_all = True
                if realign_all:
                    height = 0
                    widths = []
                    vspace0 = 8
                    hspace0 = 8
                    hspace1 = 16
                    hspace2 = 8
                    comp = self.component.txtCapacity
                    height = max(comp.height - get_base_line(comp.font), height)
                    widths.append(comp.width)
                    comp = self.component.txtAmmoCount
                    height = max(comp.height - get_base_line(comp.font), height)
                    widths.append(comp.width + hspace1)
                    comp = self.component.txtAmmoName
                    if comp.visible:
                        height = max(comp.height - get_base_line(comp.font), height)
                        widths.append(comp.width + hspace2)
                    comp = self.component.mode
                    if comp.visible:
                        height = max(comp.height, height)
                        widths.append(comp.width)
                    comp = self.component.txtCapacity
                    comp.position[1] = height + get_base_line(comp.font)
                    comp = self.component.txtAmmoCount
                    comp.position[1] = height + get_base_line(comp.font)
                    comp = self.component.txtAmmoName
                    if comp.visible:
                        comp.position[1] = height + get_base_line(comp.font)
                    comp = self.component.mode
                    if comp.visible:
                        comp.position[1] = height
                    comp = self.component.htk
                    comp.height = comp.txt.height
                    comp.width = max(comp.txt.width + 4, comp.height)
                    comp = self.component.image
                    active_scale = 0.8
                    active_unscale = 0.6
                    active_factor = active_scale if data['active'] else active_unscale
                    comp.width = comp.texture.width * data['scale'] * active_factor
                    comp.height = comp.texture.height * data['scale'] * active_factor
                    comp.position = (self.desired_width, height + vspace0, 0.5)
                    self.desired_width = max(sum(widths), comp.width) + (self.component.htk.width + hspace0)
                    comp = self.component.image
                    self.desired_height = comp.position[1] + comp.height + 16
                    pos_x = self.desired_width - (self.component.htk.width + hspace0)
                    self.component.image.position[0] = pos_x
                    self.component.txtCapacity.position[0] = pos_x
                    pos_x -= widths.pop(0)
                    self.component.txtAmmoCount.position[0] = pos_x
                    pos_x -= widths.pop(0)
                    if self.component.txtAmmoName.visible:
                        self.component.txtAmmoName.position[0] = pos_x
                        pos_x -= widths.pop(0)
                    self.component.mode.position[0] = self.component.mode.visible and pos_x
            return

    def _gather_data(self):
        weapon_data = None
        p = BigWorld.player()
        weapon = p.weapon_slots.get(self.slot_key)
        if weapon:
            weapon_data = {'ammo_name': None,
             'scale': self.calc_scale(),
             'font': (self.get_small_font(), self.get_large_font()),
             'htkwidth': self.component.htk.txt.width}
            if weapon.isGrenadeLaunchMode():
                capacity = weapon.getCurrentGrenadeCapacity()
                ammo_count = weapon.getCurrentGrenadeNumber()
                ammo_type = weapon.getCurrentGrenadeType()
                shooting_mode = ItemsCatalog.SHOOTING_MODE_LAUNCH
            else:
                capacity = weapon.getAmmoCapacity()
                ammo_count = weapon.getAmmoNumber()
                ammo_type = weapon.getAmmoType()
                weapon_category = ItemsCatalog.GetItemCategory(weapon.getItemType())
                if weapon_category == IC.LAUNCHER:
                    shooting_mode = 'rocket'
                else:
                    shooting_mode = weapon.shooting_mode
            weapon_data['capacity'] = capacity
            weapon_data['ammo_count'] = ammo_count
            weapon_data['shooting_mode'] = shooting_mode
            if p.active_weapon:
                weapon_data['active'] = p.active_weapon.slot_name == self.slot_key
                weapon_data['ammo_type'] = ammo_type
                if ammo_type:
                    ammo_name = ammo_type not in self._ammo_names and ItemsUtils.GetItemName(ammo_type, fGetShortName=True)
                    ammo_name = ammo_name.split(' ')[-1]
                    self._ammo_names[ammo_type] = ammo_name
                weapon_data['ammo_name'] = self._ammo_names[ammo_type]
            item_param = ItemsCatalog.GetItemParam(weapon.getItemType())
            image_path = item_param.get('SilhouetteIconName', 'soGUI/frame/munitions/default.dds')
            weapon_data['image_path'] = image_path
        return weapon_data