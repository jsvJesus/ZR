# Embedded file name: ./client/soGUI/weapon_win/grenade_block.py
import BWPersonality
import colorCodes as cc
import ItemsUtils
from Items import ItemsCatalog
import BigWorld
import GUI
from block import Block
import ItemCategories as IC

class GrenadeBlock(Block):

    def __init__(self):
        Block.__init__(self)
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.width, comp.height = (0, 0)
        self.component = comp
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.colour = cc.active_rgba
        self.component.addChild(comp, 'image')
        comp = GUI.Text()
        comp.colour = cc.inactive_rgba
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'txt')
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (255, 255, 255, 126)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (1, 0, 0.5)
        self.component.addChild(comp, 'htk')
        comp = GUI.Text()
        comp.colour = cc.active_rgba
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (0, -0.1, 0.5)
        self.component.htk.addChild(comp, 'txt')

    def _on_binding_changed(self, data):
        if 'ThrowGrenade' in data:
            self._update_htk()

    def _update_htk(self):
        key = BWPersonality.settings.keyBindings.getKeyBindForAction('ThrowGrenade')
        comp = self.component.htk.txt
        if key:
            comp.text = unicode(key)
            comp.visible = True
        else:
            comp.text = u'-'
            comp.visible = False

    def on_show(self):
        Block.on_show(self)
        self._grenade_item = None
        self._update_htk()
        return

    def _update_content(self, data, prev_data):
        if not data:
            self.desired_height = 0
            self.desired_width = 0
            return
        scale_dirty, image_dirty, count_dirty, realign_all, font_dirty, htk_dirty = (True,
         True,
         True,
         False,
         True,
         True)
        if prev_data:
            if prev_data['type'] == data['type']:
                image_dirty = False
            if prev_data['count'] == data['count']:
                count_dirty = False
            if prev_data['scale'] == data['scale']:
                scale_dirty = False
            if prev_data['font'] == data['font']:
                font_dirty = False
            if data['htkwidth'] == prev_data['htkwidth']:
                htk_dirty = False
        if scale_dirty:
            realign_all = True
            comp = self.component.htk
            comp.width, comp.height = (15, 15)
        if font_dirty:
            self.component.txt.font = data['font']
            self.component.htk.txt.font = data['font']
            realign_all = True
        if count_dirty:
            self.component.txt.text = str(data['count'])
            realign_all = True
        if htk_dirty:
            realign_all = True
        if image_dirty:
            grenade_params = ItemsCatalog.GetItemParam(data['type'])
            grenade_icon = grenade_params.get('SilhouetteIconName')
            comp = self.component.image
            if not grenade_icon:
                comp.textureName = 'soGUI/frame/munitions/throw.dds'
                comp.width, comp.height = comp.texture.width, comp.texture.height
                realign_all = True
            space0 = realign_all and 8
            space1 = 4
            width = self.component.txt.width + self.component.image.width + space1
            comp = self.component.htk
            comp.height = comp.txt.height
            comp.width = max(comp.txt.width + 4, comp.height)
            self.desired_width, self.desired_height = width + (self.component.htk.width + space0), 20
            pos_x = self.desired_width - (self.component.htk.width + space0)
            comp = self.component.txt
            comp.position[0] = pos_x
            pos_x -= comp.width
            comp = self.component.image
            comp.position[0] = pos_x - space1

    def _gather_data(self):
        p = BigWorld.player()
        gadgets = getattr(p, 'ActiveGadgetList', [])
        grenade_item = None
        grenade_data = None
        for gadget_data in gadgets:
            gadget_type = gadget_data['GadjetType']
            if not gadget_type:
                continue
            if ItemsCatalog.GetItemCategory(gadget_type) != IC.GRENADE:
                continue
            grenade_id = gadget_data['GadjetID']
            if self._grenade_item and self._grenade_item['complexItemID'] == grenade_id:
                grenade_item = self._grenade_item
            else:
                grenade_item = ItemsUtils.GetComplexItemByID(p, grenade_id)
            if not grenade_item:
                continue
            grenade_data = {'scale': self.calc_scale(),
             'type': gadget_type,
             'count': ItemsUtils.GetSingleInconstantParam(grenade_item, ItemsCatalog.INC_ROUND_NUMBER) or 0,
             'font': self.get_small_font(),
             'htkwidth': self.component.htk.txt.width}
            break

        self._grenade_item = grenade_item
        return grenade_data