class FlashScriptGUIBase(IFlashGUI, PyGUI.PyGUIBase):
    """\xd0\x91\xd0\xb0\xd0\xb7\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb2\xd0\xb7\xd0\xb0\xd0\xb8\xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd1\x8f \xd1\x81 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88 (\xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd1\x81 \xd1\x81\xd0\xb5\xd0\xbd\xd1\x82\xd1\x8f\xd0\xb1\xd1\x80\xd1\x8f 2015-\xd0\xb3\xd0\xbe).
    
    \xd0\xa2\xd1\x80\xd0\xb5\xd0\xb1\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbe\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd1\x8b: prepare_answer, ready, create.
    GUI \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88\xd0\xba\xd0\xb8 \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81 \xd0\xbf\xd0\xbe\xd0\xbc\xd0\xbe\xd1\x89\xd1\x8c\xd1\x8e \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0 create.
    """

    def __init__(self, component, *args, **kw):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        PyGUI.PyGUIBase.__init__(self, component)
        self.class_name = self.__class__.__name__
        self._layer = None
        return

    @classmethod
    def create(cls, movie_path = None, backgroundAlpha = 0, *args, **kw):
        """\xd0\x9c\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0.
        
        movie_path - \xd0\xbf\xd1\x83\xd1\x82\xd1\x8c \xd0\xba \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88-\xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd1\x83,
        backgroundAlpha - \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb7\xd1\x80\xd0\xb0\xd1\x87\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c \xd1\x84\xd0\xbe\xd0\xbd\xd0\xb0.
        """
        if not movie_path is not None:
            raise AssertionError, '\xd0\x9d\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82'
            wde = BigWorld.worldDrawEnabled()
            BigWorld.worldDrawEnabled(False)
            try:
                view, movie = Scaleform.createMovieInstance(movie_path)
            finally:
                BigWorld.worldDrawEnabled(wde)

            view is None and bwdebug.ERROR_MSG("Error loading Scaleform movie '%s'" % movie_path)
            return
        else:
            view.backgroundAlpha = backgroundAlpha
            component = GUI.Flash(view)
            component.width = 2
            component.height = 2
            component.materialFX = 'BLEND'
            component.focus = False
            component.mouseButtonFocus = False
            component.crossFocus = False
            component.moveFocus = False
            component.dragFocus = False
            component.dropFocus = False
            component.position = (0.0, 0.0, 0.5)
            component.script = cls(component, *args, **kw)
            component.script.viewX = view
            component.script.movieX = movie
            component.widthMode = component.heightMode = 'CLIP'
            component.horizontalAnchor = 'CENTER'
            component.verticalAnchor = 'CENTER'
            component.horizontalPositionMode = component.verticalPositionMode = 'CLIP'
            view.setExternalInterfaceCallback(component.script.externalInterfaceHandler)
            return component

    @property
    def visible(self):
        return self.component.visible

    @visible.setter
    def visible(self, value):
        self.component.visible = value

    def close(self):
        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xb5\xd0\xb1\xd1\x8f \xd0\xb8 \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb7 \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x81\xd0\xbb\xd0\xbe\xd1\x8f."""
        self.hide()
        component = getattr(self._layer, self.class_name)
        try:
            self._layer.delChild(component)
        except AttributeError:
            pass

    def bind_to_parrent_layer(self, layer):
        """\xd0\x9f\xd1\x80\xd0\xb8\xd0\xb2\xd1\x8f\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81\xd0\xb2\xd0\xbe\xd0\xb9 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xba \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xbe\xd0\xbc\xd1\x83 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x8e."""
        self._layer = layer
        layer.addChild(self.component, self.class_name)

    def doReposition(self):
        """\xd0\x9f\xd1\x80\xd0\xb8 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8 \xd1\x80\xd0\xb0\xd0\xb7\xd1\x80\xd0\xb5\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0 \xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd1\x80\xd1\x80\xd0\xb5\xd0\xba\xd1\x82\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88.
        
        \xd0\x95\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xb7\xd0\xb0 \xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbd \xd1\x82\xd0\xb8\xd0\xba, \xd0\xbd\xd0\xb8\xd1\x87\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbd\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f,
        \xd0\xbf\xd0\xbe\xd1\x8d\xd1\x82\xd0\xbe\xd0\xbc\xd1\x83 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbb\xd0\xb1\xd1\x8d\xd0\xba.
        """
        self.component.width = 2.1
        self.component.height = 2.1
        self.handle_ID = BigWorld.callback(0.2, self._do_reposition)

    def _do_reposition(self):
        """\xd0\x97\xd0\xb0\xd0\xba\xd0\xb0\xd0\xbd\xd1\x87\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd0\xb0 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88-\xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0."""
        BigWorld.cancelCallback(self.handle_ID)
        self.component.width = 2
        self.component.height = 2

    def externalInterfaceHandler(self, func_name, args_in_tuple):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8 \xd0\xb2\xd1\x8b\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd1\x8b \xd0\xbe\xd1\x82 \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88-\xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0."""
        pass

    def set_alpha_background(self, alpha):
        self.viewX.backgroundAlpha = alpha

    def handleKeyEvent(self, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        return self.component.movie.handleKeyEvent(event)

    def handleMouseButtonEvent(self, comp, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        return self.component.movie.handleMouseButtonEvent(event)

    def handleMouseEvent(self, comp, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        return self.component.movie.handleMouseEvent(event)

    def hide(self):
        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88-\xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82"""
        self.visible = False
        self.component.focus = False
        self.component.mouseButtonFocus = False
        self.component.crossFocus = False
        self.component.moveFocus = False
        self.component.dragFocus = False
        self.component.dropFocus = False

    def show(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88-\xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82"""
        self.visible = True
        self.component.focus = True
        self.component.mouseButtonFocus = True
        self.component.crossFocus = True
        self.component.moveFocus = True
        self.component.dragFocus = True
        self.component.dropFocus = True

    def localized_resource(self, paths):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x89\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd1\x8b \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5 json."""
        answer = {}
        language = BWPersonality.settings.getSetting('language', default=None)
        for filename in paths:
            answer[filename.encode('utf-8')] = utils.dict_from_localization(filename, language)

        return answer


