# Embedded file name: ./client/soGUI/ConnectionWindow.py
import BWPersonality
import GUI
import soGUI
from Helpers.PyGUI.PyGUIBase import PyGUIBase

class ConnectionWindow(PyGUIBase):
    factoryString = 'soGUI.ConnectionWindow'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.position = (0, 0, 1)
        cmp.materialFX = 'BLEND'
        cmp.width = 10
        cmp.height = 10
        cmp = GUI.Frame2('soGUI/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (128, 128, 128, 128)
        cmp.materialFX = 'BLEND'
        cmp.width = 1
        cmp.height = 1
        cmp.position = (0, 0, 0.9)
        self.component.addChild(cmp, 'frame')

    def setupContent(self):
        cmp = GUI.Frame2('soGUI/black.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 10, 230)
        cmp.materialFX = 'BLEND'
        cmp.width = 0.075
        cmp.height = 0.05
        cmp.position = (0, 0, 0.9)
        self.component.addChild(cmp, 'msg')
        txt = GUI.Text('Connection...')
        txt.horizontalAnchor = 'CENTER'
        txt.verticalAnchor = 'CENTER'
        txt.font = 'RobotoCondensedRegular_20.font'
        txt.verticalPositionMode = 'CLIP'
        txt.horizontalPositionMode = 'CLIP'
        txt.colour = (255, 255, 255, 255)
        txt.position = (0, 0, 0)
        txt.visible = True
        txt.multiline = False
        self.component.addChild(txt, 'txt')

    def show(self):
        print 'show', self
        if self.component.parent is None:
            connWinLayer = getattr(BWPersonality.GUICore, 'connWinLayer', None)
            if not connWinLayer:
                layer = soGUI.soGUILayer(GUI.Window())
                cmp = layer.component
                cmp.position.z = 0.0
                cmp.visible = True
                cmp.dropFocus = False
                GUI.addRoot(cmp)
                BWPersonality.GUICore.connWinLayer = cmp
            BWPersonality.GUICore.connWinLayer.addChild(self.component, 'connWin')
        self.component.visible = True
        self.component.position = (0.0, 0.0, 1)
        return

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.connWinLayer.delChild('connWin')

    def setText(self, text):
        self.component.txt.text = text