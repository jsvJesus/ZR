# Embedded file name: ./client/soGUI/CargoZoneGUI.py
import GUI
import math
import colorCodes
import BWPersonality
from Localization import lc
from BoxStatus import BoxStatus
from Helpers.PyGUI import PyGUIBase
from Helpers.PyGUI.DraggableComponent import DraggableComponent
from soGUI.BoxElement import BoxElement

class CargoZoneGUI(PyGUIBase, DraggableComponent):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        component.script = self
        self.component.focus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.boxes = {}
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.position = (-1, 0, 1)
        cmp.materialFX = 'BLEND'
        self.width = cmp.width = 240
        self.height = cmp.height = 422
        cmp = GUI.Frame2('soGUI/black.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 130)
        cmp.materialFX = 'BLEND'
        cmp.width = self.width
        cmp.height = self.height
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp, 'frame')

    def setupContent(self):
        txt = GUI.Text(lc('GUI.dungeon_heli_gui.cargo'))
        txt.horizontalAnchor = 'LEFT'
        txt.verticalAnchor = 'BOTTOM'
        txt.font = 'RobotoCondensedRegular_16.font'
        txt.verticalPositionMode = 'PIXEL'
        txt.horizontalPositionMode = 'PIXEL'
        txt.position = (20, 25, 0.5)
        txt.colour = colorCodes.header_rgba
        txt.visible = True
        txt.multiline = False
        self.component.addChild(txt, 'title')
        txt = GUI.Text(lc('GUI.dungeon_heli_gui.boxes'))
        txt.horizontalAnchor = 'LEFT'
        txt.verticalAnchor = 'BOTTOM'
        txt.font = 'RobotoCondensedRegular_16.font'
        txt.verticalPositionMode = 'PIXEL'
        txt.horizontalPositionMode = 'PIXEL'
        txt.position = (50, 50, 0.5)
        txt.colour = colorCodes.inactive_rgba
        txt.visible = True
        txt.multiline = False
        self.component.addChild(txt, 'boxes')
        w, h = txt.stringDimensions(txt.text)
        txt = GUI.Text()
        txt.horizontalAnchor = 'LEFT'
        txt.verticalAnchor = 'BOTTOM'
        txt.font = 'RobotoCondensedRegular_16.font'
        txt.verticalPositionMode = 'PIXEL'
        txt.horizontalPositionMode = 'PIXEL'
        txt.position = (50 + w + 7, 50, 0.5)
        txt.colour = colorCodes.header_rgba
        txt.visible = True
        txt.multiline = False
        self.component.addChild(txt, 'counter')

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'dungGUI')
        self.component.visible = True
        return

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.worldLayer.delChild('dungGUI')

    def update_height(self):
        rows = max(1, math.ceil(len(self.boxes) / 5.0))
        self.height = self.component.height = 60 + 42 * rows
        self.component.frame.height = self.height

    def update_counter(self):
        count = 0
        for box in self.boxes.values():
            if box.status == BoxStatus.COMPLETE:
                count += 1

        self.component.counter.text = '{0}/{1}'.format(count, len(self.boxes))

    def set_box_data(self, data):
        for box in self.boxes.values():
            self.component.delChild(box.component)

        self.boxes = {}
        max_columns = 5
        index = 0
        for i in data:
            box_id = i['index']
            status = i['status']
            row = index / max_columns
            column = index - row * max_columns
            index += 1
            box = BoxElement(GUI.Window(), status)
            cmp = box.component
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.position = (20 + column * 42, 53 + 42 * row, 0.3)
            self.component.addChild(cmp, 'box{0}'.format(index))
            self.boxes[box_id] = box

        self.update_height()
        self.update_counter()

    def set_box_status(self, box_id, status):
        if not self.boxes.has_key(box_id):
            print 'ERROR BoxElement', box_id
            return
        self.boxes[box_id].set_icon_type(status)
        self.update_counter()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)