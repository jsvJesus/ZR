    def onRClick(self):
        self.slotEvent(ITSLOT.SLOTEVENT_RCLICK, self)

    def onDblClick(self):
        self.slotEvent(ITSLOT.SLOTEVENT_DBLCLICK, self)

    def handleMouseLeaveEvent(self, cmp):
        self.slotEvent(ITSLOT.SLOTEVENT_MOUSELEAVE, self)
        self._mouse_inside = False
        self._update_selector()
        return True

    def handleMouseEnterEvent(self, cmp):
        self.slotEvent(ITSLOT.SLOTEVENT_MOUSEENTER, self)
        self._mouse_inside = True
        self._update_selector()
        return True

    def handleMouseEvent(self, cmp, event):
        if not self.dragging:
            return False
        soDraggableComponent.handleMouseEvent(self, cmp, event)
        data = [self, event.cursorPosition, (event.dx, event.dy, event.dz)]
        self.slotEvent(ITSLOT.SLOTEVENT_MOUSEMOVE, data)
        return True

