        """
        self._multisel_take_types_sounds = []

    def on_out_screen_enter(self):
        """ \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82 \xd1\x82\xd1\x8f\xd0\xbd\xd1\x83\xd1\x82 \xd0\xbd\xd0\xb0\xd0\xb4 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xbc \xd0\xb1\xd0\xb5\xd0\xb7 \xd0\xb3\xd1\x83\xd0\xb8"""
        self._dragged_out_screen = True

    def on_out_screen_leave(self):
        """ \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82 \xd0\xbd\xd0\xb0\xd0\xb4 \xd0\xba\xd0\xb0\xd0\xba\xd0\xb8\xd0\xbc\xd1\x82\xd0\xbe \xd0\xb3\xd1\x83\xd0\xb8"""
        self._dragged_out_screen = False

    def handleDragStartEvent(self, cmp):
        self._dragged_out_screen = False
        if self.locked:
            return False
        self.pressed = False
        if self.dragProxy:
            soDraggableComponent.handleDragStartEvent(self, cmp)
            self.slotEvent(ITSLOT.SLOTEVENT_DRAGSTART, self)
            self._play_take_sound()
        return True

    def handleDragStopEvent(self, cmp):
        self._play_drag_stop_sound()
        soDraggableComponent.handleDragStopEvent(self, cmp)
        self.slotEvent(ITSLOT.SLOTEVENT_DRAGSTOP, self)
        self._dragged_out_screen = False
        return True

    def handleDragEnterEvent(self, cmp, dragged):
        if dragged.script is None:
            return False
        else:
            handled = self.slotEvent(ITSLOT.SLOTEVENT_DRAGENTER, [self, dragged.script])
            return bool(handled)

    def handleDragLeaveEvent(self, cmp, dragged):
        if dragged.script is None:
            return False
        else:
            handled = self.slotEvent(ITSLOT.SLOTEVENT_DRAGLEAVE, [self, dragged.script])
            return bool(handled)

    def handleDropEvent(self, cmp, dropped):
        if dropped.script is None:
            return False
        else:
            self.slotEvent(ITSLOT.SLOTEVENT_DROP, [self, dropped.script])
            return True

    def handleMouseButtonEvent(self, cmp, event):
        self.slotEvent(ITSLOT.SLOTEVENT_MOUSEBUTTON, [self, event])
        if not event.isMouseButton():
            return False
        if event.isKeyDown():
            if event.key == KEY_LEFTMOUSE or event.key == KEY_RIGHTMOUSE:
                self.pressed = True
                if event.key == KEY_LEFTMOUSE and not event.isCtrlDown() and not event.isShiftDown():
                    if BigWorld.time() - self._dbl_click_start_time <= BWPersonality.GUICore.mouseDoubleClickSpeed:
                        self._dbl_click_start_time = 0
                        self.onDblClick()
                    else:
                        self._dbl_click_start_time = BigWorld.time()
                self.lastPressed = BigWorld.time()
        if event.isKeyUp() and self.pressed:
            if self.pressed and BigWorld.time() - self.lastPressed <= 0.3:
                if event.key == KEY_LEFTMOUSE:
                    self.onLClick()
                elif event.key == KEY_RIGHTMOUSE:
                    self.onRClick()
            self.pressed = False
        return True

    def _get_selected_items(self):
        items = []
        if self.parent_view and hasattr(self.parent_view, '_get_view_selected_items'):
            items = self.parent_view._get_view_selected_items()
        if items:
            return items
        if self.itemData:
            return [self.itemData]
        return []

    def _get_selected_item_types(self):
        res = []
        for item in self._get_selected_items():
            if not item:
                continue
            item_type = item.get('complexItemType') or item.get('item_type')
            if not item_type:
                continue
            res.append(item_type)

        return res

    def _play_take_sound(self):
        self._multisel_take_types_sounds = self._get_selected_item_types()
        sound_path = ItemsUtils.GetItemInventorySound(self._multisel_take_types_sounds, 'take')
        if sound_path:
            sounds_manager.playSound(sound_path)

    def _play_drag_stop_sound(self):
        sound_path = ItemsUtils.GetItemInventorySound(self._multisel_take_types_sounds, 'put')
        if sound_path:
            sounds_manager.playSound(sound_path)

    def get_multiselection_identifier(self):
        return self.itemData and self.itemData.get('complexItemID', None)

    def get_multiselection(self):
        if self.multiselected:
            result = copy.copy(self.parent_view._multiselection)
            result.remove(self.get_multiselection_identifier())
            result.insert(0, self.get_multiselection_identifier())
            return result
        elif getattr(self.parent_view, '_multiselection', None):
            return self.parent_view._multiselection
        else:
            if getattr(self, 'isDragging', False) and self.draggedData:
                complex_item_id = self.draggedData.get('complexItemID')
                if complex_item_id:
                    return [complex_item_id]
            return [self.get_multiselection_identifier()]

    def get_multiselection_count(self):
        return len(self.parent_view._multiselection)

    @property
    def multiselected(self):
        if not self.parent_view:
            return False
        return self.parent_view.is_multiselected(self)


class soItemView(PyGUIBase):
    factoryString = 'soGUI.soItemView'
    SCROLL_WIDTH = 16

    def __init__(self, component, slotClass, hScroll = True, vScroll = True, slot_eventsHandler = lambda event, data: False, eventsHandler = lambda event, data: False, canDrag = False, eatDrop = True, rows = 5, cols = 2, rowWidth = 3, borderWidth = 1, hInterval = 0, vInterval = 0, parent_script = None, locked_data = None, scroll_auto_hide = False, addx = 0, addy = 0):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.addx = addx
        self.addy = addy
        self.cursor = [0, 0]
        self.maxScroll = [rowWidth - cols, 0]
        self.locked_data = locked_data
        self.pressed = False
        self.lastPressed = 0
        self.dragging = False
        self.dragProxy = None
        self._parent_script = parent_script
        self._multiselectable = False
        self._multiselection = []
        self._clear_multiselection_callback = 0
        self.scroll_auto_hide = scroll_auto_hide
        self.items = []
        self.hScroll = hScroll
        self.vScroll = vScroll
        self.canDrag = canDrag
        self.eatDrop = eatDrop
        self.slotClass = slotClass
        self.borderWidth = borderWidth
        self.rows = rows
        self.cols = cols
        self.hInterval = hInterval
        self.vInterval = vInterval
        self.rowWidth = rowWidth
        self.slot_eventsHandler = slot_eventsHandler
        self.eventsHandler = eventsHandler
        self.setupRoot()
        self.setupSlots()
        self.setupScrolls()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.dragFocus = self.canDrag
        cmp.dropFocus = self.eatDrop
        cmp.moveFocus = True
        cmp.crossFocus = True

    def deleteSlots(self):
        for i in xrange(self.rows * self.cols):
            if hasattr(self.component, 'slot' + str(i)):
                self.component.delChild('slot' + str(i))

    def setupSlots(self):
        vScrollW = self.SCROLL_WIDTH if self.vScroll else 0
        hScrollW = self.SCROLL_WIDTH if self.hScroll else 0
        self.component.width = self.borderWidth * 2 + vScrollW + self.slotClass.SLOTWIDTH * self.cols + self.hInterval * (self.cols - 1)
        self.component.height = self.borderWidth * 2 + hScrollW + self.slotClass.SLOTHEIGHT * self.rows + self.vInterval * (self.rows - 1)
        for i in xrange(self.rows * self.cols):
            if hasattr(self.component, 'slot' + str(i)):
                self.component.delChild('slot' + str(i))
            slot = self.slotClass(GUI.Window(), i, None)
            slot.parent_view = self
            slot.parent_script = self._parent_script
            cmp = slot.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.position.x = self.addx + self.borderWidth + (self.slotClass.SLOTWIDTH + self.hInterval) * (i % (self.cols * 1.0))
            cmp.position.y = self.addy + self.borderWidth + (self.slotClass.SLOTHEIGHT + self.vInterval) * (i // (self.cols * 1.0))
            cmp.position.z = 0.5
            slot.slotEvent = self._slot_handler
            self.component.addChild(cmp, 'slot' + str(i))

        return

    def set_multiselectable(self):
        self._multiselectable = True

    def _slot_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_MOUSEBUTTON:
            slot, keyevent = data
            BigWorld.cancelCallback(self._clear_multiselection_callback)
            if self._multiselectable:
                clear = not keyevent.isKeyDown()
                if keyevent.key == KEY_LEFTMOUSE and not keyevent.isKeyDown():
                    if slot.haveItem():
                        if keyevent.isCtrlDown():
                            self._invert_multiselection(slot)
                            clear = False
                        elif keyevent.isShiftDown():
                            if self._multiselection:
                                seek_items = (slot.get_multiselection_identifier(), self._multiselection[-1])
                                if all(seek_items):
                                    if seek_items[0] == seek_items[1]:
                                        clear = False
                                    else:
                                        started = False
                                        for item in self.items:
                                            if self._get_multiselection_identifier(item) in seek_items:
                                                if started:
                                                    self._multiselect_item(item)
                                                    break
                                                started = True
                                            if started:
                                                self._multiselect_item(item)

                                        clear = False
                            else:
                                self._invert_multiselection(slot)
                                clear = False
                if clear:
                    self._clear_multiselection_next_tick()
        elif event == ITSLOT.SLOTEVENT_DRAGSTART:
            if self._multiselectable and not data.multiselected:
                self._clear_multiselection_next_tick()
        return self.slot_eventsHandler(event, data)

    def _get_view_selected_items(self):
        if not self._multiselection:
            return []
        visItemCount = self.cols * self.rows
        res = []
        for i in xrange(visItemCount):
            slot = getattr(self.component, 'slot' + str(i)).script
            if slot.get_multiselection_identifier() in self._multiselection:
                if slot.itemData:
                    res.append(slot.itemData)

        return res

    def _multiselect_item(self, item):
        identifier = self._get_multiselection_identifier(item)
        if identifier not in self._multiselection:
            self._multiselection.append(identifier)
            slot = self.find_slot_by_multiselection_identifier(identifier)
            if slot:
                slot._applyItemData()

    def find_slot_by_multiselection_identifier(self, identifier):
        visItemCount = self.cols * self.rows
        for i in xrange(visItemCount):
            slot = getattr(self.component, 'slot' + str(i)).script
            if slot.get_multiselection_identifier() == identifier:
                return slot

    def _get_multiselection_identifier(self, item):
        return item and item['complexItemID']

    def _invert_multiselection(self, slot):
        identifier = slot.get_multiselection_identifier()
        if identifier in self._multiselection:
            self._multiselection.remove(identifier)
        else:
            self._multiselection.append(identifier)
        slot._applyItemData()

    def get_items(self, item_ids):
        all_items = {}
        for item in self.items:
            all_items[item['complexItemID']] = item

        return [ all_items.get(item_id) for item_id in item_ids ]

    def is_multiselected(self, slot):
        if not self._multiselectable:
            return False
        return slot.get_multiselection_identifier() in self._multiselection

    def on_show(self):
        self.clear_multiselection()
        BWPersonality.register_key_event_interceptor(self._on_global_key_event, high_priority=True)

    def on_hide(self):
        self.clear_multiselection()
        BWPersonality.unregister_key_event_interceptor(self._on_global_key_event)

    def _on_global_key_event(self, event):
        if not event.isKeyDown() and event.key == KEY_LEFTMOUSE:
            self._clear_multiselection_next_tick()
        return False

    def _clear_multiselection_next_tick(self):
        BigWorld.cancelCallback(self._clear_multiselection_callback)
        self._clear_multiselection_callback = BigWorld.callback(0, self.clear_multiselection)

    def clear_multiselection(self):
        if self._multiselectable and self._multiselection:
            visItemCount = self.cols * self.rows
            for i in xrange(visItemCount):
                slot = getattr(self.component, 'slot' + str(i)).script
                identifier = slot.get_multiselection_identifier()
                if identifier in self._multiselection:
                    self._multiselection.remove(identifier)
                    slot._applyItemData()

            self._multiselection[:] = []

    def setupScrolls(self):
        vScrollHeight = self.component.height - self.SCROLL_WIDTH if self.hScroll else self.component.height
        vScrollHeight -= self.borderWidth * 2
        if hasattr(self.component, 'vScroll'):
            self.component.delChild('vScroll')
        scroll = soScrollBar2(GUI.Window(), width=16, height=vScrollHeight, steps=0, auto_hide=self.scroll_auto_hide)
        scroll.scrollUp = self.scrolledUP
        scroll.scrollDown = self.scrolledDOWN
        scroll.scrollMoved = self.vScrollMoved
        cmp = scroll.component
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.horizontalPositionMode = 'PIXEL'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.visible = self.vScroll
        cmp.position = (self.component.width - self.borderWidth, self.borderWidth, 0.1)
        scroll.setVisualState('normal')
        scroll.onBound()
        self.component.addChild(cmp, 'vScroll')
        scroll.setSteps(self.maxScroll[1])
        hScrollHeight = self.component.width - self.SCROLL_WIDTH if self.vScroll else self.component.width
        hScrollHeight -= self.borderWidth * 2
        if hasattr(self.component, 'hScroll'):
            self.component.delChild('hScroll')
        scroll = soScrollBar2(GUI.Window(), width=16, height=hScrollHeight, steps=0, horizontal=True, auto_hide=self.scroll_auto_hide)
        scroll.scrollLeft = self.scrolledLEFT
        scroll.scrollRight = self.scrolledRIGHT
        scroll.scrollMoved = self.hScrollMoved
        cmp = scroll.component
        cmp.verticalAnchor = 'BOTTOM'
        cmp.horizontalAnchor = 'LEFT'
        cmp.horizontalPositionMode = 'PIXEL'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.visible = self.hScroll
        cmp.position = (self.borderWidth, self.component.height - self.borderWidth, 0.1)
        scroll.setVisualState('normal')
        scroll.onBound()
        self.component.addChild(cmp, 'hScroll')
        scroll.setSteps(self.maxScroll[0])

    def setCacheMode(self, cache_mode):
        visItemCount = self.cols * self.rows
        renderedItems = 0
        firstItemIndex = (self.maxScroll[0] + self.cols) * self.cursor[1] + self.cursor[0]
        itemIndex = firstItemIndex
        while renderedItems < visItemCount and itemIndex < len(self.items):
            col = itemIndex % (self.maxScroll[0] + self.cols)
            if col >= self.cursor[0] and col < self.cursor[0] + self.cols:
                itemSlot = getattr(self.component, 'slot{0}'.format(renderedItems))
                itemSlot.script.setCache_mode(cache_mode)
                renderedItems += 1
            itemIndex += 1

    def set_slot_content(self, slot, content):
        slot.setContent(content)

    def _applyItem(self, item):
        visItemCount = self.cols * self.rows
        for i in xrange(visItemCount):
            slot = getattr(self.component, 'slot' + str(i))
            if slot.script.itemData and slot.script.itemData['complexItemID'] == item['complexItemID']:
                self.set_slot_content(slot.script, item)

    def unlockItem(self, item):
        visItemCount = self.cols * self.rows
        for i in xrange(visItemCount):
            slot = getattr(self.component, 'slot' + str(i))
            if slot.script.itemData and slot.script.itemData['complexItemID'] == item['complexItemID']:
                slot.script.lockSlot(False)

    def _applyItems(self):
        visItemCount = self.cols * self.rows
        renderedItems = 0
        firstItemIndex = (self.maxScroll[0] + self.cols) * self.cursor[1] + self.cursor[0]
        itemIndex = firstItemIndex
        for i in xrange(visItemCount):
            slot = getattr(self.component, 'slot' + str(i))
            slot.script.set_index(firstItemIndex + i)
            self.set_slot_content(slot.script, None)

        while renderedItems < visItemCount and itemIndex < len(self.items):
            col = itemIndex % (self.maxScroll[0] + self.cols)
            if col >= self.cursor[0] and col < self.cursor[0] + self.cols:
                item = self.items[itemIndex]
                itemSlot = getattr(self.component, 'slot{0}'.format(renderedItems))
                self.set_slot_content(itemSlot.script, item)
                if self.locked_data and item and item['complexItemID'] in self.locked_data:
                    itemSlot.script.lockSlot(item['complexItemID'] in self.locked_data or itemSlot.script.locked)
                renderedItems += 1
            itemIndex += 1

        return

    def setItem(self, data):
        for item in self.items:
            if item['complexItemID'] == data['complexItemID']:
                item = data
                break

        self._applyItem(data)

    def setItems(self, data):
        if data is None:
            data = []
        list_diff = utils.get_list_diff(data, self.items)
        if list_diff['added']:
            for item in list_diff['added']:
                self.onAddItem(item)

        if list_diff['removed']:
            for item in list_diff['removed']:
                if item and item.has_key('complexItemID') and item.get('complexItemID') in self._multiselection:
                    self._multiselection.remove(item['complexItemID'])
                self.onRemoveItem(item)

        self.items = data
        self._updateMaxScroll()
        self._applyItems()
        return

    def updateSlotsItems(self, dict_data, **kw):
        visItemCount = self.cols * self.rows
        for i in xrange(visItemCount):
            slot = getattr(self.component, 'slot' + str(i))
            slot.script.updateSlot(dict_data, **kw)

    def updateSlotsColour(self, *w, **kw):
        visItemCount = self.cols * self.rows
        for i in xrange(visItemCount):
            slot = getattr(self.component, 'slot' + str(i))
            slot.script.update_item_color()

    def scroll_items_count(self):
        return len(self.items)

    def _updateMaxScroll(self):
        self.maxScroll[0] = self.rowWidth - self.cols
        self.maxScroll[1] = int(ceil(self.scroll_items_count() / float(self.rowWidth))) - self.rows
        if self.maxScroll[1] < 0:
            self.maxScroll[1] = 0
        self.component.vScroll.script.setSteps(self.maxScroll[1])
        self.component.hScroll.script.setSteps(self.maxScroll[0])
        if self.cursor[1] > self.maxScroll[1]:
            self.cursor[1] = self.maxScroll[1]

    def onAddItem(self, item):
        pass

    def onRemoveItem(self, item):
        pass

    def onScroll(self):
        pass

    def scrollHandler(self, event, data):
        if event == 'RIGHT':
            self.cursor[0] += 1
        elif event == 'LEFT':
            self.cursor[0] -= 1
        elif event == 'hMOVE':
            self.cursor[0] = data
        if event == 'DOWN':
            self.cursor[1] += 1
        elif event == 'UP':
            self.cursor[1] -= 1
        elif event == 'vMOVE':
            self.cursor[1] = data
        if self.cursor[0] > self.maxScroll[0]:
            self.cursor[0] = self.maxScroll[0]
        if self.cursor[0] < 0:
            self.cursor[0] = 0
        if self.cursor[1] > self.maxScroll[1]:
            self.cursor[1] = self.maxScroll[1]
        if self.cursor[1] < 0:
            self.cursor[1] = 0
        self.component.vScroll.script.setValue(self.cursor[1])
        self.component.hScroll.script.setValue(self.cursor[0])
        self.onScroll()
        self._applyItems()

    def setScroll(self, x, y):
        self.cursor = [x, y]
        self.component.vScroll.script.setValue(self.cursor[1])
        self.component.hScroll.script.setValue(self.cursor[0])
        self._applyItems()

    def resetScroll(self):
        self.setScroll(0, 0)

    def onLClick(self):
        self.eventsHandler(ITSLOT.SLOTEVENT_LCLICK, self)

    def onRClick(self):
        self.eventsHandler(ITSLOT.SLOTEVENT_RCLICK, self)

    def onDblClick(self):
        self.eventsHandler(ITSLOT.SLOTEVENT_DBLCLICK, self)

    def handleMouseLeaveEvent(self, cmp):
        self.eventsHandler(ITSLOT.SLOTEVENT_MOUSELEAVE, self)
        return True

    def handleMouseEnterEvent(self, cmp):
        self.eventsHandler(ITSLOT.SLOTEVENT_MOUSEENTER, self)
        return True

    def handleMouseEvent(self, cmp, event):
        if event.dz:
            if self.vScroll:
                if event.dz < 0:
                    self.scrollHandler('DOWN', None)
                else:
                    self.scrollHandler('UP', None)
            elif self.hScroll:
                if event.dz < 0:
                    self.scrollHandler('LEFT', None)
                else:
                    self.scrollHandler('RIGHT', None)
        data = [self, event.cursorPosition, (event.dx, event.dy, event.dz)]
        self.eventsHandler(ITSLOT.SLOTEVENT_MOUSEMOVE, data)
        return True

    def handleDragStartEvent(self, cmp):
        self.dragging = True
        self.pressed = False
        self.eventsHandler(ITSLOT.SLOTEVENT_DRAGSTART, self)
        return True

    def handleDragStopEvent(self, cmp):
        self.dragging = False
        self.eventsHandler(ITSLOT.SLOTEVENT_DRAGSTOP, self)
        return True

    def handleDragEnterEvent(self, cmp, dragged):
        if dragged.script is None:
            return False
        else:
            handled = self.eventsHandler(ITSLOT.SLOTEVENT_DRAGENTER, [self, dragged.script])
            return bool(handled)

    def handleDragLeaveEvent(self, cmp, dragged):
        if dragged.script is None:
            return False
        else:
            handled = self.eventsHandler(ITSLOT.SLOTEVENT_DRAGLEAVE, [self, dragged.script])
            return bool(handled)

    def handleDropEvent(self, cmp, dropped):
        if dropped.script is None:
            return False
        else:
            self.eventsHandler(ITSLOT.SLOTEVENT_DROP, [self, dropped.script])
            return True

    def handleMouseButtonEvent(self, cmp, event):
        if not event.isMouseButton():
            return False
        if event.isKeyDown():
            if event.key == KEY_LEFTMOUSE or event.key == KEY_RIGHTMOUSE:
                self.pressed = True
                if BigWorld.time() - self.lastPressed <= BWPersonality.GUICore.mouseDoubleClickSpeed:
                    self.onDblClick()
                self.lastPressed = BigWorld.time()
        if event.isKeyUp():
            if self.pressed and BigWorld.time() - self.lastPressed <= 0.3:
                if event.key == KEY_LEFTMOUSE:
                    self.onLClick()
                elif event.key == KEY_RIGHTMOUSE:
                    self.onRClick()
            self.pressed = False
        return True

    def setRestrictingComponent(self, comp):
        for i in xrange(self.rows * self.cols):
            cmp = getattr(self.component, 'slot' + str(i))
            cmp.script.setRestrictingComponent(comp)

    def change_size(self, cols, rows):
        self.deleteSlots()
        self.rowWidth = cols
        self.rows = rows
        self.cols = cols
        self.setupSlots()
        self.setupScrolls()
        self._updateMaxScroll()
        self._applyItems()

    @PyGUIEvent('vScroll', 'scrollUp')
    def scrolledUP(self):
        self.scrollHandler('UP', None)
        return

    @PyGUIEvent('vScroll', 'scrollDown')
    def scrolledDOWN(self):
        self.scrollHandler('DOWN', None)
        return

    @PyGUIEvent('hScroll', 'scrollLeft')
    def scrolledLEFT(self):
        self.scrollHandler('LEFT', None)
        return

    @PyGUIEvent('hScroll', 'scrollRight')
    def scrolledRIGHT(self):
        self.scrollHandler('RIGHT', None)
        return

    @PyGUIEvent('vScroll', 'scrollMoved')
    def vScrollMoved(self, newVal):
        self.scrollHandler('vMOVE', newVal)

    @PyGUIEvent('hScroll', 'scrollMoved')
    def hScrollMoved(self, newVal):
        self.scrollHandler('hMOVE', newVal)