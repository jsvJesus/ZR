    def _applyItemData(self):
        self._update_droplet()
        self._update_selector()

    def _get_item_data(self):
        return self.itemData

    def _update_droplet(self):
        if self._has_droplet:
            self.component.drop.visible = False
            item_data = self._get_item_data()
            if item_data:
                water_state = ItemsUtils.get_water_state(item_data)
                if water_state == WaterState.Dirty:
                    self.component.drop.textureName = 'soGUI/maps/Icons/dirty_water.dds'
                    self.component.drop.visible = True
                elif water_state == WaterState.Clear:
                    self.component.drop.textureName = 'soGUI/maps/Icons/pure_water.dds'
                    self.component.drop.visible = True

    def _update_selector(self):
        if self._has_multiselector:
            self.component.multiselection.visible = False
            if self.haveItem() and self.multiselected:
                self.component.multiselection.visible = True
                self.component.multiselection.colour = HIGHTLIGHT_COLOR
            elif self._mouse_inside:
                if not hasattr(self.component, 'frameCmp') or self.component.frameCmp.visible:
                    self.component.multiselection.visible = True
                    self.component.multiselection.colour = HOVER_COLOR

    def haveItem(self):
        if self.itemData is None:
            return False
        else:
            return True
            return

    def lockSlot(self, doLock = True):
