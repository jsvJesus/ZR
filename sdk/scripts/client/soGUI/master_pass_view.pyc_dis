# Embedded file name: ./client/soGUI/master_pass_view.py
import BigWorld
import BWPersonality
import GUI
import traceback
import soGUI
from Helpers.PyGUI import PyGUIBase
from Localization import lc, localization_object

class MasterPassStr(PyGUIBase):
    factoryString = 'MasterPassStr'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 400
        cmp.height = 35
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (0.0, 1, 0.0)

    def setupContent(self):
        cmp = GUI.Frame2('soGUI/items/cell.dds')
        cmp.verticalPositionMode = cmp.horizontalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.component.width
        cmp.height = self.component.height
        cmp.colour = (255, 230, 230, 200)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.9)
        self.component.addChild(cmp, 'frameCmp')
        cmp = GUI.Text('MASTER PASSWORD')
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.colour = (175, 150, 150, 250)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.3)
        self.component.addChild(cmp, 'textstr')

    def show(self):
        self.component.visible = True
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.visible = True
        player = BigWorld.player()
        server_address = BWPersonality.game.last_server_address
        acount_name = BWPersonality.game.last_account_name.decode('utf-8')
        avatart_name = player.name
        server_name = self._getServerName(server_address)
        text = u''
        if player.UserFromMasterPassword:
            text += 'MASTER:  '
        text += u'[{0}]  {1}  {2}'.format(server_name, acount_name, avatart_name, player.id)
        self.component.textstr.text = text
        return

    def _getServerName(self, server_address):
        data = BWPersonality.GUICore.loginFlash.login_actions.servers_by_id.values()
        for name, addr, _, _ in data:
            if addr == server_address:
                return name

        return server_address

    def hide(self):
        self.component.visible = False