    def _set_scroll_value(self, value):
        value = clamp(value, 0, self.rights_scroll.steps)
        if self.rights_scroll.getValue() == value:
            return
        self.rights_scroll.setValue(value)
        self._scroll_changed()

    def _scroll_changed(self):
        pos_y = -self.rights_scroll.getValue() * self.scrollStep
        self.component.rightsFrame.rights_list.position.y = min(pos_y, 0)

    def handleMouseEnterEvent(self, comp):
        self.wheelFocus = True
        self.component.focus = True
        return True

    def handleMouseLeaveEvent(self, comp):
        self.wheelFocus = False
        self.component.focus = False
        return True

    def handleMouseEvent(self, component, event):
        dz = event.dz
        if dz > 0:
            self.rights_scrollUp()
            return True
        if dz < 0:
            self.rights_scrollDown()
            return True
        return False

    def rights_scrollUp(self):
        self._set_scroll_value(self.rights_scroll.getValue() - 1)

    def rights_scrollDown(self):
        self._set_scroll_value(self.rights_scroll.getValue() + 1)

    def rights_scrollMoved(self, value):
        self._set_scroll_value(value)

    def setDataPremissions(self, data):
        self.clearDarkScreen()
        self._rights_data = data
        self._updateRightsEditor()

    def _updateRightsEditor(self):
        for rightCmp in self.rightsCheckBoxes:
            self.component.rightsFrame.rights_list.delChild(rightCmp)
            rightCmp = None

        self.rightsCheckBoxes = []
        screenH = self.component.rightsFrame.rights_list.height
        for i, right in enumerate(RIGHTS_CLAN):
            right_name, right_id, right_active, right_level = right
            if BigWorld.player().clan_level and BigWorld.player().clan_level < right_level:
                continue
            cb = RightCheckBox(GUI.Window(), soGUI.CheckBoxPropsStructure(labelText=right_name, labelColour=(220, 220, 220, 255), disableLabelColour=(146, 146, 146, 255)))
            cmp = cb.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (146, 146, 146, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (0, 2 + i * 25, 0.4)
            self.component.rightsFrame.rights_list.addChild(cmp, 'right' + str(right_id))
            cb.onStateChange = partial(self.rightChecked, right_id)
            cb.onBound()
            self.rightsCheckBoxes.append(cmp)
            cb.disable()

        self.component.rightsFrame.rights_list.height = 2 + len(self.rightsCheckBoxes) * 25
        self.component.ranks.script.clear()
        itemH = 25.0
        self.scrollStep = itemH / 2.0
        scrollStepCount = (115 + itemH * len(self.rightsCheckBoxes) - screenH) / float(self.scrollStep)
        if scrollStepCount > 0:
            self.rights_scroll.setSteps(math.ceil(scrollStepCount))
        else:
            self.rights_scroll.setSteps(0)
        for rank in BigWorld.player().clanRoster['ranks']:
            key, lc_caption = rank
            self.component.ranks.script.addElement(lc_caption)

        self.component.ranks.script.onBound()
        self.component.btnAdd.position.y = self.component.ranks.position.y + len(BigWorld.player().clanRoster['ranks']) * 30 + 5
        p = BigWorld.player()
        vis = len(p.clanRoster['ranks']) < ClanSettings.get_ranks_maxcount(p.clan_level)
        self.component.btnAdd.visible = vis and bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_EDIT_RIGHTS))
        return

    def update_locks(self):
        if self.component.btnClear:
            is_owner = bool(BigWorld.player().checkClanRights(Clan.FLAG_CLAN_OWNER))
            self.component.btnClear.visible = is_owner
        roster = BigWorld.player().clanRoster
        if self.component.btnUp:
            self.component.btnUp.visible = bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_EDIT_RIGHTS))
        if self.component.btnDown:
            self.component.btnDown.visible = bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_EDIT_RIGHTS))
        if self.component.btnDelete:
            self.component.btnDelete.visible = bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_EDIT_RIGHTS))
        if self.component.btnAdd and roster and roster.has_key('ranks'):
            p = BigWorld.player()
            vis = len(p.clanRoster['ranks']) < ClanSettings.get_ranks_maxcount(p.clan_level)
            if vis:
                self.component.btnAdd.visible = bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_EDIT_RIGHTS))
            self.component.btnEdit.visible = self.component.btnEdit and bool(BigWorld.player().checkClanRights(Clan.FLAG_CAN_EDIT_RIGHTS))

    def update(self):
        self._updateRightsEditor()

    def onRankSelect(self):
        if not hasattr(self.component, 'ranks'):
            return
        else:
            self.component.saveBtn.visible = 0
            self._rights_changed = False
            sel = self.component.ranks.script.getSelection()
            access = BigWorld.player().checkClanRights(Clan.FLAG_CAN_EDIT_RIGHTS)
            for rightCmp in self.rightsCheckBoxes:
                if access:
                    rightCmp.script.enable()
                else:
                    rightCmp.script.disable()
                rightCmp.script.setInactive()

            sel = self.component.ranks.script.getSelection()
            if not sel:
                return
            lc_caption = sel[0]
            rank = BigWorld.player().clanRoster['ranksData'].get(lc_caption, None)
            if not rank:
                return
            rank_id = rank[-1]
            rank_options = rank[1]
            if rank_id == 1000:
                for rightCmp in self.rightsCheckBoxes:
                    rightCmp.script.disable()
                    rightCmp.script.setActive()

                return
            self._current_clan_rank = rank_id
            self._parse_rank_optons(rank_id, rank_options)
            self._current_clan_rights = rank_options
            return

    def rightChecked(self, rightID):
        check = None

        def _getBit(num, pos):
            return (num & 1 << pos) >> pos

        def _setBit(num, pos):
            return num ^ 2 ** pos

        if hasattr(self.component.rightsFrame.rights_list, 'right' + str(rightID)):
            cmp = getattr(self.component.rightsFrame.rights_list, 'right' + str(rightID))
            check = cmp.script.isChecked()
        if check is None:
            print 'ERROR: ClanRights Editor wasnt initialised properly: missing checkbox'
            return
        else:
            sel = self.component.ranks.script.getSelection()
            if not sel:
                return
            lc_caption = sel[0]
            rank = BigWorld.player().clanRoster['ranksData'].get(lc_caption, None)
            if not rank:
                return
            if rank[-1] == 1000:
                return
            self._current_clan_rights = _setBit(self._current_clan_rights, rightID)
            self._rights_changed = True
            self.component.saveBtn.visible = 1
            if self.component.btnClear.visible:
                self.component.saveBtn.position.x = 447
            else:
                self.component.saveBtn.position.x = 260
            return

    def onUpBtn(self):
        sel = self.component.ranks.script.getSelection()
        if len(sel) > 0:
            sel = sel[0]
            BWPersonality.GUICore.clanEvent(soGUI.soClanScreen2.EVENT_MOVERANK, (sel, Clan.MOVE_UP))

    def onDownBtn(self):
        sel = self.component.ranks.script.getSelection()
        if len(sel) > 0:
            sel = sel[0]
            BWPersonality.GUICore.clanEvent(soGUI.soClanScreen2.EVENT_MOVERANK, (sel, Clan.MOVE_DOWN))

    def onAddBtn(self):
        sel = self.component.ranks.script.getLast()
        if not sel:
            return
        BWPersonality.GUICore.clanEvent(soGUI.soClanScreen2.EVENT_ADDRANK, sel)

    def onDeleteBtn(self):
        sel = self.component.ranks.script.getSelection()
        if len(sel) > 0:
            sel = sel[0]
            BWPersonality.GUICore.clanEvent(soGUI.soClanScreen2.EVENT_DELRANK, sel)

    def onEditBtn(self):
        sel = self.component.ranks.script.getSelection()
        if len(sel) > 0:
            sel = sel[0]
            BWPersonality.GUICore.clanEvent(soGUI.soClanScreen2.EVENT_EDITRANK, sel)

    def onClearBtn(self):

        def _clear_rights(event):
            if event == gui_jokes.askUserYesNo.YES:
                self._rights_changed = False
                BigWorld.player().cell.resetClanPremissions()

        gui_jokes.askUserYesNo(lc('GUI.Legacy.RESET_RIGHTS_LABEL'), lc('GUI.Legacy.RESET_RIGHTS_TEXT'), _clear_rights)

    def onRmb(self, caption):
        if not caption:
            return
        else:
            rank = BigWorld.player().clanRoster['ranksData'].get(caption, None)
            if not rank:
                return
            BigWorld.player().clanRenameActionsRequest(caption)
            return

    def onSaveRightsBtnClick(self):

        def _save_check(event):
            if event == gui_jokes.askUserYesNo.YES:
                BigWorld.player().cell.saveClanPremissions(self._current_clan_rank, self._current_clan_rights)
                self._rights_changed = False
                self.component.saveBtn.visible = 0

        if self._current_clan_rank is None:
            return
        elif self._current_clan_rights is None:
            return
        else:
            gui_jokes.askUserYesNo(lc('GUI.Legacy.SAVE_RIGHTS_LABEL'), lc('GUI.Legacy.SAVE_RIGHTS_TEXT'), _save_check)
            return

    def show(self):
        self.component.visible = True
        self.wait()
        BigWorld.player().cell.getClanPremissions()

    def hide(self):
        self.component.visible = False

    def wait(self):
        self.clearDarkScreen()
        self.component.darkScreen.visible = True
        self._clbID = BigWorld.callback(5, self.clearDarkScreen)

    def clearDarkScreen(self):
        if self._clbID:
            BigWorld.cancelCallback(self._clbID)
            self._clbID = 0
        self.component.darkScreen.visible = False

    def _parse_rank_optons(self, rankID, rankOptions):

        def _getBit(num, pos):
            return (num & 1 << pos) >> pos

        def _setBit(num, pos):
            return num ^ 2 ** pos

        for i in xrange(0, len(RIGHTS_CLAN)):
            if i >= len(self.rightsCheckBoxes):
                break
            if rankOptions & 1 << RIGHTS_CLAN[i][1]:
                self.rightsCheckBoxes[i].script.setActive()


class RightCheckBox(soCheckBox):

    def disable(self):
        self.box.buttonDisabled = True
        self.box._updateVisualState()
        self.label.colour[3] = 155

    def enable(self):
        self.box.buttonDisabled = False
        self.box._updateVisualState()
        self.label.colour[3] = 255

    def setActive(self):
        self.box.buttonActive = True
        self.box._updateVisualState()
        self.label.colour = self.labelColour

    def setInactive(self):
        self.box.buttonActive = False
        self.box._updateVisualState()
        self.label.colour = self.disableLabelColour

    def onChange(self, checked):
        if checked:
            self.setActive()
        else:
            self.setInactive()
        return None


class RightListElement(soListElement):
    pass