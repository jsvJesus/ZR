# Embedded file name: ./client/soGUI/circlemenu/circle_utils.py
from math import atan2, pi
petal_count = 12

def get_sector_index_from_mouse_pos(mouse_pos):
    if mouse_pos[0] == 0 and mouse_pos[1] == 0:
        return None
    else:
        angle = atan2(mouse_pos[1], mouse_pos[0])
        if angle < 0:
            angle += 2 * pi
        sector_index = int((angle + pi / petal_count) / (2 * pi) * petal_count)
        return sector_index % petal_count