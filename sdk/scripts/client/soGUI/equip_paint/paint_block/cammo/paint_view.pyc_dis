camo_priorities = {}
for i, camo_id in enumerate(camos_sorted):
    camo_priorities[camo_id] = i

class PaintView(View):

    def __init__(self, component):
        View.__init__(self, component)
        self._tm = CammoTableModel()
        self._item = None
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.visible = False
        self._table_grid = CammoTableGrid(comp, self._tm)
        self._table_grid.add_listener(self._on_tablegrid_event)
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        self._color_picker = ColorPicker(comp)
        self._color_picker.add_listener(self._on_colorpicker_event)
        self.component.addChild(comp)
        comp = GUI.Window('soGUI/frame/paint/slot.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (255,
         255,
         255,
         76.5)
        comp.tiled = True
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.4)
        self.component.addChild(comp, 'unavailable')
        comp = GUI.Text(lc('PaintScreen.emblems.LOCKED'))
        comp.colour = cc.active_rgba
        self.component.unavailable.addChild(comp, 'text')
        return

    def _on_colorpicker_event(self, event_type, data):
        if event_type == PickerET.OnSaveClick:
            data['camo_id'] = self._tm.selected.camo_id
            self.notify_listeners(event_type, data)
            playSound('ui/equip_modification/soft_click')
        if event_type == PickerET.OnColorRequested:
            self._item.apply_color(data['channel'], data['color'])
        elif event_type == PickerET.OnHeightChanged:
            self._update_height()

    def _update_height(self):
        cpheight = self._color_picker.component.height
        if cpheight and self._color_picker.component.visible:
            self.height = self._color_picker.component.position[1] + self._color_picker.component.height
        else:
            self.height = self._table_grid.component.height

    def set_item(self, item):
        if self._item:
            self._item.remove_listener(self._on_equipitem_event)
        camo_ids = []
        if item:
            camo_ids = DyeConstant.get_item_camos(item.item_type)
        if camo_ids:
            camo_ids = sorted(camo_ids, key=lambda c_id: camo_priorities.get(c_id), reverse=True)
            self._item = item
            self._item.add_listener(self._on_equipitem_event)
            camo_id = item.camo_id
            self._tm.set_items(camo_id, item.item_type, [None] + camo_ids)
            self._table_grid.component.visible = True
            self._color_picker.set_item(item)
            self.component.unavailable.visible = False
        else:
            self._tm.clear()
            self._table_grid.component.visible = False
            self._color_picker.set_item(None)
            self.component.unavailable.visible = True
        return

    def _on_equipitem_event(self, event_type, data):
        if event_type == EquipItemET.OnCamoColorsChanged:
            self._tm.select_item(self._item.camo_id)

    def _on_tablegrid_event(self, event_type, data):
        if event_type == TableGridET.OnCammoChanged:
            prev_cammo = self._item.camo_id
            self._item.camo_id = data['camo_id']

    def do_reposition(self, reposition_data):
        View.do_reposition(self, reposition_data)
        cols, rows = reposition_data['paint_cols'], reposition_data['paint_rows']
        cell_size = reposition_data['cell_size']
        scroll_width = reposition_data['scroll_width']
        equip_table_height = cell_size * rows
        equip_table_width = cell_size * cols + scroll_width
        comp = self._table_grid.component
        comp.width, comp.height = equip_table_width, equip_table_height
        comp.position = (0, 0, 0.5)
        self._table_grid.do_reposition(cols, rows, cell_size, cell_size, scroll_width)
        pos_y = self._table_grid.component.height + cell_size * 0.25
        comp = self._color_picker.component
        comp.width = self.component.width - scroll_width
        comp.position = (0, pos_y, 0.5)
        self._color_picker.do_reposition()
        comp = self.component.unavailable
        comp.width, comp.height = equip_table_width - scroll_width, equip_table_height
        comp.tileWidth, comp.tileHeight = cell_size, cell_size
        comp = comp.text
        comp.font = calc_needed_font(32)
        self._update_height()