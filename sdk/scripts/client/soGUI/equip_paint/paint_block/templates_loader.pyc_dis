# Embedded file name: ./client/soGUI/equip_paint/paint_block/templates_loader.py
from random import choice
import os
import utils
from struct import pack, unpack
import string
_path = os.path.join(utils.stalker_path(), 'usercontent/camo_templates')

def _write_to_file(file_path, camo_id, colors):
    with open(file_path, 'wb') as f:
        f.write(pack('H', camo_id))
        for color in colors:
            if color:
                f.write(pack('B', 1))
                color = map(int, color)[:3] or (255, 0, 255)
                f.write(pack('BBB', *color))
            else:
                f.write(pack('B', 0))


def create_copy_template(camo_id, colors):
    while True:
        file_name = ''
        for i in range(5):
            file_name += choice(string.ascii_letters)

        for i in range(3):
            file_name += choice(string.digits)

        file_name = file_name.lower() + '.cam'
        file_path = os.path.join(_path, file_name)
        if not os.path.exists(file_path):
            break

    _write_to_file(file_path, camo_id, colors)
    return {'name': file_name,
     'camo_id': camo_id,
     'colors': colors}


def save_template(name, camo_id, colors):
    if not os.path.exists(_path):
        os.makedirs(_path)
    file_name = name + '.cam'
    file_path = os.path.join(_path, file_name)
    if os.path.exists(file_path):
        return None
    else:
        _write_to_file(file_path, camo_id, colors)
        return {'name': file_name,
         'camo_id': camo_id,
         'colors': colors}


def rewrite_template(file_name, camo_id, colors):
    file_path = os.path.join(_path, file_name)
    _write_to_file(file_path, camo_id, colors)


def delete_templates(file_names):
    if not os.path.exists(_path):
        return
    for file_name in file_names:
        file_path = os.path.join(_path, file_name)
        if os.path.exists(file_path):
            os.remove(file_path)


def load_all_templates():
    result = []
    if not os.path.exists(_path):
        return result
    else:
        for file_name in os.listdir(_path):
            file_path = os.path.join(_path, file_name)
            if not os.path.isfile(file_path):
                continue
            with open(file_path, 'rb') as f:
                camo_id = unpack('H', f.read(2))[0]
                colors = []
                for i in range(4):
                    has_color = unpack('B', f.read(1))[0]
                    if has_color:
                        color = unpack('BBB', f.read(3))
                        colors.append(color + (255,))
                    else:
                        colors.append(None)

                result.append({'name': file_name,
                 'camo_id': camo_id,
                 'colors': colors})

        result.sort(key=lambda r: os.path.getmtime(os.path.join(_path, r['name'])), reverse=True)
        return result