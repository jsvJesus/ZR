# Embedded file name: ./client/soGUI/equip_paint/paint_block/color_picker.py
from Localization import lc
import colorCodes as cc
from utils import Listenable
import DyeConstant
import Keys
import GUI
from soGUI.equip_paint.equip_block.equip_tablegrid import ItemDataET as EquipItemDataET
