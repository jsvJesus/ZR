# Embedded file name: ./client/soGUI/equip_paint/paint_block/emblem/emblem_tablegrid.py
import ItemsUtils
import colorCodes as cc
import GUI
from soGUI.equip_paint.tablegrid.tablegrid import TableGrid, Cell
from soGUI.equip_paint.tablegrid.table_model import TableModel, ItemData, EventType as TableET
import UCManager
from soGUI.equip_paint.eqp_button import EqpButton
from sounds_manager import playSound

class CellET:
    OnSelectRequested, OnLoadRequested = ((r, 'emblemcell') for r in range(2))


class EmblemCell(Cell):

    def __init__(self, component):
        Cell.__init__(self, component)
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.filterType = 'LINEAR'
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.7)
        self.component.addChild(comp, 'image')
        comp = GUI.Window('soGUI/frame/paint/borderslot.dds')
        comp.materialFX = 'SOLID'
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.9)
        comp.width, comp.height = (2, 2)
        comp.visible = False
        self.component.addChild(comp, 'selection')

    def _on_mouse_down(self):
        data = {'item': self._item}
        self.notify_listeners(CellET.OnSelectRequested, data)

    def _update_visual(self):
        if not self._item:
            return
        if self._item.selected:
            self.component.selection.visible = True
            self.component.image.colour[3] = 230
        else:
            self.component.selection.visible = False
            self.component.image.colour[3] = 64

    def _on_itemdata_event(self, event_type, data):
        Cell._on_itemdata_event(self, event_type, data)
        if event_type == ItemDataET.OnSelectionChanged:
            self._update_visual()


class ColoredCell(EmblemCell):

    def __init__(self, component):
        EmblemCell.__init__(self, component)
        comp = self.component.image
        comp.width, comp.height = self.component.width - 2, self.component.height - 2
        comp = GUI.Window('soGUI/frame/paint/needbuy.dds')
        comp.materialFX = 'BLEND'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (0.8, 0.8, 0.2)
        self.component.addChild(comp, 'needbuy')

    def _icon_loaded(self, emblem_id, feed_name, texture):
        if self._item and self._item.emblem_id == emblem_id:
            self.component.image.texture = texture
        self._update_visual()

    def _update_visual(self):
        EmblemCell._update_visual(self)
        if self._item and self.component.needbuy.visible:
            if not self._item.selected:
                self.component.image.colour[3] = 32

    def set_item(self, item):
        EmblemCell.set_item(self, item)
        if item:
            if item.need_buy:
                self.component.image.texture = item.emblem_id
                self.component.needbuy.visible = True
            else:
                UCManager.ucmanager.loadImg(item.emblem_id, self._icon_loaded)
                self.component.needbuy.visible = False
        self._update_visual()

    def _on_itemdata_event(self, event_type, data):
        EmblemCell._on_itemdata_event(self, event_type, data)
        if event_type == ItemDataET.OnEmblemLoaded:
            self.component.needbuy.visible = False


class DelCell(EmblemCell):

    def __init__(self, component):
        EmblemCell.__init__(self, component)
        comp = self.component.image
        comp.filterType = 'LINEAR'
        comp.width, comp.height = self.component.width * 0.5, self.component.height * 0.5
        comp.textureName = 'soGUI/frame/paint/no_camo.dds'

    def set_item(self, item):
        EmblemCell.set_item(self, item)
        self._update_visual()


class LoadCell(EqpButton, EmblemCell):

    def __init__(self, component):
        EmblemCell.__init__(self, component)
        EqpButton.__init__(self, component)
        comp = self.component.image
        comp.filterType = 'LINEAR'
        comp.width, comp.height = self.component.width * 0.5, self.component.height * 0.5
        comp.textureName = 'soGUI/frame/paint/load_emblem.dds'

    def update_visual(self, hovered, pressed):
        if pressed:
            color = cc.inactive_rgba
        elif hovered:
            color = cc.active_rgba
        else:
            color = cc.inactive_rgba
        self.component.image.colour = color

    def handleMouseEnterEvent(self, comp):
        playSound('ui/equip_modification/soft_hover')
        return EqpButton.handleMouseEnterEvent(self, comp)

    def _on_mouse_down(self):
        pass

    def on_click(self):
        self.notify_listeners(CellET.OnLoadRequested)


class ItemDataET:
    OnSelectionChanged, OnEmblemLoaded = ((r, 'emblemitemdata') for r in range(2))


class EmblemItemData(ItemData):

    def __init__(self, item):
        ItemData.__init__(self, item)
        self._selected = False

    @property
    def emblem_id(self):
        return self._item and self._item['emblem_id']

    def load_emblem(self, emblem_id):
        self._item['emblem_id'] = emblem_id
        self.notify_listeners(ItemDataET.OnEmblemLoaded)

    @property
    def need_buy(self):
        return ItemsUtils.is_textured_emblem(self.emblem_id)

    @property
    def selected(self):
        return self._selected

    @selected.setter
    def selected(self, value):
        if self._selected == value:
            return
        self._selected = value
        self.notify_listeners(ItemDataET.OnSelectionChanged)


class EmblemTableET:
    OnNeedBuyChanged, OnSelectedChanged = ((r, 'enblemtableet') for r in range(2))


class EmblemTableModel(TableModel):

    def __init__(self):
        TableModel.__init__(self)
        self._selected = None
        self._need_buy = False
        return

    def _create_item_data(self, item):
        return EmblemItemData(item)

    def set_selected(self, emblem_id):
        if emblem_id:
            self.selected = next((item for item in self._items if item.emblem_id == emblem_id), None)
        else:
            self.selected = self._items[0]
        return

    def deselect(self):
        self.selected = None
        return

    def select_item(self, item):
        self.selected = item

    def find_item(self, emblem_id):
        return next((item for item in self._items if item.emblem_id == emblem_id), None)

    def notify_listeners(self, event_type, data = None):
        TableModel.notify_listeners(self, event_type, data)
        if event_type in (TableET.OnItemAppended,
         TableET.OnItemsSet,
         TableET.OnItemsDeleted,
         TableET.OnItemPrepended):
            self.need_buy = any((item.need_buy for item in self._items))

    def _on_item_event(self, event_type, data):
        TableModel._on_item_event(self, event_type, data)
        if event_type == ItemDataET.OnEmblemLoaded:
            self.need_buy = any((item.need_buy for item in self._items))

    @property
    def need_buy(self):
        return self._need_buy

    @need_buy.setter
    def need_buy(self, value):
        if self._need_buy == value:
            return
        self._need_buy = value
        self.notify_listeners(EmblemTableET.OnNeedBuyChanged)

    @property
    def selected(self):
        return self._selected

    @selected.setter
    def selected(self, value):
        if value == self._selected:
            return
        if self._selected:
            self._selected.selected = False
        self._selected = value
        if self._selected:
            self._selected.selected = True
        self.notify_listeners(EmblemTableET.OnSelectedChanged)


class TableGridET:
    OnEmblemChanged, OnLoadRequested = ((r, 'emblemtablegrid') for r in range(2))


class EmblemTableGrid(TableGrid):

    def _get_cell_class(self, col, row):
        if row == 0:
            if col == 0:
                return DelCell
            if col == 1:
                return LoadCell
        return ColoredCell

    def _on_cell_event(self, event_type, data):
        if event_type == CellET.OnSelectRequested:
            data = {'emblem_id': data['item'].emblem_id}
            prev_selected = self._tm.selected
            self.notify_listeners(TableGridET.OnEmblemChanged, data)
            if self._tm.selected != prev_selected:
                playSound('ui/menu_click')
        elif event_type == CellET.OnLoadRequested:
            self.notify_listeners(TableGridET.OnLoadRequested)