# Embedded file name: ./client/soGUI/equip_paint/paint_block/emblem/emblem_view.py
from functools import partial
from itertools import chain
import BigWorld
import ResMgr
import DyeConstant
from Items import ItemsCatalog
from Localization import lc
import ItemsUtils
import GUI
from soGUI.equip_paint.tabview.tabview import View
from emblem_tablegrid import EmblemTableGrid, EmblemTableModel, TableGridET, EmblemTableET
import UCManager
from soGUI.donat_shop.window.auxwins.auxwins import Auxwins
from soGUI.equip_paint.equip_block.equip_tablegrid import ItemDataET as EquipItemET
import BWPersonality
from soGUI.file_finder.file_finder import InvalidPath

class EmblemViewET:
    OnUploadRequest, = ((r, 'emblemview') for r in range(1))


class EmblemView(View):

    def __init__(self, component, finder_comp):
        View.__init__(self, component)
        self._finder_comp = finder_comp
        self._item = None
        self._tm = EmblemTableModel()
        self._tm.add_listener(self._on_tm_event)
        comp = GUI.Simple(u'')
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'base')
        comp = GUI.Window()
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.5)
        self._table_grid = EmblemTableGrid(comp, self._tm)
        self._table_grid.add_listener(self._on_tablegrid_event)
        self.component.base.addChild(comp)
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'BLEND'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.colour = (255,
         255,
         255,
         127.5)
        comp.position = (0, 0, 0.2)
        comp.visible = False
        self.component.addChild(comp)
        return

    def feed_dependencies(self, buy_txt, buy_btn):
        self._buy_txt, self._buy_btn = buy_txt, buy_btn
        self._buy_btn.on_click = self._on_buy_click

    def _on_buy_click(self):
        emblem_item = self._tm.selected
        data = {'tickets': DyeConstant.COST_UPLOAD_EMBLEM[ItemsCatalog.EVENT_TICKET['TypeID']],
         'texture': emblem_item.emblem_id}
        self.notify_listeners(EmblemViewET.OnUploadRequest, data)

    def _update_buy_txt(self):
        self._buy_txt.visible = self._tm.need_buy

    def _update_buy_btn(self):
        self._buy_btn.component.visible = bool(self.component.visible and self._tm.selected and self._tm.selected.need_buy)

    def on_show(self, personal_emblems, standard_emblems):
        data = [ {'emblem_id': emblem_id} for emblem_id in chain([None, None] + personal_emblems + standard_emblems) ]
        self._tm.set_items(data)
        self._update_buy_txt()
        self._update_buy_btn()
        return

    def on_active_changed(self, active):
        self._update_buy_btn()

    def _on_tm_event(self, event_type, data):
        if event_type == EmblemTableET.OnNeedBuyChanged:
            self._update_buy_txt()
            self._update_buy_btn()
        if event_type == EmblemTableET.OnSelectedChanged:
            self._update_buy_btn()

    def set_item(self, item):
        if self._item:
            self._item.remove_listener(self._on_equipitem_event)
        self._item = item
        if self._item:
            self._item.add_listener(self._on_equipitem_event)
        if item and ItemsUtils.can_be_emblemed(item.item_type):
            self._tm.set_selected(item.emblem_id)
        else:
            self._tm.deselect()

    def _on_equipitem_event(self, event_type, data):
        if event_type == EquipItemET.OnEmblemChanged:
            self._tm.set_selected(self._item.emblem_id or None)
        return

    def _on_tablegrid_event(self, event_type, data):
        if event_type == TableGridET.OnEmblemChanged:
            if self._item and ItemsUtils.can_be_emblemed(self._item.item_type):
                self._item.emblem_id = data['emblem_id']
        elif event_type == TableGridET.OnLoadRequested:
            BWPersonality.GUICore.file_finder.show(self._finder_comp, self._on_browser_result, depth=0.01)

    def _on_browser_result(self, path):
        hide_finder = BWPersonality.GUICore.file_finder.hide
        if not path:
            hide_finder()
            return
        if path is InvalidPath:
            Auxwins.show_ok_message(lc('PaintScreen.emblems.INVALID_PATH'))
            return
        result, path, error = UCManager.ucmanager.converToDDS(path)
        if not result:
            Auxwins.show_ok_message(lc('PaintScreen.emblems.BAD_FORMAT'))
            return
        ResMgr.purge(path)
        texture = BigWorld.PyTextureProvider(path, 3)
        if texture.height > 128 or texture.width > 128:
            strsize = '{0}x{1}'.format(texture.width, texture.height)
            Auxwins.show_ok_message(lc('colourItemWindow.ERROR_SIZE').format(strsize))
            return
        self._tm.prepend_item({'emblem_id': texture})
        hide_finder()

    def _update_height(self):
        self.height = self._table_grid.component.height

    def do_reposition(self, reposition_data):
        View.do_reposition(self, reposition_data)
        cols, rows = reposition_data['paint_cols'], reposition_data['paint_rows']
        cell_size = reposition_data['cell_size']
        scroll_width = reposition_data['scroll_width']
        emblem_table_height = cell_size * rows
        emblem_table_width = cell_size * cols + scroll_width
        comp = self._table_grid.component
        comp.width, comp.height = emblem_table_width, emblem_table_height
        self._table_grid.do_reposition(cols, rows, cell_size, cell_size, scroll_width)
        self._update_height()