# Embedded file name: ./client/soGUI/equip_paint/paint_block/paint_tabview.py
import BWPersonality
from Localization import lc
from ..tabview.tabview import TabView
from cammo.paint_view import PaintView
from color_picker import PickerET
from emblem.emblem_view import EmblemView, EmblemViewET
from templates.templates_view import TemplatesView, TemplatesViewET
from soGUI.donat_shop.window.auxwins.auxwins import Auxwins
import templates_loader
from sounds_manager import playSound

class PaintTabView(TabView):

    def __init__(self, component, finder_comp):
        self._finder_comp = finder_comp
        TabView.__init__(self, component)

    def _on_active_changed(self, active, prev_active):
        if BWPersonality.GUICore.filefinder_visible():
            BWPersonality.GUICore.file_finder.hide()
        if active and prev_active:
            playSound('ui/equip_modification/soft_click')

    def _create_pages(self):
        self._paint_view = PaintView(self._create_view_comp())
        self._paint_view.add_listener(self._on_paintview_event)
        paint_page = {'header': lc('EquipPaint.painttab.btnpaint'),
         'view': self._paint_view}
        emblems_page = {'header': lc('EquipPaint.painttab.btnemblems'),
         'view': EmblemView(self._create_view_comp(), self._finder_comp)}
        self._templates_view = TemplatesView(self._create_view_comp())
        self._templates_view.add_listener(self._on_templatesview_event)
        templates_page = {'header': lc('EquipPaint.painttab.btntemplates'),
         'view': self._templates_view}
        return [paint_page, emblems_page, templates_page]

    def _on_templatesview_event(self, event_type, data):
        if event_type == TemplatesViewET.OnTemplateDeleteRequested:
            templates_loader.delete_templates(data['file_names'])
            self._templates_view.on_templates_deleted(data['file_names'])
        elif event_type == TemplatesViewET.OnRewriteClick:
            templates_loader.rewrite_template(data['name'], data['camo_id'], data['colors'])
            self._templates_view.on_template_rewritten(data['name'])
        elif event_type == TemplatesViewET.OnNewClick:
            template = templates_loader.create_copy_template(data['camo_id'], data['colors'])
            self._templates_view.on_template_created(template)
            self._templates_view.restore_original(data['name'])

    def _on_paintview_event(self, event_type, data):
        if event_type == PickerET.OnSaveClick:

            def okcallback(text):
                if not text:
                    return
                template = templates_loader.save_template(text, data['camo_id'], data['colors'])
                if template:
                    self._templates_view.on_template_created(template)
                else:
                    Auxwins.show_ok_message(lc('EquipPaint.painttab.btnpaint.badname'))

            btns_data = [{'text': lc('EquipPaint.painttab.btnpaint.saveok'),
              'callback': okcallback}, {'text': lc('EquipPaint.painttab.btnpaint.savecancel')}]

            def callback():
                Auxwins.show_tf_message(lc('EquipPaint.painttab.btnpaint.saveconfirm'), btns_data)

            Auxwins.show_ok_message(lc('EquipPaint.painttab.btntemplates.notify'), callback=callback)

    def on_show(self, personal_emblems, standard_emblems):
        self._emblem_view.on_show(personal_emblems, standard_emblems)

    def _on_view_event(self, event_type, data):
        TabView._on_view_event(self, event_type, data)
        if event_type == EmblemViewET.OnUploadRequest:
            self.notify_listeners(event_type, data)

    def set_item(self, item):
        self._paint_view.set_item(item)
        self._emblem_view.set_item(item)
        self._templates_view.set_item(item)

    def do_reposition(self, reposition_data):
        reposition_data['header_height'] = reposition_data['paint_header_height']
        reposition_data['font_size'] = 26
        TabView.do_reposition(self, reposition_data)

    def reset(self):
        self._templates_view.restore_original()

    @property
    def _emblem_view(self):
        return self._views[1]