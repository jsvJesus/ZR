# Embedded file name: ./client/soGUI/transformation_help.py
import BWPersonality
from Helpers.PyGUI import PyGUIBase
from soGUI.soButton import soButton
import GUI
import re
import traceback
import BigWorld
import utils

class TransformationHelp(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._loop_id = 0
        self._timers = {}
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 0, 0, 100)
        cmp.materialFX = 'BLEND'
        cmp.height = 500
        cmp.width = 400
        cmp.position = (10, 100, 0.1)

    def setupContent(self):
        btn = soButton(GUI.Window())
        cmp = btn.component
        btn.initVSC('soGUI/elements/button_transforamtionhelp.xml')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.label.font = 'RobotoCondensedRegular_16.font'
        cmp.label.text = 'i'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 30
        cmp.height = 30
        cmp.position = (2, 2, 0.1)
        cmp.script.setDisabledState(False)
        cmp.script.onClick = self.switchSpoiler
        self.component.addChild(cmp, 'switchspoiler')
        btn.onBound()
        cmp = GUI.Simple('textures/default/black.dds')
        cmp.verticalPositionMode = cmp.horizontalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 300
        cmp.height = 300
        cmp.colour = (255, 255, 255, 100)
        cmp.materialFX = 'BLEND'
        cmp.position = (2, 32, 0.9)
        self.component.addChild(cmp, 'text_frame')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.multiline = True
        cmp.colourFormatting = True
        cmp.font = 'RobotoCondensedRegular_20.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (15, 40, 0.3)
        self.component.addChild(cmp, 'help_text')

    def switchSpoiler(self):
        show = not self.component.help_text.visible
        self.component.help_text.visible = show
        self.component.text_frame.visible = show

    def show(self, text = ''):
        self._timers = {}
        self.component.visible = True
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild('TransformationHelp')
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'TransformationHelp')
        self._prepareText(text)
        self.component.help_text.visible = True
        self.component.text_frame.visible = True
        self._updateText()
        if self._loop_id:
            BigWorld.cancelCallback(self._loop_id)
            self._loop_id = 0
        self._loop_id = BigWorld.callback(1.0, self._loop)
        return

    def hide(self):
        self.component.visible = False
        if self._loop_id:
            BigWorld.cancelCallback(self._loop_id)
            self._loop_id = 0

    def _prepareText(self, text):
        self._timers = {}
        for key in re.findall(u'\\{[a-zA-Z-|]+\\}', text):
            key = key.strip('}{')
            self._timers[key] = u''
            try:
                act_type, skillname = key.split('|', 1)
            except:
                print 'error for', repr(key)
                traceback.print_exc()
                continue

            if act_type == 'reuseTimer':
                self._timers[key] = skillname

        self._base_text = text

    def _loop(self):
        if not self.component.visible:
            return
        if not self._timers:
            return
        self._updateText()
        self._loop_id = BigWorld.callback(1.0, self._loop)

    def _updateText(self):
        text = '???'
        texttimers = {}
        try:
            pl = BigWorld.player()
            for key, skillname in self._timers.items():
                skill = pl.active_transform.getSkillByName(skillname)
                delay = skill.getReuseTime()
                if delay <= 0:
                    texttimers[key] = ''
                    continue
                texttimers[key] = utils.secToTimerText(delay)

            text = self._base_text.format(**texttimers)
        except:
            traceback.print_exc()

        if self.component.help_text.text != text:
            self.component.help_text.text = text
            w, h = self.component.help_text.stringDimensions(text)
            self.component.text_frame.width = max(50, w + 30)
            self.component.text_frame.height = max(50, h + 25)