            self.model.effectorright = model

        self._fetch_gun_model(onLoadGunModel)

    def setModel(self, clear = False):
        if clear:
            self.model = None
        else:
            if self.model:
                savedActionQueue = ResMgr.DataSection('savedActionQueue')
                self.model.saveActionQueue(savedActionQueue)
            else:
                savedActionQueue = None
            self.compileModel()
        return

    def compileModel(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0.
        
        \xd0\x95\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb5\xd1\x81\xd1\x82\xd1\x8c prymary \xd0\xbe\xd1\x80\xd1\x83\xd0\xb6\xd0\xb8\xd0\xb5, \xd1\x82\xd0\xbe \xd1\x81 \xd0\xbe\xd1\x80\xd0\xb8\xd0\xb6\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xb2 \xd1\x80\xd1\x83\xd0\xba\xd0\xb5.
        """
        if self.character:
            active_weapon_data = self.character['active_weapon_data']
        else:
            active_weapon_data = ItemsUtils.default_active_weapon_data()
        self.ActiveWeaponSet = dict(active_weapon_data['qiuck_weapon_set'])
        self.ActiveItemID = 0
        self.coloriseEmblems = self.character.coloriseEmblems if self.character else []
        self.colorDelegates = self.character.colorDelegates if self.character else []
        StalkerModel.ComposePlayerModelTraker(self, callback=self.onLoadModel)

    def _fetch_gun_model(self, callback):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd1\x80\xd1\x83\xd0\xb6\xd0\xb8\xd1\x8f."""
        gun_model = None
        self.primary_gun_model = None
        self.secondary_gun_model = None
        if self.ActiveWeaponSet['PrimarySlotID'] and self.ActiveWeaponSet['PrimarySlotType'] != 14:
            self.fetchModelByNamesDict(self.GetEquippedItemModels(ItemsCatalog.PRIMARY), callback)
            self.ActiveWeaponSet['PrimarySlotID'] = 0
            self.ActiveWeaponSet['PrimarySlotType'] = 0
            self.ActiveWeaponSet['PrimarySlotTintID'] = 0
        elif self.ActiveWeaponSet['SecondarySlotID'] and gun_model is None:
            self.fetchModelByNamesDict(self.GetEquippedItemModels(ItemsCatalog.SECONDARY), callback)
            self.ActiveWeaponSet['SecondarySlotID'] = 0
            self.ActiveWeaponSet['SecondarySlotType'] = 0
            self.ActiveWeaponSet['SecondarySlotTintID'] = 0
        else:
            callback(None)
        return

    def GetEquippedItemModels(self, secondary_primary_active):
        return {}

    def getModelByNamesDict(self, names_dict):
        core_model = None
        if names_dict:
            body_entry = names_dict[ItemsCatalog.BODY]
            try:
                core_model = BigWorld.Model(body_entry[ItemsUtils.MODEL_LIST_POSITION])
            except:
                traceback.print_exc()
                print 'Error load gun model:', self
                print 'names_dict', names_dict
                print 'body_entry', body_entry
                print 'key', ItemsUtils.MODEL_LIST_POSITION
                print 'core_models', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                print
                return

            tint_dict = body_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
            if tint_dict:
                for tint_key in tint_dict:
                    try:
                        setattr(core_model, tint_key, tint_dict[tint_key])
                    except:
                        traceback.print_exc()
                        print 'ERROR set tint model', repr(tint_key), repr(tint_dict[tint_key])
                        print 'models:', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print

            del names_dict[ItemsCatalog.BODY]
            if names_dict:
                for model_entry in names_dict.values():
                    if model_entry[ItemsUtils.MODEL_LIST_POSITION]:
                        try:
                            model = BigWorld.Model(model_entry[ItemsUtils.MODEL_LIST_POSITION])
                        except:
                            traceback.print_exc()
                            print 'ERROR load gun attach model:'
                            print [model_entry[ItemsUtils.MODEL_LIST_POSITION]]
                            print
                            continue

                    else:
                        continue
                    tint_dict = model_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
                    if tint_dict:
                        for tint_key in tint_dict:
                            if hasattr(model, tint_key):
                                setattr(model, tint_key, tint_dict[tint_key])

                    try:
                        setattr(core_model, model_entry[ItemsUtils.MODEL_HP_POSITION], model)
                    except ValueError:
                        print 'Cant attach model at hp', model_entry[ItemsUtils.MODEL_HP_POSITION], ' model name ', model_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print 'core_model', core_model.sources
                        traceback.print_exc()
                        return core_model
                    except AttributeError:
                        print 'Cant attach model at hp', model_entry[ItemsUtils.MODEL_HP_POSITION], ' model name ', model_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print 'core_model', core_model.sources
                        traceback.print_exc()
                        return core_model

        return core_model

    def fetchModelByNamesDict(self, names_dict, callback):
        core_model = None

        def onLoadCoreModel(model):
            core_model = model
            tint_dict = body_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
            if tint_dict:
                for tint_key in tint_dict:
                    try:
                        setattr(core_model, tint_key, tint_dict[tint_key])
                    except:
                        traceback.print_exc()
                        print 'ERROR set tint model', repr(tint_key), repr(tint_dict[tint_key])
                        print 'models:', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print

            del names_dict[ItemsCatalog.BODY]
            if names_dict:
                for model_entry in names_dict.values():
                    if model_entry[ItemsUtils.MODEL_LIST_POSITION]:

                        def onLoadModel(_model_entry, model):
                            tint_dict = _model_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
                            if tint_dict:
                                for tint_key in tint_dict:
                                    if hasattr(model, tint_key):
                                        setattr(model, tint_key, tint_dict[tint_key])

                            try:
                                setattr(core_model, _model_entry[ItemsUtils.MODEL_HP_POSITION], model)
                            except ValueError:
                                print 'Cant attach model at hp', repr(_model_entry[ItemsUtils.MODEL_HP_POSITION]), ' model name ', _model_entry[ItemsUtils.MODEL_LIST_POSITION]
                                print 'core_model', core_model.sources
                                traceback.print_exc()
                            except AttributeError:
                                print 'Cant attach model at hp', _model_entry[ItemsUtils.MODEL_HP_POSITION], ' model name ', _model_entry[ItemsUtils.MODEL_LIST_POSITION]
                                print 'core_model', core_model.sources
                                traceback.print_exc()

                        try:
                            BigWorld.fetchModel(model_entry[ItemsUtils.MODEL_LIST_POSITION], partial(onLoadModel, model_entry))
                        except:
                            traceback.print_exc()
                            print 'ERROR load gun attach model:'
                            print [model_entry[ItemsUtils.MODEL_LIST_POSITION]]
                            print
                            continue

                    else:
                        continue

            callback(core_model)

        if names_dict:
            body_entry = names_dict[ItemsCatalog.BODY]
            try:
                BigWorld.fetchModel(body_entry[ItemsUtils.MODEL_LIST_POSITION], onLoadCoreModel)
            except:
                traceback.print_exc()
                print 'Error load gun model:', self
                print 'names_dict', names_dict
                print 'body_entry', body_entry
                print 'key', ItemsUtils.MODEL_LIST_POSITION
                print 'core_models', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                print
                callback(core_model)
                return

        return