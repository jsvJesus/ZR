# Embedded file name: ./client/soGUI/QuestsBoard.py
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from soGUI.soList_optimized import soList_optimized
import GUI
import soGUI
import QuestDispatcher as QD
from soGUI.soTextField import soTextField2
from soTextField import soTxtFieldPropsStructure
import colorCodes
from soGUI.soButton import soButton
from msgbox_templates import ask_yes_no
from gui_const import MESSAGEBOX
from Localization import lc

class QuestsBoardDelegate:

    def request_board_quests(self):
        print 'Request board quests, override me'

    def request_quest_from_board(self, quest_id):
        print 'Request quest from board, override me'


class QuestsBoard(PyGUIBase):

    def __init__(self):
        comp = GUI.Window()
        PyGUIBase.__init__(self, comp)
        comp.script = self
        comp.horizontalPositionMode = comp.verticalPositionMode = 'CLIP'
        comp.widthMode = comp.heightMode = 'CLIP'
        comp.horizontalAnchor = 'CENTER'
        comp.verticalAnchor = 'CENTER'
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.width = 2
        comp.height = 2
        comp.position = (0, 0, 0.2)
        comp.widthMode = comp.heightMode = 'PIXEL'
        self._quest_ids = []
        self._setup_content()
        self._delegate = None
        self._selected_quest = None
        return

    def _setup_content(self):
        self._description_ratio = 0.6
        width = self.component.width * (1.0 - self._description_ratio)
        height = self.component.height - 81
        self._quests_list = soList_optimized(GUI.Window(), soGUI.ListPropsStructure(width=width, height=height, elemStyle='soGUI/elements/listElementBoard.xml', isMultiSel=False, elemHeight=35, sorted=False, selectCallBack=self._on_quest_selected), default_frame_skin='', buttons_is_options=False)
        self._quests_list.component.horizontalPositionMode = self._quests_list.component.verticalPositionMode = 'PIXEL'
        self._quests_list.component.widthMode = self._quests_list.component.heightMode = 'PIXEL'
        self._quests_list.component.verticalAnchor = 'TOP'
        self._quests_list.component.horizontalAnchor = 'LEFT'
        self._quests_list.component.position = (4, 54, 0.5)
        self.component.addChild(self._quests_list.component)
        self._quests_list.onBound()
        width = self.component.width * self._description_ratio
        self._title_text = soTextField2(GUI.Window(), soTxtFieldPropsStructure(height=200, width=width, vScroll=False, textureless=True))
        comp = self._title_text.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'CENTER'
        comp.verticalAnchor = 'TOP'
        self.component.addChild(comp)
        self._title_text.onBound()
        self._description_text = soTextField2(GUI.Window(), soTxtFieldPropsStructure(height=800, width=width, vScroll=False, textureless=True, autoSize=True))
        comp = self._description_text.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.position = (self.component.width * (1.0 - self._description_ratio), 110, 0.2)
        self.component.addChild(comp)
        self._description_text.onBound()
        self._take_btn = soButton(GUI.Window())
        comp = self._take_btn.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'CENTER'
        comp.verticalAnchor = 'TOP'
        comp.width = 130
        comp.height = 29
        comp.position = (self.component.width * (1.0 - self._description_ratio) + self.component.width * self._description_ratio * 0.5, 300, 0.2)
        self._take_btn.initVSC('soGUI/elements/button_1.xml')
        self._take_btn.onBound()
        self._take_btn.setVisualState('normal')
        self._take_btn.onClick = self._on_take_quest_click
        comp.label.text = lc('Quests.Board.TAKE_QUEST')
        self.component.addChild(comp)
        self._update_take_button_position()

    def _set_description_text(self, text):
        self._description_text.setText(text)

    def _set_title_text(self, text):
        self._title_text.setText(colorCodes.regular_text_color + text)
        x_position = self.component.width * (1.0 - self._description_ratio) + self.component.width * self._description_ratio - self._title_text.getTxtWidth() * 0.5
        self._title_text.component.position = (x_position, 80, 0.2)

    def _update_take_button_position(self):
        desc_comp = self._description_text.component
        pos = list(self._take_btn.component.position)
        pos[1] = desc_comp.position[1] + desc_comp.height + 20
        self._take_btn.component.position = tuple(pos)
        self._take_btn.component.visible = True

    def _on_take_quest_click(self):

        def callback(event, data):
            if event == MESSAGEBOX.EVENT_BTNPRESS:
                if data['btn'] == MESSAGEBOX.BTN_YES:
                    self.delegate.request_quest_from_board(self._selected_quest)
                    self._take_btn.setDisabledState(True)

        if self._selected_quest:
            ask_yes_no('QuestBoard', lc('Quests.Board.TAKE_QUEST'), QD.getQuestTitleByID(self._selected_quest), callback=callback)

    def _on_quest_selected(self):
        self._take_btn.setDisabledState(False)
        quest_name = self._quests_list.getSelection()[0]
        quest_id = self._quests_list.getAttachment(quest_name)
        self._set_title_text(QD.getQuestTitleByID(quest_id))
        self._set_description_text(QD.get_description_by_id(quest_id))
        self._update_take_button_position()
        self._selected_quest = quest_id

    def show(self):
        self._take_btn.component.visible = False
        self._description_text.setText('')
        self._title_text.setText('')
        self.component.visible = True
        self.delegate.request_board_quests()

    def hide(self):
        self.component.visible = False

    def update_quests(self, quest_ids):
        self._quest_ids = quest_ids
        self._quests_list.clear()
        for quest_id in quest_ids:
            self._quests_list.addElement(QD.getQuestTitleByID(quest_id), quest_id, delayedRender=True)

        self._quests_list.applyElements()

    @property
    def save_blob(self):
        return (self._quest_ids, self.delegate)

    @save_blob.setter
    def save_blob(self, value):
        self._quest_ids, self.delegate = value

    @property
    def delegate(self):
        if not self._delegate:
            self._delegate = QuestsBoardDelegate()
        return self._delegate

    @delegate.setter
    def delegate(self, value):
        self._delegate = value