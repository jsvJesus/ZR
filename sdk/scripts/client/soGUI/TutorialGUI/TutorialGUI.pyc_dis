# Embedded file name: ./client/soGUI/TutorialGUI/TutorialGUI.py
import math
import BigWorld
import GUI
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from soGUI.GUIPositions import GUIPositions
from Helpers.PyGUI.DraggableComponent import DraggableComponent
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
from soGUI.soButton import soButton
from Localization import lc
import steam_client_api
BLINK_NUM = 8
BLINK_TIME = 0.8
BLINK_COLOR = (255, 255, 255, 32)

class TutorialGUI(PyGUIBase, GUIPositions, DraggableComponent):
    factoryString = 'soGUI.soStationTutorialGUI'

    def __init__(self):
        PyGUIBase.__init__(self, GUI.Window())
        DraggableComponent.__init__(self, True, True, True, 0, 0)
        GUIPositions.__init__(self)
        self.component.script = self
        comp = self.component
        comp.heightMode, comp.widthMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (332, 300)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.position = (0, 0, 0.1)
        self._coroutine = None
        self._setup_content()
        return

    def stopDragging(self):
        GUIPositions.stopDragging(self)
        DraggableComponent.stopDragging(self)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def _setup_content(self):
        comp = GUI.Simple('soGUI/frame/back_help1.dds')
        comp.materialFX = 'BLEND'
        comp.heightMode, comp.widthMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 1)
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        self.component.addChild(comp, 'frame')
        comp = GUI.Window()
        comp.heightMode, comp.widthMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (300, 2)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.9)
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        self.component.addChild(comp, 'container')
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.heightMode, comp.widthMode = ('CLIP', 'CLIP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.1)
        comp.materialFX = 'BLEND'
        comp.colour = BLINK_COLOR
        comp.visible = False
        self.component.addChild(comp, 'blinker')
        skip_btn = soButton(GUI.Window())
        comp = skip_btn.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.width, comp.height = (200, 29)
        comp.position = (0, -0.9, 0.2)
        skip_btn.initVSC('soGUI/elements/button_1.xml')
        skip_btn.onBound()
        skip_btn.setVisualState('normal')
        skip_btn.onClick = self._on_skip_click
        comp.label.text = lc('Tutorial.ui.skip_button')
        comp.visible = False
        self.component.addChild(comp, 'skip_button')

    def _on_skip_click(self):
        BigWorld.player().skip_tutorial()

    def show_skip(self, show):
        if steam_client_api.STEAM_MODE:
            self.component.skip_button.visible = show

    def show(self, content_component):
        GUIPositions.show(self)
        self.component.visible = True
        for child_name, _ in self.component.container.children:
            self.component.container.delChild(child_name)

        if content_component:
            self.component.container.addChild(content_component)

    def hide(self):
        for child_name, _ in self.component.container.children:
            self.component.container.delChild(child_name)

        self.component.visible = False

    def _calc_blink_alpha(self, ratio):
        total_angle = math.pi * BLINK_NUM
        fade_angle = total_angle - math.pi * 0.5
        cur_angle = total_angle * ratio
        if cur_angle < fade_angle:
            intencity = abs(math.sin(cur_angle))
        else:
            intencity = 1.0 - (cur_angle - fade_angle) / (total_angle - fade_angle)
        return intencity * BLINK_COLOR[3]

    @BWMemberCoroutine
    def _blink_coroutine(self):
        comp = self.component.blinker
        comp.visible = True
        blink_time = 0.0
        while blink_time < BLINK_TIME:
            comp.colour[3] = self._calc_blink_alpha(blink_time / BLINK_TIME)
            yield BWWaitForPeriod(0)
            blink_time += BigWorld.getTimeDelta()

        comp.visible = False
        self._coroutine = None
        return

    def blink(self):
        if self._coroutine:
            return
        self._coroutine = self._blink_coroutine()
        self._coroutine.run()