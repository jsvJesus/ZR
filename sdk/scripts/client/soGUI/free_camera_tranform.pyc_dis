        def elem(ID, posx, posy, text):
            cmp = GUI.Text(text)
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.verticalAnchor = 'CENTER'
            cmp.horizontalAnchor = 'LEFT'
            cmp.font = 'RobotoCondensedRegular_16.font'
            cmp.colour = (175, 166, 112, 150)
            cmp.position = (posx, posy, 0.0)
            cmp.multiline = 1
            self.component.addChild(cmp, 'elem_%s' % ID)
            self._property[ID] = cmp

        pos_y += 5
        elem(EV.TH_TRAP, 10, pos_y, u'1-\u0442\u043b')
        elem(EV.WHEELS, 10, pos_y + 15, u'4-\u043a\u043e\u043b\u0435\u0441\u0430')
        elem(EV.FLY_STOP, 10, pos_y + 30, u'5-\u043c\u043e\u0442\u043e\u0440 \u0441\u0442\u043e\u043f')
        elem(EV.LOCK_YAW, 10, pos_y + 45, u'6-lock_yaw')
        elem(EV.PANIC_ROTATE, 10, pos_y + 60, u'7-\u043f\u0430\u043d\u0438\u043a\u0430')
        elem(EV.BURN, 120, pos_y, u'9-\u0433\u043e\u0440\u0435\u0442\u044c')
        elem(EV.PITCH_ENTIY, 120, pos_y + 15, u'MMB-\u043d\u0430\u043a\u043b\u043e\u043d')
        elem(EV.FPS, 120, pos_y + 30, u'CapsLock-fps')

    def updateProp(self, props):
        for ID, comp in self._property.items():
            if props.get(ID, None):
                comp.colour = (255, 166, 112, 255)
            else:
                comp.colour = (175, 166, 112, 150)

        return

    def _switchSound(self, *e):
        pl = BigWorld.player()
        if not pl.vechicle_contorled:
            return
        if not pl.vechicle_contorled._sound1:
            return
        if pl.vechicle_contorled._fly_stop_status:
            return
        s = pl.vechicle_contorled._sound1
        s.muted = not s.muted

    def _switchLookAround(self, *e):
        pl = BigWorld.player()
        pl.LookAround(not pl.lookingaround)

    def onLockPitch(self, *e):
        lock = self.component.lockPitch.script.isChecked()
        BigWorld.player()._transform_fly_lock_pitch = lock

    def onSpeedChange(self, val):
        self._speed_scroll.setValue(val)
        percent = float(val) / self._scroll_steps
        new_speed = (max_speed - min_speed) * percent + min_speed
        self.component.speed_label.text = 'speed: %.1f        [Ctrl+Wheel]' % new_speed
        BigWorld.player()._transform_fly_speed = new_speed

    def onFovChange(self, val):
        self._fov_scroll.setValue(val)
        percent = float(val) / self._scroll_steps
        new_fov = (max_fov - min_fov) * percent + min_fov
        self.component.fov_label.text = 'fov: %.5f' % new_fov
        BigWorld.projection().rampFov(new_fov, 1.0)

    def onPivotDistChange(self, val):
        self._pivot_dist_scroll.setValue(val)
        percent = float(val) / self._scroll_steps
        new_piv = (max_piv - min_piv) * percent + min_piv
        self.component.pivot_dist_label.text = 'pivot dist: %.5f       [Shift+Wheel]' % new_piv
        BigWorld.camera().pivotMaxDist = new_piv

    def onAddYawChange(self, val):
        self._pivot_add_yaw.setValue(val)
        percent = float(val) / self._scroll_steps
        max_yaw = 0.01
        min_yaw = 0.0
        add_yaw = (max_yaw - min_yaw) * percent + min_yaw
        self.component.add_yaw_label.text = 'rotate speed: %.5f' % add_yaw
        BigWorld.player()._transform_fly_add_yaw = add_yaw

    def _resetFov(self):
        percent = (player_speed_settings.FOV.DEFAULT_FOV - min_fov) / (max_fov - min_fov)
        step = self._scroll_steps * percent
        self.onFovChange(int(step))

    def _resetSpeed(self):
        player = BigWorld.player()
        if not player:
            return
        if not hasattr(player, '_transform_fly_speed'):
            return
        percent = (player._transform_fly_speed - min_speed) / (max_speed - min_speed)
        step = self._scroll_steps * percent
        self.onSpeedChange(int(step))

    def _resetLock(self):
        player = BigWorld.player()
        if not player:
            return
        if not hasattr(player, '_transform_fly_lock_pitch'):
            return
        if player._transform_fly_lock_pitch:
            self.component.lockPitch.script.setActive()
        else:
            self.component.lockPitch.script.setInactive()

    def _switchLaser(self, *e):
        player = BigWorld.player()
        vechicle_contorled = getattr(player, 'vechicle_contorled', None)
        if vechicle_contorled:
            vechicle_contorled._show_laser = not vechicle_contorled._show_laser
        return

    def _switchMark(self, *e):
        player = BigWorld.player()
        vechicle_contorled = getattr(player, 'vechicle_contorled', None)
        if vechicle_contorled:
            vechicle_contorled._show_players = not vechicle_contorled._show_players
        return

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def _update(self):
        self._resetFov()
        self._resetSpeed()
        self._resetLock()

    def doReposition(self):
        self.component.position = (0.0, 0.0, 0.99)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.visible = True
        self.component.position = (1, -1, 0.1)
        self._update()
        player = BigWorld.player()
        if player.vechicle_contorled:
            player.vechicle_contorled.updatePropGui()
        return

    def close(self):
        self.component.visible = False

    def hide(self):
        if self.component.visible:
            BigWorld.projection().rampFov(player_speed_settings.FOV.DEFAULT_FOV, player_speed_settings.FOV.DEFAULT_FOV_RF_TIME)
            self.component.visible = False