    def update(self):
        self.component.wnd.frame.my_clan.script.text = BigWorld.player().clanName.decode('utf-8')
        if BigWorld.player().clanUnion:
            self.component.wnd.frame.my_union.script.text = BigWorld.player().clanUnion.decode('utf-8')
            self.component.wnd.frame.my_union.label.colour = (0, 255, 0, 255)
            self.component.wnd.frame.my_union.visible = 1
        else:
            self.component.wnd.frame.my_union.script.text = lc('PlayerAvatarForSoClanScreen.client.NO_UNION')
            self.component.wnd.frame.my_union.label.colour = (146, 146, 146, 255)
            self.component.wnd.frame.my_union.visible = 0
        p = BigWorld.player()
        if len(self.clan_war_controls) != len(p.clan_myenemies) or len(self.clan_ally_controls) != len(p.clan_unenemies):
            self.fix_clan_contols()
        self.component.wnd.frame.dropdown_union.visible = 1
        self.component.wnd.frame.bcg2.visible = 1
        self.component.wnd.frame.my_union.visible = 1
        self.component.wnd.frame.label_union.visible = 1
        self.component.wnd.frame.bcg_war.position.y = self.component.wnd.frame.label_war.position.y + 3
        self.component.wnd.frame.dropdown_war.position.y = self.component.wnd.frame.label_war.position.y + 3
        if p.clan_myenemies:
            y = self.component.wnd.frame.my_war.position.y
            index = 0
            for i, clan_name in enumerate(p.clan_myenemies):
                self.clan_war_controls[i].script.text = clan_name.decode('utf-8')
                self.clan_war_controls[i].position.y = i * 30 + y

            self.component.wnd.frame.my_war.visible = False
            self.component.wnd.frame.height = self.clan_war_controls[-1].position.y + 30
            self.component.wnd.frame.label_un_war.position.y = self.clan_war_controls[-1].position.y + 30
        else:
            self.component.wnd.frame.my_war.visible = True
            self.component.wnd.frame.my_war.text = lc('PlayerAvatarForSoClanScreen.client.NO_WAR')
            self.component.wnd.frame.height = self.component.wnd.frame.my_war.position.y + 30
            self.component.wnd.frame.label_un_war.position.y = self.component.wnd.frame.my_war.position.y + 30
        self.component.wnd.frame.my_un_war.position.y = self.component.wnd.frame.label_un_war.position.y + 30
        if p.clan_unenemies:
            y = self.component.wnd.frame.my_un_war.position.y
            for i, clan_name in enumerate(p.clan_unenemies):
                self.clan_ally_controls[i].script.text = clan_name.decode('utf-8')
                self.clan_ally_controls[i].position.y = i * 30 + y

            self.component.wnd.frame.my_un_war.visible = False
            self.component.wnd.frame.height = self.clan_ally_controls[-1].position.y + 30
        else:
            self.component.wnd.frame.my_un_war.visible = True
            self.component.wnd.frame.my_un_war.text = lc('PlayerAvatarForSoClanScreen.client.NO_WAR')
            self.component.wnd.frame.height = self.component.wnd.frame.my_un_war.position.y + 30
        self.scrollStep = 30
        scrollStepCount = (self.component.wnd.frame.height - 360) / float(self.scrollStep)
        if scrollStepCount > 0:
            self.scroll.setSteps(math.ceil(scrollStepCount))
        else:
            self.scroll.setSteps(0)
        for i, key in enumerate(['my_clan', 'union', 'war']):
            ddl = getattr(self.component.wnd.frame, 'dropdown_{0}'.format(key))
            ddl.script.setSelectionByValue(BigWorld.player().getRelationMarkParam(CLAN_TYPES[i]), silent=True)

    def fix_clan_contols(self):
        count_cmp = len(self.clan_war_controls)
        count_war = len(BigWorld.player().clan_myenemies)
        count_acmp = len(self.clan_ally_controls)
        count_ally = len(BigWorld.player().clan_unenemies)
        index = 0
        if count_cmp < count_war:
            for i in range(count_war - count_cmp):
                index = i + count_cmp + 1
                c_text = ClanText(GUI.Window())
                c_text.label.colour = (255, 0, 0, 255)
                c_text.horizontalAnchor = 'LEFT'
                c_text.verticalAnchor = 'BOTTOM'
                c_text.verticalPositionMode = 'PIXEL'
                c_text.horizontalPositionMode = 'PIXEL'
                c_text.onClick = self.onClanNameClick
                c_text.onRightClick = self.onClanNameRightClick
                cmp = c_text.component
                cmp.visible = True
                cmp.position = (16, 85 + 60 * index, 0)
                self.component.wnd.frame.addChild(cmp, 'my_war_{0}'.format(index))
                self.clan_war_controls.append(cmp)

        elif count_cmp > count_war:
            for i in range(count_cmp - count_war):
                cmp = self.clan_war_controls[-1]
                self.component.wnd.frame.delChild(cmp)
                del self.clan_war_controls[-1]

        if count_acmp < count_ally:
            for i in range(count_ally - count_acmp):
                index = i + count_acmp + 1
                c_text = ClanText(GUI.Window())
                c_text.label.colour = (255, 0, 0, 255)
                c_text.horizontalAnchor = 'LEFT'
                c_text.verticalAnchor = 'BOTTOM'
                c_text.verticalPositionMode = 'PIXEL'
                c_text.horizontalPositionMode = 'PIXEL'
                c_text.onClick = self.onClanNameClick
                c_text.onRightClick = self.onClanNameRightClick
                cmp = c_text.component
                cmp.visible = True
                cmp.position = (16, 85 + 60 * index, 0)
                self.component.wnd.frame.addChild(cmp, 'un_war_{0}'.format(index))
                self.clan_ally_controls.append(cmp)

        elif count_acmp > count_ally:
            for i in range(count_acmp - count_ally):
                cmp = self.clan_ally_controls[-1]
                self.component.wnd.frame.delChild(cmp)
                del self.clan_ally_controls[-1]

    def hide(self):
        self.component.visible = False
        self.hide_drop_downs()

    def hide_drop_downs(self):
        for i in ['my_clan', 'union', 'war']:
            dd = getattr(self.component.wnd.frame, 'dropdown_{0}'.format(i))
            dd.script.showList(False)

    def show(self):
        self.update()
        self.component.visible = True

    def _set_scroll_value(self, value):
        value = clamp(value, 0, self.scroll.steps)
        if self.scroll.getValue() == value:
            return
        self.scroll.setValue(value)
        self._scroll_changed()

    def _scroll_changed(self):
        pos_y = -self.scroll.getValue() * self.scrollStep
        self.component.wnd.frame.position.y = min(pos_y, 0)

    def handleMouseEnterEvent(self, comp):
        self.wheelFocus = True
        self.component.focus = True
        return True

    def handleMouseLeaveEvent(self, comp):
        self.wheelFocus = False
        self.component.focus = False
        return True

    def handleMouseEvent(self, component, event):
        dz = event.dz
        if dz > 0:
            self.scrollUp()
            return True
        if dz < 0:
            self.scrollDown()
            return True
        return True

    def scrollUp(self):
        self._set_scroll_value(self.scroll.getValue() - 1)

    def scrollDown(self):
        self._set_scroll_value(self.scroll.getValue() + 1)

    def scrollMoved(self, value):
        self._set_scroll_value(value)

    def update_locks(self):
        player = BigWorld.player()
        if not player or player.__class__.__name__ == 'Avatar':
            return
        if self.component.btn_addWar:
            can_invite = not player.checkClanRights(Clan.FLAG_CAN_DECLARE_WAR)
            self.component.btn_addWar.script.setDisabledState(can_invite)
            self.component.btn_addWar.visible = not ClanSettings.is_block_war(player.clan_level)
        if self.component.btn_addUnion:
            block_union = int(bool(player.clanUnion)) < ClanSettings.get_union_count(player.clan_level)
            self.component.btn_addUnion.visible = block_union
            if not not player.checkClanRights(Clan.FLAG_CLAN_OWNER):
                can_invite = bool(player.clanUnion)
                self.component.btn_addUnion.script.setDisabledState(can_invite)
            can_invite = self.component.btn_addAlliance and not player.checkClanRights(Clan.FLAG_CLAN_OWNER)
            self.component.btn_addAlliance.script.setDisabledState(can_invite or bool(player.clanUnion))

    def onSelectedVisibleConfig(self, clan_relation_type, elementID):
        BigWorld.player().setAllianceMarkParam(clan_relation_type, elementID)

    def onAddWarClick(self):

        def onClanIntive(text):
            BigWorld.player().clan_start_war(text)

        cost = ClanSettings.get_diplomacy_cost(BigWorld.player().clan_level, 'war')
        gui_jokes.inputBox(lc('GUI.ClanGUI.INVITE_TO_WAR'), lc('GUI.ClanGUI.INVITE_CLAN_TEXT1').format(cost), onClanIntive, active=True)

    def onAddUnionClick(self):

        def input_validator(new_str, whole_text, offset):
            return offset < 4

        def onClanIntive2(clan_name, tag):
            if 0 < len(tag) <= 4:
                BigWorld.player().invite_to_union(clan_name, tag)
            else:
                gui_jokes.msgBox(lc('GUI.ClanGUI.INVITE_TO_UNION'), lc('GUI.ClanGUI.CREATE_ALLIANCE_ERROR_NAME'))

        def onClanIntive(text):
            gui_jokes.inputBox(lc('GUI.ClanGUI.INVITE_TO_UNION'), lc('GUI.ClanGUI.CREATE_UNION_TEXT'), partial(onClanIntive2, text), active=True, input_validator=input_validator, id='union_tag')

        cost = ClanSettings.get_diplomacy_cost(BigWorld.player().clan_level, 'union')
        gui_jokes.inputBox(lc('GUI.ClanGUI.INVITE_TO_UNION'), lc('GUI.ClanGUI.INVITE_UNION_TEXT').format(cost), onClanIntive, active=True, id='union_name')

    def onBreakUnionClick(self):

        def _break_ally1(clan_name, event):
            if event == gui_jokes.askUserYesNo.YES:
                BigWorld.player().break_alliance()

        gui_jokes.askUserYesNo(lc('GUI.ClanGUI.INVITE_TO_BREAK'), lc('GUI.ClanGUI.ARE_YOU_SURE_BREAK_UNION').format(self._selected_clan_name), partial(_break_ally1, self._selected_clan_name))

    def onStartWarClick(self):
        if not self._selected_clan_name:
            return

        def war(text, event):
            if event == gui_jokes.askUserYesNo.YES:
                BigWorld.player().clan_start_war(text)

        cost = ClanSettings.get_diplomacy_cost(BigWorld.player().clan_level, 'war')
        gui_jokes.askUserYesNo(lc('GUI.ClanGUI.INVITE_TO_WAR'), lc('GUI.ClanGUI.ARE_YOU_SURE_WAR').format(self._selected_clan_name, cost), partial(war, self._selected_clan_name))

    def onBreakWarClick(self):

        def _peace(text):
            BigWorld.player().clan_stop_war(text)

        def _peace1(clan_name, event):
            if event == gui_jokes.askUserYesNo.YES:
                BigWorld.player().clan_stop_war(clan_name)

        if not self._selected_clan_name or self._selected_clan_name.encode('utf-8') not in BigWorld.player().clanEnemies:
            gui_jokes.inputBox(lc('GUI.ClanGUI.INVITE_TO_PEACE'), lc('GUI.ClanGUI.INVITE_CLAN_TEXT_WITH_CP'), _peace, active=True)
        else:
            gui_jokes.askUserYesNo(lc('GUI.ClanGUI.INVITE_TO_PEACE'), lc('GUI.ClanGUI.ARE_YOU_SURE_PEACE_1').format(self._selected_clan_name), partial(_peace1, self._selected_clan_name))

    def onClanNameClick(self, clan_name):
        pass

    def set_aggression(self, agression_list):
        self.agression_list = agression_list
        self.update()

    def onClanNameRightClick(self, component, clan_name):
        BWPersonality.GUICore.removeListener('contextMenuEvent', self.context_menu_event)
        actions = {'card': lc('GUI.ClanGUI.CLAN_CARD')}
        clan_name = clan_name.encode('utf-8')
        if clan_name in BigWorld.player().clan_myenemies:
            actions['peace'] = lc('GUI.ClanGUI.INVITE_TO_PEACE')
        if clan_name in BigWorld.player().clan_unenemies and clan_name not in BigWorld.player().clan_myenemies:
            actions['war'] = lc('GUI.ClanGUI.INVITE_TO_WAR')
        if clan_name == BigWorld.player().clanUnion:
            actions['break_union'] = lc('GUI.ClanGUI.INVITE_TO_BREAK')
        BWPersonality.GUICore.addListener('contextMenuEvent', self.context_menu_event)
        BWPersonality.GUICore.showContextMenu('soClanRelationsTab', actions, data=clan_name, sort_keys=False)

    def context_menu_event(self, interface_id, action_id, caption, event, data = None):
        if 'soClanRelationsTab' != interface_id:
            return
        if event == 0:
            BWPersonality.GUICore.removeListener('contextMenuEvent', self.context_menu_event)
            if action_id == 'card':
                BigWorld.player().base.get_another_clan_info(data)
            elif action_id == 'peace':
                self._selected_clan_name = data.decode('utf-8')
                self.onBreakWarClick()
            elif action_id == 'break_union':
                self._selected_clan_name = data.decode('utf-8')
                self.onBreakUnionClick()
            elif action_id == 'war':
                self._selected_clan_name = data.decode('utf-8')
                self.onStartWarClick()

    def get_next_weekly_tax_time(self):
        from datetime import date, timedelta
        import ItemsUtils
        import time
        now = date.today()
        days_ahead = (7 - now.weekday()) % 7
        if days_ahead == 0 and time.localtime().tm_hour >= 7:
            days_ahead = 7
        next_monday_7am = now + timedelta(days=days_ahead)
        time_end = time.mktime(time.strptime(next_monday_7am.isoformat() + ' 7:00', '%Y-%m-%d %H:%M')) - BWPersonality.gpd.time_diff
        return ItemsUtils.timeToString(time_end - time.time() - BWPersonality.gpd.time_diff)


class ClanText(PyGUIBase):

    def __init__(self, component, text = ''):
        PyGUIBase.__init__(self, component)
        component.script = self
        cmp = self.component
        self.buttonPressed = False
        cmp.crossFocus = True
        cmp.moveFocus = True
        cmp.mouseButtonFocus = True
        cmp.widthMode = 'PIXEL'
        cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = 'PIXEL'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.materialFX = 'BLEND'
        cmp.width = 100
        cmp.height = 32
        self.label = GUI.Text(text)
        self.label.horizontalAnchor = 'LEFT'
        self.label.verticalAnchor = 'TOP'
        self.label.verticalPositionMode = 'PIXEL'
        self.label.horizontalPositionMode = 'PIXEL'
        self.label.font = 'RobotoCondensedRegular_16.font'
        self.label.position = (0, 0, 0)
        self.component.addChild(self.label, 'label')
        self.update_size()

    def update_size(self):
        w, h = self.label.stringDimensions(self.label.text)
        self.component.width = w + 26
        self.component.height = h

    @property
    def horizontalAnchor(self):
        return self.label.horizontalAnchor

    @horizontalAnchor.setter
    def horizontalAnchor(self, value):
        self.label.horizontalAnchor = value

    @property
    def verticalPositionMode(self):
        return self.label.verticalPositionMode

    @verticalPositionMode.setter
    def verticalPositionMode(self, value):
        self.label.verticalPositionMode = value

    @property
    def horizontalPositionMode(self):
        return self.label.horizontalPositionMode

    @horizontalPositionMode.setter
    def horizontalPositionMode(self, value):
        self.label.horizontalPositionMode = value

    @property
    def widthMode(self):
        return self.label.widthMode

    @widthMode.setter
    def widthMode(self, value):
        self.label.widthMode = value

    @property
    def heightMode(self):
        return self.label.heightMode

    @heightMode.setter
    def heightMode(self, value):
        self.label.heightMode = value

    @property
    def text(self):
        return self.label.text

    @text.setter
    def text(self, value):
        self.label.text = value
        self.update_size()

    def onClick(self, text):
        pass

    def onRightClick(self, comp, text):
        pass

    def handleMouseButtonEvent(self, comp, event):
        key = event.key
        down = event.isKeyDown()
        if key == Keys.KEY_LEFTMOUSE:
            if down and not self.buttonPressed:
                self.buttonPressed = True
            elif not down and self.buttonPressed:
                self.buttonPressed = False
                self.onClick(self.text)
        if key == Keys.KEY_RIGHTMOUSE:
            if down and not self.buttonPressed:
                self.buttonPressed = True
            elif not down and self.buttonPressed:
                self.buttonPressed = False
                self.onRightClick(comp, self.text)
        return True