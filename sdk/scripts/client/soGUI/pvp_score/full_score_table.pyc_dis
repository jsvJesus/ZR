            self.BG_LINE_TEXTURE = bg_line_texture
        Line.__init__(self, height)
        self._aligned = False
        pos = 0
        self._wins = []
        n = len(textwidths_list)
        last_col = n - 1
        for i, width in enumerate(textwidths_list):
            if i == last_col:
                win_comp = self._create_cmp_icon(pos, width)
            else:
                win_comp = self._create_cmp_text(pos, aligns[i], width)
            self._wins.append(win_comp)
            pos += width

