class Line(PyGUIBase):
    BG_LINE_TEXTURE = 'soGUI/frame/paint/white.dds'

    def __init__(self, height):
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = 2, height
        comp.materialFX = 'SOLID'
        comp.position = (0, 0, 0.5)
        PyGUIBase.__init__(self, comp)
        self.component.script = self
        comp = GUI.Simple(self.BG_LINE_TEXTURE)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.5)
        comp.materialFX = 'BLEND'
        comp.colour = (234, 255, 0, 120)
        comp.visible = False
        self.component.addChild(comp, 'mark')

    def on_attached_to_parent(self):
        pass

    def set_marked(self, value, colour = (234, 255, 0, 120)):
        self.component.mark.visible = value
        self.component.mark.colour = colour


class TextIconLine(Line):
    """
    \xd0\xbd\xd0\xb5\xd1\x81\xd0\xba\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xba\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xbd\xd0\xbe\xd0\xba \xd1\x81 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd0\xbe\xd0\xbc \xd0\xb8 \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd0\xbd\xd1\x8f\xd1\x8f \xd1\x81 \xd0\xb8\xd0\xba\xd0\xbe\xd0\xbd\xd0\xba\xd0\xbe\xd0\xb9
