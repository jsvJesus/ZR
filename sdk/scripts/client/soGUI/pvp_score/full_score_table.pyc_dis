    def _create_cmp_icon(self, pos, width):
        win_comp = GUI.Window('')
        win_comp.horizontalPositionMode, win_comp.verticalPositionMode = ('PIXEL', 'CLIP')
        win_comp.horizontalAnchor, win_comp.verticalAnchor = ('LEFT', 'CENTER')
        win_comp.widthMode, win_comp.heightMode = ('PIXEL', 'CLIP')
        win_comp.width, win_comp.height = width + 1, 2
        win_comp.materialFX = 'SOLID'
        win_comp.position = (pos, 0, 0.5)
        back_comp = self.get_back_comp()
