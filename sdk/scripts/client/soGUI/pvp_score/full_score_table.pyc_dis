class Bar(PyGUIBase, DraggableComponent):

    def __init__(self, scroll_data, back_comp, bar_comp):
        PyGUIBase.__init__(self, bar_comp)
        DraggableComponent.__init__(self, False, True, True)
        self.component.script = self
        self._base_comp = back_comp
        self._bar_comp = bar_comp
        self._scroll_data = scroll_data
        self.onDragging = self._on_pos_changed
        self.on_pos_changed = lambda : None

    def scroll_data_changed(self):
        if not self._scroll_data:
            self._base_comp.visible = False
        else:
            self._base_comp.visible = True
            ratio = self._scroll_data['disp'] / self._scroll_data['maxdisp']
            self._bar_comp.position[1] = 1 - ratio * (2 - self._bar_comp.height)

    def _on_pos_changed(self):
        ratio = 1 - (self._bar_comp.height - self._bar_comp.position[1] - 1) / (self._bar_comp.height - 2)
        self._scroll_data['disp'] = self._scroll_data['maxdisp'] * ratio
        self.on_pos_changed()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)


class FullScoreTable(PyGUIBase):
    TITLE = u'???'
    HEADERS = []
    COLOUR = (0, 0, 0, 255)
    BG_TEXTURE = ''
    BG_COLOUR = (0, 0, 0, 255)
    BG_LINE_TEXTURE = ''

    def __init__(self, component, line_height, scroll_width):
        PyGUIBase.__init__(self, component)
        self.component.script = self
        self.lines = []
        self._pool = []
        self._line_height = line_height
        self._scroll_data = {}
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.component.widthMode = 'PIXEL'
        self._setup_ui(line_height, scroll_width)
        self._update_scroll_data()

    def handleMouseEvent(self, component, event):
        if event.dz:
            if not self._scroll_data:
                return False
            disp = event.dz * 0.1
            self._scroll_data['disp'] = math_bw.clamp(self._scroll_data['disp'] - disp, 0, self._scroll_data['maxdisp'])
            self._bar.scroll_data_changed()
            self._apply_scroll_data()
            return True
        return False

    def _setup_ui(self, line_height, scroll_width):
        main_comp = GUI.Window('')
        main_comp.horizontalPositionMode, main_comp.verticalPositionMode = ('CLIP', 'CLIP')
        main_comp.horizontalAnchor, main_comp.verticalAnchor = ('LEFT', 'CENTER')
        main_comp.widthMode, main_comp.heightMode = ('PIXEL', 'CLIP')
        main_comp.width, main_comp.height = self.component.width - scroll_width, 2
        main_comp.materialFX = 'SOLID'
        main_comp.position = (-1, 0, 0.9)
        self.component.addChild(main_comp)
        mltext = Title([main_comp.width], line_height, self.COLOUR)
        mltext.component.position[1] = 0
        mltext.set_text(0, self.TITLE)
        main_comp.addChild(mltext.component)
        mltext.on_attached_to_parent()
        self._textwidths_list = [ h['width'] for h in self.HEADERS ]
        self._textwidths_list[-1] = main_comp.width - sum(self._textwidths_list[:-1])
        self._aligns = [ h['align'] for h in self.HEADERS ]
        mltext = MultiTextLine(self._textwidths_list, self._aligns, line_height)
        mltext.set_colour((255, 255, 255, 200))
        mltext.component.position[1] = line_height - 1
        main_comp.addChild(mltext.component)
        mltext.on_attached_to_parent()
        for i, header in enumerate(self.HEADERS):
            mltext.set_text(i, header['title'])

        self._scroll_back_height = self.component.height - line_height * 2 + 2
        scroll_back_comp = GUI.Window()
        scroll_back_comp.horizontalPositionMode, scroll_back_comp.verticalPositionMode = ('CLIP', 'PIXEL')
        scroll_back_comp.horizontalAnchor, scroll_back_comp.verticalAnchor = ('CENTER', 'BOTTOM')
        scroll_back_comp.widthMode, scroll_back_comp.heightMode = ('CLIP', 'PIXEL')
        scroll_back_comp.width, scroll_back_comp.height = 2, self._scroll_back_height
        scroll_back_comp.materialFX = 'SOLID'
        scroll_back_comp.position = (0, self.component.height, 0.5)
        main_comp.addChild(scroll_back_comp)
        comp = GUI.Window(self.BG_TEXTURE)
        comp.colour = self.BG_COLOUR
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 0)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.5)
        scroll_back_comp.addChild(comp)
        self._line_comp = comp
        comp = GUI.Window('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = scroll_width, self.component.height - line_height * 2
        comp.materialFX = 'SOLID'
        comp.position = (1, line_height * 2, 0.5)
        self.component.addChild(comp, 'bar_back')
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (1, 0.5)
        comp.materialFX = 'SOLID'
        comp.position = (0, 1, 0.5)
        self.component.bar_back.addChild(comp, 'bar')
        self._bar = Bar(self._scroll_data, self.component.bar_back, comp)
        self._bar.on_pos_changed = self._apply_scroll_data

    def _get_line(self):
        if not self._pool:
            mltext = MultiTextLine(self._textwidths_list, self._aligns, self._line_height, self.BG_LINE_TEXTURE)
            mltext.set_colour((255, 255, 255, 120))
            self._pool.append(mltext)
        return self._pool.pop()

    def update(self, data):
        for l in self.lines:
            self._line_comp.delChild(l.component)

        self._pool.extend(self.lines)
        self.lines = []
        self._line_comp.height = self._line_height * len(data)
        pos = 0
        for i in xrange(len(data)):
            line = self._get_line()
            line.component.position[1] = pos
            pos += self._line_height - 1
            self._line_comp.addChild(line.component)
            line.on_attached_to_parent()
            self.lines.append(line)

        self._update_scroll_data()

    def _update_scroll_data(self):
        tail = self._line_comp.height - self._scroll_back_height
        if tail <= 0:
            self._scroll_data.clear()
        else:
            self._scroll_data['maxdisp'] = tail
            if 'disp' not in self._scroll_data:
                self._scroll_data['disp'] = 0
            elif self._scroll_data['disp'] > self._scroll_data['maxdisp']:
                self._scroll_data['disp'] = self._scroll_data['maxdisp']
        self._bar.scroll_data_changed()
        self._apply_scroll_data()

    def _apply_scroll_data(self):
        if self._scroll_data:
            self._line_comp.position[1] = -self._scroll_data['disp']
        else:
            self._line_comp.position[1] = 0


class FullScoreTableGB(FullScoreTable):
    HEADERS = [{'title': lc('score_pvp.table_bg.name'),
      'width': 432,
      'align': 'LEFT'}, {'title': lc('score_pvp.table_bg.prize'),
      'width': 150,
      'align': 'CENTER'}, {'title': lc('score_pvp.table_bg.kills'),
      'width': None,
      'align': 'CENTER'}]
    TITLE = lc('score_pvp.table_bg.title')
    COLOUR = (135, 60, 0, 255)
    NAME_COL, GIFT_COL, KILLED_COL = xrange(3)

    def update(self, data, pvp_data = None):
        FullScoreTable.update(self, data)
        bg_player = data[0] if data else {}
        bg_player = dict(bg_player)
        gift_col = ''
        if pvp_data:
            winLimit = BigWorld.player().pvpInstConfig.get('winGiftBoxCount', '???')
            gift_col = u'%s/%s' % (pvp_data['gameInfo']['teamRedWins'], winLimit)
        if self.lines:
            line = self.lines[0]
            line.set_text(self.NAME_COL, bg_player.get('name', u'???'))
            line.set_text(self.GIFT_COL, gift_col)
            line.set_text(self.KILLED_COL, str(bg_player.get('kills', '???')))


class FullScoreTablePlayers(FullScoreTable):
    HEADERS = [{'title': u'#',
      'width': 32,
      'align': 'CENTER'}, {'title': lc('score_pvp.table_human.name'),
      'width': 400,
      'align': 'LEFT'}, {'title': lc('score_pvp.table_human.human_prize'),
      'width': 150,
      'align': 'CENTER'}]
    TITLE = lc('score_pvp.table_human.human_title')
    COLOUR = (48, 0, 0, 255)
    NUM_COL, NAME_COL, GIFT_COL = xrange(3)

    def update(self, data):
        FullScoreTable.update(self, data)
        for i, line_data in enumerate(data):
            line = self.lines[i]
            line.set_marked(line_data['name'] == BigWorld.player().name)
            line.set_text(self.NUM_COL, str(i + 1))
            line.set_text(self.NAME_COL, line_data['name'])
            line.set_text(self.GIFT_COL, str(line_data['plscore']))


