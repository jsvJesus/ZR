        comp.colour = (193, 160, 171, 255)
        comp.position = (0, -5, 0.5)
        comp.font = 'RobotoCondensedRegular_36.font'
        self.component.addChild(comp, 'title')
        comp = GUI.Text('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.colour = (100, 100, 100, 255)
        comp.position = (-1, HEIGHT - 2, 0.1)
        comp.font = 'ruRU_Cyrvetica_Extra_14i.font'
        self.component.addChild(comp, 'noteam')
        comp = GUI.Window('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = STAT_WIDTH, STAT_HEIGHT
        comp.materialFX = 'SOLID'
        comp.position = (STAT_OFFSET, 0, 0.5)
        self.component.addChild(comp, 'stat')
        self._stat_table = FullScoreTableCommand(comp, LINE_HEIGHT, SCROLL_WIDTH)
        comp = GUI.Window('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = SUBWIND_WIDTH, PLAYERS_HEIGHT
        comp.materialFX = 'SOLID'
        comp.position = (OFFSET - 20, Y_OFFSET, 0.5)
        self.component.addChild(comp, 'blue')
        self._players_table_blue = FullScoreTableBlue(comp, LINE_HEIGHT, SCROLL_WIDTH)
        comp = GUI.Window('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = SUBWIND_WIDTH, PLAYERS_HEIGHT
        comp.materialFX = 'SOLID'
        comp.position = (OFFSET + 20, Y_OFFSET, 0.5)
        self.component.addChild(comp, 'red')
        self._players_table_red = FullScoreTableRed(comp, LINE_HEIGHT, SCROLL_WIDTH)

    def setTitle(self, text):
        self.component.title.text = text

    def updateScore(self, data):
        self._data = data
        self._dirty = True
        if self.component.visible:
            self._apply_changes()

    def _applyNoTeam(self):
        names = [ p['name'] for p in self._data['players'] if p['teamID'] not in (TEAM_RED, TEAM_BLUE) ]
        self.component.noteam.text = u' '.join(names)

    def _apply_changes(self):
        self._players_table_red.update(sort_team_dm_players(self._data['players'], TEAM_RED))
        self._players_table_blue.update(sort_team_dm_players(self._data['players'], TEAM_BLUE))
        red = {'name': lc('score_pvp.team_red'),
         'kills': self._data['gameInfo']['teamRedWins'],
         'colour': RED_COLOUR}
        blue = {'name': lc('score_pvp.team_blue'),
         'kills': self._data['gameInfo']['teamBlueWins'],
         'colour': BLUE_COLOUR}
        data = sorted([red, blue], key=lambda x: -x['kills'])
        self._stat_table.update(data)
        self._applyNoTeam()
        self._dirty = False

    def show(self):
        if self._dirty:
            self._apply_changes()
        self.component.visible = True

    def hide(self):
        self.component.visible = False