import GUI
import BigWorld
from Helpers.PyGUI import PyGUIBase
from full_score_table import FullScoreTable
from csconstans import sort_team_dm_players
from csconstans import TEAM_RED, TEAM_BLUE
from Localization import lc
import events_pvp_new_year
WIDTH = 1000
SUBWIND_WIDTH = 480
LINE_HEIGHT = 36
TITLE_HEIGHT = 50
TABLE_SPACE = 20
PLAYERS_HEIGHT = LINE_HEIGHT * 12
STAT_WIDTH = WIDTH - 300
STAT_HEIGHT = TITLE_HEIGHT + LINE_HEIGHT * 2 + TABLE_SPACE
STAT_OFFSET = 0
HEIGHT = TABLE_SPACE + PLAYERS_HEIGHT + TITLE_HEIGHT + STAT_HEIGHT
SCROLL_WIDTH = 20
OFFSET = WIDTH / 2
Y_OFFSET = TITLE_HEIGHT + STAT_HEIGHT
RED_COLOUR = (75, 14, 14, 255)
BLUE_COLOUR = (14, 14, 75, 255)

class FullScoreTableCommand(FullScoreTable):
    HEADERS = [{'title': u'#',
      'width': 32,
      'align': 'CENTER'}, {'title': lc('score_pvp.table_team_dm_statistic.command'),
      'width': 300,
      'align': 'LEFT'}, {'title': lc('score_pvp.table_team_dm_statistic.kills'),
      'width': 30,
      'align': 'CENTER'}]
    TITLE = lc('score_pvp.table_team_dm_statistic.title')
    COLOUR = (112, 64, 25, 255)
    NUM_COL, NAME_COL, KILLS_COL = xrange(3)
    BG_LINE_TEXTURE = 'soGUI/frame/paint/gradient.dds'

    def update(self, data):
        FullScoreTable.update(self, data)
        for i, line_data in enumerate(data):
            line = self.lines[i]
            line.set_marked(True, line_data['colour'])
            line.set_text(self.NUM_COL, str(i + 1))
            line.set_text(self.NAME_COL, line_data['name'])
            line.set_text(self.KILLS_COL, str(line_data['kills']))


class FullScoreTableRed(FullScoreTable):
    HEADERS = [{'title': u'#',
      'width': 32,
      'align': 'CENTER'},
     {'title': lc('score_pvp.table_team_dm.name'),
      'width': 270,
      'align': 'LEFT'},
     {'title': lc('score_pvp.table_team_dm.kills'),
      'width': 70,
      'align': 'CENTER'},
     {'title': lc('score_pvp.table_team_dm.deaths'),
      'width': 70,
      'align': 'CENTER'}]
    TITLE = u''
    COLOUR = (0, 0, 0, 0)
    NUM_COL, NAME_COL, KILLS_COL, DEATHS_COL = xrange(4)
    BG_TEXTURE = 'soGUI/frame/paint/gradient.dds'
    BG_COLOUR = RED_COLOUR

    def update(self, data):
        if BigWorld.player().inPVPinstance == events_pvp_new_year.TEAM_SNOWBALLS_DAILY:
            show_name = lc('soPvPStats.soGUI.NY_SNOWBALLS_TEAM_DM_PLAYER_NAME')
        else:
            show_name = None
        FullScoreTable.update(self, data)
        for i, line_data in enumerate(data):
            line = self.lines[i]
            line.set_marked(line_data['name'] == BigWorld.player().name)
            line.set_text(self.NUM_COL, str(i + 1))
            line.set_text(self.NAME_COL, show_name or line_data['name'])
            line.set_text(self.KILLS_COL, str(line_data['kills']))
            line.set_text(self.DEATHS_COL, str(line_data['deaths']))

        return


class FullScoreTableBlue(FullScoreTableRed):
    TITLE = lc('score_pvp.table_team_dm.title')
    COLOUR = (112, 64, 25, 255)
    BG_TEXTURE = 'soGUI/frame/paint/gradient.dds'
    BG_COLOUR = BLUE_COLOUR


class FullScoreTeamDM(PyGUIBase):

    def __init__(self):
        comp = GUI.Window('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = WIDTH, HEIGHT
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.05)
        PyGUIBase.__init__(self, comp)
        self._dirty = False
        self.component.script = self
        self.setup_ui()

    def setup_ui(self):
        comp = GUI.Text('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
