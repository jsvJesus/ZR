# Embedded file name: ./client/soGUI/pvp_score/score_team_dm.py
import GUI
import BigWorld
from Helpers.PyGUI import PyGUIBase
from score_dm import PlayerTop, ScoreDM
from full_score_team_dm import FullScoreTeamDM
from Localization import lc

def getPlayerData(data):
    player = BigWorld.player()
    for pl in data['players']:
        if pl['name'] == player.name:
            return pl


class PlayerTopTDM(PlayerTop):
    WIDTH = 320
    HEIGHT = 78

    def setupContent(self):
        left_offs = 20
        upp_offs = 11
        txt1 = self._creteText(lc('score_pvp.label_time_lost'), 'label_time')
        txt1.position = (left_offs, 17 + upp_offs, 0)
        txt2 = self._creteText(u'--:--', 'time_lost')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, 17 + upp_offs, 0)
        self._resizable.append([txt1, txt2])
        txt1 = self._creteText(lc('score_pvp.label_kills'), 'label_1')
        txt1.position = (left_offs, 40 + upp_offs, 0)
        txt2 = self._creteText(u'--', 'kills')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, 40 + upp_offs, 0)
        self._resizable.append([txt1, txt2])
        txt1 = self._creteText(lc('score_pvp.label_deaths'), 'label_deaths')
        txt1.position = (left_offs, 63 + upp_offs, 0)
        txt2 = self._creteText(u'--', 'deaths')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, 63 + upp_offs, 0)
        self._resizable.append([txt1, txt2])

    def updateScore(self, data):
        self.score_data = data
        my_info = getPlayerData(data)
        if my_info:
            self.component.kills.text = str(my_info['kills'])
            self.component.deaths.text = str(my_info['deaths'])
        else:
            self.component.kills.text = '-'
        self.resize()


class CommandTop(PyGUIBase):
    WIDTH = 245
    HEIGHT = 44

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.score_data = None
        self.setupRoot()
        self.setupContent()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = self.HEIGHT * 2
        cmp.width = self.WIDTH
        cmp.position = (0, 0.98, 0.05)

    def setupContent(self):
        cmp = GUI.Simple('soGUI/frame/pvp_score/blue_red.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = self.HEIGHT
        cmp.width = self.WIDTH
        cmp.position = (0, 0, 0.9)
        self.component.addChild(cmp, 'bg')
        txt = GUI.Text('BL')
        txt.horizontalAnchor = 'RIGHT'
        txt.verticalAnchor = 'CENTER'
        txt.verticalPositionMode = 'PIXEL'
        txt.horizontalPositionMode = 'PIXEL'
        txt.font = 'RobotoCondensedRegular_20.font'
        txt.position = (self.WIDTH / 2 - 20, self.HEIGHT / 2, 0.5)
        self.component.addChild(txt, 'blue')
        txt = GUI.Text('RE')
        txt.horizontalAnchor = 'LEFT'
        txt.verticalAnchor = 'CENTER'
        txt.verticalPositionMode = 'PIXEL'
        txt.horizontalPositionMode = 'PIXEL'
        txt.position = (self.WIDTH / 2 + 20, self.HEIGHT / 2, 0.5)
        txt.font = 'RobotoCondensedRegular_20.font'
        self.component.addChild(txt, 'red')

    def updateScore(self, data):
        self.score_data = data
        self.component.red.text = str(self.score_data['gameInfo']['teamRedWins'])
        self.component.blue.text = str(self.score_data['gameInfo']['teamBlueWins'])


class ScoreTDM(ScoreDM):

    def setupContent(self):
        self._com_top = CommandTop(GUI.Window())
        self._top = PlayerTopTDM(GUI.Window())
        self._full = FullScoreTeamDM()
        self.component.addChild(self._com_top.component, 'com_top')
        self.component.addChild(self._top.component, 'player_top')
        self.component.addChild(self._full.component, 'full')
        self._top.component.visible = False
        self._full.component.visible = False

    def setScoreData(self, data):
        ScoreDM.setScoreData(self, data)
        self._com_top.updateScore(data)