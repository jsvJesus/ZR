# Embedded file name: ./client/soGUI/pvp_score/score_dm.py
import GUI
import BigWorld
import BWPersonality
from Helpers.PyGUI import PyGUIBase
from Helpers.PyGUI.DraggableComponent import DraggableComponent
from soGUI.GUIPositions import GUIPositions
import csconstans
import time
import traceback
import sounds_manager as sounds
from full_score_dm import FullScoreDM
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
from Localization import lc
from csconstans import GAME_STATUS
from utils import secToTimerText

def getPlayerPosition(pvp_data):
    player = BigWorld.player()
    player_list = csconstans.sort_dm_players(pvp_data['players'])
    for index, pl in enumerate(player_list):
        if pl['name'] == player.name:
            return (index + 1, pl)


class PlayerTop(PyGUIBase, GUIPositions, DraggableComponent):
    WIDTH = 220
    HEIGHT = 80
    _is_end = -1

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.score_data = None
        self._resizable = []
        self.setupRoot()
        self.setupContent()
        DraggableComponent.__init__(self, 1, 1, 1, xoffset=0, yoffset=0)
        GUIPositions.__init__(self)
        GUIPositions.show(self)
        return

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def stopDragging(self):
        GUIPositions.stopDragging(self)
        DraggableComponent.stopDragging(self)

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (0, 0, 0, 100)
        cmp.materialFX = 'BLEND'
        cmp.height = self.HEIGHT
        cmp.width = self.WIDTH
        cmp.textureName = 'textures/default/white.dds'
        cmp.position = (0.99, 0.9, 0.05)

    def _creteText(self, text, name):
        txt = GUI.Text(text)
        txt.horizontalAnchor = 'LEFT'
        txt.verticalAnchor = 'BOTTOM'
        txt.verticalPositionMode = 'PIXEL'
        txt.horizontalPositionMode = 'PIXEL'
        txt.font = 'RobotoCondensedRegular_20.font'
        self.component.addChild(txt, name)
        return txt

    def setupContent(self):
        left_offs = 20
        upp_offs = 10
        txt1 = self._creteText(lc('score_pvp.label_time_lost'), 'label_time')
        txt1.position = (left_offs, 17 + upp_offs, 0)
        txt2 = self._creteText(u'--:--', 'time_lost')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, 17 + upp_offs, 0)
        self._resizable.append([txt1, txt2])
        txt1 = self._creteText(lc('score_pvp.label_kills'), 'label_1')
        txt1.position = (left_offs, 40 + upp_offs, 0)
        txt2 = self._creteText(u'--', 'kills')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, 40 + upp_offs, 0)
        self._resizable.append([txt1, txt2])
        txt1 = self._creteText(lc('score_pvp.label_my_score_position'), 'label_2')
        txt1.position = (left_offs, 63 + upp_offs, 0)
        txt2 = self._creteText(u'--', 'position_my')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, 63 + upp_offs, 0)
        self._resizable.append([txt1, txt2])

    def updateScore(self, data):
        self.score_data = data
        my_info = getPlayerPosition(data)
        if my_info:
            pl_position, pl = my_info
            self.component.kills.text = str(pl['kills'])
            self.component.position_my.text = str(pl_position)
        else:
            self.component.kills.text = '-'
            self.component.position_my.text = '-'
        self.resize()

    def setTimerText(self, text, is_end = False):
        self.component.time_lost.text = text
        if self._is_end != is_end:
            self._is_end = is_end
            if is_end:
                text = lc('score_pvp.label_time_exit')
            else:
                text = lc('score_pvp.label_time_lost')
            self.component.label_time.text = text
        self.resize()

    def resize(self):
        max_line_width = 0
        for label, txt in self._resizable:
            w0, _ = label.stringDimensions(label.text)
            w1, _ = txt.stringDimensions(txt.text)
            txt.position[0] = w0 + label.position[0] + 3
            line_width = txt.position[0] + w1 + 5 + 10
            max_line_width = max(max_line_width, line_width)

        self.component.width = max(max_line_width, 100)

    def reset_position(self):
        """ \xd1\x81\xd0\xb1\xd1\x80\xd0\xb0\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd """
        self.component.position = (0.99, 0.9, 0.05)


class ScoreDM(PyGUIBase):
    _timer_sound = None

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._music = None
        self.score_data = None
        self._is_timer = True
        self._top = None
        self._timer = None
        self.setupRoot()
        self.setupContent()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.colour = (255, 0, 0, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = 2
        cmp.width = 2
        cmp.position = (0, 0, 0.05)
        txt = GUI.Text(u'')
        txt.horizontalAnchor = 'CENTER'
        txt.verticalAnchor = 'BOTTOM'
        txt.verticalPositionMode = 'CLIP'
        txt.horizontalPositionMode = 'CLIP'
        txt.font = 'RobotoCondensedRegular_36.font'
        txt.position = (0, 0.6, 0.3)
        self.component.addChild(txt, 'up_text')

    def setupContent(self):
        self._top = PlayerTop(GUI.Window())
        self._full = FullScoreDM()
        self.component.addChild(self._top.component, 'player_top')
        self.component.addChild(self._full.component, 'full')
        self._top.component.visible = False
        self._full.component.visible = False

    def hide(self):
        self.stopMusic()
        self.stopTimerSound()
        self.component.visible = False
        self.score_data = None
        if self._timer:
            try:
                self._timer.stop()
            except:
                traceback.print_exc()

            self._timer = None
        return

    def show(self):
        self.component.visible = True
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild('ScorePVP')
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'ScorePVP')
        if self._full:
            self._full.setTitle(u'')
        player = BigWorld.player()
        self.onChangeTeamPVP(getattr(player, 'teamID', 0))
        if not self._timer:
            self._timer = self._timer_tick()
            self._timer.run()
        self._is_timer = True
        return

    @BWMemberCoroutine
    def _timer_tick(self):
        while True:
            self.updateTimer()
            yield BWWaitForPeriod(1.0)

    def updateTimer(self):
        if not self._top:
            return
        if not self._is_timer:
            return
        text = '--:--'
        timeLostSec = 0
        timer_sound = False
        is_end = False
        if self.score_data:
            gameInfo = self.score_data['gameInfo']
            timeLostSec = gameInfo['gameTimeEnd'] + BWPersonality.gpd.time_diff - time.time()
            is_end = gameInfo['gameStatus'] == GAME_STATUS.END_GAME
            if gameInfo['gameStatus'] == GAME_STATUS.WARM_UP:
                self.setUpText(lc('soFlashPVP.messages.warmup'))
            if timeLostSec > 0 and gameInfo['gameStatus'] == GAME_STATUS.BATTLE:
                if timeLostSec < 30:
                    timer_sound = True
        if timer_sound and not self._timer_sound:
            self._timer_sound = sounds.playMusic('music/volcano_event/timer')
        elif not timer_sound and self._timer_sound:
            self.stopTimerSound()
        if timeLostSec > 0:
            text = secToTimerText(timeLostSec)
        self._top.setTimerText(text, is_end)

    def scoreBarVisible(self):
        return self._full and self._full.component.visible

    def onChangeTeamPVP(self, value):
        if not self._top:
            return
        self._top.component.visible = True
        if self.score_data:
            self.setScoreData(self.score_data)

    def setUpText(self, text):
        self.component.up_text.text = text
        self.component.up_text.visible = bool(text)

    def onSetBestCursor(self, mouse_cursor):
        pass

    def pvpScoreStartExtraTime(self):
        self.setUpText('')
        if self._full:
            self._full.setTitle(lc('soFlashPVP.messages.extra_time'))

    def pvpScoreStartRound(self):
        self._is_timer = True
        self.setUpText(u'')
        if self._full:
            self._full.setTitle(u'')

    def pvpScorePauseRound(self):
        self._is_timer = True

    def playMusic(self, path):
        if self._music and self._music.sound_path == path:
            return
        self.stopMusic()
        self._music = sounds.playMusic(path)

    def stopMusic(self):
        if self._music:
            self._music.stop()
            self._music.releaseSound()
            self._music = None
        return

    def stopTimerSound(self):
        if self._timer_sound:
            self._timer_sound.stop()
            self._timer_sound.releaseSound()
            self._timer_sound = None
        return

    def pvpScoreEvent(self, eventID, code, msg):
        pass

    def pvpScoreWinPlayer(self, msg):
        self.setVisibleScore(True)
        self._full.setTitle(msg)

    def pvpScoreWinTeam(self, teamID):
        if teamID == csconstans.TEAM_NO:
            msg = lc('soFlashPVP.messages.dead_heat')
        else:
            msg = lc('soFlashPVP.messages.win') if teamID == BigWorld.player().teamID else lc('soFlashPVP.messages.defeat')
        self._full.setTitle(msg)

    def setScoreData(self, data):
        self.score_data = data
        if self._top:
            self._top.updateScore(data)
        if self._full:
            self._full.updateScore(data)

    def setVisibleScore(self, doShow):
        if self._full:
            self._full.show() if doShow else self._full.hide()

    def updateFalgsState(self, red_home, blue_home):
        pass