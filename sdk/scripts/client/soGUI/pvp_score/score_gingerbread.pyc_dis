        txt.font = 'RobotoCondensedRegular_24.font'
        txt.position = (120, 80 + upp_offs, 0)
        self.component.addChild(txt, 'position_my')
        self._resizable.append([self.component.label_2, self.component.position_my])
        txt = GUI.Text(lc('score_pvp.label_time_lost'))
        txt.horizontalAnchor = 'LEFT'
        txt.verticalAnchor = 'BOTTOM'
        txt.verticalPositionMode = 'PIXEL'
        txt.horizontalPositionMode = 'PIXEL'
        txt.font = 'RobotoCondensedRegular_20.font'
        txt.position = (left_offs, 105 + upp_offs, 0)
        self.component.addChild(txt, 'label_time')
        txt = GUI.Text(u'--:--')
        txt.horizontalAnchor = 'LEFT'
        txt.verticalAnchor = 'BOTTOM'
        txt.verticalPositionMode = 'PIXEL'
        txt.horizontalPositionMode = 'PIXEL'
        txt.font = 'RobotoCondensedRegular_24.font'
        txt.position = (120, 105 + upp_offs, 0)
        self.component.addChild(txt, 'time_lost')
        self._resizable.append([self.component.label_time, self.component.time_lost])

    def updateScore(self, data):
        self.score_data = data
        winLimit = BigWorld.player().pvpInstConfig.get('winGiftBoxCount', '???')
        self.component.prize_all.text = '%s/%s' % (data['gameInfo']['teamRedWins'], winLimit)
        my_info = getPlayerPosition(data)
        if my_info:
            pl_position, pl = my_info
            self.component.prize_my.text = str(pl['plscore'])
            self.component.position_my.text = str(pl_position)
        else:
            self.component.prize_my.text = '-'
            self.component.position_my.text = '-'
        self.resize()

    def setTimerText(self, text, is_end = False):
        self.component.time_lost.text = text
        if self._is_end != is_end:
            self._is_end = is_end
            if is_end:
                text = lc('score_pvp.label_time_exit')
            else:
                text = lc('score_pvp.label_time_lost')
            self.component.label_time.text = text
        self.resize()

    def resize(self):
        max_line_width = 0
        for label, txt in self._resizable:
            w0, _ = label.stringDimensions(label.text)
            w1, _ = txt.stringDimensions(txt.text)
            txt.position[0] = w0 + label.position[0] + 3
            line_width = txt.position[0] + w1 + 5 + 10
            max_line_width = max(max_line_width, line_width)

        self.component.width = max(max_line_width, 100)


