# Embedded file name: ./client/soGUI/pvp_score/full_score_dm.py
import GUI
import BigWorld
from Helpers.PyGUI import PyGUIBase
from full_score_table import FullScoreTable
from csconstans import sort_dm_players
from csconstans import TEAM_RED, TEAM_BLUE
from Localization import lc
WIDTH = 800
LINE_HEIGHT = 36
TITLE_HEIGHT = 50
TABLE_SPACE = 20
PLAYERS_HEIGHT = LINE_HEIGHT * 12
HEIGHT = TABLE_SPACE + PLAYERS_HEIGHT + TITLE_HEIGHT
SCROLL_WIDTH = 20
OFFSET = WIDTH / 2 + 10

class FullScoreTableDM(FullScoreTable):
    HEADERS = [{'title': u'#',
      'width': 32,
      'align': 'CENTER'},
     {'title': lc('score_pvp.table_dm.name'),
      'width': 580,
      'align': 'LEFT'},
     {'title': lc('score_pvp.table_dm.kills'),
      'width': 80,
      'align': 'CENTER'},
     {'title': lc('score_pvp.table_dm.deaths'),
      'width': 80,
      'align': 'CENTER'}]
    TITLE = lc('score_pvp.table_dm.title')
    COLOUR = (48, 0, 0, 255)
    NUM_COL, NAME_COL, KILLS_COL, DEATHS_COL = xrange(4)

    def update(self, data):
        FullScoreTable.update(self, data)
        for i, line_data in enumerate(data):
            line = self.lines[i]
            line.set_marked(line_data['name'] == BigWorld.player().name)
            line.set_text(self.NUM_COL, str(i + 1))
            line.set_text(self.NAME_COL, line_data['name'])
            line.set_text(self.KILLS_COL, str(line_data['kills']))
            line.set_text(self.DEATHS_COL, str(line_data['deaths']))


class FullScoreDM(PyGUIBase):

    def __init__(self):
        comp = GUI.Window('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = WIDTH, HEIGHT
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.05)
        PyGUIBase.__init__(self, comp)
        self._dirty = False
        self.component.script = self
        self.setup_ui()

    def setup_ui(self):
        comp = GUI.Text('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.colour = (193, 160, 171, 255)
        comp.position = (0, 0, 0.5)
        comp.font = 'RobotoCondensedRegular_36.font'
        self.component.addChild(comp, 'title')
        comp = GUI.Text('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.colour = (100, 100, 100, 255)
        comp.position = (-1, HEIGHT - 2, 0.1)
        comp.font = 'ruRU_Cyrvetica_Extra_14i.font'
        self.component.addChild(comp, 'noteam')
        comp = GUI.Window('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = 2, PLAYERS_HEIGHT
        comp.materialFX = 'SOLID'
        comp.position = (OFFSET, TITLE_HEIGHT + TABLE_SPACE, 0.5)
        self.component.addChild(comp)
        self._players_table = FullScoreTableDM(comp, LINE_HEIGHT, SCROLL_WIDTH)

    def setTitle(self, text):
        self.component.title.text = text

    def updateScore(self, data):
        self._data = data
        self._dirty = True
        if self.component.visible:
            self._apply_changes()

    def _applyNoTeam(self):
        names = [ p['name'] for p in self._data['players'] if p['teamID'] not in (TEAM_RED, TEAM_BLUE) ]
        self.component.noteam.text = u' '.join(names)

    def _apply_changes(self):
        self._players_table.update(sort_dm_players(self._data['players']))
        self._applyNoTeam()
        self._dirty = False

    def show(self):
        if self._dirty:
            self._apply_changes()
        self.component.visible = True

    def hide(self):
        self.component.visible = False