# Embedded file name: ./client/soGUI/pvp_score/score_flag.py
import GUI
import BigWorld
from score_dm import PlayerTop
from Localization import lc
from full_score_flag import FullScoreFlag
from score_team_dm import ScoreTDM
from score_team_dm import CommandTop
from score_team_dm import getPlayerData

class PlayerTopFlag(PlayerTop):
    WIDTH = 320
    HEIGHT = 92

    def setupContent(self):
        left_offs = 20
        upp_offs = 33
        txt1 = self._creteText(lc('score_pvp.label_time_lost'), 'label_time')
        txt1.position = (left_offs, upp_offs, 0)
        txt2 = self._creteText(u'--:--', 'time_lost')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, upp_offs, 0)
        self._resizable.append([txt1, txt2])
        upp_offs += 25
        txt1 = self._creteText(lc('score_pvp.label_flags'), 'label_0')
        txt1.position = (left_offs, upp_offs, 0)
        txt2 = self._creteText(u'--', 'flags')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, upp_offs, 0)
        self._resizable.append([txt1, txt2])
        upp_offs += 25
        txt1 = self._creteText(lc('score_pvp.label_kills'), 'label_1')
        txt1.position = (left_offs, upp_offs, 0)
        txt2 = self._creteText(u'--', 'kills')
        txt2.font = 'RobotoCondensedRegular_24.font'
        txt2.position = (120, upp_offs, 0)
        self._resizable.append([txt1, txt2])

    def updateScore(self, data):
        self.score_data = data
        my_info = getPlayerData(data)
        if my_info:
            self.component.kills.text = str(my_info['kills'])
            self.component.flags.text = str(my_info['brought_flags'])
        else:
            self.component.kills.text = '-'
        self.resize()


class CommandTopFlag(CommandTop):

    def setupContent(self):
        CommandTop.setupContent(self)
        cmp = GUI.Simple('soGUI/maps/Icons/pvp/flag_blue.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.materialFX = 'SOLID'
        cmp.width = cmp.height = 32
        cmp.position = (self.WIDTH / 2 - 5, 60, 0.1)
        self.component.addChild(cmp, 'flblue')
        cmp = GUI.Simple('soGUI/maps/Icons/pvp/flag_red.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.materialFX = 'SOLID'
        cmp.width = cmp.height = 32
        cmp.position = (self.WIDTH / 2 + 5, 60, 0.1)
        self.component.addChild(cmp, 'flred')

    def updateFalgsHomeState(self, red_home, blue_home):
        self.component.flred.visible = red_home
        self.component.flblue.visible = blue_home


class ScoreFlag(ScoreTDM):

    def setupContent(self):
        self._com_top = CommandTopFlag(GUI.Window())
        self._top = PlayerTopFlag(GUI.Window())
        self._full = FullScoreFlag()
        self.component.addChild(self._com_top.component, 'com_top')
        self.component.addChild(self._top.component, 'player_top')
        self.component.addChild(self._full.component, 'full')
        self._top.component.visible = False
        self._full.component.visible = False

    def updateFalgsState(self, red_home, blue_home):
        self._com_top.updateFalgsHomeState(red_home, blue_home)