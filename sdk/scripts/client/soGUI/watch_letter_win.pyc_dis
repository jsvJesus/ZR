class EventType:
    OnAcceptRequested, OnRefuseRequested = ((r, 'recruitwatchletterwin') for r in range(2))


class WatchLetterWin(DragWin, Listenable):
    _request_id = 0

    def __init__(self):
        Listenable.__init__(self)
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
