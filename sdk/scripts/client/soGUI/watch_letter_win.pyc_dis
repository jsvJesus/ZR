        btn.onClick = self._on_refuse_click
        self.component.addChild(comp)
        btn.onBound()
        return

    def _apply_data(self, data):
        self._data = data
        self.component.name.text = u'{0} {1}'.format(cc.inactive_hex + lc('GUI.ClanGUI.RECRUITING.Win.Name'), cc.active_hex + data['name'].decode('utf8'))
        self.component.level.text = u'{0} {1}'.format(cc.inactive_hex + lc('GUI.ClanGUI.RECRUITING.Win.Level'), cc.active_hex + unicode(data['level']))
        self._tf.setText(u'', immidiate=True)
        WatchLetterWin._request_id = 120 % (WatchLetterWin._request_id + 1)
        BigWorld.player().base.get_letter_details0(data['dbid'], WatchLetterWin._request_id)

    def _on_accept_click(self):
        data = self._data
        self.hide()
        p = BigWorld.player()

        def callback(event):
            if event == gui_jokes.askUserYesNo.YES:
                if p.clanpoints < cp:
                    p.tellAboutClanStatus([], [], Clan.STATUS_NOT_ENOUGH_CLAN_POINTS)
                    return
                if p.money < money:
                    p.tellAboutClanStatus([], [], Clan.STATUS_NOT_ENOUGH_MONEY)
                    return
                notify_data = {'db_id': data['dbid'],
                 'name': data['name']}
                self.notify_listeners(EventType.OnAcceptRequested, notify_data)

        max_members_count = ClanSettings.get_max_players(p.clan_level)
        if not (p.clanRoster and len(p.clanRoster['members'])):
            members_count = 0
            members_count >= max_members_count and p.tellAboutClanStatus([], [], Clan.STATUS_TOO_MUCH_MEMBERS)
            return
        money, cp = ClanSettings.get_invite_cost(p.clan_level)
        gui_jokes.askUserYesNo(lc('GUI.ClanGUI.INVITE_TO_CLAN_CAPTION'), lc('GUI.ClanGUI.INVITE_CLAN_TEXT2').format(cp, money), callback)

    def _on_refuse_click(self):
        data = {'db_id': self._data['dbid']}
        self.hide()
        self.notify_listeners(EventType.OnRefuseRequested, data)

    def show(self, data):
        self._apply_data(data)
        if not self.component.visible:
            self.component.visible = True
            self._on_show()

    def _got_letter_details(self, message, request_id):
        if WatchLetterWin._request_id != request_id:
            return
        self._tf.setText(cc.active_xml + message.decode('utf8'), immidiate=True)

    def _on_show(self):
        BigWorld.player().got_letter_details0 = self._got_letter_details

    def hide(self):
        if self.component.visible:
            self.component.visible = False
            self._on_hide()

    def _on_hide(self):
        self._data = None
        BigWorld.player().got_letter_details0 = lambda *args: None
        return