# Embedded file name: ./client/soGUI/promo_gui/message_box.py
import GUI
from win import Win, TextField
import colorCodes as cc

class MessageBox(Win):

    def setup_content(self):
        Win.setup_content(self)
        self._btn1_callback = None
        self._btn2_callback = None
        self.component.close_btn.visible = False
        self.component.colour = (0, 0, 0, 255)
        self.component.height = 300
        self._btn1, self._btn2 = self.create_buttons()
        self._btn1.on_click = self._on_btn1_click
        self._btn2.on_click = self._on_btn2_click
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.position = (0, 130, 0.5)
        self._tf = TextField(comp, width=self.component.width - 52, font='RobotoCondensedRegular_18.font', align='center')
        self._tf.DEFAULT_COLOR = cc.active_rgba
        self.component.addChild(comp)
        return

    def set_btn1_callback(self, callback):
        self._btn1_callback = callback

    def set_btn2_callback(self, callback):
        self._btn2_callback = callback

    def set_btn1_text(self, text):
        self._btn1.text = text

    def set_btn2_text(self, text):
        self._btn2.text = text

    def set_text(self, text):
        self._tf.setText(text)

    def _on_btn1_click(self):
        if self._btn1_callback:
            self._btn1_callback()
        else:
            self.hide()

    def _on_btn2_click(self):
        if self._btn2_callback:
            self._btn2_callback()
        else:
            self.hide()

    def hide(self):
        Win.hide(self)
        self.set_btn1_text(u'')
        self.set_btn2_text(u'')
        self.set_text(u'')
        self.set_btn1_callback(None)
        self.set_btn2_callback(None)
        return