        self.component.addChild(comp)
        self._notification_text = tf
        self.set_error_text_field(tf)
        edit_width = 360
        self._mail_eb = EditBox(edit_width, None, pholder=lc('PromoGui.registerwin.mail'))
        self._mail_eb.onValueChange = self._on_eb_value_changed
        comp = self._mail_eb.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
