        comp.materialFX = 'SOLID'
        self._mail_text.addChild(comp)
        self._code_eb = EditBox(edit_width, '*', pholder=lc('PromoGui.registerwin.code'))
        self._code_eb.onValueChange = self._on_eb_value_changed
        comp = self._code_eb.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.position = (0, 216, 0.5)
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width * 0.5, 250, 0.5)
        tf = TextField(comp, width=self.component.width - 32, height=60, font='RobotoCondensedRegular_24.font', align='center')
        tf.INTERFACE_ID = RegisterWin.interface_id
        tf.setText(u'<hlink={0};>'.format(lc('PromoGui.registerwin.login')))
        self.component.addChild(comp)
        self._login_text = comp
        return

    def _on_eb_value_changed(self, by_user):
        if by_user:
            self.restore_error_text()

    def on_show(self):
        Win.on_show(self)
        self._apply_btn.enabled = True
        self.state = State.Mail
        self._code_eb.clear(False)
        self._registration_data = {}

    def on_hide(self):
        Win.on_hide(self)
        self._code_eb.on_hide()
        self._mail_eb.on_hide()
        self._registration_data = {}

    def _check_end_registration(self):
        if 'partner' in self._registration_data and 'info' in self._registration_data:
            data = {'secret': self._registration_data['partner']}
            self.notify_listeners(EventType.OnRegister, data)

    def on_reg_partner(self, email, secret):
        Win.on_reg_partner(self, email, secret)
        if self.state == State.WaitCode:
            self._registration_data['partner'] = secret
            self._check_end_registration()

    def on_update_partner_info(self):
        Win.on_update_partner_info(self)
        if self.state == State.WaitCode:
            self._registration_data['info'] = None
            self._check_end_registration()
        return

    def on_promo_event(self, code):
        Win.on_promo_event(self, code)
        if PCODE.is_error(code):
            if self.state == State.WaitMail:
                self.state = State.Mail
            elif self.state == State.WaitCode:
                self.state = State.Code
        elif self.state == State.WaitMail:
            if code == PCODE.OK_SEND_REG_EMAI_KEY:
                self.state = State.Code

    @property
    def state(self):
        return self._state

    @state.setter
    def state(self, value):
        if self._state == value:
            return
        self._state = value
        if self.state == State.Mail:
            self._notification_text.setText(lc('PromoGui.registerwin.entermail'))
            self._code_eb.component.visible = False
            self._apply_btn.text = lc('PromoGui.registerwin.send_btn')
            self._apply_btn.enabled = True
            self._mail_eb.set_readonly(False)
            self._mail_eb.component.visible = True
            self._mail_text.visible = False
            self._login_text.visible = True
            self.set_load_pane(False)
        elif self.state == State.WaitMail:
            self._notification_text.setText(lc('PromoGui.registerwin.entermail'))
            self._code_eb.component.visible = False
            self._apply_btn.text = lc('PromoGui.registerwin.send_btn')
            self._apply_btn.enabled = False
            self._mail_eb.set_readonly(True)
            self._mail_eb.component.visible = True
            self._mail_text.visible = False
            self._login_text.visible = True
            self.set_load_pane(True)
        elif self.state == State.Code:
            self._notification_text.setText(lc('PromoGui.loginwin.notification2'))
            self._code_eb.component.visible = True
            self._apply_btn.text = lc('PromoGui.registerwin.confirm_btn')
            self._apply_btn.enabled = True
            self._mail_eb.set_readonly(True)
            self._mail_eb.component.visible = False
            self._code_eb.set_readonly(False)
            self._code_eb.clear(False)
            self._mail_text.text = self._mail_eb.getRaw()
            self._mail_text.visible = True
            self._login_text.visible = False
            self.set_load_pane(False)
        elif self.state == State.WaitCode:
            self._notification_text.setText(lc('PromoGui.loginwin.notification2'))
            self._code_eb.component.visible = True
            self._apply_btn.text = lc('PromoGui.registerwin.confirm_btn')
            self._apply_btn.enabled = False
            self._mail_eb.set_readonly(True)
            self._mail_eb.component.visible = False
            self._code_eb.set_readonly(True)
            self._mail_text.text = self._mail_eb.getRaw()
            self._mail_text.visible = True
            self._login_text.visible = False
            self.set_load_pane(True)
        else:
            raise RuntimeError

    def _on_apply_click(self):
        self.restore_error_text()
        if self.state == State.Mail:
            mail_text = self._mail_eb.getRaw()
            if not re.compile(utils_bw.MAIL_REGEX).match(mail_text):
                self._mail_eb._inputError()
                return
            data = {'mail_text': str(mail_text)}
            self.notify_listeners(EventType.OnStartRegParnterRequest, data)
            self.state = State.WaitMail
        elif self.state == State.Code:
            code_text = self._code_eb.getRaw()
            if not code_text:
                self._code_eb._inputError()
                return
            try:
                code_text = str(code_text)
            except:
                self._code_eb._inputError()
                return

            data = {'code_text': code_text}
            self.notify_listeners(EventType.OnContinueRegPartnerRequest, data)
            self.state = State.WaitCode
        else:
            raise RuntimeError

    def _on_cancel_click(self):
        self.notify_listeners(WinET.OnRequestExit)

    def on_hlink_click(self, data, interface_id):
        if interface_id == RegisterWin.interface_id:
            self.notify_listeners(EventType.OnRequestLogin)