import utils_bw
from promo_code_constant import PCODE

class EventType:
    OnRegister, OnRequestLogin, OnStartRegParnterRequest, OnContinueRegPartnerRequest = ((r, 'promo.register_win') for r in range(4))


class State:
    Mail, WaitMail, Code, WaitCode = range(4)


class RegisterWin(Win):
    interface_id = 'Promo.RegisterWin'

    def setup_content(self):
        Win.setup_content(self)
        self._state = None
        self.create_caption(lc('PromoGui.registerwin.caption'))
        self._apply_btn, cancel_btn = self.create_buttons()
        self._apply_btn.text = lc('PromoGui.registerwin.send_btn')
        self._apply_btn.on_click = self._on_apply_click
        cancel_btn.text = lc('PromoGui.registerwin.cancel_btn')
        cancel_btn.on_click = self._on_cancel_click
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width * 0.5, 86, 0.5)
