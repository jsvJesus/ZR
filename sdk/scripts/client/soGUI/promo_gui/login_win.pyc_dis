        tf.setText(lc('PromoGui.loginwin.forgot'))
        self._links_comp.addChild(comp)
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.position = (0, 282, 0.1)
        tf = TextField(comp, width=self.component.width - 32, height=28, font='RobotoCondensedRegular_24.font', align='center')
