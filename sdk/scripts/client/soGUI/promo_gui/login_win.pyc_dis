class EventType:
    OnSubscribeRequest, OnContinueSubscribeRequest, OnSubscribeCompleted, OnRegisterRequest = ((r, 'promo.login_win') for r in range(4))


class State:
    Mail, WaitMail, Code, WaitCode = range(4)


class LoginWin(Win):
    interface_id = 'Promo.LoginWin'

