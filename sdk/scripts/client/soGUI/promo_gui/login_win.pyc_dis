        tf.setText(u'<hlink={0};>'.format(lc('PromoGui.loginwin.register')))
        self._links_comp.addChild(comp)
        return

    def on_promo_event(self, code):
        Win.on_promo_event(self, code)
        if PCODE.is_error(code):
            if self.state == State.WaitMail:
                self.state = State.Mail
            elif self.state == State.WaitCode:
                self.state = State.Code
        if self.state == State.WaitMail:
            if code == PCODE.OK_SUBSC_SEND_EMAIL:
                self.state = State.Code
        elif self.state == State.WaitCode:
            if code == PCODE.OK_SUBSC:
                self.notify_listeners(EventType.OnSubscribeCompleted)

    def _on_apply_click(self):
        self.restore_error_text()
        if self.state == State.Mail:
            mail_text, secret_text = self._mail_eb.getRaw(), self._secret_eb.getRaw()
            valid = True
            if re.compile(utils_bw.MAIL_REGEX).match(mail_text):
                mail_text = str(mail_text)
            else:
                self._mail_eb._inputError()
                valid = False
            if secret_text:
                try:
                    secret_text = str(secret_text)
                except:
                    self._secret_eb._inputError()
                    valid = False

            else:
                self._secret_eb._inputError()
                valid = False
            if valid:
                data = {'mail': mail_text,
                 'secret': secret_text}
                self.notify_listeners(EventType.OnSubscribeRequest, data)
                self.state = State.WaitMail
        elif self.state == State.Code:
            code_text = self._code_eb.getRaw()
            if code_text:
                try:
                    code_text = str(code_text)
                except:
                    self._code_eb._inputError()
                else:
                    data = {'code': code_text}
                    self.notify_listeners(EventType.OnContinueSubscribeRequest, data)
                    self.state = State.WaitCode

            else:
                self._code_eb._inputError()

    @property
    def state(self):
        return self._state

    @state.setter
    def state(self, value):
        if value == self._state:
            return
        self._state = value
        if value == State.Mail:
            self._notification_text.setText(lc(u'PromoGui.loginwin.notification1'))
            self._secret_eb.component.visible = True
            self._secret_eb.set_readonly(False)
            self._code_eb.component.visible = False
            self._code_eb.set_readonly(True)
            self._apply_btn.text = lc('PromoGui.loginwin.enter_btn')
            self._apply_btn.enabled = True
            self._mail_eb.set_readonly(False)
            self._mail_eb.component.visible = True
            self._links_comp.visible = True
            self._mail_text.visible = False
            self.set_load_pane(False)
        elif value == State.WaitMail:
            self._notification_text.setText(lc(u'PromoGui.loginwin.notification1'))
            self._secret_eb.component.visible = True
            self._secret_eb.set_readonly(True)
            self._code_eb.component.visible = False
            self._code_eb.set_readonly(True)
            self._apply_btn.text = lc('PromoGui.loginwin.enter_btn')
            self._apply_btn.enabled = False
            self._mail_eb.set_readonly(True)
            self._mail_eb.component.visible = True
            self._links_comp.visible = True
            self._mail_text.visible = False
            self.set_load_pane(True)
        elif value == State.Code:
            self._notification_text.setText(lc(u'PromoGui.loginwin.notification2'))
            self._secret_eb.component.visible = False
            self._secret_eb.set_readonly(True)
            self._code_eb.component.visible = True
            self._code_eb.set_readonly(False)
            self._apply_btn.text = lc('PromoGui.loginwin.confirm_btn')
            self._apply_btn.enabled = True
            self._mail_eb.set_readonly(True)
            self._mail_eb.component.visible = False
            self._links_comp.visible = False
            self._mail_text.text = self._mail_eb.getRaw()
            self._mail_text.visible = True
            self.set_load_pane(False)
        elif value == State.WaitCode:
            self._notification_text.setText(lc(u'PromoGui.loginwin.notification2'))
            self._secret_eb.component.visible = False
            self._secret_eb.set_readonly(True)
            self._code_eb.component.visible = True
            self._code_eb.set_readonly(True)
            self._apply_btn.text = lc('PromoGui.loginwin.confirm_btn')
            self._apply_btn.enabled = False
            self._mail_eb.set_readonly(True)
            self._mail_eb.component.visible = False
            self._links_comp.visible = False
            self._mail_text.text = self._mail_eb.getRaw()
            self._mail_text.visible = True
            self.set_load_pane(True)

    def on_hlink_click(self, data, interface_id):
        Win.on_hlink_click(self, data, interface_id)
        if interface_id == LoginWin.interface_id:
            self.notify_listeners(EventType.OnRegisterRequest)

    def _on_cancel_click(self):
        self.notify_listeners(WinET.OnRequestExit)

    def _on_eb_value_changed(self, by_user):
        if by_user:
            self.restore_error_text()

    def on_show(self):
        Win.on_show(self)
        self.state = State.Mail
        self._code_eb.clear(False)
        self._secret_eb.clear(False)

    def on_browser_shown(self):
        Win.on_browser_shown(self)
        self._mail_eb.on_hide()
        self._secret_eb.on_hide()
        self._code_eb.on_hide()

    def on_hide(self):
        Win.on_hide(self)
        self._mail_eb.on_hide()
        self._secret_eb.on_hide()
        self._code_eb.on_hide()