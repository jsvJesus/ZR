class ItemSlot:
    _red_color = (96, 27, 27, 255)

    def __init__(self):
        comp = GUI.Window()
        comp.isClip = False
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.filterType = 'LINEAR'
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        self.component = comp
        comp = GUI.Frame2('soGUI/frame/promo_gui/frame_promo.dds')
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.width, comp.height = (2, 2)
        comp.materialFX = 'BLEND'
        comp.colour = ItemSlot._red_color
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'image')
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.materialFX = 'SOLID'
        comp.colour = ItemSlot._red_color
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = (40, 20)
        comp.position = (-1, 1, 0.5)
        self.component.addChild(comp)
        self._text_back_comp = comp
        comp = GUI.Text(u'??', 'RobotoCondensedRegular_16.font')
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.5)
        self._text_back_comp.addChild(comp)
        self._text_comp = comp

    def set_item(self, item_type, count):
        if not ItemsUtils.GetIconName(None, item_type):
            icon_name = 'nottexture.dds'
            comp = self.component.image
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.position = (0, 0, 0.5)
            comp.texture = BWPersonality.GUICore.get_icon_from_cache(icon_name)
            comp.width, comp.height = comp.texture.width, comp.texture.height
            self._text_comp.text = count > 1 and unicode(count)
            self._text_back_comp.visible = True
        else:
            self._text_back_comp.visible = False
        return


class ItemsView:

    def __init__(self, component):
        self.component = component
        self.component.isClip = False
        self._slots = []
        self._columns_count = 6
        self._slot_width = 64
        self._slot_height = 64
        self._hor_space = 28
        self.component.width = self._columns_count * self._slot_width + self._hor_space * (self._columns_count - 1)

    def set_items(self, stritems):
        items = []
        if stritems:
            try:
                for item_data in stritems.split(' '):
                    item_data = item_data.split('*')
                    if len(item_data) == 2:
                        item_type, count = item_data[0], int(item_data[1])
                    else:
                        item_type, count = item_data[0], 1
                    items.append((int(item_type), count))

            except:
                print 'Promo items (ERROR):', repr(stritems)
                traceback.print_stack()
                traceback.print_exc()
                items = []

        if items:
            vert_space = 8
            column = 0
            y_pos = 0
            for i, item_data in enumerate(items):
                if i == len(self._slots):
                    slot = ItemSlot()
                    self._slots.append(slot)
                    self.component.addChild(slot.component)
                    slot.component.width, slot.component.height = self._slot_width, self._slot_height
                slot = self._slots[i]
                x_pos = column * self._slot_width + self._hor_space * column
                slot.component.position = (x_pos, y_pos, 0.5)
                slot.component.visible = True
                slot.set_item(*item_data)
                column += 1
                if column >= self._columns_count and i < len(items) - 1:
                    column = 0
                    y_pos += self._slot_height + vert_space

            for i in range(i + 1, len(self._slots)):
                self._slots[i].component.visible = False

            self.component.visible = True
            self.component.height = y_pos + self._slot_height
        else:
            self.component.visible = False
            self.component.height = 0


class Content:
    interface_id = 'Promo.PersonalWin.Content'

    def __init__(self, component):
        self.component = component
        comp = GUI.Text(lc('PromoGui.personalwin.youget1'), 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (26, 0, 0.5)
        comp.colour = (0, 0, 0, 255)
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (0, 30, 0.5)
        self.component.addChild(comp)
        self._items_view = ItemsView(comp)
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (26, 0, 0.5)
        self._tf = TextField(comp, width=self.component.width - 52)
        self.component.addChild(comp)
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width * 0.5, 0, 0.1)
        tf = TextField(comp, width=self.component.width - 32, height=28, font='RobotoCondensedRegular_24.font', align='center')
        tf.INTERFACE_ID = Content.interface_id
        tf.setText(u'<hlink={0};>'.format(lc('PromoGui.personalwin.logout')))
        self.component.addChild(comp)
        self._logout_tf = tf

    def apply(self, itemstr, perc_data):
        self._items_view.set_items(itemstr)
        perc, serv_perce = perc_data
        text = lc('PromoGui.personalwin.youget2').format(perc)
        for serv_data in serv_perce:
            text += u'\n* {0} - {1}%'.format(serv_data['serv'], int(serv_data['perc']))

        self._tf.setText(text)
        self._tf.component.position[1] = self._items_view.component.height + self._items_view.component.position[1]
        self._logout_tf.component.position[1] = self._tf.component.position[1] + self._tf.component.height + 8
        self.component.height = self._logout_tf.component.position[1] + self._logout_tf.component.height