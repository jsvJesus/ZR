    @property
    def expanded(self):
        return self._expanded

    @expanded.setter
    def expanded(self, value):
        if value == self._expanded:
            return
        self._expanded = value
        self._update_expansion()

    @property
    def secret(self):
        return self._secret

    @secret.setter
    def secret(self, value):
        self._secret = value
        self._secret_comp.visible = bool(value)
        self._update_expansion()

    def on_update_partner_info(self):
        self._update_dynamic_content()
        if not BigWorld.player()._partner_id:
            self.notify_listeners(WinET.OnRequestExit)

    def _on_expand_click(self):
        self.expanded = not self.expanded

    def _on_copy_key_click(self):
        BigWorld.clipboardSetPlainText(self.secret)

    def _on_copy_promo_click(self):
        BigWorld.clipboardSetPlainText(BigWorld.player()._partner_promo_code)

    def _update_expansion(self):
        if self._secret_comp.visible:
            self._promo_comp.position[1] = self._tf_pos + 62
        else:
            self._promo_comp.position[1] = self._tf_pos - 8
        pos = self._promo_comp.position[1] + 32
        if self.expanded:
            self._content.component.visible = True
            self._content.component.position[1] = pos + 42
            pos += self._content.component.height + 8
            self._expand_btn.image = 'soGUI/frame/promo_gui/expand.dds'
        else:
            self._content.component.visible = False
            self._expand_btn.image = 'soGUI/frame/promo_gui/expand_down.dds'
        pos += 60
        self._expand_btn.component.position[1] = pos
        pos += 26
        self._website_comp.position[1] = pos
        pos += 32
        self._program_comp.position[1] = pos
        pos += 48
        self.component.height = pos
        Utils.roundComponentPos(self)

    def _update_dynamic_content(self):
        self._promo_text.text = BigWorld.player()._partner_promo_code
        p = BigWorld.player()
        self._content.apply(p._partner_stritems, p._partner_perc)
        self._update_expansion()

    def on_hlink_click(self, data, interface_id):
        Win.on_hlink_click(self, data, interface_id)
        if interface_id == Content.interface_id:

            def on_confirm():
                self.message_box.hide()
                self.set_load_pane(True)
                self.notify_listeners(EventType.OnUnsubscribeRequest)

            self.message_box.set_text(lc('PromoGui.personalwin.confirm_text'))
            self.message_box.set_btn1_text(lc('PromoGui.personalwin.confirm_yes'))
            self.message_box.set_btn2_text(lc('PromoGui.personalwin.confirm_no'))
            self.message_box.set_btn1_callback(on_confirm)
            self.message_box.show()

    def on_show(self):
        Win.on_show(self)
        self.secret = None
        self.expanded = False
        self._update_dynamic_content()
        return

    def on_hide(self):
        Win.on_hide(self)
        self._edit_box.on_hide()
        self.secret = None
        return