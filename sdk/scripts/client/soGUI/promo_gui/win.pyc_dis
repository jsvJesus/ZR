class EventType:
    OnRequestExit, = ((r, 'promo_win') for r in range(1))


class TextField(soTextField3):

    def __init__(self, comp, width, height = 0, font = 'RobotoCondensedRegular_16.font', align = 'left'):
        autosize = height == 0
        soTextField3.__init__(self, comp, width=width, height=height, borderWidth=0, vOffset=0, hOffset=0, textWidth=-1, hScroll=False, vScroll=False, autosize=autosize)
        self.INTERFACE_ID = Win.interface_id
        self.HLINK_STYLE = 'soGUI/visual_styles/hlink_promo.xml'
        self.DEFAULT_FONT = font
        self.DEFAULT_COLOR = (0, 0, 0, 255)
        self.DEFAULT_ALIGNMENT = align
        self.component.focus = False
        self.component.moveFocus = False

    def setText(self, text, immidiate = True):
        soTextField3.setText(self, text, immidiate=immidiate)


class EditBox(soEditBox2):

    def __init__(self, width, masc_char, pholder = None, validator = None):
        comp = GUI.Window()
        soEditBox2.__init__(self, comp, width=width, hOffset=12, height=0, font='RobotoCondensedRegular_24.font', inputValidator=validator or (lambda *args: True), autosize=True, maskChar=masc_char, placeholder=pholder)
        self.onBound()
        self.setEnableCopyPaste(True)

    def set_readonly(self, readonly):
        self.component.textPlane.mouseButtonFocus = not readonly
        self.component.textPlane.moveFocus = not readonly
        self.component.textPlane.crossFocus = not readonly
        if readonly:
            self.activate(False)

    def runErrorNotify(self):
        if self.errorNotifier:
            self.errorNotifier.stop()
        self.errorNotifier = self._special_erroneous_state()
        self.errorNotifier.run()

    @BWMemberCoroutine
    def _special_erroneous_state(self):
        for i in range(4):
            self.erroneous = True
            self.updateVisuals()
            yield BWWaitForPeriod(0.05)
            self.erroneous = False
            self.updateVisuals()
            yield BWWaitForPeriod(0.05)

        self.errorNotifier = None
        return

    def on_hide(self):
        self.activate(False)
        self.stopErrorNotify()


class Win(Listenable):
    interface_id = 'Promo.Win'
    message_box = None
    RED_COLOUR = (96, 27, 27, 255)

    def __init__(self):
        Listenable.__init__(self)
        comp = GUI.Window('textures/default/white.dds')
        comp.materialFX = 'SOLID'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.colour = (255, 250, 230, 255)
        comp.height, comp.width = (400, 600)
        comp.position = (0, 0, 0.05)
        comp.visible = False
        self._error_tf = None
        self._origin_tf = None
        self._error_time = 0
        self.component = comp
        self.setup_content()
        return

    def setup_content(self):
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.filterType = 'LINEAR'
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (18, 18)
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width - 8, 8, 0.0)
        button = PaintButton(comp, visual_state='soGUI/frame/storehouse/storeImageButton.xml')
        button.hover_sound = None
        button.image = 'soGUI/frame/storehouse/x.dds'
        button.on_click = lambda : self._on_close_click()
        self.component.addChild(comp, 'close_btn')
        button.do_reposition()
        comp = GUI.Window('textures/default/white.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (0, 0, 0, 150)
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.1)
        self.component.addChild(comp, 'load_pane')
        Interceptor(comp, interscept_keys=True)
        comp.visible = False
        comp = GUI.Simple('soGUI/frame/journal/load_anim/load_pips')
        comp.materialFX = 'BLEND'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (35, 10)
        comp.position = (0, 0, 0.5)
        self.component.load_pane.addChild(comp, 'load_pips')
        return

    def create_caption(self, text):
        comp = GUI.Text(text, 'RobotoCondensedRegular_24.font')
        comp.colour = Win.RED_COLOUR
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.position = (0, 48, 0.3)
        self.component.addChild(comp)

    def set_load_pane(self, value):
        self.component.load_pane.visible = value

    def create_buttons(self):
        width, height = (260, 46)
        space = 24
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width, height
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (space, 0, 0.3)
        button0 = PaintButton(comp, visual_state='soGUI/frame/promo_gui/button1.xml')
        self.component.addChild(comp, 'btn0')
        button0.do_reposition()
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = width, height
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width - space, 0, 0.3)
        button1 = PaintButton(comp, visual_state='soGUI/frame/promo_gui/button2.xml')
        self.component.addChild(comp, 'btn1')
        button1.do_reposition()
        self.align_buttons()
        return (button0, button1)

    def align_buttons(self):
        space = 24
        self.component.btn0.position[1] = self.component.height - space
        self.component.btn1.position[1] = self.component.height - space

    def set_error_text_field(self, origin_tf):
        origin_comp = origin_tf.component
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = origin_comp.widthMode, origin_comp.heightMode
        comp.horizontalAnchor, comp.verticalAnchor = origin_comp.horizontalAnchor, origin_comp.verticalAnchor
        comp.horizontalPositionMode, comp.verticalPositionMode = origin_comp.horizontalPositionMode, origin_comp.verticalPositionMode
        comp.width, comp.height = origin_comp.width, origin_comp.height
        comp.position = origin_comp.position
        tf = soTextField3(comp, width=origin_tf.width, height=origin_tf.height, borderWidth=0, vOffset=0, hOffset=0, textWidth=-1, hScroll=False, vScroll=False)
        tf.DEFAULT_COLOR = cc.red_rgba
        tf.DEFAULT_FONT = origin_tf.DEFAULT_FONT
        tf.DEFAULT_ALIGNMENT = origin_tf.DEFAULT_ALIGNMENT
        comp.focus = False
        comp.moveFocus = False
        comp.visible = False
        self._error_tf = tf
        self._origin_tf = origin_tf
        self.component.addChild(comp)

    def restore_error_text(self):
        if self._error_tf:
            self._error_tf.component.visible = False
        if self._origin_tf:
            self._origin_tf.component.visible = True

    def set_error_text(self, text):
        if self._origin_tf:
            self._origin_tf.component.visible = False
        if self._error_tf:
            self._error_tf.component.visible = True
            self._error_tf.setText(text, immidiate=True)

    def on_promo_event(self, code):
        if PCODE.is_error(code):
            self.set_error_text(lc(PCODE.get_lc(code)))

    def on_reg_partner(self, email, secret):
        pass

    def on_update_partner_info(self):
        pass

    def on_use_promocode(self, stritems):
        pass

    def on_hlink_click(self, data, interface_id):
        pass

    def _hlink_event(self, event, data):
        if event != HyperLink.EVENT_CLICK:
            return
        data, interface_id = data
        if interface_id == Win.interface_id:
            BWPersonality.GUICore.showWebEmbdeded(True, data)
            self.on_browser_shown()
        else:
            self.on_hlink_click(data, interface_id)

    def on_browser_shown(self):
        pass

    @property
    def visible(self):
        return self.component.visible

    def show(self):
        if not self.visible:
            self.component.visible = True
            self.on_show()

    def hide(self):
        if self.visible:
            self.on_hide()
            self.component.visible = False

    def on_show(self):
        BWPersonality.GUICore.addListener('hlinkEvent', self._hlink_event)
        Utils.roundComponentPos(self)

    def on_hide(self):
        BWPersonality.GUICore.removeListener('hlinkEvent', self._hlink_event)
        self.restore_error_text()
        self.set_load_pane(False)

    def _on_close_click(self):
        self.notify_listeners(EventType.OnRequestExit)

    @property
    def message_box(self):
        return Win.message_box