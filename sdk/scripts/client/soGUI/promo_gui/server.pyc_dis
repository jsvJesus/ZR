# Embedded file name: ./client/soGUI/promo_gui/server.py
import BigWorld
from utils import Listenable

class EventType:
    OnPromoEvent, OnRegPartner, OnUpdatePartnerInfo, OnUsePromocode = ((r, 'promo.server') for r in range(4))


class Server(Listenable):

    def __init__(self, parent):
        Listenable.__init__(self)
        self._active = False
        self._callback_handler = None
        self._wait_until_time = 0
        self._min_wait_time = 1.5
        self._pending_data = []
        parent.on_promo_event = self._on_promo_event
        parent.on_reg_partner = self._on_reg_partner
        parent.on_use_promocode = self._on_use_promocode
        parent.on_update_partner_info = self._on_update_partner_info
        return

    def on_show(self):
        self._active = True

    def on_hide(self):
        self._active = False
        self._pending_data = []
        if self._callback_handler:
            BigWorld.cancelCallback(self._callback_handler)
            self._callback_handler = None
        return

    def _check_pending_data(self):
        if self._callback_handler:
            BigWorld.cancelCallback(self._callback_handler)
            self._callback_handler = None
        if self._active:
            if BigWorld.time() >= self._wait_until_time:
                for event_type, data in self._pending_data:
                    self.notify_listeners(event_type, data)

            else:
                self._callback_handler = BigWorld.callback(BigWorld.time() - self._wait_until_time + 0.1, self._check_pending_data)
                return
        self._pending_data = []
        return

    def _on_promo_event(self, code):
        if self._active:
            data = {'code': code}
            self._pending_data.append((EventType.OnPromoEvent, data))
            self._check_pending_data()

    def _on_use_promocode(self, stritems):
        if self._active:
            data = {'stritems': stritems}
            self._pending_data.append((EventType.OnUsePromocode, data))
            self._check_pending_data()

    def _on_reg_partner(self, email, secret):
        if self._active:
            data = {'email': email,
             'secret': secret}
            self._pending_data.append((EventType.OnRegPartner, data))
            self._check_pending_data()

    def _on_update_partner_info(self):
        if self._active:
            self._pending_data.append((EventType.OnUpdatePartnerInfo, None))
            self._check_pending_data()
        return

    def start_reg_partner(self, mail_text, delay = True):
        if self._active:
            if delay:
                self._wait_until_time = BigWorld.time() + self._min_wait_time
            BigWorld.player().base.startRegPartner(str(mail_text))

    def subscribe_partner(self, mail, secret, delay = True):
        if self._active:
            if delay:
                self._wait_until_time = BigWorld.time() + self._min_wait_time
            BigWorld.player().base.subscPartner(mail, secret)

    def continue_subscribe_partner(self, code, delay = True):
        if self._active:
            if delay:
                self._wait_until_time = BigWorld.time() + self._min_wait_time
            BigWorld.player().base.continueSubscPartner(code)

    def use_promo_code(self, code, delay = True):
        if self._active:
            if delay:
                self._wait_until_time = BigWorld.time() + self._min_wait_time
            BigWorld.player().base.usePromoCode(code)

    def unsubscribe_partner(self, delay = True):
        if self._active:
            if delay:
                self._wait_until_time = BigWorld.time() + self._min_wait_time
            BigWorld.player().base.unSubscPartner()

    def continue_reg_parnter(self, code_text, delay = True):
        if self._active:
            if delay:
                self._wait_until_time = BigWorld.time() + self._min_wait_time
            BigWorld.player().base.continueRegPartner(code_text)