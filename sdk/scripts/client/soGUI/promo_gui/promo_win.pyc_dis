# Embedded file name: ./client/soGUI/promo_gui/promo_win.py
import GUI
from win import Win, EditBox, TextField, EventType as WinET
from Localization import lc
from promo_code_constant import PCODE

class State:
    Promo, WaitPromo = range(2)


class EventType:
    OnRequestPromo, = ((r, 'promo.PromoWin') for r in range(1))


class PromoWin(Win):

    def setup_content(self):
        Win.setup_content(self)
        self._state = None
        self.create_caption(lc('PromoGui.promowin.caption'))
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width * 0.5, 86, 0.5)
        tf = TextField(comp, width=self.component.width - 32, height=40, font='RobotoCondensedRegular_18.font', align='center')
        tf.setText(lc('PromoGui.promowin.entercode'))
        self.component.addChild(comp)
        self.set_error_text_field(tf)
        comp = GUI.Text(lc('PromoGui.promowin.code'), 'RobotoCondensedRegular_24.font')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (26, 146, 0.5)
        comp.colour = Win.RED_COLOUR
        self.component.addChild(comp)
        self._promo_eb = EditBox(432, None)
        self._promo_eb.onValueChange = self._on_eb_value_changed
        comp = self._promo_eb.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
        comp.position = (self.component.width - 26, 146, 0.5)
        self.component.addChild(comp)
        self._apply_btn, cancel_btn = self.create_buttons()
        self._apply_btn.text = lc('PromoGui.promowin.apply_btn')
        self._apply_btn.on_click = self._on_apply_click
        cancel_btn.text = lc('PromoGui.promowin.cancel_btn')
        cancel_btn.on_click = self._on_cancel_click
        return

    def on_promo_event(self, code):
        Win.on_promo_event(self, code)
        if PCODE.is_error(code):
            if self.state == State.WaitPromo:
                self.state = State.Promo

    @property
    def state(self):
        return self._state

    @state.setter
    def state(self, value):
        if self._state == value:
            return
        self._state = value
        height0 = 280
        if value == State.Promo:
            self.component.height = height0
            self._apply_btn.enabled = True
            self.align_buttons()
            self._promo_eb.set_readonly(False)
            self.set_load_pane(False)
        elif value == State.WaitPromo:
            self.component.height = height0
            self._apply_btn.enabled = False
            self._promo_eb.set_readonly(True)
            self.align_buttons()
            self.set_load_pane(True)

    def _on_cancel_click(self):
        self.notify_listeners(WinET.OnRequestExit)

    def _on_apply_click(self):
        self.restore_error_text()
        if self.state == State.Promo:
            promo_text = self._promo_eb.getRaw()
            valid = False
            if promo_text:
                try:
                    promo_text = str(promo_text)
                    valid = True
                except:
                    pass

            if valid:
                data = {'code': promo_text}
                self.notify_listeners(EventType.OnRequestPromo, data)
                self.state = State.WaitPromo
            else:
                self._promo_eb._inputError()

    def _on_eb_value_changed(self, by_user):
        if by_user:
            self.restore_error_text()

    def on_show(self):
        Win.on_show(self)
        self.state = State.Promo
        self._promo_eb.clear(False)

    def on_hide(self):
        Win.on_hide(self)
        self._promo_eb.on_hide()