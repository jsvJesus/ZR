        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'CENTER')
        cmp.materialFX = 'SOLID'
        cmp.width = self.SLOTWIDTH - border * 2
        cmp.height = self.SLOTHEIGHT - border * 2
        cmp.position = (0, 0, 0.9)
        self.component.addChild(cmp, 'fon')
        self._fon = cmp
        cmp = GUI.Text('', 'RobotoCondensedRegular_16.font')
        cmp.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
        cmp.position = (30, 5, 0.0)
        self.component.addChild(cmp, 'cam_name')
        self._cam_name = cmp
        self._cb_cam_active = soCheckBox(GUI.Window())
        cmp = self._cb_cam_active.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.materialFX = 'BLEND'
        cmp.position = (10, 5, 0.0)
        self.component.addChild(cmp, '_cb_cam_active')
        self._cb_cam_active.onBound()
        self._cb_cam_active.onStateChange = self._on_cb_cam
        btn = ImageButton(image_path='soGUI/elements/cam_editor/btn_save_cam.dds', h_anchor='CENTER', v_anchor='CENTER', position=(WIN_W - 230, 15, 0.0), on_click=self.on_btn_save_cam)
        self.component.addChild(btn.component, 'btn_save_cam')
        btn.set_state_icon('pressed', 'soGUI/elements/cam_editor/btn_save_cam_on.dds')
        btn.set_tooltip(lc('cam_editor_win.cam_win.btn_save_cam_tip'))
        self._btn_save_cam = btn
        btn = ImageButton(image_path='soGUI/elements/cam_editor/btn_del_cam.dds', h_anchor='CENTER', v_anchor='CENTER', position=(WIN_W - 200, 15, 0.0), on_click=self.on_btn_del_cam)
        self.component.addChild(btn.component, 'btn_del_cam')
        btn.set_state_icon('pressed', 'soGUI/elements/cam_editor/btn_del_cam_on.dds')
        btn.set_tooltip(lc('cam_editor_win.cam_win.btn_del_cam_tip'))
        num_box = NumBox()
        cmp = num_box.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'CENTER')
        cmp.position = (WIN_W - 160, 15, 0.0)
        cmp.script.onDefaultAction = self._on_box_speed
        self.component.addChild(cmp, 'box_speed')
        num_box.onBound()
        self._box_speed = num_box
        num_box = NumBox()
        cmp = num_box.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'CENTER')
        cmp.position = (WIN_W - 120, 15, 0.0)
        cmp.script.onDefaultAction = self._on_box_fov
        self.component.addChild(cmp, 'box_fov')
        num_box.onBound()
        self._box_fov = num_box
        num_box = NumBox(width=40, max_chars=5)
        cmp = num_box.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'CENTER')
        cmp.position = (WIN_W - 80, 15, 0.0)
        cmp.script.onDefaultAction = self._on_box_dof
        self.component.addChild(cmp, 'box_dof')
        num_box.onBound()
        self._box_dof = num_box
        btn = ImageButton(image_path='soGUI/elements/cam_editor/btn_add_cam.dds', h_anchor='CENTER', v_anchor='CENTER', position=(WIN_W - 40, 15, 0.0), on_click=self.on_btn_add_cam)
        self.component.addChild(btn.component, 'btn_add_cam')
        btn.set_state_icon('pressed', 'soGUI/elements/cam_editor/btn_add_cam_on.dds')
        btn.set_tooltip(lc('cam_editor_win.cam_win.btn_add_cam_tip'))

    def is_cam_active(self):
        return self._cb_cam_active.isChecked()

    def _on_cb_cam(self):
        active = self.is_cam_active()
        CM.save_cam(self.itemData['cam_id'], active=active)
        self._applyItemData()

    def _on_box_speed(self):
        val = self._set_speed(self._box_speed.getValue()[0].strip())
        CM.save_cam(self.itemData['cam_id'], speed=val)

    def _on_box_fov(self):
        val = self._set_fov(self._box_fov.getValue()[0].strip())
        CM.save_cam(self.itemData['cam_id'], fov=val)
        CM.apply_fov(val)

    def _on_box_dof(self):
        val = self._set_dof(self._box_dof.getValue()[0].strip())
        CM.save_cam(self.itemData['cam_id'], dof=val)
        CM.apply_dof(val)

    def _set_speed(self, val):
        val = unicode(CM.clamp_speed(val))
        self._box_speed.setValue(val)
        return val

    def _set_fov(self, val):
        val = unicode(CM.clamp_fov(val))
        self._box_fov.setValue(val)
        return val

    def _set_dof(self, val):
        val = unicode(CM.clamp_dof(val))
        self._box_dof.setValue(val)
        return val

    def _applyItemData(self):
        if not self.haveItem():
            self.component.visible = False
            return
        self.component.visible = True
        self._fon.colour = UNSELECTED_COLOR
        if self.itemData.get('selected'):
            self._fon.colour = SELECTED_COLOR
        cam = CM.get_cam_info(self.itemData['cam_id'])
        self._cb_cam_active.set_active(cam['active'])
        self._set_speed(cam['speed'])
        self._set_fov(cam['fov'])
        self._set_dof(cam['dof'])
        self._box_speed.ediatable_enable = cam['active']
        self._box_fov.ediatable_enable = cam['active']
        self._box_dof.ediatable_enable = cam['active']
        self._cam_name.colour = LABEL_DISABLED_COLOR
        if cam['active']:
            self._cam_name.colour = LABEL_COLOR
        self._cache_cam_matrix(cam)
        self.update_save_cam_icon()
        self.component.cam_name.text = CM.get_name(self.itemData['cam_id'])

    def get_cam_id(self):
        if not self.haveItem():
            return
        return self.itemData['cam_id']

    def on_btn_add_cam(self):
        CM.add_cam(self.itemData['cam_id'])

    def on_btn_del_cam(self):
        if not self.is_cam_active():
            return

        def handler(code):
            if code == gui_jokes.askUserYesNo.YES:
                CM.del_cam(self.itemData['cam_id'])

        title = lc('cam_editor_win.cam_win.del_msg_box.title')
        cam_name = cc.active_xml + CM.get_name(self.itemData['cam_id']) + cc.inactive_xml
        text = lc('cam_editor_win.cam_win.del_msg_box.text').format(cam_name)
        gui_jokes.askUserYesNo(title, text, handler, enter_btn=gui_jokes.askUserYesNo.YES)

    def on_btn_save_cam(self):
        if not self.is_cam_active():
            return

        def handler(code):
            if code == gui_jokes.askUserYesNo.YES:
                CM.save_cam(self.itemData['cam_id'], save_matrix=True)
                self._cache_cam_matrix()

        title = lc('cam_editor_win.cam_win.save_msg_box.title')
        cam_name = cc.active_xml + CM.get_name(self.itemData['cam_id']) + cc.inactive_xml
        text = lc('cam_editor_win.cam_win.save_msg_box.text').format(cam_name)
        gui_jokes.askUserYesNo(title, text, handler, enter_btn=gui_jokes.askUserYesNo.YES)

    def deactivate(self):
        self._box_speed.activate(False)
        self._box_fov.activate(False)
        self._box_dof.activate(False)

    _can_save = None
    _cached_time = 0
    _cached_matrix = None

    def _cache_cam_matrix(self, cam = None):
        if not self.haveItem():
            return
        else:
            if cam is None:
                cam = CM.get_cam_info(self.itemData['cam_id'])
            self._can_save = False
            self._cached_time = time.time()
            matrix = Matrix()
            matrix.setRotateYPR(cam['rotate'])
            matrix.translation = cam['pos']
            self._cached_matrix = matrix
            return

    def update_save_cam_icon(self):
        if not self.haveItem():
            return
        dt = time.time() - self._cached_time
        if dt < 1:
            self._btn_save_cam.set_enable(False)
            return
        selected = self.itemData.get('selected')
        if not selected:
            self._btn_save_cam.set_enable(False)
            return

        def can_save():
            """
            True \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c
            False \xd1\x83\xd0\xb6\xd0\xb5 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb0
            """
            if self._can_save:
                return True
            elif self._cached_matrix is None:
                self._can_save = True
                return True
            p0 = Vector3(1, 2, 3)
            p1 = Matrix(BigWorld.camera().invViewMatrix).applyPoint(p0)
            p2 = self._cached_matrix.applyPoint(p0)
            EPS_MOVE = 0.001
            if (p1 - p2).length > EPS_MOVE:
                self._can_save = True
                return True
            else:
                return self._can_save

        self._btn_save_cam.set_enable(can_save())


class CamListWindow(DragWin, GUIPositions):
    """
    \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd1\x81 \xd1\x82\xd1\x80\xd0\xb5\xd0\xba\xd0\xb0\xd0\xbc\xd0\xb8 \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80
    """
    factoryString = 'CamListWindow'

    def __init__(self):
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        DragWin.__init__(self, comp)
        GUIPositions.__init__(self)
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
        cmp.materialFX = 'BLEND'
        cmp.width = WIN_W
        cmp.height = WIN_H
        cmp.position = (800, 100, 0.0)

    def setupContent(self):
        offset = 3
        cmp = GUI.Window('soGUI/frame/paint/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
        cmp.materialFX = 'BLEND'
        cmp.width = WIN_W - offset * 2 - 15
        cmp.height = WIN_H - 70
        cmp.position = (offset, 35, 0.5)
        cmp.colour = INNER_COLOR
        self.component.addChild(cmp, 'inner')
        cmp = GUI.Text('', 'RobotoCondensedRegular_16.font')
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
        cmp.position = (10, 10, 0.5)
        self.component.addChild(cmp, 'title')
        self._title = cmp

        def create_btns():
            btn = soButton(GUI.Window())
            btn.initVSC('soGUI/elements/closeBox.xml')
            cmp = btn.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor, cmp.verticalAnchor = ('RIGHT', 'TOP')
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.width = 18
            cmp.height = 18
            cmp.position = (WIN_W - 5, 5, 0.5)
            cmp.script.onClick = self.hide
            self.component.addChild(cmp, 'btn_close')
            btn.onBound()

        def create_listview():
            cmp = GUI.Text('SPEED', 'RobotoCondensedRegular_16.font')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'TOP')
            cmp.materialFX = 'BLEND'
            cmp.position = (WIN_W - 160, 40, 0.5)
            self.component.addChild(cmp, 'label_speed')
            cmp = GUI.Text('FOV', 'RobotoCondensedRegular_16.font')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'TOP')
            cmp.materialFX = 'BLEND'
            cmp.position = (WIN_W - 120, 40, 0.5)
            self.component.addChild(cmp, 'label_fov')
            cmp = GUI.Text('DOF', 'RobotoCondensedRegular_16.font')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'TOP')
            cmp.materialFX = 'BLEND'
            cmp.position = (WIN_W - 80, 40, 0.5)
            self.component.addChild(cmp, 'label_dof')
            itemView = soItemView(GUI.Window(), CamSlot, slot_eventsHandler=self.slotHandler, eventsHandler=self.itemViewHandler, rowWidth=1, cols=1, hScroll=0, borderWidth=0, rows=int(WIN_H / CamSlot.SLOTHEIGHT) - 3, vScroll=1)
            cmp = itemView.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
            cmp.position = (2, 70, 0.5)
            cmp.materialFX = 'BLEND'
            self.component.addChild(cmp, 'list_view')
            itemView.setItems(None)
            itemView.onBound()
            itemView.setRestrictingComponent(None)
            self._list_view = itemView
            self.apply_cam_list()
            return

        create_btns()
        create_listview()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)

    def get_selected_index(self):
        _filtered = [ c for c in self._cam_list if c['active'] ]
        for index, cam in enumerate(_filtered):
            if cam['active'] and cam.get('selected'):
                return index

        return -1

    def on_select_cam(self, cam_id):
        self._cam_list = CM.get_cam_list()
        for cam in self._cam_list:
            cam['selected'] = bool(cam_id == cam['cam_id'] and cam['active'])

        self._list_view.setItems(self._cam_list)
        CM.stop(on_select_cam=True)

    def slotHandler(self, eventID, slot):
        if eventID == ITSLOT.SLOTEVENT_LCLICK:
            self.on_select_cam(slot.get_cam_id())

    def itemViewHandler(self, *e):
        pass

    _cam_list = []

    def apply_cam_list(self):
        self._title.text = lc('cam_editor_win.cam_win.title').format(CM._last_track_name)
        self._cam_list = CM.get_cam_list()
        self._list_view.setItems(self._cam_list)

    def deactivate_all(self):
        count = self._list_view.cols * self._list_view.rows
        for i in xrange(count):
            slot = getattr(self._list_view.component, 'slot' + str(i))
            slot.script.deactivate()

    def update_save_cam_icon_all(self):
        count = self._list_view.cols * self._list_view.rows
        for i in xrange(count):
            slot = getattr(self._list_view.component, 'slot' + str(i))
            slot.script.update_save_cam_icon()

    def apply_cam_list_index(self, index, cam_id):
        y = max(0, index - self._list_view.rows + 1)
        self._list_view.setScroll(0, y)
        self.on_select_cam(cam_id)

    def show(self, *w, **kw):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'CamListWindow')
        self.component.visible = True
        self.component.moveFocus = True
        self.component.focus = True
        GUIPositions.show(self)
        return

    def hide(self):
        self.component.visible = False

    def is_visible(self):
        return self.component.visible