    def _write_file(self, file_path, data):
        try:
            _str = pyson.dumps(data)
            with open(file_path, 'wb') as fh:
                fh.write(_str)
        except:
            print '[ERROR] _write_file', [file_path]
            traceback.print_exc()

    def _read_file(self, file_path):
        try:
            with open(file_path, 'rb') as fh:
                data = pyson.loads(fh.read())
        except:
            print '[ERROR] _read_file', [file_path]
            traceback.print_exc()
            return

        return data

    def get_track_list(self):
        track_list = []
        space_name = self.get_sync_space()
        for i, track_name in enumerate(sorted(self.space2tracks[space_name].keys())):
            track_list.append({'track_name': track_name,
             'track_index': i})

        return track_list

    def save_config(self):
        """\xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbd\xd0\xb0 \xd0\xb4\xd0\xb8\xd1\x81\xd0\xba"""
        for space_name in self.space2tracks:
            for track_name, track_data in self.space2tracks[space_name].items():
                _track_data = copy.deepcopy(track_data)
                to_del_keys = ('see_code', 'see_id', 'see_pos')
                for k in to_del_keys:
                    if k in _track_data:
                        del _track_data[k]

                file_path = os.path.join(CAM_EDITOR_DIR, '%s.ced' % track_name)
                self._write_file(file_path, _track_data)

        self._draw_cam_models()
        self._cam_list_win.deactivate_all()

    def _validate_track_data(self, track_data):
        if 'cam_list' not in track_data:
            track_data['cam_list'] = []
        try:
            for cam in track_data['cam_list']:
                if 'cam_id' not in cam:
                    raise ValueError('no cam_id')
                if 'pos' not in cam:
                    raise ValueError('no pos')
                if 'rotate' not in cam:
                    raise ValueError('no rotate')
                if 'active' not in cam:
                    cam['active'] = True
                if 'speed' not in cam:
                    cam['speed'] = DEFAULT_SPEED
                if 'fov' not in cam:
                    cam['fov'] = DEFAULT_FOV
                if 'dof' not in cam:
                    cam['dof'] = DEFAULT_DOF

        except:
            print '[ERROR] _validate_track_data', track_data
            raise

        return track_data

    space2tracks = dict()

