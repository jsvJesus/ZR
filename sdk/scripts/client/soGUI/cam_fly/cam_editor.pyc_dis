    def _applyItemData(self):
        if not self.haveItem():
            self.component.visible = False
            return
        self.component.visible = True
        self._fon.colour = UNSELECTED_COLOR
        if self.itemData.get('selected'):
            self._fon.colour = SELECTED_COLOR
        self.component.track_name.text = '%s: %s' % (self.itemData['track_index'] + 1, self.itemData['track_name'])

    def get_track_name(self):
        if not self.haveItem():
            return
        return self.itemData['track_name']

    def _on_btn_see_pers(self):
        if getattr(BWPersonality.GUICore, 'cam_editor', None):
            BWPersonality.GUICore.cam_editor.on_select_track(self.get_track_name())
        CM.on_btn_see_pers()
        return

    def _on_btn_see_obj(self):
        if getattr(BWPersonality.GUICore, 'cam_editor', None):
            BWPersonality.GUICore.cam_editor.on_select_track(self.get_track_name())
        CM.on_btn_see_obj()
        return

    def _on_btn_cam_list(self):
        if getattr(BWPersonality.GUICore, 'cam_editor', None):
            BWPersonality.GUICore.cam_editor.on_select_track(self.get_track_name(), to_show=True)
        return

    def update_state_btns(self):
        if not self.haveItem():
            return
        self._btn_see_pers.set_toggle(False)
        self._btn_see_obj.set_toggle(False)
        see_code = CM.get_track_see_code(self.itemData['track_name'])
        if see_code == CM.SEE_PERS:
            self._btn_see_pers.set_toggle(True)
        elif see_code == CM.SEE_OBJ:
            self._btn_see_obj.set_toggle(True)


