            cmp.script.onClick = self.on_btn_load_track
            self.component.addChild(cmp, 'btn_load_track')
            btn.onBound()

        def create_listview():
            itemView = soItemView(GUI.Window(), TrackSlot, slot_eventsHandler=self.slotHandler, eventsHandler=self.itemViewHandler, rowWidth=1, cols=1, hScroll=0, borderWidth=0, rows=int(WIN_H / TrackSlot.SLOTHEIGHT) - 3, vScroll=1)
            cmp = itemView.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
            cmp.position = (2, 70, 0.5)
            cmp.materialFX = 'BLEND'
            self.component.addChild(cmp, 'list_view')
            itemView.setItems(None)
            itemView.onBound()
            itemView.setRestrictingComponent(None)
            self._list_view = itemView
            self.apply_track_list()
            return

        create_btns()
        create_listview()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)

    def on_select_track(self, track_name, to_show = False):
        if not track_name:
            return
        CM.init_cam_list(track_name, to_show)
        for x in self._track_list:
            x['selected'] = bool(track_name == x['track_name'])

        self._list_view.setItems(self._track_list)

    def slotHandler(self, eventID, slot):
        if eventID == ITSLOT.SLOTEVENT_LCLICK:
            self.on_select_track(slot.get_track_name())

    def itemViewHandler(self, *e):
        pass

    _track_list = []

    def apply_track_list(self):
        self._track_list = CM.get_track_list()
        self._list_view.setItems(self._track_list)

    _new_track_win = None

    def on_btn_new_track(self):
        """
        \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xb8\xd0\xb9 track-\xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba
        """
        if not self._new_track_win:
            self._new_track_win = NewTrackWin()
        self._new_track_win.show()

    def is_track_win_visible(self):
        if self._new_track_win:
            return self._new_track_win.component.visible

    def on_btn_load_track(self):
        """
        \xd0\xb2\xd1\x8b\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xb8\xd0\xb9 track-\xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba
        """
        import soGUI.openFileDialog as fd
        w = fd.OpenFileDialog(GUI.Window())

        def on_open_file(file_path):
            if file_path:
                CM.load_track(file_path)

        w.show(on_open_file, init_dir=unicode(CAM_EDITOR_DIR), filters=['.ced'])

    def on_btn_switch_cam(self):
        CM.switch_player_free_cam()

    def on_btn_UPDCam(self):
        """
        \xd0\xb7\xd0\xb0\xd0\xb3\xd1\x80\xd1\x83\xd0\xb6\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xb8\xd1\x81\xd1\x82\xd0\xb5\xd0\xbc\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x82\xd1\x80\xd0\xb5\xd0\xba\xd0\xbe\xd0\xb2 \xd0\xb2 \xd1\x81\xd0\xbe\xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb8 \xd1\x81 \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb5\xd0\xb9 \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb5\xd0\xb9
        """
        CM.reload_config()

    def on_see_entity(self, entity_id):
        CM.on_btn_set_see_pers(entity_id)

    def on_see_obj(self):
        CM.on_btn_set_see_obj()

    @property
    def is_set_obj_mode(self):
        return CM.is_set_obj_mode

    def update_btn_switch_cam(self, is_player_cam):
        self.btn_switch_cam.component.label.text = 'FreeCam' if is_player_cam else 'PersCam'

    def update_state_btns2(self):
        count = self._list_view.cols * self._list_view.rows
        for i in xrange(count):
            slot = getattr(self._list_view.component, 'slot' + str(i))
            slot.script.update_state_btns()

    def show(self, *w, **kw):
        self._on_show()

    def hide(self):
        self._on_hide()

    def _on_show(self):
        self.component.visible = True
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'CamEditor')
        BWPersonality.GUICore.mouseAltMode = True
        BWPersonality.GUICore.setBestCursor()
        self.component.moveFocus = True
        self.component.focus = True
        GUIPositions.show(self)
        CM.show_all()
        return

    def _on_hide(self):
        self.component.visible = False
        CM.hide_all()

    def on_exit(self):
        self.hide()
        CM.clear_all()

    def is_visible(self):
        return self.component.visible