            cmp.label.font = 'RobotoCondensedRegular_16.font'
            cmp.materialFX = 'BLEND'
            cmp.width = 100
            cmp.height = 30
            cmp.position = (2, WIN_H - 2, 0.5)
            cmp.script.onClick = self.on_btn_switch_cam
            self.component.addChild(cmp, 'btn_switch_cam')
            btn.onBound()
            self.btn_switch_cam = btn
            btn = ImageButton(image_path='soGUI/elements/cam_editor/btn_upd_cam.dds', h_anchor='LEFT', v_anchor='TOP', position=(WIN_H - 50, 40, 0.5), on_click=self.on_btn_UPDCam)
            self.component.addChild(btn.component, 'btn_upd_cam')
            btn.set_tooltip(lc('cam_editor_win.main_win.btn_upd_cam_tip'))
            btn_track_w = 100
            btn = soButton(GUI.Window())
            cmp = btn.component
            btn.initVSC('soGUI/elements/button_1.xml')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor, cmp.verticalAnchor = ('LEFT', 'TOP')
            cmp.label.font = 'RobotoCondensedRegular_16.font'
            cmp.label.text = 'New Track'
            cmp.materialFX = 'BLEND'
            cmp.width = btn_track_w
            cmp.height = 30
            cmp.position = (2, 37, 0.5)
            cmp.script.onClick = self.on_btn_new_track
            self.component.addChild(cmp, 'btn_new_track')
            btn.onBound()
            btn = soButton(GUI.Window())
            cmp = btn.component
