MATH_PI = math.pi
MATH_2PI = math.pi * 2

def clampAngles(start, end):
    rotate = end - start
    if rotate[0] <= -MATH_PI:
        end[0] += MATH_2PI
    elif rotate[0] > MATH_PI:
        end[0] -= MATH_2PI
    if rotate[1] <= -MATH_PI:
        end[1] += MATH_2PI
    elif rotate[1] > MATH_PI:
        end[1] -= MATH_2PI
    if rotate[2] <= -MATH_PI:
        end[2] += MATH_2PI
    elif rotate[2] > MATH_PI:
        end[2] -= MATH_2PI


from Math import Vector3, Matrix

def get_look_at_matrix(start_pos, end_pos):
    normed_w_dir = end_pos - start_pos
    normed_w_dir.normalise()
    up = Vector3(0, 1, 0)
    m = Matrix()
    m.lookAt(start_pos, normed_w_dir, up)
    try:
        m.invert()
    except:
        m = Matrix()
        m.translation = Vector3(start_pos)

    return m


