    def on_btn_reset(self):
        """
        \xd1\x81\xd0\xb1\xd1\x80\xd0\xbe\xd1\x81 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8 \xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb3\xd0\xbe\xd0\xb4\xd1\x8b
        """
        player = BigWorld.player()
        if not player:
            return
        if player.clientAccessLevel < 1:
            player.systemMsgChat(lc('cam_editor_win.no_rights'))
            return
        player.cell.reset_ingame_time_and_weather()

    def on_btn_apply(self):
        """
        \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb0 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8 \xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb3\xd0\xbe\xd0\xb4\xd1\x8b
        """
        player = BigWorld.player()
        if not player:
            return
        if player.clientAccessLevel < 1:
            player.systemMsgChat(lc('cam_editor_win.no_rights'))
            return

        def set_time(s):

            def get_nums():
                res = []
                digits = []
                for c in s:
                    if c.isdigit():
                        digits.append(c)
                    elif digits:
                        res.append(int(''.join(digits)))
                        digits = []

                if digits:
                    res.append(int(''.join(digits)))
                return res

            t = get_nums()
            hh = 0
            mm = 0
            if len(t) >= 1 and t[0]:
                hh = min(t[0], 24)
            if len(t) >= 2 and t[1]:
                mm = min(t[1], 60)
            BigWorld.timeOfDay('%s:%s' % (hh, mm))

        set_time(self.edit_time.getValue()[0])
        weather_name = self.combobox.getSelection()[0].encode('utf-8')
        player.onWeatherChanged(weather_name)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'TimeWeatherWin')
        self.component.visible = True
        self.component.moveFocus = True
        self.component.focus = True
        GUIPositions.show(self)
        return

    def hide(self):
        self.component.visible = False
        self.combobox.showList(False)


