        cmp.position = (6, 115, 0.5)
        self.component.addChild(cmp, 'btn_weather')
        btn.onBound()
        cmp.script.onClick = self._on_btn_weather

        def create_btns():
            btn_size = 50
            btn_names = ['btn_play',
             'btn_stop',
             'btn_pause',
             'btn_back']
            btn_funcs = [self.on_play,
             self.on_stop,
             self.on_pause,
             self.on_backplay]
            btn_tips = [lc('cam_editor_win.player_win.btn_play_tip'),
             lc('cam_editor_win.player_win.btn_stop_tip'),
             lc('cam_editor_win.player_win.btn_pause_tip'),
             lc('cam_editor_win.player_win.btn_back_tip')]
            self._btns = {}
            for i in xrange(len(btn_names)):
                btn_name = btn_names[i]
                tooltip = btn_tips[i]
                btn = ImageButton(image_path='soGUI/elements/cam_editor/%s.dds' % btn_name, h_anchor='LEFT', v_anchor='TOP', position=(5 * (i + 1) + btn_size * i, 35, 0.0), on_click=btn_funcs[i])
                self.component.addChild(btn.component, btn_name)
                btn.set_state_icon('pressed', 'soGUI/elements/cam_editor/%s_on.dds' % btn_name)
                btn.set_tooltip(tooltip)
                self._btns[btn_name] = btn

        create_btns()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)

    _time_weather_win = None

    def _on_btn_weather(self):
        if not self._time_weather_win:
            self._time_weather_win = TimeWeatherWin()
        self._time_weather_win.show()

    def _on_cb_loop(self, *e):
        CM.is_loop_active = self._cb_loop.isChecked()
        CM._draw_cam_models()

    def set_label_speed(self):
        self._label_speed.text = u'fly: {0:.1f}'.format(CM._speed_mouse_coef)
        self._label_speed2.text = u'WASD: {0:.1f}'.format(CM._wasd_speed)

    def update_state_btns(self):
        for btn in self._btns.values():
            btn.set_toggle(False)

        if CM.is_pause:
            self._btns['btn_pause'].set_toggle(True)
        elif CM.is_play:
            if CM.is_stop:
                pass
            elif CM.play_forward:
                self._btns['btn_play'].set_toggle(True)
            else:
                self._btns['btn_back'].set_toggle(True)

    def _hook_key_event(self, event):
        if event.isRepeatedEvent() or not event.isKeyDown():
            return False
        key = event.key
        if key == Keys.KEY_Z:
            self.on_play()
            return True
        if key == Keys.KEY_X:
            self.on_stop()
            return True
        if key in (Keys.KEY_C, Keys.KEY_SPACE):
            self.on_pause()
            return True
        if key == Keys.KEY_V:
            self.on_backplay()
            return True
        if key == Keys.KEY_B:
            CM.on_btn_see_pers()
            return True
        if key == Keys.KEY_N:
            CM.on_btn_see_obj()
            return True
        if key == Keys.KEY_L:
            self._cb_loop.set_active(not self._cb_loop.isChecked())
            self._on_cb_loop()
            return True
        if key == Keys.KEY_F9:
            CM.show_hide_gui()
            return True
        if key == Keys.KEY_ESCAPE:
            CM.stop()
            CM.show_hide_gui(force_show=True)
            return True
        return False

    def on_play(self):
        CM.play()

    def on_stop(self):
        CM.stop()

    def on_pause(self):
        CM.pause()

    def on_backplay(self):
        CM.backplay()

    def show(self, *w, **kw):
        self._on_show()

    def hide(self):
        self._on_hide()

    def _on_show(self):
        self.component.visible = True
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'CamPlayerWin')
        self.component.moveFocus = True
        self.component.focus = True
        GUIPositions.show(self)
        BWPersonality.register_key_event_interceptor(self._hook_key_event)
        return

    def _on_hide(self):
        self.component.visible = False
        if self._time_weather_win:
            self._time_weather_win.hide()
        BWPersonality.unregister_key_event_interceptor(self._hook_key_event)

    def is_visible(self):
        return self.component.visible