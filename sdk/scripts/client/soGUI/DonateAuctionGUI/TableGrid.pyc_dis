# Embedded file name: ./client/soGUI/DonateAuctionGUI/TableGrid.py
import Codes
import BWPersonality
from Localization import lc
import GUI
import soGUI
from soGUI.soList_optimized import soList_optimized
import utils
from client_utils import time_to_string
import colorCodes as cc

class TableGrid(soList_optimized):

    def __init__(self, columns_data, comp, width, height, row_height, select_callback):
        self._columns_data = columns_data
        struct_data = soGUI.ListPropsStructure(width=width, height=height, elemStyle='soGUI/elements/listElementBoard.xml', isMultiSel=False, elemHeight=row_height, selectCallBack=self._row_selected, sorted=False)
        soList_optimized.__init__(self, comp, struct_data, default_frame_skin=u'')
        self._select_callback = select_callback

    def _row_selected(self):
        selection = self.getSelection()
        if selection:
            self._select_callback(self.getAttachment(selection[0]))

    def _readraw_element(self, i, elem):
        base_data = self.get_base_data_by_index(elem)
        component = self.elemComps[i].component
        component.baseName.text = lc('DonateBases.name.' + base_data['name'])
        if not base_data['clan_name'].decode('utf8'):
            component.owner.text = lc('GUI.DonateBase.noFartherRent')
            has_owner = bool(base_data['clan_name'])
            int_time = max(0, int(base_data['sell_time'] - BWPersonality.gpd.server_time))
            str_time = time_to_string(int_time)
            colour_rgba = has_owner and cc.inactive_rgba
            colour_hex = cc.inactive_hex
            component.time.text = lc('GUI.DonateBase.busy')
            component.stake.text = lc('GUI.DonateBase.rent_time') + ' ' + cc.active_hex + str_time
        else:
            component.time.text = str_time
            component.stake.text = utils.groupNumber(base_data['last_stake']['price'])
            code = base_data['last_stake']['code']
            if code == Codes.AUCTION_STAKE_NONE:
                colour_rgba = cc.highlighted2_rgba
                colour_hex = cc.highlighted2_hex
            elif code == Codes.AUCTION_STAKE_WIN:
                colour_rgba = cc.green_rgba
                colour_hex = cc.green_hex
            elif code == Codes.AUCTION_STAKE_SPOILED:
                colour_rgba = cc.red_rgba
                colour_hex = cc.red_hex
        for i, comp in enumerate((component.owner,
         component.baseName,
         component.time,
         component.stake)):
            if self._columns_data[i]['colourFormatting']:
                comp.text = colour_hex + comp.text
            else:
                comp.colour = colour_rgba

        component.withdraw_pip.visible = base_data['withdraw']

    def apply_single_element(self, i, elem):
        soList_optimized.apply_single_element(self, i, elem)
        self._readraw_element(i, elem)

    def get_base_data_by_index(self, index):
        return self.attachments[self.indexes[index]]

    def _redraw_visible(self):
        start = self.offset
        end = self.offset + self.visibleCount
        for i, elem in enumerate(xrange(start, end)):
            try:
                self._readraw_element(i, elem)
            except:
                print self.offset, self.visibleCount, len(self.elemComps)
                raise

    def on_element_inited(self, elem_comp):
        component = elem_comp.component
        component.label.visible = False

        def create_text(column, name):
            comp = GUI.Text('')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
            comp.font = 'RobotoCondensedRegular_16.font'
            comp.position = (self._col_center(column), 0, 0.3)
            comp.colourFormatting = self._columns_data[column]['colourFormatting']
            component.addChild(comp, name)

        create_text(0, 'owner')
        create_text(1, 'baseName')
        create_text(2, 'time')
        create_text(3, 'stake')
        comp = GUI.Simple('soGUI/GUIs/unscalable/event_circle.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (0, 0, 0.1)
        comp.materialFX = 'BLEND'
        comp.visible = False
        component.addChild(comp, 'withdraw_pip')

    def tick(self):
        self._redraw_visible()

    def _col_center(self, index):
        result = 0
        for i, cd in enumerate(self._columns_data):
            if i < index:
                result += cd['width']
            elif i == index:
                result += cd['width'] * 0.5
                break

        return result

    def clear(self):
        soList_optimized.clear(self)

    def add_element(self, base_data):
        self.addElement(base_data['name'], attachment=base_data, delayedRender=True)

    def select_element(self, base_data):
        self.toggleByCaption(base_data['name'])

    def has_elements(self):
        return len(self.elements) > 0

    def update_element(self, base_data):
        self.attachments[base_data['name']] = base_data
        start = self.offset
        end = self.offset + self.visibleCount
        for i, elem in enumerate(xrange(start, end)):
            elem_base_data = self.get_base_data_by_index(elem)
            if elem_base_data['name'] == base_data['name']:
                try:
                    self.apply_single_element(i, elem)
                except:
                    print self.offset, self.visible, len(self.elemComps)
                    raise

    def apply(self):
        self.applyElements()
        self.onBound()