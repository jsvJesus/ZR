def compile_screen_component(select_callback):
    table_internal_space = 5
    table_scroll_width = 21
    columns_widths = sum((cd['width'] for cd in columns_data))
    component = GUI.Window()
    component.visible = False
    component.widthMode, component.heightMode = ('PIXEL', 'PIXEL')
    component.width = columns_widths + TABLE_SPACE_LEFT + TABLE_SPACE_RIGHT + table_scroll_width
    component.height = HEIGHT + TABLE_SPACE_BOTTOM
    component.position = (0, 0, 0.5)
    comp = GUI.Frame2('soGUI/frame/basic_frame_1.dds')
    comp.position = (0, 0, 0.9)
    comp.materialFX = 'BLEND'
    comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
    comp.width, comp.height = (2, 2)
    component.addChild(comp, 'frame')
    comp = GUI.Window()
    table_pos_y = ROW_HEIGHT * 2
    table_height = HEIGHT - table_pos_y
    TableGrid(columns_data, comp, columns_widths + table_scroll_width, table_height, ROW_HEIGHT, select_callback)
    comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
    comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
    comp.position = (TABLE_SPACE_LEFT, table_pos_y, 0.8)
    comp.mouseButtonFocus = 0
    comp.materialFX = 'BLEND'
    component.addChild(comp, 'bases_list')
    comp = GUI.Text(lc('GUI.DonateBase.title'))
    comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
    comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
    comp.font = 'RobotoCondensedRegular_18.font'
    comp.colour = cc.active_rgba
    comp.position = (0, 6, 0.3)
    component.addChild(comp, 'iLabel')
    rent_time = Constants.DonatBase.ownership_time / 60 / 60 / 24
    text = lc('GUI.DonateBase.rent_notification').format(rent_time)
    comp = GUI.Text(text, 'RobotoCondensedRegular_18.font')
    comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
    comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
    comp.colour = cc.inactive_rgba
    comp.position = (0, component.height - 19, 0.3)
    component.addChild(comp)
    title_y = ROW_HEIGHT
    pos_x = TABLE_SPACE_LEFT

    def line(pos1, pos2):
        comp = GUI.Simple('soGUI/white.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = abs(pos1[0] - pos2[0]) or 1, abs(pos1[1] - pos2[1]) or 1
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.colour = (85, 85, 85, 255)
        comp.materialFX = 'SOLID'
        comp.position = (min(pos1[0], pos2[0]), min(pos1[1], pos2[1]), 0.5)
        component.addChild(comp)

    line((pos_x + table_internal_space, ROW_HEIGHT * 2), (pos_x + table_internal_space + columns_widths - table_internal_space, ROW_HEIGHT * 2))
    texts = ['tenant',
     'name',
     'timeToSell',
     'stake']
    for i, column_data in enumerate(columns_data):
        title_width = column_data['width']
        comp = GUI.Text(lc('GUI.DonateBase.' + texts[i]))
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = title_width, ROW_HEIGHT
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.colour = cc.active_rgba
        comp.position = (pos_x + title_width * 0.5, title_y + ROW_HEIGHT * 0.5, 0.6)
        component.addChild(comp, 'title_' + str(i))
        pos_x += title_width

    comp = GUI.Simple('textures/default/black.dds')
    comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
    comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
    comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
    comp.colour = (255, 255, 255, 150)
    comp.materialFX = 'BLEND'
    comp.width, comp.height = (2, 2)
    comp.position = (0, 0, 0.01)
    comp.dragFocus = True
    comp.dropFocus = True
    comp.crossFocus = True
    comp.moveFocus = True
    comp.mouseButtonFocus = True
    comp.visible = False
    component.addChild(comp, 'darkScreen')
    comp = GUI.Simple('soGUI/maps/loadingScreen/loadingCircle/loadingCircle.texanim')
    comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
    comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
    comp.widthMode = comp.heightMode = 'PIXEL'
    comp.colour = (150, 150, 150, 220)
    comp.materialFX = 'BLEND'
    comp.height = 20
    comp.width = 20
    comp.position = (0, 0, 0.01)
    component.darkScreen.addChild(comp, 'darkScreenLogo')
    closeBox = soButton(GUI.Window())
    comp = closeBox.component
    comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
    comp.widthMode = comp.heightMode = 'PIXEL'
    comp.horizontalAnchor = 'RIGHT'
    comp.verticalAnchor = 'TOP'
    comp.colour = (255, 255, 255, 255)
    comp.materialFX = 'BLEND'
    comp.width = 18
    comp.height = 18
    comp.position = (component.width - comp.width + 8, 6, 0.3)
    closeBox.initVSC('soGUI/elements/closeBox.xml')
    closeBox.onBound()
    closeBox.setVisualState('normal')
    component.addChild(comp, 'closeBox')
    return component