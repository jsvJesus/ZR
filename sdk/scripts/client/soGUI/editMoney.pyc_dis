# Embedded file name: ./client/soGUI/editMoney.py
import BigWorld
import BWPersonality
from Helpers.PyGUI.PyGUIBase import PyGUIBase
import GUI
from utils import groupNumber
from Localization import lc
from soGUI.soEditField import soEditBox
from soGUI.soEditField import soEditBox2
from textMoney import getColorMoney

class soEditBoxMoney(soEditBox):
    SEP = '`'

    def __init__(self, *w, **kw):
        self.money_value = 0
        soEditBox.__init__(self, *w, **kw)

    def onUpdateText(self, rawText):
        pass

    def onMoneyValueChange(self, value):
        pass

    def getValue(self):
        num = self.rawText.replace(self.SEP, '').strip()
        num = int(num) if num.isdigit() else 0
        return num

    def setValue(self, value):
        if isinstance(value, (float, int)):
            value = int(value)
        if isinstance(value, (str, unicode)):
            value = value.split('.', 1)[0]
            if not value.isdigit():
                value = 0
        else:
            value = 0
        value = int(value)
        self.money_value = value
        soEditBox.setValue(self, unicode(value))

    def backSpace(self, shift = False):
        if self.selectionAnchor:
            self.deleteSelection()
            self._renderText()
            return True
        else:
            charPos = self._getRawPosition(*self.cursor)
            is_end_pos = len(self.rawText) == self.cursor[1]
            if charPos is None or charPos == 0:
                return False
            if charPos < len(self.rawText):
                if not shift:
                    if self.rawText[charPos - 1] == self.SEP:
                        charPos -= 1
                    self.rawText = self.rawText[:charPos - 1] + self.rawText[charPos:]
                else:
                    self.rawText = self.rawText[charPos:]
            elif not shift:
                self.rawText = self.rawText[:-1]
            else:
                self.clear()
            if not shift:
                self.formattedText[self.cursor[0]] = self.formattedText[self.cursor[0]][:self.cursor[1] - 1] + self.formattedText[self.cursor[0]][self.cursor[1]:]
            else:
                self.formattedText[self.cursor[0]] = self.formattedText[self.cursor[0]][self.cursor[1]:]
            self._renderText()
            if is_end_pos:
                self.cursor[1] += 1
            self.onValueChange(True)
            return True

    def deleteChar(self, shift):
        charPos = self._getRawPosition(*self.cursor)
        if charPos is None:
            return False
        else:
            if charPos < len(self.rawText):
                if not shift:
                    if self.rawText[charPos] == self.SEP:
                        charPos += 1
                    self.rawText = self.rawText[:charPos] + self.rawText[charPos + 1:]
                    self.formattedText[self.cursor[0]] = self.formattedText[self.cursor[0]][:self.cursor[1]] + self.formattedText[self.cursor[0]][self.cursor[1] + 1:]
                else:
                    self.rawText = self.rawText[:charPos]
                    self.formattedText[self.cursor[0]] = self.formattedText[self.cursor[0]][:self.cursor[1]]
            self._renderText()
            self.onValueChange(True)
            return True

    def addChar(self, char):
        if self.rawText == '0':
            self.rawText = ''
        charPos = self._getRawPosition(*self.cursor)
        if self.selectionAnchor:
            self.deleteSelection()
        if not self.checkValidity(char, charPos):
            self._inputError()
            return False
        elif charPos is None:
            return False
        else:
            resultStr = u''
            for letter in char:
                if letter not in self.BANNED_CHARACTERS:
                    resultStr += letter

            if charPos < len(self.rawText):
                self.rawText = self.rawText[:charPos] + resultStr + self.rawText[charPos:]
            else:
                self.rawText += resultStr
            self.formattedText[self.cursor[0]] = self.formattedText[self.cursor[0]][:self.cursor[1]] + resultStr + self.formattedText[self.cursor[0]][self.cursor[1]:]
            self._renderText()
            self.onValueChange(True)
            return True

    def _renderText(self):
        self.component.textPlane.textRender.text = u''
        _clear_cursor = len(self.rawText[0:self.cursor[1]].replace(self.SEP, ''))
        num = self.rawText.replace(self.SEP, '').strip()
        num = int(num) if num.isdigit() else 0
        color = getColorMoney(num)
        money = groupNumber(num, self.SEP)
        self.rawText = money
        self.formattedText = [money]
        realcursor = 0
        for char in self.rawText:
            if _clear_cursor <= 0:
                break
            if char.isdigit():
                _clear_cursor -= 1
            realcursor += 1

        self.cursor[1] = realcursor
        self.component.textPlane.textRender.text = self.rawText
        self.component.textPlane.textRender.colour = color
        self.onUpdateText(self.rawText)
        self.component.colour = color
        self._updateCursor()
        money = self.getValue()
        if money != self.money_value:
            self.money_value = money
            self.onMoneyValueChange(money)


class soEditBoxGold(soEditBoxMoney):

    def __init__(self, *w, **kw):
        soEditBoxMoney.__init__(self, *w, **kw)