class RotatingRectangle(PyGUIBase):
    """\xd0\x9f\xd1\x80\xd1\x8f\xd0\xbc\xd0\xbe\xd1\x83\xd0\xb3\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xb8\xd0\xba \xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xb8\xd0\xb9 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""

    def __init__(self, component, parent_component = None):
        PyGUIBase.__init__(self, parent_component)
        self.parent_script = parent_component.script
        self.mouse_hook_registred = False

    @classmethod
    def create(cls, parent_component):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xb8 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        component = GUI.Simple('textures/default/white.dds')
        component.horizontalPositionMode = component.verticalPositionMode = 'CLIP'
        component.horizontalAnchor = 'CENTER'
        component.verticalAnchor = 'CENTER'
        component.widthMode = component.heightMode = 'CLIP'
        component.colour = (255, 255, 255, 0)
        component.materialFX = 'BLEND'
        component.position = (0, 0.05, 0.0)
        component.visible = 1
        component.width, component.height = (0.75, 1.6)
        component.script = cls(component, parent_component)
        component.mouseButtonFocus = True
        component.moveFocus = True
        component.focus = True
        return component

    def mouse_hook(self, event):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd1\x87\xd0\xb8\xd0\xba \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd0\xb9 \xd0\xbc\xd1\x8b\xd1\x88\xd0\xba\xd0\xb8."""
        if BigWorld.isKeyDown(Keys.KEY_LEFTMOUSE):
            dx = event.dx * 0.01
            self.parent_script.yaw_rotate_dummy(dx)
            return True
        else:
            BWPersonality.GUICore.registerMouseHook(None)
            self.mouse_hook_registred = False
            return False
            return

    def handleMouseEvent(self, component, event):
        if BigWorld.isKeyDown(Keys.KEY_LEFTMOUSE) and not self.mouse_hook_registred:
            BWPersonality.GUICore.registerMouseHook(self.mouse_hook)
            self.mouse_hook_registred = True
            return True
        return False


def is_not_setted_max_light(function):
    """\xd0\x91\xd0\xbb\xd0\xbe\xd0\xba\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbe \xd0\xbc\xd0\xb0\xd0\xba\xd1\x81\xd0\xb8\xd0\xbc\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5.
    
    \xd0\x98\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd1\x81 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xbc LightManager.
    """

    def wrapper(self, *args, **kw):
        if self.always_max_light:
            return None
        else:
            result = function(self, *args, **kw)
            return result

    return wrapper


class LightManager(object):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x83\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd1\x91\xd0\xbd\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c\xd1\x8e \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0."""
    EMPTY_STATE = 0
    TURN_ON_STATE = 1
    TURN_OFF_STATE = 2

    def __init__(self, light_source_callback, current_light):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80
        
        light_source_callback - \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8f \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f 
        \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd1\x81 \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xbe\xd0\xbc,
        current_light - \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb8\xd0\xb9 \xd1\x83\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd0\xbd\xd1\x8c \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8.
        """
        self.light_source_callback = light_source_callback
        self.current_light = current_light
        self.max_light = 0.75
        self.min_light = current_light
        self.light_step = 0.075
        self._next_action = self._empty_action
        self._next_action_is_empty = True
        self._delay = 0.1
        self.always_max_light = False
        self._current_state = self.EMPTY_STATE

    def _empty_action(self):
        """\xd0\x9f\xd1\x83\xd1\x81\xd1\x82\xd0\xbe\xd0\xb5 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb5."""
        return None

    @is_not_setted_max_light
    def turn_on(self):
        """\xd0\x92\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xb0"""
        if self._current_state == self.TURN_ON_STATE:
            if not self._next_action_is_empty:
                self.next_action = self._empty_action
                self._next_action_is_empty = True
            return
        if self._current_state == self.TURN_OFF_STATE:
            self.next_action = self.turn_on
            self._next_action_is_empty = False
            return
        self._current_state = self.TURN_ON_STATE
        if not self._next_action_is_empty:
            self.next_action = self._empty_action

        def condition(current, end):
            """\xd0\xa3\xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xb5 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xba\xd1\x80\xd0\xb0\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2\xd0\xbe\xd0\xb7\xd1\x80\xd0\xb0\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f."""
            if current >= end:
                return False
            return True

        def end_actions():
            """\xd0\x92\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8\xd0\xb3\xd0\xbb\xd0\xbe \xd0\xbc\xd0\xb0\xd0\xba\xd1\x81\xd0\xb8\xd0\xbc\xd1\x83\xd0\xbc\xd0\xb0."""
            self._current_state = self.EMPTY_STATE
            self.next_action()

        self._change_light(self.max_light, self.light_step, condition, end_actions)

    @is_not_setted_max_light
    def turn_off(self):
        """\xd0\x92\xd1\x8b\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xb0"""
        if self._current_state == self.TURN_OFF_STATE:
            if not self._next_action_is_empty:
                self.next_action = self._empty_action
                self._next_action_is_empty = True
            return
        if self._current_state == self.TURN_ON_STATE:
            self.next_action = self.turn_off
            self._next_action_is_empty = False
            return
        self._current_state = self.TURN_OFF_STATE
        if not self._next_action_is_empty:
            self.next_action = self._empty_action

        def condition(current, end):
            """\xd0\xa3\xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xb5 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xba\xd1\x80\xd0\xb0\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x83\xd0\xb1\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f."""
            if current <= end:
                return False
            return True

        def end_actions():
            """\xd0\x92\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8\xd0\xb3\xd0\xbb\xd0\xbe \xd0\xbc\xd0\xb8\xd0\xbd\xd0\xb8\xd0\xbc\xd1\x83\xd0\xbc\xd0\xb0."""
            self._current_state = self.EMPTY_STATE
            self.next_action()

        self._change_light(self.min_light, -self.light_step, condition, end_actions)

    @property
    def next_action(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb5 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb5."""
        return self._next_action

    @next_action.setter
    @is_not_setted_max_light
    def next_action(self, value):
        """\xd0\x97\xd0\xb0\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb5 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb5."""
        self._next_action = value

    def set_max_light(self, max_light_flag = True):
        """\xd0\x92\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c / \xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbc\xd0\xb0\xd0\xba\xd1\x81\xd0\xb8\xd0\xbc\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5."""
        if max_light_flag:

            def on_max_light():
                self.always_max_light = True
                self.current_light = self.max_light
                self.light_source_callback(self.current_light)

            if self._current_state != self.EMPTY_STATE:
                self.next_action = on_max_light
                self.always_max_light = True
            else:
                on_max_light()
        else:
            self.always_max_light = False
            self.next_action = self._empty_action
            self.turn_off()

    def _change_light(self, end_light, light_step, condition, end_actions):
        """\xd0\x9f\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xbd\xd0\xbe \xd1\x81\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb8 \xd0\xb7\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbc \xd0\xb2\xd1\x8b\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd0\xb2\xd1\x82\xd0\xb8\xd0\xb5."""
        self.current_light += light_step
        if condition(self.current_light, end_light):
            self.light_source_callback(self.current_light)
            BigWorld.callback(self._delay, lambda : self._change_light(end_light, light_step, condition, end_actions))
        else:
            end_actions()


class DummyWindow(Singlton, PyGUIBase, flash_utils.FlashInteractor):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd1\x81 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd1\x83\xd1\x80\xd0\xbe\xd0\xb9 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0."""

    def initialization(self, component, receiver):
        PyGUIBase.__init__(self, component)
        flash_utils.FlashInteractor.__init__(self, receiver)
        component.script = self
        self.avatar_dummy = AvatarDummy()
        self.visible = False
        self.max_Xposition = 1.0
        self.min_Xposition = 0
        self.max_Yposition = 1.0
        self.min_Yposition = 0
        self.currnt_light = 0.2
        self.light_manager = LightManager(self.light_source_callback, self.currnt_light)
        self.matrixyaw = Math.Matrix()
        self.matrixpos = Math.Matrix()
        self.matrixpitch = Math.Matrix()
        self.viewMatrix = Math.Matrix()
        self.matrixpos.setTranslate((0, 0, 0.98))
        self.setupRoot()
        self.setupContent()
        self.onBound()

    def setupRoot(self):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbe\xd1\x81\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 0.5
        cmp.height = 1
        cmp.position = (self.persent_to_position(0.75), 0, 0.2)

    def setupContent(self):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81\xd0\xbe\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xbe\xd0\xb5 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0."""
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.2)
        cmp.visible = 1
        cmp.width, cmp.height = (2, 2)
        self.component.addChild(cmp, 'tmpFON')
        cmp = GUI.Simple('textures/default/blue_dark.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.2)
        cmp.visible = 1
        cmp.height = 2
        cmp.width = 4
        cmp.filterType = 'LINEAR'
        self.component.addChild(cmp, 'renderDummy')
        component = RotatingRectangle.create(self.component)
        self.component.addChild(component, 'rotatingRectangle')
        self._create_model_renderer()

    def turn_on_light(self):
        self.light_manager.turn_on()

    def turn_off_light(self):
        self.light_manager.turn_off()

    def light_source_callback(self, current_light):
        self._model_renderer.addAmbientColor(tuple([current_light] * 4))

    def _create_model_renderer(self):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd1\x80\xd0\xb5\xd0\xbd\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb5\xd1\x80 \xd0\xbf\xd0\xbe\xd0\xb4 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xba\xd0\xb8 \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xb0."""
        sW, sH = BigWorld.screenSize()
        self._model_renderer = BigWorld.PyModelRenderer(sW, sH)
        for _ in xrange(10):
            self._model_renderer.delDirectionLight(0)
            self._model_renderer.delOmniLight(0)

    def position_to_persent(self, position):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 [-2; 2] \xd0\xb2 \xd0\xbe\xd1\x82\xd0\xbd\xd0\xbe\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xba \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd0\xb0\xd0\xbc \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0."""
        return 0.5 * (1 + position)

    def persent_to_position(self, persent):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82 \xd0\xbe\xd1\x82\xd0\xbd\xd0\xbe\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xba \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd0\xb0\xd0\xbc \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0 \xd0\xb2  \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 [-2; 2]."""
        return (persent - 0.5) * 2

    def persent_to_size(self, persent):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80 \xd0\xbe\xd1\x82\xd0\xbd\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe \xd0\xb2\xd1\x8b\xd1\x81\xd0\xbe\xd1\x82\xd1\x8b \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0 \xd0\xba \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd1\x83 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0."""
        return persent * 2

    def yaw_rotate_dummy(self, dx):
        """\xd0\x9f\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd \xd0\xbf\xd0\xbe \xd1\x81\xd0\xb2\xd0\xbe\xd0\xb5\xd0\xb9 \xd0\xbe\xd1\x81\xd0\xb8."""
        self._model.yaw -= dx

    def set_avatar_Xposition(self, new_position, time_ = 1):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x81 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xbe\xd0\xbc \xd0\xbf\xd0\xbe \xd0\xbe\xd1\x81\xd0\xb8 X.
        
        new_position - \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8f \xd0\xbe\xd1\x82\xd0\xbd\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd0\xb0 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0
        (\xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd1\x80 0,5 - \xd1\x8d\xd1\x82\xd0\xbe \xd1\x86\xd0\xb5\xd0\xbd\xd1\x82\xd1\x80 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xbd\xd0\xb0\xd1\x85\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f \xd0\xb2 
        \xd1\x81\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb8\xd0\xbd\xd0\xb5 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xbe \xd0\xbe\xd1\x81\xd0\xb8 \xd0\xa5),
        time_ - \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb7\xd0\xb0 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb5 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xb8\xd0\xb7
        \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2 \xd0\xb4\xd1\x80\xd1\x83\xd0\xb3\xd1\x83\xd1\x8e (\xd0\xb2 \xd1\x81\xd0\xb5\xd0\xba\xd1\x83\xd0\xbd\xd0\xb4\xd0\xb0\xd1\x85).
        """
        current_Xposition = self.position_to_persent(self.component.position.x)
        if new_position > self.max_Xposition:
            new_position = self.max_Xposition
        elif new_position < self.min_Xposition:
            new_position = self.min_Xposition
        if current_Xposition == new_position:
            return
        if current_Xposition > new_position:
            forward = -1

            def stop_condition(new_Xpos, end_position):
                return new_Xpos > end_position

        else:
            forward = 1

            def stop_condition(new_Xpos, end_position):
                return new_Xpos < end_position

        time_of_step = 0.005

        def action(new_position, old_position, percent_per_step):
            new_Xpos = old_position + 4 * percent_per_step * forward
            y = self.component.position.y
            z = self.component.position.z
            self.component.position = (self.persent_to_position(new_Xpos), y, z)
            if stop_condition(new_Xpos, new_position):
                BigWorld.callback(time_of_step * (100 / 60), lambda : action(new_position, new_Xpos, percent_per_step))

        if time_ > 0:
            number_of_steps = time_ / time_of_step
            percent_per_step = abs(current_Xposition - new_position) / number_of_steps
            BigWorld.callback(time_of_step, lambda : action(new_position, current_Xposition, percent_per_step))
        else:
            self.component.position = (self.persent_to_position(new_position), self.component.position.y, self.component.position.z)

    def set_avatar_Yposition(self, new_position, time_ = 1):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x81 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xbe\xd0\xbc \xd0\xbf\xd0\xbe \xd0\xbe\xd1\x81\xd0\xb8 X.
        
        new_position - \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8f \xd0\xbe\xd1\x82\xd0\xbd\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd0\xb0 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0
        (\xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd1\x80 0,5 - \xd1\x8d\xd1\x82\xd0\xbe \xd1\x86\xd0\xb5\xd0\xbd\xd1\x82\xd1\x80 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xbd\xd0\xb0\xd1\x85\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f \xd0\xb2 
        \xd1\x81\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb8\xd0\xbd\xd0\xb5 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xbe \xd0\xbe\xd1\x81\xd0\xb8 \xd0\xa5),
        time_ - \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb7\xd0\xb0 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb5 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xb8\xd0\xb7
        \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2 \xd0\xb4\xd1\x80\xd1\x83\xd0\xb3\xd1\x83\xd1\x8e (\xd0\xb2 \xd1\x81\xd0\xb5\xd0\xba\xd1\x83\xd0\xbd\xd0\xb4\xd0\xb0\xd1\x85)
        (\xd1\x83 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8 \xd0\xb4\xd0\xb2\xd0\xb8\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xb1\xd0\xbe\xd0\xbb\xd1\x8c\xd1\x88\xd0\xb8\xd1\x85 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f\xd1\x85 \xd0\xb1\xd0\xbe\xd0\xbb\xd1\x8c\xd1\x88\xd0\xb0\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xb3\xd1\x80\xd0\xb5\xd1\x88\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c).
        """
        current_Yposition = self.position_to_persent(self.component.position.y)
        if new_position > self.max_Yposition:
            new_position = self.max_Yposition
        elif new_position < self.min_Yposition:
            new_position = self.min_Yposition
        if current_Yposition == new_position:
            return
        if current_Yposition > new_position:
            forward = -1

            def stop_condition(new_Ypos, end_position):
                return new_Ypos > end_position

        else:
            forward = 1

            def stop_condition(new_Ypos, end_position):
                return new_Ypos < end_position

        time_of_step = 0.005

        def action(new_position, old_position, percent_per_step):
            new_Ypos = old_position + 4 * percent_per_step * forward
            y = self.component.position.y
            z = self.component.position.z
            self.component.position = (self.persent_to_position(new_Ypos), y, z)
            if stop_condition(new_Ypos, new_position):
                BigWorld.callback(time_of_step * (100 / 60), lambda : action(new_position, new_Ypos, percent_per_step))

        if time_ > 0:
            number_of_steps = time_ / time_of_step
            percent_per_step = abs(current_Yposition - new_position) / number_of_steps
            BigWorld.callback(time_of_step, lambda : action(new_position, current_Yposition, percent_per_step))
        else:
            self.component.position = (self.component.position.x, self.persent_to_position(new_position), self.component.position.z)

    def resize_component(self, percent):
        """\xd0\x98\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd1\x81 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8e \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0.
        
        percent - \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80 \xd0\xbe\xd1\x82\xd0\xbd\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd1\x8c\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe \xd0\xb2\xd1\x8b\xd1\x81\xd0\xbe\xd1\x82\xd1\x8b \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0,
        \xd1\x82.\xd0\xb5. percent = 1 - \xd1\x8d\xd1\x82\xd0\xbe \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xb2\xd1\x8b\xd1\x81\xd0\xbe\xd1\x82\xd0\xb0 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 == \xd0\xb2\xd1\x8b\xd1\x81\xd0\xbe\xd1\x82\xd0\xb5 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0.
        """
        height = self.persent_to_size(percent)
        comp = self.component
        comp.height = height
        comp.width = height / 2

    def show(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        if not self.visible:
            return
        else:
            if self.component.parent is None:
                import BWPersonality
                BWPersonality.GUICore.generalLayer.addChild(self.component, self.__class__.__name__)
            self.component.visible = True
            self.component.crossFocus = True
            self.component.focus = True
            self.component_size_and_position()
            return

    def hide(self):
        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        if self.visible:
            return
        self.component.visible = False
        self.component.crossFocus = False
        self.component.focus = False

    def set_character(self, char):
        """\xd0\xa1\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0."""
        self.avatar_dummy = self._get_avatar_dummy(char)
        self.avatar_dummy.setModel(clear=True)
        self.avatar_dummy.set_character(char)
        self._model = self.avatar_dummy.model
        self._update_model()
        self.light_manager.set_max_light(False)

    def doReposition(self):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd1\x80\xd0\xb5\xd0\xbd\xd0\xb4\xd0\xb5\xd1\x80 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8 \xd1\x80\xd0\xb0\xd0\xb7\xd1\x80\xd0\xb5\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0."""
        self._create_model_renderer()
        self._update_model()
        self.component_size_and_position()

    def _update_model(self):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c."""
        self._model_renderer.models = [self._model]
        self._model.zoomExtents(True)
        self._model_renderer.dynamic = True
        self.component.renderDummy.texture = self._model_renderer.texture
        self._model.IdleUnarmed()
        if self.avatar_dummy.primary_gun_model:
            self._model.idle_static_automat()
        self._init_position_and_size()

    def _get_avatar_dummy(self, character):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb9 \xd1\x8d\xd0\xba\xd0\xb7\xd0\xb5\xd0\xbc\xd0\xbf\xd0\xbb\xd1\x8f\xd1\x80 \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xb0."""
        avatar_dummy = AvatarDummy()
        avatar_dummy.setModel(clear=True)
        avatar_dummy.set_character(character)
        return avatar_dummy

    def _init_position_and_size(self):
        """\xd0\x9d\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xb0\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd0\xbe\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x83\xd1\x8e \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0."""
        init_matrix = Math.Matrix()
        init_matrix.setTranslate((0, 0, 1.2))
        self._model_renderer.viewMatrix = init_matrix
        self._model.yaw = 3.0
        pitch = -0.28
        self.matrixpitch.setRotateX(pitch)
        self.viewMatrix = Math.Matrix(self._model_renderer.viewMatrix)
        self.viewMatrix.preMultiply(self.matrixpitch)
        self._model_renderer.viewMatrix = self.viewMatrix
        x, _y, z = self._model.position
        self._model.position = (x, -0.43, z)
        self.matrixpos.setTranslate((0, 0, 1.02))
        self.updateView()
        self.resize_component(0.75)

    def show_debug_fon(self, doShow = True):
        """\xd0\x92\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd1\x84\xd0\xbe\xd0\xbd \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xb2 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbc \xd1\x81\xd1\x82\xd0\xbe\xd0\xb8\xd1\x82 \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd."""
        self.component.tmpFON.visible = doShow

    @flash_utils.send_to_flashscript
    def component_size_and_position(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xb2\xd0\xb5\xd1\x80\xd1\x85\xd0\xbd\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xb0\xd0\xb3\xd0\xbe \xd1\x83\xd0\xb3\xd0\xbb\xd0\xb0 \xd0\xb2 \xd0\xbf\xd0\xb8\xd0\xba\xd1\x81\xd0\xb5\xd0\xbb\xd1\x8f\xd1\x85."""
        position = self.component.position
        corner_x = self.position_to_persent(position.x - self.component.width / 2.0)
        corner_y = self.position_to_persent(position.y - self.component.height / 2.0)
        sW, sH = BigWorld.screenSize()
        data = {'corner': (corner_x * sW, corner_y * sH),
         'height': self.component.height / 2 * sH,
         'width': self.component.width / 2 * sW}
        return data

    def update_from_GUI(self, choiceGroup, var):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbd\xd0\xb5\xd1\x88\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xb2\xd0\xb8\xd0\xb4 \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xb2\xd1\x8b\xd0\xb1\xd0\xbe\xd1\x80\xd0\xb5 \xd0\xb2\xd0\xbd\xd0\xb5\xd1\x88\xd0\xbd\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0."""
        self.avatar_dummy.update_from_GUI(choiceGroup, var)
        self._model = self.avatar_dummy.model
        self._update_model()

    def handleMouseEnterEvent(self, comp):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x8e, \xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xb2\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82\xd0\xba\xd1\x83."""
        self.turn_on_light()
        return True

    def handleMouseLeaveEvent(self, comp):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x8e, \xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82\xd0\xba\xd1\x83."""
        self.turn_off_light()
        return True

    def updateView(self):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80, \xd1\x81\xd0\xbc\xd0\xbe\xd1\x82\xd1\x80\xd1\x8f\xd1\x89\xd0\xb8\xd1\x85 \xd0\xbd\xd0\xb0 \xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xba\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xb8 \xd0\xbe\xd1\x81\xd0\xb2\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5."""
        self.viewMatrix = Math.Matrix()
        self.viewMatrix.preMultiply(self.matrixpitch)
        self.viewMatrix.preMultiply(self.matrixyaw)
        self.viewMatrix.postMultiply(self.matrixpos)
        self._model_renderer.viewMatrix = self.viewMatrix
        for _ in xrange(10):
            self._model_renderer.delOmniLight(0)

        inv = Math.Matrix(self.viewMatrix)
        inv.invert()
        self._model_renderer.addOmniLight((82, 82, 82, 10), inv.applyPoint((55, 55, -61)), 0, 100)
        self._model_renderer.nearPlane = 0.1