# Embedded file name: ./client/soGUI/sales/filters/baseblock.py
from Helpers.PyGUI.PyGUIBase import PyGUIBase
import colorCodes as cc
from soGUI.soButton import soButton
from Localization import lc
import GUI
from ui_elements import BilboardEditText, BilboardEditTextNumber, BilboardDropdown, BillboardDropdownWindow
import GiftBankUtils
from NPCs import NPCs

class Baseblock(PyGUIBase):

    def __init__(self, comp, data_changed_callback = None, reset_click_callback = None):
        PyGUIBase.__init__(self, comp)
        comp.script = self
        comp.materialFX = 'SOLID'
        self._ignore_changes = False
        self._callback = data_changed_callback
        height = 4
        height_step = 36
        field_width = 216
        field_height = 30
        margin_left = 26
        margin_right = 4
        caption_offset = 4
        self._edits = []

        def create_button(height, text):
            comp = GUI.Window()
            btn = soButton(comp)
            btn.initVSC('soGUI/elements/button_1.xml')
            btn.onBound()
            btn.setVisualState('normal')
            comp.label.text = text
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.position = (1, height, 0.3)
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = field_width - margin_left - margin_right, field_height
            self.component.addChild(comp)
            comp.horizontalPositionMode = 'PIXEL'
            comp.position[0] -= field_width - margin_left
            return btn

        def create_caption(height, text):
            comp = GUI.Text(text)
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.font = 'RobotoCondensedRegular_16.font'
            comp.colour = cc.inactive_rgba
            comp.position = (4, height + caption_offset, 0.3)
            self.component.addChild(comp)
            return comp

        def create_edittext(height):
            textedit = BilboardEditText(field_width, field_height, self._data_changed)
            comp = textedit.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
            comp.position = (1, height, 0.3)
            self.component.addChild(comp)
            comp.horizontalPositionMode = 'PIXEL'
            comp.position[0] -= margin_right
            self._edits.append(textedit)
            return textedit

        def create_items_dropdown(height):
            ddl = BilboardDropdown(field_width, field_height, 70, callback=self._data_changed)
            comp = ddl.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
            comp.position = (1, height, 0.3)
            elems = [[0, lc('soTradeInterface.shop.NO_MATTER')], [1, lc('soTradeInterface.shop.YES')], [2, lc('soTradeInterface.shop.NO')]]
            ddl.addElements(elems)
            ddl.setSelectionByValue(0, True)
            self.component.addChild(comp)
            comp.horizontalPositionMode = 'PIXEL'
            comp.position[0] -= margin_right
            ddl.onBound()
            return ddl

        def create_keepers_dropdown(height):
            ddl = BillboardDropdownWindow(field_width, callback=self._data_changed)
            comp = ddl.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
            comp.position = (1, height, 0.3)
            elements = [ (GiftBankUtils.get_keeper_index(keeper), NPCs.getProfession(keeper)) for keeper in GiftBankUtils.get_keeper_names_list(False) ]
            ddl.set_data(elements)
            self.component.addChild(comp, 'keepers_filter')
            comp.horizontalPositionMode = 'PIXEL'
            comp.position[0] -= margin_right
            ddl.onBound()
            return ddl

        def create_double_field(height):
            small_field_width = 60
            comp = GUI.Text(lc('sales.FILTERS.BASEBLOCK.FROM'))
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.font = 'RobotoCondensedRegular_16.font'
            comp.colour = cc.inactive_rgba
            comp.position = (1, height + caption_offset, 0.3)
            self.component.addChild(comp)
            comp.horizontalPositionMode = 'PIXEL'
            x = comp.position[0]
            x -= field_width
            comp.position[0] = x
            x += margin_left
            textedit1 = BilboardEditTextNumber(small_field_width, field_height, callback=self._data_changed)
            comp = textedit1.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.position = (x, height, 0.3)
            self.component.addChild(comp)
            x += small_field_width + 39
            comp = GUI.Text(lc('sales.FILTERS.BASEBLOCK.TO'))
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
            comp.font = 'RobotoCondensedRegular_16.font'
            comp.colour = cc.inactive_rgba
            comp.position = (x - 8, height + caption_offset, 0.3)
            self.component.addChild(comp)
            comp.horizontalPositionMode = 'PIXEL'
            x += margin_left
            textedit2 = BilboardEditTextNumber(small_field_width, field_height, callback=self._data_changed)
            comp = textedit2.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.position = (x, height, 0.3)
            self.component.addChild(comp)
            self._edits.extend((textedit1, textedit2))
            return (textedit1, textedit2)

        comp = create_caption(height, lc('sales.FILTERS.BASEBLOCK.CAPTION'))
        comp.colour = cc.active_rgba
        height += height_step
        create_caption(height, lc('sales.FILTERS.BASEBLOCK.ITEMNAME'))
        self._item_name_edit = create_edittext(height)
        height += height_step
        create_caption(height, lc('sales.FILTERS.BASEBLOCK.STOCKMAN'))
        self._keepers_ddl = create_keepers_dropdown(height)
        height += height_step
        create_caption(height, lc('sales.FILTERS.BASEBLOCK.INTERNALITEMS'))
        self._items_ddl = create_items_dropdown(height)
        height += height_step
        create_caption(height, lc('sales.FILTERS.BASEBLOCK.STATETIME'))
        self._statetime_df = create_double_field(height)
        height += height_step
        create_caption(height, lc('sales.FILTERS.BASEBLOCK.REPAIRS'))
        self._repairs_df = create_double_field(height)
        height += height_step
        create_caption(height, lc('sales.FILTERS.BASEBLOCK.ITEMSCOUNT'))
        self._itemscount_df = create_double_field(height)
        height += height_step
        reset_btn = create_button(height, lc('sales.FILTERS.BASEBLOCK.RESET'))
        if reset_click_callback:
            reset_btn.onClick = reset_click_callback
        self.filter_data = self._compile_filter_data()

    def _data_changed(self, *args):
        if self._ignore_changes:
            return
        _filter_data = self._compile_filter_data()
        if _filter_data != self.filter_data:
            self.filter_data = _filter_data
            if self._callback:
                self._callback()

    def _compile_filter_data(self):

        def parse_number(edit_text):
            raw = edit_text.getRaw()
            if raw:
                return int(raw)
            return -1

        result = {'item_name': self._item_name_edit.getRaw(),
         'keepers': self._keepers_ddl.get_selection(),
         'internals': self._items_ddl.getSelection()[1],
         'statetime': map(parse_number, self._statetime_df),
         'reps': map(parse_number, self._repairs_df),
         'counts': map(parse_number, self._itemscount_df)}
        return result

    def reset(self):
        self._ignore_changes = True
        self._item_name_edit.clear()
        self._keepers_ddl.reset()
        self._items_ddl.setSelectionByValue(0)
        for f in self._statetime_df:
            f.clear()

        for f in self._repairs_df:
            f.clear()

        for f in self._itemscount_df:
            f.clear()

        self._ignore_changes = False
        self._data_changed()

    def on_hide(self):
        self._keepers_ddl.showList(False)
        self._items_ddl.showList(False)
        for edit in self._edits:
            edit.activate(False)