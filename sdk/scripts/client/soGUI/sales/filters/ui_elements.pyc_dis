class BillboardCheckBox(soCheckBox):

    class ArrowDir:
        Up, Down = range(2)

    def __init__(self, text, klass, color = cc.active_rgba, callback = None):
        params = CheckBoxPropsStructure(labelText=text, font='RobotoCondensedRegular_16.font', labelColour=color)
        soCheckBox.__init__(self, GUI.Window(), params)
        self.component.horizontalAnchor = 'LEFT'
        self.component.verticalAnchor = 'TOP'
        self.component.horizontalPositionMode = 'PIXEL'
        self.component.verticalPositionMode = 'PIXEL'
        self.component.widthMode = 'PIXEL'
        self.component.heightMode = 'PIXEL'
        self.box.onClick = self.click
        self.klass = klass
        self.callback = callback

    def create_drop_button(self, callback):
        self.component.isClip = False
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (self.calc_string_dimentions()[0] + 32, 0, 0.2)
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (18, 18)
        btn = soButton(comp)
        btn.setVisualState('normal')
        btn.onBound()
        btn.onClick = callback
        self.component.addChild(comp, 'button')

    def set_arrow_direction(self, arrow_dir):
        if arrow_dir == BillboardCheckBox.ArrowDir.Up:
            self.component.button.script.initVSC('soGUI/elements/quest_view_arrow_up.xml')
        elif arrow_dir == BillboardCheckBox.ArrowDir.Down:
            self.component.button.script.initVSC('soGUI/elements/quest_view_arrow_down.xml')

    def click(self):
        if self.callback:
            self.callback(self.klass, self.isChecked())