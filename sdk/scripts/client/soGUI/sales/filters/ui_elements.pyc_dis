class BilboardEditText(soEditBox):

    def __init__(self, width, height, callback = None, hOffset = 6, vOffset = 6):
        soEditBox.__init__(self, GUI.Window(), width=width, height=height, font='RobotoCondensedRegular_14.font', hOffset=hOffset, vOffset=vOffset, autosize=False)
        self.callback = callback
        self.setValidator(self.input_validator)

    def onValueChange(self, by_user):
        if self.callback:
            self.callback(self.getRaw())

    def input_validator(self, newStr, wholeText, offset):
        return len(newStr) + len(wholeText) <= 19


class BilboardEditTextNumber(soNumberBox):

    def __init__(self, width, height, callback = None):
        soNumberBox.__init__(self, GUI.Window(), width=width, height=height, font='RobotoCondensedRegular_14.font', hOffset=6, vOffset=6, autosize=False)
        self.callback = callback
        self.setValidator(self.input_validator)

    def onValueChange(self, by_user):
        if self.callback:
            self.callback(self.getRaw())

    def input_validator(self, newStr, wholeText, offset):
