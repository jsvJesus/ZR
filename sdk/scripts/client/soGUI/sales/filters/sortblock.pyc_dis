# Embedded file name: ./client/soGUI/sales/filters/sortblock.py
from Helpers.PyGUI.PyGUIBase import PyGUIBase
import GUI
from Localization import lc
from soGUI.soButton import soButton
from functools import partial
from Constants import BoardSort

class Sortblock(PyGUIBase):

    def __init__(self, component, columns_widths):
        PyGUIBase.__init__(self, component)
        self.component.script = self
        self.data_changed_callback = lambda : None

        def create_line(text, pos_x, mode):
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
            comp.position = (pos_x, 8, 0.5)
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = (150, 18)
            btn = soButton(comp)
            comp.label.text = text
            btn.initVSC('soGUI/elements/sale_inactive.xml')
            btn.onBound()
            btn.onClick = partial(self._line_click, mode)
            self.component.addChild(comp)
            text_btn = btn
            string_width = comp.label.stringDimensions(text)[0]
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = (18, 18)
            comp.position = (pos_x + string_width * 0.5 + 2, 0.1, 0.4)
            btn = soButton(comp)
            btn.setVisualState('normal')
            btn.onBound()
            btn.onClick = partial(self._line_click, mode)
            self.component.addChild(comp)
            arrow_btn = btn
            return (text_btn, arrow_btn)

        positions = [columns_widths[0] * 0.5]
        for i in range(1, len(columns_widths)):
            positions.append(columns_widths[i - 1] * 0.5 + columns_widths[i] * 0.5 + positions[-1])

        self._elements = {}
        text_btn, arrow_btn = create_line(lc('sales.FILTERS.SORTBLOCK.NAME'), positions[0], BoardSort.Name)
        self._elements[BoardSort.Name] = {'text': text_btn,
         'arrow': arrow_btn}
        text_btn, arrow_btn = create_line(lc('sales.FILTERS.SORTBLOCK.PRICE'), positions[1], BoardSort.Price)
        self._elements[BoardSort.Price] = {'text': text_btn,
         'arrow': arrow_btn}
        text_btn, arrow_btn = create_line(lc('sales.FILTERS.SORTBLOCK.TIME'), positions[2], BoardSort.Time)
        self._elements[BoardSort.Time] = {'text': text_btn,
         'arrow': arrow_btn}
        text_btn, arrow_btn = create_line(lc('sales.FILTERS.SORTBLOCK.CHARS'), positions[3], None)
        text_btn.setDisabledState(True)
        arrow_btn.component.visible = False
        text_btn.onClick = lambda : None
        self.mode = (None, None)
        self.set_mode(BoardSort.Name, BoardSort.Forward)
        return

    def _line_click(self, mode):
        if mode == self.mode[0]:
            self.set_mode(self.mode[0], (self.mode[1] + 1) % 2)
        else:
            self.set_mode(mode, BoardSort.Forward)

    def set_mode(self, mode_type, mode_direction):
        mode = (mode_type, mode_direction)
        if mode == self.mode:
            return
        self.mode = mode
        for element in self._elements.itervalues():
            element['text'].initVSC('soGUI/elements/sale_inactive.xml')
            element['text']._updateVisualState()
            element['arrow'].component.visible = False

        element = self._elements[mode_type]
        element['text'].initVSC('soGUI/elements/sale_active.xml')
        element['text']._updateVisualState()
        element['arrow'].component.visible = True
        if mode_direction == BoardSort.Forward:
            element['arrow'].initVSC('soGUI/elements/sale_arrow_down.xml')
        elif mode_direction == BoardSort.Backward:
            element['arrow'].initVSC('soGUI/elements/sale_arrow_up.xml')
        element['arrow'].onBound()
        self.data_changed_callback()