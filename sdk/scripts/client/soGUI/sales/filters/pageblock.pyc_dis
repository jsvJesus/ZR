        self.component.content.addChild(comp, 'btn_end')
        self.disable()
        self.click_callback = lambda start_index, direction: None

    def _on_start_click(self):
        self.notify_listeners(EventType.OnStartClick)
        self.click_callback(0, BoardSort.Forward)

    def _on_left_click(self):
        index = self._index_range[0] - 1
        self.notify_listeners(EventType.OnPrevClick)
        self.click_callback(index, BoardSort.Backward)

    def _on_right_click(self):
        index = self._index_range[1] + 1
        self.notify_listeners(EventType.OnNextClick)
        self.click_callback(index, BoardSort.Forward)

    def _on_end_click(self):
        index = self._total - 1
        self.notify_listeners(EventType.OnEndClick)
        self.click_callback(index, BoardSort.Backward)

    def disable(self):
        self.component.content.btn_start.script.enabled = False
        self.component.content.btn_left.script.enabled = False
        self.component.content.btn_right.script.enabled = False
        self.component.content.btn_end.script.enabled = False
        self._index_range = (None, None)
        self._total = None
        return

    def set_data(self, index_range, total):
        if index_range[0] == -1 or index_range[1] == -1:
            self.disable()
            return
        self._index_range = index_range
        self._total = total
        left_enabled = index_range[0] > 0
        self.component.content.btn_start.script.enabled = left_enabled
        self.component.content.btn_left.script.enabled = left_enabled
        right_enabled = index_range[1] < total - 1
        self.component.content.btn_right.script.enabled = right_enabled
        self.component.content.btn_end.script.enabled = right_enabled