            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = hor_anchor, 'CENTER'
            comp.width, comp.height = comp.texture.width, comp.texture.height
            comp.position = (start_pos, -space, 0.5)
            self.component.addChild(comp)
        comp = GUI.Text()
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = hor_anchor, 'CENTER'
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = 2, 2.0 / 3
        comp.position = (start_pos, space, 0.5)
        comp.colour = cc.highlighted_rgba
        self.component.addChild(comp, 'name')
        comp.horizontalPositionMode = 'PIXEL'
        comp.position[0] += margin
        comp = GUI.Text()
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = hor_anchor, 'CENTER'
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = 2, 2.0 / 3
        comp.position = (start_pos, 0, 0.5)
        comp.colour = cc.active_rgba
        self.component.addChild(comp, 'time')
        comp.horizontalPositionMode = 'PIXEL'
        comp.position[0] += margin
        comp = GUI.Text()
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = hor_anchor, 'CENTER'
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = 2, 2.0 / 3
        comp.position = (start_pos, -space, 0.5)
        comp.colour = cc.highlighted2_rgba
        self.component.addChild(comp, 'bank')
        comp.horizontalPositionMode = 'PIXEL'
        comp.position[0] += margin

    def update(self, item):
        self.component.name.text = item['sellerName'].decode('utf8')
        self.component.time.text = str(item['hoursLeft']) + lc('tmplocal.strings.str25')
        self.component.bank.text = _NPCs.getProfession(item['BankName']) or '???'