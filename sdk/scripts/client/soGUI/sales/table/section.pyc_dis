        return

    def apply_item_data(self, item):
        self._item = item
        try:
            self.update(self._item)
        except:
            traceback.print_exc()
            traceback.print_stack()

    def update(self, item):
        self.component.textureName = 'soGUI/frame/paint/blue.dds'

