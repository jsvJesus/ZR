    def complex_item(self):
        if self._item:
            return self._item['complexItem']
        else:
            return None

    @property
    def item_type(self):
        if self._item:
            return self._item['complexItem']['complexItemType']

    @property
    def item_class(self):
        if self._item:
            return ItemsCatalog.GetItemClass(self.item_type)


class PriceSection(Section):

    def __init__(self, component):
        Section.__init__(self, component)
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        comp.width, comp.height = (2, 2)
        self._label_total = TextMoney(comp, font='RobotoCondensedRegular_14.font')
        self._label_total.moneyIcon.visible = False
        self.component.addChild(comp)
        comp = self._label_total.moneyLabel
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.5)
        comp.width, comp.height = (2, 2)
