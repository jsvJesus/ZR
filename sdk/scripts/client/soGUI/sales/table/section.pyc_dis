        comp.font = 'RobotoCondensedRegular_14.font'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.position = (0, -0.5, 0.5)
        comp.width, comp.height = (2, 2)
        comp.colour = cc.inactive_rgba
        self.component.addChild(comp)
        self._label_one = comp

    def update(self, item):
        self._label_total.setValue(item['price'])
        if ItemsUtils.isStackedItemType(self.item_type):
            number = ItemsUtils.GetItemNumber(self.complex_item)
            self._label_one.text = u'{0} x {1} {2}'.format(number, int(round(float(item['price']) / number)), lc('tmplocal.strings.RUB'))
            self._label_one.visible = True
        else:
            self._label_one.visible = False