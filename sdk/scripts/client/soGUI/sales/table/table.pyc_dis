# Embedded file name: ./client/soGUI/sales/table/table.py
import GUI
from Helpers.PyGUI.PyGUIBase import PyGUIBase, Interceptor
from line import Line

class Table(PyGUIBase):

    def __init__(self, comp):
        PyGUIBase.__init__(self, comp)
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0)
        comp.colour = (0, 0, 0, 150)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'load')
        Interceptor(comp)
        comp = GUI.Simple('soGUI/frame/journal/load_anim/load_pips')
        comp.materialFX = 'BLEND'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (35, 10)
        comp.position = (0, 0, 0)
        self.component.load.addChild(comp)
        pos_y = 0
        line_height = 70
        self.rows = 0
        self._lines = []

        def calculate_columns_widths(width_total):
            chars_fixed_width = 380
            state_time_min_width = 220
            price_min_width = 106
            name_min_width = 236
            name_prefered_width = 326
            width = chars_fixed_width + state_time_min_width + price_min_width
            prefered_width = width + name_prefered_width
            min_width = width + name_min_width
            if width_total > prefered_width:
                remain = width_total - prefered_width
                per_column_remain = remain / 3.0
                return [name_prefered_width + per_column_remain,
                 price_min_width + per_column_remain,
                 state_time_min_width + per_column_remain,
                 chars_fixed_width]
            elif width_total > min_width:
                remain = width_total - min_width
                return [name_min_width + remain,
                 price_min_width,
                 state_time_min_width,
                 chars_fixed_width]
            else:
                return [name_min_width,
                 price_min_width,
                 state_time_min_width,
                 chars_fixed_width]

        self.columns_widths = calculate_columns_widths(self.component.width)
        while pos_y + line_height < self.component.height:
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
            comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
            comp.width, comp.height = 2, line_height
            comp.position = (0, pos_y, 0.5)
            self.component.addChild(comp)
            line = Line(comp, self.columns_widths)
            line.click_callback = self._on_line_click
            self._lines.append(line)
            pos_y += line_height
            self.rows += 1
            if self.rows >= 29:
                break

        self.click_callback = lambda click_type, item_data: None

    def disable(self):
        self.component.load.visible = True

    def _on_line_click(self, click_type, line):
        self.click_callback(click_type, line.item)

    def set_data(self, data):
        self.component.load.visible = False
        for i, line in enumerate(self._lines):
            if len(data) > i:
                line.set_item(data[i])
            else:
                line.set_item(None)

        return