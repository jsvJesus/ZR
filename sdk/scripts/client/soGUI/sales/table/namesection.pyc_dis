class Tooltiper(Interceptor):

    def __init__(self, component):
        Interceptor.__init__(self, component)
        self._item_data = None
        self.on_click = lambda : None
        return

    def set_item(self, complex_item):
        self._item_data = complex_item

    def handleMouseClickEvent(self, comp):
        self.on_click()
        return True

    def handleMouseLeaveEvent(self, comp):
        if self._item_data and not ItemsUtils.is_sub_item(self._item_data):
            BWPersonality.GUICore.toolTipEvent(self._item_data, BWPersonality.GUICore.GUI_ID_SHOP, soToolTipComponent.EVENT_HIDE)
        return Interceptor.handleMouseLeaveEvent(self, comp)

    def handleMouseEnterEvent(self, comp):
        if self._item_data and not ItemsUtils.is_sub_item(self._item_data):
            BWPersonality.GUICore.toolTipEvent(self._item_data, BWPersonality.GUICore.GUI_ID_SHOP, soToolTipComponent.EVENT_SHOW)
        return Interceptor.handleMouseEnterEvent(self, comp)


