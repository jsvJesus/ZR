        self.component.addChild(comp, 'item_grade')
        drop = GUI.Simple('soGUI/maps/Icons/pure_water.dds')
        drop.verticalPositionMode = drop.horizontalPositionMode = 'PIXEL'
        drop.horizontalAnchor = 'LEFT'
        drop.verticalAnchor = 'TOP'
        drop.widthMode = drop.heightMode = 'PIXEL'
        drop.width = drop.texture.width
        drop.height = drop.texture.height
        drop.colour = (255, 255, 255, 255)
        drop.materialFX = 'BLEND'
        drop.position = (3, 3, 0.1)
        drop.visible = False
        self.component.addChild(drop, 'drop')

    def set_item(self, complex_item):
        Tooltiper.set_item(self, complex_item)
        item_colored = False
        item_emblemed = False
        item_graded = False
        if ItemsUtils.is_sub_item(complex_item):
            item_type = complex_item['itemType']
        else:
            item_type = complex_item['complexItemType']
            self.component.count.text = ItemsUtils.GetDisplayValue(complex_item)
            item_colored = bool(ItemsUtils.getItemColorise(complex_item))
            item_emblemed = bool(ItemsUtils.getItemEmblem(complex_item))
            item_graded = bool(ItemsUtils.IsItemGraded(complex_item))
        icon_name = ItemsUtils.GetIconName(None, item_type=item_type) or 'nottexture.dds'
        self.component.image.texture = BWPersonality.GUICore.get_icon_from_cache(icon_name)
        self.component.item_colored.visible = item_colored
        self.component.item_emblem.visible = item_emblemed
        self.component.item_grade.visible = item_graded
        self.component.drop.visible = False
        if not ItemsUtils.is_sub_item(complex_item):
            water_state = ItemsUtils.get_water_state(complex_item)
            if water_state == WaterState.Dirty:
                self.component.drop.textureName = 'soGUI/maps/Icons/dirty_water.dds'
                self.component.drop.visible = True
            elif water_state == WaterState.Clear:
                self.component.drop.textureName = 'soGUI/maps/Icons/pure_water.dds'
                self.component.drop.visible = True
        return


class NameSection(Section):

    def __init__(self, component, slots_start_pos, text_component):
        Section.__init__(self, component)
        self._slots_start_pos = slots_start_pos
        self._mini_slot_size = 32
        self._slot_space = 2
        comp = self.create_slot_component()
        self.component.addChild(comp)
        self._base_slot = Slot(comp)
        self._base_slot.on_click = self._on_item_click
        self._slots = []
        self.component.addChild(text_component, 'name')
        self.on_item_click = lambda : None

    def create_slot_component(self):
        comp = GUI.Window()
        comp.verticalPositionMode, comp.horizontalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (64, 64)
        comp.position = (2, 2, 1)
        return comp

    def _on_item_click(self):
        self.on_item_click()

    def apply_item_name_to_text(self, item_name, text_comp):
        raise NotImplementedError

    def align_slots_center(self, max_item_in_row = None):

        def generate_row(row, start_index, count):
            spaces_count = max(0, count - 1)
            width = count * self._mini_slot_size + spaces_count * self._slot_space
            displace = width / 2
            index = 0
            y_pos = self._slots_start_pos[1] + row * (self._mini_slot_size + self._slot_space)
            for i in range(start_index, start_index + count):
                slot = self._slots[i]
                x_pos = self._slots_start_pos[0] + (self._mini_slot_size + self._slot_space) * index - displace
                slot.component.position[0] = x_pos
                slot.component.position[1] = y_pos
                index += 1

            return y_pos + self._mini_slot_size

        total = next((i for i, s in enumerate(self._slots) if not s.component.visible), len(self._slots))
        start_index = 0
        row = 0
        if not max_item_in_row:
            max_item_in_row = self._total
        bottom_line = self._slots_start_pos[1]
        while total > 0:
            bottom_line = generate_row(row, start_index, min(max_item_in_row, total)) + 4
            total -= max_item_in_row
            start_index += max_item_in_row
            row += 1

        return bottom_line

    def get_slot(self, index):
        while index >= len(self._slots):
            comp = GUI.Window()
            comp.verticalPositionMode, comp.horizontalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = self._mini_slot_size, self._mini_slot_size
            x_pos = self._slots_start_pos[0] + (self._mini_slot_size + self._slot_space) * len(self._slots)
            comp.position = (x_pos, self._slots_start_pos[1], 1)
            self.component.addChild(comp)
            self._slots.append(Slot(comp))

        return self._slots[index]

    def update(self, item):
        complex_item = item['complexItem']
        self._base_slot.set_item(complex_item)
        item_name = ItemsUtils.GetItemName(complex_item['complexItemType'])
        self.apply_item_name_to_text(item_name, self.component.name)
        for slot in self._slots:
            if not slot.component.visible:
                break
            slot.component.visible = False

        for i, item in enumerate(complex_item.get('itemList')):
            slot = self.get_slot(i)
            slot.set_item(item)
            slot.component.visible = True