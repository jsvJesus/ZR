# Embedded file name: ./client/soGUI/sales/table/charssection.py
from Items import ItemsCatalog
import ItemsUtils
import GUI
from section import Section
import colorCodes as cc
from Localization import lc
import clweapon
from Helpers.PyGUI.PyGUIBase import Interceptor
import BWPersonality
import math_bw

class Alignment:
    Stretch, Squash = range(2)


class LoadMode:
    Short, Extended = range(2)


class CompslotTypes:
    Art, State, Pollution, Reps, Loaded, LoadedExtended, Battery, Uses, Number = range(9)
    slottype_to_image = {State: 'soGUI/frame/billboard/status.dds',
     Pollution: 'soGUI/frame/billboard/impurity.dds',
     Reps: 'soGUI/frame/billboard/repaired.dds',
     Loaded: 'soGUI/frame/billboard/charged.dds',
     LoadedExtended: 'soGUI/frame/billboard/charged.dds',
     Battery: 'soGUI/frame/billboard/battery.dds',
     Uses: 'soGUI/frame/billboard/employ.dds',
     Number: 'soGUI/frame/billboard/amount.dds',
     Art: 'soGUI/frame/billboard/charge.dds'}
    slottype_to_tooltip = {State: lc('sales.TABLE.TTIPS.STATE'),
     Pollution: lc('sales.TABLE.TTIPS.POLLUTE'),
     Reps: lc('sales.TABLE.TTIPS.REPS'),
     Loaded: lc('sales.TABLE.TTIPS.LOAD'),
     LoadedExtended: lc('sales.TABLE.TTIPS.LOAD'),
     Battery: lc('sales.TABLE.TTIPS.BATTERY'),
     Uses: lc('sales.TABLE.TTIPS.USES'),
     Number: lc('sales.TABLE.TTIPS.AMOUNT'),
     Art: lc('sales.TABLE.TTIPS.ART')}


class Tooltiper(Interceptor):

    def __init__(self, component, intercept_buttons = False):
        Interceptor.__init__(self, component)
        self._text = None
        return

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip()
        return Interceptor.handleMouseLeaveEvent(self, comp)

    def set_text(self, text):
        self._text = text

    def handleMouseEnterEvent(self, comp):
        if self._text:
            text = cc.tf3_regular_text_color + self._text
            BWPersonality.GUICore.showToolTip(text, delay=0.2)
        return Interceptor.handleMouseEnterEvent(self, comp)


class CharsSection(Section):

    def __init__(self, component, alignment, loadmode):
        Section.__init__(self, component)
        self._margin = 4
        self._space = 0
        self._load_mode = loadmode
        self._alignment = alignment
        self.content_width = 0.0
        self._compslots = []

        def create_compslot():
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
            comp.height = 2
            comp.position = (0, 0, 0.5)
            self.component.addChild(comp)
            self._compslots.append(comp)
            component = comp
            comp = GUI.Simple('')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.position = (self._margin, 0, 0.5)
            component.addChild(comp, 'image')
            Tooltiper(comp)
            comp = GUI.Text()
            comp.colour = cc.highlighted2_rgba
            comp.font = 'RobotoCondensedRegular_16.font'
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.position = (38, 0, 0.5)
            comp.multiline = True
            component.addChild(comp, 'text')

        compslots_number = 4
        for i in range(compslots_number):
            create_compslot()

        self._index = None
        return

    def set_space(self, space):
        self._space = space

    def update(self, item):
        for compslot in self._compslots:
            compslot.visible = False

        self._index = 0
        self.content_width = 0

        def apply_result(slot_type, text):
            if text is None or self._index >= len(self._compslots):
                return
            else:
                compslot = self._compslots[self._index]
                self._index += 1
                compslot.image.textureName, compslot.text.text = CompslotTypes.slottype_to_image[slot_type], text
                compslot.image.width, compslot.image.height = compslot.image.texture.width, compslot.image.texture.height
                compslot.visible = True
                compslot.image.script.set_text(CompslotTypes.slottype_to_tooltip[slot_type])
                compslot.position[0] = self.content_width
                if self._alignment == Alignment.Stretch:
                    width = self.component.width * 0.25
                elif self._alignment == Alignment.Squash:
                    text_width = compslot.text.stringDimensions(compslot.text.text)[0]
                    width = compslot.text.position[0] + text_width + self._margin
                compslot.width = width
                self.content_width += width + self._space
                return

        self.content_width = max(0, self.content_width - self._space)
        apply_result(CompslotTypes.Art, self._append_art_time())
        apply_result(CompslotTypes.State, self._append_state())
        apply_result(CompslotTypes.Pollution, self._append_pollution())
        apply_result(CompslotTypes.Reps, self._append_repairs())
        if self._load_mode == LoadMode.Short:
            apply_result(CompslotTypes.Loaded, self._append_loaded())
        elif self._load_mode == LoadMode.Extended:
            apply_result(CompslotTypes.Loaded, self._append_loadedextended())
        apply_result(CompslotTypes.Battery, self._append_battery())
        apply_result(CompslotTypes.Uses, self._append_uses())
        apply_result(CompslotTypes.Number, self._append_number())

    def _append_state(self):
        condition_string = ItemsUtils.GetItemConditionPercentString(None, self.complex_item)
        if not condition_string:
            return
        else:
            return condition_string

    def _append_pollution(self):
        if self.item_class != ItemsCatalog.WEAPON:
            return None
        else:
            pollut_value = round(ItemsUtils.GetItemPollution(self.complex_item, pollution_type=ItemsCatalog.INC_POLLUTION_SCORCHING), 1)
            return str(pollut_value) + '%'

    def _append_repairs(self):
        if not ItemsUtils.is_itemtype_repairable(self.item_type):
            return
        if self.item_class == ItemsCatalog.CLOTH:
            return
        result = ItemsUtils.GetSingleInconstantParam(self.complex_item, ItemsCatalog.INC_REPAIRS_NUMBER) or 0
        return unicode(result) + ' ' + lc('sales.TABLE.REPNUM')

    def _append_loaded(self):
        if self.item_class != ItemsCatalog.WEAPON:
            return None
        else:
            weapon = clweapon.ClWeapon(self.complex_item)
            return unicode(weapon.getAmmoNumber() or 0) + ' ' + lc('sales.TABLE.AMMONUM')

    def _append_loadedextended(self):
        if self.item_class != ItemsCatalog.WEAPON:
            return None
        else:
            weapon = clweapon.ClWeapon(self.complex_item)
            if not weapon.getAmmoNumber():
                ammo_count = 0
                result = unicode(str(ammo_count) + ' ' + lc('sales.TABLE.AMMONUM'))
                result = ammo_count and ItemsUtils.GetItemName(weapon.getAmmoType(), fGetShortName=False) + '\n' + result
            return result

    def _append_battery(self):
        if self.item_class not in (ItemsCatalog.CLOTH, ItemsCatalog.GADGET):
            return None
        elif 'FuelMax' not in ItemsCatalog.GetItemParam(self.item_type):
            return None
        else:
            max_battery_level = ItemsUtils.get_max_battery_level(self.item_type)
            battery_level = ItemsUtils.GetBatteryLevel(self.complex_item)
            battery_level_percent = round(100.0 * battery_level / max_battery_level, 1)
            return str(battery_level_percent) + '%'

    def _append_uses(self):
        count = None
        max_count = None
        item_class = self.item_class
        item_param = ItemsCatalog.GetItemParam(self.item_type)
        if item_class == ItemsCatalog.BUFF:
            count = ItemsUtils.GetSingleInconstantParam(self.complex_item, ItemsCatalog.INC_USES_NUMBER)
            if 'IsArtefactContainer' in item_param:
                if not ItemsUtils.GetSingleInconstantParam(self.complex_item, ItemsCatalog.INC_USES_CONTAINER_NUMBER):
                    count = 0
                    max_count = item_param.get('MaxUseArtefact')
                    if max_count is not None:
                        count = max_count - count
            elif item_class == ItemsCatalog.GADGET:
                if 'waterNumberOfSips' in item_param and ItemsUtils.GetItemCondition(None, self.complex_item) > 0:
                    sips = ItemsUtils.getWaterSipsPot(self.complex_item)
                    if sips >= 1:
                        count = sips
                elif 'IsArtefactContainer' in item_param:
                    count = ItemsUtils.GetSingleInconstantParam(self.complex_item, ItemsCatalog.INC_USES_CONTAINER_NUMBER) or 0
                    max_count = item_param.get('MaxUseArtefact')
            elif item_class == ItemsCatalog.ARTIFACT:
                count = ItemsUtils.GetSingleInconstantParam(self.complex_item, ItemsCatalog.INC_USES_CONTAINER_NUMBER) or 0
                max_count = item_param.get('MaxUseArtefact')
            return count is None and None
        else:
            if max_count is None:
                count = unicode(count)
            else:
                count = u'{0} {1} {2}'.format(count, lc('sales.TABLE.OF'), max_count)
            return count

    def _append_number(self):
        if not ItemsUtils.isStackedItemType(self.item_type):
            return None
        else:
            number = ItemsUtils.GetItemNumber(self.complex_item)
            if number <= 1:
                return None
            return str(number)

    def _append_art_time(self):
        if self.item_class != ItemsCatalog.ARTIFACT:
            return None
        else:
            percent = round(math_bw.clamp(ItemsUtils.GetArtefactDepleetionPercent(self.complex_item)) * 1000) * 0.1
            text = str(percent) + '%'
            return text