from utils import PY
import GUI
from section import PriceSection
from namesection import NameSection
from timesection import TimeSection, Alignment as TimeAlignment
from charssection import CharsSection, Alignment as CharsAlignment, LoadMode
from soGUI.soButton import soButton
import colorCodes as cc
import client_utils

class ClickType:
    Line, Item = range(2)


class LineNameSection(NameSection):

    def __init__(self, component):
        comp = GUI.Text('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.position = (68, 6, 0.5)
        comp.colour = cc.highlighted2_rgba
        NameSection.__init__(self, component, (68, 34), comp)

    def apply_item_name_to_text(self, item_name, text_comp):
        clip_width = self.component.width - 70
        text_comp.text = client_utils.clip_text(item_name, text_comp, clip_width)


class Line(soButton):

    def __init__(self, component, columns_widths):
        soButton.__init__(self, component)
        pos_x = 0.0
        sections_classes = [(LineNameSection, []),
         (PriceSection, []),
         (TimeSection, [TimeAlignment.Left, True, 0.5]),
         (CharsSection, [CharsAlignment.Stretch, LoadMode.Short])]
        self._sections = []
        for i in range(len(sections_classes)):
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
            comp.width, comp.height = columns_widths[i], 2
            comp.position = (pos_x, 0, 0)
            self.component.addChild(comp)
            pos_x += columns_widths[i]
            args = sections_classes[i][1]
            self._sections.append(sections_classes[i][0](comp, *args))

        self._sections[0].on_item_click = self._on_item_click
        self.onClick = self.on_click
        self.initVSC('soGUI/elements/button_1.xml')
        self.onBound()
        self.item = None
        self._apply_item_data()
        self.click_callback = lambda click_type, line: None
        return

    def _on_item_click(self):
        self.click_callback(ClickType.Item, self)

    def _apply_item_data(self):
        if not self.item:
            self.component.visible = False
            return
        self.component.visible = True
        for section in self._sections:
            section.apply_item_data(self.item)

    def set_item(self, item_data):
        self.item = PY(item_data)
        self._apply_item_data()

    def on_click(self):
        self.click_callback(ClickType.Line, self)