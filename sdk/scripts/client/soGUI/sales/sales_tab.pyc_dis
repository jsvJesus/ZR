    def _on_buy_click(self, item_data):

        def buy():
            BigWorld.player().buyItemFromShop(item_data['sellerName'], item, price, item_data['BankName'])
            self._winsmanager.close_win(item['complexItemID'])
            self._filters.invalidate()

        p = BigWorld.player()
        price = item_data['price']
        if p.CreditNumber < price:
            ask = lc('tmplocal.strings.str13') % (p.CreditNumber, price)
            gui_jokes.askUserOk(lc('Codes.ShopResponses.ERROR'), ask)
            return
        elif item_data['sellerName'] == p.name.encode('utf8'):
            ask = lc('Codes.ShopResponses.FAIL_NO_BUY_SELF')
            gui_jokes.askUserOk(lc('Codes.ShopResponses.ERROR'), ask)
            return
        else:
            item = item_data['complexItem']
            item_param = ItemsCatalog.GetItemParam(item['complexItemType'])
            item_ttl = ItemsUtils.GetItemDestroyTime(item, item_param)
            if item_ttl is not None and item_ttl < 60:

                def ttl_callback(event):
                    if event == gui_jokes.askUserYesNo.YES:
                        buy()

                ask = lc('Inventory.client.ItemlifeTimeIsOverOnBye')
                gui_jokes.askUserYesNo(u'', ask, ttl_callback)
            else:
                buy()
            return

    def got_catalog_filtered2(self, request_id, index_range, total, result):
        if not self._visible:
            return
        if self._server.check_data(request_id):
            self._table.set_data(result)
            self._filters.set_data(index_range, total)

    def _on_table_click(self, click_type, item_data):
        if click_type == ClickType.Item:
            BWPersonality.GUICore.showItemInfo(item_data['complexItem'])
        elif click_type == ClickType.Line:
            self._winsmanager.create_window(item_data)

    def _on_filters_data_changed_immidiate(self):
        self._server.stop_request()
        self._table.disable()

    def _on_filters_data_changed_delay(self):
        self._compile_data_and_request_server()

    def show(self):
        if not self._visible:
            self._visible = True
            self._table.disable()
            self._compile_data_and_request_server()

    def ready_to_close(self):
        return not self._winsmanager.pop_top_window()

    def _compile_data_and_request_server(self):
        filter_data = self._filters.get_filter_data()
        filter_data['rows'] = self._table.rows
        self._server.request_data(filter_data)

    def hide(self):
        if self._visible:
            self._filters.on_hide()
            self._winsmanager.clear()
            self._visible = False