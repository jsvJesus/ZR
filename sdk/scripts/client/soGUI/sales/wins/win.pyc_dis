class WinNameSection(NameSection):

    def __init__(self, component):
        tf = soTextField3(GUI.Window(), 200, 60, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        comp = tf.component
