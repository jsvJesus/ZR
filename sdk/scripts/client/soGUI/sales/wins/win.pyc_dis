    def handleMouseButtonEvent(self, comp, event):
        self.notify_listeners(EventType.FocusRequest, self)
        return DragWin.handleMouseButtonEvent(self, comp, event)

    def _on_close_click(self):
        self.notify_listeners(EventType.CloseRequest, self)

    def _on_buy_click(self):
        self.notify_listeners(EventType.BuyRequest, self)

    def set_item(self, item_data):
        self.item_data = item_data
        self._namesection.apply_item_data(item_data)
        self._timesection.apply_item_data(item_data)
        self._charssection.apply_item_data(item_data)
        width = self._charssection.content_width
        self._charssection.component.width = width
        price = groupNumber(item_data['price'])
        self.component.price.text = lc('sales.TABLE.WINS.PRICE').format(price)