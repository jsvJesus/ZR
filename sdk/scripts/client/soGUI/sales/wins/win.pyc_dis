        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (68, 6, 0.5)
        NameSection.__init__(self, component, (2, 68), comp)

    def apply_item_name_to_text(self, item_name, text_comp):
        text_comp.script.setText(cc.highlighted2_xml + u'<font=RobotoCondensedRegular_16.font>' + item_name, immidiate=True)


