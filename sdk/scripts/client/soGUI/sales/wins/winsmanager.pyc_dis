# Embedded file name: ./client/soGUI/sales/wins/winsmanager.py
import GUI
from win import Win, EventType
from random import uniform

class WinsManager:

    def __init__(self, component):
        self.component = component
        self._wins = []
        self.buy_callback = lambda : None

    def create_window(self, item_data):
        first_itemdata_win = None
        first_hidden_win = None
        for win in self._wins:
            if win.component.visible:
                if win.item_data['complexItem']['complexItemID'] == item_data['complexItem']['complexItemID']:
                    first_itemdata_win = win
                    break
            else:
                first_hidden_win = win

        if not first_itemdata_win:
            win = first_hidden_win
            if not win:
                comp = len(self._wins) < 20 and GUI.Window('soGUI/frame/paint/white.dds')
                comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
                comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
                comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
                comp.width, comp.height = (490, 330)
                comp.position = (uniform(-0.2, 0.2), uniform(-0.2, 0.2), 5)
                comp.colour = (0, 0, 0, 240)
                comp.materialFX = 'BLEND'
                self.component.addChild(comp)
                win = Win(comp)
                win.add_listener(self._on_win_event)
                self._wins.append(win)
            else:
                win = self._wins[-1]
        win.set_item(item_data)
        win.component.visible = True
        self._focus_win(win)
        return

    def pop_top_window(self):
        for win in self._wins:
            if win.component.visible:
                win.component.visible = False
                return True

        return False

    def close_win(self, complex_item_id):
        for win in self._wins:
            if win.item_data['complexItem']['complexItemID'] == complex_item_id:
                win.component.visible = False

    def _on_win_event(self, event_type, win):
        if event_type == EventType.CloseRequest:
            win.component.visible = False
        elif event_type == EventType.FocusRequest:
            self._focus_win(win)
        elif event_type == EventType.BuyRequest:
            self.buy_callback(win.item_data)

    def _focus_win(self, win):
        self._wins.remove(win)
        self._wins.insert(0, win)
        if self._wins:
            depth = 1.0 / len(self._wins)
        for i, win in enumerate(self._wins):
            self._wins[i].component.position[2] = i * depth

        self.component.reSort()

    def clear(self):
        for win in self._wins:
            win.component.visible = False