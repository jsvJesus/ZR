def f_vec(vec):
    out = ''
    for x in vec:
        out += ' %.4f' % x

    return out


def isShift():
    return BigWorld.isKeyDown(Keys.KEY_LSHIFT or Keys.KEY_RSHIFT)


def isAlt():
    return BigWorld.isKeyDown(Keys.KEY_LALT or Keys.KEY_RALT)


