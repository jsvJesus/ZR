    def changeMode(self, value, mode):
        if not value:
            return
        self.mode = mode
        self.updateMode()
        self.onCamTagert(old_cam=BigWorld.camera())

    def show(self, mode = None):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild('TestRotateHelp')
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'TestRotateHelp')
        self.component.visible = True
        player = BigWorld.player()
        if not player.active_weapon:
            BWPersonality.gpd.sendHightMessage('  ERROR: player not found active_weapon')
            self.hide()
            return
        else:
            if not mode:
                mode = MODES[0]
            self.mode = mode
            player.lookingaround = True
            player.update_turn_states()
            player.updateTrackerLookArround(player.lookingaround)
            player.physics.userDirected = False
            BWPersonality.GUICore.targettingGUI.hide()
            BWPersonality.GUICore.showCrosshairLookAround(True)
            BWPersonality.GUICore.setMouseAltState(altState=True, force=True)
            BWPersonality.debugHOOKHandleMouseEvent = self.debugHOOKHandleMouseEvent
            BWPersonality.debugHOOKHandleKeyEvent = self.debugHOOKHandleKeyEvent
            old_cam = player.AvatarCam
            self.free_cam = BigWorld.FreeCamera(old_cam)
            self.free_cam.invViewProvider = Matrix(old_cam.invViewMatrix)
            BigWorld.camera(self.free_cam)
            self.updateMode()
            self.onCamTagert(old_cam=old_cam)
            self._radio[mode].setActive()
            return

    def hide(self):
        self.component.visible = False
        self.stop()
        BWPersonality.GUICore.setBestCursor()
        BigWorld.player().updateHandToWeaponOffset()

    def onCamTagert(self, old_cam = None):
        BigWorld.cancelCallback(self._timerID)
        if not old_cam:
            old_cam = BigWorld.camera()

        def start_camera():
            BigWorld.cancelCallback(self._timerID)
            self._cam_matr_offset = Matrix(self.getCamTagert())
            self._cam_matr_offset.invert()
            self._cam_matr_offset.preMultiply(old_cam.invViewMatrix)
            self._timerID = BigWorld.callback(0.001, self._tick)

        null_matrix = False
        if not self._cam_tagert_w.attachments:
            self._cam_tagert_w.attach(BigWorld.Model(''))
            null_matrix = True
        if not self._cam_tagert_p.attachments:
            self._cam_tagert_p.attach(BigWorld.Model(''))
            null_matrix = True
        if null_matrix:
            BigWorld.callback(0, start_camera)
        else:
            start_camera()

    def getCamTagert(self):
        if self._cb_cam.isChecked():
            return self._cam_tagert_p
        return self._cam_tagert_w

    def updateMode(self):
        BigWorld.cancelCallback(self._timerID)
        player = BigWorld.player()
        if self.mode == 'Left_hand':
            bone_name = 'HP_Lhand'
            self._cam_tagert_w = player.active_weapon_model.node(bone_name)
            self._cam_tagert_p = player.model.node(bone_name)
            self._weapon_node = player.active_weapon_model.node(bone_name)
            self._getAddPos = lambda : player.left_weapon_prov.add_position
            self._getAddRot = lambda : player.left_weapon_prov.add_rotation
            self._setAddPos = lambda val: setattr(player.left_weapon_prov, 'add_position', val)
            self._setAddRot = lambda val: setattr(player.left_weapon_prov, 'add_rotation', val)
        elif self.mode == 'Right_hand':
            bone_name = 'HP_Rhand'
            self._cam_tagert_w = player.active_weapon_model.node(bone_name)
            self._cam_tagert_p = player.model.node(bone_name)
            self._weapon_node = player.active_weapon_model.node(bone_name)
            self._getAddPos = lambda : player.right_weapon_prov.add_position
            self._getAddRot = lambda : player.right_weapon_prov.add_rotation
            self._setAddPos = lambda val: setattr(player.right_weapon_prov, 'add_position', val)
            self._setAddRot = lambda val: setattr(player.right_weapon_prov, 'add_rotation', val)
        elif self.mode == 'GUNR':
            print 'GUNR   model'
            self._cam_tagert_w = player.model.node('RightShoulder')
            self._cam_tagert_p = player.active_weapon_model.node('HP_GUNR')
            self._weapon_node = player.model.node('HP_GUNR')
            self._getAddPos = lambda : player.GUNMover_nodeInfo.vecAddPos
            self._getAddRot = lambda : (0, 0, 0)
            self._setAddPos = lambda val: setattr(player.GUNMover_nodeInfo, 'vecAddPos', val)
            self._setAddRot = lambda val: 0
        elif self.mode == 'GUNRW':
            print 'GUNRW   active_weapon_model'
            self._cam_tagert_w = player.active_weapon_model.node('HP_GUNR')
            self._cam_tagert_p = player.active_weapon_model.node('HP_GUNRW')
            self._weapon_node = player.active_weapon_model.node('HP_GUNRW')
            self._getAddPos = lambda : player.test_nodeInfo_gunrw.vecAddPosGun
            self._getAddRot = lambda : (0, 0, 0)
            self._setAddPos = lambda val: setattr(player.test_nodeInfo_gunrw, 'vecAddPosGun', val)
            self._setAddRot = lambda val: 0
        else:
            raise ValueError('unknown %s' % self.mode)

    def stop(self):
        BigWorld.cancelCallback(self._timerID)
        BWPersonality.debugHOOKHandleMouseEvent = lambda *e: None
        BWPersonality.debugHOOKHandleKeyEvent = lambda *e: None
        player = BigWorld.player()
        BigWorld.camera(player.AvatarCam)

    def rotate_cam_orbiter(self, dx, dy):
        dx = dx * 0.003
        dy = dy * 0.003
        view = Matrix(self.free_cam.invViewProvider)
        pivot_matr = Matrix(self.getCamTagert())
        pivot = pivot_matr.translation
        if pivot.distTo(view.translation) > 5000:
            return False
        cam_vec = view.translation - pivot
        dist = cam_vec.length
        cam_vec.normalise()
        yaw = cam_vec.yaw + dx
        pitch = cam_vec.pitch - dy
        pitch = max(-1.56, min(1.56, pitch))
        cam_vec.setPitchYaw(pitch, yaw)
        new_pos = pivot + cam_vec * dist
        new_view = Matrix()
        old_cam_up = view.applyToAxis(1)
        old_cam_dir = view.applyToAxis(2)
        pre_yaw = old_cam_dir.yaw + dx
        pre_pitch = old_cam_dir.pitch + dy
        pre_pitch = max(-1.56, min(1.56, pre_pitch))
        cam_dir_pre = Vector3()
        cam_dir_pre.setPitchYaw(pre_pitch, pre_yaw)
        need_cam_dir = -cam_vec
        smooth = 30
        new_cam_dir = (cam_dir_pre * smooth + need_cam_dir) / (smooth + 1)
        new_cam_dir.normalise()
        new_view.lookAt(new_pos, new_cam_dir, Vector3(0, 1, 0))
        new_view.invert()
        old_rol = view.roll
        add_roll_cam = Matrix()
        add_roll_cam.setRotateYPR((0, 0, old_rol * 0.98))
        new_view.preMultiply(add_roll_cam)
        self._cam_matr_offset = pivot_matr
        self._cam_matr_offset.invert()
        self._cam_matr_offset.preMultiply(new_view)
        return True

    def _move(self, event):
        cam_view = Matrix(self.free_cam.invViewProvider)
        player = BigWorld.player()
        weapon_node = Matrix(self._weapon_node)
        m_add_pos = Matrix()
        m_add_rot = Matrix()
        m_add_pos.setTranslate(self._getAddPos())
        m_add_rot.setRotateYPR(self._getAddRot())
        hand_node = Matrix(weapon_node)
        hand_node.preMultiply(m_add_pos)
        hand_node.preMultiply(m_add_rot)
        weaponInv = Matrix(weapon_node)
        weaponInv.invert()
        move_speed = 0.0001
        if isShift():
            move_speed *= 10
        add_m = Matrix()
        add_m.setTranslate((-event.dx * move_speed, event.dy * move_speed, 0))
        cam_view_new = Matrix(cam_view)
        cam_view_new.preMultiply(add_m)
        diff_screen = Matrix(cam_view_new)
        diff_screen.invert()
        diff_screen.postMultiply(cam_view)
        new_hand = Matrix(hand_node)
        new_hand.postMultiply(diff_screen)
        wehand_plhand = Matrix(weaponInv)
        wehand_plhand.preMultiply(new_hand)
        self._setAddPos(wehand_plhand.translation)
        self._last_time_move = BigWorld.time()
        drawer.clear()
        drawer.addLine(weapon_node.translation, new_hand.translation)

    def _rotate(self, event):
        cam_view = Matrix(self.free_cam.invViewProvider)
        player = BigWorld.player()
        weapon_node = Matrix(self._weapon_node)
        weaponInv = Matrix(weapon_node)
        weaponInv.invert()
        m_add_pos = Matrix()
        m_add_rot = Matrix()
        m_add_pos.setTranslate(self._getAddPos())
        m_add_rot.setRotateYPR(self._getAddRot())
        hand_node = Matrix(weapon_node)
        hand_node.preMultiply(m_add_pos)
        hand_node.preMultiply(m_add_rot)
        rotate_speed = 0.0005
        if isShift():
            rotate_speed *= 10
        add_m = Matrix()
        if self._cam_roll:
            add_m.setRotateYPR((0, 0, event.dy * rotate_speed * self._cam_roll * 0.6))
        else:
            add_m.setRotateYPR((event.dx * rotate_speed, event.dy * rotate_speed, 0))
        cam_view_new = Matrix(cam_view)
        cam_view_new.preMultiply(add_m)
        diff_screen = Matrix(cam_view_new)
        diff_screen.invert()
        diff_screen.postMultiply(cam_view)
        new_hand = Matrix(hand_node)
        new_hand.postMultiply(diff_screen)
        wehand_plhand = Matrix(weaponInv)
        wehand_plhand.preMultiply(new_hand)
        self._setAddRot((wehand_plhand.yaw, wehand_plhand.pitch, wehand_plhand.roll))
        self._last_time_move = BigWorld.time()
        drawer.clear()
        height_w = 0.03
        height_h = 0.07
        wpos = weapon_node.translation
        drawer.addLine(wpos, wpos + weapon_node.applyToAxis(0) * height_w, (0.7, 0, 0, 0.1))
        drawer.addLine(wpos, wpos + new_hand.applyToAxis(0) * height_h, (1, 0, 0, 1))
        drawer.addLine(wpos, wpos + weapon_node.applyToAxis(1) * height_w, (0, 1, 0, 0.1))
        drawer.addLine(wpos, wpos + new_hand.applyToAxis(1) * height_h, (0, 1, 0, 1))
        drawer.addLine(wpos, wpos + weapon_node.applyToAxis(2) * height_w, (0, 0, 1, 0.1))
        drawer.addLine(wpos, wpos + new_hand.applyToAxis(2) * height_h, (0, 0, 1, 1))

    def toChangeMouseEvent(self, event):
        if self._lmb:
            self._move(event)
        if self._rmb:
            self._rotate(event)

    def debugHOOKHandleMouseEvent(self, event):
        if self._alt:
            move_speed = 0.001
            rotate_speed = 0.001
            dz_speed = 5e-05
            if isShift():
                dz_speed *= 10
            free_cam = BigWorld.camera()
            m = Matrix()
            if event.dz:
                m.setTranslate((0, 0, event.dz * dz_speed))
                self._cam_matr_offset.preMultiply(m)
            if self._lmb:
                m.setTranslate((-event.dx * move_speed, event.dy * move_speed, 0))
                self._cam_matr_offset.preMultiply(m)
            if self._rmb:
                if self._cam_roll:
                    m.setRotateYPR((0, 0, event.dy * rotate_speed * self._cam_roll))
                else:
                    m.setRotateYPR((-event.dx * rotate_speed, -event.dy * rotate_speed, 0))
                self._cam_matr_offset.preMultiply(m)
            if self._mmb:
                self.rotate_cam_orbiter(event.dx, event.dy)
                self._skip_orbiter_smooth = True
        else:
            self.toChangeMouseEvent(event)
        BWPersonality.PyGUI.handleMouseEvent(event)
        BWPersonality.GUICore.handleMouseEvent(event)
        GUI.handleMouseEvent(event)
        return True

    def debugHOOKHandleKeyEvent(self, event):
        down = event.isKeyDown()
        if event.key == Keys.KEY_LALT:
            self._alt = down
        if event.key == Keys.KEY_LEFTMOUSE:
            self._lmb = down
        if event.key == Keys.KEY_MIDDLEMOUSE:
            self._mmb = down
        if event.key == Keys.KEY_ESCAPE and down:
            self.hide()
        if event.key == Keys.KEY_RIGHTMOUSE:
            self._rmb = down
            x_curs = BWPersonality.game.mcursor.position[0]
            self._cam_roll = 0
            if x_curs > 0.8:
                self._cam_roll = 1
            elif x_curs < -0.8:
                self._cam_roll = -1
        if down:
            to_mode = {Keys.KEY_1: MODES[0],
             Keys.KEY_2: MODES[1],
             Keys.KEY_3: MODES[2],
             Keys.KEY_4: MODES[3]}
            mode = to_mode.get(event.key, None)
            if mode:
                self._radio[mode].setActive()
                self.changeMode(True, mode)
            if event.key in (Keys.KEY_RETURN, Keys.KEY_SPACE):
                self.save()
        if BWPersonality.GUICore.handleKeyEvent(event):
            return True
        else:
            GUI.handleKeyEvent(event)
            return True

    def save(self):
        BWPersonality.gpd.sendHightMessage('save...')
        player = BigWorld.player()
        w = player.active_weapon
        if not w:
            return
        if w._custom_hilt and w._custom_hilt.getProp().get('tracker_from'):
            data = [{'event': 'save_offset',
              'item_type': w._custom_hilt.getProp().get('tracker_from'),
              'tracker_key': player._getTrackerKey(),
              'hand_L_weapon_add_pos': tuple(player.left_weapon_prov.add_position),
              'hand_L_weapon_add_rotate': tuple(player.left_weapon_prov.add_rotation)}, {'event': 'save_offset',
              'item_type': w.getItemType(),
              'tracker_key': player._getTrackerKey(),
              'hand_R_weapon_add_pos': tuple(player.right_weapon_prov.add_position),
              'hand_R_weapon_add_rotate': tuple(player.right_weapon_prov.add_rotation),
              'GUNPOS': tuple(player.GUNMover_nodeInfo.vecAddPos),
              'GUNRWPOS': tuple(player.test_nodeInfo_gunrw.vecAddPosGun)}]
        else:
            data = [{'event': 'save_offset',
              'item_type': w.getItemType(),
              'tracker_key': player._getTrackerKey(),
              'hand_L_weapon_add_pos': tuple(player.left_weapon_prov.add_position),
              'hand_L_weapon_add_rotate': tuple(player.left_weapon_prov.add_rotation),
              'hand_R_weapon_add_pos': tuple(player.right_weapon_prov.add_position),
              'hand_R_weapon_add_rotate': tuple(player.right_weapon_prov.add_rotation),
              'GUNPOS': tuple(player.GUNMover_nodeInfo.vecAddPos),
              'GUNRWPOS': tuple(player.test_nodeInfo_gunrw.vecAddPosGun)}]
        for e in data:
            if not wtCommunicate.send(e):
                BWPersonality.gpd.sendHightMessage('error connect')

    def _tick(self):
        if not self.component.visible:
            return self.stop()
        BigWorld.cancelCallback(self._timerID)
        self._timerID = BigWorld.callback(0.001, self._tick)
        if self._alt and self._mmb and not self._skip_orbiter_smooth:
            self.rotate_cam_orbiter(0, 0)
        m = Matrix(self.getCamTagert())
        m.preMultiply(self._cam_matr_offset)
        self.free_cam.invViewProvider = m
        self._skip_orbiter_smooth = False
        if BigWorld.time() - self._last_time_move > 0.7:
            drawer.clear()