        cmp.materialFX = 'BLEND'
        cmp.width = 131
        cmp.height = 25
        cmp.position = (self.component.width / 2 - 2 - cmp.width / 2, self.component.height - 7, 0.1)
        cmp.script.onClick = self.onAccept
        self.component.addChild(cmp, 'button_accept')
        btn.onBound()
        self.scroll = soScrollBar2(GUI.Window(), width=16, height=280)
        self.scroll.scrollMoved = self.scrollMoved
        self.scroll.scrollDown = self.scrollDown
        self.scroll.scrollUp = self.scrollUp
        cmp = self.scroll.component
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.position = (self.component.width - 19, 49, 0.1)
        self.component.addChild(cmp, 'scroll')
        self.scroll.setVisualState('normal')
        self.scroll.onBound()
        self.scroll.setSteps(0)
        h = self.component.wnd.scrollHolder.war_list.stringDimensions(self.component.wnd.scrollHolder.war_list.text)[1]
        self.component.wnd.scrollHolder.height = self.component.wnd.scrollHolder.war_list.position.y + h + 20
        self.scrollStep = 20
        scrollStepCount = (self.component.wnd.scrollHolder.height - self.component.wnd.height) / float(self.scrollStep)
        if scrollStepCount > 0:
            self.scroll.setSteps(math.ceil(scrollStepCount))
        else:
            self.scroll.setSteps(0)

    def _set_scroll_value(self, value):
        value = clamp(value, 0, self.scroll.steps)
        if self.scroll.getValue() == value:
            return
        self.scroll.setValue(value)
        self._scroll_changed()

    def _scroll_changed(self):
        pos_y = -self.scroll.getValue() * self.scrollStep
        self.component.wnd.scrollHolder.position.y = min(pos_y, 0)

    def scrollUp(self):
        self._set_scroll_value(self.scroll.getValue() - 1)

    def scrollDown(self):
        self._set_scroll_value(self.scroll.getValue() + 1)

    def scrollMoved(self, value):
        self._set_scroll_value(value)

    def handleMouseEvent(self, component, event):
        dz = event.dz
        if dz > 0:
            self.scrollUp()
            return True
        if dz < 0:
            self.scrollDown()
            return True
        return True


