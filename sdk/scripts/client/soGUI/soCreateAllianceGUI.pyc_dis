class AllianceWindowInterface(PyGUIBase, DraggableComponent):

    def __init__(self, component, clan_name = '', alliance_name = '', enemies = None, callback = None):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        component.script = self
        self.clan_name = clan_name.decode('utf-8')
        self.alliance_name = alliance_name.decode('utf-8')
        self.enemies = u',\n'.join([ i.decode('utf-8') for i in enemies ]) if enemies else None
        self.callback = callback
        self.timeout = 30
        self.setupRoot()
        self.setupControls()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = self.height
        cmp.width = self.width
        cmp.visible = False
        cmp.textureName = ''
        cmp.dragFocus = True
        cmp.dropFocus = True
        cmp.crossFocus = True
        cmp.moveFocus = True
        cmp.mouseButtonFocus = True
        cmp.position = (0, 0, 0.01)
        cmp.visible = False

    def setupControls(self):
        cmp = GUI.Frame2('soGUI/frame/basic_frame_no_footer.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 2.0
        cmp.height = 2.0
        cmp.position = (0, 0, 1.2)
        self.component.addChild(cmp, 'wndFrame')
        cmp = GUI.Window()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.width - 26
        cmp.height = self.height
        cmp.position = (0.0, 26, 1)
        cmp.textureName = ''
        self.component.addChild(cmp, 'wnd')
        closeBox = soButton(GUI.Window())
        cmp = closeBox.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.component.width - 26, 6, 0.3)
        cmp.script.onClick = self.hide
        closeBox.initVSC('soGUI/elements/closeBox.xml')
        closeBox.onBound()
        closeBox.setVisualState('normal')
        self.component.addChild(cmp, 'closeBox')

    @BWMemberCoroutine
    def timeoutTicker(self):
        mins = self.timeout / 60
        secs = self.timeout - mins * 60
        if mins > 0:
            time = '{0}:{1:02}'.format(mins, secs)
        else:
            time = '{0}'.format(secs)
        self.onChangeTime(time)
        while self.timeout > 0:
            yield BWWaitForPeriod(1.0)
            self.timeout -= 1
            mins = self.timeout / 60
            secs = self.timeout - mins * 60
            if mins > 0:
                time = '{0}:{1:02}'.format(mins, secs)
            else:
                time = '{0}'.format(secs)
            self.onChangeTime(time)

        self.ticker = None
        self.onTimerEnd()
        return

    def onChangeTime(self, time):
        raise EnvironmentError

    def onTimerEnd(self):
        self.ticker = None
        self.hide()
        return

    def stopDragging(self):
        DraggableComponent.stopDragging(self)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.name)
        self.component.visible = True
        if self.timeout > 0:
            self.ticker = self.timeoutTicker()
            self.ticker.run()
        BWPersonality.GUICore.setBestCursor()
        return

    def hide(self):
        if self.ticker:
            self.ticker.stop()
            self.ticker = None
        self.component.visible = False
        BWPersonality.GUICore.worldLayer.delChild(self.component)
        return

    def silence_hide(self):
        if self.ticker:
            self.ticker.stop()
            self.ticker = None
        self.component.visible = False
        BWPersonality.GUICore.worldLayer.delChild(self.component)
        return


