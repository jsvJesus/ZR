# Embedded file name: ./client/soGUI/cast_bar/cast_bar.py
import BigWorld
from Helpers.PyGUI.Utils import build_circle_mesh
from math_bw import clamp
from cast import Cast
import GUI

class Circle:

    def __init__(self):
        comp = GUI.DebugComponent('soGUI/frame/castbar/progress_bar.dds')
        comp.materialFX = 'BLEND'
        comp.script = self
        comp.filterType = 'LINEAR'
        self.pixelperfect = False
        self.component = comp
        self._ratio = 0.0

    def set_ratio(self, ratio):
        self._ratio = clamp(ratio)

    def buildMesh(self):
        return build_circle_mesh(self._ratio)


class CastBar(Cast):

    def __init__(self):
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.2)
        comp.width, comp.height = (200, 200)
        Cast.__init__(self, comp)
        comp = GUI.Window('soGUI/frame/castbar/progressbar_back.dds')
        comp.materialFX = 'BLEND'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'back')
        self._circle = Circle()
        comp = self._circle.component
        self.component.width, self.component.height = comp.texture.width, comp.texture.height
        comp.position = (0, 0, 0.1)
        self.component.addChild(comp)
        self._realign_center()

    def _set_red_black(self, factor):
        self.component.back.colour = (factor * 100,
         0,
         0,
         127)

    def _update_content(self):
        if self.ratio is None:
            self.component.visible = False
            return
        else:
            self._circle.set_ratio(self.ratio)
            self.component.visible = True
            return

    def _realign_center(self):
        sw, sh = BigWorld.screenSize()
        self.component.position = (int(sw) / 2, int(sh) / 2, self.component.position[2])

    def doReposition(self):
        Cast.doReposition(self)
        self._realign_center()