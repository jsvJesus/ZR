# Embedded file name: ./client/soGUI/cast_bar/cast.py
import BigWorld
from math_bw import clamp, linear_map
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
from math import pi, sin

class Cast(object):

    def __init__(self, component):
        self._coroutine = None
        self._ratio = None
        self.component = component
        self.component.visible = False
        return

    @property
    def ratio(self):
        return self._ratio

    @ratio.setter
    def ratio(self, value):
        if value is not None:
            value = clamp(value)
        if self._ratio == value:
            return
        else:
            self._ratio = value
            self._update_content()
            return

    @BWMemberCoroutine
    def _cast_coroutine(self, duration, start_ratio, hide_on_complete = True):
        self._set_red_black(0)
        self.ratio = start_ratio
        start_time = BigWorld.time()
        stop_time = start_time + duration
        while BigWorld.time() < stop_time:
            self.ratio = linear_map(BigWorld.time(), start_time, stop_time, start_ratio, 1.0)
            yield BWWaitForPeriod(0)

        self.ratio = 1.0
        yield BWWaitForPeriod(0)
        if hide_on_complete:
            self.ratio = None
        self._coroutine = None
        return

    @BWMemberCoroutine
    def _uncast_coroutine(self, duration):
        self._set_red_black(0)
        self.ratio = 1
        start_time = BigWorld.time()
        stop_time = start_time + duration
        while BigWorld.time() < stop_time:
            self.ratio = linear_map(BigWorld.time(), start_time, stop_time, 1.0, 0.0)
            yield BWWaitForPeriod(0)

        self.ratio = 0.0
        yield BWWaitForPeriod(0)
        self.ratio = None
        self._coroutine = None
        return

    @BWMemberCoroutine
    def _interrup_coroutine(self):
        self._set_red_black(0)
        start_time = BigWorld.time()
        duration = 0.5
        end_time = start_time + duration
        while BigWorld.time() < end_time:
            ratio = (BigWorld.time() - start_time) / duration * 1 * pi
            value = sin(ratio)
            self._set_red_black(value * value)
            yield BWWaitForPeriod(0)

        self._set_red_black(0)
        yield BWWaitForPeriod(0)
        self.ratio = None
        self._coroutine = None
        return

    def doReposition(self):
        pass

    def runCast(self, duration, hide_on_complete = True):
        if self._coroutine:
            self._coroutine.stop()
        self._coroutine = self._cast_coroutine(duration, 0.0, hide_on_complete=hide_on_complete)
        self._coroutine.run()

    def cancelCast(self):
        if self._coroutine:
            self._coroutine.stop()
            self._coroutine = None
        self.ratio = None
        self.component.visible = False
        return

    def runSegmentCast(self, duration, percent = 0):
        if self._coroutine:
            self._coroutine.stop()
        self._coroutine = self._cast_coroutine(duration, percent)
        self._coroutine.run()

    def interruptCast(self):
        if self._coroutine:
            self._coroutine.stop()
        self._coroutine = self._interrup_coroutine()
        self._coroutine.run()

    def runUnCast(self, duration):
        if self._coroutine:
            self._coroutine.stop()
        self._coroutine = self._uncast_coroutine(duration)
        self._coroutine.run()