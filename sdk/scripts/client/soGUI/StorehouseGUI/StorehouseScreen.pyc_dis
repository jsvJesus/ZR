class CircleNotificator:

    def __init__(self, base_comp):
        self.component = base_comp
        comp = GUI.Text(u'')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, -0.1, 0.5)
        self._text = comp
        self._count = 0
        self._hidden = False
        self._ts = TextScaler(comp, 'RobotoCondensedRegular_16')
        base_comp.addChild(comp, 'number')
        self._update_visibility()

    def do_reposition(self):
        self._ts.do_reposition()

    def set_count(self, count):
        self._count = count
        self._text.text = str(count) if count <= 9 else u'9+'
        self._update_visibility()

    def hide(self, value):
        self._hidden = value
        self._update_visibility()

    def _update_visibility(self):
        self.component.visible = self._count > 0 and not self._hidden


