    def _minimize(self):
        self._minimized = True
        self.component.maximized.visible = False
        self.component.minimized.visible = True
        self._restore_values = {'position': tuple(self.component.position),
         'width': self.component.width,
         'height': self.component.height,
         'horAnchor': self.component.horizontalAnchor,
         'vertAnchor': self.component.verticalAnchor,
         'horPozMode': self.component.horizontalPositionMode,
         'vertPosMode': self.component.verticalPositionMode,
         'widthMode': self.component.widthMode,
         'heightMode': self.component.heightMode}
        self.component.widthMode, self.component.heightMode = ('CLIP', 'CLIP')
        self.component.horizontalPositionMode, self.component.verticalPositionMode = ('CLIP', 'CLIP')
        self.component.width, self.component.height = (0.5, 0.1)
        self.component.horizontalAnchor, self.component.verticalAnchor = ('LEFT', 'BOTTOM')
        self.component.position = (-1, -1, self.component.position[2])
        self._update_transparency()

    def handleMouseButtonEvent(self, comp, event):
        if self._minimized:
            self._minimized = False
            self.component.maximized.visible = True
            self.component.minimized.visible = False
            self.component.widthMode = self._restore_values['widthMode']
            self.component.heightMode = self._restore_values['heightMode']
            self.component.horizontalAnchor = self._restore_values['horAnchor']
            self.component.verticalAnchor = self._restore_values['vertAnchor']
            self.component.horizontalPositionMode = self._restore_values['horPozMode']
            self.component.verticalPositionMode = self._restore_values['vertPosMode']
            self.component.width = self._restore_values['width']
            self.component.height = self._restore_values['height']
            self.component.position = self._restore_values['position']
            self.doReposition()
            return True
        self._update_transparency()
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def _update_transparency(self):
        if self._minimized and self._mouse_inside:
            alpha = 255
        else:
            alpha = 85
        self.component.minimized.colour[3] = alpha
        self.component.minimized.restore.colour[3] = alpha

    def doReposition(self):
        self.component.horizontalPositionMode = 'PIXEL'
        if not self._minimized:
            comp = self.component
            prev_mode = comp.heightMode
            comp.heightMode = 'PIXEL'
            pixel_height = comp.height
            comp.heightMode = prev_mode
            comp.widthMode = 'PIXEL'
            comp.width = pixel_height * 1.4
        self._minimize_button.do_reposition()
        for r in self._repositioners:
            r.do_reposition()

        comp = self._scroll_comp
        comp.heightMode = 'PIXEL'
        comp.height = self._pos_y
        self._scroll.do_reposition()
        for line in self._lines:
            line.do_reposition()

        self.onBound()

    _payed_items = []
    _got_items = []
    _delay_callback = None

    @staticmethod
    def _apply_diff_items():
        if ItemsPendWin._delay_callback:
            BigWorld.cancelCallback(ItemsPendWin._delay_callback)
            ItemsPendWin._delay_callback = None
        if ItemsPendWin._payed_items:
            BWPersonality.GUICore.itemspend_win._add_data(ItemsPendWin._payed_items)
        if ItemsPendWin._got_items:
            BWPersonality.GUICore.itemspend_win._items_added(ItemsPendWin._got_items)
        del ItemsPendWin._payed_items[:]
        del ItemsPendWin._got_items[:]
        return

    @staticmethod
    def _think_later():
        if ItemsPendWin._delay_callback:
            BigWorld.cancelCallback(ItemsPendWin._delay_callback)
        ItemsPendWin._delay_callback = BigWorld.callback(3.0, ItemsPendWin._apply_diff_items)

    @staticmethod
    def items_added(data):
        """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4 """
        if not BigWorld.auth.is_connected():
            return
        ItemsPendWin._got_items.extend(data)
        ItemsPendWin._think_later()

    @staticmethod
    def add_data(items):
        """ \xd0\xb7\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd0\xbb\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbe """
        if not BigWorld.auth.is_connected():
            return
        ItemsPendWin._payed_items.extend(items)
        ItemsPendWin._think_later()

    @staticmethod
    def on_disconnect():
        if ItemsPendWin._delay_callback:
            BigWorld.cancelCallback(ItemsPendWin._delay_callback)
            ItemsPendWin._delay_callback = None
        ItemsPendWin._payed_items[:] = []
        ItemsPendWin._got_items[:] = []
        if BWPersonality.GUICore._itemspend_win:
            BWPersonality.GUICore._itemspend_win.hide()
        return

    def _add_data(self, data):
        self._stop_wait_hide()
        self.component.visible = True
        for d in data:
            line = Line(self._pos_y, 20, d)
            self._scroll_comp.addChild(line.component)
            self._lines.append(line)
            self._pos_y += 20

        self.doReposition()

    def _items_added(self, items):
        self._stop_wait_hide()
        for item in items:
            try:
                line = next((l for l in self._lines if l.item_type == item['item_type'] and l.count == item['count'] and not l.is_marked))
                line.mark()
            except StopIteration:
                continue

        if all((l.is_marked for l in self._lines)):
            self._run_wait_hide()

    def _stop_wait_hide(self):
        if self._hide_controller_id:
            BigWorld.cancelCallback(self._hide_controller_id)
            self._hide_controller_id = None
        return

    def _run_wait_hide(self):
        self._stop_wait_hide()
        self._hide_controller_id = BigWorld.callback(5.0, self.hide)

    def handleMouseEnterEvent(self, comp):
        self._mouse_inside = True
        self._update_transparency()
        return PyGUIBase.handleMouseEnterEvent(self, comp)

    def handleMouseLeaveEvent(self, comp):
        self._mouse_inside = False
        self._update_transparency()
        return PyGUIBase.handleMouseLeaveEvent(self, comp)

    def onBound(self):
        PyGUIBase.onBound(self)
        roundComponentPos(self._minimize_button)

    def hide(self):
        self._stop_wait_hide()
        self.component.visible = False
        for line in self._lines:
            self._scroll_comp.delChild(line.component)

        self._lines = []
        self._pos_y = 20

    @property
    def visible(self):
        return self.component.visible