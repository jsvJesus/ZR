class Line:

    def __init__(self, pixel_pos_y, pixel_height, data):
        self.item_type = data['item_type']
        self.count = data['count']
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = 2, pixel_height
        comp.position = (0, pixel_pos_y, 0.5)
        comp.materialFX = 'BLEND'
        self.component = comp
        self._texts = []
        item_name = ItemsUtils.get_shop_name(self.item_type)
        comp = GUI.Text(item_name)
        comp.colour = (0, 0, 0, 255)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (-0.8, 0, 0.5)
        text = TextScaler(comp, 'RobotoCondensedRegular_16')
        self.component.addChild(comp)
        self._texts.append(text)
        count = u'{0} {1}'.format(self.count, lc('StoreHouse.penditems.COUNT'))
        comp = GUI.Text(count)
        comp.colour = (0, 0, 0, 255)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
        comp.position = (0.8, 0, 0.5)
        text = TextScaler(comp, 'RobotoCondensedRegular_16')
        self.component.addChild(comp)
        self._texts.append(text)
        comp = GUI.Simple('soGUI/frame/storehouse/check_mark.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.position = (-0.9, 0, 0.5)
        comp.materialFX = 'BLEND'
        comp.visible = False
        comp.filterType = 'LINEAR'
        self.component.addChild(comp, 'check')

    def mark(self):
        self.component.check.visible = True

    @property
    def is_marked(self):
        return self.component.check.visible

    def do_reposition(self):
        comp = self.component.check
        comp.heightMode = 'CLIP'
        comp.height = 2
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width = comp.height
        for t in self._texts:
            t.do_reposition()


