# Embedded file name: ./client/soGUI/StorehouseGUI/BinItem.py
from soGUI.StorehouseGUI.ShopUtils import AmountButton, MultilineText
from StoreHouse import getDonateItemCost
import ItemsUtils
from Helpers.PyGUI.PyGUIBase import PyGUIBase
import GUI
from soGUI.UtilsGUI.TextScaler import TextScaler
from soGUI.UtilsGUI.PaintButton import PaintButton
from Localization import lc
from utils import format_price

class BinItem(PyGUIBase):

    def __init__(self, component, item, params):
        """ \xd0\xbd\xd0\xb5\xd0\xbe\xd0\xb1\xd1\x8f\xd0\xb7\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xb0\xd1\x80\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80\xd1\x8b
                        currency - \xd0\xb2\xd0\xb0\xd0\xbb\xd1\x8e\xd1\x82\xd0\xb0
                        amount_only - \xd1\x83\xd1\x80\xd0\xb5\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xb0\xd1\x8f \xd0\xb2\xd0\xb5\xd1\x80\xd1\x81\xd0\xb8\xd1\x8f \xd0\xb1\xd0\xb5\xd0\xb7 \xd1\x86\xd0\xb5\xd0\xbd \xd0\xb8 \xd1\x81\xd0\xbe \xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd0\xba\xd0\xb8\xd0\xbc \xd0\xba\xd0\xbe\xd0\xbb\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd0\xbe\xd0\xbc
        """
        component.script = self
        self._item = item
        self._params = params
        self.on_del_item_click = lambda item: None
        self.on_count_changed_by_button = lambda item, count: None
        PyGUIBase.__init__(self, component)
        self._currency = params.get('currency') or lc('StoreHouse.bin.GOLD')
        self._repositioners = []
        self._setup_content(item)

    def _update_image(self):
        item_type = self._item['item']['item_type']
        icon_name = ItemsUtils.GetIconName(None, item_type, self._item['amount'])
        if self.component.image.textureName != icon_name:
            self.component.image.textureName = icon_name
        return

    def _setup_content(self, item):
        item_type = item['item']['item_type']
        icon_name = ItemsUtils.GetIconName(None, item_type, item['amount'])
        comp = GUI.Simple(icon_name)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'image')
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (0.9, 2)
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (-0.66, 0, 0.5)
        self.component.addChild(comp, 'name_container')
        item_name = ItemsUtils.GetItemName(item_type)
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        self._mt = MultilineText(comp, item_name, 'RobotoCondensedRegular_14', alignment='LEFT')
        self._mt.set_color((0, 0, 0, 255))
        self._repositioners.append(self._mt)
        self.component.name_container.addChild(comp, 'name')
        self._del_button = None
        if self._params.get('amount_only', False):
            comp = GUI.Text(unicode(item['amount']))
            comp.colour = (0, 0, 0, 255)
            comp.materialFX = 'BLEND'
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
            comp.width, comp.height = (0.25, 1.5)
            comp.position = (0.8, 0, 0.5)
            self._amount_button = TextScaler(comp, 'RobotoCondensedRegular_28_2')
            self._repositioners.append(self._amount_button)
            self.component.addChild(comp, 'amount_button')
        else:
            comp = GUI.Window()
            comp.materialFX = 'SOLID'
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
            comp.width, comp.height = (0.25, 1.5)
            comp.position = (0.57, 0, 0.5)
            self._amount_button = AmountButton(comp)
            self._amount_button.set_text_color((0, 0, 0, 255))
            self._amount_button.set_count(item['amount'])
            self._amount_button.on_count_changed_by_button = self._on_count_changed_by_button
            self._repositioners.append(self._amount_button)
            self.component.addChild(comp, 'amount_button')
            comp = GUI.Text(format_price(self.calc_line_cost()) + ' ' + self._currency)
            comp.colour = (0, 0, 0, 255)
            comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
            comp.width, comp.height = (0.2, 2)
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.position = (0.9, 0, 0.5)
            self._repositioners.append(TextScaler(comp, 'RobotoCondensedRegular_14'))
            self.component.addChild(comp, 'price')
            comp = GUI.Window()
            comp.materialFX = 'BLEND'
            del_button = PaintButton(comp, visual_state='soGUI/frame/storehouse/storeImageButton.xml')
            del_button.hover_sound = None
            del_button.image = 'soGUI/frame/storehouse/x.png'
            del_button.on_click = lambda : self.on_del_item_click(item)
            self.component.addChild(comp, 'delbutton')
            self._del_button = del_button
        return

    def calc_line_cost(self):
        return getDonateItemCost(self._item['item'], self._currency) * self._amount_button.count

    def _on_count_changed_by_button(self):
        cost = self.calc_line_cost()
        self.component.price.text = format_price(cost) + ' ' + self._currency
        self.on_count_changed_by_button(self._item, self._amount_button.count)
        self._update_image()

    def do_reposition(self):
        comp = self.component.image
        comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
        comp.height = 1.8
        comp.heightMode = 'PIXEL'
        comp.width = comp.height
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (-0.9, 0, 0.5)
        if self._del_button:
            comp = self._del_button.component
            comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
            comp.height = 0.3
            comp.heightMode = 'PIXEL'
            comp.width = comp.height
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.position = (1.0, 0, 0.5)
            comp.script.do_reposition()
        comp = self._mt.component
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (-1, 0, 0.5)
        for r in self._repositioners:
            r.do_reposition()

        comp.heightMode = 'PIXEL'
        comp.height = self._mt.height
        comp.heightMode = 'CLIP'