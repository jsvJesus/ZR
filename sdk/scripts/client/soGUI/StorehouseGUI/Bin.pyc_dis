        self._repositioners = []
        self._items = {}
        self._lines = []
        self._total_cost = 0
        self._currency = None
        self._setup_content()
        self._oneshot_bought_message = None
        if 'notificator' in self._params:
            self._params['notificator'].set_count(self.items_count)
        return

