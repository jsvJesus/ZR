        base_comp.position = (0, 0.96, 0.5)
        base_comp.materialFX = 'SOLID'
        self.component.field.addChild(base_comp, 'scroll_base')
        self._scroll_comp = GUI.Window()
        self._scroll_comp.materialFX = 'SOLID'
