    def _on_del_item_click(self, item):
        del self._items[item['item']['item_type']]
        self._redraw_items()

    def _on_count_changed_by_button(self, item, count):
        self._items[item['item']['item_type']]['amount'] = count
        self._update_total_cost()

    def _update_total_cost(self):
        self._total_cost = sum((line.calc_line_cost() for line in self._lines))
        if not self._currency:
            currency = lc('StoreHouse.bin.GOLD')
            if self._total_text:
                self._total_text.text = lc('StoreHouse.bin.TOTAL').format(format_price(self._total_cost), currency)
            'notificator' in self._params and self._params['notificator'].set_count(self.items_count)

    def add_item(self, amount, item):
        item_type = item['item_type']
        if item_type in self._items:
            self._items[item_type]['amount'] += amount
        else:
            self._items[item_type] = {'amount': amount,
             'item': item}
        if 'notificator' in self._params:
            self._params['notificator'].set_count(self.items_count)

    def clear_items(self):
        self._items = {}
        if 'notificator' in self._params:
            self._params['notificator'].set_count(self.items_count)

    def _redraw_items(self):
        self._lines = []
        for child_name, _ in self._scroll_comp.children:
            self._scroll_comp.delChild(child_name)

        for i, item in enumerate(self._items.values()):
            comp = GUI.Window()
            comp.materialFX = 'SOLID'
            params = {'currency': self._currency,
             'amount_only': self._params.get('amount_only', False)}
            bin_item = BinItem(comp, item, params)
            bin_item.on_del_item_click = self._on_del_item_click
            bin_item.on_count_changed_by_button = self._on_count_changed_by_button
            self._lines.append(bin_item)
            self._scroll_comp.addChild(comp, 'item' + str(i))

        if not self._params.get('amount_only', False):
            self._update_total_cost()
        self.do_reposition()

    def _on_buy_click(self):
        if self._total_cost == 0:
            return

        def on_buy_complete(code):
            if self._buy_button:
                self._buy_button.enabled = True
            if code == CODES.NOT_ENOUGH_GOLD:
                MessageWin.shop_instance.show_double_orange_buttons(lc('StoreHouse.bin.NOT_ENOUGH_GOLD').format(self._needed_money), lc('StoreHouse.bin.REFUSE'), lc('StoreHouse.bin.REFILL'), orange_click_callback=self._on_web_payment_click)
                return
            if code == CODES.NOT_ENOUGH_PLATINA:
                MessageWin.shop_instance.show_single_button(lc('StoreHouse.bin.NOT_ENOUGH_PLATINA').format(self._needed_platina), lc('StoreHouse.bin.OK'))
                return
            if code == CODES.STORE_HOUSE_TAKE_NOT_FREE_SPACE:
                MessageWin.shop_instance.show_single_button(lc('StoreHouse.bin.NOT_ENOUGH_SPACE'), lc('StoreHouse.bin.OK'))
                return
            if code in [CODES.BUY_STEAM_OK,
             CODES.ERROR_BUY_STEAM,
             CODES.OK,
             CODES.BUY_DONATE_OK]:
                self._items.clear()
                self._redraw_items()
                self._update_total_cost()
                self.on_bin_try_close_callback()
                if code in [CODES.OK, CODES.BUY_DONATE_OK, CODES.BUY_STEAM_OK]:
                    bought_message, callback = self._get_oneshot_bought_message()
                    if not bought_message:
                        bought_message = lc('StoreHouse.bin.BOUGHT')
                    MessageWin.shop_instance.show_single_button(bought_message, lc('StoreHouse.bin.OK'), callback=callback)
                    BWPersonality.GUICore.on_item_payed(to_server)
                else:
                    MessageWin.shop_instance.show_single_button(CODES.getText(code), lc('StoreHouse.bin.OK'))
                return
            MessageWin.shop_instance.show_single_button(CODES.getText(code), lc('StoreHouse.bin.OK'))

        def on_buy_agree():
            for item_type, item in self._items.items():
                data = {'item_type': item_type,
                 'count': item['amount']}
                to_server.append(data)

            if self._buy_button:
                self._buy_button.enabled = False
            self.on_buy_click(to_server, self._total_cost, on_buy_complete)

        to_server = []
        MessageWin.shop_instance.show_double_buttons(lc('StoreHouse.bin.SURE_BUY'), lc('StoreHouse.bin.CANCEL'), lc('StoreHouse.bin.COMMIT_BUY'), right_click_callback=on_buy_agree)

    def set_oneshot_bought_message(self, text, callback = None):
        self._oneshot_bought_message = (text, callback)

    def _get_oneshot_bought_message(self):
        if self._oneshot_bought_message:
            text, callback = self._oneshot_bought_message
            self._oneshot_bought_message = None
            return (text, callback)
        else:
            return (None, None)
            return

    @property
    def _needed_money(self):
        return self._total_cost - BigWorld.player().gold

    @property
    def _needed_platina(self):
        return self._total_cost - BigWorld.player().current_platina

    def _on_web_payment_click(self):
        if self._needed_money <= 0:
            raise RuntimeError
        BigWorld.player().openWebPayment(self._needed_money)

    def show(self, currency = None):
        if self.visible:
            return
        self._currency = currency
        self.component.visible = True
        if self._buy_button:
            self._buy_button.enabled = True
        self._redraw_items()

    def hide(self):
        if not self.visible:
            return
        self.component.visible = False

    @property
    def items_count(self):
        return sum((item['amount'] for item in self._items.values()))

    @property
    def visible(self):
        return self.component.visible

    def do_reposition(self):
        for r in self._repositioners:
            r.do_reposition()

        comp = self.component.field.scroll_base
        comp.widthMode = 'CLIP'
        comp.width = 2
        comp.widthMode = 'PIXEL'
        line_width = comp.width
        line_height = line_width * 0.11
        for i, line in enumerate(self._lines):
            comp = line.component
            comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
            comp.width, comp.height = 1.9, line_height
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.position = (-1, line_height * i, 0.5)
            comp.script.do_reposition()

        comp = self._scroll_comp
        comp.heightMode = 'PIXEL'
        comp.height = line_height * len(self._items)
        self._scroll.do_reposition()