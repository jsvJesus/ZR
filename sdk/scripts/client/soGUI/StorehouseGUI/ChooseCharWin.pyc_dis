        """
        from Account import Account
        if not ChooseCharWin._instance:
            ChooseCharWin._instance = ChooseCharWin(parent_component)
        self = ChooseCharWin._instance
        if self.component.parent != parent_component:
            if self.component.parent:
                self.component.parent.delChild(self.component)
            if parent_component:
                parent_component.addChild(self.component)
        self.component.visible = True
        self.component.colour = background_color
        self._chose_callback = choose_callback
        self._cancel_callback = cancel_callback
        for b in self._char_buttons:
            b.component.visible = False

        for i, (char_name, db_id, space_name) in enumerate(Account.char_list_cache):
            space_id = getattr(BigWorld.player(), 'spaceID', None)
            if space_id:
                override_space_name = getattr(BigWorld.player(), 'get_space_name', lambda space_id: None)(space_id)
                if override_space_name:
                    space_name = override_space_name
            lock_tutorial = not space_name or space_name in TutorialUtils.TUTORIAL_SPACES
            button = self._char_buttons[i]
            button.component.visible = True
            button.set_text(char_name)
            button.on_click = partial(self._on_char_click, db_id, char_name, lock_tutorial)

        self.do_reposition()
        return

    @staticmethod
    def hide_all_instances():
        if ChooseCharWin._instance:
            ChooseCharWin._instance.hide()