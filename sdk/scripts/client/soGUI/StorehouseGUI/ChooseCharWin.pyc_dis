    def do_reposition(self):
        ratio = 1.2
        comp = self.component.content
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'CLIP')
        comp.height = 0.7
        comp.heightMode = 'PIXEL'
        comp.width = comp.height * ratio
        comp.position = (0, 0.1, 0.5)
        self._title.do_reposition()
        for r in self._repositioners:
            r.transform.apply_mode()

    def _on_cancel_click(self):
        callback = self._cancel_callback
        self.hide()
        if callback:
            callback()

    def onParentSizeChanged(self, component):
        self.do_reposition()

    def _on_char_click(self, db_id, char_name, lock_tutorial):
        callback = self._chose_callback
        self.hide()
        callback(db_id, char_name, lock_tutorial)

    def hide(self):
        self.component.visible = False
        self._chose_callback = None
        self._cancel_callback = None
        return

    @staticmethod
