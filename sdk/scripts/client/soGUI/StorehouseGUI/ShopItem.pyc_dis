        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (1.9, 0.2)
        comp.position = (0, -0.4, 0.5)
        comp.colour = (200, 130, 0, 255)
        self.component.action_panel.addChild(comp, 'sale_price')
        self._repositioners.append(self._sale_price)

    def _setup_store_content(self):
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (1.9, 0.3)
        comp.position = (-0.95, -0.6, 0.5)
        comp.visible = False
        self._use_button = PaintButton(comp, visual_state='soGUI/frame/storehouse/smallStoreButton.xml')
        self._use_button.text = lc('StoreHouse.shopitem.USE')
        self._use_button.on_click = self._on_use_click
        self.component.addChild(comp, 'usebutton')
        self._repositioners.append(self._use_button)
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (1.9, 0.3)
        comp.position = (-0.95, -0.95, 0.5)
        self._take_button = PaintButton(comp, visual_state='soGUI/frame/storehouse/smallStoreButton.xml')
        self._take_button.text = lc('StoreHouse.shopitem.TAKE')
        self._take_button.on_click = self._on_take_click
        self.component.addChild(comp, 'takebutton')
        self._repositioners.append(self._take_button)

    def _on_take_click(self):
        self.take_click_callback(self._item['complexItemID'])
        self.component.takebutton.script.enabled = False

    def _on_use_click(self):

        def accept():
            self.use_click_callback(self._item['complexItemID'])
            self.component.usebutton.script.enabled = False

        item_type = self._item['complexItemType']
        item_param = ItemsCatalog.GetItemParam(item_type)
        booster_id = item_param.get('Booster_id')
        if booster_id and BigWorld.player().get_boost_id():
            MessageWin.shop_instance.show_double_buttons(lc('StoreHouse.shopitem.BOOSTWARNING'), lc('StoreHouse.shopitem.OK'), lc('StoreHouse.shopitem.CANCEL'), left_click_callback=accept)
        elif ItemsUtils.canTakeStoreHouseItemToAvatar(item_type):
            win_component = BWPersonality.GUICore.storehouse_screen.component
            ChooseCharWin.show(win_component, self._char_pick_click)
        else:
            accept()

    def _char_pick_click(self, db_id, char_name, lock_tutorial):
        if db_id is None:
            return
        elif lock_tutorial:
            MessageWin.shop_instance.show_single_button(lc('StoreHouse.moveitem.LOCKTUTOR'), lc('StoreHouse.shopitem.OK'))
            return
        else:

            def accept():
                self.put_to_inventory_click_callback(self._item['complexItemID'], db_id)
                self.component.usebutton.script.enabled = False

            text = lc('StoreHouse.moveitem.CONFIRM').format(char_name)
            MessageWin.shop_instance.show_double_buttons(text, lc('StoreHouse.shopitem.OK'), lc('StoreHouse.shopitem.CANCEL'), left_click_callback=accept)
            return

    def _setup_item_desc_content(self, mode):
        comp = GUI.Window()
        item_desc = ShopItemDesc(comp, mode)
        item_desc.on_click = self._on_desc_click
        self.component.addChild(comp, 'item_desc')
        self._repositioners.append(item_desc)

    def _on_desc_click(self):
        InfoWin.instance.show(self._item_type, self._complex_button)

    def _bin_click(self):
        if self._complex_button.count == 0:
            return
        screen_pos = self.component.item_desc.script.icon_pos
        self.bin_click_callback(self._complex_button.count, self._item, screen_pos)
        self.component.item_desc.script.twinkle()

    def _update_sale(self):
        cur_time = BWPersonality.gpd.server_time
        self.sale = self._item['promo_time_start'] <= cur_time <= self._item['promo_time_end']
        if self.sale:
            sale_percent = self._item['promo_discount']
            donat_cost = float(getDonateItemCost(self._item, self._currency))
            text_price = format_price(donat_cost) + ' ' + self._local_name(self._currency)
            self._sale_price.component.text = text_price
            self._action_text.set_text(u'-{0}%'.format(sale_percent))

    def tick(self):
        self._update_sale()

    def set_lock(self, lock):
        if self._take_button:
            self._take_button.enabled = not lock

    def do_reposition(self):
        if self._mode == ShopUtils.SHOP_MODE:
            ratio = 1.2
        elif self._mode == ShopUtils.STORE_MODE:
            ratio = 1.3
        comp = self.component.item_desc
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width = 2
        comp.widthMode = 'PIXEL'
        comp.height = comp.width * ratio
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 1, 0.5)
        for r in self._repositioners:
            r.do_reposition()

        if self._mode == ShopUtils.SHOP_MODE:
            self._sales_back.height = self._action_text.height
            self._sales_back.width = self._sales_back.height * self._sales_back_ratio
            comp = self.component.action_panel.sale_cross
            comp.heightMode = 'PIXEL'
            comp.width = comp.height * comp.texture.width / comp.texture.height
            comp.heightMode = 'CLIP'
            comp = self.component.action_panel.timer
            comp.widthMode = 'PIXEL'
            comp.height = comp.width * comp.texture.height / comp.texture.width
            comp.widthMode = 'CLIP'