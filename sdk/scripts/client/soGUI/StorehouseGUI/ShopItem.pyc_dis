        self._complex_button = ComplexAmountButton(comp)
        self._complex_button.text = lc('StoreHouse.shopitem.TO_BIN')
        self._complex_button.on_click = self._bin_click
        self._complex_button.on_amount_changed_callback = self._on_amount_changed
        self.component.addChild(comp, 'buybutton')
        self._repositioners.append(self._complex_button)
        btn_comp = comp
        comp = GUI.Window('soGUI/frame/storehouse/garant.dds')
