# Embedded file name: ./client/soGUI/StorehouseGUI/BalanceBtn.py
import BWPersonality
import GUI
from soGUI.UtilsGUI.TextScaler import TextScaler
from Localization import lc
import BigWorld
from soGUI.UtilsGUI.PaintButton import PaintButton
from Helpers.PyGUI.PyGUIBase import Interceptor
import steam_client_api
import StoreHouseConst

class BalanceButton(PaintButton):

    def handleMouseEnterEvent(self, comp):
        BWPersonality.GUICore.showToolTip(lc('StoreHouse.mainscreen.SWAP'), gui_layer=BWPersonality.GUICore.generalLayer)
        return PaintButton.handleMouseEnterEvent(self, comp)

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip()
        return PaintButton.handleMouseLeaveEvent(self, comp)


class Tooltiper(Interceptor):

    def __init__(self, component):
        Interceptor.__init__(self, component)
        self.text = lc('StoreHouse.mainscreen.GOLD')

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip()
        return Interceptor.handleMouseLeaveEvent(self, comp)

    def handleMouseEnterEvent(self, comp):
        if self.text:
            BWPersonality.GUICore.showToolTip(self.text, gui_layer=BWPersonality.GUICore.generalLayer)
        return Interceptor.handleMouseEnterEvent(self, comp)


class LockKeys:
    Mode, Pend = range(2)


class BalanceBtn:

    def __init__(self, comp):
        self.component = comp
        self._repositioners = []
        self._lock_keys = set()
        self._unlock_handler = None
        self.on_switch_request_callback = lambda : None
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (0, 0, 0.5)
        pb = BalanceButton(comp, visual_state='soGUI/frame/paint/paintImageButton2.xml')
        pb.image = 'soGUI/frame/storehouse/switching.dds'
        pb.on_click = self._on_swap_click
        comp.width, comp.height = comp.image.width, comp.image.height
        self._repositioners.append(pb)
        self.component.addChild(comp, 'switch')
        comp = GUI.Text(u'')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (self.component.switch.width + 4, 0, 0.5)
        self.component.addChild(comp, 'balance_text')
        self._repositioners.append(TextScaler(comp, 'RobotoCondensedRegular_18'))
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (16, 16)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'coin')
        comp = GUI.Text(u'')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'price_text')
        TextScaler(comp, 'RobotoCondensedRegular_18')
        self._repositioners.append(TextScaler(comp, 'RobotoCondensedRegular_18'))
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (1, 0, 0.1)
        comp.width, comp.height = (1, 2)
        self.component.addChild(comp)
        self._tooltiper = Tooltiper(comp)
        return

    def lock_swap(self, lock):
        if lock:
            self._lock_keys.add(LockKeys.Mode)
        elif LockKeys.Mode in self._lock_keys:
            self._lock_keys.remove(LockKeys.Mode)
        self._update_lock()

    def _on_swap_click(self):

        def _unlock_pend():
            if LockKeys.Pend in self._lock_keys:
                self._lock_keys.remove(LockKeys.Pend)
            self._update_lock()

        self._lock_keys.add(LockKeys.Pend)
        self._unlock_handler = BigWorld.callback(0.5, _unlock_pend)
        self._update_lock()
        self.on_switch_request_callback()

    def _update_lock(self):
        self.component.switch.script.enabled = not self._lock_keys

    def update(self, currency):
        is_partner = bool(BigWorld.player().partner_id)
        self.component.switch.visible = is_partner
        self.component.price_text.visible = True
        self.component.coin.visible = True
        self.component.visible = True
        if currency == StoreHouseConst.CURRENCY_PLATINA_NAME and is_partner:
            self.component.price_text.text = unicode(BigWorld.player().current_platina)
            self.component.price_text.colour = (207, 219, 255, 255)
            self.component.coin.textureName = 'soGUI/frame/storehouse/platinumcoin.dds'
            self._tooltiper.text = lc('StoreHouse.mainscreen.PLATINA')
            self.component.balance_text.text = lc('StoreHouse.mainscreen.BALANCE')
        elif not BigWorld.auth.isGoldAcc():
            if is_partner:
                self.component.price_text.visible = False
                self.component.coin.visible = False
                self._tooltiper.text = None
                self.component.balance_text.text = lc('StoreHouse.mainscreen.CHANGE_CURRENCY')
            else:
                self.component.visible = False
        else:
            self.component.price_text.text = unicode(BigWorld.player().gold)
            self.component.price_text.colour = (255, 198, 0, 255)
            self.component.coin.textureName = 'soGUI/frame/storehouse/goldcoin.dds'
            self._tooltiper.text = lc('StoreHouse.mainscreen.GOLD')
            self.component.balance_text.text = lc('StoreHouse.mainscreen.BALANCE')
        self.do_reposition()
        return

    def on_hide(self):
        BWPersonality.GUICore.hideToolTip()

    def do_reposition(self):
        for r in self._repositioners:
            r.do_reposition()

        comp = self.component.balance_text
        width = comp.stringWidth(comp.text)
        pos_x = comp.position[0] + width
        comp = self.component.coin
        comp.position[0] = pos_x + 2
        pos_x = comp.position[0] + comp.width
        comp = self.component.price_text
        comp.position[0] = pos_x + 2