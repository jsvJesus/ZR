# Embedded file name: ./client/soGUI/pda_ui/noanomaly_block.py
import GUI
import BigWorld
import math_bw
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
from utils import Listenable

class LockMode:
    Locked, Unlocked, Prepare = range(3)


class EventType:
    OnLockChanged, = ((r, 'noanomaly_block') for r in range(1))


class NoAnomalyBlock(Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        self._component = component
        self._setup_content()
        self._coroutine_handler = None
        self._alpha = 1
        self._reset()
        return

    def _setup_content(self):
        comp = GUI.Window('soGUI/frame/pda/search/search.texanim')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (82, 86, 0.1)
        comp.filterType = 'LINEAR'
        comp.materialFX = 'BLEND'
        self._component.addChild(comp)

    def fade(self, show):
        self._needed_alpha = 1 if show else 0
        if self._needed_alpha != self._alpha and self._coroutine_handler == None:
            self._coroutine_handler = self._fade_coroutine()
            self._coroutine_handler.run()
        return

    @BWMemberCoroutine
    def _fade_coroutine(self):
        while self.alpha != self._needed_alpha:
            self.alpha = math_bw.move_towards(self.alpha, self._needed_alpha, BigWorld.getTimeDelta())
            yield BWWaitForPeriod(0)

        self._coroutine_handler = None
        return

    def on_show(self):
        self._reset()

    def on_hide(self):
        self._reset()

    def _reset(self):
        self.alpha = 1
        self._needed_alpha = 1
        if self._coroutine_handler:
            self._coroutine_handler.stop()
            self._coroutine_handler = None
        return

    @property
    def lock_mode(self):
        if self.alpha == 0:
            return LockMode.Unlocked
        if self.alpha == 1:
            return LockMode.Locked
        return LockMode.Prepare

    @property
    def alpha(self):
        return self._alpha

    @alpha.setter
    def alpha(self, value):
        prev_mode = self.lock_mode
        self._alpha = value

        def set_recursive_alpha(alpha, component):
            component.colour[3] = alpha
            for _, child in component.children:
                set_recursive_alpha(alpha, child)

        set_recursive_alpha(self._alpha * 255.0, self._component)
        self._component.visible = self._alpha > 0
        if self.lock_mode != prev_mode:
            data = (self.lock_mode, prev_mode)
            self.notify_listeners(EventType.OnLockChanged, data)