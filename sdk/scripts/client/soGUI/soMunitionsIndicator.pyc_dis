    def stopDragging(self):
        GUIPositions.stopDragging(self)
        DraggableComponent.stopDragging(self)

    def handleMouseButtonEvent(self, comp, event):
        if not event.isMouseButton():
            return False
        down = event.isKeyDown()
        key = event.key
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def update(self):
        data = BWPersonality.GUICore.munitionsDataSection
        if data is None:
            return
        else:
            kb = BWPersonality.settings.keyBindings
            if data.has_key('primary_name'):
                self.component.pLabel.text = data['primary_name'] + ' [{0}]'.format(kb.getKeyBindForAction('PrimaryWeapon'))
            if data.has_key('primary2_name'):
                self.component.p2Label.text = data['primary2_name'] + ' [{0}]'.format(kb.getKeyBindForAction('Primary2Weapon'))
            if data.has_key('secondary_name'):
                self.component.sLabel.text = data['secondary_name'] + ' [{0}]'.format(kb.getKeyBindForAction('SecondaryWeapon'))
            if data.has_key('primary_count'):
                self.component.pCount.text = data['primary_count']
            if data.has_key('primary2_count'):
                self.component.p2Count.text = data['primary2_count']
            if data.has_key('secondary_count'):
                self.component.sCount.text = data['secondary_count']
            if data.has_key('all_primary_ammo'):
                self.component.pAllCount.text = data['all_primary_ammo']
            if data.has_key('all_primary2_ammo'):
                self.component.p2AllCount.text = data['all_primary2_ammo']
            if data.has_key('all_secondary_ammo'):
                self.component.sAllCount.text = data['all_secondary_ammo']
            if data.has_key('weight'):
                self.component.weight.text = u'{0:.1f}/{1:.1f} {2}'.format(data['weight'][0], data['weight'][1], lc('GUI.MunitionsGUI.WEIGHT'))
            if data.get('grenades_data'):
                gcount, gtype = data['grenades_data']['count'], data['grenades_data']['type']
                self.component.grenadeCount.text = unicode(gcount)
                item_name = ItemsUtils.GetItemName(gtype, fGetShortName=True)
                keybind = kb.getKeyBindForAction('ThrowGrenade')
                self.component.grenadeText.text = u'{0} [{1}]'.format(item_name, keybind)
            else:
                self.component.grenadeCount.text = u'-'
                self.component.grenadeText.text = u''
            if data.has_key('ShootingMode'):
                sm = data['ShootingMode']
                if sm in self._shooting_icons:
                    self.component.fireType.texture = self._shooting_icons[sm]
                    comp = self.component.fireType
                    comp.width, comp.height = comp.texture.width, comp.texture.height
                    self.component.fireType.visible = True
                else:
                    self.component.fireType.visible = False
            for comp in chain(*self._slot_lists.values()):
                comp.colour = INACTIVE_COLOR

            if self._throwing:
                self.component.throwIcon.colour = ACTIVE_COLOR
                self.component.grenadeCount.colour = ACTIVE_COLOR
                self.component.grenadeText.colour = ACTIVE_COLOR
            else:
                self.component.throwIcon.colour = INACTIVE_COLOR
                self.component.grenadeCount.colour = INACTIVE_COLOR
                self.component.grenadeText.colour = INACTIVE_COLOR
                for comp in self._slot_lists.get(data.get('active_slot_name'), []):
                    comp.colour = ACTIVE_COLOR

            return

    def updatePingAndFPS(self):
        if not self._need_update_ping_and_fps:
            return
        BigWorld.callback(self.UPDATE_TIME_INTERVAL, self.updatePingAndFPS)
        pl = BigWorld.player()
        if pl and pl.__class__.__name__ != 'PlayerAvatar':
            return
        if self.component.fpsLabel.visible:
            self.component.fpsLabel.text = u'FPS: %0.1f' % float(BigWorld.fps())
        if self.component.pingLabel.visible:
            lp = BigWorld.LatencyInfo().value
            self.component.pingLabel.text = u'ping: %0.0fms' % (lp[3] * 1000)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'munitionsGUI')
        GUIPositions.show(self)
        self.component.visible = True
        return

    def on_grenade_start_throw(self):

        def wait_until_stop_throw():
            try:
                self._throwing = BigWorld.player().is_throwing
            except:
                self._throwing = False

            if not self._throwing:
                self.update()
                return
            BigWorld.callback(0.1, wait_until_stop_throw)

        self._throwing = True
        self.update()
        wait_until_stop_throw()

    def hide(self):
        self.component.visible = False