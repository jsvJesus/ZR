        self.setupRoot()
        self.setupContent()
        self.doReposition()
        BigWorld.callback(self.UPDATE_TIME_INTERVAL, self.updatePingAndFPS)

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (0, 0, 0, 80)
        cmp.materialFX = 'BLEND'
        cmp.width = 380
        cmp.height = 138
        sW, sH = BigWorld.screenSize()
        x, y = sW - 3, sH - 80
        x, y = pixels_to_clip((x, y))
        cmp.position = (x, y, 0.9)

    def reset_position(self):
        sW, sH = BigWorld.screenSize()
        x, y = sW - 3, sH - 80
        x, y = pixels_to_clip((x, y))
        self.component.position = (x, y, 0.9)

