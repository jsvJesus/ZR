# Embedded file name: ./client/soGUI/soToolTipComponent.py
import GUI
import BigWorld
import BWPersonality
from Helpers.BWCoroutine import *
from Helpers.PyGUI import PyGUIBase

class soToolTipComponent(object):
    EVENT_SHOW = 0
    EVENT_HIDE = 1

    def __init__(self, component, id, iid = None):
        component.script = self
        component.crossFocus = True
        self.toolTipID = id
        self.interfaceID = iid

    def handleMouseEnterEvent(self, comp):
        BWPersonality.GUICore.toolTipEvent(self.toolTipID, self.interfaceID, soToolTipComponent.EVENT_SHOW)
        return True

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.toolTipEvent(self.toolTipID, self.interfaceID, soToolTipComponent.EVENT_HIDE)
        return True


from soGUI.soTextField import soTextField3

class soToolTipWindow(PyGUIBase):
    factoryString = 'soGUI.soToolTipWindow'
    STYLE_FIXED = 0
    STYLE_CURSOR = 1
    STYLE_FIXED_FROM_CURSOR = 2

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.renderStyle = self.STYLE_CURSOR
        self.toolTipID = None
        self.delayer = None
        self.delayerStop = None
        self.follower = None
        self.setupRoot()
        self.setupContent()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 0
        cmp.height = 0
        cmp.position = (0, 0, 0.05)

    def setupContent(self):
        txt = soTextField3(GUI.Window(), width=300, height=100, textWidth=-1, hScroll=False, vScroll=False, hideScroll=False, borderWidth=0, vOffset=0, hOffset=0, textureless=True, autosize=True)
        txt.DEFAULT_FONT = 'RobotoCondensedRegular_16.font'
        cmp = txt.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (11, 11, 0.2)
        self.component.addChild(cmp, 'ttText')
        txt.onBound()
        cmp = GUI.Frame2('soGUI/frame/frame_tooltip.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.width = cmp.height = 2.0
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp, 'dFrame')

    def setData(self, data):
        self.component.ttText.script.setText(data)
        self._updateDims()

    def setStyle(self, style):
        self.renderStyle = style
        self._checkFollower()

    def _checkFollower(self):
        if self.renderStyle is self.STYLE_CURSOR:
            if self.follower is None:
                self.follower = self.followCursor()
                self.follower.run()
        elif self.renderStyle is self.STYLE_FIXED:
            if self.follower:
                self.follower.stop()
                self.follower = None
            self.fixToolTip()
        elif self.renderStyle is self.STYLE_FIXED_FROM_CURSOR:
            if self.follower:
                self.follower.stop()
                self.follower = None
            self.fixToolTipFromCursor()
        return

    def fixToolTip(self):
        self.component.horizontalAnchor = 'RIGHT'
        self.component.verticalAnchor = 'BOTTOM'
        self.component.position = (0.95, -0.95, 0.05)

    def fixToolTipFromCursor(self):
        self.component.horizontalAnchor = 'RIGHT'
        self.component.verticalAnchor = 'BOTTOM'
        mouseX, mouseY = GUI.mcursor().position
        self.component.position = (mouseX, mouseY, 0.0)
        self._checkIntersections()

    def _updateDims(self):
        self.component.width = self.component.ttText.width + 22
        self.component.height = self.component.ttText.height + 22

    def show(self, delay = 1.0, delayStop = None, gui_layer = None, toolTipID = None):
        if not gui_layer:
            gui_layer = BWPersonality.GUICore.worldLayer
            if self.component.parent and self.component.parent is not gui_layer:
                self.component.parent.delChild(self.component)
            if not self.component.parent:
                gui_layer.addChild(self.component, 'TTWindow')
            if self.delayer:
                self.delayer.stop()
                self.delayer = None
            if self.delayerStop:
                self.delayerStop.stop()
                self.delayerStop = None
            if not delay:
                self.component.ttText.script.renderText()
                self.component.visible = True
            else:
                self.delayer = self.delayedShow(delay)
                self.delayer.run()
            self.delayerStop = delayStop and self.delayedHide(delayStop)
            self.delayerStop.run()
        self.toolTipID = toolTipID
        self._checkFollower()
        BWPersonality.GUICore.setBestCursor()
        return

    def hide(self, toolTipID = None):
        if toolTipID and self.toolTipID and self.toolTipID != toolTipID:
            return
        else:
            if self.delayer:
                self.delayer.stop()
                self.delayer = None
            self.component.visible = False
            if self.follower:
                self.follower.stop()
                self.follower = None
            if self.delayerStop:
                self.delayerStop.stop()
                self.delayerStop = None
            return

    def _checkIntersections(self):
        sW, sH = BigWorld.screenSize()
        relW = 2.0 / (sW / self.component.width)
        relH = 2.0 / (sH / self.component.height)
        hOffset = 0.0
        if self.component.position.x + relW > 1.0:
            if self.component.position.x - relW < -1.0:
                hOffset = self.component.position.x + relW - 1.0
                self.component.horizontalAnchor = 'LEFT'
            else:
                self.component.horizontalAnchor = 'RIGHT'
        else:
            self.component.horizontalAnchor = 'LEFT'
        if self.component.position.y - relH < -1.0:
            self.component.verticalAnchor = 'BOTTOM'
        else:
            self.component.verticalAnchor = 'TOP'
        self.component.position.x -= hOffset

    @BWMemberCoroutine
    def delayedShow(self, delay):
        yield BWWaitForPeriod(delay)
        self.component.visible = True
        self.delayer = None
        return

    @BWMemberCoroutine
    def delayedHide(self, delay):
        yield BWWaitForPeriod(delay)
        self.delayerStop = None
        self.hide()
        return

    @BWMemberCoroutine
    def followCursor(self):
        while self.renderStyle is self.STYLE_CURSOR:
            mouseX, mouseY = GUI.mcursor().position
            self.component.position = (mouseX, mouseY, 0.0)
            yield BWWaitForPeriod(0.01)
            self._checkIntersections()

        self.follower = None
        return