def get_base_line(font_name):
    return _base_lines.get(font_name)


def get_height(font_name):
    return _heights.get(font_name)


def get_nearest_roboto_font(size):
    pos = bisect_left(_roboto_fonts, size)
    if pos == 0:
        size = _roboto_fonts[0]
    elif pos == len(_roboto_fonts):
        size = _roboto_fonts[-1]
    else:
        left, right = _roboto_fonts[pos - 1], _roboto_fonts[pos]
        size = left if abs(left - size) <= abs(right - size) else right
    return 'RobotoCondensedRegular_{0}.font'.format(size)


class TextScaler:
    """ \xd0\xbc\xd0\xb0\xd1\x81\xd1\x88\xd1\x82\xd0\xb0\xd0\xb1\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82 \xd0\xb2 \xd0\xb7\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x81\xd0\xb8\xd0\xbc\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xbe\xd1\x82 \xd1\x80\xd0\xb0\xd0\xb7\xd1\x80\xd0\xb5\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0
    """

    def __init__(self, text_component, config_name):
        self._config = configs[config_name]
        self.component = text_component

    def do_reposition(self):
        height = BigWorld.screenHeight()
        for i, screen_size in enumerate(self._config['screen']):
            if height < screen_size:
                self.component.font = self._config['fonts'][i]
                break
        else:
            self.component.font = self._config['fonts'][-1]


class Text3Scaler(TextScaler):
    """ \xd0\xbc\xd0\xb0\xd1\x81\xd1\x88\xd1\x82\xd0\xb0\xd0\xb1\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 soTextField3 \xd0\xb2 \xd0\xb7\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x81\xd0\xb8\xd0\xbc\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xbe\xd1\x82 \xd1\x80\xd0\xb0\xd0\xb7\xd1\x80\xd0\xb5\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0
    """

    def do_reposition(self):
        height = BigWorld.screenHeight()
        for i, screen_size in enumerate(self._config['screen']):
            if height < screen_size:
                self.component.DEFAULT_FONT = self._config['fonts'][i]
                break
        else:
            self.component.DEFAULT_FONT = self._config['fonts'][-1]