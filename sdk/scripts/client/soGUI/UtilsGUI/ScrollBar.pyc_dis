# Embedded file name: ./client/soGUI/UtilsGUI/ScrollBar.py
import GUI
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from Helpers.PyGUI.DraggableComponent import DraggableComponent

class Bar(PyGUIBase, DraggableComponent):

    def __init__(self, component, height):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, False, True, True)
        component.script = self
        self.height = height
        self.onDragging = self._on_pos_changed
        self.on_position_changed = lambda pos: None
        self.position = 1.0
        self._locked = True

    def set_limits(self, limits):
        self._limits = limits
        self._update_limits()

    def set_height(self, height):
        self.height = height
        self._update_limits()

    def _update_limits(self):
        self._max_pos = self._limits[0]
        self._min_pos = self._limits[1] + self.height

    def handleMouseButtonEvent(self, comp, event):
        if self._locked:
            return True
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def _on_pos_changed(self):
        self.position = 1.0 - (self.component.position[1] - self._min_pos) / (self._max_pos - self._min_pos)
        if self.position > 1:
            self.position = 1
            self.component.position[1] = self._min_pos
        if self.position < 0:
            self.position = 0
            self.component.position[1] = self._max_pos
        self.on_position_changed(self.position)

    def scroll(self, dz):
        if self._locked:
            return
        self.component.position[1] += dz * 0.001
        self._on_pos_changed()

    def lock(self, lock):
        self._locked = lock


class ScrollBar(PyGUIBase):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xba\xd1\x80\xd1\x83\xd1\x87\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd0\xbc\xd0\xbe\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe
            \xd0\xb2\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c do_reposition \xd1\x80\xd1\x83\xd0\xba\xd0\xb0\xd0\xbc\xd0\xb8
    """

    def __init__(self, base_component, scroll_component, bar_component, side_mode):
        """ side_mode - \xd1\x81 \xd0\xba\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb9 \xd1\x81\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbd\xd1\x8b \xd0\xba\xd1\x80\xd1\x83\xd1\x82\xd0\xb8\xd0\xbb\xd0\xba\xd0\xb0
                        True - \xd1\x81\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xb0
                        False - \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb2\xd0\xb0
        """
        PyGUIBase.__init__(self, base_component)
        self.position_changed_callback = lambda pixel_position: None
        self.component.script = self
        self.component.moveFocus = True
        self._line_pos = 0.85
        self._bar_limit = (1, -1)
        self._bar_size = (0.033, 0.45)
        self._side_mode = side_mode
        self._bar_component = bar_component
        self.__setup_content(scroll_component, bar_component)

    def handleMouseEvent(self, comp, event):
        if event.dz:
            self._bar.scroll(event.dz)
            return True
        return False

    def __setup_content(self, scroll_component, bar_component):
        self.component.addChild(scroll_component, 'scroll_area')
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.colour = (178, 178, 178, 255)
        comp.materialFX = 'SOLID'
        bar_component.addChild(comp, 'bar')
        self._bar = Bar(comp, self._bar_size[1])
        self._bar.set_limits(self._bar_limit)
        self._bar.on_position_changed = self._bar_position_changed
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (178,
         178,
         178,
         127.5)
        bar_component.addChild(comp, 'bar_stripe')

    def _bar_position_changed(self, position):
        """ 0 - \xd0\xb2\xd0\xb2\xd0\xb5\xd1\x80\xd1\x85\xd1\x83, 1 - \xd0\xb2\xd0\xbd\xd0\xb8\xd0\xb7\xd1\x83 """
        pos = self.component.scroll_area.position
        new_pos = -position * self._scroll_size
        if abs(pos[1] - new_pos) < 0.0001:
            return
        pos[1] = new_pos
        self.component.scroll_area.position = pos
        self.position_changed_callback(pos[1])

    def set_line_pos(self, value):
        """ \xd1\x81\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd1\x81\xd0\xba\xd0\xb8 (\xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e 0.85) """
        self._line_pos = value

