    def set_bar_size(self, width, height):
        """ \xd1\x88\xd0\xb8\xd1\x80\xd0\xb8\xd0\xbd\xd0\xb0 \xd0\xb8 \xd0\xb2\xd1\x8b\xd1\x81\xd0\xbe\xd1\x82\xd0\xb0 \xd0\xb1\xd0\xb0\xd1\x80\xd0\xb0 \xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd1\x81\xd0\xba\xd0\xb8 (\xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e 0.033, 0.45) """
        self._bar_size = (width, height)
        self._bar.set_height(height)

    def do_reposition(self):
        comp = self.component.scroll_area
        comp.widthMode = 'CLIP'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor = 'LEFT' if self._side_mode else 'RIGHT'
        comp.verticalAnchor = 'TOP'
