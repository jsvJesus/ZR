        comp = GUI.Text(lc('AchivGui.tab.desc'))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (8, 259, 0.8)
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.colour = CC.inactive_rgba
        self.component.container.addChild(comp, 'desclabel')
        desc_text = soTextField3(GUI.Window(), width=236, textWidth=236, height=160, borderWidth=0, vOffset=0, hOffset=0, hScroll=False, vScroll=False)
        comp = desc_text.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (236, 160)
        comp.position = (8, 271, 0.8)
        self.component.container.addChild(comp, 'desc')
        stats_text = soTextField3(GUI.Window(), width=236, textWidth=236, height=160, borderWidth=0, vOffset=0, hOffset=0, hScroll=False, vScroll=False)
        comp = stats_text.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (236, 160)
        comp.position = (8, 550, 0.8)
        comp = stats_text.component
        self.component.container.addChild(comp, 'stats')
        self._ach_id = None
        self._value = None
        self._desc_prefix = CC.header_xml + '<font=RobotoCondensedRegular_16.font>'
        return

    def on_show(self):
        self._data_provider.add_ach_listener(self)
        self._update_content()

    def on_hide(self):
        self._data_provider.remove_ach_listener(self)
        self.component.container.stats.script.setText(u'')

    def on_achivs_event(self, event_type, data):
        if event_type == APET.AchmaskUpdated:
            self._update_content()
        elif event_type == APET.GotAchValue:
            ach_data = data
            if ach_data['ach_id'] == self._ach_id:
                self._update_content(ach_data['value'])

    def set_ach(self, ach_id):
        self._ach_id = ach_id
        self._update_content()

    def _update_content(self, value = None):
        self._value = value
        cont = self.component.container
        if self._ach_id is None:
            cont.visible = False
            return
        else:
            cont.visible = True
            achivment = achives_parser.get_achiv(self._ach_id)
            image = achivment.get('image')
            if image:
                self.component.container.image.textureName = image
                self.component.container.image.visible = True
            else:
                self.component.container.image.visible = False
            title_text = '<alignment=center><font=RobotoCondensedRegular_18.font>' + achivment['name']
            if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and self._data_provider.isAdminAccess():
                title_text = u'ach_id: {0}\n{1}'.format(self._ach_id, title_text)
            self._title_text.setText(title_text)
            cont.desc.script.setText(self._desc_prefix + achivment['description'])
            cont.stats.script.setText(descriptor.compile_description(self._ach_id, self._value, self._data_provider))
            return

    @property
    def _data_provider(self):
        return BigWorld.player()