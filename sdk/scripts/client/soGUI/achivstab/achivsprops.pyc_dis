        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 252)
        comp.position = (0, self.component.height - 12, 1)
        self.component.addChild(comp, 'frame_bottom')
