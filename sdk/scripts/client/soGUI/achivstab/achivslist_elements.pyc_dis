        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (2, 4, 0.1)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'pip')
        return

    def apply(self, ach_id, hidden_count_provider):
        self._hidden_count_provider = hidden_count_provider
        self._ach_id = ach_id
        self._update_content()

    def _update_content(self):
        if self._ach_id == HIDDEN_ACHS_CODE:
            self.component.cutter.name.text = lc('AchivGui.hidden_title') + u' ' + unicode(self._hidden_count_provider())
            self.component.cutter.description.text = lc('AchivGui.hidden_desc')
            self.component.fader.visible = False
            self.component.pip.visible = False
            self.component.image.textureName = 'soGUI/maps/Icons/achievements/unknown_achievement.dds'
            self.component.frameTexture.colour = (55, 55, 55, 255)
            self.component.mouseButtonFocus = False
            self.component.crossFocus = False
        else:
            achivement = achives_parser.get_achiv(self._ach_id)
            completed = self._ach_id in self._data_provider.achiv_ids
            self.component.fader.visible = not completed
            self.component.cutter.name.text = achivement['name']
            self.component.cutter.description.text = achivement['description']
            unread = self._data_provider.is_ach_unread(self._ach_id)
            self.component.pip.visible = unread
            image = achivement.get('image', 'soGUI/frame/paint/blue.dds')
            self.component.image.textureName = image
            self.component.frameTexture.colour = (255, 255, 255, 255)
            self.component.mouseButtonFocus = True
            self.component.crossFocus = True

    def setVisualState(self, stateName):
        highlight = self.component.highlight
        if stateName in ('pressed', 'active', 'hover_active'):
            highlight.colour[3] = 50
            highlight.visible = True
        elif stateName == 'hover':
            highlight.colour[3] = 10
            highlight.visible = True
        else:
            highlight.visible = False

    @property
    def _data_provider(self):
        return BigWorld.player()


class AchList(soList_optimized):

    def __init__(self, width, height, hidden_count_provider):
        create_data = soGUI.ListPropsStructure(width=width, height=height, elemHeight=ELEM_HEIGHT)
        soList_optimized.__init__(self, GUI.Window(), create_data, default_frame_skin='', buttons_is_options=False)
        self.achiv_selected_callback = lambda ach_id: None
        self._hidden_count_provider = hidden_count_provider

    def get_elem_class(self):
        return Element

    def apply_single_element(self, i, elem):
        soList_optimized.apply_single_element(self, i, elem)
        element = self.elemComps[i].component.script
        element.apply(self.attachments[self.indexes[elem]], self._hidden_count_provider)

    def onSelected(self):
        soList_optimized.onSelected(self)
        selection = self.getSelection()
        if len(selection) == 1:
            ach_id = self.getAttachment(selection[0])
            if BigWorld.player().set_ach_read(ach_id):
                for ec in self.elemComps:
                    ec._update_content()

            self.achiv_selected_callback(ach_id)
        else:
            self.achiv_selected_callback(None)
        return

    def clear(self):
        soList_optimized.clear(self)
        self.achiv_selected_callback(None)
        return

    def save_state(self):
        selection = self.getSelection()
        ach_id = None
        if len(selection) == 1:
            ach_id = self.getAttachment(selection[0])
        self._saved_state = (self.get_scroll_value(), ach_id)
        return

    def restore_state(self):
        scroll_value, ach_id = self._saved_state
        self.set_scroll_value(scroll_value)
        self.toggleByCaption(unicode(ach_id))