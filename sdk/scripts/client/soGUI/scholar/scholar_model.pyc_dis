# Embedded file name: ./client/soGUI/scholar/scholar_model.py
import BWPersonality
from utils import Listenable, PY
import open_world_events_config as owe_config
from copy import deepcopy
from NPCs import NPCs

class EventType:
    OnInfoSet, OnProgressChanged, OnNpcAppended, OnNpcChanged = ((r, 'scholar_model') for r in range(4))


class ScholarModel(Listenable):

    def __init__(self):
        Listenable.__init__(self)
        self._reset_values()

    def _reset_values(self):
        self._info = None
        self.progress = (0, 0)
        self.time_end = 0
        self.npcs = []
        return

    def update_info(self, event_type, int_list, str_list):
        if event_type == owe_config.PROGRESS_CHANGED:
            self.progress = (int_list[0], self.progress[1])
            self.notify_listeners(EventType.OnProgressChanged)
        elif event_type == owe_config.NPC_SPAWNED:
            entity_id, ratio = int_list
            name = NPCs.key_name_to_local(str_list[0])
            self.npcs.append({'name': name,
             'ratio': ratio,
             'entity_id': entity_id})
            self.notify_listeners(EventType.OnNpcAppended)
        elif event_type == owe_config.NPC_HEALTH_CHANGED:
            entity_id, ratio = int_list
            npc = next((n for n in self.npcs if n['entity_id'] == entity_id))
            npc['ratio'] = ratio
            data = npc
            self.notify_listeners(EventType.OnNpcChanged, data)
        else:
            print event_type

    def set_info(self, info):
        if self._info != info:
            if info:
                self._info = deepcopy(info)
                self.progress = (self._info['progressbar_value'], self._info['progressbar_max_value'])
                self.time_end = self._info['time_end'] + BWPersonality.gpd.time_diff
                self.event_name = self._info['event_name']
                self.npcs = [ {'name': NPCs.key_name_to_local(data['displayName']),
                 'ratio': data['health_ratio'],
                 'entity_id': data['npc_id']} for data in self._info['npc_list'] ]
            else:
                self._reset_values()
            self.notify_listeners(EventType.OnInfoSet)