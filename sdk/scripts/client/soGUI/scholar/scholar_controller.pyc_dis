# Embedded file name: ./client/soGUI/scholar/scholar_controller.py
import BWPersonality
from scholar_model import ScholarModel
from scholar_view import ScholarView
from utils import Destructable
import open_world_events_config as owe_config

class ScholarController(Destructable):

    def __init__(self):
        Destructable.__init__(self)
        self._model = ScholarModel()
        self._view = ScholarView(self._model)
        BWPersonality.GUICore.worldLayer.addChild(self._view.component, 'Scholar.GUI.Interface')

    def show(self):
        self._view.show()

    def hide(self):
        self._view.hide()

    @property
    def visible(self):
        return self._view.visible

    def set_owe_info(self, info):
        self._model.set_info(info)
        self.show()

    def update_owe_info(self, event_type, int_list, str_list):
        if event_type == owe_config.LEAVE_AREA:
            self._model.set_info(None)
            self.hide()
        else:
            self._model.update_info(event_type, int_list, str_list)
        return

    def on_release(self):
        self.hide()
        BWPersonality.GUICore.worldLayer.delChild('Scholar.GUI.Interface')