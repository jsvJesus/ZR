# Embedded file name: ./client/soGUI/donat_shop/window/win_ui/scroll_content.py
from math_bw import clamp
from ui.panel import Panel

class ScrollPart(object):

    def __init__(self):
        self._scroll_visible = False
        self._start_local = 0
        self._end_local = 0
        self._view_size = 0

    def set_params(self, value, start_local, end_local, view_size):
        changed = (self.scroll_visible,
         self._start_local,
         self._end_local,
         self._view_size != value,
         start_local,
         end_local,
         view_size)
        self.scroll_visible = value
        self._view_size = view_size
        self._start_local = start_local
        self._end_local = end_local
        if changed:
            self.on_visible_borders_changed(self.scroll_visible, start_local, end_local)

    def on_scoll_visible_changed(self, scroll_visible):
        self.component.visible = scroll_visible

    def on_visible_borders_changed(self, visible, start, end):
        pass

    def get_visible_borders(self):
        return (self._start_local, self._end_local)

    @property
    def scroll_visible(self):
        return self._scroll_visible

    @scroll_visible.setter
    def scroll_visible(self, value):
        if value == self._scroll_visible:
            return
        self._scroll_visible = value
        self.on_scoll_visible_changed(self._scroll_visible)


class ScrollContent(Panel):

    def __init__(self, component, name):
        Panel.__init__(self, component, name)

    def on_mode_applied(self):
        Panel.on_mode_applied(self)
        comp = self.component
        parent = comp.parent
        start_visible = -comp.position[1]
        end_visible = start_visible + parent.height
        for _, child in comp.children:
            if not isinstance(child.script, ScrollPart):
                continue
            child_start = child.position[1]
            child_end = child_start + child.height
            visible = child_end >= start_visible and child_start <= end_visible
            start_local = clamp(start_visible - child_start, 0, child.height)
            end_local = clamp(end_visible - child_start, 0, child.height)
            child.script.set_params(visible, start_local, end_local, parent.height)

    @staticmethod
    def calculate_mode(content_comp, view_comp, displacement):
        _, cpx, cpy = content_comp.script.transform._mode
        prev_content_pix_pos = content_comp.position[1]
        pixel_ratio = content_comp.script.transform.pixel_ratio
        cpy = list(cpy)
        space = max(0, displacement - view_comp.height)
        content_pos = clamp(float(-prev_content_pix_pos) / space if space > 0 else 0)
        cpy[1] = content_pos
        cpy[2] = content_pos
        cpy[3] = displacement / pixel_ratio
        return (cpx, tuple(cpy))