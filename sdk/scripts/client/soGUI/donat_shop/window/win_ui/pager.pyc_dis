# Embedded file name: ./client/soGUI/donat_shop/window/win_ui/pager.py
from utils import Listenable

class EventType:
    OnIndexChanged, OnSizeChanged = ((r, 'pager') for r in range(2))


class Pager(Listenable):

    def __init__(self):
        Listenable.__init__(self)
        self._index = None
        self._items = []
        return

    def set_items(self, items):
        prev_count = self.count
        self._items[:] = items
        if self._items:
            if self.index is None or self.index >= self.count:
                self.index = 0
        else:
            self.index = None
        if prev_count != self.count:
            self.notify_listeners(EventType.OnSizeChanged)
        return

    def move_right(self):
        if self._items and self._index is not None:
            self.index = (self.index + 1) % self.count
        else:
            self.index = None
        return

    def move_left(self):
        if self._items and self.index is not None:
            self.index = (self.index - 1) % self.count
        else:
            self.index = None
        return

    def get_cur_item(self):
        return self._items[self.index]

    def get_item(self, index):
        return self._items[index]

    def set_cur_item(self, item):
        if item not in self._items:
            self.index = None
        else:
            self.index = self._items.index(item)
        return

    @property
    def count(self):
        return len(self._items)

    @property
    def index(self):
        return self._index

    @index.setter
    def index(self, value):
        if self._index == value:
            return
        self._index = value
        self.notify_listeners(EventType.OnIndexChanged)