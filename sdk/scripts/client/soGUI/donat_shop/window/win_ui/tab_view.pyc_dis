from utils import Listenable
from ui.panel import Panel
from tab import Tab

class EventType:
    OnTabShown = ((r, 'tabview') for r in range(1))


class TabView(Panel, Listenable):

    def __init__(self, parent_comp, name):
        Listenable.__init__(self)
        Panel.__init__(self, parent_comp, name)
        self._visible = False
        self._cur_type = None
        self._tabs = {}
        return

    def append_tab(self, tab, tab_type):
        raise tab_type not in self._tabs or AssertionError
        tab.transform.set_clip_mode((0, 0, 1, 1))
        tab.component.visible = False
        self._tabs[tab_type] = tab

    def create_tab(self, tab_type, tab_name):
        tab = Tab(self.component, tab_name)
        self.append_tab(tab, tab_type)
        return tab

    @property
    def tab_type(self):
        return self._cur_type

    @tab_type.setter
    def tab_type(self, value):
        if self._cur_type == value:
            return
        if self._get_cur_tab():
            if self._visible:
                self._get_cur_tab().on_hide()
            self._get_cur_tab().component.visible = False
        self._cur_type = value
        if self._get_cur_tab():
            self._get_cur_tab().component.visible = True
            if self._visible:
                self._get_cur_tab().on_show()
                data = {'tab_type': self._cur_type}
                self.notify_listeners(EventType.OnTabShown, data)

    def _get_cur_tab(self):
        return self._tabs.get(self._cur_type)

    def on_show(self):
        self._visible = True
        if self._get_cur_tab():
            self._get_cur_tab().on_show()
            data = {'tab_type': self._cur_type}
            self.notify_listeners(EventType.OnTabShown, data)

    def on_hide(self):
        if self._get_cur_tab():
            self._get_cur_tab().on_hide()
        self._visible = False