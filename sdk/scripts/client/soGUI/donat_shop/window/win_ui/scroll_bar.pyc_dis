# Embedded file name: ./client/soGUI/donat_shop/window/win_ui/scroll_bar.py
import GUI
import BigWorld
import Keys
from math_bw import clamp, smooth_damp
from ui.panel import Panel, EventType as PanelET
from Helpers.PyGUI import Utils

class ScrollBar(Panel):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb8 \xd1\x81\xd1\x83\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c content-panel (\xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb9 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xb5\xd1\x82 \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f-panel)
            content \xd0\xb4\xd0\xbe\xd0\xbb\xd0\xb6\xd0\xb5\xd0\xbd \xd0\xb8\xd0\xbc\xd0\xb5\xd1\x82\xd1\x8c pixel_params \xd0\xbf\xd0\xbe \xd0\xb2\xd0\xb5\xd1\x80\xd1\x82\xd0\xb8\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8 \xd0\xb2 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb5 pixel_params(0, 0, height)
    """

    def __init__(self, content, parent, name):
        Panel.__init__(self, parent, name)
        self.change_interseption(intercept_buttons=True, intercept_moving=True)
        self._content = content
        self._drag_pos = None
        self._move_pos = None
        self._velocity = 0
        self._callback_handler = None
        comp = GUI.Window('textures/default/white.dds')
        comp.colour = (178, 178, 178, 255)
        self._handler = Panel(self.component, 'handler', component=comp)
        self._handler.transform.set_clip_mode((0, 0, 1, 0.5))
        comp = GUI.Window('textures/default/white.dds')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.width, comp.height = (0.5, 2)
        comp.position = (0, 0, 0.9)
        comp.colour = (100, 100, 100, 250)
        self.component.addChild(comp, 'line')
        self._content.add_callback(self._on_content_event)
        self._cparent = self._content.component.parent.script
        return

    def _on_content_event(self, observable, event_type, data = None):
        if event_type == PanelET.OnModeApplied:
            self._update_content()
        elif event_type == PanelET.OnSizeChanged:
            self._drag_pos = None
            self._move_pos = None
        return

    def _update_content(self):
        content_height = self._content.component.height
        view_height = self._cparent.component.height
        tail_height = content_height - view_height
        if tail_height <= 0 or content_height == 0:
            self.component.visible = False
            _, cpx, cpy = self._content.transform._mode
            cpy = list(cpy)
            if cpy[1] or cpy[2]:
                cpy[1] = 0
                cpy[2] = 0
                cpy = tuple(cpy)
                self._content.transform.set_mixed_mode(cpx, cpy)
            return
        cpy = self._content.transform._mode[2]
        ratio = cpy[2]
        handle_size = float(view_height) / content_height
        free_size = 1 - handle_size
        pos_0 = clamp(free_size * ratio)
        pos_1 = clamp(pos_0 + handle_size)
        self.component.visible = True
        self._handler.transform.set_clip_mode((0,
         pos_0,
         1,
         pos_1))

    def handleMouseButtonEvent(self, component, event):
        result = Panel.handleMouseButtonEvent(self, component, event)
        if event.isKeyDown():
            local_pos = self.component.screenToLocal(GUI.mcursor().position)
            mouse_pos = float(local_pos[1]) / self.component.height
            mode = self._handler.transform._mode
            _, pos_0, _, pos_1 = mode[1]
            self._cancel_callbacks()
            if pos_0 <= mouse_pos <= pos_1:
                self._drag_pos = (pos_0, mouse_pos, pos_1)
                self._move_pos = None
                self._drag_tick()
            else:
                self._drag_pos = None
                self._move_pos = mouse_pos
                self._velocity = 0
                self._move_tick()
        return result

    def move_to(self, ratio):
        self._cancel_callbacks()
        self._drag_pos = None
        self._move_pos = ratio
        self._velocity = 0
        self._move_tick()
        return

    def _move_tick(self):
        self._drag_pos = None
        if not Utils.is_visible_in_hierarchy(self.component):
            return
        elif self._move_pos is None:
            return
        else:
            _, cpx, cpy = self._content.transform._mode
            ratio = cpy[2]
            new_ratio, self._velocity = smooth_damp(ratio, self._move_pos, self._velocity, 0.1, 50, BigWorld.getTimeDelta())
            if abs(new_ratio - ratio) < 1e-05:
                new_ratio = ratio
                self._velocity = 0
            if new_ratio == ratio:
                return
            cpy = list(cpy)
            cpy[1] = new_ratio
            cpy[2] = new_ratio
            cpy = tuple(cpy)
            self._content.transform.set_mixed_mode(cpx, cpy)
            self._cancel_callbacks()
            self._callback_handler = BigWorld.callback(0, self._move_tick)
            return

    def _cancel_callbacks(self):
        if self._callback_handler:
            BigWorld.cancelCallback(self._callback_handler)
            self._callback_handler = None
        return

    def move_abs(self, value):
        comp = self._content.component
        if comp.height > 0:
            space = comp.height - comp.parent.height
            if space != 0:
                self.move(value / float(space))

    def move(self, value):
        if self._move_pos is None:
            _, cpx, cpy = self._content.transform._mode
            ratio = cpy[2]
        else:
            ratio = self._move_pos
        new_ratio = clamp(ratio + value)
        self._move_pos = new_ratio
        self._drag_pos = None
        self._velocity = 0
        self._cancel_callbacks()
        self._move_tick()
        return

    def stop(self):
        self._move_pos = None
        self._drag_pos = None
        self._velocity = 0
        self._cancel_callbacks()
        return

    def _drag_tick(self):
        self._move_pos = None
        if not BigWorld.isKeyDown(Keys.KEY_LEFTMOUSE):
            self._drag_pos = None
        if not Utils.is_visible_in_hierarchy(self.component):
            self._drag_pos = None
        if not self._drag_pos:
            return
        else:
            local_pos = self.component.screenToLocal(GUI.mcursor().position)
            mouse_pos = float(local_pos[1]) / self.component.height
            p0, mp, p1 = self._drag_pos
            disp = mouse_pos - mp
            pos_0 = max(0, p0 + disp)
            handle_size = p1 - p0
            pos_1 = pos_0 + handle_size
            if pos_1 > 1:
                pos_1 = 1
                pos_0 = pos_1 - handle_size
            free_size = 1 - handle_size
            ratio = float(pos_0) / free_size
            _, cpx, cpy = self._content.transform._mode
            cpy = list(cpy)
            cpy[1] = ratio
            cpy[2] = ratio
            cpy = tuple(cpy)
            self._content.transform.set_mixed_mode(cpx, cpy)
            self._callback_handler = BigWorld.callback(0, self._drag_tick)
            return

    def on_size_changed(self):
        self._drag_pos = None
        self._move_pos = None
        self._update_content()
        return