# Embedded file name: ./client/soGUI/donat_shop/window/shop_tab/shop_tab.py
from math_bw import clamp
import BigWorld
import GUI
from soGUI.donat_shop.window.win_ui.tab import Tab
from soGUI.donat_shop.window.win_ui.scroll_bar import ScrollBar
from soGUI.donat_shop.window.win_ui.scroll_content import ScrollContent
from soGUI.donat_shop.window.win_ui.items_block import EventType as ItemsET
from shop_items_block import ShopItemsBlock
from ui.transform import pixel_params, clip_params
from ui.panel import Panel
from recs.rec_block import RecBlock
from bbs.bb_block import BbBlock
from soGUI.donat_shop.window import element
from shop_sort_ui import ShopSortUi, SortEventType
from soGUI.donat_shop.models.model import EventType as ModelET

class ShopTab(Tab):

    def __init__(self, parent_comp, shop_model, bin_model):
        Tab.__init__(self, parent_comp, 'shop')
        self._shop_model = shop_model
        self._shop_model.add_listener(self._on_shopmodel_event)
        self.change_interseption(intercept_moving=True)
        sorter_size = 100
        comp = GUI.MaskableWindow('soGUI/frame/donatshop/gradient.dds')
        view = Panel(self.component, 'view', component=comp)
        view.transform.set_clip_mode((0, 0, 1, 1), (sorter_size,
         36,
         -58,
         -36))
        comp.materialFX = 'BLEND'
        bottom, top = (0.5, 2.5)
        comp.mapping = ((0, top),
         (0, bottom),
         (1, bottom),
         (1, top))
        content = ScrollContent(view.component, 'content')
        cpx = clip_params((0, 1))
        cpy = pixel_params(0, 0, 0)
        content.transform.set_mixed_mode(cpx, cpy)
        self._scroll = ScrollBar(content, self.component, 'scroll')
        cpx = pixel_params(0.5, 1, 14, -28)
        cpy = clip_params((0, 1), (82, -74))
        self._scroll.transform.set_mixed_mode(cpx, cpy)

        def create_default_comp():
            comp = GUI.Window()
            comp.materialFX = 'BLEND'
            comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
            comp.ha, comp.va = ('LEFT', 'TOP')
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            content.component.addChild(comp)
            return comp

        self._rec_block = RecBlock(create_default_comp(), shop_model, bin_model)
        self._bb_block = BbBlock(create_default_comp(), shop_model, bin_model)
        self._items_block = ShopItemsBlock(create_default_comp(), shop_model, bin_model)
        self._items_block.add_listener(self._on_itemsblock_event)
        comp = GUI.Window('soGUI/frame/donatshop/dot.dds')
        comp.materialFX = 'BLEND_MASKABLE'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = 0, comp.texture.height
        comp.position = (0, 0, 0.5)
        comp.tileHeight = comp.texture.height
        comp.tileWidth = comp.texture.width
        comp.tiled = True
        content.component.addChild(comp, 'pipline')
        self._sort_ui = ShopSortUi(self.component, self.component.view.content.script)
        self._sort_ui.add_listener(self._on_sortui_event)
        hm = pixel_params(0, 0, sorter_size)
        vm = clip_params((0, 1))
        self._sort_ui.transform.set_mixed_mode(hm, vm)

    def _on_shopmodel_event(self, event_type, data):
        if event_type == ModelET.OnItems:
            if getattr(self, '_scroll_on_shop_items', False):
                del self._scroll_on_shop_items
                if self._shop_model.items:
                    BigWorld.callback(0.1, self.scroll_to_premiums)

    def scroll_to_premiums(self):
        if not self._shop_model.items:
            self._scroll_on_shop_items = True
            return
        self._sort_ui.scroll_to_premiums()

    def on_show(self):
        Tab.on_show(self)
        self._rec_block.on_show()
        self._items_block.on_show()
        self._bb_block.on_show()
        self._sort_ui.on_show()

    def on_tick(self):
        self._rec_block.on_tick()
        self._bb_block.on_tick()
        self._items_block.on_tick()
        self._sort_ui.on_tick()

    def on_hide(self):
        Tab.on_hide(self)
        self._rec_block.on_hide()
        self._items_block.on_hide()
        self._bb_block.on_hide()
        self._sort_ui.on_hide()

    def _create_broken_item(self, uid):
        raise NotImplementedError(uid)

    def _mark_align_content(self):
        element.add_pre_gui_callback(self._align_content)

    def _on_sortui_event(self, event_type, data):
        if event_type == SortEventType.OnMoveRequest:
            space = self.component.view.content.height - self.component.view.height
            if space > 0:
                ratio = clamp(float(data['pos'] + 8) / space)
                self._scroll.move_to(ratio)

    def _align_content(self):
        top_margin = 0
        left_margin = 40
        right_margin = 40
        bottom_margin = 20
        space0 = 96
        pipline_space = 42
        space1 = 32
        screen_height = BigWorld.screenHeight()
        rec_height = screen_height * 0.485
        bb_height = screen_height * 0.263
        pos_y = top_margin
        content = self.component.view.content
        pixel_ratio = content.script.transform.pixel_ratio
        top_margin *= pixel_ratio
        left_margin *= pixel_ratio
        right_margin *= pixel_ratio
        bottom_margin *= pixel_ratio
        space0 *= pixel_ratio
        space1 *= pixel_ratio
        pipline_space *= pixel_ratio
        width = content.width - left_margin - right_margin
        rec_ratio = width / rec_height
        min_rec_ratio = 2.6
        if rec_ratio < min_rec_ratio:
            rec_ratio = min_rec_ratio
            rec_height = width / rec_ratio
        comp = self._rec_block.component
        comp.position = (left_margin, pos_y, 0.5)
        comp.width, comp.height = width, rec_height
        rec_comp = comp
        comp = content.pipline
        comp.width = content.width - left_margin - right_margin
        comp.position = (left_margin, rec_comp.position[1] + rec_comp.height + pipline_space, comp.position[2])
        bb_ratio = width / bb_height
        min_bb_ratio = 5.0
        if bb_ratio < min_bb_ratio:
            bb_ratio = min_bb_ratio
            bb_height = width / bb_ratio
        pos_y += rec_height + space0
        comp = self._bb_block.component
        comp.position = (left_margin, pos_y, 0.5)
        comp.width, comp.height = width, bb_height
        pos_y += bb_height + space1
        comp = self._items_block.component
        comp.position = (left_margin, pos_y, 0.5)
        comp.width = width
        self._rec_block.align_content()
        slot_width, cols = self._bb_block.align_content()
        align_data = self._items_block.mark_align_content(slot_width, cols)
        pos_y += align_data['height'] + bottom_margin
        cpx, cpy = ScrollContent.calculate_mode(content, self.component.view, pos_y)
        content.script.transform.set_mixed_mode(cpx, cpy)
        self._sort_ui.update_sort_map(align_data['tag_positions'], self._items_block.component.position[1])

    def handleMouseEvent(self, component, event):
        result = Tab.handleMouseEvent(self, component, event)
        if event.dz:
            self._scroll.move_abs(-event.dz)
        return result

    def on_size_changed(self):
        Tab.on_size_changed(self)
        self._mark_align_content()
        self._items_block.do_reposition()

    def _on_itemsblock_event(self, event_type, data):
        if event_type == ItemsET.OnItemsChanged:
            self._mark_align_content()