# Embedded file name: ./client/soGUI/donat_shop/window/shop_tab/shop_sort_ui.py
from ui.panel import EventType as PanelET
from soGUI.donat_shop.window.sort_ui import SortUi
from donate_catalog_tags import TAGS_NAME_IDS
from Localization import lc

class SortEventType:
    OnMoveRequest, = ((r, 'sortui') for r in range(1))


class ShopSortUi(SortUi):

    def __init__(self, component, content):
        SortUi.__init__(self, component)
        self._content = content
        self._sort_map = None
        self._content.add_callback(self._on_content_event)
        return

    def _on_content_event(self, observable, event_type, data = None):
        if event_type == PanelET.OnModeApplied:
            self._mark_update()
        elif event_type == PanelET.OnSizeChanged:
            self._mark_update()

    def _is_bar_valid(self, index):
        return self.sort_map and self.sort_map[index][1][1] or False

    def _get_cur_tag(self):
        if not self.sort_map:
            return None
        else:
            content = self._content.component
            content_pos = abs(content.position[1])
            for i in range(len(self.sort_map) - 1, -1, -1):
                dt, (pos, valid) = self.sort_map[i]
                if content_pos >= pos and valid:
                    return dt

            return None

    def _calc_tag_pos(self, tag_id):
        return next((td[1][0] for td in self._sort_map if td[0] == tag_id), None)

    def _on_bar_click(self, tag_id):
        data = {'pos': self._calc_tag_pos(tag_id),
         'tag': tag_id}
        self.notify_listeners(SortEventType.OnMoveRequest, data)

    def scroll_to_premiums(self):
        tag_pos = self._calc_tag_pos(TAGS_NAME_IDS['TAG_SUBSCRIPTION'])
        if tag_pos is not None:
            data = {'pos': tag_pos}
            self.notify_listeners(SortEventType.OnMoveRequest, data)
        return

    def update_sort_map(self, tag_positions, local_block_top_margin):
        rows = [(-1, [0, True]), (0, [0, False])]
        tag_positions = tag_positions.items()
        tag_positions.sort()
        for tag, pos in tag_positions:
            rows.append((tag, (local_block_top_margin + pos, True)))

        self.sort_map = rows

    def main_line_text(self):
        return lc('DonatShop.window.shop.main')

    @property
    def sort_map(self):
        return self._sort_map

    @sort_map.setter
    def sort_map(self, value):
        if self._sort_map == value:
            return
        self._sort_map = value
        self._mark_update()