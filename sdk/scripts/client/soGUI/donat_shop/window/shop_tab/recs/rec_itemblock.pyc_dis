# Embedded file name: ./client/soGUI/donat_shop/window/shop_tab/recs/rec_itemblock.py
from soGUI.donat_shop.window.shop_tab.shop_item_view import ShopItemView
from random import choice, shuffle

class RecItemBlock:

    def __init__(self, component, shop_model, bin_model, can_stretch):
        self.component = component
        self._can_stretch = can_stretch
        self._shop_model = shop_model
        self._views = []
        self._item_types = []
        self._cols = 0

        def create_view():
            view = ShopItemView(self.component, 'view_' + str(len(self._views)), shop_model, bin_model)
            self._views.append(view)

        for i in range(7):
            create_view()

        long_view = self._views[-1]
        long_view.component.image.position[1] = 0.1

    def set_item_types(self, item_types):
        self._item_types = item_types
        self._apply_item_types()

    def _apply_item_types(self):
        if self._cols == 0:
            return
        else:

            def is_long(item_type):
                if not item_type:
                    return False
                item_data = self._shop_model.get_item(item_type)
                if not item_data:
                    return False
                return bool(item_data.get('promo_long'))

            long_item = None
            show_item_types = list(self._item_types)
            shuffle(show_item_types)
            if self._can_stretch and self._cols == 3 and len(self._item_types) >= 5:
                long_items = filter(is_long, self._item_types)
                if long_items:
                    long_item = choice(long_items)
                    show_item_types.remove(long_item)
                    show_item_types[2:2] = (None, None)
            for index in range(2 * self._cols):
                if index >= len(show_item_types):
                    break
                self._views[index].set_item_type(show_item_types[index])

            for i in range(index + 1, len(self._views) - 1):
                self._views[i].set_item_type(None)

            long_view = self._views[-1]
            long_view.set_item_type(long_item)
            return

    def on_tick(self):
        for view in self._views:
            view.on_tick()

    def align_content(self, cols):
        self._cols = cols
        index = 0
        space = 8
        pixel_ratio = self._views[0].transform.pixel_ratio
        size_x = float(self.component.width + space) / cols
        size_y = float(self.component.height + space) / 2
        col_width = size_x - space
        height = size_y - space
        col_width /= pixel_ratio
        size_x /= pixel_ratio
        height /= pixel_ratio
        size_y /= pixel_ratio
        for col in range(cols):
            for row in range(2):
                view = self._views[index]
                view.transform.set_pixel_mode((0, 0), (0, 0), (col_width, height), pixel_pos=(size_x * col, size_y * row))
                index += 1

        long_view = self._views[-1]
        long_view.transform.set_pixel_mode((0, 0), (0, 0), (col_width, height * 2 + space / pixel_ratio), pixel_pos=(size_x, 0))
        self._apply_item_types()
        return col_width