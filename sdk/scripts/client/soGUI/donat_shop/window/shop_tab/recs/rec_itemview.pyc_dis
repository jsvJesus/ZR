# Embedded file name: ./client/soGUI/donat_shop/window/shop_tab/recs/rec_itemview.py
import ItemsUtils
import GUI
from soGUI.donat_shop.models.shop_model import RecType
from soGUI.donat_shop.window.shop_tab.shop_item_view import ShopItemView
from soGUI.StorehouseGUI.ShopUtils import MultilineText
from soGUI.donat_shop.window.win_ui.item_view import ItemView
import colorCodes as cc

class RecItemView(ShopItemView):

    def __init__(self, component, name, shop_model, bin_model, depth = 0.5):
        ShopItemView.__init__(self, component, name, shop_model, bin_model, depth=depth, multiline_config='Shop_24')
        self.delay_load_time = 0
        self._txt.set_color(cc.active_rgba)
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'BOTTOM')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (0, 0)
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'txt2')
        self._txt2 = MultilineText(comp, u'', 'Shop_18')
        self._txt2.material_fx = 'BLEND_MASKABLE'
        self._txt2.set_color(cc.inactive_rgba)
        self.component.visible = False
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0.1)
        comp.visible = False
        comp.filterType = 'LINEAR'
        comp.materialFX = 'BLEND_MASKABLE'
        self.component.addChild(comp, 'banner')
        self.set_button_height(ItemView.btn_height)
        self._nonbanner_comps = (self._txt.component,
         self._txt2.component,
         self._btn.component,
         self.component.image,
         self.component.info)

    def show_info_win(self):
        if not self.component.banner.visible:
            ShopItemView.show_info_win(self)

    def _apply_button_height(self):
        mode = self._btn.transform._mode
        if mode:
            mode = mode[1:]
            mode[2] = (mode[2][0], self._btn_height)
            self._btn.transform.set_pixel_mode(*mode)
        else:
            self._btn.transform.set_pixel_mode((0.5, 1), (0.5, 1), (0, self._btn_height), pixel_pos=(0, -50))

    def set_button_width(self, button_width):
        mode = self._btn.transform._mode[1:]
        mode[2] = (button_width, mode[2][1])
        self._btn.transform.set_pixel_mode(*mode)

    def _align_banner(self):
        comp = self.component.banner
        if not comp.visible:
            return
        space = self.component.width * 0.05
        bottom_space = self.component.height - self._btn.component.position[1] - self._btn.component.height
        ratio = float(comp.texture.width) / comp.texture.height
        width = self.component.width - space * 2
        height = width * ratio
        max_height = self.component.height - space - bottom_space
        if height > max_height:
            height = max_height
            width = height / ratio
        comp.width, comp.height = width, height
        center_y = max_height / 2 + space
        comp.position[1] = center_y

    def set_recom(self, recom):
        if recom['rec_type'] == RecType.Item:
            self.set_item_type(recom['item_type'])
            for comp in self._nonbanner_comps:
                comp.visible = True

            self.component.banner.visible = False
        elif recom['rec_type'] == RecType.Banner:
            for comp in self._nonbanner_comps:
                comp.visible = False

            self.component.banner.textureName = recom['banner']
            self.component.banner.visible = True
            self._disc_text.component.visible = False
            self.component.garant.visible = False
            self._align_banner()

    def _update_content(self):
        if self._item_data:
            item_name = ItemsUtils.get_shop_desc(self.item_type) or u' '
            self._txt2.set_text(item_name)
        ShopItemView._update_content(self)

    def _align_content(self):
        ShopItemView._align_content(self)
        text_size = 0.85
        pixel_ratio = self.transform.pixel_ratio
        comp = self.component.txt2
        comp.position[1] = self._btn.component.position[1] - 8 * pixel_ratio
        comp.width, comp.height = self.component.width * text_size, comp.position[1]
        if self.component.width > 0:
            self._txt2.do_reposition()
            comp.height = self._txt2.height
        comp = self.component.txt
        comp.position[1] = self._txt2.component.position[1] - self._txt2.component.height - 8 * pixel_ratio
        comp.width, comp.height = self.component.width * text_size, comp.position[1]
        if self.component.width > 0:
            self._txt.do_reposition()
            comp.height = self._txt.height
        self._align_banner()