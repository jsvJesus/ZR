# Embedded file name: ./client/soGUI/donat_shop/window/shop_tab/recs/pager_ui.py
from utils import Listenable
import GUI
from ui.panel import Panel
from soGUI.donat_shop.window.win_ui.pager import EventType as PagerET

class BarEventType:
    OnClick, = ((r, 'pagerbar') for r in range(1))


class Bar(Panel, Listenable):

    def __init__(self, index, parent_comp):
        Listenable.__init__(self)
        self._index = index
        name = 'bar' + str(index)
        comp = GUI.Window('soGUI/frame/donatshop/slider.dds')
        Panel.__init__(self, parent_comp, name, component=comp)
        comp.materialFX = 'BLEND_MASKABLE'
        comp.filterType = 'LINEAR'
        self.change_interseption(intercept_buttons=True)

    def handleMouseButtonEvent(self, component, event):
        result = Panel.handleMouseButtonEvent(self, component, event)
        if event.isKeyDown():
            data = {'index': self._index}
            self.notify_listeners(BarEventType.OnClick, data)
        return result


class PagerUi(Panel):

    def __init__(self, pager, component, name):
        Panel.__init__(self, component, name)
        self._pager = pager
        self._current_index = None
        self._pager.add_listener(self._on_pager_event)
        self._base_color = (70, 70, 70, 255)
        self._selected_color = (150, 150, 150, 255)
        self._bars = []
        return

    def _on_pager_event(self, event_type, data):
        if event_type == PagerET.OnSizeChanged:
            for name, _ in self.component.children:
                self.transform.del_child(name)

            self._bars[:] = []
            count = self._pager.count
            if not count:
                self.current_index = None
                return
            k = 0.2
            bar_size = 1.0 / (count + (count - 1) * k)
            space_size = k * bar_size
            size = bar_size + space_size
            for i in range(count):
                bar = Bar(i, self.component)
                bar.component.colour = self._base_color
                bar.transform.set_clip_mode((size * i,
                 0,
                 size * i + bar_size,
                 1))
                bar.add_listener(self._on_bar_event)
                self._bars.append(bar.component)

            self.current_index = self._pager.index
        elif event_type == PagerET.OnIndexChanged:
            if self._bars:
                self.current_index = self._pager.index
        return

    def _on_bar_event(self, event_type, data):
        if event_type == BarEventType.OnClick:
            self._pager.index = data['index']

    @property
    def current_index(self):
        return self._current_index

    @current_index.setter
    def current_index(self, value):
        if self._current_index == value:
            return
        else:
            if self._current_index is not None:
                self._bars[self._current_index].colour = self._base_color
            self._current_index = value
            if self._current_index is not None:
                self._bars[self._current_index].colour = self._selected_color
            return