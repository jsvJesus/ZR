# Embedded file name: ./client/soGUI/donat_shop/window/tab_panel.py
from win_ui.tab_view import TabView
from shop_tab.shop_tab import ShopTab
from store_tab.store_tab import StoreTab
from bin_tab.bin_tab import BinTab

class TabType:
    Shop, Store, Bin = range(3)


class TabPanel(TabView):

    def __init__(self, parent_comp, screen_component, name, shop_model, store_model, bin_model, state_model):
        TabView.__init__(self, parent_comp, name)
        self._shop_tab = ShopTab(self.component, shop_model, bin_model)
        self.append_tab(self._shop_tab, TabType.Shop)
        store_tab = StoreTab(self.component, screen_component, store_model, state_model)
        self.append_tab(store_tab, TabType.Store)
        bin_tab = BinTab(self.component, bin_model, shop_model, state_model)
        self.append_tab(bin_tab, TabType.Bin)

    def on_tick(self):
        self._get_cur_tab().on_tick()

    def handle_esc(self):
        return self._get_cur_tab().handle_esc()

    def scroll_to_premiums(self):
        self.tab_type = TabType.Shop
        self._get_cur_tab().scroll_to_premiums()