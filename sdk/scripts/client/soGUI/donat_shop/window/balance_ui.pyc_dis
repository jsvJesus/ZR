# Embedded file name: ./client/soGUI/donat_shop/window/balance_ui.py
import BigWorld
from utils import Listenable
from Localization import lc
from ui.panel import Panel
from ui.text import Text, Align
from ui.button import Button
import colorCodes as cc
from soGUI.donat_shop.models.shop_model import EventType as ShopModelET
import StoreHouseConst

class EventType:
    OnCurrencyClicked, = ((r, 'balanceui') for r in range(1))


class BalanceUi(Panel, Listenable):

    def __init__(self, component, shop_model):
        Listenable.__init__(self)
        Panel.__init__(self, component, 'balance_ui')
        self._shop_model = shop_model
        self._shop_model.add_listener(self._on_shopmodel_event)
        self._btn_swap = Button(self.component, 'currency_btn')
        self._btn_swap.set_visual('soGUI/frame/buttons/swapbtn.json')
        self._btn_swap.transform.set_clip_mode((0, 0.5, 1, 1))
        self._btn_swap.on_click = self._on_currency_click
        self._btn_swap.component.frame.filterType = 'LINEAR'
        self._text = Text(self.component, 'text', size=32)
        self._text.set_alignment(Align.Right, Align.Center)
        self._text.transform.set_clip_mode((0, 0, 1, 1))
        self._image = Panel(self.component, 'image')
        self._image.transform.set_clip_mode((0, 0.5, 1, 1))
        self._image.component.materialFX = 'BLEND'
        self._image.component.filterType = 'LINEAR'

    def _on_shopmodel_event(self, event_type, data):
        if event_type in (ShopModelET.OnCurrencyChanged, ShopModelET.OnMoneyChanged):
            self._update_content()

    def on_show(self):
        self._update_content()

    def _update_content(self):
        """ http://hz-dev.stalker.so:8090/projects/stalker-online/wiki/Donat_shop
        """
        is_partner = bool(BigWorld.player().partner_id)
        is_platina = StoreHouseConst.CURRENCY_PLATINA_NAME == self._shop_model.currency
        is_gold = bool(BigWorld.auth.isGoldAcc() and BigWorld.player().gold)

        def get_from_currency(count, currency):
            return u'{active}{0} {gold}{1} {active}{2}'.format(lc('DonatShop.window.currencybtn'), count, currency, active=cc.active_hex, gold=cc.premgold_hex)

        if is_gold:
            if is_partner:
                can_swap = True
                if is_platina:
                    count = BigWorld.player().current_platina
                    currency = lc('StoreHouse.shopitem.PLATINA')
                    image_texture = 'soGUI/frame/storehouse/platinumcoin.dds'
                    text = get_from_currency(count, currency)
                else:
                    count = BigWorld.player().gold
                    currency = lc('StoreHouse.shopitem.GOLD')
                    image_texture = 'soGUI/frame/storehouse/goldcoin.dds'
                    text = get_from_currency(count, currency)
            else:
                can_swap = False
                count = BigWorld.player().gold
                currency = lc('StoreHouse.shopitem.GOLD')
                image_texture = 'soGUI/frame/storehouse/goldcoin.dds'
                text = get_from_currency(count, currency)
        elif is_partner:
            can_swap = True
            if is_platina:
                count = BigWorld.player().current_platina
                currency = lc('StoreHouse.shopitem.PLATINA')
                image_texture = 'soGUI/frame/storehouse/platinumcoin.dds'
                text = get_from_currency(count, currency)
            else:
                text = lc('StoreHouse.mainscreen.CHANGE_CURRENCY')
                image_texture = None
        else:
            self.component.visible = False
            return
        self.component.visible = True
        space_x = 4
        pixel_ratio = self.transform.pixel_ratio
        self._text.set_text(text)
        pos_x = -self._text.get_string_width() / pixel_ratio - space_x
        size = 24
        if image_texture:
            self._image.component.visible = True
            self._image.component.textureName = image_texture
            texture = self._image.component.texture
            ratio = float(texture.width) / texture.height
            self._image.transform.set_pixel_mode((1, 0.5), (1, 0.5), (size, size / ratio), (pos_x, 0))
            pos_x -= size + space_x
        else:
            self._image.component.visible = False
        if can_swap:
            self._btn_swap.component.visible = True
            texture = self._btn_swap.component.frame.texture
            ratio = float(texture.width) / texture.height
            self._btn_swap.transform.set_pixel_mode((1, 0.5), (1, 0.5), (size, size / ratio), (pos_x, 0))
        else:
            self._btn_swap.component.visible = False
        return

    def on_size_changed(self):
        Panel.on_size_changed(self)
        self._update_content()

    def _on_currency_click(self):
        self.notify_listeners(EventType.OnCurrencyClicked)