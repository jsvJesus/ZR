# Embedded file name: ./client/soGUI/donat_shop/window/auxwins/pickpaymentwin.py
from functools import partial
from ui.button import Button
from Localization import lc
from basewin import BaseWin
from Constants import EMBD_PAYMENT_TYPE as EPT
from ui.transform import pixel_params, clip_params

class EventType:
    OnPaymentPicked, = ((r, 'pickpaymentwin') for r in range(1))


class PickPaymentWin(BaseWin):

    def __init__(self, parent_comp, name):
        BaseWin.__init__(self, parent_comp, name)
        pos_y = 64
        btn_scale = 1
        for payment_type in (EPT.UKASSA, EPT.XSOLLA):
            btn = Button(self.component, '')
            btn.override_background_texture(EPT.type_data[payment_type]['btn_image'])
            btn.set_visual('soGUI/frame/buttons/paymentbutton.json')
            btn.component.frame.filterType = 'LINEAR'
            texture = btn.component.frame.texture
            btn.transform.set_pixel_mode((0.5, 0), (0.5, 0), (texture.width * btn_scale, texture.height * btn_scale), (0, pos_y))
            btn.on_click = partial(self._on_payment_click, payment_type)
            pos_y += texture.height * btn_scale + 16

        hpm = clip_params((0, 1))
        vpm = pixel_params(0.5, 1, 40, -48)
        btn = Button(self.component, 'btn_back')
        btn.transform.set_mixed_mode(hpm, vpm)
        btn.set_text(lc('StoreHouse.paytypes.back'))
        btn.set_visual('soGUI/frame/buttons/linkbuttoncenter.json')
        btn.on_click = self.hide

    def show(self):
        BaseWin.show(self, u'', (), caption=lc('StoreHouse.paytypes.pickpayment'))

    def _on_payment_click(self, payment_type):
        data = {'payment_type': payment_type}
        self.hide()
        self.notify_listeners(EventType.OnPaymentPicked, data)