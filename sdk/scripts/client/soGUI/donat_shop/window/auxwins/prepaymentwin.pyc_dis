# Embedded file name: ./client/soGUI/donat_shop/window/auxwins/prepaymentwin.py
from basewin import BaseWin
from Constants import EMBD_PAYMENT_TYPE as EPT
from Localization import lc
from ui.button import Button
from ui.transform import pixel_params, clip_params

class PrepaymentWin(BaseWin):

    def __init__(self, parent_comp, name):
        BaseWin.__init__(self, parent_comp, name)
        self._btn_prepay = Button(self.component, 'btn_prepay')
        self._prepay_callback = None
        hpm = clip_params((0, 1))
        vpm = pixel_params(0.5, 1, 40, -110)
        self._btn_prepay.transform.set_mixed_mode(hpm, vpm)
        self._btn_prepay.set_text(lc('StoreHouse.paytypes.changepayment'))
        self._btn_prepay.set_visual('soGUI/frame/buttons/linkbuttoncenter.json')
        self._btn_prepay.on_click = self._on_prepay_click
        return

    def _on_prepay_click(self):
        self._prepay_callback()

    def change_payment_type(self, payment_type):
        self._payment_type = payment_type
        self._apply_show()

    def _agree_with_args(self):
        self._agree_callback(self._payment_type)

    def show(self, payment_type, agree_callback, prepay_callback):
        self._payment_type = payment_type
        self._agree_callback = agree_callback
        self._prepay_callback = prepay_callback
        self._apply_show()

    def _apply_show(self):
        btns_data = ({'text': lc('StoreHouse.bin.CANCEL'),
          'sound': 'ui/inventory/item_drop'}, {'text': lc('StoreHouse.bin.CONTINUE'),
          'callback': self._agree_with_args,
          'sound': 'ui/weapon_mod/approve',
          'visual': 'soGUI/frame/buttons/donatbutton_red.json'})
        text = lc('StoreHouse.bin.SURE_BUY_PAY').format(lc(EPT.type_data[self._payment_type]['local_key']))
        BaseWin.show(self, text, btns_data, caption=lc('StoreHouse.paytypes.payment'))