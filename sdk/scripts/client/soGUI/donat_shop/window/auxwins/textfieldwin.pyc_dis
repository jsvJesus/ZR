# Embedded file name: ./client/soGUI/donat_shop/window/auxwins/textfieldwin.py
from functools import partial
from basewin import BaseWin
from soGUI.promo_gui.win import EditBox

def _word_validator(new_str, whole_text, offset):
    """ \xd0\xbd\xd0\xb5 \xd0\xbe\xd1\x87\xd0\xb5\xd0\xbd\xd1\x8c \xd0\xb4\xd0\xbb\xd0\xb8\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xbe \xd0\xb1\xd0\xb5\xd0\xb7 \xd0\xba\xd1\x80\xd0\xb8\xd0\xb2\xd1\x8b\xd1\x85 \xd1\x81\xd0\xb8\xd0\xbc\xd0\xb2\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2 """
    try:
        result = new_str + whole_text
        if len(result) > 32:
            return False
        return result.isalnum()
    except:
        return False


class TextfieldWin(BaseWin):

    def __init__(self, parent_comp, name):
        BaseWin.__init__(self, parent_comp, name)
        self._txt.component.position[1] = 0.5
        self._edit_box = EditBox(200, None, validator=_word_validator)
        self.component.addChild(self._edit_box.component)
        return

    def _intercept_callback(self, original_callback):
        original_callback(self._edit_box.getRaw())

    def show(self, text, btns_data, caption = None):
        self._edit_box.clear()
        for i in range(len(btns_data)):
            btn = btns_data[i]
            callback = btn.get('callback')
            if callback:
                btn = dict(btn)
                btn['callback'] = partial(self._intercept_callback, callback)
                btns_data[i] = btn

        BaseWin.show(self, text, btns_data, caption=None)
        return

    def _on_hide(self):
        self._edit_box.clear()
        self._edit_box.on_hide()
        BaseWin._on_hide(self)

    def on_size_changed(self):
        BaseWin.on_size_changed(self)
        self._edit_box.setWidth(self.component.width * 0.7)