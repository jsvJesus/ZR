# Embedded file name: ./client/soGUI/donat_shop/window/auxwins/tooltip.py
import BigWorld
import GUI
from Math import Vector2
from ui.wrapped_text import WrappedText
from ui.text import Align
from utils import Tickable
from Helpers.PyGUI import Utils
import colorCodes as cc

class Tooltip(WrappedText, Tickable):
    _width = 300

    def __init__(self, parent_comp, depth = 0):
        Tickable.__init__(self)
        WrappedText.__init__(self, parent_comp, 'tooltip', 16, depth=depth)
        self.set_alignment(Align.Left)
        self.set_unscalable()
        self.set_color(cc.active_hex)
        comp = GUI.Frame2('soGUI/frame/frame_tooltip.dds')
        comp.materialFX = 'BLEND'
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.wm, comp.hm = ('CLIP', 'CLIP')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.99)
        self.component.addChild(comp, 'unremovable_frame')
        self.component.visible = False
        self.set_margin(8, 8, 8, 8)
        self.transform.set_base_resolution(None)
        self.transform.set_pixel_mode((0, 0), (0, 0), (Tooltip._width, 400))
        return

    def show(self, text):
        self.component.visible = True
        self.component.width = Tooltip._width
        self.set_text(text)
        max_width = 0
        for line in self._line_comps:
            max_width = max(max_width, line.width * self.component.width * 0.5)

        self.component.width = self._margins[0] + max_width + self._margins[1]
        self.start_tick()

    def on_size_changed(self):
        pass

    def on_tick(self):
        mouse_pos = Vector2(GUI.mcursor().position)
        sw, sh = BigWorld.screenSize()
        mouse_pos.x = (mouse_pos.x + 1) * 0.5 * sw
        mouse_pos.y = (1.0 - (mouse_pos.y + 1) * 0.5) * sh
        width, height = self.component.width, self.wrapped_height
        pivot = [0, 0]
        if mouse_pos.x + width > sw:
            pivot[0] = 1
        if mouse_pos.y + height > sh:
            pivot[1] = 1
        self.transform.set_pixel_mode(tuple(pivot), (0, 0), (width, height), pixel_pos=mouse_pos)

    def hide(self):
        self.component.visible = False
        self.stop_tick()

    def can_tick(self):
        return Utils.is_visible_in_hierarchy(self.component)

    @property
    def visible(self):
        return self.component.visible