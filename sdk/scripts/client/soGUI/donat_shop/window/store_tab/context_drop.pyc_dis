# Embedded file name: ./client/soGUI/donat_shop/window/store_tab/context_drop.py
from utils import Listenable
from functools import partial
from ui.button import Button
from ui.transform import pixel_params, clip_params
from soGUI.donat_shop.donat_shop_utils import ItemActions

class EventType:
    OnAction, = ((r, 'contextdrop') for r in range(1))


class ContextDrop(Listenable):
    _btn_height = 50

    def __init__(self, component, store_model):
        Listenable.__init__(self)
        self._store_model = store_model
        self.component = component
        self._btns = {}
        for i, action_type in enumerate(ItemActions.get_all()):
            b = Button(self.component, 'btn_' + str(i))
            hpp = clip_params((0, 1))
            vpp = pixel_params(0, 0, ContextDrop._btn_height)
            b.transform.set_mixed_mode(hpp, vpp)
            b.set_visual('soGUI/frame/buttons/donatstoredrop.json')
            b.set_text(ItemActions.get_localization(action_type))
            b.on_click = partial(self._on_action_click, action_type)
            self._btns[action_type] = b

    def show(self, store_itemview, actions):
        self._item_view = store_itemview
        comp = store_itemview.component
        screen_pos = comp.localToScreen((0, comp.height))
        local_pos = self.component.parent.screenToLocal(screen_pos)
        self.component.position = (local_pos[0], local_pos[1], self.component.position[2])
        self.component.width = comp.width
        self.component.visible = True
        height = 0
        for btn in self._btns.itervalues():
            btn.component.visible = False

        for action, enabled in actions:
            btn = self._btns[action]
            comp = btn.component
            comp.visible = True
            _, hpp, vpp = btn.transform._mode
            vpp = list(vpp)
            vpp[4] = height / btn.transform.pixel_ratio
            btn.transform.set_mixed_mode(hpp, tuple(vpp))
            btn.set_enabled(enabled)
            height = comp.position[1] + comp.height

        self.component.height = height

    def _on_action_click(self, action_type):
        self.hide()
        data = {'action_type': action_type,
         'view': self._item_view}
        self.notify_listeners(EventType.OnAction, data)

    def hide(self):
        self.component.visible = False