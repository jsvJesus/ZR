import ItemsUtils
import GUI
from soGUI.donat_shop.window.win_ui.item_view import ItemView
from soGUI.login.tooltip import TooltipProviderShopWin as TooltipProvider
from Localization import lc
from ui.button import Button
from ui.panel import Panel
import sounds_manager as sm
from ui.text import Text
from soGUI.StorehouseGUI.InfoWin import InfoWin

class EventType:
    OnClick, = ((r, 'storeitemview') for r in range(1))


class StoreButton(Button, TooltipProvider):

    def __init__(self, component, name):
        Button.__init__(self, component, name)
        comp = GUI.Window('soGUI/frame/donatshop/triangle.dds')
        tri = Panel(self.component, 'triangle', component=comp)
        size = 16
        tri.transform.set_pixel_mode((0.5, 0.5), (1, 0.5), (size, size), (-20, 0))
        tri.component.materialFX = 'BLEND_MASKABLE'
        tri.component.filterType = 'LINEAR'

    def get_tooltip_text(self):
        if not self._enabled:
            return lc('DonatShop.window.store.buttondisable')

    def handleMouseEnterEvent(self, comp):
        result = Button.handleMouseEnterEvent(self, comp)
        TooltipProvider.on_mouse_enter(self)
        return result

    def handleMouseLeaveEvent(self, comp):
        result = Button.handleMouseLeaveEvent(self, comp)
        TooltipProvider.on_mouse_leave(self)
        return result

    def show_arrow(self, show):
        self.component.triangle.visible = show


class StoreItemView(ItemView):

    def __init__(self, component, name, data_provider, depth = 0.5):
        ItemView.__init__(self, component, name, depth=depth)
        self._data_provider = data_provider
        if self._btn:
            self._btn.set_text(lc('DonatShop.window.store.take'))
        self._count_text = Text(self.component, 'count', size=24, depth=0.3)
        self._count_text.component.textureName = 'soGUI/frame/paint/white.dds'
        self._count_text.component.materialFX = 'BLEND_MASKABLE'
        self._count_text.component.text.materialFX = 'BLEND_MASKABLE'
        self._count_text.transform.set_pixel_mode((0, 0), (0, 0), (68, 32))
        self._count_text.set_color((255, 255, 255, 255))
        self._count_text.component.colour = (178, 10, 9, 255)

    def _on_click(self):
        sm.playSound('ui/big_click')
        data = {'store_item_view': self}
        self.notify_listeners(EventType.OnClick, data)

    def show_info_win(self):
        InfoWin.instance.show(self.item_type, complex_item=self._item_data)

    def _create_button(self, component, name):
        return None

    def update_button_interactability(self):
        if self._item_data:
            need_arrow, enabled = self._data_provider.get_show_params(self._item_data)
        else:
            need_arrow, enabled = False, False
        self._btn.show_arrow(need_arrow)
        self._btn.set_enabled(enabled)

    def set_item_data(self, value):
        ItemView.set_item_data(self, value)
        if self._btn:
            self.update_button_interactability()

    def _update_content(self):
        ItemView._update_content(self)
        if not self._item_data:
            return
        number = ItemsUtils.GetItemNumber(self._item_data)
        if number and number > 1:
            self._count_text.component.visible = True
            self._count_text.set_text('x' + str(number))
        else:
            self._count_text.component.visible = False
        if self._btn:
            self.update_button_interactability()