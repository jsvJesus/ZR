# Embedded file name: ./client/soGUI/donat_shop/window/store_tab/store_items_block.py
import ItemsUtils
import BigWorld
from Items import ItemsCatalog
from soGUI.donat_shop.window.win_ui.items_block import ItemsBlock
from soGUI.donat_shop.window.store_tab.store_item_view import StoreItemView
from soGUI.donat_shop.donat_shop_utils import ItemActions

class StoreItemsBlock(ItemsBlock):

    def __init__(self, component, model):
        self._pool = set()
        ItemsBlock.__init__(self, component, self._pool, model, 0.953)

    def mark_align_content(self):
        slot_height = BigWorld.screenHeight() * 0.2
        slot_width = self._slot_ratio * slot_height
        min_space = slot_height * 0.1
        cols = int(float(self.component.width + min_space) / (slot_width + min_space))
        align_data = ItemsBlock.mark_align_content(self, slot_width, cols or 1)
        align_data['slot_width'] = slot_width
        return align_data

    def _align_content(self):
        ItemsBlock._align_content(self)
        potential_count = self.get_pool_potential_count()
        existing_count = len(self._pool) + len(self._itemviews)
        need_resort = False
        for _ in range(existing_count, potential_count):
            need_resort = True
            self._generate_item_in_pool()

        if need_resort:
            self.component.reSort()

    def _decide_actions(self, item_data):
        if self._model.npc_name:
            return ((ItemActions.TakeStore, True),)
        item_type = item_data['complexItemType']
        item_params = ItemsCatalog.GetItemParam(item_type)
        if 'Premium_id' in item_params or 'Booster_id' in item_params:
            return ((ItemActions.Activate, True), (ItemActions.TakeStore, False))
        elif ItemsUtils.canTakeStoreHouseItemToAvatar(item_type):
            return ((ItemActions.TakeInventory, True), (ItemActions.TakeStore, False))
        else:
            return tuple()

    def get_show_params(self, item_data):
        actions = self._decide_actions(item_data)
        return (len(actions) > 1, len(actions) > 1 or len(actions) == 1 and actions[0][1])

    def _create_item_view(self, component, name):
        return StoreItemView(component, name, self)