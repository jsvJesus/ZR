# Embedded file name: ./client/soGUI/donat_shop/window/bin_tab/bin_tab.py
from Localization import lc
from math_bw import inverse_lerpclam, lerp, lerpclamp
import BigWorld
import GUI
from soGUI.donat_shop.window.win_ui.tab import Tab
from bin_table import BinTable
from ui.text import Text, Align
from ui.panel import Panel
from soGUI.donat_shop.models.bin_model import EventType as BinET
from soGUI.donat_shop.models.state_model import EventType as StateET
from ui.button import Button
