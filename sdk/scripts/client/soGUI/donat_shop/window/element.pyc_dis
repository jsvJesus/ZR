class Tickable:

    def __init__(self, tick_delay = 0):
        self.__tick_handler = None
        self._tick_delay = tick_delay
        return

    def __stop_tick(self):
        if self.__tick_handler:
            BigWorld.cancelCallback(self.__tick_handler)
            self.__tick_handler = None
        return

    def __start_tick(self):
        self.__stop_tick()
        self.__tick_handler = BigWorld.callback(self._tick_delay, self.__tick)

    def __tick(self):
        self.__stop_tick()
        if self.can_tick():
            self.on_tick()
            self.__start_tick()

    def start_tick(self):
        self.__start_tick()

    def stop_tick(self):
        self.__stop_tick()

    def can_tick(self):
        return True

    def on_tick(self):
        pass


class Hidable:

    def __init__(self):
        self._visible = False

    def show(self):
        if not self._visible:
            self._visible = True
            self._on_show()

    def on_show(self):
        pass

    def on_hide(self):
        pass

    def hide(self):
