# Embedded file name: ./client/soGUI/donat_shop/models/bin_model.py
import BigWorld
from functools import partial
from model import Model
from copy import deepcopy
from soGUI.donat_shop.models.shop_model import EventType as ShopET
from soGUI.donat_shop.models.model import EventType as ModelET

class EventType:
    OnSizeChanged, OnCountChanged, PricesInvalidated, OnTotalChanged = ((r, 'binmodel') for r in range(4))


class BinModel(Model):

    def __init__(self, shop_model):
        Model.__init__(self)
        self._shop_model = shop_model
        self._shop_model.add_listener(self._on_shopmodel_event)
        self._items = {}
        self._sorted_types = []
        self.total_count = 0
        self._total_cost = 0

    def set_items(self, items):
        raise NotImplementedError

    def add_items(self, items):
        raise NotImplementedError

    def get_item(self, index):
        if index >= len(self._sorted_types):
            return None
        else:
            return self._sorted_types[index]

    def get_item_type(self, item_type):
        return self._items.get(item_type)

    def clear(self):
        if not self._items:
            return
        self.total_count = 0
        self.total_cost = 0
        self._sorted_types[:] = []
        self._items.clear()
        self.notify_listeners(EventType.OnSizeChanged)
        self.notify_listeners(EventType.OnCountChanged)

    def set_content(self, content_data):
        if not self._shop_model.items:
            self._wait_init_content_data = content_data
            return
        else:
            self.clear()
            total_count = 0
            total_cost = 0
            for item_type, count in content_data.items():
                shop_item = self._shop_model.get_item(item_type)
                self._items[item_type] = deepcopy(shop_item)
                self._items[item_type]['bincount'] = count
                single_cost = self._shop_model.get_item_actual_cost(item_type)
                cost = single_cost * count
                self._items[item_type]['actual_cost'] = single_cost
                self._sorted_types.append(item_type)
                total_count += count
                total_cost += cost

            self.total_count = total_count
            self.total_cost = total_cost
            self.notify_listeners(EventType.OnSizeChanged)
            for item_type in self._sorted_types:
                data = {'shop_item_view': None,
                 'item_type': item_type,
                 'prev_count': 0,
                 'count': self._items[item_type]['bincount']}
                self.notify_listeners(EventType.OnCountChanged, data)

            return

    def add_item_type(self, item_type, shop_item_view = None):
        size_changed = False
        if item_type not in self._items:
            shop_item = self._shop_model.get_item(item_type)
            self._items[item_type] = deepcopy(shop_item)
            self._items[item_type]['bincount'] = 0
            self._items[item_type]['actual_cost'] = self._shop_model.get_item_actual_cost(item_type)
            self._sorted_types.append(item_type)
            size_changed = True
        prev_count = self._items[item_type]['bincount']
        count = prev_count + 1
        self._items[item_type]['bincount'] = count
        self.total_count += 1
        self.total_cost += self._items[item_type].get('actual_cost', 0)
        if size_changed:
            self.notify_listeners(EventType.OnSizeChanged)
        data = {'shop_item_view': shop_item_view,
         'item_type': item_type,
         'prev_count': prev_count,
         'count': count}
        self.notify_listeners(EventType.OnCountChanged, data)

    def clear_item_type(self, item_type):
        if item_type not in self._items:
            return
        else:
            item_data = self._items[item_type]
            prev_count = item_data['bincount']
            cost = item_data.get('actual_cost', 0) * prev_count
            self.total_count -= prev_count
            self.total_cost -= cost
            del self._items[item_type]
            self._sorted_types.remove(item_type)
            self.notify_listeners(EventType.OnSizeChanged)
            data = {'shop_item_view': None,
             'item_type': item_type,
             'prev_count': prev_count,
             'count': 0}
            self.notify_listeners(EventType.OnCountChanged, data)
            return

    def _on_shopmodel_event(self, event_type, data):
        if event_type == ModelET.OnItems:
            if hasattr(self, '_wait_init_content_data'):
                fill_data = self._wait_init_content_data
                del self._wait_init_content_data
                if self._shop_model.items:
                    BigWorld.callback(0.1, partial(self.set_content, fill_data))
        if event_type == ShopET.OnCurrencyChanged:
            self._invalidate_prices()

    def _invalidate_prices(self):
        total_cost = 0
        for item_type in self._items:
            item_data = self._items[item_type]
            if 'original_cost' not in item_data:
                continue
            shop_item = self._shop_model.get_item(item_type)
            if not shop_item:
                del item_data['original_cost']
            item_data['actual_cost'] = self._shop_model.get_item_actual_cost(item_type)
            total_cost += item_data['actual_cost'] * item_data['bincount']

        self.total_cost = total_cost
        self.notify_listeners(EventType.PricesInvalidated)

    @property
    def total_cost(self):
        return self._total_cost

    @total_cost.setter
    def total_cost(self, value):
        if self._total_cost == value:
            return
        self._total_cost = value
        self.notify_listeners(EventType.OnTotalChanged)

    def del_item_type(self, item_type, shop_item_view = None):
        if item_type not in self._items:
            return
        prev_count = self._items[item_type]['bincount']
        count = prev_count - 1
        self._items[item_type]['bincount'] = count
        self.total_count -= 1
        self.total_cost -= self._items[item_type].get('actual_cost', 0)
        if count <= 0:
            del self._items[item_type]
            self._sorted_types.remove(item_type)
            self.notify_listeners(EventType.OnSizeChanged)
        data = {'shop_item_view': shop_item_view,
         'item_type': item_type,
         'prev_count': prev_count,
         'count': count}
        self.notify_listeners(EventType.OnCountChanged, data)

    def get_size(self):
        return len(self._sorted_types)