# Embedded file name: ./client/soGUI/donat_shop/models/filter_model.py
import ItemsUtils
from model import Model, EventType as ModelET

class FilterModel(Model):

    def __init__(self, model, initial_tag):
        Model.__init__(self)
        self.filter_tag = initial_tag
        self._model = model
        self._model.add_listener(self._on_model_event)

    def change_filter(self, tag_id):
        if self.filter_tag == tag_id:
            return
        self.filter_tag = tag_id
        filtered_items = filter(self._is_model_item, self._model.items)
        self.set_items(filtered_items)

    def _on_model_event(self, event_type, data):
        if event_type == ModelET.OnItems:
            filtered_items = filter(self._is_model_item, self._model.items)
            self.set_items(filtered_items)

    def add_items(self, items):
        raise all(self._is_model_item, items) or AssertionError
        Model.add_items(self, items)

    def _is_model_item(self, item):
        if self.filter_tag == -1:
            return True
        return ItemsUtils.get_donat_tag(item['item_type']) == self.filter_tag

    def has_item_discount_now(self, item_type):
        return self._model.has_item_discount_now(item_type)

    def is_valid(self, item_type):
        return self._model.is_valid(item_type)

    @property
    def currency(self):
        return self._model.currency

    def get_item_actual_cost(self, item_type):
        return self._model.get_item_actual_cost(item_type)

    @property
    def npc_name(self):
        return self._model.npc_name