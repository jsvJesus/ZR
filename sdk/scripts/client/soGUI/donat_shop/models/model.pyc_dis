# Embedded file name: ./client/soGUI/donat_shop/models/model.py
from utils import Listenable
import ItemsUtils

class EventType:
    OnItems = ((r, 'donat_model') for r in range(1))


class Model(Listenable):

    def __init__(self):
        Listenable.__init__(self)
        self.items = []
        self._item_by_uid = {}

    def set_items(self, items):
        converted_items = []
        item_index = {}
        for index, item in enumerate(items):
            converted_item = self._convert_item_format(item)
            converted_items.append(converted_item)
            item_index[converted_item['uid']] = index

        def get_sort_key(item):
            return (ItemsUtils.get_donat_tag(item['item_type']), item_index[item['uid']])

        items = converted_items
        items.sort(key=get_sort_key)
        if items == self.items:
            return
        self.items = items
        self._item_by_uid = dict(((item['uid'], item) for item in self.items))
        self.notify_listeners(EventType.OnItems)

    def _convert_item_format(self, item):
        return item

    def get_item(self, item_uid):
        return self._item_by_uid.get(item_uid)

    def add_items(self, items):
        items = map(self._convert_item_format.items)
        self.items.extend(items)
        self.notify_listeners(EventType.OnItems)