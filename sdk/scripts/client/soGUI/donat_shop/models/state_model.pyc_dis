# Embedded file name: ./client/soGUI/donat_shop/models/state_model.py
from utils import Listenable
import BigWorld
from StoreHouseConst import CODES
from soGUI.donat_shop.window.auxwins.auxwins import Auxwins

class EventType:
    OnBinBuyRequested, OnBinBuyCompleted, OnUseItemRequested, OnUseItemCompleted, OnSwitchCurrencyRequested, OnTakeItemRequested, OnTakeAllRequested, OnTakeItemToAvatarRequested, OnCompleteTakeItemToAvatarRequested = ((r, 'StateModel') for r in range(9))


class StateModel(Listenable):

    def __init__(self):
        Listenable.__init__(self)
        self.payment_type = BigWorld.auth.embd_payment_type

    def take_all_request(self, npc_name):
        code = BigWorld.player().takeStoreHouseAllItems(npc_name)
        if CODES.OK == code:
            self.notify_listeners(EventType.OnTakeAllRequested)
        else:
            Auxwins.show_ok_message(CODES.getText(code))

    def take_item_request(self, item_id, npc_name):
        code = BigWorld.player().takeStoreHouseItem(item_id, npc_name)
        if code == CODES.OK:
            self.notify_listeners(EventType.OnTakeItemRequested)
        else:
            Auxwins.show_ok_message(CODES.getText(code))

    def take_itemtoavatar_request(self, item_id, db_id):
        self.notify_listeners(EventType.OnTakeItemToAvatarRequested)
        BigWorld.player().takeStoreHouseItemToAvatar(item_id, db_id)

    def use_item_request(self, item_id):
        self.notify_listeners(EventType.OnUseItemRequested)
        BigWorld.player().useStoreHouseItem(item_id)

    def complete_useitem_request(self):
        self.notify_listeners(EventType.OnUseItemCompleted)

    def complete_takeitemtoavatar_request(self):
        self.notify_listeners(EventType.OnCompleteTakeItemToAvatarRequested)

    def buy_bin_request(self, item_data, total_cost, payment_type):
        if payment_type is not None:
            BigWorld.auth.embd_payment_type = payment_type
        code = BigWorld.player().buyDonate(item_data, total_cost)
        if code == CODES.OK:
            self.notify_listeners(EventType.OnBinBuyRequested)
        else:
            Auxwins.show_ok_message(CODES.getText(code))
        return

    def complete_bin_request(self, success):
        if success:
            self.payment_type = BigWorld.auth.embd_payment_type
        data = {'success': success}
        self.notify_listeners(EventType.OnBinBuyCompleted, data)

    def switch_currency_request(self):
        self.notify_listeners(EventType.OnSwitchCurrencyRequested)
        BigWorld.player().switchPlatinaDonateShopCatalog()