class InWorldFlagMarker(PyGUIBase):
    """\xd0\x9a\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x81 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c\xd1\x8e \xd0\xba \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd1\x83."""
    factoryString = 'soGUI.InWorldFlagMarker'
    FRAME_TEXTURE = BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/frame.dds')

    def __init__(self, component, letter = 'A', alpha = 1.0):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.alpha = alpha * 255.0
        self.letter = letter
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        comp = self.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'CLIP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'CENTER'
        comp.verticalAnchor = 'BOTTOM'
        comp.colour = (255,
         255,
         255,
         self.alpha)
        comp.materialFX = 'BLEND'
        comp.width = 0
        comp.height = 0
        comp.position = (0.0, 0.0, 1.5)
        comp.textureName = ''

    def setupContent(self):
        comp = GUI.Text('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'BOTTOM'
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.colour = (255,
         255,
         255,
         self.alpha)
        comp.colourFormatting = True
        comp.multiline = True
        comp.materialFX = 'BLEND'
        comp.text = self.text
        calcStr = self.text
        colorCodes = []
        idx = 0
        while idx >= 0:
            idx = self.text.find(u'\\c', idx)
            if idx >= 0:
                colorCodes.append(idx)
                idx += 1

        for cc in colorCodes:
            calcStr = self.text[:cc] + self.text[cc + 11:]

        w, h = comp.stringDimensions(calcStr)
        if w + 4 > self.component.width:
            self.component.width = w + 4
        if self.component.height > 0:
            self.component.height += h + 4
        else:
            self.component.height = h + 4
        vis_str = self.text.split('\n')
        for index, vis_part in enumerate(vis_str):
            comp = GUI.Text('')
            comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
            comp.horizontalAnchor = 'CENTER'
            comp.verticalAnchor = 'BOTTOM'
            comp.font = 'RobotoCondensedRegular_16.font'
            comp.colour = (255,
             255,
             255,
             self.alpha)
            comp.colourFormatting = True
            comp.multiline = True
            comp.materialFX = 'BLEND'
            comp.text = vis_part
            comp.position = (self.component.width // 2, int(self.component.height - 2 - (len(vis_str) - (index + 1)) * (h / len(vis_str))), 0.5)
            self.component.addChild(comp, 'text{0}'.format(index))

        comp = GUI.Frame2('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'CENTER'
        comp.verticalAnchor = 'BOTTOM'
        comp.colour = (255,
         255,
         255,
         self.alpha)
        comp.materialFX = 'BLEND'
        comp.width = w + 4
        comp.height = h + 4
        comp.position = (self.component.width // 2, self.component.height, 1.0)
        comp.texture = self.FRAME_TEXTURE
        self.component.addChild(comp, 'backFrame')


class soFlagIcon(PyGUIBase):
    factoryString = 'soGUI.soFlagIcon'
    ICON_SIZE = 48
    ENEMY_TEXTURE = BigWorld.PyTextureProvider('soGUI/frame/flags/enemy_flag.dds')
    CAPTURE_TEXTURE = BigWorld.PyTextureProvider('soGUI/frame/flags/captured_flag.dds')

    def __init__(self, component, letter = 'A', statuses = (False, False, False), size = 1):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.size = size
        self.letter = letter
        self._is_owner, self._is_invader, self._is_ally = statuses
        self.setupRoot()
        self.load_letter()

    def update_colors(self):
        if self._is_invader:
            self.component.icon.texture = self.CAPTURE_TEXTURE
        else:
            self.component.icon.texture = self.ENEMY_TEXTURE
        self.component.ally.visible = self._is_ally

    def load_letter(self):
        texture_name = 'soGUI/frame/flags/{0}.dds'.format(self.letter.lower())

        def on_texture_loaded(resource):
            if not hasattr(self.component, 'letter'):
                return
            self.component.letter.texture = resource[texture_name]
            self.update_colors()

        BigWorld.loadResourceListBG([texture_name], on_texture_loaded)

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.ICON_SIZE
        cmp.height = self.ICON_SIZE
        cmp.position = (0.0, 0.0, 1.5)
        cmp.textureName = ''
        cmp = GUI.Simple('')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = self.ICON_SIZE
        cmp.height = self.ICON_SIZE
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.5)
        cmp.texture = None
        cmp.visible = True
        self.component.addChild(cmp, 'icon')
        cmp = GUI.Simple('')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.width = 12
        cmp.height = 15
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.4)
        cmp.texture = None
        cmp.visible = True
        self.component.addChild(cmp, 'letter')
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.width = 16
        cmp.height = 1
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (self.component.width / 2.0, self.component.height / 2.0 + self.component.letter.height / 2 + 2, 0.4)
        cmp.visible = False
        self.component.addChild(cmp, 'ally')
        return


class soFlagMarkers(PyGUIBase):
    """\xd0\x9a\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x81\xd0\xbe\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb6\xd0\xb0\xd1\x89\xd0\xb8\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb8 \xd0\xba \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd1\x83."""
    factoryString = 'soGUI.soFlagMarkers'

    def __init__(self, component):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        PyGUIBase.__init__(self, component)
        component.script = self
        self._inworld_flag_markers = {}
        self._buying_markers = {}
        self.setupRoot()
        self.is_hidden_inworld_m = False
        self.is_hidden_on_buying_m = False

    def setupRoot(self):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb3\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0."""
        comp = self.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'CLIP'
        comp.widthMode = comp.heightMode = 'CLIP'
        comp.horizontalAnchor = comp.verticalAnchor = 'CENTER'
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.width = 2.0
        comp.height = 2.0
        comp.position = (0.0, 0.0, 0.9)
        comp.visible = True
        BWPersonality.GUICore.flashWorldLayer.addChild(comp, 'flagMarkers')

    def clear(self):
        """\xd0\x9e\xd1\x87\xd0\xb8\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbe\xd1\x82 \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb5\xd0\xb9."""
        for component in itertools.chain(self._inworld_flag_markers.values(), self._buying_markers.values()):
            if self.component.hasChild(component, False):
                self.component.delChild(component)

    def show(self):
        self.component.visible = True

    def hide(self):
        self.component.visible = False

    def add_inworld_caption(self, identific, component):
        self._inworld_flag_markers[identific] = component
        if not self.is_hidden_inworld_m and not self.component.hasChild(component, False):
            self.component.addChild(component)

    def add_on_buying_caption(self, identific, component):
        self._buying_markers[identific] = component
        if not self.is_hidden_on_buying_m and not self.component.hasChild(component, False):
            self.component.addChild(component)

    def del_inworld_caption(self, identific):
        component = self._inworld_flag_markers.pop(identific, None)
        if component is not None and not self.is_hidden_inworld_m:
            self.component.delChild(component)
        return

    def del_on_buying_caption(self, identific):
        component = self._buying_markers.pop(identific, None)
        if component is not None and not self.is_hidden_on_buying_m:
            self.component.delChild(component)
        return

    def is_in_inworld_caption(self, identific):
        """\xd0\x98\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0 \xd0\xb2\xd0\xbe \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xbd\xd0\xb0\xd1\x85\xd0\xbe\xd0\xb6\xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2 \xd0\xbc\xd0\xb8\xd1\x80\xd0\xb5."""
        return identific in self._inworld_flag_markers

    def hide_inworld_flag_markers(self):
        self.is_hidden_inworld_m = True
        for component in self._inworld_flag_markers.values():
            if self.component.hasChild(component, False):
                self.component.delChild(component)

    def show_inworld_flag_markers(self):
        for component in self._inworld_flag_markers.values():
            if not self.component.hasChild(component, False):
                self.component.addChild(component)

        self.is_hidden_inworld_m = False

    def hide_on_buying_flag_markers(self):
        self.is_hidden_on_buying_m = True
        for component in self._buying_markers.values():
            if self.component.hasChild(component, False):
                self.component.delChild(component)

        self._buying_markers = {}

    def show_on_buying_flag_markers(self):
        for component in self._buying_markers.values():
            if not self.component.hasChild(component, False):
                self.component.addChild(component)

        self.is_hidden_on_buying_m = False