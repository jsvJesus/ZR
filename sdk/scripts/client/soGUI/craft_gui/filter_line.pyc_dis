# Embedded file name: ./client/soGUI/craft_gui/filter_line.py
import GUI
from Helpers.PyGUI import PyGUIBase
from WorkbenchUtil import WorkbenchTypes as WT
from soGUI import soButton, soButtonWTT
from soGUI.soEditField import soEditBox
_filters = [(WT.NONE, 'soGUI/elements/filter_manual.xml', 'none'),
 (WT.MECH, 'soGUI/elements/filter_mech.xml', 'mech'),
 (WT.SOLDER, 'soGUI/elements/filter_tinker.xml', 'solder'),
 (WT.LABOR, 'soGUI/elements/filter_laboratory.xml', 'labor')]

class FilterLine(PyGUIBase):

    def __init__(self, parent_comp, height):
        comp = GUI.Window()
        PyGUIBase.__init__(self, comp)
        comp.script = self
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = parent_comp.width, height
        comp.position = (0, 18, 0)
        parent_comp.addChild(comp, 'filterline')
        self._setup_content()
        self.on_filter_changed_callback = lambda : None
        self.filter_data = {'wtypes': set(),
         'text': u''}

    def clear_and_initialize(self, workbench_type):
        for button in self._buttons:
            button.setToggleState(button.filter_wtype == workbench_type)

        self._on_buttons_changed()

    def _on_buttons_changed(self):
        worbench_types = set()
        for button in self._buttons:
            if not button.buttonActive:
                continue
            if button.filter_wtype is not None:
                worbench_types.add(button.filter_wtype)

        self.filter_data['wtypes'] = worbench_types
        self.on_filter_changed_callback()
        return

    def _on_text_changed(self, by_user):
        self.filter_data['text'] = self._filter_box.getRaw().lower()
        self.on_filter_changed_callback()

    def on_hide(self):
        self._filter_box.activate(False)

    def _setup_content(self):
        self._filter_box = soEditBox(GUI.Window(), width=232, height=18)
        self._filter_box.onValueChange = self._on_text_changed
        comp = self._filter_box.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (32, self.component.height / 2, 0.3)
        self.component.addChild(comp, 'value')
        comp = GUI.Simple('soGUI/frame/search.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.position = (0, self.component.height / 2, 0.5)
        self.component.addChild(comp)
        right_margin = 8
        space = 16
        self._buttons = []
        for i, filter_data in enumerate(_filters):
            button = soButtonWTT(GUI.Window(), TTid='recipefilter_' + filter_data[2])
            button.buttonStyle = soButton.TOGGLEBUTTON_STYLE
            button.buttonActive = True
            comp = button.component
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
            comp.width, comp.height = (18, 18)
            right_index = len(_filters) - i
            comp.position = (right_margin + self.component.width - right_index * space, 0, 0.3)
            button.initVSC(filter_data[1])
            button.onBound()
            button.onClick = self._on_buttons_changed
            button.setVisualState('active')
            button.filter_wtype = filter_data[0]
            self._buttons.append(button)
            self.component.addChild(comp)