class KickstartSlot(Slot):
    factoryString = 'soGUI.craft_gui.kickstart_block.KickstartSlot'

    def __init__(self, *args):
        self._template_icon = None
        Slot.__init__(self)
        self.component.crossFocus = True
        self.component.dragFocus = True
        self.component.dropFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.dragProxy = self.component.dragProxy
        self._onDragStart = self.on_drag_start
        self._onDragStop = self.on_drag_stop
        self.stored_item_changed_callback = lambda new_item, old_item: None
        return

    def on_drag_start(self):
        if self.filled:
            self.dragProxy.visible = True
            return True
        return False

    def on_drag_stop(self):
        self.dragProxy.visible = False
        return True

    def setupContent(self):
        Slot.setupContent(self)
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 64
        cmp.height = 64
        cmp.colour = (255, 255, 255, 128)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.5)
        cmp.visible = False
        self.component.addChild(cmp, 'dragProxy')
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.colour = (0, 0, 0, 200)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0)
        comp.materialFX = 'BLEND'
        comp.visible = False
        self.component.addChild(comp, 'fader')

    def set_template_types(self, item_types, icon):
        self._template_icon = icon
        if self.haveItem():
            old_item = self.itemData['complex_item']
            item_data = {'filter_types': item_types,
             'item_type': item_types[0] if item_types else None,
             'complex_item': None} if item_types else None
            Slot.set_item_data(self, item_data)
            old_item and self.stored_item_changed_callback(None, old_item)
        return

    def set_complex_item(self, complex_item):
        if self.haveItem():
            old_item = self.itemData['complex_item']
            if self.itemData:
                item_data = deepcopy(self.itemData)
                item_data['item_type'] = complex_item and complex_item['complexItemType']
                item_data['complex_item'] = complex_item
            else:
                item_data['complex_item'] = None
        else:
            item_data = None
        Slot.set_item_data(self, item_data)
        self.stored_item_changed_callback(complex_item, old_item)
        return

    def _applyItemData(self):
        Slot._applyItemData(self)
        if self.haveItem():
            if not self.itemData['complex_item']:
                self.component.item_icon.texture = BWPersonality.GUICore.get_icon_from_cache(self._template_icon)
                self.component.item_icon.colour[3] = 128
            else:
                self.component.item_icon.colour[3] = 256
        if self.dragProxy:
            self.dragProxy.texture = self.component.item_icon.texture

    def can_accept_item(self, complex_item):
        if not self.available:
            return False
        return self.itemData['filter_types'] and complex_item['complexItemType'] in self.itemData['filter_types']

    def validate_items(self):
        if not self.filled:
            return
        complex_item_id = self.itemData['complex_item']['complexItemID']
        complex_item = ItemsUtils.GetComplexItemByID(self._craft_user, complex_item_id)
        if not complex_item:
            self.set_complex_item(None)
            return
        elif not self._craft_user.validate_kickstart_item(complex_item):
            self.set_complex_item(None)
            return
        else:
            return

    def on_out_screen_drop(self):
        self.set_complex_item(None)
        return

    @property
    def available(self):
        return self.haveItem() and not self.itemData['complex_item']

    @property
    def filled(self):
        return self.haveItem() and self.itemData['complex_item']

    @property
    def _craft_user(self):
        return BigWorld.player()

    def get_complex_item_id(self):
        if self.filled:
            return self.itemData['complex_item']['complexItemID']

    def get_item_type(self):
        if self.filled:
            return self.itemData['complex_item']['complexItemType']

    def set_fader(self, value):
        self.component.fader.visible = value


