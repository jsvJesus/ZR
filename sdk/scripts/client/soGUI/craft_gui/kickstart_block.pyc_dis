    factoryString = 'soGUI.craft_gui.kickstart_block.KickstartBlock'

    def __init__(self, parent_component, classic = True):
        """ classic - \xd1\x82\xd0\xbe\xd1\x82, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb9 \xd0\xb2 \xd0\xbe\xd0\xb1\xd1\x8b\xd1\x87\xd0\xbd\xd0\xbe\xd0\xbc \xd0\xba\xd1\x80\xd0\xb0\xd1\x84\xd1\x82\xd0\xb5, \xd0\xb8\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5, \xd0\xb2 \xd0\xb0\xd0\xbc\xd1\x83\xd0\xbb\xd0\xb5\xd1\x82\xd0\xbd\xd0\xbe\xd0\xbc """
