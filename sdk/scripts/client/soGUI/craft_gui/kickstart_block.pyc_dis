        else:
            margin = 36
            comp.width = self.component.width - margin * 2
            comp.position = (margin, 22, 0.5)
        self._item_view.onBound()
        self._item_view.setRestrictingComponent(None)
        self._descriptions = []
        if not classic:
            comp.slot1.position[0] = 300
            self._create_item_descriptions()
        if classic:
            comp.width = 280
        else:
            comp.width = self.component.item_view.width
        self._slots = []
        for i in xrange(cols * rows):
            slot = getattr(self._item_view.component, 'slot' + str(i)).script
            slot.stored_item_changed_callback = self._on_slot_item_changed
            self._slots.append(slot)

        self.on_content_changed = lambda : None
        return

