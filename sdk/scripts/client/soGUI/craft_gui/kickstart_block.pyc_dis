            comp.widthMode = 'PIXEL'
            comp.width = parent_component.width
        cols, rows = (2, 1)
        self._item_view = soItemView(GUI.Window(), KickstartSlot, slot_eventsHandler=self._slot_handler, rowWidth=cols, rows=rows, cols=cols, hScroll=False, vScroll=False)
