        self.component.item_view.addChild(comp, 'itemname2')
        self._descriptions.append(comp)

    def _on_slot_item_changed(self, new_item, old_item):
        if new_item:
            self._craft_user.capture_craft_item(new_item['complexItemID'])
        if old_item:
            self._craft_user.release_craft_items([old_item['complexItemID']])
        self.on_content_changed()

    def _slot_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DROP:
            slot, inventory_slot = data
            if not self._need_kickstart and not slot._always_active:
                return True
            if inventory_slot.factoryString != 'soGUI.soInventorySlot2':
                return True
            complex_item = inventory_slot.itemData
            if not slot.can_accept_item(complex_item):
                return True
            if not self._craft_user.validate_kickstart_item(complex_item):
                return True
            slot.set_complex_item(complex_item)
        return True

    def on_items_changed(self):
        """ \xd1\x83 \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba\xd0\xb0 \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xbb\xd0\xb8\xd1\x81\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd1\x8b """
        for slot in self._slots:
            slot.validate_items()

    def show(self, workbench_type, need_kickstart):
        self.component.visible = True
        self._need_kickstart = need_kickstart
        for i in xrange(len(self._slots)):
            item_data = WorkbenchUtil.kickstart_set[i] if i < len(WorkbenchUtil.kickstart_set) else None
            if item_data:
                self._slots[i].set_template_types(item_data['item_ids'], item_data['icon'])
                self._slots[i]._always_active = item_data['always_active']
                self._slots[i].set_fader(not need_kickstart and not item_data['always_active'])
            else:
                self._slots[i].set_template_types(None, None)
                self._slots[i]._always_active = False
                self._slots[i].set_fader(False)
            if i < len(self._descriptions):
                self._descriptions[i].text = u'???'

        return

    def hide(self):
        """ \xd1\x81\xd0\xba\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd0\xb1\xd0\xbb\xd0\xbe\xd0\xba
                \xd0\xbd\xd0\xb5 \xd0\xbf\xd1\x83\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81 on_hide
        """
        self.component.visible = False

    def on_hide(self):
        """ \xd1\x81\xd0\xba\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd1\x86\xd0\xb5\xd0\xbb\xd0\xb8\xd0\xba\xd0\xbe\xd0\xbc \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe
                \xd0\xbd\xd0\xb5 \xd0\xbf\xd1\x83\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81 hide
        """
        for slot in self._slots:
            slot.set_template_types(None, None)

        return

    def compile_item_types(self):
        result = []
        for slot in self._slots:
            item_type = slot.get_item_type()
            if item_type:
                result.append(item_type)

        return result

    def compile_item_ids(self):
        result = []
        for slot in self._slots:
            item_id = slot.get_complex_item_id()
            if item_id:
                result.append(item_id)

        return result

    @property
    def filled(self):
        if self._need_kickstart:
            for i, slot in enumerate(self._slots):
                if slot.available and not slot.filled:
                    if WorkbenchUtil.kickstart_set[i]['musthave']:
                        return False

        return True

    @property
    def _craft_user(self):
        return BigWorld.player()