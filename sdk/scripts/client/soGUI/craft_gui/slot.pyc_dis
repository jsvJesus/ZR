# Embedded file name: ./client/soGUI/craft_gui/slot.py
from soGUI.soItemView import soItemSlot
import BWPersonality
import GUI
import ItemsUtils

class Slot(soItemSlot):
    SLOTWIDTH = 64
    SLOTHEIGHT = 64

    def __init__(self):
        comp = GUI.Window()
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = Slot.SLOTWIDTH, Slot.SLOTHEIGHT
        soItemSlot.__init__(self, comp, None)
        self.component.script = self
        self.set_item_data(None)
        self.component.mouseButtonFocus = True
        self.disabled = False
        return

    def setupContent(self):
        comp = GUI.Frame2('soGUI/items/cell.dds')
        comp.verticalPositionMode, comp.horizontalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.materialFX = 'SOLID'
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'frame')
        comp = GUI.Simple('')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.4)
        comp.filterType = 'LINEAR'
        self.component.addChild(comp, 'item_icon')
        comp = GUI.Simple('soGUI/maps/Icons/equipment/locked.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.position = (0, 0, 0.8)
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        self.component.addChild(comp, 'disabler')
        comp = GUI.Simple('soGUI/white.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (60, 60)
        comp.colour = (255, 85, 85, 0)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.8)
        self.component.addChild(comp, 'bg_blink')
        shad = GUI.AlphaShader()
        comp.addShader(shad, 'blink')

    def set_item_data(self, item_data):
        self.setContent(item_data)

    def _applyItemData(self):
        soItemSlot._applyItemData(self)
        item_comp = self.component.item_icon
        if self.haveItem():
            item_comp.visible = True
            item_type = self.itemData.get('item_type')
            if item_type:
                if not ItemsUtils.GetIconName(None, item_type=item_type):
                    icon_name = 'nottexture.dds'
                    icon = BWPersonality.GUICore.get_icon_from_cache(icon_name)
                    item_comp.texture = icon and icon
                else:
                    item_comp.textureName = icon_name
            else:
                item_comp.visible = False
        else:
            item_comp.visible = False
        return

    def run_blink(self):
        self.component.bg_blink.colour = (255, 0, 0, 150)
        shad = self.component.bg_blink.blink
        shad.value = 1.0
        shad.reset()
        shad.mode = 'ALL'
        shad.start = 1.0
        shad.stop = 0.0
        shad.alpha = 1
        shad.speed = 0.6
        shad.value = 0.0

    @property
    def disabled(self):
        self.component.disabler.visible

    @disabled.setter
    def disabled(self, value):
        self.component.disabler.visible = value
        self.lockSlot(value)