    def set_chance_provider(self, chance_provider):
        self._chance_provider = chance_provider

    def set_craft_recipe(self, craft_recipe):
        self._recipe = craft_recipe
        self._update_content()

    def dependencies_changed(self):
        self._update_content()

    def _update_content(self):
        if not self._recipe:
            self.component.hidecomp.visible = False
            self._slot.set_item_data(None)
            return
        else:
            craft_result = self._recipe['CraftResult']
            if not len(craft_result) == 1:
                raise AssertionError
                self.component.hidecomp.visible = True
                item_type, count = craft_result.items()[0]
                item_name = ItemsUtils.GetItemName(item_type, fGetShortName=True)
                text = u'<font=RobotoCondensedRegular_16.font><hlink={0};INFO:TYPE:{1}> {2} {3}'.format(item_name, item_type, count, lc('CraftWin.ui.pieces'))
                self._text_field.setText(text)
                self._slot.set_item_data({'item_type': item_type})
                needed_skill = self._recipe.get('NeededPerk')
                self._totaltext.text = CC.inactive_hex + lc('CraftWin.ui.neededskills')
                perk_name = needed_skill and lc('PerksSystem.name.id{0}'.format(needed_skill))
                self._totaltext.text += u'\n' + CC.active_hex + perk_name
            else:
                self._totaltext.text += u'\n' + CC.active_hex + '-'
            self._totaltext.text += u'\n{0}{1}{2} {3}%'.format(CC.inactive_hex, lc('CraftWin.ui.successchance'), CC.active_hex, int(self._chance_provider() * 100))
            time = int(self._recipe['CraftTime'] / 100.0)
            self._totaltext.text += u'\n{0}{1}{2} {3} {4}'.format(CC.inactive_hex, lc('CraftWin.ui.crafttime'), CC.active_hex, time, lc('CraftWin.ui.secs'))
            return

    def _on_slock_right_click(self):
        p = BigWorld.player()
        if not self._slot.itemData or p.isDestroyed or p.dead:
            return
        item_type = self._slot.itemData['item_type']
        actions = {'item_info:{0}'.format(item_type): lc('Inventory.INFO')}
        BWPersonality.GUICore.showContextMenu(ResultBlock.factoryString, actions)
        BWPersonality.GUICore.addListener('contextMenuEvent', self._on_context_event)

    def _on_context_event(self, interface_id, action_id, caption, event, data):
        if interface_id == ResultBlock.factoryString:
            if event == soGUI.soContextMenuComponent.EVENT_SELECT:
                if action_id.startswith('item_info'):
                    type_id = int(action_id.split(':')[1])
                    item = ItemsUtils.CreateFakeItem(type_id)
                    BWPersonality.GUICore.showItemInfo(item)
        BWPersonality.GUICore.removeListener('contextMenuEvent', self._on_context_event)

    def on_hide(self):
        BWPersonality.GUICore.removeListener('contextMenuEvent', self._on_context_event)