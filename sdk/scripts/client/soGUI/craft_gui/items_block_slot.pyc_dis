# Embedded file name: ./client/soGUI/craft_gui/items_block_slot.py
import BWPersonality
import ItemsUtils
import GUI
from slot import Slot
import colorCodes as CC
import BigWorld
from copy import deepcopy

class ItemsBlockSlot(Slot):
    factoryString = 'soGUI.craft_gui.items_block_slot.ItemsBlockSlot'
    ACCEPT_OK, REFUSE_STANDARD = xrange(2)

    def __init__(self, *args):
        Slot.__init__(self)
        self.component.crossFocus = True
        self.component.dragFocus = True
        self.component.dropFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.dragProxy = self.component.dragProxy
        self._onDragStart = self.on_drag_start
        self._onDragStop = self.on_drag_stop
        self.stored_items_changed_callback = lambda slot, added_items, removed_items: None
        self._filled = False

    def setupContent(self):
        Slot.setupContent(self)
        comp = GUI.Text()
        comp.font = 'ruRU_Cyrvetica_Extra_10i.font'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width, 0, 0.5)
        comp.width, comp.height = (30, 20)
        comp.colour = (255, 0, 0, 255)
        self.component.addChild(comp, 'count')
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 64
        cmp.height = 64
        cmp.colour = (255, 255, 255, 128)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.5)
        cmp.visible = False
        self.component.addChild(cmp, 'dragProxy')

    def on_drag_start(self):
        if not self.empty and self.usable:
            self.dragProxy.visible = True
            return True
        return False

    def on_drag_stop(self):
        self.dragProxy.visible = False
        return True

    def set_item_data(self, item_data):
        """ \xd0\xb3\xd0\xb4\xd0\xb5 item_data - \xd1\x8d\xd1\x82\xd0\xbe \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8c \xd1\x81 \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd0\xbc\xd0\xb8:
                        item_type, max_count, item_ids - \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd0\xb1\xd1\x8b\xd1\x87\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2,
                        item_ids - (\xd0\xbd\xd0\xb5 \xd0\xb1\xd0\xbe\xd0\xbb\xd1\x8c\xd1\x88\xd0\xb5 \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe) \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5\xd1\x80\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb2
        """
        old_items = set()
        if self.itemData:
            old_items = set(self.itemData['item_ids'])
        if item_data and 'item_ids' in item_data and 'item_type' not in item_data:
            if len(item_data['item_ids']) > 0:
                complex_item = ItemsUtils.GetComplexItemByID(self._craft_user, item_data['item_ids'][0])
                item_data['item_type'] = complex_item['complexItemType']
        item_data = deepcopy(item_data)
        if item_data and 'max_count' not in item_data and not item_data['item_ids'] and 'item_type' in item_data:
            del item_data['item_type']
        Slot.set_item_data(self, item_data)
        new_items = set()
        if self.itemData:
            new_items = set(self.itemData['item_ids'])
        added_items = new_items - old_items
        removed_items = old_items - new_items
        if added_items or removed_items:
            self.stored_items_changed_callback(self, added_items, removed_items)

    def set_item_ids(self, item_ids):
        item_data = deepcopy(self.itemData)
        item_data['item_ids'] = item_ids
        self.set_item_data(item_data)

    def append_item_id(self, item_id):
        item_data = deepcopy(self.itemData)
        item_data['item_ids'].append(item_id)
        self.set_item_data(item_data)

    def clear_item_ids(self):
        item_data = deepcopy(self.itemData)
        item_data['item_ids'] = []
        self.set_item_data(item_data)

    def validate_items(self, craft_recipe):
        if not self.haveItem():
            return
        bad_ids = []
        for item_id in self.itemData['item_ids']:
            item = ItemsUtils.GetComplexItemByID(self._craft_user, item_id)
            if item:
                self._craft_user.validate_craft_item(item, craft_recipe) or bad_ids.append(item_id)

        item_data = deepcopy(self.itemData)
        item_data['item_ids'] = filter(lambda item_id: item_id not in bad_ids, item_data['item_ids'])
        if not item_data['item_ids'] and 'max_count' not in item_data and 'item_type' in item_data:
            del item_data['item_type']
        self.set_item_data(item_data)

    def _applyItemData(self):
        Slot._applyItemData(self)
        self._filled = False
        if not self.itemData:
            self.component.count.visible = False
            self._empty = True
        else:
            icon_comp = self.component.item_icon
            count_comp = self.component.count
            count_comp.visible = True
            count = self._calc_count()
            needed_count = self.itemData['max_count']
            count_comp.text = '{0}/{1}'.format(count, needed_count)
            if count < needed_count:
                count_comp.colour = (255, 0, 0, 255)
                icon_comp.colour[3] = 128
            else:
                count_comp.colour = CC.buttons_rgba
                icon_comp.colour[3] = 255
                self._filled = True
            self._empty = count == 0
        if self.dragProxy:
            self.dragProxy.texture = self.component.item_icon.texture

    def on_out_screen_drop(self):
        if self.itemData:
            self.clear_item_ids()

    def compile_sufficient_item_ids(self):
        if not self.usable:
            return []
        count = 0
        item_ids = []
        for item_id in self.itemData['item_ids']:
            item = ItemsUtils.GetComplexItemByID(self._craft_user, item_id)
            if not item:
                continue
            item_ids.append(item_id)
            count += ItemsUtils.GetItemNumber(item)
            if count >= self.itemData['max_count']:
                break

        return item_ids

    def can_accept_item(self, complex_item):
        if not self.available:
            return self.REFUSE_STANDARD
        if not self.itemData:
            return self.REFUSE_STANDARD
        if self.itemData['item_type'] != complex_item['complexItemType']:
            return self.REFUSE_STANDARD
        return self.ACCEPT_OK

    def _calc_count(self):
        count = 0
        for item_id in self.itemData['item_ids']:
            item = ItemsUtils.GetComplexItemByID(self._craft_user, item_id)
            if item:
                count += ItemsUtils.GetItemNumber(item)

        return count

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip(self.factoryString)
        return Slot.handleMouseLeaveEvent(self, comp)

    def handleMouseEnterEvent(self, comp):
        if self.itemData:
            from Inventory import Inventory
            fake_item = ItemsUtils.CreateFakeItem(self.itemData['item_type'])
            try:
                ItemsUtils.SetItemNumber(fake_item, self._calc_count())
            except:
                pass

            text = Inventory.GetItemString(fake_item)
            BWPersonality.GUICore.showToolTip(CC.tf3_regular_text_color + text, tooltipID=self.factoryString)
        return Slot.handleMouseEnterEvent(self, comp)

    @property
    def available(self):
        """ \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82 \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xbe\xd0\xb9 \xd0\xb8 \xd0\xb2 \xd0\xbd\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb2\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82 """
        return self.usable and not self._filled

    @property
    def usable(self):
        """ \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82 \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f """
        return self.haveItem() and not self.disabled

    @property
    def empty(self):
        """ \xd0\xb2 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c, \xd0\xbd\xd0\xbe \xd0\xbe\xd0\xbd \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xbe\xd0\xb9 """
        return self.usable and self._empty

    @property
    def filled(self):
        """ \xd0\xb2 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82 \xd0\xb2\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c\xd1\x8e """
        return self.usable and self._filled

    @property
    def _craft_user(self):
        return BigWorld.player()