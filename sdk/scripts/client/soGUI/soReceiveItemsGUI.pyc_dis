class soReceiveItemsGUI(PyGUIBase, DraggableComponent, GUIPositions):
    factoryString = 'soGUI.soReceiveItemsGUI'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        GUIPositions.__init__(self)
        component.script = self
        self.available = True
        self.current_event = None
        self.item_holder = None
        self.remaining_items = 0
        self.reward_list_window = None
        self.need_slots = []
        self.setupRoot()
        self.setupControls()
        return

