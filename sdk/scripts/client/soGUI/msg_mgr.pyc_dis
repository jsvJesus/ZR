"""\xd0\x9c\xd0\xbe\xd0\xb4\xd1\x83\xd0\xbb\xd1\x8c \xd1\x80\xd0\xb5\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xba\xd0\xb8 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xb8\xd0\xb7/\xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f."""
import re
import time
import BigWorld
import BWPersonality
import msgchecker
import ResMgr
import sounds_manager
from ChatChannelConfig import ChannelConsts
from Settings import Settings
from Localization import lc
import words_filter
CHANNEL_CONST = ChannelConsts()
NEED_RETURN_MSG = set([CHANNEL_CONST.TRADE, CHANNEL_CONST.GENERAL, CHANNEL_CONST.WHISPER])
CENSORED_CHNLS = set([CHANNEL_CONST.GENERAL,
 CHANNEL_CONST.TRADE,
 CHANNEL_CONST.GROUP,
 CHANNEL_CONST.CLAN,
 CHANNEL_CONST.WHISPER])
URL_PATT = u'http[s]?://(?:[a-zA-Z\u0430-\u044f\u0410-\u042f]|[0-9]|[$-_@.&+]|[!*\\(\\),]|(?:%[0-9a-fA-F\u0430-\u044f\u0410-\u042f][0-9a-fA-F\u0430-\u044f\u0410-\u042f]))+'

class AttrFromSettings(object):
    """
    \xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x81\xd0\xb2\xd0\xbe\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2 (\xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 \xd0\xb4\xd0\xb5\xd1\x81\xd0\xba\xd1\x80\xd0\xb8\xd0\xbf\xd1\x82\xd0\xbe\xd1\x80), \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd1\x85
    \xd0\xbf\xd0\xbe \xd1\x84\xd0\xb0\xd0\xba\xd1\x82\xd1\x83 \xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x8f\xd1\x82\xd1\x81\xd1\x8f \xd0\xb2 Settings.Settings.
    """

    def __init__(self, name, deafult = None):
        self.name = name
        self.deafult = deafult

    def __get__(self, instance, owner = None):
        if instance is None:
            return self
        else:
            value = Settings().getSetting(self.name, self.deafult)
            return value

    def __set__(self, instance, value):
        Settings().setSetting(self.name, value, flush=True)


class MessageManager(object):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xba\xd0\xb8, \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb8 \xd0\xbe\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xba\xd0\xb8 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb9."""
    chatabuse = AttrFromSettings('chatabuse', False)

    def __init__(self, chat):
        self._chat = chat
        self._msg_checker = msgchecker.ClientMsgChecker()
        bad_words_path = 'scripts/client/data/Chat/badwords.txt'
        text = ResMgr.openSection(bad_words_path).asBinary
        text = text.replace('\r', '')
        words = text.split('\n')
        url_patt = re.compile(URL_PATT, re.IGNORECASE | re.UNICODE)
        comment_patt = re.compile(u'-.*?-', re.MULTILINE | re.UNICODE)
        self._words_filter = words_filter.WordsFilter(words, u'*', url_patt, comment_patt)

    def print_msg(self, channel_id, text, sender = u'', additional = u''):
        """\xd0\x92\xd1\x8b\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb5."""
        friend = None
        if CHANNEL_CONST.WHISPER == channel_id:
            friend = BigWorld.player().is_friend(sender)
        data = self._wrap_msg_data(channel_id, text)
        if friend is not None:
            data['friend'] = friend
        if sender:
            data['sender'] = sender
        data['additional'] = additional
        return data

    def replace_bad_words(self, string):
        """\xd0\x97\xd0\xb0\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb7\xd0\xb2\xd1\x91\xd0\xb7\xd0\xb4\xd0\xbe\xd1\x87\xd0\xba\xd0\xb0\xd0\xbc\xd0\xb8 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb5\xd1\x89\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0."""
        string = self._words_filter.replace_bad_words(string)
        return string

    def send_msg(self, channel_id, text, receiver):
        """\xd0\x9e\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80 \xd0\xb8 \xd0\xb2\xd1\x8b\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82 \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb5."""
        if not text:
            return
        if channel_id in NEED_RETURN_MSG:
            self._return_msg(channel_id, text, receiver)
        do_send, system_text = self._check_text(text, channel_id)
        if do_send:
            BigWorld.player().send_message(channel_id, text, receiver)
        else:
            not_be_delivered = lc('Common.chat.WILL_NOT_BE_DELIVERED', utf8=True)
            msg = '{0} {1}'.format(system_text, not_be_delivered)
            self._chat.print_msg_to_chat(CHANNEL_CONST.SYSTEM, msg)

    def _check_text(self, text, channel_id):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbd\xd0\xb0 \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbe\xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f."""
        result, reason = self._msg_checker.can_it_be_sent(text, channel_id)
        if self._msg_checker.is_exceed_spam_limit():
            pass
        return (result, reason)

    def _is_latin_chars(self, text):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2\xd1\x81\xd0\xb5 \xd0\xbb\xd0\xb8 \xd1\x81\xd0\xb8\xd0\xbc\xd0\xb2\xd0\xbe\xd0\xbb\xd1\x8b \xd1\x81 \xd0\xb0\xd0\xbd\xd0\xb3\xd0\xbb\xd0\xb8\xd0\xb9\xd1\x81\xd0\xba\xd0\xbe\xd0\xb9 \xd1\x80\xd0\xb0\xd1\x81\xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd0\xb8 \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xb8\xd0\xb0\xd1\x82\xd1\x83\xd1\x80\xd1\x8b."""
        all_is_eng = not any((ord(ch) > 128 for ch in text))
        return all_is_eng

    def _return_msg(self, channel_id, text, receiver):
        """\xd0\x9e\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb8 \xd0\xb2\xd0\xb5\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82."""
        data = self._wrap_msg_data(channel_id, text)
        data['receiver'] = receiver
        self._chat.returned_msg(data)

    def _wrap_msg_data(self, channel_id, text):
        """
        \xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb8 \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb5
        \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4 \xd0\xbe\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xba\xd0\xbe\xd0\xb9 \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82.
        """
        only_latin = False
        if not self.chatabuse and channel_id in CENSORED_CHNLS:
            text = self.replace_bad_words(text)
            only_latin = self._is_latin_chars(text)
        struct_time = time.localtime()
        loc_time = '{h:0>2}:{m:0>2}:{s:0>2}'.format(h=struct_time.tm_hour, m=struct_time.tm_min, s=struct_time.tm_sec)
        data = {'channel_id': channel_id,
         'text': text if isinstance(text, str) else text.encode('utf-8'),
         'time': loc_time,
         'only_latin': only_latin}
        return data