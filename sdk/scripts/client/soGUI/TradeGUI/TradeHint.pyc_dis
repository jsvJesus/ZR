# Embedded file name: ./client/soGUI/TradeGUI/TradeHint.py
import GUI
from Helpers.PyGUI import PyGUIBase
from soGUI.soTextField import soTextField3
import BWPersonality
import colorCodes
import math
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
import BigWorld

class TradeHint(PyGUIBase):

    def __init__(self):
        component = GUI.Window()
        component.horizontalPositionMode = component.verticalPositionMode = 'CLIP'
        component.horizontalAnchor = 'CENTER'
        component.verticalAnchor = 'CENTER'
        component.widthMode = component.heightMode = 'PIXEL'
        component.colour = (255, 255, 255, 255)
        component.materialFX = 'BLEND'
        component.position = (0, -0.5, 0)
        component.visible = False
        PyGUIBase.__init__(self, component)
        component.script = self
        self._alpha_components = [component]

        class EmptyCoroutine:

            def stop(self):
                pass

        self._coroutine = EmptyCoroutine()
        self._setup_content()
        self.alpha = 0

    def _setup_content(self):
        cmp = GUI.Frame2('soGUI/frame/tt_frame.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.width = cmp.height = 2.0
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp)
        self._alpha_components.append(cmp)
        self._text_field = soTextField3(GUI.Window(), width=300, height=100, textWidth=-1, hScroll=False, vScroll=False, hideScroll=False, borderWidth=0, vOffset=0, hOffset=0, textureless=True, autosize=True)
        cmp = self._text_field.component
        cmp.materialFX = 'BLEND'
        cmp.textRendererPlane.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (11, 11, 0.2)
        self.component.addChild(cmp)
        self._text_field.onBound()
        self._alpha_components.append(cmp)
        self._text_renderer = cmp.textRendererPlane

    @property
    def alpha(self):
        return self._alpha

    @alpha.setter
    def alpha(self, value):
        self._alpha = value
        color_alpha = math.ceil(value * 255)
        for child in self._alpha_components + [ c[1] for c in self._text_renderer.children ]:
            child.colour[3] = color_alpha

    def show(self, autofade = True):
        """        \xd0\xbe\xd0\xba\xd0\xbe\xd1\x88\xd0\xba\xd0\xbe \xd1\x81 \xd1\x85\xd0\xb8\xd0\xbd\xd1\x82\xd0\xbe\xd0\xbc
                        autofade - \xd1\x81\xd0\xb0\xd0\xbc\xd0\xbe \xd0\xb0\xd0\xb2\xd1\x82\xd0\xbe\xd0\xbc\xd0\xb0\xd1\x82\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb3\xd0\xb0\xd1\x81\xd0\xbd\xd0\xb5\xd1\x82 (\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5 \xd0\xb3\xd0\xb0\xd1\x81\xd0\xb8\xd1\x82\xd1\x8c fade_now)
        """
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'TradeHintLayerName')
        self.component.visible = True
        self._coroutine.stop()
        self._coroutine = self._fade_coroutine(autofade)
        self._coroutine.run()
        return

    def fade_now(self):
        self._coroutine.stop()
        if not self.component.visible:
            return
        self._coroutine = self._unfade()
        self._coroutine.run()

    @BWMemberCoroutine
    def _unfade(self):
        while self.alpha > 0.0:
            self.alpha = max(0, self.alpha - BigWorld.getTimeDelta() * 5.0)
            yield BWWaitForPeriod(0.0)

        self.hide()

    @BWMemberCoroutine
    def _fade_coroutine(self, autofade):
        while self.alpha < 1.0:
            self.alpha = min(1.0, self.alpha + BigWorld.getTimeDelta() * 5.0)
            yield BWWaitForPeriod(0.0)

        if autofade:
            yield BWWaitForPeriod(3.0)
            while self.alpha > 0.0:
                self.alpha = max(0, self.alpha - BigWorld.getTimeDelta() * 5.0)
                yield BWWaitForPeriod(0.0)

            self.hide()

    def set_text(self, text):
        self._text_field.setText(colorCodes.tf3_regular_text_color + text)
        self._text_field.renderText()
        self._update_dims()

    def _update_dims(self):
        self.component.width = self._text_field.component.width + 22
        self.component.height = self._text_field.component.height + 22

    def hide(self):
        self.component.visible = False