class PendTextMoney(TextMoney):

    def setValue(self, money):
        if money is None:
            TextMoney.setValue(self, 0)
            self.moneyLabel.text = u'???'
        else:
            TextMoney.setValue(self, money)
        return


class ItemBox(PyGUIBase):
    factoryString = 'soGUI.ItemBox'

    def __init__(self, component, cols, rows, tradescreen, title, max_size = 32, neck = 0):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._neck = neck
        self._cols = cols
        self._rows = rows
        self._max_size = max_size
        self._tradescreen = tradescreen
        self._title = title
        self.component.focus = True
        self.setup_content()
        self.reset()

    def handleKeyEvent(self, event):
        return event.key in (Keys.KEY_LCONTROL, Keys.KEY_RCONTROL)

    def get_slot_class(self):
        return TradeSlot

    def setup_content(self):
        cmp = GUI.Frame2('soGUI/frame/basic_frame_1.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = self.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 2
        cmp.height = 2
        cmp.position = (0, 0, 1.0)
        self.component.addChild(cmp, 'frame')
        cmp.heightMode = 'PIXEL'
        cmp.widthMode = 'PIXEL'
        self._item_view = soItemView(GUI.Window(), self.get_slot_class(), slot_eventsHandler=self.slot_handler, rowWidth=self._cols, rows=self._rows, cols=self._cols, hScroll=False)
        cmp = self._item_view.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = 'CLIP'
        cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = self.component.frame.width
        cmp.height = self.component.frame.height - 68 - self._neck
        cmp.position = (4, 29 + self._neck, 0.5)
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        self.component.frame.addChild(cmp, 'item_view')
        self._item_view.onBound()
        self._item_view.setRestrictingComponent(None)
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/elements/closeBox.xml')
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 18
        cmp.position = (self.component.frame.width - 8, 8, 0.2)
        btn.onClick = self.on_close
        self.component.frame.addChild(cmp)
        btn.onBound()
        btn._updateVisualState()
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colourFormatting = True
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (12, 6, 0.2)
        cmp.text = self._title
        self.component.frame.addChild(cmp, 'title')
        return

    def set_title(self, title):
        self._title = title
        self.component.frame.title.text = self._title

    def slot_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DROP:
            slot = data[1]
            if slot.factoryString == 'soGUI.soInventorySlot2':
                item_ids = slot.get_multiselection()
                items_data = ItemsUtils.get_multiple_items_by_ids(BigWorld.player(), item_ids)
            else:
                if not hasattr(slot, 'haveItem'):
                    return
                if not slot.haveItem():
                    return
                items_data = [slot.itemData]
            items_data = filter(lambda i: bool(i), items_data)
            if items_data:
                self.on_drop_items(slot.factoryString, items_data)
        elif event == ITSLOT.SLOTEVENT_DBLCLICK:
            if data.itemData:
                self.on_dbl_click(data.itemData)
        return True

    def on_close(self):
        self._tradescreen.on_close()

    def on_drop_items(self, source_factory_string, items_data):
        pass

    def on_dbl_click(self, item_data):
        pass

    def remove_item(self, item_id):
        for i in xrange(len(self.items)):
            if self.items[i]['complexItemID'] == item_id:
                del self.items[i]
                self.update_items()
                break

    def decrease_count(self, item_id, count, artic = None):
        for i in xrange(len(self.items)):
            if self.items[i]['complexItemID'] != item_id:
                continue
            if artic is not None and 'artic' in self.items[i]:
                if self.items[i]['artic'] != artic:
                    continue
            self.items[i]['count'] -= count
            if self.items[i]['count'] <= 0:
                del self.items[i]
            else:
                ItemsUtils.SetItemNumber(self.items[i], self.items[i]['count'])
            self.update_items()
            break

        return

    def set_items(self, items):
        self._item_view.setItems(items)
        self.on_items_updated()

    def update_items(self):
        self._item_view.setItems(self.items)
        self.on_items_updated()

    def add_item(self, item_data):

        def items_equals(item1, item2):
            if item1.get('complexItemID', 0) != item2.get('complexItemID', 0):
                return False
            if item1.get('artic', 0) != item2.get('artic', 0):
                return False
            return True

        found_item = None
        if ItemsUtils.isStackedItemType(item_data['complexItemType']):
            found_item = next((item for item in self.items if items_equals(item, item_data)), None)
            if found_item:
                cur_item_inc_param = ItemsUtils.GetComplexItemInconstanParams(found_item)
                cur_item_number = ItemsUtils.GetItemNumber(found_item, cur_item_inc_param)
                apppend_item_number = ItemsUtils.GetItemNumber(item_data)
                number = cur_item_number + apppend_item_number
                ItemsUtils.SetItemNumber(found_item, number, cur_item_inc_param)
                found_item['count'] = number
        if not found_item:
            if len(self.items) >= self._max_size:
                self._tradescreen.on_items_max_size()
                return False
            self.items.append(item_data)
        self.update_items()
        return True

    def show(self):
        self._item_view.setItems([])
        self.component.visible = True

    def get_slots_available(self):
        return self._max_size - len(self.items)

    @property
    def visible(self):
        return self.component.visible

    @property
    def items(self):
        return self._item_view.items

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.setBestCursor()
        self.reset()

    def reset(self):
        had_items = bool(self.items)
        self._item_view.setItems([])
        if had_items:
            self.on_items_updated()

    def on_items_updated(self):
        pass


class GoldMoneyItemBox(ItemBox):
    factoryString = 'soGUI.GoldMoneyItemBox'

    def __init__(self, component, cols, rows, trade_screen, title, max_size = 24):
        ItemBox.__init__(self, component, cols, rows, trade_screen, title, max_size=max_size, neck=30)
