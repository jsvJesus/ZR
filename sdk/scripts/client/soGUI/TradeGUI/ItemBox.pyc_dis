        cmp = money.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (28, 32, 0.3)
        self.component.frame.addChild(cmp, 'textmoney')
        money.onBound()
        money.setValue(u'0')
        cmp = GUI.Window()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 200)
        cmp.materialFX = 'BLEND'
        cmp.height = self.component.frame.height - 64
        cmp.width = self.component.width - 6
        cmp.position = (4, 28, 0.1)
        cmp.visible = False
        Interceptor(cmp)
        comp = GUI.Frame2('soGUI/frame/confirm_frame.dds')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        cmp.addChild(comp, 'pane')
        self.component.frame.addChild(cmp, 'confirm_pane')
        comp = GUI.Text(lc('soTradeInterface.tradescreen.CREDITS'))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (100, 20)
        comp.position = (162, 36, 0.3)
        comp.font = 'RobotoCondensedRegular_14.font'
        comp.colour = (146, 146, 146, 255)
        self.component.frame.addChild(comp, 'credits')
        hintBox = soButton(GUI.Window())
        comp = hintBox.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'RIGHT'
        comp.verticalAnchor = 'TOP'
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.width = 18
        comp.height = 18
        comp.position = (self.component.frame.width - 30, 8, 0.3)
        hintBox.initVSC('soGUI/elements/helpBox.xml')
        hintBox.onBound()
        hintBox.onClick = self.on_hint_click
        hintBox.setVisualState('normal')
        self.component.addChild(comp)

    def on_hint_click(self):
        BWPersonality.GUICore.openGUIHelp('soTradeInterface')

    def lock(self, lock):
        self.component.frame.confirm_pane.visible = lock

    @property
    def locked(self):
        return self.component.frame.confirm_pane.visible

    def reset(self):
        ItemBox.reset(self)
        self.lock(False)

    def get_items_cost(self):
        money = 0
        credits = 0
        for item_data in self.items:
            count = item_data.get('count', 1)
            money += item_data.get('price', 0) * count
            credits += item_data.get('credits', 0) * count

        return (money, credits)

    def do_reposition(self):
        pass

    def calc_credits(self):
        return sum((item_data['credits'] * item_data['count'] for item_data in self.items))

    @property
    def money(self):
        return int(self.component.frame.textmoney.script.getValue())

    @money.setter
    def money(self, value):
        return self.component.frame.textmoney.script.setValue(value)

    @property
    def credits(self):
        return self._credits

    @credits.setter
    def credits(self, value):
        self._credits = value
        self.component.frame.credits.text = lc('soTradeInterface.tradescreen.CREDITS').format(value)