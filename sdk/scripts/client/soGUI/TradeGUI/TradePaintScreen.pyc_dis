class DragWin(PyGUIBase, DraggableComponent, GUIPositions):

    def __init__(self, component, gui_pos_id):
        self._gui_pos_id = gui_pos_id
        PyGUIBase.__init__(self, component)
        GUIPositions.__init__(self)
        DraggableComponent.__init__(self, True, True, True)
        component.script = self

    def show(self):
        if self.component.visible:
            return
        self.component.visible = True
        GUIPositions.show(self)

    def hide(self):
        if not self.component.visible:
            return
        self.component.visible = False

    @property
    def gui_positions_id(self):
        return self._gui_pos_id

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def stopDragging(self):
        DraggableComponent.stopDragging(self)
        GUIPositions.stopDragging(self)


class TradePaintScreen:

    def __init__(self):
        self._tradehint = TradeHint()

        def simple_win(parent):
            comp = GUI.Window()
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = parent.width, parent.height
            comp.position = (0, 0, 0.5)
            comp.visible = False
            return comp

        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.height = 98 + Constants.GIVE_SIZE[1] * Constants.SLOT_SIZE
        comp.width = 24 + Constants.GIVE_SIZE[0] * Constants.SLOT_SIZE
        comp.position = (0, -0.8, 0.3)
        comp.visible = False
        comp.dragFocus = True
        comp.mouseButtonFocus = True
        DragWin(comp, 'tradepaint_give_comp')
        self._give_comp = comp
        self._trade_give_comp = simple_win(self._give_comp)
        self._give_comp.addChild(self._trade_give_comp, 'tradegive')
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.height = 98 + Constants.RECIEVE_SIZE[1] * Constants.SLOT_SIZE
        comp.width = 24 + Constants.RECIEVE_SIZE[0] * Constants.SLOT_SIZE
        comp.dragFocus = True
        comp.mouseButtonFocus = True
        comp.position = (0, -0.8, 0.3)
        comp.visible = False
        DragWin(comp, 'tradepaint_recieve_comp')
        self._recieve_comp = comp
        self._trade_recieve_comp = simple_win(self._recieve_comp)
        self._recieve_comp.addChild(self._trade_recieve_comp, 'traderecieve')
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.height = 100 + Constants.SELL_SIZE[1] * Constants.SLOT_SIZE
        comp.width = 24 + Constants.SELL_SIZE[0] * Constants.SLOT_SIZE
        comp.dragFocus = True
        comp.mouseButtonFocus = True
        comp.position = (-1, -1, 0.6)
        comp.visible = False
        DragWin(comp, 'tradepaint_sell_comp')
        self._sell_comp = comp
        self._trade_sell_comp = simple_win(self._sell_comp)
        self._sell_comp.addChild(self._trade_sell_comp, 'tradesellbox')
        self.trade_screen = TradeScreen(self._trade_give_comp, self._trade_recieve_comp, self._trade_sell_comp, self._tradehint)
        self.trade_screen.on_close_click = self._on_close
        self.visible = False

    def _on_close(self):
        self.hide()

    def on_inventory_dbl_click(self, item_data):
        self.trade_screen.on_inventory_dbl_click(item_data)

    def on_inventory_shift_click(self, item_data):
        self.trade_screen.on_inventory_shift_click(item_data)

    def on_inventory_ctrl_click(self, item_data):
        self.trade_screen.on_inventory_ctrl_click(item_data)

    def hide(self):
        if not self.visible:
            return
        self.visible = False
        self.trade_screen.hide()
        self._give_comp.script.hide()
        self._recieve_comp.script.hide()
        self._sell_comp.script.hide()
        self._tradehint.fade_now()
        self._delegate.on_trade_hidden()

    def is_item_locked(self, item_id):
        return self.trade_screen.is_item_locked(item_id)

    def show(self, seller):
        if self.visible:
            return
        else:
            self.visible = True
            if self._give_comp.parent is None:
                layer = BWPersonality.GUICore.worldLayer
                layer.addChild(self._give_comp, 'trade_give_comp')
                layer.addChild(self._recieve_comp, 'trade_recieve_comp')
                layer.addChild(self._sell_comp, 'trade_sell_comp')
            self.trade_screen.show()
            self._delegate.on_trade_shown()
            self._give_comp.script.show()
            self._recieve_comp.script.show()
            self._sell_comp.script.show()
            return

    def apply_item_sell_filter(self, item):
        return self.trade_screen.apply_item_sell_filter(item)

    def doReposition(self):
        self.trade_screen.doReposition()

    @property
    def visible(self):
        return self._visible

    @property
    def _delegate(self):
        return BigWorld.player()