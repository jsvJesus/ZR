class SellTradeSlot(TradeSlot):
    factoryString = 'soGUI.SellTradeSlot'
    rep_icon = None

    @staticmethod
    def get_rep_icon_texture_provider():
        if not SellTradeSlot.rep_icon:
            SellTradeSlot.rep_icon = BigWorld.PyTextureProvider('soGUI/items/item_buy_reputation.dds')
        return SellTradeSlot.rep_icon

    def get_context_menu_actions(self):
        actions = TradeSlot.get_context_menu_actions(self)
        if not self.trade_locked and self._trade_screen.can_add_items():
            if self.itemData.get('selltype') == 'unexhausted' or self.itemData['count'] > 1:
                actions[TradeSlot.EVENT_ADD] = lc('Inventory.client.ADD_ITEMS')
        return actions

    def prepare_item_before_show_infow_window(self, complex_item):
        complex_item = TradeSlot.prepare_item_before_show_infow_window(self, complex_item)
        SellTradeSlot.validate_randomness_and_insert_weapon_attaches(complex_item)
        return complex_item

    @staticmethod
    def validate_randomness_and_insert_weapon_attaches(complex_item):
        try:
            item_type = complex_item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            if item_class == ItemsCatalog.WEAPON and complex_item.get('selltype') == 'unexhausted':
                boxname = ItemsCatalog.GetItemParam(item_type).get('AttachShopBB')
                if boxname:
                    bb_data = BlackBox.ShopattachesBox(boxname)._data
                    sub_types = []
                    for gr in bb_data['groups']:
                        raise gr['chance'] == 100 or AssertionError
                        raise gr['rangeTo'] == 1 or AssertionError
                        raise gr['rangeFrom'] == 1 or AssertionError
                        raise len(gr['items']) == 1 or AssertionError
                        for gr_item in gr['items']:
                            raise gr_item['dropChance'] == 100 or AssertionError
                            raise gr_item['rangeTo'] == 1 or AssertionError
                            raise gr_item['rangeFrom'] == 1 or AssertionError
                            sub_types.append(gr_item['itemID'])

                    sub_items = []
                    for sub_type in sub_types:
                        sub_item = ItemsUtils.CreateItem(BigWorld.player, sub_type, -1)
                        sub_items.append(ItemsUtils.ConvertItemToSubItemWeapon(sub_item))

                    complex_item['itemList'].extend(sub_items)
        except:
            print 'SellItemBox (ERROR):', boxname, complex_item
            traceback.print_exc()

        return complex_item

    def context_menu_event(self, interface_id, eventid, caption, event, data = None):
        TradeSlot.context_menu_event(self, interface_id, eventid, caption, event, data)
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            if eventid == TradeSlot.EVENT_ADD:
                self.show_add_number_dialog()

    def setupContent(self):
        TradeSlot.setupContent(self)
        comp = GUI.Simple('')
        comp.texture = SellTradeSlot.get_rep_icon_texture_provider()
        comp.verticalPositionMode, comp.horizontalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (4, 4, 0.3)
        comp.materialFX = 'BLEND'
        comp.visible = False
        self.component.addChild(comp, 'rep_icon')

    def show_add_number_dialog(self):

        def add_number_to_buy(event, data):
            if event == MESSAGEBOX.EVENT_BTNPRESS:
                if data['btn'] == MESSAGEBOX.BTN_ALL:
                    edit_box.setValue(str(self.itemData['count']))
                elif data['btn'] == MESSAGEBOX.BTN_OK:
                    text = data['add_controls']['edit_box']
                    if text.isdigit():
                        if ItemsUtils.isStackedItemType(self.itemData['complexItemType']):
                            count = min(int(text), self.itemData.get('count', sys.maxint))
                        else:
                            count = min(int(text), self._trade_screen.get_recive_slots_available())
                        if count > 0:
                            self.add_number_to_buy(count)
            elif event == MESSAGEBOX.EVENT_CLOSE or event == MESSAGEBOX.EVENT_CLOSE_NONUSER:
                self._msg_box = None
            return

        def input_validator(newStr, wholeText, offset):
            if not number_input_validator(newStr, wholeText, offset):
                return False
            if ItemsUtils.isStackedItemType(self.itemData['complexItemType']):
                return True
            total = int(wholeText + newStr)
            return total <= self._trade_screen.get_recive_slots_available()

        self._msg_box = msgbox_templates.input_box_ok_all_cancel('Inventory.add_number_to_buy', lc('GUI.Inventory.BUY_CAPTION'), lc('GUI.Inventory.BUY_TEXT_ADD'), callback=add_number_to_buy, default='1', input_validator=input_validator)
        edit_box = self._msg_box.component.edit_edit_box.script
        all_btn = self._msg_box.component.btn_9.script
        if self.itemData['selltype'] == 'unexhausted':
            all_btn.setDisabledState(True)

        def intercept_input(event):
            if event.key == Keys.KEY_F and not all_btn.buttonDisabled:
                edit_box.setValue(str(self.itemData['count']))
                return True
            return False

        edit_box.select([0, 0], [0, 1])
        edit_box.keys_interceptor = intercept_input

    def _applyItemData(self):
        TradeSlot._applyItemData(self)
        self.trade_locked = False
        self.component.rep_icon.visible = False
        if self.haveItem():
            credits = self.itemData['credits']
            if credits:
                self.component.rep_icon.visible = True
                relation = self.get_seller_relation()
                if credits > relation:
                    self.trade_locked = True

    def add_number_to_buy(self, count):
        if self.itemData:
            if self.itemData['selltype'] == 'exhausted':
                count = min(count, self.itemData['count'])
            BWPersonality.GUICore.trade_screen.on_slot_add_item_count(self.itemData, count)

    def get_count_text(self):
        if self.itemData['selltype'] == 'unexhausted':
            return u'\u221e'
        elif ItemsUtils.isStackedItemType(self.itemData['complexItemType']):
            return str(self.itemData['count'])
        else:
            return ''

    def get_seller_reputation(self, fraction_id):
        return BigWorld.player().getFractionRelationship(fraction_id)

    def get_seller_relation(self):
        return BigWorld.player().get_personal_relation()


class SellItemBox(ItemBox):
    factoryString = 'soGUI.SellItemBox'

    def __init__(self, trade_screen, component):
        self._tradepoints_interface_id = SellItemBox.factoryString
        ItemBox.__init__(self, component, Constants.SELL_SIZE[0], Constants.SELL_SIZE[1], trade_screen, lc('soTradeInterface.tradescreen.SELLBOX_TITLE'), max_size=256, neck=30)
        self.unfiltered_items = []
        self._hidden_items = {}
        self._filter_text = ''
        self._inited = False
        self._money = 0
        component = GUI.Window()
        component.horizontalPositionMode = component.verticalPositionMode = 'CLIP'
        component.horizontalAnchor = 'RIGHT'
        component.verticalAnchor = 'TOP'
        component.position = (1, 1, 0.5)
        component.widthMode = component.heightMode = 'PIXEL'
        component.width = 200
        component.height = 50
        component.materialFX = 'BLEND'
        self._filter_box = FilterSet(component, self._filter_changed)
        self.component.addChild(component)

    def reset(self):
        ItemBox.reset(self)
        self._inited = False

    def _update_title(self, fract_id = None):
        player = BigWorld.player()
        npc_name = player.get_last_trader_name()
        npc_local_name = NPCs.getName(npc_name, player)
        text = lc('soTradeInterface.tradescreen.SELLBOX_TITLE').format(npc_local_name)
        if fract_id:
            text += u' ({0})'.format(rep_utils.get_name(fract_id))
        self.set_title(text)

    def show(self):
        self._update_title()
        self.set_credits(None)
        BWPersonality.GUICore.removeListener('hlinkEvent', self._hlink_event)
        BWPersonality.GUICore.addListener('hlinkEvent', self._hlink_event)
        ItemBox.show(self)
        if not self._inited:
            self._inited = True
            self._tradescreen.request_trade_data()
        return

    def _hlink_event(self, event, data):
        if event != HyperLink.EVENT_CLICK:
            return
        data, interface_id = data
        if interface_id == self._tradepoints_interface_id:
            npc_name = BigWorld.player().get_last_trader_name()
            group_id = AP.get_npc_tradegroup(npc_name)
            if group_id:
                BWPersonality.GUICore.journal_win.show_reptab(group_id)

    def setup_content(self):
        ItemBox.setup_content(self)
        quick_search_width = 256
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (146, 146, 146, 255)
        cmp.materialFX = 'BLEND'
        cmp.text = lc('soTradeInterface.tradescreen.QUICK_SEARCH')
        cmp.position = (self.component.width - 16 - quick_search_width, 34, 0.3)
        self.component.addChild(cmp)
        component = GUI.Window()
        component.horizontalPositionMode = component.verticalPositionMode = 'PIXEL'
        component.horizontalAnchor = 'RIGHT'
        component.verticalAnchor = 'TOP'
        component.widthMode = component.heightMode = 'PIXEL'
        component.position = (self.component.width - 8, 32, 0.3)
        self._filter_edit = FilterEditBox(component, 20, quick_search_width, self._filter_text_changed)
        self.component.frame.addChild(component)
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.width, comp.height = (500, 20)
        comp.position = (28, -0.97, 0.5)
        txt = soTextField3(comp, comp.width, comp.height, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        txt.INTERFACE_ID = self._tradepoints_interface_id
        self.component.frame.addChild(comp, 'credits')
        comp = GUI.Simple('soGUI/frame/minimap/trade.dds')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.colour = (157, 64, 17, 255)
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (8, -0.95, 0.1)
        self.component.addChild(comp)

    def set_credits(self, value):
        if value is None:
            self.component.frame.credits.visible = False
            return
        else:
            npc_name = BigWorld.player().get_last_trader_name()
            group_id = AP.get_npc_tradegroup(npc_name)
            if group_id is None:
                self.component.frame.credits.visible = False
                return
            group_name = rep_utils.get_name(group_id)
            text = u'<hlink={0}: {1};>'.format(group_name, value)
            self.component.frame.credits.script.setText(text, immidiate=True)
            self.component.frame.credits.visible = True
            return

    def hide(self):
        ItemBox.hide(self)
        self._filter_edit.activate(False)
        BWPersonality.GUICore.removeListener('hlinkEvent', self._hlink_event)

    def _filter_text_changed(self, text):
        self._filter_text = text
        self._update_assortment()

    def _filter_changed(self, filter_mask):
        self._update_assortment()

    def handleMouseButtonEvent(self, comp, event):
        self._filter_edit.activate(False)
        return ItemBox.handleMouseButtonEvent(self, comp, event)

    def slot_handler(self, event, data):
        if event == ITSLOT.SLOTEVENT_DBLCLICK:
            if data.trade_locked:
                return False
        if event == ITSLOT.SLOTEVENT_MOUSEBUTTON:
            if data[0].trade_locked:
                return False
            self._filter_edit.activate(False)
            if data[1].key == Keys.KEY_MIDDLEMOUSE and data[1].isKeyDown() and self._tradescreen.can_add_items():
                data[0].show_add_number_dialog()
                return True
        return ItemBox.slot_handler(self, event, data)

    def set_assortment(self, assortment, keepitems, rep_id):
        self._update_title(rep_id)

        def create_unlimited_fake_item(item):
            type_id = item['type_id']
            fake_item = ItemsUtils.CreateFakeItem(type_id)
            fake_item['price'] = item['money']
            fake_item['selltype'] = 'unexhausted'
            fake_item['credits'] = item['credits']
            fake_item['artic'] = item['artic']
            if ItemsUtils.isStackedItemType(type_id):
                ItemsUtils.SetItemNumber(fake_item, '~')
            return fake_item

        def create_unique_item(item):
            complex_item = deepcopy(item)
            complex_item['price'] = ItemsUtils.get_rated_price(item)
            complex_item['selltype'] = 'unique'
            complex_item['count'] = ItemsUtils.GetItemNumber(item)
            complex_item['credits'] = 0
            return complex_item

        unlimited_fake_items = map(create_unlimited_fake_item, assortment)
        unique_items = map(create_unique_item, keepitems)
        self.unfiltered_items = self._sort_items(unlimited_fake_items + unique_items)
        self._update_assortment()
        self.set_credits(self.get_seller_relation())

    def _sort_items(self, items):

        def comparator(item):
            item_type = item['complexItemType']
            item_param = ItemsCatalog.GetItemParam(item_type)
            return (item_param.get('SortID', 0), item_type, item['price'])

        return sorted(items, key=comparator)

    def _update_assortment(self):
        visible_items = self._filter_items(self.unfiltered_items)
        self._item_view.setItems(visible_items)

    def remove_item(self, item_id):
        ItemBox.remove_item(self, item_id)
        for i in xrange(len(self.unfiltered_items)):
            if self.unfiltered_items[i]['complexItemID'] == item_id:
                del self.unfiltered_items[i]
                break

    def decrease_count(self, item_id, count, artic = None):
        ItemBox.decrease_count(self, item_id, count, artic)
        for i in xrange(len(self.unfiltered_items)):
            if self.unfiltered_items[i]['complexItemID'] == item_id:
                if self.unfiltered_items[i]['selltype'] == 'exhausted':
                    self.unfiltered_items[i]['count'] -= count
                    if self.unfiltered_items[i]['count'] <= 0:
                        del self.unfiltered_items[i]
                else:
                    del self.unfiltered_items[i]
                break

    def add_item(self, item_data):
        if len(self.unfiltered_items) >= self._max_size:
            print 'SellItemBox (ERROR): max size reached'
            return False
        self.unfiltered_items.append(item_data)
        self._update_assortment()
        return True

    def hide_bought_items(self, items):
        items = items or []
        self._hidden_items = {}
        for item in items:
            self._hidden_items[item['complexItemID']] = item

        self._update_assortment()

    def _filter_items(self, items):

        def is_valid_type(item_type):
            item_category = ItemsCatalog.GetItemCategory(item_type)
            filter_bit = IC.get_filter(item_category)
            return not bool(filter_bit is None or self.filter_mask & filter_bit)

        def is_valid_filtertext(_filter_text, item_type):
            if not _filter_text:
                return True
            else:
                is_filter_short = BWPersonality.settings.optionalSettings.items_filter_search_in_short
                friendly_name_long = ItemsUtils.GetItemName(item_type, fGetShortName=False).lower()
                if not is_filter_short:
                    return _filter_text in friendly_name_long
                friendly_name_short = ItemsUtils.GetItemName(item_type, fGetShortName=True).lower()
                return _filter_text in friendly_name_short or _filter_text in friendly_name_long

        filter_text = self._filter_text.lower()
        filtered_items = filter(lambda item: is_valid_type(item['complexItemType']) and is_valid_filtertext(filter_text, item['complexItemType']), items)
        visible_items = []
        for item in filtered_items:
            if item['selltype'] == 'unexhausted':
                visible_items.append(item)
                continue
            hidden_item = self._hidden_items.get(item['complexItemID'])
            if not hidden_item:
                visible_items.append(item)
                continue
            if item['selltype'] == 'unique' and item['count'] <= hidden_item['count']:
                continue
            if item['selltype'] == 'exhausted' and item['count'] <= hidden_item['count']:
                continue
            partly_hidden_item = deepcopy(item)
            partly_hidden_item['count'] = item['count'] - hidden_item['count']
            ItemsUtils.SetItemNumber(partly_hidden_item, partly_hidden_item['count'])
            visible_items.append(partly_hidden_item)

        return visible_items

    def on_drop_items(self, source_factory_string, items_data):
        if not source_factory_string == 'soGUI.RecieveTradeSlot':
            return
        for item_data in items_data:
            BWPersonality.GUICore.trade_screen.on_slot_outdrop(source_factory_string, item_data)

    def on_dbl_click(self, item_data):
        item_class = ItemsCatalog.GetItemClass(item_data['complexItemType'])
        if item_class == ItemsCatalog.WEAPON:
            item_data = SellTradeSlot.validate_randomness_and_insert_weapon_attaches(deepcopy(item_data))
        BWPersonality.GUICore.trade_screen.on_sell_item_dblclick(item_data)

    def get_slot_class(self):
        return SellTradeSlot

    @property
    def trader_money(self):
        return self._money

    def get_seller_relation(self):
        return BigWorld.player().get_personal_relation()

    @property
    def filter_mask(self):
        return self._filter_box.filter_mask