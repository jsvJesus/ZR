# Embedded file name: ./client/soGUI/TradeGUI/FilterSet.py
from soGUI.soButton import soButtonWTT, soButton
import GUI
from functools import partial
from gui_const import INV_CONST
import BigWorld
from soGUI.soEditField import soEditBox2

class FilterEditBox(soEditBox2):

    def __init__(self, component, height, width, value_change_callback):
        self._callback = value_change_callback
        soEditBox2.__init__(self, component, height=height, width=width)

    def setupContent(self):
        soEditBox2.setupContent(self)
        self._btn = soButton(GUI.Window())
        self._btn.initVSC('soGUI/elements/closeBox.xml')
        cmp = self._btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 18
        cmp.position = (self.component.width - 4, 4, 0.2)
        cmp.visible = False
        self._btn.onClick = self.clear
        self.component.addChild(cmp)
        self._btn.onBound()
        self._btn._updateVisualState()

    def do_reposition(self):
        self._btn.component.position = (self.component.width - 4, 4, 0.2)

    def onValueChange(self, byUser):
        text = self.getRaw()
        self._btn.component.visible = bool(text)
        self._callback(text)
        return soEditBox2.onValueChange(self, byUser)


class FilterSet:
    DBL_CLICK_THRESHOLD = 0.3
    CLICK_DELAY = 0.2

    def __init__(self, component, callback, quests_button = False):
        self.component = component
        self.filter_mask = 0
        self._buttons = {}
        self._callback = callback
        self._lastclick_time = BigWorld.time()
        self._lastclick_bit = None
        self.setup_content(quests_button)
        self._delay_callback = None
        return

    def setup_content(self, quests_button):

        def create_filter_button(ttid, index, filter_bit, visual_style):
            filterBtn = soButtonWTT(GUI.Window(), TTid=ttid)
            filterBtn.buttonStyle = soButton.TOGGLEBUTTON_STYLE
            filterBtn.buttonActive = True
            filterBtn.onClick = partial(self.filterHandler, filter_bit)
            cmp = filterBtn.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'RIGHT'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.width = 18
            cmp.height = 18
            cmp.position = (self.component.width - 18 * index - 36, 6, 0.3)
            filterBtn.initVSC(visual_style)
            filterBtn.onBound()
            filterBtn.setVisualState('active')
            self.component.addChild(cmp)
            self._buttons[filter_bit] = filterBtn

        if quests_button:
            create_filter_button('filtQuests', -1, INV_CONST.FILT_QUESTS, 'soGUI/elements/filter_quest.xml')
        create_filter_button('filtArts', 0, INV_CONST.FILT_ARTS, 'soGUI/elements/filter_artifact.xml')
        create_filter_button('filtLoot', 1, INV_CONST.FILT_LOOT, 'soGUI/elements/filter_misc.xml')
        create_filter_button('filtFood', 2, INV_CONST.FILT_FOOD, 'soGUI/elements/filter_consumables.xml')
        create_filter_button('filtGadgets', 3, INV_CONST.FILT_GADGETS, 'soGUI/elements/filter_gadjet.xml')
        create_filter_button('filtClother', 4, INV_CONST.FILT_CLOTHER, 'soGUI/elements/filter_armor.xml')
        create_filter_button('filtWeapon', 5, INV_CONST.FILT_WEAPON, 'soGUI/elements/filter_weapons.xml')

    def filterHandler(self, filter_bit):
        if filter_bit == self._lastclick_bit and BigWorld.time() - self._lastclick_time <= FilterSet.DBL_CLICK_THRESHOLD:
            any_bit = False
            for fb, btn in self._buttons.items():
                if fb != filter_bit and self.filter_mask & fb:
                    any_bit = True
                    break

            this_bit = self.filter_mask & filter_bit
            if any_bit and this_bit:
                for fb, btn in self._buttons.items():
                    btn.setToggleState(True)

                self.filter_mask = 0
            else:
                for fb, btn in self._buttons.items():
                    btn.setToggleState(fb == filter_bit)

                self.filter_mask = ~filter_bit
        else:
            self.filter_mask ^= filter_bit
        self._lastclick_bit = filter_bit
        self._lastclick_time = BigWorld.time()

        def perform_action():
            if self._callback:
                self._callback(self.filter_mask)
            self._delay_callback = None
            return

        if self._delay_callback:
            BigWorld.cancelCallback(self._delay_callback)
        self._delay_callback = BigWorld.callback(FilterSet.CLICK_DELAY, perform_action)