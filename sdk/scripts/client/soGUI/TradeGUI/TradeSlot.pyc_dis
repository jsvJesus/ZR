# Embedded file name: ./client/soGUI/TradeGUI/TradeSlot.py
from soGUI.soItemView import soItemSlot, LOCKED_COLOR
import GUI
import BWPersonality
from Localization import lc
import soGUI
import colorCodes
import utils
