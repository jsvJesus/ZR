# Embedded file name: ./client/soGUI/textMoney.py
import BigWorld, GUI, Keys
import traceback
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from Localization import lc
from utils import groupNumber
color_tab = [(1000000000, (255, 0, 255, 255)),
 (500000000, (89, 54, 255, 255)),
 (100000000, (255, 0, 0, 255)),
 (10000000, (190, 105, 190, 255)),
 (1000000, (255, 242, 0, 255)),
 (500000, (247, 148, 29, 255)),
 (100000, (57, 181, 74, 255)),
 (10000, (0, 174, 239, 255))]

def getColorMoney(money, alpha = 255):
    for maxmoney, color in color_tab:
        if money >= maxmoney:
            return (color[0],
             color[1],
             color[2],
             alpha)

    return (255,
     255,
     255,
     alpha)


class TextMoney(PyGUIBase):
    SEP = '`'

    def __init__(self, component, font = 'RobotoCondensedRegular_12.font', usecolor = True, scale_icon = 1, align_center = False):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._alpha = 255
        self._align_center = align_center
        self._font = font
        self._usecolor = usecolor
        self._value = 0
        self._scale_icon = scale_icon
        self.setup()

    def setup(self):
        self.moneyIcon = GUI.Simple('')
        self.moneyIcon.verticalAnchor = 'CENTER'
        self.moneyIcon.horizontalAnchor = 'LEFT'
        self.moneyIcon.horizontalPositionMode = 'PIXEL'
        self.moneyIcon.verticalPositionMode = 'PIXEL'
        self.moneyIcon.widthMode = 'PIXEL'
        self.moneyIcon.heightMode = 'PIXEL'
        self.moneyIcon.position = (0, 15, 0.0)
        texture, size = self.getPathIcon()
        self.moneyIcon.height = size[1] * self._scale_icon
        self.moneyIcon.width = size[0] * self._scale_icon
        self.moneyIcon.textureName = texture
        self.moneyIcon.visible = True
        self.component.addChild(self.moneyIcon, 'moneyIcon')
        self.moneyLabel = GUI.Text('value / value')
        self.moneyLabel.font = self._font
        self.moneyLabel.horizontalAnchor = 'LEFT'
        self.moneyLabel.verticalAnchor = 'BOTTOM'
        self.moneyLabel.verticalPositionMode = 'PIXEL'
        self.moneyLabel.horizontalPositionMode = 'PIXEL'
        self.moneyLabel.position = (20, 20, 0.0)
        self.moneyLabel.visible = True
        self.component.addChild(self.moneyLabel, 'moneyLabel')

    def move_money_icon_height(self, delta_height):
        """ \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb2\xd1\x8b\xd1\x81\xd0\xbe\xd1\x82\xd1\x83 \xd0\xb8\xd0\xba\xd0\xbe\xd0\xbd\xd0\xba\xd0\xb8, \xd0\xb0 \xd1\x82\xd0\xbe \xd0\xbe\xd0\xbd\xd0\xb0 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xba\xd1\x80\xd0\xb8\xd0\xb2\xd0\xbe \xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbd\xd0\xb5\xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd1\x85 \xd1\x88\xd1\x80\xd0\xb8\xd1\x84\xd1\x82\xd0\xbe\xd0\xb2
                (\xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80. \xd0\xb4\xd0\xbb\xd1\x8f RobotoCondensedRegular_14.font)
        """
        pos = self.moneyIcon.position
        self.moneyIcon.position = (pos[0], pos[1] + delta_height, pos[2])

    def getPathIcon(self):
        return ('soGUI/frame/inventory/money.dds', (16, 8))

    def getPostfix(self):
        return lc('tmplocal.strings.RUB')

    def setValue(self, money):
        money = str(money)
        rawText = money.replace(self.SEP, '').strip()
        try:
            money = int(float(rawText))
            self._value = money
        except:
            print 'rawText:', repr(rawText)
            traceback.print_stack()
            traceback.print_exc()
            self.textCmp.text = str(money) + self.getPostfix()
            return

        self._redraw()
        if self._align_center:
            self._align_components_on_center()

    def _align_components_on_center(self):
        total_width = self.moneyIcon.width + 4 + self.moneyLabel.stringWidth(self.moneyLabel.text)
        start_pos = (self.component.width - total_width) / 2
        self.moneyIcon.position[0] = start_pos
        self.moneyLabel.position[0] = start_pos + self.moneyIcon.width + 4

    @property
    def textCmp(self):
        return self.moneyLabel

    def _redraw(self):
        if self._usecolor:
            self.textCmp.colour = getColorMoney(self._value, self._alpha)
        money = groupNumber(self._value, self.SEP)
        self.textCmp.text = money + self.getPostfix()

    def getValue(self):
        return self._value

    def setAlpha(self, alpha = 255):
        self._alpha = alpha
        self._redraw()


class TextGold(TextMoney):
    """docstring for TextGold"""

    def getPathIcon(self):
        return ('soGUI/frame/inventory/gold.dds', (11, 9))

    def getPostfix(self):
        return lc('tmplocal.strings.GOLDRUB')


class SimpeTextMoney(TextMoney):
    """label = SimpeTextMoney(GUI.Text(''))"""

    def setup(self):
        self.moneyIcon = None
        self.moneyLabel = None
        self.component.font = self._font
        self.component.horizontalAnchor = 'LEFT'
        self.component.verticalAnchor = 'BOTTOM'
        self.component.verticalPositionMode = 'PIXEL'
        self.component.horizontalPositionMode = 'PIXEL'
        self.component.position = (20, 20, 0.0)
        return

    @property
