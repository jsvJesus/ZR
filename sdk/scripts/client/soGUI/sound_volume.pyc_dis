class SoundVolume(PyGUIBase):
    factoryString = 'soGUI.SoundVolume'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.r_offset = 5
        self.width = 300
        self._levels = {}
        self.setupRoot()

    def setupRoot(self):
        W, H = BigWorld.screenSize()
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'CENTER'
        cmp.width = self.width + self.r_offset
        cmp.height = 20
        cmp.position = (-0.99, 0, 0.0)
        cmp.colour = (255, 255, 255, 500)
        cmp.materialFX = 'BLEND'
        cmp.visible = True
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (19, 19, 17, 190)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp, 'fon')

    def show(self):
        BWPersonality.GUICore.worldLayer.delChild('sound_volume')
        BWPersonality.GUICore.worldLayer.addChild(self.component, 'sound_volume')
        self.component.visible = True

    def hide(self):
        self.component.visible = False

    def create_level(self, key):
        pos_y = len(self._levels) * 30 + 20
        self.component.height = pos_y + 30
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (19, 19, 200, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 10
        cmp.height = 20
        cmp.position = (0, pos_y, 0.5)
        bar = cmp
        self.component.addChild(cmp, 'bar_%s' % key)
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 200)
        cmp.materialFX = 'BLEND'
        cmp.width = 5
        cmp.height = 25
        cmp.position = (0, pos_y, 0.6)
        target = cmp
        self.component.addChild(cmp, 'tagert_%s' % key)
        cmp = GUI.Text('')
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.position = (30, pos_y, 0.1)
        text = cmp
        self.component.addChild(cmp, 'text_%s' % key)
        self._levels[key] = {'pos_y': pos_y,
         'bar': bar,
         'target': target,
         'text': text}

    def clear(self):
        pass

    def update(self, key, volume, tagert_volume = None):
        if key not in self._levels:
            self.create_level(key)
        comp = self._levels[key]
        if tagert_volume is not None:
            comp['target'].position[0] = tagert_volume * self.width
        comp['bar'].width = volume * self.width
        comp['text'].text = u'%s: %.2f' % (key, volume)
        return