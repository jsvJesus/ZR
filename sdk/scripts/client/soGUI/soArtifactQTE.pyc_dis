    def _on_close_click(self):
        self.hide()
        BWPersonality.GUICore.setMouseAltState(False)
        BWPersonality.GUICore.setBestCursor()

    def _updateFuelIndicator(self):
        player = BigWorld.player()
        ae = getattr(player, 'artefactExtractor', None)
        if not ae:
            return
        else:
            item_dict = ae.item_dict
            count = ItemsUtils.GetBatteryLevel(item_dict)
            max_count = ItemsUtils.GetMaxBatteryLevel(item_dict)
            off = count <= 0
            if not off and self.component.red_indicator.visible:
                player.cell.append_to_battery_consumers(item_dict['complexItemID'])
            self.component.red_indicator.visible = off
            if not self._screen_coroutine:
                self.component.screen.dark_fon.visible = off
            level_ratio = float(count) / max_count
            self.component.radarNet.text_fuel.text = '%.1f%%' % (100.0 * level_ratio)
            self.component.radarNet.battery_level.battery_level_container.filler.width = math_bw.clamp(level_ratio) * 2
            if off:
                self._red_ind_shad.alpha = 1.0
                self._red_ind_shad.reset()
                self._red_ind_shad.alpha = 0.0
            self.component.button_light1.visible = not off
            self.component.button_light2.visible = not off
            self.is_on = not off
            self._fuel_full = not off
            if self._first_show_trigger:
                self._first_show_trigger = False
                if off:
                    self._no_battery_coroutine_handler = self._no_battery_coroutine()
                    self._no_battery_coroutine_handler.run()
            return

    def renderContents(self, slider = True, points = True, keyBinds = True, select = True, status = True):
        try:
            self._updateFuelIndicator()
        except:
            traceback.print_exc()

        if slider:
            cmp = self.component.sliderHolder.timeSlider
            hPos = self.sliderData * 2.0 - 1.0
            cmp.position = (hPos, 1.0, 0.8)
        if not self._fuel_full and self.points:
            self._clearPoints()
        self.component.radarHolder.spotLine.visible = self._fuel_full
        points = True
        if points:
            for anomaly_id, point_comp in self.points.items():
                if anomaly_id not in self.QTEdata:
                    point_comp.visible = False
                    self.component.radarHolder.delChild(point_comp)
                    del self.points[anomaly_id]

            if self._fuel_full:
                for anomaly_id, anomaly_pos in self.QTEdata.items():
                    if anomaly_id not in self.points:
                        pointObj = soArtifactPoint(GUI.Window(), self)
                        if self.status == self.STATUS_PLAY:
                            anomaly = BigWorld.entities.get(anomaly_id)
                            if anomaly:
                                dist = (anomaly.position - BigWorld.player().position).length
                                in_range = dist < ItemsUtils.EXTRACTION_RANGE
                                if in_range:
                                    pointObj.in_range = True
                                    ae = getattr(BigWorld.player(), 'artefactExtractor', None)
                                    if anomaly_id and ae and ae.choosen_anomaly == anomaly_id:
                                        pointObj._listen_out_range = True
                        cmp = pointObj.component
                        cmp.visual.colour = self._compile_color()
                        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
                        self.component.radarHolder.addChild(cmp, 'point' + str(anomaly_id))
                        pointObj.onBound()
                        pointObj.setID(anomaly_id)
                        pointObj.onClick = partial(self.processPoint, anomaly_id)
                        self.points[anomaly_id] = cmp
                        cmp.position = (anomaly_pos[0], anomaly_pos[1], 0.0)

        if keyBinds:
            if len(self.keyData) < 5:
                for i in xrange(5):
                    cmp = self.component.__getattribute__('key' + str(i))
                    cmp.visible = False

            i = 0
            for key_name, key_visible, key_presses in self.keyData:
                cmp = self.component.__getattribute__('key' + str(i))
                cmp.textureName = self.KEYMAP[key_name]
                cmp.visible = key_visible
                cmp.colour[3] = 255 if key_presses else 100
                i += 1

        if select:
            if hasattr(self.component.radarHolder, 'point' + str(self.selectorData)):
                cmp = self.component.radarHolder.__getattribute__('point' + str(self.selectorData))
                cmp.script.select()
        self._update_ui()
        return

    def _update_ui(self):
        lb_comp = self.component.lamp_bottom
        text_comp = self.component.infoBar.help
        if self.status == self.STATUS_PREPARATION:
            text_comp.text = lc('soArtifactQTE.HELP_PLAY')
            lb_comp.visible = True
        elif self.status == self.STATUS_PLAY:
            text_comp.text = lc('soArtifactQTE.HELP_PLAY')
            lb_comp.visible = True
        elif self.status == self.STATUS_FAIL:
            text_comp.text = lc('soArtifactQTE.HELP_PLAY')
            lb_comp.visible = False
        elif self.status == self.STATUS_WIN:
            text_comp.text = lc('soArtifactQTE.HELP_SUCCESS')
            lb_comp.visible = False
        elif self.status == self.STATUS_IDLE:
            if not self.points:
                lb_comp.visible = False
                text_comp.text = lc('soArtifactQTE.HELP_NONE')
            elif any((p.script.in_range for p in self.points.values())):
                text_comp.text = lc('soArtifactQTE.HELP_GRAB')
                lb_comp.visible = True
            else:
                text_comp.text = lc('soArtifactQTE.HELP_COME')
                lb_comp.visible = False

    def onGameNotify(self, notify_id, data = None):
        if notify_id == self.NOTIFY_ERROR_DIST:
            self.onGameStatus(self.STATUS_FAIL)
        elif notify_id == self.NOTIFY_START_GAME:
            for anomaly_id, point_comp in self.points.items():
                listen_out_range = data == anomaly_id
                point_comp.script.listenOutRange(listen_out_range)

    def on_range_change(self, point):
        self.renderContents()

    def onPointOutRange(self, anomaly_id):
        self.points[anomaly_id].script.listenOutRange(False)
        player = BigWorld.player()
        ae = getattr(player, 'artefactExtractor', None)
        if not ae:
            return
        else:
            ae.stopGame()
            self.onGameNotify(self.NOTIFY_ERROR_DIST)
            player.putMessage(CHANNEL_CONSTS.SYSTEM, lc('soArtifactQTE.ERROR_DIST'))
            return

    def _compile_color(self):
        colour = list(math_bw.lerp_rgb_colors(GREEN_COLOR, RED_COLOR, self._intencity[0]))
        colour[3] = self._intencity[1] * 255
        return tuple(colour)

    def _set_colours(self, intensity, alpha):
        self._intencity = (intensity, alpha)
        colour = self._compile_color()
        self.component.radarNet.colour = colour
        self.component.infoBar.help.colour = colour
        self.component.radarNet.text_fuel.colour = colour
        self.component.infoBar.colour = colour
        self.component.sliderHolder.timeSlider.colour = colour
        self.component.radarHolder.spotLine.colour = colour
        self.component.radarNet.battery_level.colour = colour
        self.component.radarNet.battery_level.battery_level_container.filler.colour = colour
        for p in self.points.values():
            p.visual.colour = colour

    @BWMemberCoroutine
    def _fail_twinkling(self):
        fail_twinkle_count = 2.5
        fail_twinkle_time = 0.5
        twinkle_delay = 1.0
        on_time = 1.5

        def twinkle_phase_to_intensity(phase):
            return abs(math.sin(phase * fail_twinkle_count * math.pi))

        time_elapsed = 0.0
        while time_elapsed < fail_twinkle_time:
            time_elapsed = min(time_elapsed + BigWorld.getTimeDelta(), fail_twinkle_time)
            phase = time_elapsed / fail_twinkle_time
            intensity = twinkle_phase_to_intensity(phase)
            self._set_colours(intensity, 1.0)
            yield BWWaitForPeriod(0)

        self._set_colours(1.0, 1.0)
        yield BWWaitForPeriod(twinkle_delay)
        yield BWWaitForCoroutine(self._screen_effect(False))
        alpha = 0.0
        while alpha < 1.0:
            alpha = min(1.0, alpha + BigWorld.getTimeDelta() / on_time)
            self._set_colours(0.0, alpha * alpha)
            yield BWWaitForPeriod(0)

        self._set_colours(0.0, 1.0)
        self.onGameStatus(self.STATUS_IDLE)
        self._clearPoints()
        self._restart_coroutine = None
        BWPersonality.GUICore.artifactQTEEvent(self.EVENT_RESTART, None)
        return

    @BWMemberCoroutine
    def _win_delay(self):
        yield BWWaitForPeriod(2.0)
        self.onGameStatus(self.STATUS_IDLE)
        self._clearPoints()
        self._restart_coroutine = None
        BWPersonality.GUICore.artifactQTEEvent(self.EVENT_RESTART, None)
        return

    def onGameStatus(self, status, data = None):
        STATUSMAP_BTN = {self.STATUS_IDLE: (255, 0, 0, 0),
         self.STATUS_PREPARATION: (255, 255, 0, 255),
         self.STATUS_PLAY: (255, 0, 0, 0),
         self.STATUS_FAIL: (255, 0, 0, 255),
         self.STATUS_WIN: (0, 255, 0, 255)}
        self.component.button_light1.colour = STATUSMAP_BTN[status]
        self.component.button_light2.colour = STATUSMAP_BTN[status]
        if self._restart_coroutine:
            self._restart_coroutine.stop()
        self._restart_coroutine = None
        if status == self.STATUS_FAIL:
            self._restart_coroutine = self._fail_twinkling()
            self._restart_coroutine.run()
        elif status == self.STATUS_WIN:
            self._play_sound('items/mgd/succeed')
            self._restart_coroutine = self._win_delay()
            self._restart_coroutine.run()
        return

    def update(self):
        data = BWPersonality.GUICore.artifactQTEDataSection
        slider, points, keyBinds, select, status = (False,
         False,
         False,
         False,
         False)
        if self.sliderData != data['slider']:
            self.sliderData = data['slider']
            slider = True
        if self.QTEdata != data['QTEdata']:
            self.QTEdata = deepcopy(data['QTEdata'])
            points = True
        if self.keyData != data['keyData']:
            self.keyData = deepcopy(data['keyData'])
            keyBinds = True
        if self.selectorData != data['selector']:
            self.selectorData = data['selector']
            select = True
        if self.status != data['QTEStatus']:
            self.status = data['QTEStatus']
            status = True
        self.renderContents(slider, points, keyBinds, select, status)

    def processPoint(self, anomaly_id):
        if self.status not in (self.STATUS_PLAY, self.STATUS_PREPARATION, self.STATUS_FAIL) and not self._restart_coroutine:
            BWPersonality.GUICore.artifactQTEEvent(self.EVENT_SELECT, anomaly_id)

    def _on_grab_click(self):
        if self.status == self.STATUS_IDLE:
            ae = getattr(BigWorld.player(), 'artefactExtractor', None)
            if ItemsUtils.GetBatteryLevel(ae.item_dict) <= 0:
                if not self._screen_coroutine and not self._restart_coroutine and not self._no_battery_coroutine_handler:
                    self._no_battery_coroutine_handler = self._no_battery_coroutine()
                    self._no_battery_coroutine_handler.run()
                    return
        if self.status not in (self.STATUS_PLAY, self.STATUS_PREPARATION, self.STATUS_FAIL):
            anomaly_id = next((a_id for a_id, p in self.points.items() if p.script.in_range), None)
            if anomaly_id and not self._restart_coroutine:
                BWPersonality.GUICore.artifactQTEEvent(self.EVENT_SELECT, anomaly_id)
        return

    def show(self):
        self._first_show_trigger = True
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'artifactQTE')
        self.component.visible = True
        GUIPositions.show(self)
        self.spotlineLoop()
        BWPersonality.GUICore.setBestCursor()
        self.component.radarNet.text_fuel.text = ''
        self._red_ind_shad.alpha = 0.0
        self._red_ind_shad.reset()
        self._red_ind_shad.alpha = 0.0
        self._set_colours(0.0, 1.0)
        self.component.screen.dark_fon.visible = True
        self.component.screen.nobatterycontainer.visible = False
        self.component.screen.dark_fon.colour[-1] = 255
        return

    def hide(self):
        self.spotlineStop()
        self.component.visible = False
        self._fuel_full = False
        self.component.red_indicator.visible = True
        self.component.screen.dark_fon.visible = True
        self.component.screen.nobatterycontainer.visible = False
        self.component.button_light1.visible = False
        self.component.button_light2.visible = False
        self._clearPoints()
        self.QTEdata = {}
        self.is_on = False
        BWPersonality.GUICore.setBestCursor()
        BWPersonality.GUICore.artifactQTEEvent(self.EVENT_CLOSED, None)
        if self._screen_coroutine:
            self._screen_coroutine.stop()
        self._screen_coroutine = None
        if self._restart_coroutine:
            self._restart_coroutine.stop()
        self._restart_coroutine = None
        if self._no_battery_coroutine_handler:
            self._no_battery_coroutine_handler.stop()
        self._no_battery_coroutine_handler = None
        self._set_colours(0.0, 1.0)
        return

    @property
    def is_on(self):
        return getattr(self, '_is_on', False)

    @is_on.setter
    def is_on(self, value):
        if self.is_on == value:
            return
        self._is_on = value
        if self._screen_coroutine:
            self._screen_coroutine.stop()
        self._screen_coroutine = self._screen_effect(self.is_on)
        self._screen_coroutine.run()

    @BWMemberCoroutine
    def _no_battery_coroutine(self):
        self.component.screen.nobatterycontainer.visible = True
        yield BWWaitForCoroutine(self._screen_effect(True))
        yield BWWaitForPeriod(2.0)
        yield BWWaitForCoroutine(self._screen_effect(False))
        self.component.screen.nobatterycontainer.visible = False
        self._no_battery_coroutine_handler = None
        return

    @BWMemberCoroutine
    def _screen_effect(self, is_on):
        if not hasattr(self.component, 'screen'):
            self._screen_coroutine = None
            return
        else:
            animation_scale = 1
            dark_fon = self.component.screen.dark_fon
            whiteblock = self.component.screen.whiteblock
            black_up = self.component.screen.black_up
            black_down = self.component.screen.black_down
            if is_on:
                self._play_sound('items/mgd/turn_off')
                open_period = 0.3 / animation_scale
                fade_period = 0.1 / animation_scale

                def state_by_phase(phase):
                    dark_fon.visible = True
                    black_up.visible = True
                    whiteblock.visible = True
                    black_down.visible = True
                    whiteblock.colour[-1] = 255
                    black_up.position[1] = 0.01
                    black_down.position[1] = -0.01
                    dark_fon.colour[-1] = phase * 255

                phase = 1.0
                state_by_phase(phase)
                while phase > 0.0:
                    phase = max(0.0, phase - BigWorld.getTimeDelta() / fade_period)
                    state_by_phase(phase)
                    yield BWWaitForPeriod(0)

                state_by_phase(phase)

                def state_by_phase(phase):
                    dark_fon.visible = False
                    black_up.visible = True
                    whiteblock.visible = True
                    black_down.visible = True
                    whiteblock.colour[-1] = phase * 255
                    black_up.position[1] = 1.0 - phase + 0.01
                    black_down.position[1] = -1 + phase - 0.01

                phase = 1.0
                state_by_phase(phase)
                while phase > 0.0:
                    phase = max(0.0, phase - BigWorld.getTimeDelta() / open_period)
                    state_by_phase(phase)
                    yield BWWaitForPeriod(0)

                state_by_phase(phase)
                dark_fon.visible = False
                whiteblock.visible = False
                black_up.visible = False
                black_down.visible = False
            else:
                self._play_sound('items/mgd/turn_off')
                close_period = 0.3 / animation_scale
                fade_period = 0.1 / animation_scale

                def state_by_phase(phase):
                    dark_fon.visible = False
                    black_up.visible = True
                    whiteblock.visible = True
                    black_down.visible = True
                    whiteblock.colour[-1] = phase * 255
                    black_up.position[1] = 1.0 - phase + 0.01
                    black_down.position[1] = -1 + phase - 0.01

                phase = 0.0
                state_by_phase(phase)
                while phase < 1.0:
                    phase = min(1.0, phase + BigWorld.getTimeDelta() / close_period)
                    state_by_phase(phase)
                    yield BWWaitForPeriod(0)

                state_by_phase(phase)

                def state_by_phase(phase):
                    dark_fon.visible = True
                    black_up.visible = True
                    whiteblock.visible = True
                    black_down.visible = True
                    dark_fon.colour[-1] = phase * 255

                phase = 0.0
                state_by_phase(phase)
                while phase < 1.0:
                    phase = min(1.0, phase + BigWorld.getTimeDelta() / fade_period)
                    state_by_phase(phase)
                    yield BWWaitForPeriod(0)

                state_by_phase(phase)
                dark_fon.visible = True
                whiteblock.visible = False
                black_up.visible = False
                black_down.visible = False
            self._screen_coroutine = None
            return

    @property
    def visible(self):
        return self.component.visible

    def _clearPoints(self):
        for anomaly_id, point_comp in self.points.items():
            point_comp.visible = False
            self.component.radarHolder.delChild(point_comp)

        self.points = {}

    def scanComplete(self):
        BWPersonality.GUICore.artifactQTEEvent(self.EVENT_SCANNED, None)
        return

    def spotlineStop(self):
        if self._spotlineLoop_id:
            BigWorld.cancelCallback(self._spotlineLoop_id)
        self._spotlineLoop_id = 0

    def _play_sound(self, path):
        if BWPersonality.GUICore.isVisibleLoaderGUI():
            return
        if not self.visible or not self.is_on:
            return
        sounds.playSound(path)

    def spotlineLoop(self):
        """ (???) \xd0\xa1\xd0\xbe\xd0\xbf\xd1\x80\xd0\xbe\xd0\xb3\xd1\x80\xd0\xb0\xd0\xbc\xd0\xbc\xd0\xb0 \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x87\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb0\xd1\x8f \xd0\xb7\xd0\xb0 \xd1\x86\xd0\xb8\xd0\xba\xd0\xbb \xd0\xbf\xd0\xbe\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0."""
        pixStartPoint = self.component.radarHolder.localToScreen((0, 0))
        startPoint = pixStartPoint[1]
        pixEndPoint = self.component.radarHolder.localToScreen((0, self.component.radarHolder.height + self.component.radarHolder.spotLine.height))
        offset = startPoint - pixEndPoint[1]
        self.spotlineStop()

        def __tick():
            if not self.component.visible:
                return
            if self.is_on:
                self._play_sound('items/mgd/search')
                self.spotlineMP.translation = (0, 0, 0)
                self.component.radarHolder.spotLine.mover.reset()
                self.component.radarHolder.spotLine.mover.eta = 1.2
                self.spotlineMP.translation = (0, -offset, 0)
            self._spotlineLoop_id = BigWorld.callback(2.5, __tick)
            self.scanComplete()

        __tick()

    def _loop_test_line(self):
        self.component.radarHolder.spotLine.mover

    @PyGUIEvent('hintBox', 'onClick')
    def onHintBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        BWPersonality.GUICore.openGUIHelp('soArtifactQTE')

    def stopDragging(self):
        GUIPositions.stopDragging(self)
        DraggableComponent.stopDragging(self)

    def handleMouseButtonEvent(self, comp, event):
        if not event.isMouseButton():
            return False
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)