        background.position = (0.0, 0.0, 0.9)
        self.component.addChild(background, 'frameCmp')
        arrow_button = GUI.Simple('')
        arrow_button.horizontalPositionMode = 'PIXEL'
        arrow_button.verticalPositionMode = 'PIXEL'
        arrow_button.widthMode = arrow_button.heightMode = 'PIXEL'
        arrow_button.horizontalAnchor = 'RIGHT'
        arrow_button.verticalAnchor = 'CENTER'
        arrow_button.width = arrow_button.height = 18
        arrow_button.position = (self.component.width - 4, self.height * 0.5, 0.2)
        self.component.addChild(arrow_button, 'btn')
        label = GUI.Text('')
        label.horizontalPositionMode = 'PIXEL'
        label.verticalPositionMode = 'PIXEL'
        label.horizontalAnchor = 'LEFT'
        label.verticalAnchor = 'CENTER'
        label.font = 'RobotoCondensedRegular_18.font'
        label.position = (4, arrow_button.position[1], 0.3)
        self.component.addChild(label, 'label')

    def setup_list_window(self):
        list_window = GUI.Window()
        list_window.horizontalAnchor = 'LEFT'
        list_window.verticalAnchor = 'TOP'
        list_window.widthMode = 'PIXEL'
        list_window.heightMode = 'PIXEL'
        list_window.horizontalPositionMode = 'CLIP'
        list_window.verticalPositionMode = 'CLIP'
        list_window.position = (-1, 0, 0.1)
        list_window.width = self.component.width
        list_window.height = 50
        self.list_window = list_window
        Interceptor(list_window)
        list_background = GUI.Frame2('soGUI/frame/con_frame.dds')
        list_background.horizontalAnchor = 'RIGHT'
        list_background.verticalAnchor = 'TOP'
        list_background.widthMode = 'CLIP'
        list_background.heightMode = 'CLIP'
        list_background.horizontalPositionMode = 'CLIP'
        list_background.verticalPositionMode = 'CLIP'
        list_background.position = (1, 1, 0)
        list_background.width = 2
        list_background.height = 2
        list_background.materialFX = 'BLEND'
        list_window.addChild(list_background, 'check_list')

    def set_data(self, elements):
        """ \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb2\xd1\x8b\xd0\xb1\xd0\xbe\xd1\x80\xd0\xba\xd0\xb8
                elements - \xd0\xbc\xd0\xb0\xd1\x81\xd1\x81\xd0\xb8\xd0\xb2 \xd0\xba\xd0\xbe\xd1\x80\xd1\x82\xd0\xb5\xd0\xb6\xd0\xb5\xd0\xb9 \xd1\x82\xd0\xb8\xd0\xbf\xd0\xb0 (data, text), \xd0\xb3\xd0\xb4\xd0\xb5
                data - \xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd1\x86\xd0\xb8\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x81 \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xbe\xd0\xbc \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 (\xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd1\x8e\xd1\x82\xd1\x81\xd1\x8f \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xbc get_selection)
                text - \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd1\x82\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f
        """
        map(self.list_window.delChild, self.list_window.check_list.children)
        column = 0
        row = 0
        half_amount = int(math.ceil(len(elements) * 0.5))
        height_dist = 20
        width_dist = 260
        space = 16
        clip_label = GUI.Text()
        clip_label.font = 'RobotoCondensedRegular_14.font'
        for i, (data, text) in enumerate(elements):
            if not text:
                continue
            if column == 0 and row >= half_amount:
                column = 1
                row = 0
            text = client_utils.clip_text(text, clip_label, width_dist - 60)
            checkbox = DropDownCheckBox(text, data, self.check_box_clicked)
            checkbox.component.position = (column * width_dist + space, height_dist * row + space, 0.1)
            self.list_window.check_list.addChild(checkbox.component, 'checkbox_' + str(i))
            row += 1

        self.list_window.width = width_dist * 2
        self.list_window.height = half_amount * height_dist + 2 * space

    def topmostHiden(self):
        return not self.list_active

    def handleMouseButtonEvent(self, comp, event):
        PyGUIBase.handleMouseButtonEvent(self, comp, event)
        down = event.isKeyDown()
        if event.key == Keys.KEY_LEFTMOUSE:
            if down and not self.pressed:
                self.pressed = True
            elif not down and self.pressed:
                self.pressed = False
                self._on_click()
        self._update_visual_state()
        return True

    def _on_click(self):
        self.showList(not self.list_active)

    def _update_visual_state(self):
        visual_state = 'normal'
        if self.hover:
            visual_state = 'hover'
        if self.pressed and self.hover:
            visual_state = 'pressed'
        self.setVisualState(visual_state)

    def handleMouseEnterEvent(self, comp):
        self.hover = True
        self._update_visual_state()
        return True

    def handleMouseLeaveEvent(self, comp):
        self.hover = False
        self._update_visual_state()
        return True

    def check_box_clicked(self, checkbox):
        self.update_text()

    def update_text(self):
        checked_children = filter(lambda child: child[1].script.isChecked(), self.list_window.check_list.children)
        self.component.label.text = lc('soTradeInterface.shop.SELECTED').format(len(checked_children))

    def get_selection(self):
        return [ child[1].script.data for child in self.list_window.check_list.children if child[1].script.isChecked() ]

    def showList(self, value):
        if self.list_active == value:
            return
        self.list_active = not self.list_active
        if self.list_active:
            local_position = (0, self.component.height)
            screen_position = self.component.localToScreen(local_position)
            self.list_window.position = (screen_position[0], screen_position[1], 0)
            BWPersonality.GUICore.showTopmost(self.list_window, self.component)
        else:
            BWPersonality.GUICore.hideTopmost(self.list_window, BWPersonality.GUICore.TOPMOST_DDL)

    def reset(self):
        for checkbox in self.list_window.check_list.children:
            checkbox[1].script.setInactive()

        self.update_text()


class DropDownCheckBox(soCheckBox):

    def __init__(self, text, data, click_callback = None):
        checkbox_structure = soGUI.CheckBoxPropsStructure(labelText=text, font='RobotoCondensedRegular_16.font', labelColour=(175, 166, 112, 255))
        soCheckBox.__init__(self, GUI.Window(), checkbox_structure)
        self.component.horizontalAnchor = 'LEFT'
        self.component.verticalAnchor = 'TOP'
        self.component.horizontalPositionMode = 'PIXEL'
        self.component.verticalPositionMode = 'PIXEL'
        self.component.widthMode = 'PIXEL'
        self.component.heightMode = 'PIXEL'
        self.box.onClick = self.click
        self.data = data
        self.click_callback = click_callback

    def click(self):
        if self.click_callback:
            self.click_callback(self)