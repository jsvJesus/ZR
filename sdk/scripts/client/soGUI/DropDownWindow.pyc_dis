class DropDownWindow(PyGUIBase, soVisualStateComponent):
    factoryString = 'soGUI.soDropDownWindow'

    def __init__(self, width = 200, height = 25):
        component = GUI.Window()
        PyGUIBase.__init__(self, component)
        soVisualStateComponent.__init__(self, component, 'soGUI.soDDLVisualState')
        component.script = self
        self.width = width
        self.height = height
        self.hover = False
        self.pressed = False
        self.list_active = False
        self.component.crossFocus = True
        self.component.mouseButtonFocus = True
        self.component.widthMode = self.component.heightMode = 'PIXEL'
        self.component.width = self.width
        self.component.height = self.height
        self.setup_content()
        self.setup_list_window()
        self.initVSC('soGUI/elements/drop_down_list.xml')
        self._update_visual_state()
        self.update_text()

    def setup_content(self):
        background = GUI.Frame2('')
        background.horizontalPositionMode = background.verticalPositionMode = 'PIXEL'
        background.widthMode = background.heightMode = 'PIXEL'
