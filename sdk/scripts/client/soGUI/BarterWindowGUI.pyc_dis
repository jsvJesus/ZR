    def _applyItemData(self):
        """\xd0\x92\xd1\x8b\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 (\xd0\xba\xd0\xb0\xd1\x80\xd1\x82\xd0\xb8\xd0\xbd\xd0\xba\xd1\x83, \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb8 \xd0\xb8 \xd0\xbf\xd1\x80\xd0\xbe\xd1\x87\xd0\xb5\xd0\xb5) \xd0\xb2 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82\xd0\xb5."""
        if self.haveItem():
            if not ItemsUtils.GetIconName(self.itemData):
                iconName = 'nottexture.dds'
                if BWPersonality.GUICore.iconTextures is not None:
                    if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                        self.component.itemIcon.texture = BWPersonality.GUICore.iconTextures.has_key(iconName) and BWPersonality.GUICore.iconTextures[iconName]
                    else:
                        self.component.itemIcon.textureName = iconName
            else:
                self.component.itemIcon.textureName = iconName
            text = 'x  {0}'.format(self.itemData['reward_quantity'])
            self.component.itemCount.text = text
            self.component.itemCount.size = (len(text) / 100.0, 0.06)
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemCount.text = ''
        self.dragProxy.texture = self.component.itemIcon.texture
        return

    def onRClick(self):
        if self.haveItem():
            BWPersonality.GUICore.addListener('contextMenuEvent', self.context_menu_event)
            BWPersonality.GUICore.showContextMenu(self._interface_id, self.get_context_menu_actions())

    def get_context_menu_actions(self):
        actions = {BarterRewardSlot.EVENT_INFO: lc('Inventory.client.INFO')}
        return actions

    def context_menu_event(self, interface_id, eventid, caption, event, data = None):
        if event == soGUI.soContextMenuComponent.EVENT_SHOW and self._interface_id == interface_id:
            return
        BWPersonality.GUICore.removeListener('contextMenuEvent', self.context_menu_event)
        if interface_id != self._interface_id:
            return
        if eventid == BarterRewardSlot.EVENT_INFO:
            info_item_data = PY(self.itemData)
            if '~' in self.itemData['complexItemParametresValues']:
                complex_values = info_item_data['complexItemParametresValues']
                for i in xrange(len(complex_values)):
                    if complex_values[i] == '~':
                        complex_values[i] = 1

            self.prepare_item_before_show_infow_window(info_item_data)
            BWPersonality.GUICore.showItemInfo(info_item_data)

    def prepare_item_before_show_infow_window(self, complex_item):
        BarterRewardSlot.validate_randomness_and_insert_weapon_attaches(complex_item)
        return complex_item

    @staticmethod
    def validate_randomness_and_insert_weapon_attaches(complex_item):
        try:
            item_type = complex_item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            if item_class == ItemsCatalog.WEAPON:
                boxname = ItemsCatalog.GetItemParam(item_type).get('AttachShopBB')
                if boxname:
                    bb_data = BlackBox.ShopattachesBox(boxname)._data
                    sub_types = []
                    for gr in bb_data['groups']:
                        raise gr['chance'] == 100 or AssertionError
                        raise gr['rangeTo'] == 1 or AssertionError
                        raise gr['rangeFrom'] == 1 or AssertionError
                        raise len(gr['items']) == 1 or AssertionError
                        for gr_item in gr['items']:
                            raise gr_item['dropChance'] == 100 or AssertionError
                            raise gr_item['rangeTo'] == 1 or AssertionError
                            raise gr_item['rangeFrom'] == 1 or AssertionError
                            sub_types.append(gr_item['itemID'])

                    sub_items = []
                    for sub_type in sub_types:
                        sub_item = ItemsUtils.CreateItem(BigWorld.player, sub_type, -1)
                        sub_items.append(ItemsUtils.ConvertItemToSubItemWeapon(sub_item))

                    complex_item['itemList'].extend(sub_items)
        except:
            print 'BarterRewardSlot (ERROR):', boxname, complex_item
            traceback.print_exc()

        return complex_item


