class MyEditField(soEditField2):
    """"\xd0\x9f\xd0\xbe\xd0\xbb\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb2\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb0 \xd1\x86\xd0\xb8\xd1\x84\xd1\x80."""

    def __init__(self, *arg, **kw):
        super(MyEditField, self).__init__(*arg, **kw)
        self._call_back = None
        return

    def handleChar(self, char):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb9 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xb8\xd0\xbc\xd0\xb2\xd0\xbe\xd0\xbb."""
        if char == self.CHAR_BACKSPACE:
            self.trueText = self.trueText[:-1]
            self.visualText = self.visualText[:-1]
            self.cursorPosition -= 1
            if self.cursorPosition < 0:
                self.cursorPosition = 0
            self._call_back(self.trueText)
        elif char not in self.CHARS_TO_IGNORE:
            if self.isNumerical:
                if not char.isdigit():
                    return True
                if len(self.trueText) + 1 > self.maxCharacters:
                    return True
            self.trueText += char
            if self.maskChar != '':
                self.visualText += self.maskChar
            else:
                self.visualText += char
            self.cursorPosition += 1
            if self._call_back is not None:
                self._call_back(self.trueText)
        else:
            return False
        self.renderText()
        self.renderCursor()
        return True

    def bind_text_change(self, func):
        """\xd0\x9f\xd1\x80\xd0\xb8\xd0\xb2\xd1\x8f\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x83\xd1\x8e \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8e \xd0\xba \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb6\xd0\xb8\xd1\x82\xd0\xb5.
        
        \xd0\xa4\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8f \xd0\xb4\xd0\xbe\xd0\xbb\xd0\xb6\xd0\xbd\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb8\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbd \xd0\xb0\xd1\x80\xd0\xb3\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 (\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd0\xb0 \xd0\xb2 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb6\xd0\xb8\xd1\x82\xd0\xb5).
        """
        self._call_back = func


