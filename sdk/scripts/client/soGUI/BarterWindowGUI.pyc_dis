        comp.text = '0 / 0'
        comp.explicitSize = False
        comp.size = (round(len(comp.text), 2) / 100, 0.06)
        self.component.addChild(comp, 'itemCount')
        comp = GUI.Simple('soGUI/items/bfg_slot.dds')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTHEIGHT
        comp.colour = (125, 0, 0, 255)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.7)
        comp.visible = False
        self.component.addChild(comp, 'ItemsQuantityBg')

    def _applyItemData(self):
        """\xd0\x92\xd1\x8b\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 (\xd0\xba\xd0\xb0\xd1\x80\xd1\x82\xd0\xb8\xd0\xbd\xd0\xba\xd1\x83, \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb8 \xd0\xb8 \xd0\xbf\xd1\x80\xd0\xbe\xd1\x87\xd0\xb5\xd0\xb5) \xd0\xb2 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82\xd0\xb5."""
        if self.haveItem():
            if not ItemsUtils.GetIconName(self.itemData):
                iconName = 'nottexture.dds'
                if BWPersonality.GUICore.iconTextures is not None:
                    if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                        self.component.itemIcon.texture = BWPersonality.GUICore.iconTextures.has_key(iconName) and BWPersonality.GUICore.iconTextures[iconName]
                    else:
                        self.component.itemIcon.textureName = iconName
            else:
                self.component.itemIcon.textureName = iconName
            text = self._added_item_text(self.itemData)
            self.component.itemCount.text = text
            self.component.itemCount.size = self._added_item_text_size(text)
            self._set_background(self.itemData)
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemCount.text = ''
            self.component.ItemsQuantityBg.visible = False
        self.dragProxy.texture = self.component.itemIcon.texture
        return

    def _set_background(self, data):
        already_added = data.get('already_added', None)
        required_number = data.get('required_number', None)
        if already_added is None or required_number is None:
            self.component.ItemsQuantityBg.visible = False
            return
        else:
            if required_number <= already_added:
                self.component.ItemsQuantityBg.visible = False
            else:
                self.component.ItemsQuantityBg.visible = True
            return

    def _added_item_text(self, data):
        already_added = data.get('already_added', None)
        required_number = data['required_number']
        text = '{0} / {1}'.format(already_added, required_number)
        return text

    def _added_item_text_size(self, text):
        x = round(len(text) / 100.0, 2)
        y = 0.06
        return (x, y)

    def onDragStart(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        return True

    def cancelTrade(self):
        print 'cancelTrade', self.component.parent.parent.script, hasattr(self.component.parent.parent.script, 'onItemRemove'), hasattr(self.component.parent.parent, 'onItemRemove')
        if self.component.parent and hasattr(self.component.parent.parent.script, 'onItemRemove'):
            self.component.parent.parent.script.onItemRemove(self.itemData)
            return
        BWPersonality.GUICore.packageSellEvent(EVENT_ITEMREMOVE, self.itemData)


class BarterListElement(soListElement):
    interfaceId = 'BarterWindow.BarterListElement'

    def handleMouseEnterEvent(self, comp):
        BWPersonality.GUICore.showToolTip(self.component.label.text, tooltipID=self.interfaceId)
        return super(BarterListElement, self).handleMouseEnterEvent(comp)

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip(self.interfaceId)
        return super(BarterListElement, self).handleMouseLeaveEvent(comp)


class BarterWindow(PyGUIBase, DraggableComponent, GUIPositions):
    """\xd0\x9e\xd0\xba\xd0\xbd\xd0\xbe \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0."""
    factoryString = 'soGUI.BarterWindow'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        GUIPositions.__init__(self)
        component.script = self
        self.interfaceID = BWPersonality.GUICore.GUI_ID_PACKAGESELL
        self.setupRoot()
        self.setupContent()
        self._clbID = 0
        self._deltaposition = [0, 0]
        self._multiplier = 1
        self.you_can_get_items_count = 0

    def setupRoot(self):
        comp = self.component
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.width = 781
        comp.height = 505
        comp.visible = False
        comp.dragFocus = True
        comp.moveFocus = True
        width, height = BigWorld.screenSize()
        comp.position = (width / 2 - comp.width / 2, height / 2 - comp.height / 2, 1)

    def setupContent(self):
        itemView = soItemView(GUI.Window(), BarterPaySlot, slot_eventsHandler=self.paySlotHandler, eventsHandler=self.payItemViewHandler, rowWidth=3, cols=3, rows=3, vScroll=True, hScroll=False, borderWidth=0)
        comp = itemView.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.position = (375, 52, 0.5)
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'payItemView')
        itemView.onBound()
        itemView.setRestrictingComponent(None)
        itemView.setItems(None)
        itemView = soItemView(GUI.Window(), BarterRewardSlot, slot_eventsHandler=self.rewardSlotHandler, eventsHandler=self.rewardItemViewHandler, rowWidth=3, cols=3, rows=3, vScroll=True, hScroll=False, borderWidth=0)
        comp = itemView.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.position = (375, 272, 0.5)
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'rewardItemView')
