# Embedded file name: ./client/soGUI/BloodGUI/BloodGUI.py
import BigWorld
import Stats
import math_bw
from Math import Vector3
import math
DEFAULT_COLOUR = (91, 0, 12, 255)

class BloodGUI:

    def __init__(self):
        from soGUI.BloodGUI.BloodGUIPanel import BloodGUIPanel
        from soGUI.BloodGUI.BloodGUIArrow import BloodGUIArrow
        self.bloodgui_arrow = BloodGUIArrow()
        self.bloodgui_panel = BloodGUIPanel()

    def doReposition(self):
        self.bloodgui_arrow.doReposition()
        self.bloodgui_panel.doReposition()

    def draw_damage(self, damager_hashable_id, damager_position, damage, is_bullet):
        max_hitpoints = BigWorld.player().GetStatValue(Stats.ch_MaxHitPoints)
        if damager_position:
            if is_bullet:
                damage_factor1 = math_bw.clamp(damage / max_hitpoints, 0, 1)
                self.bloodgui_arrow.draw_damage(damager_hashable_id, damager_position, damage_factor1)
            else:
                cur_hitpoints = BigWorld.player().GetStatValue(Stats.ch_HitPoints)
                damage_factor2 = math_bw.clamp(1 - cur_hitpoints / max_hitpoints, 0, 1)
                self.bloodgui_panel.draw_damage(damager_position, damage_factor2)

    def draw_fall_damage(self, damage):
        max_hitpoints = BigWorld.player().GetStatValue(Stats.ch_MaxHitPoints)
        damage_factor = math_bw.clamp(damage / max_hitpoints, 0, 1)
        self.bloodgui_panel.draw_fall_damage(damage_factor)

    def draw_colored_damage(self, colour):
        self.bloodgui_panel.draw_colored_damage(colour)

    @staticmethod
    def damager_position_to_angle(position):
        """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbe\xd1\x80\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x82 \xd0\xb8\xd1\x81\xd1\x82\xd0\xbe\xd1\x87\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0 \xd0\xb4\xd0\xb0\xd0\xbc\xd0\xb0\xd0\xb3\xd0\xb0 \xd0\xb2 \xd1\x83\xd0\xb3\xd0\xbe\xd0\xbb \xd0\xbe\xd1\x82\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x81\xd1\x82\xd1\x80\xd0\xb5\xd0\xbb\xd0\xba\xd0\xb8 """
        player = BigWorld.player()
        if not player or player.__class__.__name__ != 'PlayerAvatar':
            return
        to_damager = position - player.position
        to_damager.y = 0
        to_damager.normalise()
        to_front = Vector3()
        to_front = Vector3(BigWorld.camera().direction)
        to_front.y = 0
        to_front.normalise()
        angle_cos = math_bw.clamp(to_damager.dot(to_front), -1, 1)
        angle = math.acos(angle_cos)
        if to_damager.cross2D(to_front) > 0:
            angle = -angle
        return angle