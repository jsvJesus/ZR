# Embedded file name: ./client/soGUI/auraperks/auraperks_ui.py
from Localization import lc
import colorCodes as cc
import BWPersonality
from Helpers.PyGUI.PyGUIBase import DragWin
import GUI
from soGUI.GUIPositions import GUIPositions
from Helpers.PyGUI.PyGUIBase import Interceptor
from EffectUtils import getEffect
from perks_system import perks_parser

class Block(Interceptor):
    size = 48

    def __init__(self, perk_id):
        self.perk_id = perk_id
        comp = GUI.Window('soGUI/frame/perks/grouping_frame.dds')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = Block.size, Block.size
        comp.materialFX = 'BLEND'
        comp.isClip = False
        Interceptor.__init__(self, comp, intercept_buttons=False, intercept_moving=True)
        comp = GUI.Window('soGUI/frame/perks/Icons/Perk{0}.dds'.format(self.perk_id))
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.filterType = 'LINEAR'
        comp.width, comp.height = (28, 28)
        self.component.addChild(comp)
        comp = GUI.Text(u'', 'RobotoCondensedRegular_10.font')
        comp.ha, comp.va = ('CENTER', 'BOTTOM')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp, 'count')

    def handleMouseEnterEvent(self, comp):
        result = Interceptor.handleMouseEnterEvent(self, comp)
        perk_name = lc('PerksSystem.name.id{0}'.format(self.perk_id))
        text = cc.tf3_regular_text_color + perk_name
        BWPersonality.GUICore.showToolTip(text, tooltipID=self.__class__.__name__)
        return result

    def handleMouseLeaveEvent(self, comp):
        result = Interceptor.handleMouseLeaveEvent(self, comp)
        BWPersonality.GUICore.hideToolTip()
        return result

    def sort_order(self):
        return perks_parser.get_perk_level(self.perk_id)

    def set_value(self, value):
        self.component.count.text = unicode(value)


class AuraperksUi(DragWin, GUIPositions):

    def __init__(self):
        comp = GUI.Window()
        comp.position = self._default_position()
        comp.ha, comp.va = ('LEFT', 'TOP')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = 0, Block.size
        comp.isClip = False
        comp.visible = False
        DragWin.__init__(self, comp)
        GUIPositions.__init__(self)
        self._perk_blocks = []

    def _sort_align_components(self):
        self._perk_blocks.sort(key=lambda pb: pb.sort_order())
        pos = 0
        for block in self._perk_blocks:
            block.component.position = (pos, 0, 0.5)
            pos += Block.size

        self.component.width = pos

    def _on_show(self):
        GUIPositions.show(self)

    def _on_hide(self):
        pass

    def update(self, perk_ids, values):
        for p_id, value in zip(perk_ids, values):
            block = next((b for b in self._perk_blocks if b.perk_id == p_id), None)
            if value:
                if not block:
                    block = Block(p_id)
                    self._perk_blocks.append(block)
                    self.component.addChild(block.component)
                effect_id = perks_parser.get_effect_aura(p_id)
                effect_data = getEffect(effect_id)
                value = min(value, effect_data['maxStacks'])
                block.set_value(value)
            elif block:
                self._perk_blocks.remove(block)
                self.component.delChild(block.component)

        self._sort_align_components()
        visible = bool(self._perk_blocks)
        if self.component.visible != visible:
            self.component.visible = visible
            if visible:
                self._on_show()
            else:
                self._on_hide()
        return

    def clear(self):
        for block in self._perk_blocks:
            self.component.delChild(block.component)

        self._perk_blocks[:] = []
        self._sort_align_components()
        if self.component.visible:
            self.component.visible = False
            self._on_hide()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)

    def reset_position(self):
        self.component.position = self._default_position()

    def _default_position(self):
        return (0.35, 0.9, 0.54)