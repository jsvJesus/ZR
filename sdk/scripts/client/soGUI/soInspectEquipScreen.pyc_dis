    def _slot_handler(self, event, data):
        if not self.current_target_id:
            return False
        if BigWorld.player().clientAccessLevel < 6:
            return False
        if event == ITSLOT.SLOTEVENT_DROP:
            char_slot, invent_slot = data
            if not isinstance(invent_slot, soInventorySlot2):
                return False
            item = invent_slot.itemData
            BigWorld.player().cell.developer_giveItemToNPC(item['complexItemID'], self.current_target_id)
            self.wait()
        return True

    def _slotHandler(self, event, data):
        pass

    def show(self, target):
        if BigWorld.player().clientAccessLevel < 6:
            return
        else:
            if self.component.parent is None:
                BWPersonality.GUICore.worldLayer.addChild(self.component, 'inspectScreen')
            self.current_target_id = target.id
            self.component.visible = True
            BWPersonality.GUICore.setBestCursor()
            self.wait()
            BigWorld.player().cell.get_entity_CarryingItems(target.id)
            return

    def hide(self):
        self.current_target_id = 0
        self.component.visible = False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def update_equipment_slots(self, target):
        for slot in self._equipment_slots:
            if slot.itemData:
                cur_item_id = slot.itemData['complexItemID']
                if not EST.get_slot_data(target, slot.slot_type)['itemID']:
                    needed_item_id = None
                    update_lock = True
                    if needed_item_id:
                        item = cur_item_id != needed_item_id and ItemsUtils.GetComplexItemByID(target, needed_item_id)
                        slot.setContent(item)
                        update_lock = False
                elif cur_item_id:
                    slot.setContent(None)
                    update_lock = False
                update_lock and slot.lockSlot(not slot.haveItem())

        return

    def updateSlots(self, target):
        self.component.charName.text = get_entity_name(target, utf8=True)
        self.clearDarkScreen()
        data = target.GetCharacterEquippedItemsDict()
        for slot_id, item in data.items():
            if slot_id in self.slots:
                self.slots[slot_id].setContent(item)

        self.update_equipment_slots(target)

    def wait(self):
        self.clearDarkScreen()
        self.component.darkScreen.visible = True

    def clearDarkScreen(self):
        self.component.darkScreen.visible = False