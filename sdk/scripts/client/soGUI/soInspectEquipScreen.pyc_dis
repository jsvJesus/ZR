DraggableComponent = PyGUI.DraggableComponent.DraggableComponent

class soInspectSlot(soCharacterSlot):

    def __init__(self, component, charID):
        soCharacterSlot.__init__(self, component, charID)

    def unequip(self):
        target_id = BWPersonality.GUICore.inspectScreen.current_target_id
        item_id = self.itemData['complexItemID']
        if not target_id or not item_id:
            return
        BigWorld.player().cell.developer_takeItemFromNPC(item_id, target_id)


