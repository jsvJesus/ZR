# Embedded file name: ./client/soGUI/storinventory/filter_line.py
from Localization import lc
import BWPersonality
from utils import Listenable
import GUI
import Keys
from donate_catalog_tags import TAGS_IDS, TAGS_PICS, TAGS_LC, universal_pic
from Helpers.PyGUI.PyGUIBase import Interceptor
from model import EventType as ModelET
import colorCodes as cc

class PicET:
    OnClick, = ((r, 'storinventory.filter.pic') for r in range(1))


class Pic(Interceptor, Listenable):

    def __init__(self, tag_id):
        Listenable.__init__(self)
        self._selected = False
        self._hovered = False
        self.tag_id = tag_id
        image_path = TAGS_PICS[tag_id] if tag_id else universal_pic
        comp = GUI.Window(image_path)
        Interceptor.__init__(self, comp)
        self._update_color()

    def handleMouseEnterEvent(self, comp):
        result = Interceptor.handleMouseEnterEvent(self, comp)
        if self.tag_id:
            text = TAGS_LC[self.tag_id].capitalize()
        else:
            text = lc('StoreHouse.filterstripe.ALL_TAG').capitalize()
        BWPersonality.GUICore.showToolTip(cc.active_xml + text, delay=0)
        self._hovered = True
        self._update_color()
        return result

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip()
        result = Interceptor.handleMouseLeaveEvent(self, comp)
        self._hovered = False
        self._update_color()
        return result

    def handleMouseButtonEvent(self, comp, event):
        result = Interceptor.handleMouseButtonEvent(self, comp, event)
        if not event.isRepeatedEvent() and event.isKeyDown() and event.key == Keys.KEY_LEFTMOUSE:
            data = {'pic': self}
            self.notify_listeners(PicET.OnClick, data)
        return result

    def set_selected(self, selected):
        self._selected = selected
        self._update_color()

    def _update_color(self):
        if self._selected:
            if self._hovered:
                alpha = 255
            else:
                alpha = 190
        elif self._hovered:
            alpha = 150
        else:
            alpha = 100
        self.component.colour[3] = alpha


class FilterLine:

    def __init__(self, component, model):
        self.component = component
        self._model = model
        self._model.add_listener(self._on_model_event)
        self._pics = []
        pos_x = 0
        tag_ids = list(TAGS_IDS)
        tag_ids[0] = None
        for tag_id in tag_ids:
            pic = Pic(tag_id)
            pic.add_listener(self._on_pic_event)
            comp = pic.component
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.width, comp.height = self.component.height, self.component.height
            comp.filterType = 'LINEAR'
            comp.ha, comp.va = ('LEFT', 'CENTER')
            comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
            comp.position = (pos_x, 0, 0.5)
            self.component.addChild(comp)
            self._pics.append(pic)
            pos_x += comp.width + 6

        self._update_selection()
        return

    def _update_selection(self):
        for pic in self._pics:
            pic.set_selected(self._model.filter_tag == pic.tag_id)

    def _on_model_event(self, event_type, data):
        if event_type == ModelET.OnFilterChanged:
            self._update_selection()

    def _on_pic_event(self, event_type, data):
        if event_type == PicET.OnClick:
            self._model.set_filter(data['pic'].tag_id)