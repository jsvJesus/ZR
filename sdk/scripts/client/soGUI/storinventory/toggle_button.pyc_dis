        return True

    def _update_visual(self):
        if self._opened:
            self.component.image.textureName = 'soGUI/frame/inventory/storage_open.dds'
            if self._hovered:
                self.component.image.colour = (255, 255, 255, 255)
            else:
                self.component.image.colour = cc.active_rgba
        else:
            self.component.image.textureName = 'soGUI/frame/inventory/storage.dds'
            if self._hovered:
                self.component.image.colour = cc.active_rgba
            else:
                self.component.image.colour = cc.inactive_rgba

    def show_wing(self, show_value):
        self.component.corner.colour[3] = lerp(self._corner_alpha, 0, show_value)

    def set_open(self, opened):
        self._opened = opened
        self._update_visual()

    def mark_pip(self, value):
        self.component.pip.visible = value