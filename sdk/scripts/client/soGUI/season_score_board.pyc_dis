        self.component.addChild(cmp, 'label_page')

    def createRanksBlockBlock(self):
        count = len(pvp_rating_config.conf)
        leftoffset = 200
        wx = (self.component.width - leftoffset) / count
        if wx < RANK_ICON_SIZE:
            return
        h = self.component.height - 100
        for index, rank in enumerate(pvp_rating_config.conf):
            x = leftoffset + wx * (index + 0.5)
            cmp = RankInfo(rank).component
            self.component.addChild(cmp, 'rank_icon_%s' % index)
            cmp.position = (x, h, 0.1)
            comp = GUI.Text(lc(rank['name']))
            comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
            comp.horizontalAnchor = 'CENTER'
            comp.verticalAnchor = 'CENTER'
            comp.font = 'RobotoCondensedRegular_14.font'
            comp.colour = (150, 150, 150, 255)
            comp.materialFX = 'BLEND'
            comp.position = (x, h + RANK_ICON_SIZE / 2 + 10, 0.1)
            self.component.addChild(comp, 'rank_name_%s' % index)
            comp = GUI.Text(str(rank['rating']))
            comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
            comp.horizontalAnchor = 'CENTER'
            comp.verticalAnchor = 'CENTER'
            comp.font = 'RobotoCondensedRegular_14.font'
            comp.colour = (220, 220, 220, 255)
            comp.materialFX = 'BLEND'
            comp.position = (x, h + RANK_ICON_SIZE / 2 + 30, 0.1)
            self.component.addChild(comp, 'rank_rating_%s' % index)

    def createTable(self):
        sW, sH = BigWorld.screenSize()
        UserRating.SLOTWIDTH = sW - 20
        self._rows = int((self.component.height - 180) // UserRating.SLOTHEIGHT)
        self._rows = max(1, self._rows)
        self._rows = min(30, self._rows)
        self.ratingView = soItemView(GUI.Window(), UserRating, slot_eventsHandler=self.slotHandler, eventsHandler=self.viewHandler, rowWidth=1, cols=1, rows=self._rows, vScroll=False, hScroll=False, borderWidth=0, parent_script=self)
        comp = self.ratingView.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.position = (3, 30, 0.5)
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'rating_view')
        self.ratingView.onBound()
        self.ratingView.setRestrictingComponent(None)
        self.ratingView.setItems(None)
        return

    def show(self):
        if not self.component.visible:
            return
        if not self.component.parent.visible:
            return
        player = BigWorld.player()
        player.base.getRatingPageFromMe(self._rows)
        player.base.checkSeasonReward()
        self.update()

    def update(self):
        self._first = 0
        if self._req_id:
            BigWorld.cancelCallback(self._req_id)
            self._req_id = 0
        self.ratingView.setItems(BWPersonality.GUICore.bulletinBoardRatingDS)
        enabled = BWPersonality.GUICore.bulletinBoardSeasonRewardDS
        self.btn_take_reward.setDisabledState(not enabled)
        if BWPersonality.GUICore.bulletinBoardRatingDS:
            self._first = BWPersonality.GUICore.bulletinBoardRatingDS[0]['pos']
            self._editPageBox.setValue(str(self._first))
        text = '/%s' % BWPersonality.GUICore.bulletinBoardRatingCount
        self.component.label_page.text = text

    def hide(self):
        self._editPageBox.activate(False)
        self._search_box.activate(False)

    def slotHandler(self, *e):
        pass

    def viewHandler(self, *e):
        pass

    _req_id = 0

    def _reqPage(self):
        if self._req_id:
            BigWorld.cancelCallback(self._req_id)
        self._req_id = BigWorld.callback(0.4, self._realyReq)

    def _realyReq(self):
        if self._first > 20000:
            self._first = 0
        BigWorld.player().base.getRatingPage(self._first, self._rows)

    def buttonHomeClick(self):
        self._first = 1
        self._editPageBox.setValue(str(self._first))
        self._reqPage()

    def buttonLeftClick(self):
        self._first -= self._rows
        self._first = max(1, self._first)
        self._reqPage()
        self._editPageBox.setValue(str(self._first))

    def buttonRightClick(self):
        self._first += self._rows
        self._reqPage()
        self._editPageBox.setValue(str(self._first))

    def goto(self):
        pos = self._editPageBox.rawText
        if not pos.isdigit():
            return
        self._first = int(pos)
        self._first = max(1, self._first)
        self._reqPage()

    def _ralySearchByName(self):
        text = self._search_box.rawText[:30]
        if text:
            BigWorld.player().base.getRatingPageSearchName(text)
        else:
            BigWorld.player().base.getRatingPageFromMe(self._rows)

    def searchByName(self):
        if self._req_id:
            BigWorld.cancelCallback(self._req_id)
        self._req_id = BigWorld.callback(0.4, self._ralySearchByName)

    def onBtnTakeReward(self):
        BigWorld.player().base.getSeasonReward()
        self.btn_take_reward.setDisabledState(True)