    def handleMouseLeaveEvent(self, cmp):
        if not self.haveItem():
            return False
        BWPersonality.GUICore.hideToolTip()
        return True

    def handleMouseEnterEvent(self, cmp):
        if not self.haveItem():
            return False
        pos = self.itemData['pos']
        reward = pvp_rating_config.top10_reward.get(pos, {})
        pos = cc.active_xml + unicode(pos) + cc.inactive_xml
        tooltip = cc.inactive_xml + lc('season_score_board.tooltip.top10reward').format(pos) + '\n'
        if not reward:
            tooltip += cc.active_xml + lc('season_score_board.tooltip.no_reward') + '\n'
        else:
            if reward.get('money'):
                money = cc.active_xml + reward['money'] + cc.inactive_xml
                tooltip += cc.inactive_xml + lc('season_score_board.tooltip.reward_money').format(money)
                tooltip += '\n'
            if reward.get('items'):
                tooltip += cc.inactive_xml + lc('season_score_board.tooltip.reward_items') + '\n' + cc.active_xml
                for itemType, count in reward['items'].items():
                    item_name = ItemsUtils.GetItemName(itemType)
                    tooltip += u'   {0} x {1}\n'.format(item_name, count)

        BWPersonality.GUICore.showToolTip(tooltip, '')
        return True

    def _applyItemData(self):
        visible = bool(self.haveItem())
        self.component.rating_icon.visible = visible
        self.component.pos.visible = visible
        self.component.name.visible = visible
        self.component.clan.visible = visible
        self.component.rating.visible = visible
        self.component.wins.visible = visible
        self.component.escape.visible = visible
        self.component.games.visible = visible
        self.component.kills.visible = visible
        self.component.deaths.visible = visible
        if visible:
            self.component.top10.visible = self.itemData['pos'] <= 10
            if not self.haveItem():
                return
            rank = pvp_rating_config.getRank(self.itemData['rating'])
            self.component.rating_icon.textureName = rank['icon']
            self.component.pos.text = str(self.itemData['pos'])
            self.component.name.text = self.itemData['name']
            self.component.clan.text = self.itemData['clan_name'].decode('utf-8')
            self.component.rating.text = str(self.itemData['rating'])
            self.component.wins.text = str(self.itemData['wins'])
            self.component.escape.text = str(self.itemData['escape'])
            self.component.games.text = str(self.itemData['number_games'])
            self.component.kills.text = str(self.itemData['number_kills'])
            self.component.deaths.text = str(self.itemData['number_deaths'])
            text_color = (255, 255, 255, 255)
            text_color = self.itemData['name'] == BigWorld.player().name and (155, 123, 78, 255)
        for comp_name in ('name', 'clan', 'rating', 'wins', 'escape', 'games', 'kills', 'deaths'):
            getattr(self.component, comp_name).colour = text_color


class RankInfo(PyGUIBase):

    def __init__(self, rank):
        self.component = GUI.Window()
        PyGUIBase.__init__(self, self.component)
        self.component.script = self
        self.component.crossFocus = True
        self.rank = rank
        self.setupRoot()
        self.setupContent()

    def handleMouseLeaveEvent(self, cmp):
        BWPersonality.GUICore.hideToolTip()
        return True

    def handleMouseEnterEvent(self, cmp):
        tooltip = cc.inactive_xml
        reward = self.rank['reward']

        def act(txt):
            return cc.active_xml + unicode(txt) + cc.inactive_xml

        if not reward:
            tooltip += lc('season_score_board.tooltip.no_reward') + '\n'
        else:
            tooltip += lc('season_score_board.tooltip.reward') + '\n'
            if reward.get('money'):
                tooltip += '   ' + lc('season_score_board.tooltip.reward_money').format(act(reward['money']))
                tooltip += '\n'
            if reward.get('items'):
                tooltip += '   ' + lc('season_score_board.tooltip.reward_items') + '\n'
                for itemType, count in reward['items'].items():
                    item_name = ItemsUtils.GetItemName(itemType)
                    tooltip += u'      {0} x {1}\n'.format(act(item_name), act(count))

        reward_levelup = self.rank.get('reward_levelup')
        if reward_levelup:
            tooltip += lc('season_score_board.tooltip.reward_levelup') + '\n'
            if reward_levelup.get('money'):
                tooltip += '   ' + lc('season_score_board.tooltip.reward_money').format(act(reward_levelup['money']))
                tooltip += '\n'
            if reward_levelup.get('exp'):
                tooltip += '   ' + lc('season_score_board.tooltip.reward_exp').format(act(reward_levelup['exp']))
                tooltip += '\n'
        if self.rank.get('access_officers_club'):
            tooltip += lc('season_score_board.tooltip.access_officers_club') + '\n'
        connect_penalty = self.rank['connect_penalty']
        tooltip += lc('season_score_board.tooltip.connect_penalty').format(act(connect_penalty))
        BWPersonality.GUICore.showToolTip(tooltip, '')
        return True

    def setupRoot(self):
        self.component.horizontalPositionMode = 'PIXEL'
        self.component.verticalPositionMode = 'PIXEL'
        self.component.horizontalAnchor = 'CENTER'
        self.component.verticalAnchor = 'CENTER'
        self.component.widthMode = 'PIXEL'
        self.component.heightMode = 'PIXEL'
        self.component.height = RANK_ICON_SIZE
        self.component.width = RANK_ICON_SIZE

    def setupContent(self):
        cmp = GUI.Simple(self.rank['icon'])
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = RANK_ICON_SIZE
        cmp.width = RANK_ICON_SIZE
        cmp.filterType = 'LINEAR'
        cmp.position = (0, 0, 0.1)
        self.component.addChild(cmp, 'rank_icon')


