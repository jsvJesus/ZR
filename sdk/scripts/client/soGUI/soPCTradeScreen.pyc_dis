class AnimItemView(soItemView):
    """docstring for soItemView"""
    factoryString = 'soGUI.soItemSlot'

    def __init__(self, *w, **kw):
        self._items = []
        self._new_added = []
        self._to_deleted = []
        soItemView.__init__(self, *w, **kw)

    def onAddItem(self, item):
        pass

    def onRemoveItem(self, item):
        pass

    def onUpdatedItems(self):
        pass

    def setItems(self, items):
        if items:
            self._items = items
        else:
            self._items = []
        soItemView.setItems(self, self._items)

    def clear(self):
        self._new_added = []
        self._to_deleted = []
        self._items = []
        soItemView.setItems(self, self._items)

    def _is_exsist_item(self, item):
        for x in self._items:
            if x['complexItemID'] == item['complexItemID']:
                return True

    def _remove_item(self, item):
        for x in self._items:
            if x['complexItemID'] == item['complexItemID']:
                self._items.remove(x)
                return True

    def addItem(self, item):
        if self._is_exsist_item(item):
            return False
        self._items.append(item)
        self.onAddItem(item)
        self._new_added.append(item['complexItemID'])
        soItemView.setItems(self, self._items)
        return True

    def removeItem(self, item):
        if not self._is_exsist_item(item):
            self._redawItems()
            return False
        self._to_deleted.append(item['complexItemID'])
        soItemView.setItems(self, self._items)

        def setitems():
            if self._remove_item(item):
                self.onRemoveItem(item)
            self._redawItems()

        BigWorld.callback(0.5, setitems)
        return True

    def _redawItems(self):
        soItemView.setItems(self, self._items)

    def updateItems(self, opp_items):
        updated = False
        for item in opp_items:
            updated |= self.addItem(item)

        for item in self._items:
            if item not in opp_items:
                updated |= self.removeItem(item)

        if updated:
            self.onUpdatedItems()

    def has_blink(self, item_id):
        return item_id in self._new_added or item_id in self._to_deleted

    def blink_status(self, item_id):
        if item_id in self._new_added:
            self._new_added.remove(item_id)
            return True
        if item_id in self._to_deleted:
            self._to_deleted.remove(item_id)
            return False


