            self.component.itemEmblem.visible = False
        self.set_drag_proxy_visual(self.component.itemIcon.texture, self.multiselected)
        return

    def _blinkCommonent(self, component, add_value = True):
        if add_value:
            component.colour = (0, 255, 0, 150)
        else:
            component.colour = (255, 0, 0, 150)
        shad = component.blink
        shad.value = 1.0
        shad.reset()
        shad.mode = 'ALL'
        shad.start = 1.0
        shad.stop = 0.0
        shad.alpha = 1
        shad.speed = 0.6
        shad.value = 0.0

    def onDragStart(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        return True


