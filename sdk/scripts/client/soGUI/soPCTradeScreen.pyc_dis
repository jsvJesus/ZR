    def notiferOnRemoveItem(self, item):
        if not self.component.visible:
            return
        player = BigWorld.player()
        if not player:
            return
        opponent_name = u'???'
        if BWPersonality.GUICore.tradeDataSection and BWPersonality.GUICore.tradeDataSection.has_key('contractor_name'):
            opponent_name = BWPersonality.GUICore.tradeDataSection['contractor_name']
        message = lc('GUI.InterPlayerTrade.OPPONENT_REMOVE_ITEM').format(opponent_name)
        msg = u"<font color='#FF0000'>{0}</font> {1}".format(message, ItemsUtils.GetInterfaceItemName(item))
        player.putMessage(CHANNEL_CONSTS.ITEMS, msg)

    def notiferOnAddItem(self, item):
        if not self.component.visible:
            return
        player = BigWorld.player()
        if not player:
            return
        opponent_name = u'???'
        if BWPersonality.GUICore.tradeDataSection and BWPersonality.GUICore.tradeDataSection.has_key('contractor_name'):
            opponent_name = BWPersonality.GUICore.tradeDataSection['contractor_name']
        message = lc('GUI.InterPlayerTrade.OPPONENT_ADD_ITEM').format(opponent_name)
        msg = u"<font color='#00FF00'>{0}</font> {1}".format(message, ItemsUtils.GetInterfaceItemName(item))
        player.putMessage(CHANNEL_CONSTS.ITEMS, msg)

    def notiferChangeMoney(self, old, new):
        pass

    def notiferChangeGold(self, old, new):
        pass

    def cancelOfferTrade(self):
        player = BigWorld.player()
        if player and not player.ExchangeProperties.fOffer:
            return
        else:
            BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_CHANGE_TERMS, None)
            return

    def mySlotHandler(self, event, data):
        if event == ITSLOT.SLOTEVENT_MOUSELEAVE:
            BWPersonality.GUICore.toolTipEvent([PC_TRADE.SOURCE_PLAYER, data.itemData], self.interfaceID, soToolTipComponent.EVENT_HIDE)
            return True
        if event == ITSLOT.SLOTEVENT_MOUSEENTER:
            BWPersonality.GUICore.toolTipEvent([PC_TRADE.SOURCE_PLAYER, data.itemData], self.interfaceID, soToolTipComponent.EVENT_SHOW)
            return True
        if event == ITSLOT.SLOTEVENT_DBLCLICK:
            BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_ACTION, [PC_TRADE.SOURCE_PLAYER, data.itemData])
            return True
        if event == ITSLOT.SLOTEVENT_RCLICK:
            BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_CONTEXT, [PC_TRADE.SOURCE_PLAYER, data.itemData])
            return True
        return False

    def myIVHandler(self, event, data):
        from soGUI.soInventorySlot2 import soInventorySlot2
        if event == ITSLOT.SLOTEVENT_DRAGENTER:
            if isinstance(data[1], soInventorySlot2):
                return True
        if event == ITSLOT.SLOTEVENT_DROP:
            if isinstance(data[1], soInventorySlot2):
                slot = data[1]
                item_ids = slot.get_multiselection()
                items = ItemsUtils.get_multiple_items_by_ids(BigWorld.player(), item_ids)
                self.blockOfferBtn()
                BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_ADDITEM, items)
                return True
        return False

    def hisSlotHandler(self, event, data):
        if event == ITSLOT.SLOTEVENT_RCLICK:
            BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_CONTEXT, [PC_TRADE.SOURCE_CONTRACTOR, data.itemData])
            return True
        if event == ITSLOT.SLOTEVENT_MOUSELEAVE:
            BWPersonality.GUICore.toolTipEvent([PC_TRADE.SOURCE_CONTRACTOR, data.itemData], self.interfaceID, soToolTipComponent.EVENT_HIDE)
            return True
        if event == ITSLOT.SLOTEVENT_MOUSEENTER:
            BWPersonality.GUICore.toolTipEvent([PC_TRADE.SOURCE_CONTRACTOR, data.itemData], self.interfaceID, soToolTipComponent.EVENT_SHOW)
            return True
        return False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def hisIVHandler(self, event, data):
        return False

    def _onUpadeMoneyEdit(self, value):
        if self.component.visible:
            BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_MONEYSET, value)
            self.blockOfferBtn()

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'pc_trade')
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        return

    def _blinkCommonent(self, component, add_value = True):
        if add_value:
            component.colour = (0, 255, 0, 150)
        else:
            component.colour = (255, 0, 0, 150)
        shad = component.blink
        shad.value = 1.0
        shad.reset()
        shad.mode = 'ALL'
        shad.start = 1.0
        shad.stop = 0.0
        shad.alpha = 1
        shad.speed = 0.9
        shad.value = 0.0

    def blinkMoney(self, add_value = True):
        self._blinkCommonent(self.component.hisWnd.bg_money, add_value)

    def hide(self):
        self.ExchangeEnded()
        BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_ABORT, None)
        return

    def ExchangeEnded(self):
        self.component.visible = False
        self._opponent_money.setValue(0)
        self.component.hisWnd.itemView.script.clear()
        self.component.playerWnd.edit.script.activate(False)
        self.component.playerWnd.edit.script.setValue(u'0')
        BWPersonality.GUICore.setBestCursor()

    def update(self):
        if not self.component.visible:
            return
        else:
            data = BWPersonality.GUICore.tradeDataSection
            if data is None:
                return
            if data.has_key('player_items'):
                self.component.playerWnd.itemView.script.setItems(data['player_items'])
            self.component.hisWnd.his_info_msg.text = u''
            if data.has_key('opponent_entity'):
                opponent_entity = data['opponent_entity']
                self.component.hisWnd.itemView.script.updateItems(opponent_entity.ExchangeProperties.ItemsToExchange)
                op_money = opponent_entity.ExchangeProperties.CreditsToExchange
                if self._opponent_money.getValue() != op_money:
                    self.blinkMoney(self._opponent_money.getValue() < op_money)
                    self.notiferChangeMoney(self._opponent_money.getValue(), op_money)
                    self.cancelOfferTrade()
                    self._opponent_money.setValue(op_money)
                if opponent_entity.ExchangeProperties.fAccept:
                    self.component.hisWnd.his_info_msg.text = lc('Common.Messages.OPPONENT_ACCEPT')
                elif opponent_entity.ExchangeProperties.fOffer:
                    self.component.hisWnd.his_info_msg.text = lc('Common.Messages.OPPONENT_OFFER')
                if opponent_entity.ExchangeProperties.fOffer and BigWorld.player().ExchangeProperties.fOffer and not BigWorld.player().ExchangeProperties.fAccept:
                    self.component.playerWnd.confirmBtn.script.buttonDisabled = False
                else:
                    self.component.playerWnd.confirmBtn.script.buttonDisabled = True
                self.component.playerWnd.confirmBtn.script._updateVisualState()
            if data.has_key('player_name'):
                self.component.playerWnd.pName.text = data['player_name']
            if data.has_key('contractor_name'):
                self.component.hisWnd.hisName.text = data['contractor_name']
            if data.has_key('player_confirmation'):
                self.component.playerWnd.confirm.visible = data['player_confirmation']
                if not self._blockedBtn:
                    self.component.playerWnd.offerBtn.script.buttonDisabled = data['player_confirmation']
                    self.component.playerWnd.offerBtn.script._updateVisualState()
                self.component.playerWnd.cancelBtn.script.buttonDisabled = not data['player_confirmation']
                self.component.playerWnd.cancelBtn.script._updateVisualState()
                if data['player_confirmation']:
                    self.component.playerWnd.edit.script.activate(False)
            if data.has_key('contractor_confirmation'):
                self.component.hisWnd.confirm.visible = data['contractor_confirmation']
            if data.has_key('input_validator'):
                self.component.playerWnd.edit.script.setValidator(data['input_validator'])
            if data.has_key('message'):
                self.component.playerWnd.info_msg.text = ''
            return

    def updateCangeParameters(self):
        money = self._opponent_money.getValue() - self.component.playerWnd.edit.script.getValue()
        slots = len(self.component.playerWnd.itemView.script.items) - len(self.component.hisWnd.itemView.script.items)
        my_weight = 0
        his_weight = 0
        for item in self.component.hisWnd.itemView.script.items:
            item_params = ItemsCatalog.GetItemParam(item['complexItemType'])
            if item_params:
                his_weight += item_params.get('Weight', 0)

        for item in self.component.playerWnd.itemView.script.items:
            item_params = ItemsCatalog.GetItemParam(item['complexItemType'])
            if item_params:
                my_weight += item_params.get('Weight', 0)

        text = lc('Inventory.client.PCT_TRACE_CHANGE_PARAMS') % (slots, his_weight - my_weight)
        text1 = lc('Inventory.client.PCT_TRACE_CHANGE_MONEY') % (money,)
        self.component.hisWnd.slotChangeLabel.text = text
        self.component.hisWnd.moneyChangeLabel.text = text1

    def updateButtonConfirm(self, hideButton):
        self.component.playerWnd.offerBtn.script.confirm = hideButton
        self.component.playerWnd.offerBtn.script._updateVisualState()

    def blockOfferBtn(self):
        self.component.playerWnd.offerBtn.script.setDisabledState(True)
        self._blockedBtn = True
        if self._callback:
            BigWorld.cancelCallback(self._callback)
            self._callback = None
        self._callback = BigWorld.callback(2.0, self.unBlockOfferBtn)
        return

    def unBlockOfferBtn(self):
        self._blockedBtn = False
        self.component.playerWnd.offerBtn.script.setDisabledState(False)

    def _updateConfirmationAvailability(self):
        player = BigWorld.player()
        if not player.ExchangeProperties.fAccept and player.ExchangeProperties.fOffer:
            self.component.playerWnd.confirmBtn.script.buttonDisabled = False
        else:
            self.component.playerWnd.confirmBtn.script.buttonDisabled = True
        self.component.playerWnd.confirmBtn.script._updateVisualState()

    def onOfferBtn(self):

        def comply():
            self.component.playerWnd.edit.script.activate(False)
            BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_OFFER, None)
            return

        def listener(code):
            if code == gui_jokes.askUserYesNo.YES:
                comply()

        contractor_items = BWPersonality.GUICore.tradeDataSection['contractor_items']
        contractor_money = int(BWPersonality.GUICore.tradeDataSection['contractor_money'])
        if not contractor_money and not contractor_items:
            title = lc('Inventory.client.PCT_TRADE_CHECKDECEIVER_TITLE')
            msg = lc('Inventory.client.PCT_TRACE_FREE')
            gui_jokes.askUserYesNo(title, msg, listener)
        else:
            comply()

    def onConfirmBtn(self):

        def listener(event):
            if not self.component.visible:
                return
            if self.component.playerWnd.confirmBtn.script.buttonDisabled:
                return
            if event == gui_jokes.askUserYesNo.YES:
                self._continueConfirm()

        self._continueConfirm()

    def _continueConfirm(self):
        player = BigWorld.player()
        if not player:
            return
        elif not player.ExchangeProperties.fOffer:
            return
        else:
            opponent_entity = player.GetExchangeOpponentEntity()
            if not opponent_entity:
                return
            elif not opponent_entity.ExchangeProperties.fOffer:
                return
            self.component.playerWnd.confirmBtn.script.buttonDisabled = True
            self.component.playerWnd.confirmBtn.script._updateVisualState()
            BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_CONFIRM, None)
            return

    def onCancelBtn(self):
        BWPersonality.GUICore.pcTradeEvent(PC_TRADE.EVENT_CANCEL, None)
        return

    def onCloseBox(self):
        self.hide()