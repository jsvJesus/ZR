        btn.onClick = self.onBtnSetClick

    def onBtnBuyClick(self):
        if not self.haveItem():
            return
        base_name = self.itemData['base_name']
        if not self.itemData['count'] != self.get_max_count():
            buy_status = self.itemData['entity_type'] == CaptureEntityType.DECORATION
            guid = self.itemData['guid']
            player = BigWorld.player()
            if not player.checkClanRights(Clan.FLAG_CAN_BASE_BUY_ENTITIES):
                gui_jokes.askUserOk(u'', lc('B2CEntitiesInfo.ClanRightsError'))
                return
            if buy_status:
                cost = u''
                cost = lc('B2CEntitiesInfo.for_money').format(self.itemData['cost_ruble'])
                if self.itemData['cost_ruble'] > self.itemData['clan_money']:
                    gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_OK'), lc('B2CEntitiesInfo.base_money_error'))
                    return
                if self.itemData['cost_clan_points'] > player.clanpoints:
                    gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_OK'), lc('B2CEntitiesInfo.base_CP_error'))
                    return
                msg = lc('B2CEntitiesInfo.ask_buy_entity').format(self.itemData['lcname'], cost, self.itemData['cost_clan_points'])
            msg = buy_status or lc('B2CEntitiesInfo.ask_delete_entity').format(self.itemData['lcname'])

        def listener(event):
            if event == gui_jokes.askUserYesNo.YES:
                self._buy_entity(base_name, guid, buy_status)

        gui_jokes.askUserYesNo(lc('B2CEntitiesInfo.title_msg'), msg, listener, enter_btn=gui_jokes.askUserYesNo.YES)

    def onBtnSetClick(self):
        if not self.haveItem():
            return
        if self.itemData['entity_type'] == CaptureEntityType.FRACTION_TRADER:
            BWPersonality.GUICore.fract_win.show(self.itemData['guid'])
            return
        if self.itemData['entity_type'] == CaptureEntityType.DECORATION:
            BWPersonality.GUICore.showEmblemsScreen(True, self.itemData['guid'], self.itemData['max_count'], self.itemData['additional_int'], self.itemData['level'])
            return
        if self.itemData['entity_type'] == CaptureEntityType.GUARDIAN:

            def listener(event):
                if event == gui_jokes.askUserYesNo.YES:
                    player = BigWorld.player()
                    player.start_guardians_buying()
                    BWPersonality.GUICore.showBaseMoneyInfo(False)

            gui_jokes.askUserYesNo(lc('B2CEntitiesInfo.title_msg'), lc('B2CEntitiesInfo.ask_buy_guard'), listener, enter_btn=gui_jokes.askUserYesNo.YES)

    @dealyed_slot
    def _buy_entity(self, base_name, guid, buy_status):
        player = BigWorld.player()
        if guid in Clan.BaseGuardianType.get_names():
            guard_type = Clan.BaseGuardianType.get_type_name(guid)
            player.cell.buy_guardian(base_name, guard_type)
            return
        player.cell.buy_attached_entity_base(base_name, guid, buy_status)

    def _applyItemData(self):
        self.component.entity_name.text = u''
        self.component.level.text = u''
        self.component.entity_name.visible = self.haveItem()
        self.component.count.visible = self.haveItem()
        self.component.level.visible = self.haveItem()
        self.component.money.visible = self.haveItem()
        self.component.money_per_day.visible = self.haveItem()
        self.component.clanpoints.visible = self.haveItem()
        self.component.button_buy.visible = self.haveItem()
        self.component.button_set.visible = self.haveItem()
        if self.haveItem():
            self.component.entity_name.text = self.itemData['lcname']
            self.component.level.text = str(self.itemData['level_can_buy'])
            self.component.money.text = str(self.itemData['cost_ruble'])
            self.component.money_per_day.text = str(self.itemData['payment_per_day_rouble'])
            self.component.clanpoints.text = str(self.itemData['cost_clan_points'])
            self.component.button_buy.script.setDisabledState(False)
            self.component.button_set.script.setDisabledState(True)
            self.component.count.text = u'{0}/{1}'.format(self.itemData['count'], self.get_max_count())
            self.component.button_set.label.text = lc('B2CEntitiesInfo.btn_pop')
            if self.itemData['entity_type'] == CaptureEntityType.GUARDIAN:
                self.component.button_buy.label.text = lc('B2CEntitiesInfo.btn_buy')
                self.itemData['lcname'] = lc('BaseToCapture.GUARDIANS.{0}'.format(self.itemData['guid']))
                self.component.entity_name.text = self.itemData['lcname']
                self.component.button_buy.script.setDisabledState(self.itemData['count'] >= self.get_max_count())
                self.component.button_set.script.setDisabledState(self.itemData['count'] == 0)
                self.itemData['base_level'] < self.itemData['level_can_buy'] and self.component.button_buy.script.setDisabledState(True)
            return
        if self.itemData['entity_type'] == CaptureEntityType.FRACTION_TRADER:
            self.component.button_set.label.text = lc('B2CEntitiesInfo.btn_change')
            p = BigWorld.player()
            if not self.itemData['count'] < self.get_max_count():
                disable = not p.checkClanRights(Clan.FLAG_CAN_CHANGE_FRACT_TRADER)
                self.component.button_set.script.setDisabledState(disable)
            elif self.itemData['entity_type'] == CaptureEntityType.DECORATION:
                self.component.button_set.label.text = lc('B2CEntitiesInfo.btn_load')
                p = BigWorld.player()
                disable = self.itemData['count'] < self.get_max_count() or not p.checkClanRights(Clan.FLAG_CAN_CHANGE_ICON) or not ClanSettings.can_change_emblem(p.clan_level)
                self.component.button_set.script.setDisabledState(disable)
            if self.itemData['count'] >= self.get_max_count():
                self.component.button_buy.label.text = lc('B2CEntitiesInfo.remove_entity')
                if self.itemData['entity_type'] == CaptureEntityType.DECORATION:
                    self.component.button_buy.label.text = lc('B2CEntitiesInfo.btn_up')
                    self.component.button_buy.script.setDisabledState(self.itemData['level'] >= 3)
            else:
                self.component.button_buy.label.text = lc('B2CEntitiesInfo.btn_buy')
                if self.itemData['base_level'] < self.itemData['level_can_buy']:
                    self.component.button_buy.script.setDisabledState(True)

    def get_max_count(self):
        if self.itemData['entity_type'] == CaptureEntityType.DECORATION:
            return 1
        return self.itemData['max_count']