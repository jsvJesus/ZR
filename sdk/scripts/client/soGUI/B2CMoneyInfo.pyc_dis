        self.component.modTab.addChild(cmp, 'base_count_value')
        return

    def slotHandler(self, *e):
        pass

    def viewHandler(self, *e):
        pass

    def update(self, base_name, data):
        self.clearDarkScreen()
        self.base_name = base_name
        self.base_money = data['clan_money']
        self._money.setValue(data['clan_money'])
        self._money1.setValue(data['clan_money'])
        self._money2.setValue(data['clan_money'])
        text = u''
        for e in data['money_info']:
            text += lc('B2CEntitiesInfo.income').format(e['lcname'], e['income']) + '\n'

        self.ctext.setText(text or '\n')
        self.component.infoTab.base_name_value.text = lc('BaseToCaptureNames.%s' % base_name)
        self.component.infoTab.base_level_value.text = lc('B2CEntitiesInfo.level').format(data['level'])
        self.component.infoTab.base_clan_value.text = BigWorld.player().clanName.decode('utf-8')
        self.component.modTab.clan_level_value.text = lc('B2CEntitiesInfo.level').format(data['level'])
        self.component.modTab.clan_points_value.text = str(BigWorld.player().clanpoints)
        next_time = BWPersonality.GUICore.baseToCaptureGUI.get_next_attack_time()
        self.component.infoTab.base_attack_time_value.text = ItemsUtils.timeToString(next_time)
        self.loadClanIcon(BigWorld.player().clanEmblemID)
        entities_info = map(dict, data['entities_info'])
        bylevel = dict(base_level=data['level'], base_name=base_name, clan_money=data['clan_money'])
        map(lambda x: x.update(bylevel), entities_info)
        entities_info.sort(key=lambda x: (x['level_can_buy'], x['cost_ruble'], x['cost_clan_points']))
        self.itemView.setItems(entities_info)

        def on_load(prereqs):
            texture = prereqs.produce(0)
            self.component.infoTab.base_screen.texture = texture if texture.loadedSuccess else self.default_base_screen

        path = 'soGUI/basetocapture_screens/{0}.dds'.format(self.base_name)
        ResourceLoader.asyncLoad([(ResourceLoader.TEXTURE, path)], on_load)

    def change_tab(self, tab_id):
        tab_list = [self.component.infoTab, self.component.accountTab, self.component.modTab]
        for i in tab_list:
            i.visible = 0

        tab_list[tab_id].visible = 1
        self.component.infoTabBtn.script.buttonActive = tab_list[TAB_INFO].visible
        self.component.infoTabBtn.script._updateVisualState()
        self.component.accountTabBtn.script.buttonActive = tab_list[TAB_AC].visible
        self.component.accountTabBtn.script._updateVisualState()
        self.component.modTabBtn.script.buttonActive = tab_list[TAB_MOD].visible
        self.component.modTabBtn.script._updateVisualState()
        if self.base_name:
            if tab_id == TAB_MOD:
                BigWorld.player().cell.show_info_entities_base(self.base_name)
            else:
                BigWorld.player().cell.show_info_money_base(self.base_name)
            self.wait()

    def show(self, base_name = ''):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.iLabel.text = lc('B2CEntitiesInfo.btn_base_managment')
        self.ctext.setText(u'')
        self._money.setValue(0)
        if not base_name:
            base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
            base_name = base_gui._current_base
        self.base_name = base_name
        self.change_tab(TAB_INFO)
        self.itemView.setItems(None)
        self.component.visible = True
        self.doReposition()
        return

    def hide(self):
        self.component.visible = False

    def doReposition(self):
        sW, sH = BigWorld.screenSize()
        self.component.position = (0, 0, 0.49)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEvent(self, component, event):
        if event.dz:
            if event.dz > 0:
                self.component.accountTab.ctext.script.scrolledUP()
            elif event.dz < 0:
                self.component.accountTab.ctext.script.scrolledDOWN()
            return True
        return False

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def clearData(self):
        pass

    def wait(self):
        self.clearDarkScreen()
        self.component.darkScreen.visible = True
        self._clbID = BigWorld.callback(5, self.clearDarkScreen)

    def clearDarkScreen(self):
        if self._clbID:
            BigWorld.cancelCallback(self._clbID)
            self._clbID = 0
        self.component.darkScreen.visible = False

    def _drawIcon(self, imgID, feedName = '', texture = None):
        component = self.component.infoTab.clan_icon
        if imgID and texture:
            component.visible = True
            component.texture = texture
        else:
            component.visible = False
            component.texture = None
        return

    def loadClanIcon(self, iconID):
        pl = BigWorld.player()
        if pl:
            if iconID != 0:
                UCManager.ucmanager.loadImg(iconID, self._drawIcon)
            else:
                self._drawIcon(0)

    def _check_base_money(self, credits):
        if credits <= 0:
            return False
        if credits > self.base_money:
            gui_jokes.askUserOk(u'', lc('B2CEntitiesInfo.base_money_error'))
            return False
        return True

    def _check_player_money(self, credits):
        if credits < 0:
            return False
        p_credits, _ = ItemsUtils.GetPlayerMoney(BigWorld.player())
        if credits > p_credits:
            gui_jokes.askUserOk(u'', lc('B2CEntitiesInfo.player_money_error'))
            return False
        return True

    @checkRight(Clan.FLAG_CAN_BASE_ADD_MONEY)
    def on_add_money(self):

        @dealyed
        def callback(self, text):
            if not text.isdigit():
                return
            if self._check_player_money(int(text)):
                BigWorld.player().cell.add_money_to_base(self.base_name, int(text))

        gui_jokes.inputBox(lc('BaseToCaptureNames.%s' % self.base_name), lc('B2CEntitiesInfo.label_add_money'), lambda e: callback(self, e), active=True)

    @checkRight(Clan.FLAG_CAN_BASE_WITHDRAW_MONEY)
    def on_withdraw_money(self):

        @dealyed
        def callback(self, text):
            if not text.isdigit():
                return
            if self._check_base_money(int(text)):
                BigWorld.player().cell.withdraw_money_from_base(self.base_name, int(text), 0)

        gui_jokes.inputBox(lc('BaseToCaptureNames.%s' % self.base_name), lc('B2CEntitiesInfo.label_withdraw_money'), lambda e: callback(self, e), active=True)

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()


class EntitySlot(soItemSlot):
    factoryString = 'soGUI.BarterPaySlot'
    SLOTWIDTH = 739
    SLOTHEIGHT = 42

    def __init__(self, component, slotIndex, itemData = None):
