# Embedded file name: ./client/soGUI/font_families.py
import GUI
_global_families = {'ArialNarrow_10.family': 'ArialNarrow_10.font',
 'ArialNarrow_12.family': 'ArialNarrow_12.font',
 'ruRU_Cyrvetica_Extra_10i.family': 'ruRU_Cyrvetica_Extra_10i.font',
 'RobotoCondensedRegular_12.family': 'RobotoCondensedRegular_12.font',
 'ArialNarrowClearShadow_14.family': 'ArialNarrowClearShadow_14.font'}
_direct_china_replace = {'RobotoCondensedRegular_18.font': 'china_18.font',
 'RobotoCondensedRegular_20.font': 'china_20.font',
 'RobotoCondensedRegular_24.font': 'china_24.font',
 'RobotoCondensedRegular_28.font': 'china_28.font',
 'RobotoCondensedRegular_32.font': 'china_32.font',
 'RobotoCondensedRegular_36.font': 'china_36.font'}

def _standard_hook(font_name, component):
    return _global_families.get(font_name) or font_name


def _china_hook(font_name, component):
    return _global_families.get(font_name) or _direct_china_replace.get(font_name) or 'china_16.font'


def initialize(language):
    if language == 'chinese':
        GUI.setFontHook(_china_hook)
    else:
        GUI.setFontHook(_standard_hook)