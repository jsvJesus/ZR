import BigWorld
import BWPersonality
import GUI
import Helpers.PyGUI as PyGUI
import soGUI
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from soGUI.soInventoryScreen import soInventoryScreen2
from soGUI.soInventorySlot2 import soInventorySlot2
from soGUI.soCraftGUI import CraftGUI
from soGUI.soCharacterScreen import soCharacterSlot, soGadgetSlot
from soGUI.soQuickSlotsBar import soActionSlot
from soGUI.soItemView import soItemSlot

class soGUILayer(PyGUIBase):
    factoryString = 'soGUI.soGUILayer'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.setupRoot()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.0)
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.visible = False
        cmp.dropFocus = True

    def handleDropEvent(self, component, dropped):
        if hasattr(dropped, 'script'):
            if not hasattr(dropped.script, 'factoryString'):
                return False
        if isinstance(dropped.script, soItemSlot):
            dropped.script.on_out_screen_drop()
            dropped.script.on_out_screen_drop_sound()
        fStr = dropped.script.factoryString
        if fStr == 'soGUI.soPartSlot':
            BWPersonality.GUICore.craftEvent(CraftGUI.EVENT_DELITEM, dropped.script.slotInfo)
        if fStr == 'soGUI.soTradeSlot':
            dropped.script.returnToParent()
        return True

    def handleDragEnterEvent(self, comp, dragged):
        if dragged and isinstance(dragged.script, soItemSlot):
            dragged.script.on_out_screen_enter()
        return True

    def handleDragLeaveEvent(self, comp, dragged):
        if dragged and isinstance(dragged.script, soItemSlot):
            dragged.script.on_out_screen_leave()
        return True

    def handleMouseEvent(self, cmp, event):
        BWPersonality.GUICore.mouseMovementEvent([event.dx,
         event.dy,
         event.dz,
         (event.cursorPosition.x, event.cursorPosition.y)])
        return False