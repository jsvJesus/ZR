def tempBlocked(item):
    if not item:
        return
    return item['complexItemID'] in temporary_blocked_items


class guiKeyEvent(object):

    def __init__(self, key, down, mods = None):
        self.key = key
        self.down = down
        self.modifiers = mods

    def isKeyDown(self):
        return self.down


class InventoryItemView(soItemView):

    def __init__(self, *args, **kargs):
        soItemView.__init__(self, *args, **kargs)
        self.set_multiselectable()
        self._items_count = 0

    def scroll_items_count(self):
        return max(soItemView.scroll_items_count(self), self._items_count)

    def set_slot_content(self, slot, content):
        soItemView.set_slot_content(self, slot, content)
        value = slot.index < self._items_count or slot.haveItem()
        slot.component.frameCmp.visible = value

    def get_multiselection_from_item(self, item):
        if self._multiselection and item['complexItemID'] in self._multiselection:
            return self._multiselection
        return [item['complexItemID']]

    def set_items_count(self, items_count):
        self._items_count = items_count
        self._applyItems()
        self._updateMaxScroll()


class CircleMenuToggleButton(Interceptor):

    def __init__(self, component):
        Interceptor.__init__(self, component)
        self._hovered = False
        self._toggled = False
        self._interface_id = self.__class__.__name__
        self._update_visual()

    def handleMouseEnterEvent(self, comp):
        result = Interceptor.handleMouseEnterEvent(self, comp)
        self._hovered = True
        self._update_visual()
        BWPersonality.GUICore.showToolTip(cc.active_xml + lc('GUI.circle_menu.tooltip'), self._interface_id)
        return result

    def handleMouseButtonEvent(self, comp, event):
        if event.isKeyDown() and event.key == Keys.KEY_LEFTMOUSE:
            self.toggled = not self.toggled
        return True

    def untoggle(self):
        self.toggled = False

    @property
    def toggled(self):
        return self._toggled

    @toggled.setter
    def toggled(self, value):
        if value == self._toggled:
            return
        self._toggled = value
        self._update_visual()
        BWPersonality.GUICore.circle_menu_edit_mode(self.toggled)

    def handleMouseLeaveEvent(self, comp):
        result = Interceptor.handleMouseLeaveEvent(self, comp)
        self._hovered = False
        self._update_visual()
        BWPersonality.GUICore.hideToolTip(self._interface_id)
        return result

    def _update_visual(self):
        if self._toggled:
            self.component.colour = (255, 255, 255, 255)
        elif self._hovered:
            self.component.colour = (200, 200, 200, 255)
        else:
            self.component.colour = (140, 140, 140, 255)


