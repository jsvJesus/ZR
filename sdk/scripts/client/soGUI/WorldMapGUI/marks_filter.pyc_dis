    def _on_toggle_click(self, button):
        if button.toggled:
            button.toggled = False
            self.mode.remove(button.mode)
        else:
            button.toggled = True
            self.mode.add(button.mode)
        data = {'mode': button.mode,
         'value': button.toggled}
        self.notify_listeners(FilterEventType.FilterChanged, data)

    def get_value(self, mode):
        return self._buttons[mode].toggled

    def on_size_changed(self):
        win_width = self._component.width
        self._component.ncpsFilter.position.x = win_width - 62
        self._component.personalFilter.position.x = win_width - 90
        self._component.partyFilter.position.x = win_width - 118
        self._component.targetFilter.position.x = win_width - 146
        self._component.questsFilter.position.x = win_width - 174
        self._component.corpsesFilter.position.x = win_width - 202