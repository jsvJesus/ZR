import GUI
from soGUI.soButton import soButton
from functools import partial
from utils import Listenable

class ToggleButton(soButton):

    def __init__(self, *args, **kargs):
        soButton.__init__(self, *args, **kargs)
        self._toggled = False

    def _updateVisualState(self):
        if self._toggled:
            self.setVisualState('toggled')
        else:
            soButton._updateVisualState(self)

    @property
    def toggled(self):
        return self._toggled

    @toggled.setter
    def toggled(self, value):
        if self._toggled == value:
            return
        self._toggled = value
        self._updateVisualState()


class FilterEventType:
    FilterChanged = 1


class FilterMode:
    Personal, Npc, Party, Target, Quests, Corpses = xrange(6)


