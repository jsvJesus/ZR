        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.materialFX = 'BLEND'
        comp.width, comp.height = comp.texture.width, comp.texture.height * 0.25
        comp.position = (0, 28, 0.1)
        btn = ToggleButton(comp)
        btn.initVSC('soGUI/frame/map/toggle_button.xml')
