class MarkBtn(EqpButton):

    def __init__(self, component, mark_type):
        self.mark_type = mark_type
        EqpButton.__init__(self, component)

    def _create_content(self):
        self._color = MapNotes.colors[MapNotes.WHITE]
        image_path = MapNotes.get_path(self.mark_type)
        comp = GUI.Window(image_path)
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.8)
        comp.width, comp.height = comp.texture.width, comp.texture.height
        self.component.addChild(comp, 'image')

    def update_visual(self, hovered, pressed):
        col = Vector4(self._color)
        col[3] = 200 if hovered else 255
        self.component.image.colour = col

    def set_color(self, color):
        self._color = color
        self._update_visual()


class ColorBtn(EqpButton):

    def update_visual(self, hovered, pressed):
        self.component.colour[3] = 200 if hovered else 255


class ColorPicker(object):

    def __init__(self, component):
        self.component = component
        self._selected = None
        self.on_selection_changed = lambda : None
        size = 20
        margin = 4
        space = (self.component.width - margin * 2 - size * 3) * 0.5
        self._buttons = {}
        pos_x = margin
        for color_id in (MapNotes.RED, MapNotes.YELLOW, MapNotes.GREEN):
            comp = GUI.Window('soGUI/frame/paint/white.dds')
            comp.materialFX = 'BLEND'
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
            comp.ha, comp.va = ('CENTER', 'CENTER')
            comp.width, comp.height = size, size
            comp.colour = MapNotes.colors[color_id]
            comp.position = (pos_x + size * 0.5, 0, 0.5)
            self.component.addChild(comp)
            pos_x += size + space
            btn = ColorBtn(comp)
            self._buttons[color_id] = btn
            btn.on_press = partial(self._on_click, color_id)

        comp = GUI.Frame2('soGUI/frame/map/frame_color.dds')
        comp.visible = False
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('PIXEL', 'CLIP')
        comp.width, comp.height = size + 8, size + 8
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp, 'frame')
        return

    def _on_click(self, color_id):
        self.selected = None if self.selected == color_id else color_id
        return

    @property
    def selected(self):
        return self._selected

    @selected.setter
    def selected(self, value):
        if self._selected == value:
            return
        self._selected = value
        comp = self.component.frame
        if self._selected:
            pos = self._buttons[self._selected].component.position
            comp.position = (pos[0], 0, comp.position[2])
            comp.visible = True
        else:
            comp.visible = False
        self.on_selection_changed()


