        column_width = component.width / columns
        self._type_to_button = {}
        for i, mark_type in enumerate(MapNotes.get_all_types()):
            column = i % columns
            row = i / columns
            comp = GUI.Window()
            button = MarkBtn(comp, mark_type)
            self._type_to_button[mark_type] = button
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.position = (column_width * column, 140 + row_height * row, 0.2)
            comp.width, comp.height = column_width, row_height
            button.on_press = partial(self._on_mark_button_click, mark_type)
            component.addChild(comp, 'mark' + str(mark_type))
            button.do_reposition()

        comp = GUI.Frame2('soGUI/frame/map/frame_color.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.width = column_width - AddMarkWin.FRAME_DISP[0] * 2
        comp.height = row_height - AddMarkWin.FRAME_DISP[1] * 2
        component.addChild(comp, 'markframe')
        self._hightligh_mark(MapNotes.MOB)
        return

    def _on_color_changed(self):
        self._update_colors()

    def _update_colors(self):
        color_id = self._color_picker.selected or MapNotes.WHITE
        color = MapNotes.colors[color_id]
        for button in self._type_to_button.itervalues():
            button.set_color(color)

    def _on_mark_button_click(self, mark_type):
        self._hightligh_mark(mark_type)

    def _hightligh_mark(self, mark_type):
        mark_comp = self._type_to_button[mark_type].component
        self.component.markframe.position = mark_comp.position + AddMarkWin.FRAME_DISP
        self._hightlighted_type = mark_type

    def _on_ok_click(self):
        color = self._color_picker.selected or MapNotes.WHITE
        self._callback(self.component.editbox.script.rawText, self._hightlighted_type, color)
        self._callback = None
        self.hide()
        return

    def show(self, callback, init_note_data = None):
        if init_note_data:
            self.component.editbox.script.setValue(init_note_data['notes'])
            self._color_picker.selected = init_note_data['color']
            self._hightligh_mark(init_note_data['flags'])
        else:
            self.component.editbox.script.clear()
        self.component.editbox.script.activate(True)
        self._callback = callback
        self.component.visible = True
        self._update_colors()

    def hide(self):
        self.component.editbox.script.clear()
        self.component.editbox.script.activate(False)
        self.component.visible = False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)