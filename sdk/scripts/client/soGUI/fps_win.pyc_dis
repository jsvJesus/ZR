# Embedded file name: ./client/soGUI/fps_win.py
import BigWorld
import GUI
from Helpers.PyGUI.PyGUIBase import DragWin
from soGUI.GUIPositions import GUIPositions
from Helpers.PyGUI import Utils
from utils import Tickable
from soGUI.UtilsGUI.TextScaler import TextScaler

class FpsWin(DragWin, GUIPositions, Tickable):

    def __init__(self):
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.hm, comp.wm = ('PIXEL', 'PIXEL')
        comp.colour = (255, 255, 255, 75)
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.width, comp.height = (0, 0)
        comp.materialFX = 'BLEND'
        comp.visible = False
        comp.position = self._get_default_position()
        DragWin.__init__(self, comp)
        GUIPositions.__init__(self)
        Tickable.__init__(self, tick_delay=0.5)
        comp = GUI.Text()
        comp.hm, comp.wm = ('PIXEL', 'PIXEL')
        self._text = comp
        self._ts = TextScaler(self._text, 'Shop_18')
        self.component.addChild(self._text)

    def can_tick(self):
        return Utils.is_visible_in_hierarchy(self.component)

    def show(self):
        self.component.visible = True
        GUIPositions.show(self)
        self._ts.do_reposition()
        self.update_content()
        self.start_tick()

    def _get_default_position(self):
        return (1, 0, 0.9)

    def reset_position(self):
        self.component.position = self._get_default_position()
        GUIPositions.on_size_changed(self)

    def onParentSizeChanged(self, component):
        self._ts.do_reposition()
        self.update_content()
        GUIPositions.on_size_changed(self)

    def update_content(self):
        ping = int(round(BigWorld.LatencyInfo().value[3] * 1000))
        fps = int(round(BigWorld.fps()))
        self._text.text = 'FPS: {0} PING: {1}'.format(fps, ping)
        width, height = self._text.stringDimensions(self._text.text)
        self.component.height = height + 8
        self.component.width = width + 16

    def on_tick(self):
        self.update_content()

    def hide(self):
        self.component.visible = False
        self.stop_tick()

    def stopDragging(self):
        DragWin.stopDragging(self)
        GUIPositions.stopDragging(self)