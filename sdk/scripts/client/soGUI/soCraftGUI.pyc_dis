    def setupSlots(self):
        indexSlot = 0
        for i in xrange(self.MAXSLOT_I):
            for j in xrange(self.MAXSLOT_Y):
                slot = soPartSlot(GUI.Window())
                cmp = slot.component
                cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
                cmp.widthMode = cmp.heightMode = 'PIXEL'
                cmp.horizontalAnchor = 'LEFT'
                cmp.verticalAnchor = 'TOP'
                cmp.colour = (255, 255, 255, 255)
                cmp.materialFX = 'BLEND'
                cmp.width = 64
                cmp.height = 64
                cmp.position = (220 + j * 64, 71 + i * 64, 0.5)
                self.component.addChild(cmp, 'partSlot' + str(indexSlot))
                indexSlot += 1

    def show(self, recipes_type = None):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'craftGUI')
        self.component.visible = True
        self.recipes_type = []
        self.update(after_show=True)
        BWPersonality.GUICore.setBestCursor()
        return

    def hide(self):
        self.component.visible = False
        self.onClear()
        self.component.blueprints.script.clear()
        BigWorld.player().InitCraft()
        BWPersonality.GUICore.setBestCursor()
        BWPersonality.GUICore.updateTopmostObjects()

    def setCancelBtn(self, value):
        if self.component.cancelBtn:
            self.component.cancelBtn.visible = value

    def update(self, after_show = False):
        data = BWPersonality.GUICore.craftDataSection
        recipes = data['recipes'] + self.recipes_type
        recDDL = self.component.blueprints.script
        selectedRec = recDDL.getSelection()[0]
        recDDL.clear()
        elems = []
        for recipe in recipes:
            recipeName = BigWorld.player().GetReceiptName(recipe)
            elem = [recipe, recipeName]
            elems.append(elem)

        if after_show and len(recipes) > 0:
            recipe_name = BigWorld.player().GetReceiptName(recipes[0])
            recDDL.setSelectionByText(recipe_name, True, True)
            BWPersonality.GUICore.craftEvent(self.EVENT_SELECT, recipes[0])
            return
        else:
            items = data['items']
            for i in xrange(self.MAXSLOT):
                cmp = self.component.__getattribute__('partSlot' + str(i))
                cmp.script.empty()

            min_art_depl = None
            if data['recipie_id']:
                min_art_depl = ItemsUtils.getRecipieMinArtifactDepleetionPercent(data['recipie_id'])
            for i in xrange(len(items)):
                cmp = self.component.__getattribute__('partSlot' + str(i))
                item = ItemsUtils.GetComplexItemByID(BigWorld.player(), items[i])
                if not item:
                    cmp.script.setIcon('nottexture.dds')
                    continue
                item_type = item['complexItemType']
                item_id = item['complexItemID']
                item_class = ItemsCatalog.GetItemClass(item_type)
                item_params = ItemsCatalog.GetItemParam(item_type)
                item_level = item_params['exp_Level']
                cmp.script.setSlotInfo(item['complexItemID'])
                if not ItemsUtils.GetIconName(item):
                    iconName = 'nottexture.dds'
                    cmp.script.setIcon(iconName)
                    if min_art_depl is not None and ItemsCatalog.GetItemClass(item_type) == ItemsCatalog.ARTIFACT:
                        ItemsUtils.GetArtefactDepleetionPercent(item) < min_art_depl and cmp.script.markAsBroken(True)
                cmp.script.setCount(ItemsUtils.GetDisplayValue(item))

            if data['autofill']:
                self.component.autofill.script.setActive()
            else:
                self.component.autofill.script.setInactive()
            recDDL.addElements(elems)
            recDDL.setSelectionByText(selectedRec, True, True)
            txt = self.component.textFld.script
            txt.setText(data['description'])
            if data.has_key('icon'):
                self.component.recipeIcon.textureName = data['icon']
            else:
                self.component.recipeIcon.textureName = ''
            return

    def handleDragEnterEvent(self, comp, dragged):
        return True

    def handleDropEvent(self, component, dropped):
        from soGUI.soInventorySlot2 import soInventorySlot2
        if isinstance(dropped.script, soInventorySlot2):
            BWPersonality.GUICore.craftEvent(self.EVENT_ADDITEM, dropped.script.itemData)
        return True

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    @PyGUIEvent('blueprints', 'onSelectedElement')
    def onRecipe(self, recID):
        BWPersonality.GUICore.craftEvent(self.EVENT_SELECT, recID)

    @PyGUIEvent('autofill', 'onStateChange')
    def onAuto(self):
        if BWPersonality.GUICore.craftDataSection is None:
            return
        else:
            state = BWPersonality.GUICore.craftDataSection['autofill']
            if self.component.autofill.script.isChecked() != state:
                BWPersonality.GUICore.craftEvent(self.EVENT_AUTOFILL, self.component.autofill.script.isChecked())
            return

    @PyGUIEvent('clearBtn', 'onClick')
    def onClear(self):
        BWPersonality.GUICore.craftEvent(self.EVENT_CLEAR, None)
        return

    @PyGUIEvent('cancelBtn', 'onClick')
    def onCancel(self):
        BWPersonality.GUICore.craftEvent(self.EVENT_CANCEL, None)
        return

    @PyGUIEvent('craftBtn', 'onClick')
    def onCraft(self):
        BWPersonality.GUICore.craftEvent(self.EVENT_CRAFT, None)
        return

    @PyGUIEvent('closeBox', 'onClick')
    def onClose(self):
        BWPersonality.GUICore.craftEvent(self.EVENT_CLOSE, None)
        BWPersonality.GUICore.showCraftGUI(False)
        return

    @PyGUIEvent('hintBox', 'onClick')
    def onHintBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        BWPersonality.GUICore.openGUIHelp('soCraftGUI')

    def handleMouseButtonEvent(self, comp, event):
        self.component.blueprints.script.showList(False)
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEvent(self, component, event):
        if event.dz:
            if event.dz > 0:
                self.component.textFld.script.scrolledUP()
            elif event.dz < 0:
                self.component.textFld.script.scrolledDOWN()
            return True
        return False