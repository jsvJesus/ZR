    def reloadBaseToCaptureGUI(self):
        if self.baseToCaptureGUI is not None:
            self.baseToCaptureGUI.hide()
        import soGUI.base_to_capture_gui
        import soGUI.FlashGUIBase
        import soGUI.flash_utils
        import base_to_capture.flags_info_storage
        import base_to_capture.flying_camera
        import base_to_capture.temp_flag_mgr
        reload(soGUI.base_to_capture_gui)
        reload(soGUI.FlashGUIBase)
        reload(soGUI.flash_utils)
        reload(base_to_capture.flags_info_storage)
        reload(base_to_capture.flying_camera)
        reload(base_to_capture.temp_flag_mgr)
        from soGUI.base_to_capture_gui.base_to_capture_window import base_to_capture_window
        self.baseToCaptureGUI = base_to_capture_window()
        return

    def getBaseToCaptureGUI(self):
        if self.baseToCaptureGUI is None:
            self.baseToCaptureGUI = base_to_capture_window()
            self.baseToCaptureGUI.hide()
        return self.baseToCaptureGUI

    def is_base_to_capture_gui_visible(self):
        return self.baseToCaptureGUI and self.baseToCaptureGUI.visible

    def showBaseToCaptureGUI(self, doShow = True, force = True):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c/\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x81 \xd0\xb8\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb5\xd0\xb9 \xd0\xbe \xd0\xb1\xd0\xb0\xd0\xb7\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""
        if self.baseToCaptureGUI is None:
            self.baseToCaptureGUI = base_to_capture_window()
        if not force and not self.baseToCaptureGUI.avatar_inside_base_radius:
            self.baseToCaptureGUI.hide()
            return
        else:
            if doShow:
                self.baseToCaptureGUI.show()
                self.setBestCursor()
            else:
                self.baseToCaptureGUI.hide()
            return

