    def show_cutscene(self, config, parent, depth):
        if not self._cutscene:
            self._cutscene = CsWin()
            parent.addChild(self._cutscene.component, 'Cs_win')
        comp = self._cutscene.component
        if comp.parent != parent:
            if comp.parent:
                comp.parent.delChild(comp)
            parent.addChild(comp)
        if comp.position[2] != depth:
            comp.position[2] = depth
            comp.parent.reSort()
        self._cutscene.show(config)

