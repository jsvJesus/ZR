    def showTempOptions(self):
        pass

    def show_tutorial_skip_in_ingame_menu(self, show):
        if not steam_client_api.STEAM_MODE:
            return
        else:
            if self.ingameMenuGUI is None:
                self.ingameMenuGUI = soIngameMainMenu(GUI.Window())
                self.ingameMenuGUI.onBound()
                self.ingameMenuGUI.component.position = (0, 0, 0.05)
            self.ingameMenuGUI.show_skip(show)
            return

    def showIngameMenu(self, doShow = True):
        if self.ingameMenuGUI is None:
            self.ingameMenuGUI = soIngameMainMenu(GUI.Window())
            self.ingameMenuGUI.onBound()
            self.ingameMenuGUI.component.position = (0, 0, 0.05)
        if self.actionBar is not None:
            self.actionBar.component.script.resetDragProxy()
        if doShow:
            if self.chatConsole:
                self.chatConsole.save_settings()
                self.chatConsole.hide()
            if self.messageBoxFlash:
                self.messageBoxFlash.hide()
            self.ingameMenuGUI.show()
            self.setMouseAltState(False)
        else:
            self.ingameMenuGUI.hide()
            if self.chatConsole:
                self.chatConsole.show()
            if self.messageBoxFlash:
                self.messageBoxFlash.check_msg_boxes()
        return

    def showPackageSell(self, doShow = True):
        if self.packageGUI is None and doShow:
            self.packageGUI = soGUI.BarterWindowGUI.BarterWindow(GUI.Window())
            self.packageGUI.onBound()
        if doShow:
            self.packageGUI.show()
        elif self.packageGUI:
            self.packageGUI.hide()
        return

    def showCraftGUI(self, doShow = True, workbench = None, payed = False):
        if doShow:
            if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and BigWorld.player().isAdminAccess():
                if self.craftGUI is None and doShow:
                    self.craftGUI = CraftGUI(GUI.Window(), None)
                    self.craftGUI.onBound()
                self.craftGUI.show(None)
            else:
                if workbench:
                    workbench_type = workbench.workbenchType
                    need_kickstart_set = workbench.need_kickstart
                else:
                    workbench_type = WT.NONE
                    need_kickstart_set = False
                if workbench_type == WT.AMULET:
                    if not self._amcraft_window:
                        self._amcraft_window = AmcraftwWindow()
                        BWPersonality.GUICore.worldLayer.addChild(self._amcraft_window.component, 'amcraftGuiWindow')
                    self._amcraft_window.show(need_kickstart_set, payed)
                else:
                    if not self._craft_window:
                        self._craft_window = CraftWindow()
                        BWPersonality.GUICore.worldLayer.addChild(self._craft_window.component, 'craftGuiWindow')
                    self._craft_window.show(workbench_type, need_kickstart_set, payed)
        else:
            if self.craftGUI:
                self.craftGUI.hide()
            if self._craft_window_visible():
                self._craft_window.hide()
            if self._amcraft_window_visible():
                self._amcraft_window.hide()
        return

