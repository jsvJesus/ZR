            self._testrotw.onBound()
        self._testrotw.show(mode)
        return

    def updateTestWeaponWindowActiveItem(self):
        self.updateTestWeaponWindow()
        if self.dbg_window:
            self.dbg_window.updateWeaponList()

    def updateTestWeaponWindow(self, doReload = False):
        if BigWorld.isConsumer():
            return
        if not self.dbg_window or doReload:
            visible = not BigWorld.isConsumer()
            try:
                import __debug.debug_window.dbg_main
            except:
                print '-' * 30
                traceback.print_stack()
                traceback.print_exc()
                print '=' * 30
                return

            if doReload:
                reload(__debug.debug_window.dbg_main)
            self.dbg_window = __debug.debug_window.dbg_main.MainDebugWindow(GUI.Window())
            self.dbg_window.onBound()
            self.dbg_window.show(visible)
            if doReload:
                self.dbg_window.updateWeaponList()
                pl = BigWorld.player()
                if pl and hasattr(pl, 'setDirectionProviderParam'):
                    pl.setDirectionProviderParam()
        self.dbg_window.update()

    def WeaponWindowSwitch(self):
        self.updateTestWeaponWindow()
        if self.dbg_window:
            self.dbg_window.switch()

    def showGui(self):
        self.hiddenState = False
        for gui in self.hiddenGUIs:
            gui.visible = True

        self.hiddenGUIs.clear()

    def remove_hiddensGUI(self, comp):
        if hasattr(comp, 'component'):
            comp = comp.component
        if comp in self.hiddenGUIs:
            self.hiddenGUIs.remove(comp)

    def hideGui(self, hide_tutorial = True):
        self.hiddenState = True
        exceptions = [self.effectsLayer, self.bloodGUI.bloodgui_arrow, self.bloodGUI.bloodgui_panel]
        roots = GUI.roots()
        for root in roots:
            if root in exceptions:
                continue
            if root.visible:
                if not hide_tutorial and root == self.tutorialLayer:
                    continue
                self.hiddenGUIs.add(root)
                root.visible = False

