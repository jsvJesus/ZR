        if doShow:
            if self.room_find_win is None:
                self.room_find_win = soGUI.pvp_room_gui.room_find_win.PVPRoomFindWin()
                BWPersonality.GUICore.worldLayer.addChild(self.room_find_win.component, 'room_find_win')
                self.room_find_win.onBound()
            self.room_find_win.show()
        elif self.room_find_win:
            self.room_find_win.hide()
