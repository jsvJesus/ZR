    def get_inventory_gui(self):
        if self.inventoryGUI is None:
            self.inventoryGUI = soInventoryScreen2(GUI.Window())
            stor_inventory = StorInventory(self.inventoryGUI)
            BWPersonality.GUICore.worldLayer.addChild(stor_inventory.component, 'meta_inventory')
