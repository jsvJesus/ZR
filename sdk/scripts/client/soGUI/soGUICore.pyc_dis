        meta_inventory = getattr(BWPersonality.GUICore.worldLayer, 'meta_inventory', None)
        return meta_inventory and meta_inventory.script

    def setPartiallyInventoryData(self, item):
        if self.inventoryDataSection and self.inventoryDataSection.has_key('items'):
            for _item in self.inventoryDataSection['items']:
                if _item['complexItemID'] == item['complexItemID']:
                    _item = item
                    break

        self.get_inventory_gui().partially_update(item)
        if self.grades_gui:
            self.grades_gui.partially_update(item)
        if self.infoWindowManger:
            self.infoWindowManger.updateCarryingItems([item])

    def setInventoryData(self, items, weight, money, filterMask = 0):
        prev_money, prev_weight = (None, None)
        if self.inventoryDataSection:
            prev_money = self.inventoryDataSection['money'][0]
            prev_weight = self.inventoryDataSection['weight'][:2]
        self.inventoryDataSection = {'items': items,
         'weight': weight,
         'money': money,
         'filters': filterMask}
        self.get_inventory_gui().update()
        if self.is_tradepaint_screen_visible():
            self.trade_screen.on_inventory_update()
        if self.infoWindowManger:
            self.infoWindowManger.updateCarryingItems(BigWorld.player().CarryingItems)
        cur_money = self.inventoryDataSection['money'][0]
        if prev_money != cur_money:
            self.money_changed(prev_money, cur_money)
        weight = self.inventoryDataSection['weight'][:2]
        if prev_weight != weight:
            self.weight_changed(*weight)
        return None

    def on_gasmaskfilter_changed(self, filter_type, cond):
        if self.gasfilterwin_visible():
            if not filter_type:
                self.gasfilter_win.hide()
        elif filter_type:
            self.gasfilter_win.show()
        if self.gasfilterwin_visible():
            self.gasfilter_win.update_ratio(filter_type, cond)

