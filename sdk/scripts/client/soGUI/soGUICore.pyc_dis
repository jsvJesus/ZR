        self.msgBoxMgr.fini()
        if BWPersonality.RELEASE and EngineStatistic:
            self.engineStatistic.hide()
            self.engineStatistic = None
        return

    def handleMouseEvent(self, event):
        handled = self.DnDHook(event)
        handled = self.mouseHook(event)
        return bool(handled)

    def handleCharEvent(self, char, key, mods):
        if self.characterReciever is not None:
            handled = self.characterReciever.script.handleChar(char, key, mods)
            if handled:
                return True
        return False

    def handleKeyEvent(self, event):
        key = event.key
        down = event.isKeyDown()
        if self.chatConsole and event.isMouseButton():
            if self.chatConsole.handleKeyEvent(event):
                if self.characterReciever is not None:
                    if hasattr(self.characterReciever.script, 'activate'):
                        self.characterReciever.script.activate(False)
                    elif hasattr(self.characterReciever.script, 'setActive'):
                        self.characterReciever.script.setActive(False)
                return True
        if self.contextMenu and self.contextMenu.isVisible and not down and key in (KEY_LEFTMOUSE,):
            BigWorld.callback(0.0, self.contextMenu.hide)
        if self.entityContextMenu and self.entityContextMenu.isVisible and not down and key in (KEY_LEFTMOUSE,):
            BigWorld.callback(0.0, self.hideEntityContextMenu)
        if hasattr(self.generalLayer, 'GUILocker'):
            if self.generalLayer.GUILocker.visible:
                if self.GUILockerCallback is not None:
                    self.GUILockerCallback(event)
                return True
        if self.keyHook(event):
            return True
        else:
            if down:
                if self.spaceLoaderGUI:
                    if self.spaceLoaderGUI.component.visible:
                        return True
            for topObj in self.topMostObjects:
                if not event.isMouseButton():
                    if self.topMostObjects[topObj].closeOnKey:
                        if down:
                            self.topMostObjects[topObj].restoreContent()

            if self.characterReciever is not None:
                handled = self.characterReciever.script.handleKeyEvent(event)
                if handled:
                    return True
            if self.contextLayer is not None and down:
                self.contextLayer.visible = False
            if self.contextMenu and self.contextMenu.isVisible:
                if down and key == KEY_ESCAPE:
                    self.contextMenu.hide()
                    return True
            if self.entityContextMenu and self.entityContextMenu.isVisible:
                if down and key == KEY_ESCAPE:
                    self.hideEntityContextMenu()
                    return True
            if self._menu_paint_screen:
                if not self._storehouse_screen or not self._storehouse_screen.visible:
                    if self._menu_paint_screen.handleKeyEvent(event):
                        return True
            if key == KEY_SPACE:
                handled = False
                if self.cutscenelist_visible():
                    handled = self._cutscene_list.handle_space(event)
                    return True
            if down and key == KEY_ESCAPE:
                handled = False
                if self.chatConsole is not None:
                    if self.chatConsole.is_fully_visible:
                        self.chatConsole.hide_chat()
                        self.chatConsole.save_settings()
                        handled = True
                        return True
                if self.filefinder_visible():
                    self._file_finder.hide()
                    return True
                if self._paint_screen and self._paint_screen.visible:
                    self._paint_screen.hide()
                    return True
                if self.infoWindowManger.isVisible():
                    self.infoWindowManger.closeTop()
                    handled = True
                    return True
                if self.weaponmod and self.weaponmod.component.visible:
                    self.weaponmod.hide()
                    return True
                if self.pvpScoreBar and self.pvpScoreBar.scoreBarVisible():
                    self.pvpScoreBar.setVisibleScore(False)
                    return True
                if self.repairMode:
                    self.showRepairMode(False)
                    return True
                if self.msgBoxMgr is not None:
                    handled = self.msgBoxMgr.onEscapeKey()
                    if handled:
                        return True
                if self.charScreen is not None:
                    if self.charScreen.component.visible:
                        self.showCharScreen(False)
                        handled = True
                if self.packageGUI is not None:
                    if self.packageGUI.component.visible:
                        self.showPackageSell(False)
                        handled = True
                if self.ingameMenuGUI is not None:
                    if self.ingameMenuGUI.component.visible:
                        self.showIngameMenu(False)
                        handled = True
                if self.playerTrade is not None:
                    if self.playerTrade.component.visible:
                        self.showPCTrade(False)
                        handled = True
                if self.eventStarter is not None:
                    if self.eventStarter.component.visible:
                        self.eventStarter.hide()
                        handled = True
                if self._B2CMoneyInfo is not None:
                    if self._B2CMoneyInfo.component.visible:
                        self.showBaseMoneyInfo(False)
                        handled = True
                if self.artifactQTE is not None:
                    if self.artifactQTE.component.visible:
                        self.showArtifactQTE(False)
                        handled = True
                if self.clanGUI is not None:
                    if self.clanGUI.component.visible:
                        self.showClanGUI(False)
                        handled = True
                if self.itemCacheGUI is not None:
                    if self.itemCacheGUI.component.visible:
                        self.showItemCache(False)
                        handled = True
                if self.itemLootCacheGUI is not None:
                    if self.itemLootCacheGUI.component.visible:
                        self.showItemLootCache(False)
                        handled = True
                if self.is_gifts_win_visible():
                    self._gifts_win.hide()
                    handled = True
                if self.userFireGUI is not None:
                    if self.userFireGUI.component.visible:
                        self.showUserFire(False)
                        handled = True
                if self.grades_gui is not None:
                    if self.grades_gui.component.visible:
                        self.show_grade_gui(False)
                        handled = True
                if self.startSaleGUI is not None:
                    if self.startSaleGUI.component.visible:
                        self.showStartSale(False)
                        handled = True
                if self.room_win is not None:
                    if self.room_win.component.visible:
                        self.showCreateRoom(False)
                        handled = True
                if self.room_find_win is not None:
                    if self.room_find_win.component.visible:
                        self.showFindRoom(False)
                        handled = True
                if self.rooms_win is not None:
                    if self.rooms_win.component.visible:
                        self.showPVPRooms(False)
                        handled = True
                if self.startSubmitOffender is not None:
                    if self.startSubmitOffender.component.visible:
                        self.hideSubmitOffender()
                        handled = True
                if self.friend_list.visible:
                    self.friend_list.hide()
                    handled = True
                if self.is_clanmanager_win_visible():
                    self.showClanManagerNPCGUI(False)
                    handled = True
                if self.QuitMenu is not None:
                    if self.QuitMenu.component.visible:
                        self.showQuitMenu(doShow=False)
                        handled = True
                if self.craftGUI is not None:
                    if self.craftGUI.component.visible:
                        self.showCraftGUI(False)
                        handled = True
                if self.inventoryGUI is not None:
                    if self.inventoryGUI.component.visible:
                        self.showInventory(False)
                        handled = True
                if self.privateStoreGUI is not None:
                    if self.privateStoreGUI.component.visible:
                        self.showPrivateStore(False)
                        handled = True
                if self.soBulletinBoard is not None:
                    if self.soBulletinBoard.component.visible:
                        if self.soBulletinBoard.ready_to_close():
                            self.showBulletinBoard(False)
                        handled = True
                if self.soBaseTrader is not None:
                    if self.soBaseTrader.component.visible:
                        self.showBasetrader(False)
                        handled = True
                if self.f1Help is not None:
                    if self.f1Help.component.visible:
                        self.showFlashHelp(False)
                        handled = True
                if self.flashHelpGUI is not None and self.flashHelpGUI.window_visible:
                    self.showFlashHelpGUI(False)
                    handled = True
                if self.clanEmblemsScreen is not None:
                    if self.clanEmblemsScreen.component.visible:
                        self.showClanEmblemsScreen(False)
                        handled = True
                if self.emblemsScreen is not None:
                    if self.emblemsScreen.component.visible:
                        self.showEmblemsScreen(False)
                        handled = True
                if hasattr(BigWorld.player(), 'playerGUI'):
                    if hasattr(BigWorld.player().playerGUI, 'questGUI'):
                        if BigWorld.player().playerGUI.questGUI.script.dlg:
                            BigWorld.player().playerGUI.questGUI.script.wantClose()
                            handled = True
                if self.clanGUI is not None:
                    if self.clanGUI.component.visible:
                        self.clanGUI.hide()
                        handled = True
                if self.soMassquestScreen and self.soMassquestScreen.component.visible:
                    self.soMassquestScreen.hide()
                    handled = True
                if self.soQuestRewardManager and self.soQuestRewardManager.handle_esc():
                    handled = True
                if self.selectMap is not None:
                    if self.selectMap.script.visible:
                        self.showSelectMap(False)
                        handled = True
                if self.shoiceTeamWindow is not None:
                    if self.shoiceTeamWindow.isVisible():
                        self.showChoiceTeam(False)
                        handled = True
                if self.baseToCaptureGUI is not None:
                    if self.baseToCaptureGUI.is_buying_state:
                        self.baseToCaptureGUI.stop_buying()
                        handled = True
                if self.emotionsGUI is not None:
                    if self.emotionsGUI.component.visible:
                        self.showEmotionsGUI(False)
                        handled = True
                if self.actionBar is not None:
                    self.actionBar.component.script.resetDragProxy()
                if self._tradepaint_screen and self._tradepaint_screen.visible:
                    self._tradepaint_screen.hide()
                    handled = True
                if self._world_map and self._world_map.visible:
                    self._world_map.hide()
                    handled = True
                if self.cutscenelist_visible():
                    self._cutscene_list.handle_esc()
                    handled = True
                if self._storehouse_screen and self._storehouse_screen.visible:
                    self._storehouse_screen.handle_esc()
                    handled = True
                if self.is_promo_gui_visible():
                    self._promo_gui.hide()
                    handled = True
                if self._dialog_screen and self._dialog_screen.visible:
                    self._dialog_screen.hide()
                    handled = True
                if self._craft_window_visible():
                    self._craft_window.hide()
                    handled = True
                if self._amcraft_window_visible():
                    self._amcraft_window.hide()
                    handled = True
                if self.journal_win_visible():
                    self._journal_win.hide()
                    handled = True
                if self.heliwin_visible():
                    self._heliwin.hide()
                    handled = True
                if self.barterwin_visible():
                    self._barterwin.hide()
                    handled = True
                if self.pdawin_visible():
                    self._pdawin.hide()
                    handled = True
                if self.gunpoint_win_visible():
                    self._gunpoint_win.hide()
                    handled = True
                if self._perks_window and self._perks_window.visible:
                    self._perks_window.hide()
                    handled = True
                if self.is_equip_paint_screen_visible():
                    self._equip_paint_screen.handle_esc()
                    handled = True
                if self.clanswin_visible():
                    self._clans_win.hide()
                    handled = True
                if self.fractwin_visible():
                    self._fract_win.hide()
                    handled = True
                if self.wimpwin_visible():
                    self._wimp_win.hide()
                    handled = True
                if self._warehouse_screen and self._warehouse_screen.visible:
                    self._warehouse_screen.hide()
                    handled = True
                if self._donate_auction_screen and self._donate_auction_screen.visible:
                    self._donate_auction_screen.hide()
                    handled = True
                if self._clan_reward_win and self._clan_reward_win.visible:
                    self._clan_reward_win.hide()
                    handled = True
                if self.npc_reload_ui_visible():
                    self._npc_reload_win.hide()
                    handled = True
                if handled:
                    self.setBestCursor()
                    return True
                self.setMouseAltState(False)
            if key in (KEY_RETURN, KEY_NUMPADENTER):
                if down:
                    handled = self.msgBoxMgr.onReturnKey()
                    if handled:
                        return True
                    if self.chatConsole is not None and self.chatConsole.visible and not self.chatConsole.is_fully_visible:
                        self.chatConsole.show_chat()
                        player = BigWorld.player()
                        if isinstance(player, Avatar.PlayerAvatar):
                            player.onShowChat()
                        return True
            return False

