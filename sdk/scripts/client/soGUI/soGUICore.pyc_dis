    def on_settings_changed(self, key, value):
        if key == 'fps_visible':
            if value and self._in_world:
                self.fps_win.show()
            elif self.fps_win_visible():
                self.fps_win.hide()
        elif key == 'compas_visible':
            if value and self._in_world:
                self.compass.show()
            elif self.compass_visible():
                self.compass.hide()
        elif key == 'weightwin_visible':
            if value and self._in_world:
                self.weight_win.show()
            elif self.weightwin_visible():
                self.weight_win.hide()
        elif key == 'actbar_type':
            self._set_actionbar_type(value)
        elif key == 'castbar_type':
            self._set_castbar_type(value)

    def _set_castbar_type(self, castbar_type):
        if self._castbar_type == castbar_type:
            return
        if self.cast_bar:
            self.cast_bar.cancelCast()
            self.worldLayer.delChild(self.cast_bar.component)
        self._castbar_type = castbar_type
        if not self.cast_bar:
            if self._castbar_type == CASTBAR_TYPE.CIRCLE:
                self._cast_bars[castbar_type] = CastBar()
            elif self._castbar_type == CASTBAR_TYPE.BAR:
                self._cast_bars[castbar_type] = CastbarBar()
        self.worldLayer.addChild(self.cast_bar.component)

    def has_actbar_circle_type(self):
        return ACTIONBAR_TYPE.has_circle(self._action_bar_type)

    def _set_actionbar_type(self, actbar_type):
        if self._action_bar_type == actbar_type:
            return
        else:
            had_circle = ACTIONBAR_TYPE.has_circle(self._action_bar_type)
            has_circle = ACTIONBAR_TYPE.has_circle(actbar_type)
            had_classic = ACTIONBAR_TYPE.has_classic(self._action_bar_type)
            has_classic = ACTIONBAR_TYPE.has_classic(actbar_type)
            self._action_bar_type = actbar_type
            if had_circle:
                if not has_circle:
                    self._circle_menu.release()
                    self._circle_menu = None
                    self.worldLayer.delChild('CircleMenu')
            elif has_circle:
                self.circle_menu
            if had_classic:
                if not has_classic:
                    self.actionBar.release()
                    self.actionBar = None
                    self.worldLayer.delChild('actionBar')
            elif has_classic:
                self.action_bar
            self.setActionBarData(self.actionBarDataSection)
            return

