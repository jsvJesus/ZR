    def testInworldMarkers(self):
        from matrix_providers import ShiftProvider

        def updater():
            marks = []
            for i in xrange(30):
                marks.append((u'TestLabel',
                 ShiftProvider(BigWorld.player().matrix, (10 + i * 0.1, 5 + i * 0.1, 10 + i * 0.1)),
                 [soInworldMarker.MARKER_PLAYER],
                 255,
                 u'profession'))

            self.setInworldMarkersData(marks, {}, None, {})
            self.im_test_cb = BigWorld.callback(0.1, updater)
            return

        self.im_test_cb = BigWorld.callback(0.1, updater)

