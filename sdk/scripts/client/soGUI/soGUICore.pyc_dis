    def showPVPScoreBarPlayerList(self, doShow = True):
        if self.pvpScoreBar:
            self.pvpScoreBar.setVisibleScore(doShow)

    def showPVPScoreBar(self, doShow = True):
        if doShow:
            cls = ScoreDM
            gamePlay = BigWorld.player().pvpInstConfig.get('gamePlay')
            if gamePlay in (csconstans.GAMEPLAY_NY_GINGERBREAD_DM,):
                cls = ScoreGingerbread
            elif gamePlay in (csconstans.GAMEPLAY_DM, csconstans.GAMEPLAY_NY_FIGHTS_DM, csconstans.GAMEPLAY_NY_SNOWBALLS_DM):
                cls = ScoreDM
            elif gamePlay == csconstans.GAMEPLAY_NY_GUNGAME_DM:
                cls = ScoreGG
            elif gamePlay in (csconstans.GAMEPLAY_TEAM_DM, csconstans.GAMEPLAY_NY_SNOWBALLS_TEAM_DM):
                cls = ScoreTDM
            elif gamePlay == csconstans.GAMEPLAY_FLAG:
                cls = ScoreFlag
            elif gamePlay == csconstans.GAMEPLAY_BUTTON_MODE:
                cls = ScoreBM
            elif gamePlay == csconstans.GAMEPLAY_NY_PROTECT:
                cls = ScoreNYProtect
            if self.pvpScoreBar and type(self.pvpScoreBar) != cls:
                self.pvpScoreBar.hide()
                self.pvpScoreBar = None
            if not self.pvpScoreBar:
                self.pvpScoreBar = cls(GUI.Window())
                self.pvpScoreBar.onBound()
            self.pvpScoreBar.show()
            if self.store_roomData:
                self.pvpScoreBar.setScoreData(self.store_roomData)
            self.pvpScoreBar.setVisibleScore(False)
        elif not doShow and self.pvpScoreBar:
            self.pvpScoreBar.hide()
        return

    def showInGameEditEindow(self, mode = None):
        if not getattr(self, '_testrotw', None):
            import soGUI.test_rotate_help_gui
