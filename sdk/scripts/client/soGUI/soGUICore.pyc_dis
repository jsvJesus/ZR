    def setupRoot(self):
        cmp = self.component
        cmp.widthMode = cmp.heightMode = 'LEGACY'
        cmp.width = 2.0
        cmp.height = 2.0
        cmp.verticalAnchor = 'CENTER'
        cmp.horizontalAnchor = 'CENTER'
        cmp.position = (0.0, 0.0, 10.0)
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.focus = True
        cmp.crossFocus = True
        cmp.dragFocus = False
        cmp.moveFocus = False
        GUI.addRoot(cmp)

