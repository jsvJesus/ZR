        self.modalLayer = cmp
        layer = soGUILayer(GUI.Window())
        cmp = layer.component
        cmp.position.z = 0.0
        cmp.visible = True
        cmp.mouseButtonFocus = False
        cmp.focus = False
        cmp.crossFocus = False
        cmp.moveFocus = False
        cmp.dragFocus = False
        cmp.dropFocus = False
        GUI.addRoot(cmp)
        self.systemLayer = cmp
        GUI.reSort()
        self.entityPickerLayer = EntityPickerLayer.EntityPickerLayer(GUI.Window(), self.worldLayer)

    def start(self):
        self.setLayerMode(self.LAYER_MODE_MENU)
        self.loginFlash = LoginScreenFlash.create().script
        self._login_win = LoginWin(BWPersonality.GUICore.generalLayer.LoginScreenFlash)
        BWPersonality.GUICore.generalLayer.addChild(self._login_win.component)
        self.messageBoxFlash = MessageBoxFlash.create().script
        self.f1Help = F1_help_gui(GUI.Window())
        self.flashHelpGUI = FlashHelpGUI.create().script
        self.showHealthBar(True)
        self.minimap = Minimap()
        self.worldLayer.addChild(self.minimap.component, 'minimap')
        self.inworldMarkersGUI = soInworldMarkers(GUI.Window())
        self.inworldMarkersGUI.onBound()
        self.flagMarkersGUI = soFlagMarkers(GUI.Window())
        self.flagMarkersGUI.onBound()
        self.effectsFrame = soCharEffectsGUI(GUI.Window())
        self.effectsFrame.onBound()
        self.effectsFrame.show()
        self.targettingGUI = soTargettingGUI(GUI.Window())
        self.targettingGUI.show()
        self.crosshairLookAroundGUI = CrosshairLookAround(GUI.Window())
        self.crosshairLookAroundGUI.onBound()
        self.crosshairLookAroundGUI.hide()
        self.msgBoxMgr = soMsgBoxMgr()
        self.interactHighLightGUI = InteractHighLightGUI(GUI.Window())
        GUI.setDragDistance(0.01)
        self.eula_state = Settings().getSetting(EULA_KEY, False)
        self.bleedGUI = soBleedGUI(GUI.Window())
        self.bleedGUI.onBound()
        self.coldGUI = ColdGUI()
        self.GUIpoison = soGUIpoison(GUI.Window())
        self.GUIpoison.onBound()
        try:

            def isEnglish(s):
                try:
                    s.decode('ascii')
                except UnicodeDecodeError:
                    return False

                return True

            game_path = os.path.realpath('.')
            if not isEnglish(game_path):
                gui_jokes.askUserOk(lc('soGUICore.soGUI.ATTENTION'), lc('soGUICore.soGUI.NON_ENG_GAME_PATH'))
        except:
            traceback.print_exc()

        self.downloadGUI = downloadGUI.DownloadGUI(GUI.Window())
        self.downloadGUI.onBound()
        self.downloadGUI.show('start download ...')
        ucmanager.startDownload(self._uc_callback_step_start, self._uc_callback_end_start)
        self.infoWindowManger.init()
        if BWPersonality.RELEASE and EngineStatistic:
            self.engineStatistic = EngineStatistic(GUI.Window())
            self.engineStatistic.show()
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.01)
        comp.visible = False
        self.global_interceptor = Interceptor(comp, True, True, True)
        self.worldLayer.addChild(comp, 'global_interceptor')
        GUI.reSort()
        self._action_bar_type = ACTIONBAR_TYPE.NONE
        self._set_actionbar_type(BWPersonality.settings.GUISettings.actbar_type)
        self._castbar_type = CASTBAR_TYPE.NONE
        self._set_castbar_type(BWPersonality.settings.GUISettings.castbar_type)

    def _uc_callback_step_start(self, fid, current, allcount):
        self.loginFlash.hide()
        self.downloadGUI.show('download %s.xdds  %s/%s' % (fid, current, allcount))

    def _uc_callback_end_start(self, msg):
        BWPersonality.gpd.sendHightMessage(msg)
        self.downloadGUI.hide()
        if not BigWorld.validatePacks():

            def deleteCallback():
                if os.path.isfile('../packs/user_packs_info'):
                    os.remove('../packs/user_packs_info')
                BigWorld.quit()

            def callback(event):
                if event == gui_jokes.askUserYesNo.OK:
                    print 'BigWorld.quit()-->'
                    deleteCallback()
                else:
                    print 'IGNORE BigWorld.quit()'
                    if BigWorld.isKeyDown(BigWorld.stringToKey('F2')):
                        self.loginFlash.show()
                        self.loginFlash.background.show()
                        return
                    deleteCallback()

            gui_jokes.askUserOk(lc('soGUICore.soGUI.ATTENTION'), lc('soGUICore.soGUI.PACK_CORUPT'), callback)
            print 'quit::  pack not valid'
            self.loginFlash.hide()
            BigWorld.callback(60, deleteCallback)
            return
        self.loginFlash.show()

    def finalize(self):
        print 'GUICore::finalize'
        for root in GUI.roots():
            self.clearAllChildren(root)
            root.script = None
            GUI.delRoot(root)

        self.iconTextures = None
        self.weaponmod = None
        self.clanEmblemsScreen = None
