    def prepareInventoryIcons(self):

        def onIconsLoaded(resourceRefs):
            self.iconTextures = resourceRefs

        listIcons = set([])
        for key, param in ItemsCatalog.items():
            if not param:
                continue
            if param.get('DELETE_ME', 0):
                continue
            if param.get('IconName'):
                listIcons.add(param['IconName'])
            for f, t, icon in param.get('IconByStack', []):
                if icon:
                    listIcons.add(icon)

        try:
            BigWorld.loadResourceListBG(tuple(listIcons), onIconsLoaded)
        except:
            print 'error occured: engine can`t preload 1 recource unit, you must pass at least 2 '

    def add_children_to_generalLayer(self):
        sW, sH = BigWorld.screenSize()
        cmp = GUI.Window('soGUI/white.dds')
        cmp.colour = (0, 0, 0, 127)
        cmp.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.0)
        cmp.tiled = True
        cmp.tileHeight = 1
        cmp.tileWidth = 1
        cmp.moveFocus = True
        cmp.crossFocus = True
        cmp.mouseButtonFocus = True
        self.generalLayer.addChild(cmp, 'GUILocker')
        cmp = GUI.Simple('soGUI/maps/loadingScreen/loadingCircle/loadingCircle.texanim')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.height = 41
        cmp.width = 41
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (sW / 2.0, sH / 2.0, 0.2)
        self.generalLayer.GUILocker.addChild(cmp, 'ldrAnim')
        cmp = GUI.Text('')
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (sW / 2.0, sH / 2.0 + 30, 0.1)
        self.generalLayer.GUILocker.addChild(cmp, 'msg')
        self.generalLayer.GUILocker.visible = False

    def GUILock(self, doLock = True, msg = u'', intercepting_callback = None):
        if doLock:
            self.generalLayer.GUILocker.visible = True
        else:
            self.generalLayer.GUILocker.visible = False
        self.generalLayer.GUILocker.msg.text = msg
        self.GUILockerCallback = intercepting_callback

    def showTimer(self, secs, msg = u'', doShow = True):
        if not hasattr(self.worldLayer, 'genericTimer'):
            sW, sH = BigWorld.screenSize()
            cmp = GUI.Text('')
            cmp.font = 'RobotoCondensedRegular_16.font'
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'CENTER'
            cmp.verticalAnchor = 'TOP'
            cmp.position = (sW / 2.0, 10, 0.5)
            self.worldLayer.addChild(cmp, 'genericTimer')
        self.genericTimerSecs = secs
        if doShow:
            self.worldLayer.genericTimer.visible = True
            if self.timerCheckCoroutine is None:
                self.timerCheckCoroutine = self.genericTimerChecker(msg)
                self.timerCheckCoroutine.run()
            else:
                self.timerCheckCoroutine.stop()
                self.timerCheckCoroutine = self.genericTimerChecker(msg)
                self.timerCheckCoroutine.run()
        else:
            self.worldLayer.genericTimer.visible = False
            if self.timerCheckCoroutine is not None:
                self.timerCheckCoroutine.stop()
                self.timerCheckCoroutine = None
        return

    _change_conn_text_coroutine = None

    def _run_change_conn_text(self):
        if self._change_conn_text_coroutine:
            self._change_conn_text_coroutine.stop()
        self._change_conn_text_coroutine = self.change_conn_text(self)
        self._change_conn_text_coroutine.run()

    @BWCoroutine
    def change_conn_text(self):
        cur_time = BigWorld.time()
        count = 3
        connection_text = lc('soGUICore.soGUI.CONNECTION_TEXT')
        while True:
            yield BWWaitForPeriod(0)
            delta_time = BigWorld.time() - cur_time
            cur_time = BigWorld.time()
            count += delta_time
            if count >= 4:
                count = 0
            if self.connectionWindow:
                self.connectionWindow.setText(u'{0}{1:<3}'.format(connection_text, '.' * int(count)))
            else:
                break

        self._change_conn_text_coroutine = None
        return

    _connectionWindow_callback = None

    def showConnectionWindow(self):
        pass

    def hideConnectionWindow(self):
        print '[soGUICore] hideConnectionWindow'
        if self._connectionWindow_callback:
            BigWorld.cancelCallback(self._connectionWindow_callback)
            self._connectionWindow_callback = None
        if self.connectionWindow:
            self.connectionWindow.hide()
            self.connectionWindow = None
        return

    def hideConfirmWindow(self):
        if self.confirmWindow is not None:
            self.confirmWindow.hide()
        if self.lastLayerMode == self.LAYER_MODE_MENU:
            self.menuLayer.visible = True
        elif self.lastLayerMode == self.LAYER_MODE_INGAME:
            self.menuLayer.visible = False
        return

    def showContextMenu(self, iid, actions, data = None, sort_keys = True):
        self.contextState = True
        if self.toolTipState:
            self.toolTip.hide()
        if self.contextMenu is None:
            self.contextMenu = soContextMenuComponent(GUI.Window(), actions, iid, data=data, sort_keys=sort_keys)
            self.contextMenu.onBound()
        else:
            self.contextMenu.showMenu(actions, iid, data=data, sort_keys=sort_keys)
        self.hideEntityContextMenu()
        return

    def hideContextMenu(self):
        if self.contextMenu:
            self.contextMenu.hide()

    def createEntityContextMenu(self, target_entity):
        self.entityPickerLayer.show_menu(entity=target_entity, position=None)
        return

    def showEntityContextMenu(self, title, actions, on_cancel = None, position = None, target_matrix = None):
        """actions = [dict(label=u"lc text", bind_key=None, callback=foo, foo_active=foo)]
        """
        if self.entityContextMenu is None:
            self.entityContextMenu = EntityContextMenu(GUI.Window())
        self.entityContextMenu.hide()
        self.entityContextMenu.showMenu(title, actions, on_cancel=on_cancel, position=position, target_matrix=target_matrix)
        self.setBestCursor()
        return

