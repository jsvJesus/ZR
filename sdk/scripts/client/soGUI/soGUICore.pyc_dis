    def showIngameSettings(self, doShow = True):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2\xd0\xbd\xd1\x83\xd1\x82\xd1\x80\xd0\xb8\xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8e \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba."""
        if doShow:
            self.loginFlash.open_settings()
            self.showIngameMenu(False)
            self.loginFlash.settingsInGame = True
            self.flashWorldLayer.visible = False
            self.flashWorldLayerChat.visible = False
            self.showLoginFlash(True)
            if self.chatConsole:
                self.chatConsole.hide()
        else:
            self.showLoginFlash(False)
            self.loginFlash.settingsInGame = False
            self.flashWorldLayerChat.visible = True
            self.flashWorldLayer.visible = True
            if self.chatConsole:
                self.chatConsole.show()
        self.updateSoundVolumeIngameMenu()

