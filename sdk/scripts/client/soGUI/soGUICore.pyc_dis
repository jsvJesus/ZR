    def showPVPRooms(self, doShow = True):
        if doShow:
            if self.rooms_win is None:
                self.rooms_win = soGUI.pvp_room_gui.rooms_win.PVPRooms()
                BWPersonality.GUICore.worldLayer.addChild(self.rooms_win.component, 'rooms_win')
                self.rooms_win.onBound()
            if doShow != -1:
                self.rooms_win.show()
        elif self.rooms_win:
            self.rooms_win.hide()
        return

    def hideSubmitOffender(self):
        if self.startSubmitOffender and self.startSubmitOffender.component.visible:
            self.startSubmitOffender.hide()

    def showSubmitOffender(self, name = None, killerClanName = '', donate_mode = False, callback = None):
        if self.startSubmitOffender is None:
            self.startSubmitOffender = soGUI.soStartSubmitOffender.soStartSubmitOffender(GUI.Window())
            BWPersonality.GUICore.worldLayer.addChild(self.startSubmitOffender.component, 'startSumbitOffHanter')
            self.startSubmitOffender.onBound()
        if donate_mode:
            self.startSubmitOffender.show_donate(name, killerClanName, callback)
        else:
            self.startSubmitOffender.show(name, killerClanName, callback)
        return

    def showArtifactQTE(self, doShow = True):
        if self.artifactQTE is None and doShow:
            self.artifactQTE = soArtifactQTE(GUI.Window())
            self.artifactQTE.onBound()
        if doShow:
            self.artifactQTE.show()
        elif self.artifactQTE:
            self.artifactQTE.hide()
        return

    def reloadChatConsole(self):
        if hasattr(self.chatConsole, 'close'):
            self.chatConsole.close()
        import soGUI.flash_utils
        reload(soGUI.flash_utils)
        import soGUI.msg_mgr
        reload(soGUI.msg_mgr)
        reload(soGUI.chatConsole_Flash)
        from soGUI.chatConsole_Flash import ChatConsoleFlash
        self.chatConsole = ChatConsoleFlash.create().script
        self.chatConsole.show()
        self.setMouseAltState(False)

    def putToChat(self, string):
        """\xd0\x9f\xd0\xbe\xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82."""
        self.chatConsole.put_to_chat(string)

    def showChatConsole(self, doShow = True):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c/\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x81 \xd1\x87\xd0\xb0\xd1\x82\xd0\xbe\xd0\xbc."""
        if self.chatConsole is None:
            self.chatConsole = ChatConsoleFlash.create().script
        if doShow:
            self.chatConsole.show()
            self.setBestCursor()
        else:
            self.chatConsole.hide()
        return

    def showMessageBoxesFlash(self, doShow = True):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c/\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x81 \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88\xd0\xb5\xd0\xb2\xd1\x8b\xd0\xbc\xd0\xb8 \xd0\xbc\xd0\xb5\xd1\x81\xd1\x81\xd0\xb5\xd0\xb4\xd0\xb6\xd0\xb0\xd0\xbc\xd0\xb8."""
        if self.messageBoxFlash is None:
            self.messageBoxFlash = MessageBoxFlash.create().script
        if doShow:
            self.messageBoxFlash.show()
            self.setBestCursor()
        else:
            self.messageBoxFlash.hide()
        return

    def showFlashHelp(self, doShow = True, force = False, help_type = 'reload'):
        if self.f1Help is None:
            self.f1Help = F1_help_gui(GUI.Window())
        if doShow:
            if self.f1Help.component.visible:
                return
            if not force and Settings().getSetting('dont_show_{0}_help'.format(help_type), False):
                return
            if force:
                self.f1Help.showMainHelp()
            else:
                self.f1Help.showHelpByType(help_type)
        else:
            self.f1Help.hide()
