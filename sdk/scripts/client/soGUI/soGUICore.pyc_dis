        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb5\xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5 \xd1\x81\xd0\xbc\xd0\xb5\xd1\x80\xd1\x82\xd0\xb8."""
        self.showPCTrade(False)
        self.showItemCache(False)
        self.showPackageSell(False)
        self.showInventory(False)
        self.showCharScreen(False)
        self.showPerksGUI(False)
        self.showClanGUI(False)
        self.showCraftGUI(False)
        self.showPrivateStore(False)
        self.showArtifactQTE(False)
        self.showEventStarter(None, doShow=False)
        self.showSelectMap(False)
        self.show_grade_gui(False)
        self.showItemLootCache(False)
        return

