    def showMessageBox(self, id = 'test', props = soDlgBoxPropsStructure(caption=u'placeholder', btnSet=[soDialogueBox.BTN_OK, soDialogueBox.BTN_CANCEL], additions=[('check', u'labelText1', 'id_check'),
 ('check', u'labelText2', 'id_check2'),
 ('check', u'labelText3', 'id_check3'),
 ('edit',
  True,
  'edit1',
  u'PLACEHOLDER',
  lambda newStr, offset, wholeText: True),
 ('radio',
  u'radio1',
  'id_radio1',
  True),
 ('radio',
  u'radio1',
  'id_radio2',
  True)], msg=u'2233' + lc('soGUICore.soGUI.STRING_3090_464') + u'zzz2' + lc('soGUICore.soGUI.STRING_3090_553')), x = 0.0, y = 0.0, forcePos = False, defaultAction = None):
        btn_set = []
        btn_map = {soDialogueBox.BTN_OK: MESSAGEBOX.BTN_OK,
         soDialogueBox.BTN_CANCEL: MESSAGEBOX.BTN_CANCEL,
         soDialogueBox.BTN_YES: MESSAGEBOX.BTN_YES,
         soDialogueBox.BTN_NO: MESSAGEBOX.BTN_NO,
         soDialogueBox.BTN_UNDO: MESSAGEBOX.BTN_UNDO,
         soDialogueBox.BTN_APPLY: MESSAGEBOX.BTN_APPLY,
         soDialogueBox.BTN_RESET: MESSAGEBOX.BTN_RESET,
         soDialogueBox.BTN_PAYEDRESET: MESSAGEBOX.BTN_PAYEDRESET,
         soDialogueBox.BTN_CONFIRM: MESSAGEBOX.BTN_CONFIRM,
         soDialogueBox.BTN_BUY: MESSAGEBOX.BTN_BUY,
         soDialogueBox.BTN_ACCEPT: soDialogueBox.BTN_ACCEPT,
         soDialogueBox.BTN_DECLINE: soDialogueBox.BTN_DECLINE}
        for btn in props.btnSet:
            btn_entry = {'type': btn_map[btn],
             'width': -1}
            if btn in props.customBtnLabel:
                btn_entry['caption'] = props.customBtnLabel[btn]
            btn_set.append(btn_entry)

        addControls = []
        addControls.append({'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
         'text': props.msg,
         'ID': 'default_txt_field',
         'autosize': True})
        for addControl in props.additions:
            if addControl[0] == 'check':
                active = False
                if len(addControl) > 3:
                    active = addControl[3]
                ctrl_ = {'type': MESSAGEBOX.ADDCONTROL_CHECKBOX,
                 'default': active,
                 'ID': addControl[2],
                 'caption': addControl[1]}
                addControls.append(ctrl_)
            if addControl[0] == 'radio':
                active = False
                if len(addControl) > 3:
                    active = addControl[3]
                ctrl_ = {'type': MESSAGEBOX.ADDCONTROL_RADIO,
                 'default': active,
                 'ID': addControl[2],
                 'caption': addControl[1]}
                addControls.append(ctrl_)
            if addControl[0] == 'edit':
                validator = lambda newStr, wholeText, offset: True
                if len(addControl) > 4:
                    validator = addControl[4]
                default = u''
                if len(addControl) > 3:
                    default = addControl[3]
                ctrl_ = {'type': MESSAGEBOX.ADDCONTROL_EDIT,
                 'default': default,
                 'ID': addControl[2],
                 'input_validator': validator}
                addControls.append(ctrl_)

        if props.font_color is None:
            props.font_color = colorCodes.tf3_gray_text
        msgBox = soMessageBox(GUI.Window(), id=id, isModal=props.modal, x=x, y=y, width=props.width, caption=props.caption, forcePos=forcePos, parent_gui_id=None, bind_to_parent=False, btn_set=btn_set, timeout=0, closeBox=props.closeBox, defaultAction=defaultAction, addControls=addControls, callback=lambda event, data: None, bg_color=props.bg_color, font_color=props.font_color)
        return self.msgBoxMgr.addMsgBox(msgBox)

    def closeMessageBox(self, id):
        self.msgBoxMgr.delMsgBox(id)

    def showMsgBox(self, id, isModal = False, x = 0.0, y = 0.0, width = 350, caption = lc('soGUICore.soGUI.STRING_3153_84'), forcePos = False, parent_gui_id = None, bind_to_parent = False, btn_set = [{'type': MESSAGEBOX.BTN_OK,
  'width': 80,
  'caption': u'ok',
  'enabled': True}, {'type': MESSAGEBOX.BTN_CANCEL,
  'width': 80}], timeout = -1, closeBox = True, defaultAction = MESSAGEBOX.BTN_OK, addControls = [{'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
  'ID': 'main_txt_field',
  'text': lc('soGUICore.soGUI.STRING_3157_93'),
  'hAnchor': MESSAGEBOX.ANCHOR_CENTER}, {'type': MESSAGEBOX.ADDCONTROL_LABEL,
  'ID': 'main_label',
  'hAnchor': MESSAGEBOX.ANCHOR_CENTER,
  'text': u'label_text_here'}], callback = lambda event, data: None, hlink_listener = None, isSystem = False):
        msgBox = soMessageBox(GUI.Window(), id, isModal, x, y, width, caption, forcePos, parent_gui_id, bind_to_parent, btn_set, timeout, closeBox, defaultAction, addControls, callback, isSystem, hlink_listener=hlink_listener)
        self.msgBoxMgr.addMsgBox(msgBox)
        return msgBox

    def closeMsgBox(self, id):
        return self.msgBoxMgr.delMsgBox(id)

