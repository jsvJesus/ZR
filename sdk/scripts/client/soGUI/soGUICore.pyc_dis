    def showWebEmbdeded(self, doShow = True, url = '', close_callback = None, open_external_callback = None):
        if Settings().getSetting('open_external_browser', False):
            print '[INFO] open_external_browser', [url]
            if url:
                import webbrowser
                webbrowser.open(url)
            if open_external_callback is not None:
                open_external_callback()
            return
        else:
            if doShow:
                if not self._web_browser:
                    self._web_browser = WebBrowser()
                self._web_browser.show(url, close_callback, open_external_callback)
                self._web_browser.onBound()
            elif self._web_browser:
                self._web_browser.hide()
            self.setBestCursor()
            return

