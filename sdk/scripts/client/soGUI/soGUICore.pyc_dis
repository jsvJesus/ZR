    def gui_visible(self):
        return bool(self._web_browser and self._web_browser.component.visible or self.packageGUI and self.packageGUI.component.visible or self.privateStoreGUI and self.privateStoreGUI.component.visible or self.ingameMenuGUI and self.ingameMenuGUI.component.visible or self.playerTrade and self.playerTrade.component.visible or self.eventStarter and self.eventStarter.component.visible or self._B2CMoneyInfo and self._B2CMoneyInfo.component.visible or self.charScreen and self.charScreen.component.visible or self.clanEmblemsScreen and self.clanEmblemsScreen.component.visible or self.emblemsScreen and self.emblemsScreen.component.visible or self.clanGUI and self.clanGUI.component.visible or self.clan_card and self.clan_card.component.visible or self.itemCacheGUI and self.itemCacheGUI.component.visible or self.itemLootCacheGUI and self.itemLootCacheGUI.component.visible or self.userFireGUI and self.userFireGUI.component.visible or self.grades_gui and self.grades_gui.component.visible or self.startSaleGUI and self.startSaleGUI.component.visible or self.room_win and self.room_win.component.visible or self.room_find_win and self.room_find_win.component.visible or self.rooms_win and self.rooms_win.component.visible or self.startSubmitOffender and self.startSubmitOffender.component.visible or self.craftGUI and self.craftGUI.component.visible or self.soBulletinBoard and self.soBulletinBoard.component.visible or self.soBaseTrader and self.soBaseTrader.component.visible or self.chatConsole and self.chatConsole.visible and self.chatConsole.is_fully_visible or self.msgBoxMgr and self.msgBoxMgr.has_cursor_windows() or self.inventoryGUI and self.inventoryGUI.component.visible or self.weaponmod and self.weaponmod.component.visible or self.friend_list.visible or self.is_clanmanager_win_visible() or self.selectMap and self.selectMap.script.visible or self.shoiceTeamWindow and self.shoiceTeamWindow.isVisible() or self.pvpScoreBar and self.pvpScoreBar.scoreBarVisible() or self.translateWindow and self.translateWindow.component.visible or self.infoWindowManger.isVisible() or self.QuitMenu and self.QuitMenu.component.visible or self.baseToCaptureGUI and self.baseToCaptureGUI.is_flags_buying or self.loginFlash and self.loginFlash.settingsInGame or self.messageBoxFlash and self.messageBoxFlash.visible or self.f1Help and self.f1Help.component.visible or self.flashHelpGUI and self.flashHelpGUI.window_visible or self.soQuestRewardManager and self.soQuestRewardManager.is_visible() or self.inspectScreen and self.inspectScreen.component.visible or self.equipScreenDebug and self.equipScreenDebug.component.visible or self._tradepaint_screen and self._tradepaint_screen.visible or self._world_map and self._world_map.visible or self._dialog_screen and self._dialog_screen.visible or self._anycraft_window_visible() or self._perks_window and self._perks_window.visible or self._warehouse_screen and self._warehouse_screen.visible or self._donate_auction_screen and self._donate_auction_screen.visible or self._storehouse_screen and self._storehouse_screen.visible or self._overlay_message and self._overlay_message.visible or self.entityContextMenu and self.entityContextMenu.isVisible or self._clan_reward_win and self._clan_reward_win.visible or self.journal_win_visible() or self.heliwin_visible() or self.is_promo_gui_visible() or self.clanswin_visible() or self.wimpwin_visible() or self.gunpoint_win_visible() or self.fractwin_visible() or self.barterwin_visible() or self.npc_reload_ui_visible() or self.revive_win_visible() or self.is_equip_paint_screen_visible())

    def setBestCursor(self):
        gv = self.gui_visible()
        if not self.menuLayer.visible:
            if not not isinstance(BigWorld.player(), Avatar.PlayerAvatar):
                if not gv:
                    mouse_cursor = self.mouseAltMode
                    if self.is_circlemenu_visible():
                        mouse_cursor = self._circle_menu.need_mouse_cursor()
                    if gv or self.is_circlemenu_visible() and self.mouseAltMode:
                        self.mouseAltMode = False
                    BWPersonality.game.set_cursor_mouse(mouse_cursor)
                    if not mouse_cursor:
                        if self.contextMenu is not None:
                            self.contextMenu.hide()
                            self.contextState = False
                        self.actionBar is not None and self.actionBar.component.script.resetDragProxy()
                self.pvpScoreBar and self.pvpScoreBar.onSetBestCursor(mouse_cursor)
            self.actionBar and self.actionBar.onSetBestCursor(mouse_cursor)
        return

    def showComponentInContextLayer(self, component):
        if self.contextLayer is not None:
            self.contextLayer.visible = False
            GUI.delRoot(self.contextLayer)
        component.visible = True
        self.contextLayer = component
        GUI.addRoot(component)
        GUI.reSort()
        return

    @property
    def isBinocularMode(self):
        return self._is_binocular_mode

    _is_binocular_mode = False

    def onChangeBinoculars(self, binocular_mode = False):
        self._is_binocular_mode = binocular_mode
        if self._is_binocular_mode:
            self.hideGui(hide_tutorial=False)
        else:
            self.showGui()

    def onChangePlayerCreditNumber(self, CreditNumber):
        if self.clanEmblemsScreen:
            self.clanEmblemsScreen.frame_change_image.updatePlayerMoney(CreditNumber)
        if self.emblemsScreen:
            self.emblemsScreen.frame_change_image.updatePlayerMoney(CreditNumber)

    def showLoadingScreen(self, doShow, radius = 500):
        loadingGUI = BWPersonality.gpd.loadingGUI
        if doShow:
            BigWorld.worldDrawEnabled(False)
        else:
            BigWorld.worldDrawEnabled(True)

        def loadComplete(complete):
            BigWorld.worldDrawEnabled(res)
            loadingGUI.visible = False

        if doShow:
            loadingGUI.visible = True
        else:
            loadingGUI.visible = False
        loadingGUI.focus = doShow
        loadingGUI.moveFocus = doShow
        loadingGUI.mouseButtonFocus = doShow
        if doShow:
            loadingGUI.script.start(radius, loadComplete)
        else:
            loadingGUI.script.cancel()

    def showItemCache(self, doShow = True, cache_mode = None):
        import ItemsUtils
        if cache_mode is not None and cache_mode != ItemsUtils.CACHE_MODE_SAFEBOX:
            self.showItemLootCache(doShow, cache_mode)
            return
        else:
            if doShow:
                self._create_cache_gui()
                self.itemCacheGUI.show(cache_mode)
                self.itemLootCacheGUI.visible = False
            elif self.itemCacheGUI:
                self.itemCacheGUI.hide()
            return

    def showItemLootCache(self, doShow = True, cache_mode = None):
        if doShow:
            self._create_cache_gui()
            self.itemLootCacheGUI.show(cache_mode)
            self.itemCacheGUI.visible = False
        elif self.itemLootCacheGUI:
            self.itemLootCacheGUI.hide()

    def showUserFire(self, doShow = True, objId = None):
        if self.userFireGUI is None and doShow:
            self.userFireGUI = UserFireScreen(GUI.Window())
            self.userFireGUI.onBound()
        if doShow:
            self.userFireGUI.show(objId)
        elif self.userFireGUI:
            self.userFireGUI.hide()
        if self.inventoryGUI:
            if doShow or self.inventoryGUI.component.visible:
                self.inventoryGUI.update()
        return

    def isUserFireVisible(self):
        return self.userFireGUI and self.userFireGUI.component.visible

    def updateUserFire(self):
        if self.userFireGUI:
            self.userFireGUI.updateUserFireWindow()

    def checkUserFireOferflow(self):
        if self.userFireGUI:
            self.userFireGUI.checkOferflow()

    def showUserFireErrorCode(self, code):
        if self.userFireGUI:
            self.userFireGUI.showUserFireErrorCode(code)

    def show_grade_gui(self, doShow = True, workbench = None, npc = None):
        if doShow:
            if self.grades_gui is None:
                self.grades_gui = Grade_window(GUI.Window())
            self.grades_gui.show(workbench, npc)
            if workbench.camera:
                BigWorld.player().go_to_dialog_camera(workbench.camera, True)
        elif self.grades_gui:
            self.grades_gui.hide()
        self.showInventory(doShow)
        self.setBestCursor()
        return

    def showStartSale(self, doShow = True, data = None):
        if self.startSaleGUI is None and doShow:
            self.startSaleGUI = SaleWin()
            BWPersonality.GUICore.worldLayer.addChild(self.startSaleGUI.component, 'startSale')
        if doShow:
            self.startSaleGUI.show(data)
        elif self.startSaleGUI:
            self.startSaleGUI.hide()
        return

    def showCreateRoom(self, doShow = True):
        if doShow:
            if self.room_win is None:
                self.room_win = soGUI.pvp_room_gui.room_win.PVPRoomWin()
                BWPersonality.GUICore.worldLayer.addChild(self.room_win.component, 'room_win')
                self.room_win.onBound()
            self.room_win.show()
        elif self.room_win:
            self.room_win.hide()
