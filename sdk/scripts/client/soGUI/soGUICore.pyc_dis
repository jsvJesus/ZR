    @ignoreError
    def onDisconnected(self):
        if self._paint_screen:
            self._paint_screen.hide()
        if self._menu_paint_screen:
            self._menu_paint_screen.hide()
        if self._storehouse_screen:
            self._storehouse_screen.hide()
        if self.is_promo_gui_visible():
            self.promo_gui.hide()
        if self._tradepaint_screen:
            self._tradepaint_screen.hide()

    @ignoreError
    def onLeaveWorld(self):
        self._in_world = False
        self._closeAllWindow()
        self.setBoardPVPInfo({})
        if self.chatConsole is not None:
            self.chatConsole.clear()
        if self.baseToCaptureGUI is not None:
            self.baseToCaptureGUI.close()
            self.baseToCaptureGUI = None
        if self._transport_window:
            self._transport_window.hide()
            self._transport_window = None
        if self.coldGUI:
            self.coldGUI.hide()
        if self.heliinterface_visible():
            self.heli_interface.hide()
        if self._journal_win:
            self._journal_win.stop_background_tasks()
        if self._weapon_win:
            self.weapon_win.hide()
        if self._weight_win:
            self.weight_win.hide()
        if self._gasfilter_win:
            self._gasfilter_win.hide()
        if self._auraperks:
            self._auraperks.clear()
        if self.minimap:
            self.minimap.on_leave_world()
        return

    @ignoreError
    def onEnterWorldPlayerAvatar(self):
        if self._journal_win:
            self._journal_win.on_change_owner()
        self._closeAllWindow()
        self.infoWindowManger.closeAll()
        if self.healthBarGUI:
            self.healthBarGUI.reset()
        if hasattr(self, 'owe_info'):
            p = BigWorld.player()
            if self.owe_info['metadata'] != (p.id,):
                print '  ZIM: wrong meta', self.owe_info['metadata'], (p.id, p.spaceID)
                del self.owe_info
            else:
                self.scholar_controller.set_owe_info(self.owe_info)
        if BWPersonality.settings.getSetting('fps_visible'):
            self.fps_win.show()
        if BWPersonality.settings.getSetting('weightwin_visible'):
            self.weight_win.show()
        if BWPersonality.settings.getSetting('compas_visible'):
            self.compass.show()
        self.weapon_win.show()
        self._in_world = True

    def resetGUIPos(self):
        GUIPositions.reset_positions()
        self.party_gui.reset_position()

    def _closeAllWindow(self):
        needhide = [self.showCraftGUI,
         self.showFlashHelp,
         self.showBulletinBoard,
         self.showPrivateStore,
         self.showPackageSell,
         self.showItemCache,
         self.showCharScreen,
         self.showClanEmblemsScreen,
         self.showEmblemsScreen,
         self.showPCTrade,
         self.showClanGUI,
         self.showUserFire,
         self.showStartSale,
         self.showArtifactQTE,
         self.showPerksGUI,
         self.showInventory,
         self.showChatConsole,
         self.showEventGUI,
         self.showEventTimerGUI,
         self.showTransformationHelp,
         self.showWeaponMod,
         self.showGiftListWindow,
         self.show_grade_gui,
         self.showCreateRoom,
         self.showFindRoom,
         self.showPVPRooms,
         self.showDungeonGUI]
        for index, method in enumerate(needhide):
            try:
                method(False)
            except:
                traceback.print_exc()

        if self._paint_screen:
            self._paint_screen.hide()
        if self._menu_paint_screen:
            self._menu_paint_screen.hide()
        if self._storehouse_screen:
            self._storehouse_screen.hide()
        if self.is_promo_gui_visible():
            self._promo_gui.hide()
        if self._tradepaint_screen:
            self._tradepaint_screen.hide()
        if self._world_map:
            self._world_map.hide()
        if self._dialog_screen:
            self._dialog_screen.hide()
        if self._craft_window_visible():
            self._craft_window.hide()
        if self._amcraft_window_visible():
            self._amcraft_window.hide()
        if self.journal_win_visible():
            self._journal_win.hide()
        if self.is_gifts_win_visible():
            self._gifts_win.hide()
        if self.heliwin_visible():
            self._heliwin.hide()
        if self.filefinder_visible():
            self._file_finder.hide()
        if self.compass_visible():
            self._compass.hide()
        if self.scholar_controller_visible():
            self.scholar_controller.hide()
        if self.barterwin_visible():
            self._barterwin.hide()
        if self.pdawin_visible():
            self._pdawin.hide()
        if self.gunpoint_win_visible():
            self._gunpoint_win.hide()
        if self.gunwin_visible():
            self._gunwin.hide()
        if self.cutscene_visible():
            self._cutscene.hide()
        if self.cutscenelist_visible():
            self._cutscene_list.hide()
        if self._perks_window:
            self._perks_window.hide()
        if self.clanswin_visible():
            self._clans_win.hide()
        if self.fractwin_visible():
            self._fract_win.hide()
        if self.wimpwin_visible():
            self._wimp_win.hide()
        if self._warehouse_screen:
            self._warehouse_screen.hide()
        if self._donate_auction_screen:
            self._donate_auction_screen.hide()
        if self.eventStarter:
            self.eventStarter.hide()
        if self.clan_card:
            self.clan_card.hide()
        if self.emotionsGUI:
            self.emotionsGUI.hide()
        if self.is_clanmanager_win_visible():
            self._clan_manager_win.hide()
        if self.is_circlemenu_visible():
            self._circle_menu.hide()
        if self._clan_reward_win and self._clan_reward_win.visible:
            self._clan_reward_win.hide()
        if self.npc_reload_ui_visible():
            self._npc_reload_win.hide()
        if self.revive_win_visible():
            self._revive_win.hide()
        self.setBestCursor()
        if hasattr(self, 'global_interceptor'):
            self.global_interceptor.set_proxy(None)
            self.global_interceptor.component.visible = False
        return

    __hide_by_transf = []

    def updateTransformationGUI(self):
        for gui_name in self.__hide_by_transf:
            gui = getattr(self.worldLayer, gui_name, None)
            if gui:
                if gui.script and hasattr(gui.script, 'on_ft_show'):
                    gui.script.on_ft_show()
                else:
                    gui.visible = True

        self.__hide_by_transf = []
        player = BigWorld.player()
        if player and getattr(player, 'active_transform', None):
            hide_gui = player.active_transform.getparam('hide_gui')
            if hide_gui:
                for gui_name in hide_gui:
                    gui_name = str(gui_name)
                    gui = getattr(self.worldLayer, gui_name, None)
                    if gui and gui.visible:
                        if gui.script and hasattr(gui.script, 'on_ft_hide'):
                            gui.script.on_ft_hide()
                        else:
                            gui.visible = False
                        self.__hide_by_transf.append(gui_name)
                    elif getattr(self, gui_name, None):
                        gui_script = getattr(self, gui_name)
                        if gui_script and hasattr(gui_script, 'on_ft_hide'):
                            gui_script.on_ft_hide()
                        elif getattr(gui_script, 'component', None):
                            gui_script.component.visible = False

        return

    def drawSound(self, key, volume, tagert_volume = None):
        if not rainConstant.DEBUG_SHOW and not self._sound_volume_bar:
            return
        elif not rainConstant.DEBUG_SHOW and self._sound_volume_bar:
            self._sound_volume_bar.hide()
            self._sound_volume_bar = None
            return
        else:
            if rainConstant.DEBUG_SHOW and not self._sound_volume_bar:
                self._sound_volume_bar = SoundVolume(GUI.Window())
                self._sound_volume_bar.onBound()
                self._sound_volume_bar.show()
            self._sound_volume_bar.update(key, volume, tagert_volume)
            return

    def showMassQuestResults(self, *args):
        """ \xd0\xbe\xd1\x82\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb7\xd0\xb8\xd1\x82\xd1\x8c \xd1\x80\xd0\xb5\xd0\xb7\xd1\x83\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb0\xd1\x82\xd1\x8b \xd0\xbc\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 """
        if not self.soMassquestScreen:
            self.soMassquestScreen = soMassquest(GUI.Window())
        self.soMassquestScreen.show(*args)

    def show_quest_reward_window(self, quest_id):
        if not self.soQuestRewardManager:
            self.soQuestRewardManager = soQuestRewardManager()
        self.soQuestRewardManager.show_quest_reward(quest_id)

    def show_bb_reward_window(self, items, exp, quest_id):
        if not self.soQuestRewardManager:
            self.soQuestRewardManager = soQuestRewardManager()
        self.soQuestRewardManager.show_bb_reward(items, exp, quest_id)

    def play_mainmenu_sound(self):
        self._menu_sound = sounds.getSound(self.MAINMENU_SOUND)
        self._menu_sound.play()

    def stop_mainmenu_sound(self):
        if self._menu_sound:
            self._menu_sound.stop()
        self._menu_sound = None
        return

    def updateSoundVolumeIngameMenu(self):
        volume = 1.0
        if self.storehouse_screen_visible and isinstance(BigWorld.player(), Avatar.PlayerAvatar):
            volume = 0.5
        elif self.ingameMenuGUI and self.ingameMenuGUI.component.visible:
            volume = 0.5
        elif self.loginFlash.settingsInGame:
            volume = 0.5
        elif self.QuitMenu and self.QuitMenu.component.visible:
            volume = 0.5
        AudioMixer.blend_volume_to(volume, 'VOLUME_INGAME_MENU', blend_time=0.5)

    @property
    def connection_problem(self):
        if not self._connection_problem:
            self._connection_problem = connection_problem_window.ConnectionProblemWindow(GUI.Window())
            self._connection_problem.onBound()
        return self._connection_problem

    @property
    def overlay_message(self):
        if not self._overlay_message:
            comp = GUI.Window('soGUI/frame/paint/black.dds')
            comp.colour = (255, 255, 255, 150)
            comp.materialFX = 'BLEND'
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
            comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
            comp.width, comp.height = (2, 2)
            comp.position = (0, 0, 0.01)
            self.generalLayer.addChild(comp, 'overlay_message')
            self._overlay_message = MessageWin(comp, MessageWin.OVERLAY)
            self._overlay_message.do_reposition()
        return self._overlay_message

    @property
    def storehouse_screen_visible(self):
        return self._storehouse_screen and self._storehouse_screen.visible

    def is_itemspendwin_visible(self):
        return self._itemspend_win and self._itemspend_win.visible

    def is_promo_gui_visible(self):
        return self._promo_gui and self._promo_gui.visible

    @property
    def itemspend_win(self):
        if not self._itemspend_win:
            self._itemspend_win = ItemsPendWin()
        return self._itemspend_win

    def on_item_payed(self, data):
        ItemsPendWin.add_data(data)

    @property
    def promo_gui(self):
        if not self._promo_gui:
            self._promo_gui = PromoGui()
        return self._promo_gui

    @property
    def storehouse_screen(self):
        if not self._storehouse_screen:
            self._storehouse_screen = ShopController()
        return self._storehouse_screen

    def updateStorehouseMoney(self):
        if self.storehouse_screen_visible:
            self._storehouse_screen.update_money()

    def updateDonateShopCatalog(self, items, version, currency = None):
        if self.storehouse_screen_visible:
            self._storehouse_screen.set_shop_items(items, version, currency)

    def updateStoreHouse(self, items):
        if self.storehouse_screen_visible:
            self._storehouse_screen.set_store_items(items.values())
        meta_inventory = self.get_metainventory()
        if meta_inventory:
            meta_inventory.set_store_items(items.values())

    def updateStoreHouseItemCount(self, count):
        self.loginFlash.account_actions.set_storage_notification_count(count)
        if self.storehouse_screen_visible:
            self._storehouse_screen.set_store_item_count(count)

    def notifyStoreHouse(self, code):
        if not self._storehouse_screen:
            return
        self._storehouse_screen.got_donate_notification(code)

    def onShowStoragehouse(self):
        self.loginFlash.account_actions.shop_opened()

    def on_play_game_click(self):
        if self._menu_paint_screen:
            self._menu_paint_screen.clear_cache()

    def on_disconnect(self):
        ItemsPendWin.on_disconnect()

    def getItemInventoryDraggedOutScreen(self):
        """ \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x82\xd0\xb0\xd1\x81\xd0\xba\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbb\xd0\xb8 \xd0\xb8\xd1\x82\xd0\xb5\xd0\xbc \xd0\xb8\xd0\xb7 \xd0\xb8\xd0\xbd\xd0\xb2\xd0\xb5\xd0\xbd\xd1\x82\xd0\xbe\xd1\x80\xd1\x8f \xd0\xb8 \xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xbe\xd1\x80 \xd0\xb2\xd0\xbd\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0
        """
        if not self.inventoryGUI:
            return
        if not self.is_inventory_visible():
            return
        return self.inventoryGUI.draggedItemUnderScreen

    def getItemQuickSlotDraggedOutScreen(self):
        """ \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x82\xd0\xb0\xd1\x81\xd0\xba\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbb\xd0\xb8 \xd0\xb8\xd1\x82\xd0\xb5\xd0\xbc \xd0\xb8\xd0\xb7 \xd0\xb1\xd1\x8b\xd1\x81\xd1\x82\xd1\x80\xd1\x8b\xd1\x85 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xb8 \xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xbe\xd1\x80 \xd0\xb2\xd0\xbd\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0
        """
        if not self.actionBar:
            return
        if not self.actionBar.component.visible:
            return
        return self.actionBar.draggedItemUnderScreen

    def show_object_info(self, name_id):
        from msgbox_templates import text_and_ok_compact
        title = lc('soObjectInfo.names.{0}'.format(name_id))
        text = lc('soObjectInfo.descriptions.{0}'.format(name_id))
        text_and_ok_compact('show_object_info', title, colorCodes.inactive_xml + text)
        BWPersonality.game.set_cursor_mouse(True)

    def showTransformationHelp(self, doShow, text = u''):
        if doShow and not self.transformation_help_gui:
            self.transformation_help_gui = TransformationHelp(GUI.Window())
            self.transformation_help_gui.onBound()
        if doShow:
            self.transformation_help_gui.show(text)
        if not doShow and self.transformation_help_gui:
            self.transformation_help_gui.hide()

    def on_just_got_achivment(self, ach_id):
        from achivments import achives_parser
        from Constants import MESSAGE_TYPES as MT
        AV = achives_parser.AchVis
        achivment = achives_parser.get_achiv(ach_id)
        ach_vis = achivment.get('alwaysvisible', AV.Common)
        if ach_vis == AV.Locked:
            return
        if not achivment:
            print 'soGUICore (ERROR): got deleted achivment', ach_id
            return
        ach_local = achivment['name']
        ach_name = lc(ach_local, utf8=True)
        msg = lc('AchivGui.notify.gotach').format(ach_name)
        BWPersonality.gpd.sendHightMessage(msg, MT.SPECIAL)
        sounds.playSound('ui/new_achievement')