    def update_window_size(self):
        self.component.heightMode = 'PIXEL'
        self.component.widthMode = 'PIXEL'
        self.component.width = self.component.height * 1024 / 820
        self.component.picture.width = self.component.width - 8
        self.component.picture.height = self.component.picture.width / (16 / 9.0)
        w, h = self.component.title_step.stringDimensions(self.component.title_step.text)
        self.component.title_step_background.height = h + 4
        self.component.title_step_background.width = w + 4
        self.component.title_step_background.position.y = self.component.picture.position.y + self.component.picture.height - self.component.title_step_background.height - 2
        self.component.title_step_background.position.x = self.component.picture.position.x + 2
        self.component.title_step.position.y = self.component.title_step_background.position.y + 2
        self.component.title_step.position.x = self.component.title_step_background.position.x + 2
        self.component.btn_back.heightMode = 'PIXEL'
        self.component.btn_next.heightMode = 'PIXEL'
        self.component.btn_play.heightMode = 'PIXEL'
        self.component.btn_back.width = 52 / 34.0 * self.component.btn_back.height
        self.component.btn_next.width = 52 / 34.0 * self.component.btn_next.height * -1
        self.component.btn_play.width = self.component.btn_play.height
        self.component.btn_play.script.setBoxSize(self.component.btn_play.height, self.component.btn_play.height)
        self.component.btn_back.heightMode = 'CLIP'
        self.component.btn_next.heightMode = 'CLIP'
        self.component.btn_play.heightMode = 'CLIP'
        self.component.btn_back.verticalPositionMode = 'PIXEL'
        self.component.description.position.y = self.component.picture.position.y + self.component.picture.height + 8
        self.component.description.width = self.component.width - 40
        self.component.description.height = self.component.btn_back.position.y - self.component.picture.position.y - (self.component.width - 8) / (16 / 9.0) - 10
        w = self.component.width - 40
        h = self.component.btn_back.position.y - self.component.picture.position.y - (self.component.width - 8) / (16 / 9.0) - 10
        self.component.description.script.setSize(w, h)
        self.component.closeBox.position.x = self.component.width - 16
        for index, btn in enumerate(self.help_buttons):
            btn.position.y = self.component.height - (index + 1) * 25 - 20

        self.component.btn_back.verticalPositionMode = 'CLIP'
        self.component.widthMode = 'CLIP'
        self.component.heightMode = 'CLIP'

    def onShow(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.visible = True
        self.component.focus = True
        self.component.crossFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.component.dragFocus = True
        self.component.dropFocus = True
        self.update_window_size()
        return

    def hide(self):
        self.component.visible = False
        self.component.focus = False
        self.component.crossFocus = False
        self.component.moveFocus = False
        self.component.mouseButtonFocus = False
        self.component.dragFocus = False
        self.component.dropFocus = False
        self.played = False
        self.next_timer()
        BWPersonality.GUICore.setBestCursor()

    def change_visible(self, value):
        self.component.main_help.visible = not value
        for btn in self.help_buttons:
            btn.visible = not value

        self.component.description.visible = value
        self.component.picture.visible = value
        self.component.title_step.visible = value
        self.component.title_step_background.visible = value
        self.component.btn_back.visible = value
        self.component.btn_next.visible = value
        self.component.btn_play.visible = value

    def showHelpByType(self, help_type):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xbd\xd1\x84\xd1\x83 \xd0\xbe \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7\xd0\xb0\xd1\x80\xd1\x8f\xd0\xb4\xd0\xba\xd0\xb5"""
        from Localization import lc, Localization
        self.onShow()
        self.index = 0
        self.current_help_type = help_type
        self.change_visible(True)
        cur_help = self.help_data[help_type]
        action_key = BWPersonality.get_action_key('ShowHelp')
        self.component.title.text = lc(cur_help['title']).format(action_key)
        lang = Localization.globalLanguage
        key = lang if cur_help['picture'].has_key(lang) else 'default'
        self.load_picture(cur_help['picture'][key])
        self.on_step_changed()
        self.play_pause()
        Settings().setSetting('dont_show_{0}_help'.format(self.current_help_type), True)

    def load_picture(self, path):
        import BigWorld
        BigWorld.loadResourceListBG([path], self.on_load_picture)

    def play_pause(self):
        self.played = not self.played
        self.next_timer()

    def next_timer(self):
        if self.call_back_id:
            BigWorld.cancelCallback(self.call_back_id)
            self.call_back_id = None
        if self.played:
            self.call_back_id = BigWorld.callback(20.0, self.next_step)
            self.component.btn_play.script.setActive()
        else:
            self.component.btn_play.script.setInactive()
        return

    def next_step(self):
        self.index += 1
        self.on_step_changed()

    def prev_step(self):
        self.index -= 1
        self.on_step_changed()

    def on_step_changed(self):
        data = self.help_data[self.current_help_type]['data']
        self.component.btn_back.script.setDisabledState(False)
        self.component.btn_next.script.setDisabledState(False)
        if self.index <= 0:
            self.component.btn_back.script.setDisabledState(True)
        elif self.index >= len(data) - 1:
            self.component.btn_next.script.setDisabledState(True)
        if 0 <= self.index <= len(data) - 1:
            self.component.description.script.setText(lc(data[self.index]['descriprion']))
            self.component.title_step.text = lc(data[self.index]['title'])
        self.update_window_size()
        self.next_timer()

    def on_load_picture(self, picts):
        self.component.picture.texture = picts.values()[0]
        self.update_window_size()

    def on_additional_show_click(self, help_type):
        self.showHelpByType(help_type)

    def showMainHelp(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd0\xb1\xd1\x89\xd0\xb8\xd0\xb9 \xd0\xa5\xd0\xb5\xd0\xbb\xd0\xbf"""
        self.onShow()
        self.index = 0
        self.change_visible(False)
        action_key = BWPersonality.get_action_key('ShowHelp')
        self.component.title.text = lc('FlashAmmoHelp.MAIN_TITLE').format(action_key)
        return None

    def load_data(self):
        py_data_section = ResMgr.openSection(CONFIG_PATH)
        self.help_data = json.loads(py_data_section.asBinary)
        self.create_buttons()

    def doReposition(self):
        for scaller in self.text_scallers.values():
            scaller.do_reposition()

        self.update_window_size()

    def create_buttons(self):
        for index, help_type in enumerate(self.help_data.keys()):
            btn = soButton(GUI.Window(), default_label_horizontal_anchor='LEFT', default_PositionMode='PIXEL')
            btn.initVSC('soGUI/visual_styles/btn_white_empty.xml')
            cmp = btn.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.width = 500
            cmp.height = 37
            cmp.label.text = lc('FlashAmmoHelp.ADDITIONAL_INFO_BTN_' + help_type)
            cmp.position = (28, 0, 0.2)
            cmp.visible = False
            self.component.addChild(cmp, 'btn_{0}'.format(help_type))
            self.help_buttons.append(cmp)
            btn.onBound()
            btn.setVisualState('normal')
            btn.onClick = partial(self.on_additional_show_click, help_type)