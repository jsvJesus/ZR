    def _get_item_data(self):
        return self.itemData and self.itemData['item']

    @BWMemberCoroutine
    def _run_drop_animate_coroutine(self):
        comp = self.component.itemIcon
        comp.width, comp.height = self.SLOTWIDTH, self.SLOTWIDTH
        duration = 0.2
        min_size = 0.7
        start_time = BigWorld.time()
        stop_time = start_time + duration
        while BigWorld.time() <= stop_time:
            ratio = (BigWorld.time() - start_time) / duration
            factor = 1 - sin(ratio * pi)
            factor = linear_map(factor, 0, 1, min_size, 1)
            size = self.SLOTWIDTH * factor
            comp.width, comp.height = size, size
            yield BWWaitForPeriod(0)

        comp.width, comp.height = self.SLOTWIDTH, self.SLOTWIDTH
        self._drop_animate_coroutine = None
        return

    def _applyItemData(self):
        self._update_droplet()
        self.component.haveAttachedParts.visible = False
        if self.haveItem():
            item_icon = self.itemData['icon']
            item_count = self.itemData['low_right_number']
            item_key = self.itemData['abovetext']
            left_text = self.itemData['left_text']
            real_item = self.itemData.get('have_item')
            if real_item:
                self.component.itemIcon.colour = (255, 255, 255, 255)
                self.component.marker_on.visible = BigWorld.player().it_is_active_gadget(self.itemData['item_id'])
            else:
                self.component.itemIcon.colour = (255, 255, 255, 120)
            if BWPersonality.GUICore.iconTextures is not None:
                if item_icon not in BWPersonality.GUICore.iconTextures.failedIDs:
                    if BWPersonality.GUICore.iconTextures.has_key(item_icon):
                        self.component.itemIcon.texture = BWPersonality.GUICore.iconTextures[item_icon]
                    else:
                        self.component.itemIcon.textureName = item_icon
            else:
                self.component.itemIcon.textureName = item_icon
            self.component.itemCount.text = item_count
            self.component.itemKey.text = item_key
            if left_text:
                self.component.haveAttachedParts.visible = True
                self.component.haveAttachedParts.text = left_text
            time, slot, from_slot = soActionBar._just_drop_item_slot
            if self == slot and BigWorld.time() == time:
                if self._drop_animate_coroutine:
                    self._drop_animate_coroutine.stop()
                self._drop_animate_coroutine = self._run_drop_animate_coroutine()
                self._drop_animate_coroutine.run()
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemCount.text = u''
            self.component.itemKey.text = u''
            self.component.marker_on.visible = False
            self.lockSlot(False)
        self.dragProxy.texture = self.component.itemIcon.texture
        return

    def clearMarkAsAttachable(self):
        self.component.mark_attachable.visible = False

    def checkMarkAsAttachable(self, attachingItem):
        if not self.itemData['item']:
            return
        entity = BigWorld.player()
        if ItemsUtils.CheckPossibleAttach(entity, self.itemData['item'], attachingItem):
            self.component.mark_attachable.visible = True

    def remove(self):
        BWPersonality.GUICore.actionBarEvent(soActionBar.EVENT_REMOVE, self.slotIndex)

    def isEmptyItem(self):
        if self.itemData['icon'] == u'':
            return True
        else:
            return False

    def handleDragStartEvent(self, cmp):
        if self.isEmptyItem():
            return False
        handled = soItemSlot.handleDragStartEvent(self, cmp)
        return bool(handled)

    def onDragStart(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        return True

    def lockSlot(self, doLock):
        soItemSlot.lockSlot(self, doLock)
        if self.locked:
            self.component.itemIcon.colour = (125, 125, 125, 255)
        else:
            self.component.itemIcon.colour = (255, 255, 255, 255)

    def handleMouseLeaveEvent(self, cmp):
        handled = soItemSlot.handleMouseLeaveEvent(self, cmp)
        self.component.frameCmp.textureName = ''
        self.component.frameCmp.texture = None
        self.clearMarkAsAttachable()
        return bool(handled)

    def handleMouseEnterEvent(self, cmp):
        handled = soItemSlot.handleMouseEnterEvent(self, cmp)
        self.component.frameCmp.texture = self.SLOTFRAME_TEXTURE_HOVER
        return bool(handled)


class soActionBar(PyGUIBase):
    factoryString = 'soGUI.soActionBar'
    _just_drop_item_slot = [None, 0, 0]
    EVENT_REMOVE = 0
    EVENT_USE = 1
    EVENT_CONTEXT = 2
    EVENT_MOVE = 3
    EVENT_BARSCROLL = 4
    EVENT_DRAG_START = 5
    EVENT_DRAG_STOP = 6

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.interfaceID = BWPersonality.GUICore.GUI_ID_ACTIONBAR
        self.drag_data = None
        self.setupRoot()
        self.setupContent()
        self.doReposition()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.materialFX = 'BLEND'
        cmp.width = 0
        cmp.height = 79

    def setupContent(self):
        itemView = soItemView(GUI.Window(), soActionSlot, slot_eventsHandler=self.slotHandler, eventsHandler=self.itemViewHandler, rowWidth=10, cols=9, rows=1, hScroll=False, vScroll=False, borderWidth=0, hInterval=1)
        cmp = itemView.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (20, 0, 0.5)
        cmp.colour = (255, 255, 255, 126)
        cmp.materialFX = 'BLEND'
        cmp.textureName = 'soGUI/frame/quick_access/shelf.dds'
        self.component.addChild(cmp, 'itemView')
        itemView.onBound()
        itemView.setRestrictingComponent(None)
        itemView.setItems(None)
        self.component.width = cmp.width + 20
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/elements/arrow_up.xml')
        btn.setVisualState('normal')
        btn.soundControlName = 'ArrowBtn'
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (0, 15, 0.2)
        cmp.visible = False
        self.component.addChild(cmp, 'btnUP')
        btn.onBound()
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/elements/arrow_down.xml')
        btn.setVisualState('normal')
        btn.soundControlName = 'ArrowBtn'
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (0, self.component.height - 5, 0.2)
        cmp.visible = False
        self.component.addChild(cmp, 'btnDN')
        btn.onBound()
        cmp = GUI.Simple('soGUI/frame/quick_access/quickslot_array_number_bg.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.tiled = True
        cmp.tileWidth = 15
        cmp.tileHeight = 63
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 15
        cmp.height = 72
        cmp.position = (4, 16, 0.1)
        self.component.addChild(cmp, 'backFrame')
        cmp = GUI.Text('1')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (10, 46, 0.3)
        self.component.addChild(cmp, 'barN')
        return

    def resetDragProxy(self):
        elements = self.component.itemView.children
        for _, child in elements:
            if hasattr(child.script, 'dragProxy') and child.script.dragging:
                child.script.dragProxy.visible = False
                GUI.clearDrag()

    def slotHandler(self, event, data):
        from soInventorySlot2 import soInventorySlot2
        from soCharacterScreen import soGadgetSlot, soCharacterSlot
        if event == ITSLOT.SLOTEVENT_DRAGLEAVE:
            if isinstance(data[0], soActionSlot):
                data[0].clearMarkAsAttachable()
            return True
        else:
            if event == ITSLOT.SLOTEVENT_DRAGENTER:
                if isinstance(data[1], soInventorySlot2):
                    if data[1].haveItem():
                        data[0].checkMarkAsAttachable(data[1].itemData)
                    return True
                if isinstance(data[1], soActionSlot):
                    return True
                if isinstance(data[1], soCharacterSlot):
                    return True
                if isinstance(data[1], soGadgetSlot):
                    return True
            if event == ITSLOT.SLOTEVENT_DROP:
                if isinstance(data[0], soActionSlot):
                    data[0].clearMarkAsAttachable()
                if data[1].itemData:
                    soActionBar._just_drop_item_slot[:] = [BigWorld.time(), data[0], data[1].itemData]
                if isinstance(data[1], soInventorySlot2):
                    data[1].toActionBar(data[0].slotIndex, data[0])
                    return True
                if isinstance(data[1], soActionSlot):
                    BWPersonality.GUICore.actionBarEvent(self.EVENT_MOVE, [data[0].slotIndex, data[1].slotIndex])
                    return True
                if isinstance(data[1], soCharacterSlot):
                    data[1].toActionBar(data[0].slotIndex, data[0])
                    return True
                if isinstance(data[1], soGadgetSlot):
                    data[1].toActionBar(data[0].slotIndex, data[0])
                    return True
            if event == ITSLOT.SLOTEVENT_MOUSEENTER:
                if isinstance(data, soActionSlot):
                    BWPersonality.GUICore.toolTipEvent(data.slotIndex, self.interfaceID, soToolTipComponent.EVENT_SHOW)
                    return True
            if event == ITSLOT.SLOTEVENT_MOUSELEAVE:
                if isinstance(data, soActionSlot):
                    data.clearMarkAsAttachable()
                    BWPersonality.GUICore.toolTipEvent(data.slotIndex, self.interfaceID, soToolTipComponent.EVENT_HIDE)
                    return True
            if event == ITSLOT.SLOTEVENT_LCLICK:
                BWPersonality.GUICore.actionBarEvent(self.EVENT_USE, data.slotIndex)
                return True
            if event == ITSLOT.SLOTEVENT_RCLICK:
                if isinstance(data, soActionSlot):
                    BWPersonality.GUICore.actionBarEvent(self.EVENT_CONTEXT, data.slotIndex)
                    return True
            if event == ITSLOT.SLOTEVENT_DRAGSTART:
                if isinstance(data, soActionSlot):
                    BWPersonality.GUICore.actionBarEvent(self.EVENT_DRAG_START, data.slotIndex)
                    self.drag_data = data
                    return True
            if event == ITSLOT.SLOTEVENT_DRAGSTOP:
                self.drag_data = None
                if isinstance(data, soActionSlot):
                    BWPersonality.GUICore.actionBarEvent(self.EVENT_DRAG_STOP, data.slotIndex)
                    return True
            return False

    def itemViewHandler(self, event, data):
        return False

    def show(self):
        self.component.visible = True

    def hide(self):
        self.component.visible = False

    def _updateSlots(self, data):
        self.component.itemView.script.setItems(data)

    def _updateActionBarN(self, data):
        self.component.barN.text = data

    def update(self):
        data = BWPersonality.GUICore.actionBarDataSection
        if data is not None:
            if data.has_key('slots'):
                self._updateSlots(data['slots'])
            if data.has_key('line_number'):
                self._updateActionBarN(data['line_number'])
        return

    def doReposition(self):
        sw, sh = BigWorld.screenSize()
        self.component.position.x = sw
        self.component.position.y = sh

    def onSetBestCursor(self, mouse_cursor):
        if hasattr(self.component, 'btnUP'):
            self.component.btnUP.visible = mouse_cursor
        if hasattr(self.component, 'btnDN'):
            self.component.btnDN.visible = mouse_cursor

    @PyGUIEvent('btnUP', 'onClick')
    def scrolledUP(self):
        BWPersonality.GUICore.actionBarEvent(self.EVENT_BARSCROLL, 1)

    @PyGUIEvent('btnDN', 'onClick')
    def scrolledDN(self):
        BWPersonality.GUICore.actionBarEvent(self.EVENT_BARSCROLL, -1)

    def release(self):
        self.hide()

    @property
    def draggedItemUnderScreen(self):
        if not self.drag_data:
            return False
        if not self.drag_data._dragged_out_screen:
            return
        if not self.drag_data.itemData:
            return
        if not self.drag_data.itemData.get('have_item'):
            return
        return self.drag_data.itemData.get('item')