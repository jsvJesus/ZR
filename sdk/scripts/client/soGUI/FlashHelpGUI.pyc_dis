 'giftwindow': 205}

class FlashHelpGUI(FlashScriptGUIBase, FlashTeamWorker):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0 \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88\xd0\xb5\xd0\xb2\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xbc\xd0\xbe\xd1\x89\xd0\xb8 Help.swf"""

    def __init__(self, component):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        FlashScriptGUIBase.__init__(self, component)
        FlashTeamWorker.__init__(self)
        self.class_name = self.__class__.__name__
        self.window_visible = False
        self.count_current_little_cards = 0
        self.input_find_focus = False
        layer = BWPersonality.GUICore.flashMessageLayer
        self.bind_to_parrent_layer(layer)

    @classmethod
    def create(cls, movie_path_name = None, backgroundAlpha = 0):
        """\xd0\x9c\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0."""
        movie_path_name = 'extendedGUI/Help.swf'
        backgroundAlpha = 0
        component = super(FlashHelpGUI, cls).create(movie_path_name, backgroundAlpha)
        component.position = (0, 0, 0.18)
        component.visible = True
        component.focus = True
        component.mouseButtonFocus = True
        component.crossFocus = True
        component.moveFocus = True
        component.dragFocus = False
        component.dropFocus = False
        return component

    def show(self):
        """\xd0\x9f\xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88-\xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82"""
        self.show_help()

    def hide(self):
        """\xd0\xa1\xd0\xba\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88-\xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82"""
        self.hide_help()

    def is_little_card_active(self):
        return bool(self.count_current_little_cards)

    def externalInterfaceHandler(self, *args, **kws):
        FlashTeamWorker.externalInterfaceHandler(self, *args, **kws)

    def handleMouseButtonEvent(self, comp, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        result = super(FlashHelpGUI, self).handleMouseButtonEvent(comp, event)
        return result

    def handleMouseEvent(self, comp, event):
        """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e BigWorld."""
        result = super(FlashHelpGUI, self).handleMouseEvent(comp, event)
        return result

    def handleKeyEvent(self, event):
        result = FlashScriptGUIBase.handleKeyEvent(self, event)
        isDown = event.isKeyDown()
        if event.isMouseButton() and event.isKeyUp():
            return False
        if not isDown:
            return False
        if event.key == Keys.KEY_ESCAPE and self.is_little_card_active():
            self.close_cards()
            print True
            return True
        if self.input_find_focus and result and event.key != Keys.KEY_ESCAPE:
            print True
            return True
        return False

    @FlashTeamWorker.receiving_method
    def showError(self, text):
        print text

    @FlashTeamWorker.receiving_method
    def find_card(self, text):
        print 'FlashHelpGUI::find_card', text

    @FlashTeamWorker.receiving_method
    def on_cnange_input_focus(self, value):
        self.input_find_focus = value

    @FlashTeamWorker.exchanging_method
    def load_images_paths(self):
        py_data_section = ResMgr.openSection(IMAGES_PATH)
        lang = Localization.globalLanguage
        data = json.loads(py_data_section.asBinary)
        images = []
        for image_data in data['images']:
            data = {'name': image_data['name'],
             'path': image_data.get('path_' + lang) or image_data.get('path')}
            images.append(data)

        return images

    @FlashTeamWorker.exchanging_method
    def localized_resource(self, paths):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x89\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd1\x8b \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5 json."""
        return super(FlashHelpGUI, self).localized_resource(paths)

    @FlashTeamWorker.exchanging_method
    def load_help_cards(self):
        py_data_section = ResMgr.openSection(CARD_PATH)
        data = json.loads(py_data_section.asBinary)
        return data

    @FlashTeamWorker.sending_method
    def show_card(self, card_id):
        self.count_current_little_cards += 1
        return card_id

    @FlashTeamWorker.sending_method
    def show_paragraph(self, paragraph_id):
        self.show_help()
        return paragraph_id

    @FlashTeamWorker.sending_method
    def close_cards(self):
        self.count_current_little_cards = 0
        return True

    @FlashTeamWorker.sending_method
    def show_help(self):
        self.window_visible = True
        return True

    @FlashTeamWorker.sending_method
    def hide_help(self):
        self.window_visible = False
        return True

    @FlashTeamWorker.receiving_method
    def close_help(self):
        self.hide()