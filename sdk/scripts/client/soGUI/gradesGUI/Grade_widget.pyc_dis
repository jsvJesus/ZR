# Embedded file name: ./client/soGUI/gradesGUI/Grade_widget.py
import GUI
import BigWorld
import grades_utils
from Helpers.PyGUI import PyGUIBase
from soGUI.soButton import soButton
from soGUI.gradesGUI.Grade_slider import Grade_slider
from grades_utils import GRADE_CLIENT_COLORS, GRADE_CLIENT_COLORS2, LOCKED_GRADES
NONE_LOCK, HALF_LOCK, FULL_LOCK, DEV_LOCK, AUTOMODE_LOCK = xrange(5)

class Grade_widget(PyGUIBase):

    def __init__(self, component, width, height, grade_id, parent):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._parent = parent
        self.width = width
        self.height = height
        self.data = {}
        self.default_data = {}
        self.grade_id = grade_id
        self.is_locked = NONE_LOCK
        self.value = 0
        self.value_index = 0
        self.diff_value = 0
        self.component.focus = True
        self.component.moveFocus = True
        self.component.crossFocus = True
        self.component.mouseButtonFocus = True
        self.component.moveFocus = True
        self.setup_root()
        self.setup_UI()
        self.update_lock()

    def setup_root(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = self.height
        cmp.width = self.width
        cmp.visible = True
        cmp.textureName = ''

    def setup_UI(self):
        cmp = GUI.Text()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'CENTER'
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.colour = (174, 174, 174, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 15, 0.5)
        cmp.text = grades_utils.get_param_local(self.grade_id)
        self.component.addChild(cmp, 'name')
        cmp = GUI.Text()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'CENTER'
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (220, 15, 0.5)
        cmp.text = u'0'
        self.component.addChild(cmp, 'value')
        gs = Grade_slider(GUI.Window(), 569, 25)
        cmp = gs.component
        cmp.position = (226, 0, 0.1)
        self.component.addChild(cmp, 'slider')
        self.component.slider.script.set_segments([0, 0, 0], 100)
        btn = soButton(GUI.Window())
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 16
        cmp.height = 16
        cmp.position = (805, 15, 0.5)
        btn.initVSC('soGUI/elements/button_plus.xml')
        btn.onBound()
        btn.setVisualState('normal')
        btn.onClick = self.on_plus_click
        self.component.addChild(cmp, 'btn_plus')
        btn = soButton(GUI.Window())
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 16
        cmp.height = 16
        cmp.position = (831, 15, 0.5)
        btn.initVSC('soGUI/elements/button_minus.xml')
        btn.onBound()
        btn.setVisualState('normal')
        btn.onClick = self.on_minus_click
        self.component.addChild(cmp, 'btn_minus')

    def on_plus_click(self):
        self.grade_up(self.grade_id)
        self.on_change_by_user(1)

    def on_minus_click(self):
        self.on_change_by_user(-1)

    def check_diff_value(self):
        if self.diff_value + self.value_index < 0:
            self.diff_value = -1 * self.value_index
        if self.diff_value + self.value_index > self.default_data['count']:
            self.diff_value = self.default_data['count'] - self.value_index

    def is_value_too_much(self):
        if not self.default_data:
            return False
        _, chance = self._parent.get_cost_chance(self.grade_id, self.diff_value)
        if chance <= 0.001:
            return True
        return self.value_index + self.diff_value >= self.default_data['count']

    def on_change_by_user(self, diff, silence = False):
        if not self.default_data:
            return
        if self.value_index + self.diff_value + diff > self.value_index:
            if self.is_locked not in [NONE_LOCK, DEV_LOCK, AUTOMODE_LOCK]:
                return
            if self.is_locked in [NONE_LOCK, AUTOMODE_LOCK]:
                self.is_locked = HALF_LOCK
        else:
            self.is_locked = NONE_LOCK
        self.diff_value += diff
        self.check_diff_value()
        if self.is_locked in [HALF_LOCK, DEV_LOCK, AUTOMODE_LOCK]:
            if not silence:
                if diff > 0:
                    self.on_end_changed(diff)
                else:
                    self.on_slider_down_changed(self.grade_id)
        self.on_value_changed(diff < 0)
        self.update_lock()
        self.update_text_val()

    def on_change_by_penalty(self, diff):
        self.diff_value += diff
        self.check_diff_value()
        self.component.slider.script.set_change_value(self.diff_value)
        self.update_text_val()

    def get_value(self):
        return self.value_index + self.diff_value

    def on_value_changed(self, is_minus):
        if self.diff_value > 0:
            self.on_grade_up(self.grade_id, is_minus)
        else:
            self.on_grade_down(self.grade_id)
        self.component.slider.script.set_change_value(self.diff_value)

    def on_end_changed(self, count = 1, old_value = False):
        self.on_slider_end_changed(self.grade_id, count, old_value=False)

    def on_slider_end_changed(self, key_id, count = 1, old_value = False):
        pass

    def on_slider_down_changed(self, key_id):
        pass

    def grade_up(self, key_id):
        pass

    def clear(self):
        self.value_index = 0
        self.value = 0
        self.component.slider.script.set_segments([0, 0, 0], 100)
        self.component.slider.script.set_default_value(0)
        self.component.slider.script.set_value(0)
        self.component.slider.script.set_change_value(0)
        self.clear_diff_val()
        self.unlock()
        self.component.value.text = ''

    def dev_unlock(self):
        self.is_locked = DEV_LOCK
        self.update_lock()

    def automode_ulock(self):
        self.is_locked = AUTOMODE_LOCK
        self.update_lock()

    def unlock(self):
        self.is_locked = NONE_LOCK
        self.update_lock()
        self.set_value_index(self.value_index)

    def half_lock(self):
        self.is_locked = HALF_LOCK
        self.update_lock()

    def lock(self):
        self.is_locked = FULL_LOCK
        self.update_lock()

    def update_lock(self):
        if self.default_data is None:
            return
        elif self.default_data.get('id') in LOCKED_GRADES:
            self.component.btn_plus.script.setDisabledState(True)
            self.component.btn_minus.script.setDisabledState(True)
            return
        else:
            result = self.is_locked in [FULL_LOCK, HALF_LOCK] or self.is_value_too_much()
            self.component.btn_plus.script.setDisabledState(result)
            self.component.btn_minus.script.setDisabledState(self.is_locked in [FULL_LOCK, NONE_LOCK])
            return

    def downgrade(self, count):
        self.on_change_by_penalty(-1 * count)

    def upgrade(self, count):
        self.on_change_by_penalty(count)

    def clear_penalty(self):
        self.on_change_by_penalty(-self.diff_value)

    def set_value(self, data):
        self.data = data

    def set_default_value(self, data):
        self.default_data = data
        self.clear()
        min_value = self.default_data['min_value']
        max_value = self.default_data['max_value']
        if grades_utils.GRADE_TYPES.VALUE == grades_utils.get_grage_type(self.grade_id):
            self.value = self.default_data['value']
            self.default_data['value_index'] = int(round((self.value - min_value) / ((max_value - min_value) / float(self.default_data['count']))))
            self.value_index = int(self.default_data['value_index'])
        else:
            self.value_index = int(self.default_data['value_index'])
            self.default_data['value'] = min_value + (max_value - min_value) / float(self.default_data['count']) * self.value_index
            self.value = self.default_data['value']
        self.update_text_val()
        self.component.slider.script.set_default_value(self.default_data['value_index'])
        self.component.slider.script.set_value(self.default_data['value_index'])
        self.clear_diff_val()
        self.component.slider.script.set_segments(self.default_data['params'], self.default_data['count'])
        self.update_lock()

    def update_text_val(self):
        if not self.default_data:
            self.component.value.text = ''
            return
        change_val = self.value_index + self.diff_value - self.default_data['value_index']
        if self.diff_value == 0 and self.value_index == self.default_data['value_index']:
            self.component.value.text = ''
            return
        percent = round(change_val / float(self.default_data['count']) * 100, 1)

        def cut_zeros(t):
            if t.endswith('.0'):
                return cut_zeros(t[:-2])
            if '.' in t and t.endswith('0'):
                return cut_zeros(t[:-1])
            return t

        text = cut_zeros(str(percent))
        self.component.value.text = text + '%'
        if self.diff_value:
            colour = GRADE_CLIENT_COLORS[1] if self.diff_value > 0 else GRADE_CLIENT_COLORS[2]
        else:
            colour = GRADE_CLIENT_COLORS2[0] if self.value_index - self.default_data['value_index'] > 0 else GRADE_CLIENT_COLORS2[1]
        self.component.value.colour = colour

    def on_slider_move(self, value_index):
        self.value_index = int(value_index)
        if not self.default_data:
            return
        try:
            min_value = self.default_data['min_value']
            max_value = self.default_data['max_value']
            count = self.default_data['count']
        except Exception:
            print 'ERROR::on_slider_move', self.default_data
            import traceback
            traceback.print_stack()
            return

        self.value = min_value + (max_value - min_value) / float(count) * self.value_index
        self.update_text_val()

    def clear_diff_val(self):
        self.diff_value = 0
        self.component.slider.script.set_change_value(self.diff_value)
        self.update_text_val()

    def set_value_index(self, value_index):
        """
                \xd1\x82\xd1\x83\xd1\x82 \xd1\x83\xd0\xb6\xd0\xb5 \xd0\xba\xd0\xbe\xd0\xbd\xd0\xba\xd1\x80\xd0\xb5\xd1\x82\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd1\x80\xd1\x83\xd0\xb6\xd0\xb8\xd1\x8f \xd1\x81 \xd1\x83\xd1\x87\xd1\x91\xd1\x82\xd0\xbe\xd0\xbc \xd0\xb3\xd1\x80\xd0\xb5\xd0\xb9\xd0\xb4\xd0\xb0
        """
        if value_index < 0:
            return
        self.on_slider_move(value_index)
        self.component.slider.script.set_value(self.value_index)
        self.clear_diff_val()
        self.update_lock()

    def get_value_index(self):
        return self.value_index + self.diff_value

    def on_grade_up(self, key_id):
        pass

    def on_grade_down(self, key_id):
        pass