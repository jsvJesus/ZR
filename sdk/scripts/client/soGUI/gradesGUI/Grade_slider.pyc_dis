# Embedded file name: ./client/soGUI/gradesGUI/Grade_slider.py
import GUI
import Keys
import Math
import BigWorld
from Helpers.PyGUI import PyGUIBase
from grades_utils import GRADE_CLIENT_COLORS, GRADE_CLIENT_COLORS2
from Helpers.PyGUI.DraggableComponent import DraggableComponent
WIDTH_ONE = 6
TEXTURE_SLIDER = BigWorld.PyTextureProvider('soGUI/frame/segment.dds')

class Grade_slider(PyGUIBase):

    def __init__(self, component, width, height):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.width = width
        self.height = height
        self.count = 100.0
        self.segments = []
        self.segment_controls = []
        self.value = 0
        self.def_value = 0
        self.diff_value = 0
        self.component.focus = True
        self.component.moveFocus = True
        self.component.crossFocus = True
        self.component.mouseButtonFocus = True
        self.component.moveFocus = True
        self.setup_root()

    def setup_root(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = self.height
        cmp.width = self.width
        cmp.visible = True
        cmp.textureName = ''

    def setup_segments(self):
        for i in self.segment_controls:
            self.component.delChild(i)

        x = 0
        self.segment_controls = []
        tmp = 0

        def create_comp():
            comp = GUI.Simple('soGUI/frame/segment.dds')
            comp.materialFX = 'BLEND'
            comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
            comp.widthMode = comp.heightMode = 'PIXEL'
            comp.horizontalAnchor = 'LEFT'
            comp.verticalAnchor = 'TOP'
            comp.tiled = True
            comp.tileWidth = max(self.get_width_one(), 4)
            return comp

        cmp = create_comp()
        cmp.colour = GRADE_CLIENT_COLORS[0]
        cmp.width = self.def_value * self.get_width_one()
        cmp.height = self.height - 4
        cmp.position = (x, 4, 0.4)
        self.component.addChild(cmp, 'segment_{0}'.format(0))
        x += cmp.width
        tmp += cmp.width
        self.segment_controls.append(cmp)
        width = self.width - x
        cmp = create_comp()
        cmp.colour = GRADE_CLIENT_COLORS[-1]
        cmp.width = width
        cmp.height = self.height - 4
        cmp.position = (x, 4, 0.4)
        self.component.addChild(cmp, 'segment_{0}'.format(1))
        self.segment_controls.append(cmp)
        tmp += width
        diff = self.value - self.def_value
        if diff != 0:
            cmp = create_comp()
            cmp.colour = GRADE_CLIENT_COLORS2[0] if diff > 0 else GRADE_CLIENT_COLORS2[1]
            cmp.width = diff * self.get_width_one()
            cmp.height = self.height - 4
            cmp.position = (x, 4, 0.4)
            self.component.addChild(cmp, 'segment_{0}'.format(2))
            self.segment_controls.append(cmp)
        if self.diff_value:
            cmp = create_comp()
            cmp.colour = GRADE_CLIENT_COLORS[1] if self.diff_value > 0 else GRADE_CLIENT_COLORS[2]
            cmp.width = self.diff_value * self.get_width_one()
            cmp.height = self.height - 4
            cmp.position = (self.value * self.get_width_one(), 4, 0.4)
            self.component.addChild(cmp, 'segment_{0}'.format(3))
            self.segment_controls.append(cmp)

    def get_width_one(self):
        return round(self.width / self.count)

    def set_segments(self, value, count):
        if self.segments == value and self.count == float(count):
            return
        self.segments = value
        self.count = float(count)
        self.setup_segments()

    def set_default_value(self, value):
        self.def_value = value

    def set_value(self, value):
        new_value = max(0, min(self.count, value))
        if new_value == self.value:
            return
        self.value = new_value
        self.setup_segments()

    def set_change_value(self, value):
        if value == self.diff_value:
            return
        self.diff_value = value
        self.setup_segments()