        cmp = GUI.Frame2('soGUI/frame/basic_frame_1.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.component.width
        cmp.height = self.component.height
        cmp.position = (0, 0, 1.0)
        self.component.addChild(cmp, 'wndFrame')
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/elements/closeBox.xml')
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.component.width - 5, 6, 0.2)
        btn.onClick = self.onCloseBox
        self.component.addChild(cmp, 'closeBox')
        btn.onBound()
        btn._updateVisualState()
        bConfirm = soButton(GUI.Window())
        bConfirm.initVSC('soGUI/elements/button_1.xml')
        cmp = bConfirm.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 200
        cmp.height = 25
        cmp.label.text = lc('GUI.ClanEmblems.BUY_CAPTION')
        cmp.position = (self.component.width - 7, self.component.height - 7, 0.9)
        self.component.addChild(cmp, 'btnConfirm')
        bConfirm.onClick = self.onSaveIconBtnClick
        bConfirm.onBound()
        bConfirm._updateVisualState()
        bClear = soButton(GUI.Window())
        bClear.initVSC('soGUI/elements/button_1.xml')
        cmp = bClear.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 95
        cmp.height = 25
        cmp.label.text = lc('colourItemWindow.CANCEL')
        x = self.component.btnConfirm.position[0] - self.component.btnConfirm.width - 5
        cmp.position = (x, self.component.height - 7, 0.9)
        self.component.addChild(cmp, 'ccancel')
        bClear.onClick = self._cancel
        bClear.onBound()
        bClear._updateVisualState()
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colourFormatting = True
        cmp.multiline = False
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (17, 16, 0.2)
        cmp.text = lc('GUI.ClanEmblems.CAPTION')
        self.component.wndFrame.addChild(cmp, 'nameLabel')
        self.frame_change_image = frameChangeImage.FrameChangeClanEmblemImage(GUI.Window(), self)
        self.frame_change_image.component.position = (2, 30, 0.0)
        self.component.addChild(self.frame_change_image.component, 'frameChangeImage')
        self.add_render()

    def add_render(self):
        self._renderModel = ModelWindow(GUI.Window())
        self.component.addChild(self._renderModel.component, 'renderModel')
        self.resetModels()

    def resetModels(self):
        player = BigWorld.player()

        def onLoadModel(model):
            self._renderModel.setModels({'player': model,
             'flag': flag_model})
            self.onLoadModel(model)

        StalkerModel.ComposePlayerModelTraker(player, callback=onLoadModel)
        flag_model = BigWorld.Model('models/misc/signs/flag/flag.model')

    def get_cost_emblem(self):
        return DyeConstant.COST_CLAN_EMBLEM

    def updateMarkText(self):
        entity = BigWorld.player()
        mark_text = get_entity_name(entity, utf8=True)
        clan_text = u'\n'
        if entity.union_tag:
            clan_text += colorCodes.mark_clan_neutral + u'[{0}] '.format(entity.union_tag.decode('utf-8'))
        clan_text += colorCodes.mark_clan_neutral
        if clan_text:
            clan_text += entity.clanName.decode('utf-8')
        mark_text += clan_text
        cmp = TypicalPlayerCaption(dict(text=mark_text, alpha=1.0))
        cmp.component.position = (0.63, 0.53, 0.0)
        cmp.visible = True
        self.component.addChild(cmp.component, 'playerCaption')

    def updateEmblemList(self, data):
        self.frame_change_image.updateEmblemList(data)

    def _drawIcon(self, imgID, feedName = '', texture = None):
        if not hasattr(self.component, 'playerCaption'):
            return
        else:
            self.component.playerCaption.script.clanIconID = imgID
            self.component.playerCaption.script.setClanIcon(imgID, feedName, texture)
            self.newEmblemID = imgID
            if texture:
                self.frame_change_image._drawIcon(imgID, feedName, texture)
                StalkerModel.setFeed(self._renderModel._model, None, 'flag_color', feedName, texture)
            else:
                self.frame_change_image._drawIcon(None)
                self.frame_change_image._drawIcon(imgID, feedName, texture)
                StalkerModel.setFeed(self._renderModel._model, None, 'flag_color', 'feed_disabled', texture)
                self.newEmblemID = 0
            return

    def clearEmblem(self):
        self.newEmblemID = self.currentEmblemID

    def onLoadModel(self, model):
        self._renderModel.show()
        self.updateCurrentIcon()

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'clanEmblemScreen')
        self.component.visible = True
        self.resetModels()
        self.updateMarkText()
        player = BigWorld.player()
        if not player.checkClanRights(Clan.FLAG_CAN_CHANGE_ICON) or not ClanSettings.can_change_emblem(player.clan_level):
            self.frame_change_image.LockBtn()
        player.base.getMyEmblems()
        player.getConsumables()
        BWPersonality.GUICore.setBestCursor()
        self.frame_change_image.updatePlayerMoney(player.CreditNumber)
        return

    def hide(self):
        self.component.visible = False
        self._renderModel.hide()
        self.frame_change_image.setStatus(1)
        self.frame_change_image.unLockBtn()
        BWPersonality.GUICore.setBestCursor()

    def updateModel(self):
        self._renderModel.show()

    def onCloseBox(self):
        self.hide()

    def updateCurrentIcon(self):
        pl = BigWorld.player()
        if pl:
            self.currentEmblemID = pl.clanEmblemID
            if self.currentEmblemID:
                UCManager.ucmanager.loadImg(self.currentEmblemID, self._drawIcon)
            else:
                self._drawIcon(self.currentEmblemID)

    def _cancel(self):
        self.frame_change_image.setStatus(1)
        emblemID = self.currentEmblemID
        self.clearEmblem()
        if emblemID:
            UCManager.ucmanager.loadImg(emblemID, self._drawIcon)
        else:
            self._drawIcon(0)

    def onSaveIconBtnClick(self):

        def _save_check(event):
            if event == gui_jokes.askUserYesNo.YES:
                if self.newEmblemID is not None:
                    BigWorld.player().cell.saveClanIconID(self.newEmblemID)
                    BigWorld.callback(1, self.updateCurrentIcon)
                    self.frame_change_image.setStatus(1)
            return

        if self.newEmblemID == self.currentEmblemID or self.newEmblemID == -1:
            gui_jokes.askUserOk(lc('GUI.ClanEmblems.BUY_CAPTION'), lc('GUI.ClanEmblems.NOT_SAVE'))
            return
        pl = BigWorld.player()
        if not pl or not pl.__class__.__name__ == 'PlayerAvatar':
            return
        if self.newEmblemID == 0:
            gui_jokes.askUserYesNo(lc('GUI.ClanEmblems.BUY_CAPTION'), lc('GUI.ClanEmblems.RESET_EMBLEM'), _save_check)
            return
        if pl.CreditNumber < DyeConstant.COST_CLAN_EMBLEM:
            gui_jokes.askUserOk(lc('colourItemWindow.ERROR'), lc('colourItemWindow.NOT_ENOUGH_MONEY'))
            return
        gui_jokes.askUserYesNo(lc('GUI.ClanEmblems.BUY_CAPTION'), lc('GUI.ClanEmblems.SAVE_EMBLEM_TEXT').format(DyeConstant.COST_CLAN_EMBLEM), _save_check)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True


class TypicalPlayerCaption(soInworldMarker):

    def setupMark(self, *w, **kw):
        super(TypicalPlayerCaption, self).setupMark(*w, **kw)
        self.component.delShader('mover')


class ModelWindow(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._x, self._y, self._z = (0.015, 1.48, -0.415)
        self.setupRoot()

    def setupRoot(self):
        W, H = (500, 420)
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = W
        cmp.height = H
        cmp.position = (340, 30, 0.1)
        cmp.colour = (255, 255, 255, 100)
        cmp.materialFX = 'BLEND'
        cmp.visible = True
        cmp.focus = 0
        cmp.crossFocus = 0
        cmp.dragFocus = False
        cmp.moveFocus = 1
        cmp.dropFocus = False
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 19, 17, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0.0, 0.1)
        cmp.visible = 0
        self.component.addChild(cmp, 'tmpFON')
        cmp.width = H - 10
        cmp.height = H - 10
        cmp = GUI.Simple('textures/default/blue_dark.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0.0, 0.1)
        cmp.visible = 1
        self.component.addChild(cmp, 'renderDummy')
        cmp.width = H - 10
        cmp.height = H - 10
        mr = BigWorld.PyModelRenderer(H, H)
        for zz in xrange(100):
            mr.delDirectionLight(0)
            mr.delOmniLight(0)

        dir1 = Math.Vector3((1, -1, 0))
        dir1.normalise()
        mr.addOmniLight((1.2, 1.2, 1.2, 1.5), (self._x, self._y, self._z), 0.2, 3)
        c = 0.5
        mr.addAmbientColor(tuple([c] * 4))
        self._model_renderer = mr

    def doReposition(self):
        W, H = BigWorld.screenSize()
        self.component.renderDummy.width = H - 10
        self.component.renderDummy.height = H - 10
        self.component.tmpFON.width = H - 10
        self.component.tmpFON.height = H - 10

    def show(self):
        self._model_renderer.dynamic = True
        self.component.renderDummy.texture = self._model_renderer.texture

    def hide(self):
        self._model_renderer.dynamic = False
        self.component.renderDummy.texture = None
        self.clearModel()
        return

    def getModel(self):
        return self._model

    def clearModel(self):
        self._model_renderer.models = []

    def setModels(self, model):
        self._model = model['flag']
        self._model.zoomExtents(0, 0.15)
        self._model.yaw = 1.5
        self._model.flag_color = 'blue'
        self._model.position = (-1.2, -0.7, 0.5)
        self._model.rotate(0.5, (2, 0, -0.6), (1, 0, 0))
        model['player'].zoomExtents(1, 2.0)
        model['player'].yaw = 2.0
        model['player'].rotate(1.3, (4, 6, 2), (3, 0, 0))
        model['player'].position = (0.25, -1.3, -0.5)
        self._model_renderer.models = [self._model, model['player']]
        try:
            model['player'].idle_0_stay_bored()
            self._model.Wave()
        except:
            import traceback
            traceback.print_exc()

    def addModel(self, model):
        self._model.append(model)
        self._model_renderer.models = self._model

    def updateImageData(self, imgids, myimgids):
        pass