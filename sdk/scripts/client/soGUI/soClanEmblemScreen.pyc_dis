class ClanEmblemScreen(PyGUIBase, DraggableComponent):
    factoryString = 'soGUI.soClanEmblemScreen'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, 1, 1, 1, xoffset=0, yoffset=0)
        component.script = self
        self._x, self._y, self._z = (0.015, 1.48, -0.415)
        self.frame_change_image = None
        self.setupRoot()
        self.setupContent()
        self.currentEmblemID = None
        self.newEmblemID = None
        return

