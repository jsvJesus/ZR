# Embedded file name: ./client/soGUI/PaintGUI/PaintColorPicker.py
from TableGrid import TableGrid
from Helpers.PyGUI.PyGUIBase import PyGUIBase
import GUI
import Keys
CHANNELS = ['R',
 'G',
 'B',
 'A']

class PaintItem(PyGUIBase):

    def __init__(self, component, channel):
        component.mouseButtonFocus = True
        self.channel = channel
        PyGUIBase.__init__(self, component)
        component.script = self
        self.on_click = lambda channel: None
        self._setup_content()
        self.selected = False

    def _setup_content(self):
        size = 2
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.width, comp.height = size, size
        comp.position = (0, 0, 0.5)
        comp.materialFX = 'SOLID'
        self.component.addChild(comp, 'frame')
        size = 1.84
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.width, comp.height = size, size
        comp.position = (0, 0, 0.4)
        comp.materialFX = 'SOLID'
        self.component.addChild(comp, 'background')

    def handleMouseButtonEvent(self, comp, event):
        if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
            self.on_click(self)
        return True

    @property
    def color(self):
        return self.component.background.colour

    @color.setter
    def color(self, value):
        self.component.background.colour = value

    @property
    def selected(self):
        return self.component.frame.visible

    @selected.setter
    def selected(self, value):
        self.component.frame.visible = value


class PaintColorPicker(TableGrid):

    def __init__(self, component):
        TableGrid.__init__(self, component, 4, 1, True)
        self._selected = None
        self.on_click = lambda chanel, color: None
        return

    def create_item_component(self, colour, index):
        comp = GUI.Window()
        self._paint_item = PaintItem(comp, CHANNELS[index])
        self._paint_item.on_click = self._on_item_click
        self._paint_item.color = colour
        return self._paint_item.component

    def set_color(self, chanel, color):
        self.items[CHANNELS.index(chanel)].color = color

    def set_items(self, colors):
        TableGrid.set_items(self, colors)
        self._selected = None
        if self.items:
            self._on_item_click(self.items[0])
        return

    def _on_item_click(self, paint_item):
        if self._selected:
            self._selected.selected = False
        self._selected = paint_item
        self._selected.selected = True
        self.on_click(paint_item.channel, self._selected.color)