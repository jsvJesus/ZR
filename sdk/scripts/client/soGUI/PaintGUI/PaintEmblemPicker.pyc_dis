import copy

class PaintItem(PyGUIBase):

    def __init__(self, emblem_id):
        PyGUIBase.__init__(self)
        self.component = GUI.Window()
        self.component.script = self
        self.component.mouseButtonFocus = True
        self.emblem_id = emblem_id
        self._setup_content()
        self._selected = False
        self._locked = False
        self.on_click = lambda item: None
        self._update_appearance()

    def _icon_loaded(self, image_id, feed_name, texture):
        self.component.image.texture = texture

    def _setup_content(self):
        comp = GUI.Simple('soGUI/frame/paint/borderslot.dds')
        comp.materialFX = 'BLEND'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.9)
        comp.width = comp.height = 2
        self.component.addChild(comp, 'select_background')
        comp = GUI.Simple('')
        comp.script = self
        comp.filterType = 'LINEAR'
        comp.materialFX = 'BLEND'
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.7)
        self.component.addChild(comp, 'image')
        if self.emblem_id:
            comp.width, comp.height = (1.6, 1.6)
            UCManager.ucmanager.loadImg(self.emblem_id, self._icon_loaded)
        else:
            comp.width, comp.height = (1, 1)
            comp.colour = (255, 255, 255, 120)
            self._icon_loaded(None, None, BigWorld.PyTextureProvider('soGUI/frame/paint/no_camo.dds'))
        return

    def handleMouseButtonEvent(self, comp, event):
        if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
            self.on_click(self)
        return True

    @property
    def locked(self):
        return self._locked

    @locked.setter
    def locked(self, value):
        self._locked = value
        self._update_appearance()

    @property
    def selected(self):
        return self._selected

    @selected.setter
    def selected(self, value):
        self._selected = value
        self._update_appearance()

    def _update_appearance(self):
        self.component.select_background.visible = not self._locked and self._selected
        self.component.image.visible = not self._locked


class PaintEmblemPicker(ScrollTable):

    def __init__(self, comp):
        self._repositioners = []
        ScrollTable.__init__(self, comp, True, 6, 5)
        self._loaded_emblems = []
        self._selected_item = None
        self._emblem_id = None
        self.on_emblem_changed = lambda emblem: None
        return

    def _setup_content(self):
        ScrollTable._setup_content(self)
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (0, 0, 0, 150)
        comp.position = (0, 0, 0.1)
        Interceptor(comp)
        self.component.addChild(comp, 'lock_pane')
        comp = GUI.Text(lc('PaintScreen.emblems.LOCKED'))
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.position = (0, 0, 0.5)
        comp.width, comp.height = (2, 2)
        self.component.lock_pane.addChild(comp, 'text')
        self._repositioners.append(TextScaler(comp, 'RobotoCondensedRegular_36_2'))

    def set_items(self, emblem_ids):
        self._loaded_emblems = copy.copy(emblem_ids)
        ScrollTable.set_items(self, [None] + self._loaded_emblems)
        return

    def add_items(self, emblem_ids):
        new_emblems = filter(lambda emblem_id: emblem_id not in self._loaded_emblems, emblem_ids)
        self._loaded_emblems.extend(new_emblems)
        ScrollTable.set_items(self, [None] + self._loaded_emblems)
        return

    def set_active_emblem(self, emblem_id):
        self._emblem_id = None
        if not self.items:
            BigWorld.callback(0, partial(self.set_active_emblem, emblem_id))
            return
        else:
            paint_item = next((pi for pi in self.items if pi.emblem_id == emblem_id), None)
            if not paint_item and not emblem_id:
                paint_item = self.items[0]
            self._emblem_id = emblem_id
            self._set_active(paint_item, False)
            return

    def do_reposition(self):
        ScrollTable.do_reposition(self)
        for r in self._repositioners:
            r.do_reposition()

        comp = self.component.lock_pane
        frame_comp = self.component.frame
        comp.widthMode, comp.heightMode = frame_comp.widthMode, frame_comp.heightMode
        comp.width, comp.height = frame_comp.width, frame_comp.height
        comp.horizontalPositionMode, comp.verticalPositionMode = frame_comp.horizontalPositionMode, frame_comp.verticalPositionMode
        comp.horizontalAnchor, comp.verticalAnchor = frame_comp.horizontalAnchor, frame_comp.verticalAnchor
        comp.position[0], comp.position[1] = frame_comp.position[0], frame_comp.position[1]
        comp = self.component
        comp.widthMode, comp.heightMode = frame_comp.widthMode, frame_comp.heightMode
        comp.width, comp.height = frame_comp.width, frame_comp.height
        comp.horizontalPositionMode, comp.verticalPositionMode = frame_comp.horizontalPositionMode, frame_comp.verticalPositionMode
        comp.horizontalAnchor, comp.verticalAnchor = frame_comp.horizontalAnchor, frame_comp.verticalAnchor
        comp.position[0], comp.position[1] = frame_comp.position[0], frame_comp.position[1]
        Interceptor(comp)

    def _set_active(self, paint_item, notify = True):
        if self._selected_item == paint_item:
            return
        else:
            prev_emblem = None
            new_emblem = None
            if self._selected_item:
                prev_emblem = self._selected_item.emblem_id
                self._selected_item.selected = False
            self._selected_item = paint_item
            if self._selected_item:
                new_emblem = self._selected_item.emblem_id
                self._selected_item.selected = True
            if notify:
                if prev_emblem != new_emblem or self._emblem_id and not new_emblem:
                    self.on_emblem_changed(new_emblem)
            return

    def _on_item_click(self, item):
        if self._selected_item == item:
            return
        self._set_active(item)

    def create_item_component(self, emblem_id, index):
        item = PaintItem(emblem_id)
        item.on_click = self._on_item_click
        return item.component

    @property
    def locked(self):
        self.component.lock_pane.visible

    @locked.setter
    def locked(self, value):
        self.component.lock_pane.visible = value
        for pi in self.items:
            pi.locked = value