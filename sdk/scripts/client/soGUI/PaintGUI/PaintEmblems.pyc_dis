# Embedded file name: ./client/soGUI/PaintGUI/PaintEmblems.py
from LoadEmblem import LoadEmblem
from PaintEmblemPicker import PaintEmblemPicker
import ItemsUtils
import functools
import GUI

class PaintEmblems(object):
    STANDARD_MODE, PERSONAL_MODE, LOAD_MODE = xrange(3)

    def __init__(self, screen_comp, emblems_comp, standard_button, personal_button, load_emblem_button, file_browser_comp):
        self._stored_item = None
        self.on_item_emblemed = lambda complex_item: None
        self._standard_button = standard_button
        self._standard_button.on_click = functools.partial(self._set_mode, PaintEmblems.STANDARD_MODE)
        self._personal_button = personal_button
        self._personal_button.on_click = functools.partial(self._set_mode, PaintEmblems.PERSONAL_MODE)
        self._load_emblem_button = load_emblem_button
        self._load_emblem_button.on_click = functools.partial(self._set_mode, PaintEmblems.LOAD_MODE)
        self._setup_content(screen_comp, emblems_comp, file_browser_comp)
        return

    def _setup_content(self, screen_comp, emblems_comp, file_browser_comp):
        self._repositioners = []
        self._standard_parent_comp = GUI.Simple('')
        emblems_comp.addChild(self._standard_parent_comp, 'standard_parent')
        self._personal_parent_comp = GUI.Simple('')
        emblems_comp.addChild(self._personal_parent_comp, 'personal_parent')
        self._standard_table = PaintEmblemPicker(self._standard_parent_comp)
        self._standard_table.on_emblem_changed = functools.partial(self._on_emblem_changed, PaintEmblems.STANDARD_MODE)
        self._personal_table = PaintEmblemPicker(self._personal_parent_comp)
        self._personal_table.on_emblem_changed = functools.partial(self._on_emblem_changed, PaintEmblems.PERSONAL_MODE)
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width = comp.height = 2
        comp.materialFX = 'BLEND'
        comp.colour = (255,
         255,
         255,
         76.5)
        comp.horizontalPositionMode = 'CLIP'
        comp.horizontalAnchor = 'LEFT'
        comp.position[0] = -1
        emblems_comp.addChild(comp)
        self._load_parent_comp = comp
        self._load_emblem = LoadEmblem(screen_comp, comp, file_browser_comp)
        self._load_emblem.on_texture_changed = functools.partial(self._on_emblem_changed, PaintEmblems.LOAD_MODE)
        self._load_emblem.on_image_uploaded_callback = self._on_new_image_uploaded
        self._load_emblem.on_emblem_loaded_callback = functools.partial(self._set_mode, PaintEmblems.PERSONAL_MODE)
        self._set_mode(PaintEmblems.STANDARD_MODE)

    def _set_mode(self, mode):
        self.close_browser()
        if mode == PaintEmblems.STANDARD_MODE:
            self._standard_button.enabled = False
            self._personal_button.enabled = True
            self._load_emblem_button.enabled = True
            self._standard_parent_comp.visible = True
            self._personal_parent_comp.visible = False
            self._load_emblem.hide()
        elif mode == PaintEmblems.PERSONAL_MODE:
            self._standard_button.enabled = True
            self._personal_button.enabled = False
            self._load_emblem_button.enabled = True
            self._standard_parent_comp.visible = False
            self._personal_parent_comp.visible = True
            self._load_emblem.hide()
        elif mode == PaintEmblems.LOAD_MODE:
            self._load_emblem_button.enabled = False
            self._standard_button.enabled = True
            self._personal_button.enabled = True
            self._standard_parent_comp.visible = False
            self._personal_parent_comp.visible = False
            self._load_emblem.show()

    def close_browser(self):
        self._load_emblem.close_browser()

    def do_reposition(self):
        self._standard_table.do_reposition()
        self._personal_table.do_reposition()
        self._load_parent_comp.widthMode = self._standard_table.pane.widthMode
        self._load_parent_comp.width = self._standard_table.pane.width * 1.8 * 0.5
        self._load_emblem.do_reposition()
        for r in self._repositioners:
            r.do_reposition()

    def on_hide(self):
        self._stored_item = None
        return

    def on_item_selected(self, paint_item):
        emblem_id = None
        self._stored_item = None
        if paint_item:
            self._stored_item = paint_item
            emblem = ItemsUtils.getItemEmblem(self._stored_item.complex_item)
            emblem_id = emblem and emblem[0]
        self._standard_table.set_active_emblem(emblem_id)
        self._personal_table.set_active_emblem(emblem_id)
        self._load_emblem.reset()
        self._update_lock()
        return

    def set_params(self, tickets):
        self._load_emblem.set_tickets(tickets)

    def _update_lock(self):
        locked = not self._stored_item or not ItemsUtils.can_be_emblemed(self._stored_item.complex_item['complexItemType'])
        self._standard_table.locked = locked
        self._personal_table.locked = locked

    def _on_new_image_uploaded(self, image_id):
        self._personal_table.add_items([image_id])
        self._personal_table.do_reposition()

    def set_items(self, emblems_ids, is_personal):
        if is_personal:
            self._personal_table.set_items(emblems_ids)
            self._personal_table.do_reposition()
        else:
            self._standard_table.set_items(emblems_ids)
            self._standard_table.do_reposition()
        self._update_lock()

    def _on_emblem_changed(self, mode, emblem):
        if mode == PaintEmblems.STANDARD_MODE:
            self._personal_table.set_active_emblem(emblem)
            self._load_emblem.reset()
        elif mode == PaintEmblems.PERSONAL_MODE:
            self._standard_table.set_active_emblem(emblem)
            self._load_emblem.reset()
        elif mode == PaintEmblems.LOAD_MODE:
            self._personal_table.set_active_emblem(None)
            self._standard_table.set_active_emblem(None)
        if self._stored_item:
            subitem = None
            item_id = self._stored_item.complex_item['complexItemID']
            if self._stored_item.parent_item:
                subitem = ItemsUtils.GetSubItemByID(self._stored_item.parent_item, item_id)
            complex_item = self._stored_item.complex_item
            if mode == PaintEmblems.LOAD_MODE:
                if subitem:
                    self._stored_item.parent_item['fake_child'] = (item_id, emblem)
                    ItemsUtils.setItemEmblem(subitem, None)
                else:
                    complex_item['fake_emblem'] = emblem
                ItemsUtils.setItemEmblem(complex_item, None)
            else:
                if 'fake_emblem' in complex_item:
                    del complex_item['fake_emblem']
                if 'fake_child' in complex_item:
                    del complex_item['fake_child']
                if subitem:
                    ItemsUtils.setItemEmblem(subitem, emblem)
                ItemsUtils.setItemEmblem(complex_item, emblem)
            self.on_item_emblemed(complex_item)
        return