        self._scroll_bar = ScrollBar(self.component.frame, comp, self.component, self._side_mode)
        Interceptor(self.component, intercept_moving=False)

    def do_reposition(self):
        comp = self.component.frame
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = 'LEFT' if self._side_mode else 'RIGHT', 'TOP'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (-1 if self._side_mode else 1, 1, comp.position[2])
        comp.width, comp.height = (1.8, 2)
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        tile_width = int(comp.width / self.size[0])
        tile_height = int(comp.height / self.size[1])
        comp.width, comp.height = tile_width * self.size[0], tile_height * self.size[1]
        comp = self.pane
        frame_comp = self.component.frame
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = tile_width * self.size[0], tile_height * self.size[1]
        comp.horizontalAnchor, comp.verticalAnchor = frame_comp.horizontalAnchor, frame_comp.verticalAnchor
        comp.horizontalPositionMode, comp.verticalPositionMode = frame_comp.horizontalPositionMode, frame_comp.verticalPositionMode
        comp.position = (frame_comp.position[0], frame_comp.position[1], comp.position[2])
        comp.tileWidth, comp.tileHeight = tile_width, tile_height
        pane_comp = self.pane
        rows_needed = int(math.ceil(float(len(pane_comp.children)) / self.size[0]))
        if rows_needed > self.size[1]:
            pane_comp.height = rows_needed * tile_height
        for i, (_, item_comp) in enumerate(pane_comp.children):
            column = i % self.size[0]
            row = i / self.size[0]
            item_comp.horizontalPositionMode, item_comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            item_comp.widthMode, item_comp.heightMode = ('PIXEL', 'PIXEL')
            item_comp.horizontalAnchor, item_comp.verticalAnchor = ('LEFT', 'TOP')
            item_comp.width = tile_width
            item_comp.height = tile_height
            item_comp.position = (column * tile_width, row * tile_height, 0.5)

        self._scroll_bar.do_reposition()

    def create_item_component(self, item, index):
        """ \xd1\x8d\xd1\x82\xd1\x83 \xd1\x88\xd1\x82\xd1\x83\xd0\xba\xd1\x83 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbe\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb2 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xb5 \xd0\xb8\xd0\xbb\xd0\xb8 \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb5\xd0\xb3\xd0\xb0\xd1\x82 create_item_delegate"""
        return GUI.Simple('soGUI/frame/paint/image.dds')

    def set_items(self, items):
        pane_comp = self.pane
        for _, child in pane_comp.children:
            pane_comp.delChild(child)

        self.items = []
        for i, item in enumerate(items):
            comp = self.create_item_delegate(item, i)
            self.items.append(comp.script)
            pane_comp.addChild(comp)

    @property
    def content_pos(self):
        frame = self.component.frame
        prev_mode = (frame.widthMode, frame.heightMode)
        frame.widthMode, frame.heightMode = ('CLIP', 'CLIP')
        frame.widthMode, frame.heightMode = prev_mode
        return self.component.frame.localToScreen((-1, 0))[0]

    @property
    def pane(self):
        return self._scroll_bar.component.scroll_area