# Embedded file name: ./client/soGUI/PaintGUI/PaintPalete.py
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from TableGrid import TableGrid
import Keys
import GUI
DEBUG = False

class PaintItem(PyGUIBase):

    def __init__(self, color):
        component = GUI.Window()
        PyGUIBase.__init__(self, component)
        component.script = self
        self.color = color
        self._setup_content()
        self.component.mouseButtonFocus = True
        self.on_click = lambda paint_item: None
        self.selected = False

    def _setup_content(self):
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (1.95, 1.95)
        comp.position = (0, 0, 0.5)
        comp.materialFX = 'SOLID'
        self.component.addChild(comp, 'frame')
        comp = GUI.Simple('soGUI/frame/paint/white.dds')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (1.7, 1.7)
        comp.position = (0, 0, 0.4)
        comp.materialFX = 'SOLID'
        comp.colour = self.color + (255,)
        self.component.addChild(comp)

    def handleMouseButtonEvent(self, comp, event):
        if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
            self.on_click(self)
        return True

    @property
    def selected(self):
        return self.comp.frame.visible

    @selected.setter
    def selected(self, value):
        self.component.frame.visible = value


class PaintPalete(PyGUIBase):

    def __init__(self, component):
        component.moveFocus = True
        PyGUIBase.__init__(self, component)
        self.component.script = self
        self.component.visible = False
        self._setup_content()
        self.on_click = lambda color: None
        self._selected = None
        return

    def _setup_content(self):
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        self._table_grid = TableGrid(comp, 18, 1, False)
        self._table_grid.create_item_delegate = self.create_item_component
        self.component.addChild(comp, 'table')

    def create_item_component(self, color, index):
        paint_item = PaintItem(color)
        paint_item.on_click = self._on_color_click
        return paint_item.component

    def _on_color_click(self, paint_item):
        if self._selected:
            self._selected.selected = False
        self._selected = paint_item
        self._selected.selected = True
        self.on_click(paint_item.color)

    def do_reposition(self):
        prev_mode = self.component.widthMode
        self.component.widthMode = 'PIXEL'
        pixel_width = self.component.width
        self.component.widthMode = prev_mode
        comp = self.component.table
        comp.horizontalPositionMode = 'CLIP'
        self.component.heightMode = 'CLIP'
        self.component.height = 0.25
        comp.heightMode = 'PIXEL'
        comp.height = pixel_width * 0.055
        comp.heightMode = 'PIXEL'
        tile_size = comp.height
        border_size = tile_size / 2
        comp.widthMode = 'PIXEL'
        comp.width = tile_size * self._table_grid.cols
        comp.heightMode = 'PIXEL'
        comp.height = tile_size
        self._table_grid.do_reposition()
        self.component.heightMode = 'PIXEL'
        self.component.height = comp.height + border_size
        self.component.widthMode = 'PIXEL'
        self.component.width = comp.width + border_size
        comp.verticalPositionMode = 'PIXEL'
        comp.verticalAnchor = 'BOTTOM'
        comp.position = (0, self.component.height - border_size / 2, 0.9)

    def show(self, colors, cur_color):
        if self._selected:
            self._selected.selected = False
            self._selected = None
        self._table_grid.set_items(colors)
        self.component.visible = True
        cur_color_formatted = tuple(list(cur_color)[:-1])
        for paint_item in self._table_grid.items:
            if paint_item.color == cur_color_formatted:
                self._selected = paint_item
                self._selected.selected = True
                break

        self.do_reposition()
        return

    def hide(self):
        self.component.visible = False