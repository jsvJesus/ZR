        comp.colour = (0, 0, 0, 255)
        self.component.frame0.addChild(comp, 'header')
        self._texts.append(TextScaler(comp, 'RobotoCondensedRegular_16'))
        self._result = ResultItem()
        self.component.addChild(self._result.component, 'frame1')
        self._shop_confirm = ShopConfirm()
        self._background.addChild(self._shop_confirm.component)

    def _on_confirm(self):
        self.on_confirm(self._tickets, *self._filter_items())

    def do_reposition(self):
        comp = self.component
        comp.heightMode, self.component.widthMode = ('CLIP', 'PIXEL')
        comp.height = 1.6
        comp.heightMode = 'PIXEL'
        comp.width = self.component.height * 0.6
        comp.frame0.scrollback.height = 1.85
        if not self._painted_items and not self._emblemed_items:
            comp.heightMode = 'CLIP'
            if self._emblems:
                comp.height = 0.75
                comp.frame0.scrollback.height = 1.3
            else:
                comp.height = 0.45
        comp = self.component.frame2
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.width = 2
        comp.widthMode = 'PIXEL'
        comp.height = comp.width * 0.165
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.position = (0, -1, 0)
        prev_mode = self.component.frame2.heightMode
        self.component.frame2.heightMode = 'PIXEL'
        frame2_height = self.component.frame2.height
        self.component.frame2.heightMode = prev_mode
        self._result.do_reposition()
        comp = self.component.frame1
        comp.verticalPositionMode = 'CLIP'
        comp.position[1] = -1
        comp.verticalPositionMode = 'PIXEL'
        comp.position[1] -= frame2_height
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width = 2
        comp.widthMode = 'PIXEL'
        comp.height = comp.width * 0.2
        frame1_height = comp.height
        comp = self.component.frame0
        comp.heightMode = 'CLIP'
        comp.height = 2
        comp.heightMode = 'PIXEL'
        comp.height -= frame2_height + frame1_height
        comp = self.component.frame0.header
        comp.verticalPositionMode = 'PIXEL'
        comp.position[1] = frame2_height * 0.3
        for text in self._texts:
            text.do_reposition()

        for item in self._items:
            item.do_reposition()

        self._scroll.do_reposition()
        self._shop_confirm.do_reposition()
        self._close_btn.do_reposition()
        self._close_btn.component.position = (self.component.width - 8, 8, 0.0)

    def show(self, painted_items, emblemed_items, emblems, header_text):
        if self._background.visible:
            return
        self.component.frame0.header.text = header_text
        self._background.visible = True
        self._painted_items = painted_items
        self._emblemed_items = emblemed_items
        self._emblems = emblems
        self._ignore_items = []
        self._ignore_emblems = []
        self._update_data()

    def hide_dell_buttons(self):
        for item in self._items:
            item.hide_dell_buttons()

    def show_total_only(self, tickets, header_text):
        if self._background.visible:
            return
        self.component.frame0.header.text = header_text
        self._background.visible = True
        self._painted_items = {}
        self._emblemed_items = {}
        self._emblems = {}
        self._ignore_items = []
        self._ignore_emblems = []
        self._update_data(additional_tickets=tickets)

    def set_available(self, tickets):
        self._available_tickets = tickets
        self._result.set_available_data(tickets)
        self._update_apply_button()

    def _filter_items(self):
        painted_items = copy(self._painted_items)
        emblemed_items = copy(self._emblemed_items)
        emblems = {}
        for texture, item_ids in self._emblems.items():
            emblems[texture] = copy(item_ids)

        for item_id in self._ignore_items:
            if item_id in painted_items:
                del painted_items[item_id]
            if item_id in emblemed_items:
                del emblemed_items[item_id]
            for texture, item_ids in emblems.items():
                if item_id in item_ids:
                    item_ids.remove(item_id)
                    if not item_ids:
                        del emblems[texture]

        for texture in self._ignore_emblems:
            if texture in emblems:
                for item_id in emblems[texture]:
                    if item_id in emblemed_items:
                        del emblemed_items[item_id]

                del emblems[texture]

        return (painted_items, emblemed_items, emblems)

    def _update_data(self, additional_tickets = 0):
        item_id_to_item_type = {}
        show_items = defaultdict(lambda : [None, None])
        painted_items, emblemed_items, emblems = self._filter_items()
        tickets = defaultdict(int)
        for texture in emblems.keys():
            tickets[texture] += DyeConstant.COST_UPLOAD_EMBLEM[ItemsCatalog.EVENT_TICKET['TypeID']]

        for item_id, item_data in painted_items.items():
            citem = self._data_provider.get_item_by_id(item_id)
            item_type = ItemsUtils.get_item_type(citem)
            item_id_to_item_type[item_id] = item_type
            show_items[item_id][0] = item_data
            camo_id = item_data['camo_id']
            tickets[item_id] += DyeConstant.get_camo_tickets(item_type, camo_id)

        for item_id, item_data in emblemed_items.items():
            item = self._data_provider.get_item_by_id(item_id)
            item_type = ItemsUtils.get_item_type(item)
            item_id_to_item_type[item_id] = item_type
            show_items[item_id][1] = item_data
            tickets[item_id] += DyeConstant.get_emblem_tickets(item_type, item_data)

        self._tickets = sum(tickets.values()) + additional_tickets
        self._result.set_total_data(self._tickets)
        self._update_apply_button()
        back_comp = self.component.frame0.scrollback
        old_mode = back_comp.widthMode
        back_comp.widthMode = 'PIXEL'
        item_pixel_width = back_comp.width
        back_comp.widthMode = old_mode
        self._items = []
        for child, _ in self._scroll_comp.children:
            self._scroll_comp.delChild(child)

        y_position = 0
        for texture in emblems.keys():
            emblem_item = EmblemItem(item_pixel_width, texture, tickets.get(texture, 0))
            emblem_item.component.position[1] = y_position
            emblem_item.on_del_click = partial(self._on_emblem_del_click, texture)
            y_position += emblem_item.component.height
            self._items.append(emblem_item)

        for i, (item_id, data) in enumerate(show_items.items()):
            paint_item = PaintItem(item_pixel_width, item_id_to_item_type[item_id], data[0], data[1], tickets.get(item_id, 0))
            paint_item.component.position[1] = y_position
            paint_item.on_del_click = partial(self._on_paint_del_click, item_id)
            y_position += paint_item.component.height
            self._items.append(paint_item)

        old_mode = self._scroll_comp.heightMode
        self._scroll_comp.heightMode = 'PIXEL'
        self._scroll_comp.height = y_position
        self._scroll_comp.heightMode = old_mode
        for i, paint_item in enumerate(self._items):
            self._scroll_comp.addChild(paint_item.component, 'slot' + str(i))
            paint_item.component.widthMode, paint_item.component.heightMode = ('CLIP', 'CLIP')
            paint_item.component.verticalPositionMode = 'CLIP'

        self.do_reposition()

    def _update_apply_button(self):
        if self._available_tickets is None:
            self.component.frame2.confirm_button.script.text = u''
        elif self._available_tickets >= self._tickets:
            self.component.frame2.confirm_button.script.text = lc('PaintScreen.confirm.CONFIRM2')
        else:
            self.component.frame2.confirm_button.script.text = lc('PaintScreen.confirm.CONFIRM1')
        return

    def not_enough_resources(self, needed_consumables):
        self._shop_confirm.show(needed_consumables)

    def _on_emblem_del_click(self, texture):
        self._ignore_emblems.append(texture)
        self._update_data()

    def _on_paint_del_click(self, item_id):
        self._ignore_items.append(item_id)
        self._update_data()

    def hide(self):
        if not self._background.visible:
            return
        self._background.visible = False
        BWPersonality.unregister_key_event_interceptor(self.keyEvent)

    def handle_esc(self):
        if self._shop_confirm.component.visible:
            self._shop_confirm.hide()
        else:
            self.hide()

    @property
    def visible(self):
        return self._background.visible

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def keyEvent(self, event):
        key, down = event.key, event.isKeyDown()
        if BWPersonality.GUICore.storehouse_screen_visible:
            return False
        if key == Keys.KEY_ESCAPE and down:
            self.on_cancel()
            BWPersonality.unregister_key_event_interceptor(self.keyEvent)
            return True
        return False