    def _update_result(self):
        if self._available_tickets is None:
            self.component.result.visible = False
            self.component.label3.text = u''
        elif self._available_tickets >= self._total_tickets:
            self.component.result.visible = False
            self.component.label3.text = lc('PaintScreen.confirm.FINE')
        else:
            diff = self._total_tickets - self._available_tickets
            self.component.label3.text = lc('PaintScreen.confirm.BUY_MORE')
            self.component.result.text = lc('PaintScreen.confirm.AMOUNT').format(diff)
            self.component.result.visible = True
        return

    def set_total_data(self, total_tickets):
        self._total_tickets = total_tickets
        self.component.needed.text = lc('PaintScreen.confirm.AMOUNT').format(total_tickets)
        self._update_result()

    def set_available_data(self, available_tickets):
        self.component.label3.visible = True
        self.component.result.visible = True
        self._available_tickets = available_tickets
        self.component.available.text = lc('PaintScreen.confirm.AMOUNT').format(available_tickets)
        self._update_result()

    def do_reposition(self):
        for t in self._texts:
            t.component.verticalPositionMode = 'CLIP'
            t.do_reposition()


class PicItem:

    def __init__(self, pixel_width, tickets):
        self.on_del_click = lambda : None
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width = pixel_width
        comp.position = (0, 0, 0.5)
        self.component = comp
        comp = GUI.Simple('')
        comp.filterType = 'LINEAR'
        comp.materialFX = 'BLEND'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.heightMode = 'PIXEL'
        comp.verticalAnchor = 'TOP'
        comp.height = pixel_width * 0.16
        comp.position = (-0.9, pixel_width * 0.04, 0.5)
        comp.texture = self.get_icon_texture()
        self.component.addChild(comp, 'image')
        comp = GUI.Window()
        comp.materialFX = 'BLEND'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0.85, 0.4, 0.5)
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width = comp.height = pixel_width * 0.05
        self._del_button = PaintButton(comp, visual_state='soGUI/frame/storehouse/storeImageButton.xml')
        self._del_button.image = 'soGUI/frame/paint/checkcross.png'
        self._del_button.on_click = lambda : self.on_del_click()
        self.component.addChild(comp, 'delbutton')
        self.component.height = pixel_width * 0.24

        def height_generator(line_height):
            i = 0
            while True:
                yield line_height * (1 + i * 0.4)
                i += 1

        self._hg = height_generator(pixel_width * 0.08)
        self._texts = []
        self._setup_content(tickets)

    def do_reposition(self):
        comp = self.component.image
        comp.verticalPositionMode = 'CLIP'
        comp.heightMode = 'CLIP'
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.width = comp.height
        comp.heightMode = 'CLIP'
        self._del_button.component.widthMode, self._del_button.component.heightMode = ('CLIP', 'CLIP')
        self._del_button.do_reposition()
        for text in self._texts:
            text.do_reposition()

    def hide_dell_buttons(self):
        self.component.delbutton.visible = False

    def get_icon_texture(self):
        raise NotImplementedError

    def _setup_content(self, tickets):
        raise NotImplementedError

    def _append_line(self, left_text, right_text):
        position_y = self._hg.next()
        colour = (50, 50, 50, 255)
        if left_text:
            comp = GUI.Text(left_text)
            comp.colour = colour
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.position = (-0.5, position_y, 0.5)
            self._texts.append(TextScaler(comp, 'RobotoCondensedRegular_16_2'))
            self.component.addChild(comp)
            comp.verticalPositionMode = 'CLIP'
        if right_text:
            comp = GUI.Text(right_text)
            comp.colour = colour
            comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
            comp.position = (0.6, position_y, 0.5)
            self._texts.append(TextScaler(comp, 'RobotoCondensedRegular_16_2'))
            self.component.addChild(comp)
            comp.verticalPositionMode = 'CLIP'


class EmblemItem(PicItem):

    def __init__(self, pixel_width, texture, tickets):
        self._texture = texture
        PicItem.__init__(self, pixel_width, tickets)

    def get_icon_texture(self):
        return self._texture

    def _setup_content(self, tickets):
        self._append_line(lc('colourItemWindow.UPLOAD_EMBLEM'), None)
        if tickets:
            self._append_line(lc('PaintScreen.confirm.TICKETS_SHORT'), lc('PaintScreen.confirm.AMOUNT').format(tickets))
        return


class PaintItem(PicItem):
    left, right = (-0.9, 0.7)

    def __init__(self, pixel_width, item_type, paint_data, emblem_data, tickets):
        self._item_type = item_type
        self._paint_data = paint_data
        self._emblem_data = emblem_data
        PicItem.__init__(self, pixel_width, tickets)

    def get_icon_texture(self):
        icon_name = ItemsCatalog.GetItemParam(self._item_type)['IconName']
        return BWPersonality.GUICore.get_icon_from_cache(icon_name, load_anyway=True)

    def _setup_content(self, tickets):
        self._append_line(ItemsUtils.GetItemName(self._item_type), None)
        if self._emblem_data:
            self._append_line(lc('PaintScreen.confirm.EMBLEM_APPLY'), None)
        elif self._emblem_data == 0:
            self._append_line(lc('PaintScreen.confirm.EMBLEM_REMOVE'), None)
        if self._cammo_id:
            self._append_line(lc('PaintScreen.confirm.PAINT_APPLY'), lc('colourItemWindow.CAMMO_' + str(self._cammo_id)))
        elif self._cammo_id == 0:
            self._append_line(lc('PaintScreen.confirm.PAINT_REMOVE'), None)
        if tickets:
            self._append_line(lc('PaintScreen.confirm.TICKETS_SHORT'), lc('PaintScreen.confirm.AMOUNT').format(tickets))
        return

    @property
    def _cammo_id(self):
        if self._paint_data:
            return self._paint_data['camo_id']
        else:
            return None


