        comp.width = comp.height = 0.6
        comp.filterType = 'LINEAR'
        comp.visible = False
        self.component.addChild(comp, 'emblemed')

    def handleMouseEnterEvent(self, component):
        if self._tooltip_callback:
            BigWorld.cancelCallback(self._tooltip_callback)
        self._tooltip_callback = BigWorld.callback(0.5, self._tooltip_timer)
        self.on_tooltip_request(None)
        return False

    def _tooltip_timer(self):
        self._tooltip_callback = None
        self.on_tooltip_request(self)
        return

    def handleMouseLeaveEvent(self, component):
        if self._tooltip_callback:
            BigWorld.cancelCallback(self._tooltip_callback)
            self._tooltip_callback = None
        self.on_tooltip_request(None)
        return False

    def handleMouseButtonEvent(self, comp, event):
        if event.isKeyDown() and event.key == Keys.KEY_LEFTMOUSE:
            if self.active and self.selected:
                if self.on_item_click(False, self.parent_item or self.complex_item):
                    self.active = False
                self.selected = False
                self.on_item_selected(None)
            elif self.active and not self.selected:
                self.selected = True
                self.on_item_selected(self)
            elif not self.active and self.selected:
                raise RuntimeError
            elif not self.active and not self.selected:
                if self.on_item_click(True, self.parent_item or self.complex_item):
                    self.active = True
                    self.selected = True
                    self.on_item_selected(self)
            else:
                raise RuntimeError
        return True

    @property
    def active(self):
        return self.component.background.visible

    @active.setter
    def active(self, value):
        if self.active == value:
            return
        self.component.background.visible = value
        self.component.item.colour = (255, 255, 255, 255) if value else PaintItem.COLOR
        self.on_item_active(self, self.active)

    @property
    def selected(self):
        return self.component.select_background.visible

    @selected.setter
    def selected(self, value):
        if self.selected == value:
            return
        self.component.select_background.visible = value

    @property
    def painted(self):
        return self.component.painted.visible

    @painted.setter
    def painted(self, value):
        self.component.painted.visible = value

    @property
    def emblemed(self):
        return self.component.emblemed.visible

    @emblemed.setter
    def emblemed(self, value):
        self.component.emblemed.visible = value


class Tooltip:

    def __init__(self):
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (0, 0, 0)
        comp.width, comp.height = (200, 200)
        self.component = comp
        self.component.script = self
        self.component.visible = False
        comp = GUI.Frame2('soGUI/frame/tt_frame.dds')
        comp.materialFX = 'BLEND'
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.9)
        self.component.addChild(comp)
        txt = soTextField3(GUI.Window(), width=300, height=100, textWidth=-1, hScroll=False, vScroll=False, hideScroll=False, borderWidth=0, vOffset=0, hOffset=0, textureless=True, autosize=True)
        comp = txt.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.position = (11, 11, 0.2)
        self.component.addChild(comp, 'ttText')
        txt.onBound()

    def _create_entity_imitator(self, equipped_cond):
        if not equipped_cond:
            return None
        else:

            class EntityImitator:
                pass

            imitator = EntityImitator()
            imitator.ActiveItemID = 0
            imitator.ActiveWeaponSet2 = {}
            if equipped_cond:
                imitator.EquippedCond2 = equipped_cond
            return imitator

    def show(self, complex_item, equipped_cond):
        self.component.visible = True
        imitator = self._create_entity_imitator(equipped_cond)
        item_text = Inventory.GetItemString(complex_item, entity=imitator)
        self.component.ttText.script.setText(colorCodes.tf3_regular_text_color + item_text)
        self.component.ttText.script.renderText()
        self.component.width = self.component.ttText.width + 22
        self.component.height = self.component.ttText.height + 22

    def hide(self):
        self.component.visible = False


class PaintInventory(ScrollTable):
    """ \xd0\xa2\xd0\xb0\xd0\xb1\xd0\xbb\xd0\xb8\xd1\x86\xd0\xb0 \xd1\x81 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc\xd0\xb8 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x80\xd0\xb0\xd1\x81\xd0\xba\xd1\x80\xd0\xb0\xd1\x81\xd0\xba\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0\xd0\xbc\xd0\xb8
            \xd0\xb2\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c do_reposition \xd1\x80\xd1\x83\xd0\xba\xd0\xb0\xd0\xbc\xd0\xb8
    """

    def __init__(self, screen_component, component, rows):
        ScrollTable.__init__(self, component, False, 6, rows)
        self.selected = None
        self.on_item_click = lambda active, complex_item: False
        self.on_item_selected = lambda complex_item: None
        self._group_activation = False
        if hasattr(screen_component, 'inventory_tooltip'):
            self._tooltip = screen_component.inventory_tooltip.script
        else:
            self._tooltip = Tooltip()
            screen_component.addChild(self._tooltip.component, 'inventory_tooltip')
        return

    def create_item_component(self, item, index):
        paint_item = PaintItem(*item)
        paint_item.on_item_click = self.on_item_click
        paint_item.on_item_selected = self._on_item_selected
        paint_item.on_item_active = self._on_item_active
        paint_item.on_tooltip_request = self._on_tooltip_request
        return paint_item.component

    def _on_tooltip_request(self, data):
        if not data:
            self._tooltip.hide()
            return
        prev_mode = (data.component.widthMode, data.component.heightMode)
        data.component.widthMode, data.component.heightMode = ('CLIP', 'CLIP')
        screen_pos = data.component.localToScreen((0.5, -0.5))
        data.component.widthMode, data.component.heightMode = prev_mode
        position = self._tooltip.component.position
        position[0] = screen_pos.x
        position[1] = screen_pos.y
        self._tooltip.show(data.complex_item, self._equipped_cond)

    def remove_items(self, items):
        ids = [ item['complexItemID'] for item in items ]
        for paint_item in self.items:
            if paint_item.complex_item['complexItemID'] in ids:
                paint_item.active = False
                if paint_item.selected:
                    self._on_item_selected(None)
                    paint_item.selected = False

        return

    def set_params(self, modify_items, original_items, equipped_cond = None):
        modify_items_with_parts = []
        for item in modify_items:
            modify_items_with_parts.append((item, None))
            for subitem in item.get('itemList', []):
                modify_items_with_parts.append((ItemsUtils.ConvertSubItemToItem(subitem), item))

        ScrollTable.set_items(self, modify_items_with_parts)
        self._equipped_cond = equipped_cond
        self._painted_items = {}
        self._emblemed_items = {}
        self._original_items = original_items
        self._modify_items = modify_items
        return

    def activate_ids(self, item_ids):
        for item in filter(lambda it: it.complex_item['complexItemID'] in item_ids, self.items):
            item.active = True

    def _on_item_active(self, paint_item, active):
        if self._group_activation:
            return
        self._group_activation = True
        parent_item = paint_item.parent_item or paint_item.complex_item
        ids = [ item['itemID'] for item in parent_item.get('itemList', []) ]
        ids.append(parent_item['complexItemID'])
        for item_id in ids:
            p_item = next((p_item for p_item in self.items if p_item.complex_item['complexItemID'] == item_id))
            p_item.active = active

        self._group_activation = False

    def deselect(self):
        self._on_item_selected(None)
        return

    def select_any(self):
        if self.selected:
            return
        for paint_item in self.items:
            item_type = paint_item.complex_item['complexItemType']
            if ItemsUtils.can_be_painted(item_type):
                paint_item.active = True
                paint_item.selected = True
                self._on_item_selected(paint_item)
                return

    def _on_item_selected(self, paint_item):
        if self.selected == paint_item:
            return
        if self.selected:
            self.selected.selected = False
        self.selected = paint_item
        self.on_item_selected(self.selected)

    def has_changes(self):
        return bool(self._emblemed_items) or bool(self._painted_items)

    def on_item_painted(self, complex_item):
        item_id = complex_item['complexItemID']
        try:
            paint_item = next((item for item in self.items if item.complex_item is complex_item))
        except StopIteration:
            return

        modify_item = ItemsUtils.find_item_in_container(self._modify_items, item_id)[0]
        if ItemsUtils.is_sub_item(modify_item):
            modify_item['itemParametresKeys'] = PY(complex_item['complexItemParametresKeys'])
            modify_item['itemParametresValues'] = PY(complex_item['complexItemParametresValues'])
        original_item = ItemsUtils.find_item_in_container(self._original_items, item_id)[0]
        original_paint_data = ItemsUtils.getItemColorise(original_item)
        paint_data = ItemsUtils.getItemColorise(complex_item)
        if original_paint_data == paint_data:
            paint_item.painted = False
            if item_id in self._painted_items:
                del self._painted_items[item_id]
        else:
            paint_item.painted = True
            if not paint_data:
                paint_data = ([0] * 12, 0, 0)
            self._painted_items[item_id] = paint_data

    def on_item_emblemed(self, complex_item):
        if complex_item.has_key('fake_emblem'):
            return
        item_id = complex_item['complexItemID']
        try:
            paint_item = next((item for item in self.items if item.complex_item is complex_item))
        except StopIteration:
            return

        original_item = ItemsUtils.find_item_in_container(self._original_items, item_id)
        if original_item:
            original_paint_data = ItemsUtils.getItemEmblem(original_item[0])
            paint_data = ItemsUtils.getItemEmblem(complex_item)
            if original_paint_data == paint_data:
                paint_item.emblemed = False
                del item_id in self._emblemed_items and self._emblemed_items[item_id]
        else:
            paint_item.emblemed = True
            if not paint_data:
                paint_data = (0, 0)
            self._emblemed_items[item_id] = paint_data

    @property
    def painted_items(self):
        data = {}
        for item_id, paint_data in self._painted_items.items():
            data[item_id] = {'colors': paint_data[0],
             'camo_id': paint_data[1]}

        return data

    @property
    def emblemed_items(self):
        data = {}
        for item_id, emblem_data in self._emblemed_items.items():
            data[item_id] = emblem_data[0]

        return data

    def get_item_by_id(self, item_id):
        return next((item.complex_item for item in self.items if item.complex_item['complexItemID'] == item_id), None)

    def is_item_changed(self, item_id):
        return item_id in self._emblemed_items or item_id in self._painted_items or None