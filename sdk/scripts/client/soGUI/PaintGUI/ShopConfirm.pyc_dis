    def _on_shop_click(self):
        self.on_shop_click(self._fill_bin)

    def set_data(self, needed_consumables):
        frame_comp = self.component.content.frame
        self._fill_bin = needed_consumables
        self._needed_texts = []
        for child_name, child in frame_comp.children:
            if child_name == 'title':
                continue
            frame_comp.delChild(child)

        prev_mode = frame_comp.widthMode
        frame_comp.widthMode = 'PIXEL'
        pixel_line_height = frame_comp.width * 0.05
        frame_comp.widthMode = prev_mode
        y_position = pixel_line_height * 3
        for type_id, count in needed_consumables.items():
            if type_id == ItemsCatalog.EVENT_TICKET['TypeID']:
                self._add_need_ticket_text(frame_comp, y_position, pixel_line_height, count)
            else:
                raise RuntimeError('not supported consumable type: ' + str(type_id))

        self.do_reposition()

    def _add_need_substrate_text(self, frame_comp, y_position, pixel_line_height, amount):
        comp = GUI.Text(lc('PaintScreen.confirm.SUBSTRATE'))
        comp.colour = (0, 0, 0, 255)
        self._needed_texts.append(TextScaler(comp, 'RobotoCondensedRegular_18'))
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (-1, y_position, 0.5)
        comp.width, comp.height = 2, pixel_line_height
        frame_comp.addChild(comp)
        comp = GUI.Text(lc('PaintScreen.confirm.AMOUNT').format(amount))
        comp.colour = (0, 0, 0, 255)
        self._needed_texts.append(TextScaler(comp, 'RobotoCondensedRegular_18'))
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'CENTER')
        comp.position = (1, y_position, 0.5)
        comp.width, comp.height = 2, pixel_line_height
        frame_comp.addChild(comp)

