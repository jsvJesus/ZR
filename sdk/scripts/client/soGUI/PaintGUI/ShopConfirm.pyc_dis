    def do_reposition(self):
        for t in self._texts:
            t.do_reposition()

        for t in self._needed_texts:
            t.component.heightMode = 'CLIP'
            t.component.verticalPositionMode = 'CLIP'
            t.do_reposition()

        comp = self.component.content
        prev_mode = comp.wm
        comp.wm = 'PIXEL'
        width = comp.width
        comp.wm = prev_mode
        self._close_btn.do_reposition()
        self._close_btn.component.position = (width - 8, 8, 0.0)


class ShopConfirm:

    def __init__(self):
        self._setup_content()

    def _setup_content(self):
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.1)
        comp.materialFX = 'BLEND'
        comp.colour = (255,
         255,
         255,
         127.5)
        comp.width, comp.height = (2, 2)
        comp.visible = False
        Interceptor(comp)
        self.component = comp
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (1, 1)
        comp.position = (0, 0, 0.9)
        comp.materialFX = 'SOLID'
        comp.colour = (255, 250, 230, 255)
        self._frame = Frame(comp)
        self._frame.on_cancel_click = self.hide
        self._frame.on_shop_click = self._on_shop
        self.component.addChild(comp, 'frame')

    def show(self, needed_consumables):
        self._frame.set_data(needed_consumables)
        self.component.visible = True

    def _on_shop(self, fill_bin):
        self.hide()
        BWPersonality.GUICore.storehouse_screen.show_bin(fill_bin, spec_mode=ShopUtils.SHOP_MODE_PAINTMODIFICATION)

    def hide(self):
        self.component.visible = False

    def do_reposition(self):
        self._frame.do_reposition()