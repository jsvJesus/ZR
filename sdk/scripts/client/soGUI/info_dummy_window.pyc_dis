    Inside, Outside = range(2)


class EventType:
    OnFullClick, OnCloseClick = ((r, 'infodummy') for r in range(2))


common_config = {'scale_sencivity': 0.005,
 'min_dist': 1.2,
 'max_dist': 6.0,
 'start_dist': 2.0,
 'start_yaw': 3.14,
 'min_pitch': -1.0,
 'max_pitch': 1.0,
