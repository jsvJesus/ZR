class DummyWindow(Interceptor, Listenable):
    factoryString = 'InfoWindow.DummyWindow'

    def __init__(self, component):
        Listenable.__init__(self)
        Interceptor.__init__(self, component)
        self._config = common_config
        self._model_renderer = None
        self._model = None
        self._weapon = None
        self._item = None
        self._width, self._height = (0, 0)
        self.setupRoot()
        return

    def _update_info_text(self, screen_width, screen_height):
        if not self._item:
            return False
        description = ItemsUtils.GetItemDescription(self._item['complexItemType'])
        if not description:
            return False
        text = cc.active_xml + lc('Inventory.client.INFO_HELP0') + '\n\n'
        text += cc.inactive_xml + description
        info_width = min(screen_width / 3, 600)
        self._tf.width, self._tf.height = info_width, 1000
        self._tf.setTextWidth(info_width)
        self._tf.setText(text, immidiate=True)
        self._tf.recalc_auto_height()
        self._tf.component.position = (screen_width - 32, screen_height - 32, 0.05)
        return True

    def do_reposition(self, width, height, mode):
        if mode == DummyWinMode.Inside:
            self.component.btnclose.visible = False
            vsc = 'soGUI/elements/btn_full.xml'
            self._tf.component.visible = False
        elif mode == DummyWinMode.Outside:
            self.component.btnclose.visible = True
            vsc = 'soGUI/elements/btn_unfull.xml'
            self._tf.component.visible = self._update_info_text(width, height)
        self.component.btnfull.script.initVSC(vsc)
        width, height = int(width), int(height)
        if (self._width, self._height) == (width, height):
            return
        else:
            self._width, self._height = width, height
            restore_item = None
            if self.component.visible and self._item:
                restore_item = self._item
            if self._model_renderer:
                self._model_renderer.models = []
                self._model_renderer.dynamic = False
            self._model = None
            self.component.renderDummy.texture = None
            if self._weapon:
                self._weapon.clearCopyModel()
                self._weapon.destroyModels()
                self._weapon = None
            comp = self.component
            comp.width, comp.height = width, height
            comp = self.component.renderDummy
            comp.width, comp.height = width, height
            comp = self.component.btnfull
            pos = self.component.width - 8
            if mode == DummyWinMode.Outside:
                pos -= comp.width + 8
            comp.position[0] = pos
            self._help_comp.position[1] = height
            self.component.btnclose.script.transform.apply_mode()
            mr = BigWorld.PyModelRenderer(width, height)
            for _ in xrange(10):
                mr.delDirectionLight(0)
                mr.delOmniLight(0)

            dir1 = Math.Vector3((1, -1, 0))
            dir1.normalise()
            mr.addOmniLight((1.2, 1.2, 1.2, 1.5), (-0.2, 0.2, -5), 3, 18)
            mr.nearPlane = 0.01
            c = 0.6
            mr.addAmbientColor((c,
             c,
             c,
             c))
            self._model_renderer = mr
            self.updateView()
            if restore_item:
                self.show(restore_item)
            return

