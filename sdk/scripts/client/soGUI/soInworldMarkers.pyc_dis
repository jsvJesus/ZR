DEFAULT_CLAN_ICON = BigWorld.PyTextureProvider('soGUI/maps/Icons/clan_icon.dds')

class soInWorldIcon(PyGUIBase):
    factoryString = 'soGUI.soInWorldIcon'
    ICON_SIZE = 32

    def __init__(self, component, iconID = 0, matrix = Math.Matrix(), height = 0, size = 1):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.matrix = matrix
        self.height = height
        self.size = size
        self.iconID = iconID
        self.setupRoot()
        self.setupMark()
        if self.iconID:
            UCManager.ucmanager.loadImg(self.iconID, self.onLoadedIcon)
        else:
            self.onLoadedIcon(imgID=0, feedName='', textureProvider=DEFAULT_CLAN_ICON)

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.ICON_SIZE
        cmp.height = self.ICON_SIZE
        cmp.position = (0.0, 0.0, 1.5)
        cmp.textureName = ''
        cmp = GUI.Simple('')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = self.ICON_SIZE
        cmp.height = self.ICON_SIZE
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.5)
        cmp.texture = None
        cmp.visible = False
        self.component.addChild(cmp, 'icon')
        return

    def onLoadedIcon(self, imgID = 0, feedName = '', textureProvider = None):
        if not self.component:
            return
        else:
            if textureProvider:
                self.component.icon.texture = textureProvider
                self.component.icon.visible = True
                self.component.icon.width = int(self.ICON_SIZE * self.size)
                self.component.icon.height = int(self.ICON_SIZE * self.size)
            else:
                self.component.visible = False
                self.component.texture = None
                self.component.icon.width = int(self.ICON_SIZE * self.size)
                self.component.icon.height = int(self.ICON_SIZE * self.size)
            return

    def setData(self, iconID, matrix, height, size):
        self.size = size
        self.component.icon.width = int(self.ICON_SIZE * self.size)
        self.component.icon.height = int(self.ICON_SIZE * self.size)
        self.iconID = iconID
        if self.iconID:
            UCManager.ucmanager.loadImg(self.iconID, self.onLoadedIcon)
        else:
            self.onLoadedIcon(imgID=0, feedName='', textureProvider=DEFAULT_CLAN_ICON)
        if self.matrix != matrix or self.height != height:
            self.matrix = matrix
            self.height = height
            self.setupMatrix()

    def setupMark(self):
        self.clipMP = GUI.WorldToClipMP()
        shader = GUI.MatrixShader()
        shader.eta = 0
        shader.blend = True
        shader.target = self.clipMP
        self.component.addShader(shader, 'mover')
        self.setupMatrix()

    def setMatrix(self, matrix):
        self.clipMP.target = matrix

    def setupMatrix(self):
        self.setMatrix(ShiftProvider(self.matrix, (0, self.height, 0)))

    def fini(self):
        self.clearAllChildren(self.component)
        self.component.delShader('mover')
        self.component.script = None
        self.component = None
        self.clipMP = None
        return


