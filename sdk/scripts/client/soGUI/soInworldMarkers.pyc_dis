class soInworldMarker(PyGUIBase):
    factoryString = 'soGUI.soInworldMarker'
    MARKER_PLAYER = 0
    MARKER_ITEM = 1
    MARKER_NPC = 2
    MARKER_PK = 100
    MARKER_WARDECLARED = 101
    MARKER_WARRECIEVED = 102
    MARKER_USE = 200
    MARKER_PICKUP = 201
    MARKER_TALK = 202
    MARKER_TRADE = 203
    MARKER_WANTED = 204
    ICON_SIZE = 16
    FRAME_TEXTURE = BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/name_bg.dds')

    def __init__(self, mark_data):
        component = GUI.Window()
        PyGUIBase.__init__(self, component)
        component.script = self
        self.iconIDs = mark_data.get('icons', [])
        self.description = mark_data.get('text', u'')
        self._profession = mark_data.get('profession')
        self.matrix = mark_data.get('matrix', Math.Matrix())
        self.height = mark_data.get('height', 0)
        self.clanIconID = 0
        self.textLabels = []
        self.alpha = mark_data.get('alpha', 1.0) * 255.0
        self.colour = (255,
         255,
         255,
         self.alpha)
        self.setupRoot()
        self.setupMark()
        self.setupContent()
        self.setClanIconByID(mark_data.get('clanIcon'))

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255,
         255,
         255,
         self.alpha)
        cmp.materialFX = 'BLEND'
        cmp.width = 0
        cmp.height = 0
        cmp.position = (0.0, 0.0, 1.5)
        cmp.textureName = ''

    def setupMatrix(self):
        self.setMatrix(ShiftProvider(self.matrix, (0, self.height, 0)))

    def setPosition(self, pos):
        self.component.position = pos
        self.component.delShader('mover')

    def setupContent(self):
        cmp = GUI.Simple('')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.width = self.ICON_SIZE
        cmp.height = self.ICON_SIZE
        cmp.colour = (255,
         255,
         255,
         self.alpha)
        cmp.materialFX = 'BLEND'
        cmp.position = (1, 0, 0.5)
        cmp.texture = None
        cmp.visible = False
        self.component.addChild(cmp, 'clanIcon')
        self.setupIcons()
        self.setupMatrix()
        return

    def setupIcons(self):
        iconHolder = None
        if len(self.iconIDs) > 0:
            cmp = GUI.Window('')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'CENTER'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (255,
             255,
             255,
             self.alpha)
            cmp.materialFX = 'BLEND'
            cmp.width = 0
            cmp.height = 16
            cmp.position = (0.0, 1.0, 1.5)
            cmp.textureName = ''
            iconHolder = cmp
        for i, icon in enumerate(self.iconIDs):
            iconHolder.width += 16
            cmp = GUI.Simple('')
            cmp.texture = soInworldMarkers.ICON_MAP[icon]
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.width = cmp.texture.width
            cmp.height = cmp.texture.height
            cmp.colour = (255,
             255,
             255,
             self.alpha)
            cmp.materialFX = 'BLEND'
            cmp.position = (0 + i * 16, 0, 0.5)
            iconHolder.addChild(cmp, 'icon' + str(i))

        if iconHolder:
            self.component.width = iconHolder.width
            self.component.height = iconHolder.height
            self.component.addChild(iconHolder, 'iconHolder')
        self.setupCaption()
        return

    def setupCaption(self):
        add_w, add_h = (0, 0)
        if self._profession:
            cmp = GUI.Text(self._profession)
            cmp.horizontalPositionMode, cmp.verticalPositionMode = ('CLIP', 'CLIP')
            cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'TOP')
            cmp.font = 'RobotoCondensedRegular_16.font'
            cmp.colour = (155,
             123,
             78,
             self.alpha)
            cmp.position = (0, 1, 0.5)
            add_w, add_h = cmp.stringDimensions(self._profession)
            self.component.addChild(cmp, 'add_text')
        for label in self.textLabels:
            self.component.delChild(label)

        self.textLabels = []
        w, h, add_w, add_h = self.getTextDimentions()
        vis_str = self.description.split('\n')
        cmp = GUI.Window('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255,
         255,
         255,
         self.alpha)
        cmp.materialFX = 'BLEND'
        cmp.width = max(w, add_w) + 8
        cmp.height = h + add_h + 4
        cmp.position = (self.component.width // 2, self.component.height, 1.0)
        cmp.texture = self.FRAME_TEXTURE
        self.component.addChild(cmp, 'backFrame')
        self.fixPosition()
        for index, vis_part in enumerate(vis_str):
            cmp = GUI.Text('')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'CENTER'
            cmp.verticalAnchor = 'BOTTOM'
            cmp.font = 'RobotoCondensedRegular_16.font'
            cmp.colour = (255,
             255,
             255,
             self.alpha)
            if self.MARKER_WANTED in self.iconIDs:
                cmp.colour = (255,
                 150,
                 150,
                 self.alpha)
            cmp.colourFormatting = True
            cmp.multiline = True
            cmp.materialFX = 'BLEND'
            cmp.text = vis_part
            _X = self.component.width // 2
            _Y = self.component.height - 2 - (len(vis_str) - (index + 1)) * (h / len(vis_str))
            cmp.position = (_X, int(_Y), 0.5)
            self.textLabels.append(cmp)
            self.component.addChild(cmp, 'description{0}'.format(index))
            if self.component.clanIcon:
                self.component.clanIcon.position = self.textLabels[-1].position - (self.textLabels[-1].width / 2 - self.ICON_SIZE / 2, 0, 0)

        self.fixPosition()

    def getTextDimentions(self):
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colourFormatting = True
        cmp.multiline = True
        cmp.materialFX = 'BLEND'
        add_w, add_h = cmp.stringDimensions(self._profession or ' ')
        w, h = cmp.stringDimensions(self.description)
        return (w,
         h,
         add_w,
         add_h)

    def setupMark(self):
        self.clipMP = GUI.WorldToClipMP()
        shader = GUI.MatrixShader()
        shader.eta = 0
        shader.blend = True
        shader.target = self.clipMP
        self.component.addShader(shader, 'mover')

    def setMatrix(self, matrix):
        self.clipMP.target = matrix

    def fixPosition(self, isNoIcon = False):
        eps = 0
        if self.clanIconID != 0:
            isNoIcon = True
        icon_text_space = 6
        labels_count = len(self.textLabels)
        for index in xrange(0, labels_count):
            if index == labels_count - 1 and isNoIcon:
                eps = self.ICON_SIZE / 2 + icon_text_space
            _X = self.component.width / 2 + eps
            _Y = self.textLabels[index].position.y
            self.textLabels[index].position = (_X, _Y, 0.5)

        w, h, add_w, add_h = self.getTextDimentions()
        if self.clanIconID:
            w += self.ICON_SIZE
        if max(w, add_w) + 8 > self.component.width:
            self.component.width = max(w, add_w) + 8
        self.normal_width = max(w, add_w) + 8
        self.component.height = max(self.ICON_SIZE, add_h) + h + 4
        self.component.backFrame.height = self.component.height - add_h
        self.component.backFrame.width = max(w, add_w) + 8
        self.component.backFrame.position = (self.component.width / 2, self.component.height, 1.0)
        if self.clanIconID and self.textLabels:
            w, h = self.textLabels[-1].stringDimensions(self.textLabels[-1].text)
            self.component.clanIcon.position = self.textLabels[index].position - (w / 2 + icon_text_space, 2, 0)

    def setClanIconByID(self, iconID):
        if self.clanIconID == iconID:
            return
        self.clanIconID = iconID
        if iconID == 0:
            self.setClanIcon(0)
            return
        UCManager.ucmanager.loadImg(self.clanIconID, self.setClanIcon)

    def setClanIcon(self, imgID = 0, feedName = '', textureProvider = None):
        if not self.component:
            return
        else:
            if textureProvider:
                self.component.clanIcon.texture = textureProvider
                self.component.clanIcon.visible = True
                self.component.width = self.normal_width + self.component.clanIcon.width + 4
            else:
                self.component.clanIcon.visible = False
                self.component.clanIcon.texture = None
                self.component.width = self.normal_width
            self.fixPosition()
            return

    def setDescription(self, txt, profession):
        if self.description == txt and self._profession == profession:
            return
        self.description = txt
        self._profession = profession
        self.setupCaption()

    def setDistance(self, dist):
        self.component.position.z = dist

    def setAlpha(self, alph):
        if self.alpha == alph:
            return
        self.alpha = alph
        for i, child in self.component.children:
            col = child.colour
            child.colour = (col[0],
             col[1],
             col[2],
             self.alpha)

        if not hasattr(self.component, 'iconHolder'):
            return
        for i, child in self.component.iconHolder.children:
            col = child.colour
            child.colour = (col[0],
             col[1],
             col[2],
             self.alpha)

    def setData(self, mark_data):
        self.setAlpha(mark_data['alpha'] * 255)
        ids = mark_data['icons']
        if self.iconIDs != ids:
            self.iconIDs = ids
            self.setupIcons()
        self.setClanIconByID(mark_data['clanIcon'])
        self.setDescription(mark_data['text'], mark_data['profession'])
        matrix = mark_data['matrix']
        height = mark_data['height']
        if self.matrix != matrix or self.height != height:
            self.matrix = matrix
            self.height = height
            self.setupMatrix()

    def fini(self):
        self.clearAllChildren(self.component)
        self.component.delShader('mover')
        self.component.script = None
        self.component = None
        self.clipMP = None
        return


class TargetMark(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self

    def update(self, mark):
        cursor_mode = BWPersonality.game.cursor_mode
        if mark is not None:
            self.component.visible = not cursor_mode
            if self.component.visible:
                texture = soInworldMarkers.ICON_MAP[mark]
                self.component.texture = texture
                self.component.width = texture.width
                self.component.height = texture.height
                space = 2.0
                self.component.pivot = (-space / texture.width, -space / texture.height)
            shape = cursor_mode and mark is not None and BWPersonality.GUICore.entityPickerLayer.mouse_focus and soInworldMarkers.CURSOR_SHAPE[mark]
            MouseShaper.set_shape(shape, channel=1)
        else:
            MouseShaper.set_shape(None, channel=1)
        return


class soInworldMarkers(PyGUIBase):
    factoryString = 'soGUI.soInworldMarkers'
    MAX_DISTANCE = 50.0
    MIN_DISTANCE = 0.0
    ICON_MAP = {soInworldMarker.MARKER_PLAYER: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/player.dds'),
     soInworldMarker.MARKER_NPC: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/NPC.dds'),
     soInworldMarker.MARKER_ITEM: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/item.dds'),
     soInworldMarker.MARKER_USE: BigWorld.PyTextureProvider('soGUI/cursor/use.dds'),
     soInworldMarker.MARKER_PICKUP: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/pickUp.dds'),
     soInworldMarker.MARKER_TALK: BigWorld.PyTextureProvider('soGUI/cursor/talk.dds'),
     soInworldMarker.MARKER_PK: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/PK.dds'),
     soInworldMarker.MARKER_WARDECLARED: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/declare_war.dds'),
     soInworldMarker.MARKER_WARRECIEVED: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/recieve_war.dds'),
     soInworldMarker.MARKER_TRADE: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/trade.dds'),
     soInworldMarker.MARKER_WANTED: BigWorld.PyTextureProvider('soGUI/frame/inworld_markers/wanted.dds')}
    CURSOR_SHAPE = {soInworldMarker.MARKER_TALK: 'dialog',
     soInworldMarker.MARKER_USE: 'use'}

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.markers = {}
        self.custom_marks = {}
        self.icon_markers = {}
        self.setupRoot()
        self._setup_target_mark()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 2.0
        cmp.height = 2.0
        cmp.position = (0.0, 0.0, 1.1)
        cmp.visible = True
        BWPersonality.GUICore.worldLayer.addChild(cmp, 'inworldMarkers')

    def _setup_target_mark(self):
        comp = GUI.Simple('')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CUSTOM', 'CUSTOM')
        comp.pivot = (0, 0)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (0, 0, 0.1)
        comp.visible = False
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'target_mark')
        self._target_mark = TargetMark(comp)

    def update(self):
        marks_data, icons_data, target_data, custom_marks = BWPersonality.GUICore.inworldMarkersDataSection
        for _id, icon in self.icon_markers.items():
            if _id not in icons_data or _id in marks_data:
                if icon is None:
                    continue
                self.component.delChild(icon.component)
                icon.fini()
                del self.icon_markers[_id]

        for _id, marker in self.markers.items():
            if _id in marks_data:
                continue
            if marker is None:
                continue
            self.component.delChild(marker.component)
            marker.fini()
            del self.markers[_id]

        self._target_mark.update(target_data)
        for _id, cm in self.custom_marks.items():
            if _id not in custom_marks:
                self.custom_marks[_id].on_hide()
                self.component.delChild(cm.component)
                del self.custom_marks[_id]

        for _id, cm in custom_marks.items():
            if _id in self.custom_marks and self.custom_marks[_id] != cm:
                self.custom_marks[_id].on_hide()
                self.component.delChild(self.custom_marks[_id].component)
                del self.custom_marks[_id]
            if _id not in self.custom_marks:
                self.custom_marks[_id] = cm
                self.component.addChild(cm.component)
                cm.on_show()

        for _id, marker in marks_data.items():
            if _id in self.markers:
                self.markers[_id].setData(marker)
            else:
                markerObj = soInworldMarker(marker)
                markerObj.onBound()
                self.markers[_id] = markerObj
                cmp = markerObj.component
                self.component.addChild(cmp)

        for _id, _icon in icons_data.items():
            if _id in marks_data:
                continue
            if _id in self.icon_markers:
                self.icon_markers[_id].setData(_icon['icon'], _icon['matrix'], _icon['height'], _icon['size'])
            else:
                markerObj = soInWorldIcon(GUI.Window(), _icon['icon'], _icon['matrix'], _icon['height'], _icon['size'])
                markerObj.onBound()
                self.icon_markers[_id] = markerObj
                cmp = markerObj.component
                cmp.visible = True
                self.component.addChild(cmp)

        return

    def show(self):
        self.component.visible = True

    def hide(self):
        self.component.visible = False