class TxtToken(object):
    TOKENTYPE_TEXT = 0
    TOKENTYPE_PICTURE = 1
    TOKENTYPE_HLINK = 2
    TOKENTYPE_FONT = 3
    TOKENTYPE_COLOR = 4
    TOKENTYPE_NEWLINE = 5
    TOKENTYPE_PARAGRAPH = 6
    TOKENTYPE_DYNAMIC = 7
    TOKENTYPE_ALIGNMENT = 8
    TOKENTYPE_GRADE = 9

    def __init__(self, tokenType = TOKENTYPE_TEXT, occurrence = 0, data = None, raw = u''):
        self.tokenType = tokenType
        self.tokenData = data
        self.occurrence = occurrence
        self.rawData = raw


class SelectableLine:
    isSelected = False

    def __init__(self, component, parent, tooltip_text = None):
        self.component = component
        self.parent = parent
        self.tooltip_text = tooltip_text
        self.tooltipID = 'TextWithTooltip'
        if self.tooltip_text:
            component.crossFocus = True

    def handleMouseEvent(self, cmp, event):
        self.parent.onLinetMouseMove(cmp, event)
        return True

    def handleKeyEvent(self, cmp, event):
        return True

    def handleMouseButtonEvent(self, cmp, event):
        self.parent.onLinetMouseButton(cmp, event)
        return True

    def select(self):
        if self.isSelected:
            return
        self.isSelected = True
        self.saveColor = tuple(self.component.colour)
        self.component.colour = (100, 255, 255, 255)

    def deselect(self):
        if not self.isSelected:
            return
        self.component.colour = self.saveColor
        self.isSelected = False

    def handleMouseEnterEvent(self, comp):
        from soGUI.soToolTipComponent import soToolTipWindow
        BWPersonality.GUICore.showToolTip(colorCodes.tf3_regular_text_color + self.tooltip_text, style=soToolTipWindow.STYLE_FIXED_FROM_CURSOR, tooltipID=self.tooltipID, delay=0.1, delayStop=10)
        return True

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip(tooltipID=self.tooltipID)
        return True


