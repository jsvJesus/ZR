        self.component.addChild(self.perksWnd.component, 'perksWnd')

    def _switchToTab(self, tab):
        visMsk = [False,
         False,
         False,
         False,
         False,
         False]
        visMsk[tab] = True
        self.component.membersBtn.script.buttonActive = visMsk[self.MODE_MEMBERS]
        self.component.membersBtn.script._updateVisualState()
        self.component.rightsBtn.script.buttonActive = visMsk[self.MODE_RANKS]
        self.component.rightsBtn.script._updateVisualState()
        self.component.allianceBtn.script.buttonActive = visMsk[self.MODE_ALLIANCE]
        self.component.allianceBtn.script._updateVisualState()
        self.component.perksBtn.script.buttonActive = visMsk[self.MODE_PERKS]
        self.component.perksBtn.script._updateVisualState()
        self.component.infoBtn.script.buttonActive = visMsk[self.MODE_INFO]
        self.component.infoBtn.script._updateVisualState()
        self.update_button_locks()

    def switch_mebmers_mode(self):
        self.members_check_mode = not self.members_check_mode
        if self.members_check_mode:
            ratio = [0.3732, 0.3248, 0.3019]
            props = soTableCheckBoxPropsStructure(dataStyles=self.memberTable_dataDS, columns=3)
            self.component.membersWnd.members_change_btn.script.initVSC('soGUI/elements/close_eye.xml')
            if self.members_sort_index > 2:
                self.members_sort_index = 2
            if self.sortType[0] > 2:
                self.sortType = (2, self.sortType[1])
                self.members_sort_index = self.sortType[0]
        else:
            if self.sortType[0] == 2:
                self.sortType = (4, self.sortType[1])
                self.members_sort_index = self.sortType[0]
            ratio = [0.2646,
             0.2163,
             0.145,
             0.1807,
             0.1934]
            props = soTableElemPropsStructure(dataStyles=self.memberTable_dataDS, columns=5)
            self.component.membersWnd.members_change_btn.script.initVSC('soGUI/elements/openEye.xml')
        tbl = self.component.membersWnd.membersTable.script
        tbl.ratio = ratio
        tbl.element_props = props
        tbl.initElements()
        self._updateMemberTable()
        self.sortCaptionClick(self.members_sort_index, silence=True)
        self.component.membersWnd.inviteToClanBtn.visible = not self.members_check_mode
        self.component.membersWnd.btn_recr.visible = not self.members_check_mode
        self.component.membersWnd.uncheckallbtn.visible = self.members_check_mode
        self.component.membersWnd.checkallbtn.visible = self.members_check_mode

    def switchToMode(self, mode):
        self._switchToTab(mode)
        if self.currentMode == mode:
            return
        else:
            if self.currentMode == self.MODE_PERKS:
                self.perksWnd.hide()
                self.perksWnd.on_hide()
            self.currentMode = mode
            modeMask = [False,
             False,
             False,
             False,
             False,
             False]
            modeMask[mode] = True
            self._selected_clan_name = None
            self.membersWnd.visible = modeMask[self.MODE_MEMBERS]
            if self.currentMode == self.MODE_PERKS:
                self.perksWnd.show()
                self.perksWnd.on_show()
            elif self.currentMode == self.MODE_MEMBERS:
                p = BigWorld.player()
                can_recrs = p.checkClanRights(Clan.FLAG_CAN_RECRUT)
                self.component.membersWnd.btn_recr.script.setDisabledState(not can_recrs)
                if can_recrs:
                    self._recr_mark.visible = False
                    p.got_check_letter_result0 = self._got_check_letter_result
                    p.base.check_recr_letters0()
            return

    def _got_check_letter_result(self, result):
        self._recr_mark.visible = result

    def checkLock(self):
        is_have_clan = bool(BigWorld.player().clanID)
        self.component.lockScreen.visible = not is_have_clan
        self.component.lockLabel.visible = not is_have_clan
        self.component.membersBtn.visible = is_have_clan
        self.component.rightsBtn.visible = is_have_clan
        self.component.allianceBtn.visible = is_have_clan
        self.component.perksBtn.visible = is_have_clan
        self.component.infoBtn.visible = is_have_clan
        if not is_have_clan:
            self.hide_all_tabs()

    def update_button_locks(self):
        player = BigWorld.player()
        if not player or player.__class__.__name__ == 'Avatar':
            return
        if self.component.membersWnd.inviteToClanBtn:
            can_invite = not BigWorld.player().checkClanRights(Clan.FLAG_CAN_INVITE)
            self.component.membersWnd.inviteToClanBtn.script.setDisabledState(can_invite)
        self.rightsWnd.update_locks()
        self.infoWnd.update_locks()
        self.relativeWnd.update_locks()

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'clanScreen')
        self.component.visible = True
        self.update_button_locks()
        self.onInfoBtnClick()
        self._update_title()
        BWPersonality.GUICore.setBestCursor()
        self._updateMemberTable()
        self._updateInfoData()
        self.checkLock()
        if self.currentMode == self.MODE_PERKS:
            self.perksWnd.show()
            self.perksWnd.on_show()
        GUIPositions.show(self)
        return

    def hide(self):
        self.component.visible = False
        if self.component.membersWnd.inviteToClanBtn:
            self.component.membersWnd.inviteToClanBtn.script.setDisabledState(False)
        self.relativeWnd.hide_drop_downs()
        BWPersonality.GUICore.setBestCursor()
        if self.currentMode == self.MODE_PERKS:
            self.perksWnd.hide()
            self.perksWnd.on_hide()
        self._recr_list.hide()

    def _timeToString(self, secs):
        hours = floor(secs / 3600.0)
        minutes = floor((secs - hours * 3600.0) / 60.0)
        seconds = secs - (hours * 3600.0 + minutes * 60.0)
        outH = str(int(hours)) if hours > 9 else u'0' + str(int(hours))
        outM = str(int(minutes)) if minutes > 9 else u'0' + str(int(minutes))
        outS = str(int(seconds)) if seconds > 9 else u'0' + str(int(seconds))
        return u'' + outH + u':' + outM + u':' + outS

    def setMembers(self, data):
        tbl = self.component.membersWnd.membersTable.script
        checked_members = BigWorld.player().getClamMemberVisible()
        for mEntry in data:
            name = mEntry
            rank = data[mEntry][1]
            points_mounth = unicode(data[mEntry][2])
            points = unicode(data[mEntry][-2])
            status = data[mEntry][-1]
            self.membersData[name] = (name,
             rank,
             points_mounth,
             points,
             status)
            if self.members_check_mode:
                rowData = {'props': soTableCheckBoxPropsStructure(dataStyles=self.memberTable_dataDS, columns=3),
                 'data': [(name, name in checked_members), rank, status]}
            else:
                rowData = {'props': soTableElemPropsStructure(dataStyles=self.memberTable_dataDS, columns=5),
                 'data': [name,
                          rank,
                          points_mounth,
                          points,
                          status]}
            tbl.rewriteRow(rowData)

        self.update()

    def savedSetMembers(self, data):
        tbl = self.component.membersWnd.membersTable.script
        old_offset = tbl.offset
        self.setMembers(data)
        tbl.vScrollMoved(old_offset)

    def addMembers(self, data):
        rows = []
        tbl = self.component.membersWnd.membersTable.script
        visible_members = BigWorld.player().getClamMemberVisible()
        for mEntry in data:
            name = mEntry
            rank = data[mEntry][1]
            points_mounth = int(data[mEntry][2])
            points = int(data[mEntry][-2])
            status = self.getMemberStrStatus(data[mEntry][-1])
            visible = name in visible_members
            if self.members_check_mode:
                rowData = {'props': soTableCheckBoxPropsStructure(dataStyles=self.memberTable_dataDS, columns=3),
                 'data': [(name, visible), rank, status]}
            else:
                rowData = {'props': soTableElemPropsStructure(dataStyles=self.memberTable_dataDS, columns=5),
                 'data': [name,
                          rank,
                          points_mounth,
                          points,
                          status]}
            rows.append(rowData)

        if rows:
            tbl.addRows(rows)

    def showOnlyOnlineMembers(self):
        self._updateMemberTable()

    def delMembers(self, data):
        rows = []
        tbl = self.component.membersWnd.membersTable.script
        for mName in data:
            rows.append(mName)

        if rows:
            tbl.removeRows(rows)

    def onClickSort(self):
        self.sortCaptionClick(self.members_sort_index)

    def sortCaptionClick(self, col_indx, silence = False):
        rows = []
        self.members_sort_index = col_indx
        tbl = self.component.membersWnd.membersTable.script
        tbl.clearRowRange(1)

        def sortOfCaption(memb):
            sort_index = col_indx
            if sort_index == 2 and self.members_check_mode:
                sort_index = -1
            return memb[sort_index]

        cur_sort_column, cur_reverse = self.sortType
        if not silence:
            reverse = False
            if cur_sort_column == col_indx:
                reverse = not cur_reverse
            self.sortType = (col_indx, reverse)
        else:
            col_indx, reverse = self.sortType
        self.members.sort(key=sortOfCaption, reverse=reverse)
        if self.members_check_mode:
            caption_data = deepcopy(self.__check_members_caption)
            columns = 3
        else:
            caption_data = deepcopy(self.__default_members_caption)
            columns = 5
        caption_data[col_indx]['color'] = self.__selected_color
        caption_data[col_indx]['contentColor'] = self.__selected_color
        caption_data[col_indx]['contentColorHover'] = self.__selected_color
        caption_data[col_indx]['contentColorSelect'] = self.__selected_color
        dataStyles = [ deepcopy(self.memberTable_captionDS) for i in xrange(columns) ]
        dataStyles[col_indx]['color'] = self.__selected_color
        dataStyles[col_indx]['hoverColor'] = self.__selected_color
        dataStyles[col_indx]['selectColor'] = self.__selected_color
        dataStyles[col_indx]['contentColor'] = self.__selected_color
        dataStyles[col_indx]['contentColorHover'] = self.__selected_color
        dataStyles[col_indx]['contentColorSelect'] = self.__selected_color
        tbl.rewriteCaption({'props': soTableCaptionPropsStructure(dataStyles=dataStyles, columns=columns),
         'data': caption_data})
        visible_members = BigWorld.player().getClamMemberVisible()
        for member in self.members:
            points_mounth = unicode(member[2])
            points = unicode(member[-2])
            status = self.getMemberStrStatus(member[-1])
            if self.members_check_mode:
                visible = member[0] in visible_members
                data = [(member[0], visible), member[1], status]
                rowData = {'props': soTableCheckBoxPropsStructure(dataStyles=self.memberTable_dataDS, columns=columns),
                 'data': data}
            else:
                rowData = {'props': soTableElemPropsStructure(dataStyles=self.memberTable_dataDS, columns=columns),
                 'data': [member[0],
                          member[1],
                          points_mounth,
                          points,
                          status]}
            rows.append(rowData)

        tbl.addRows(rows)
        self.update_sort_btn_pos()

    def update_sort_btn_pos(self):
        column, revese = self.sortType
        initVSC = 'soGUI/elements/sale_arrow_down.xml' if revese else 'soGUI/elements/sale_arrow_up.xml'
        self.component.membersWnd.sort_caption_btn.script.initVSC(initVSC)
        self.component.membersWnd.sort_caption_btn.script.onBound()
        self.component.membersWnd.sort_caption_btn.script.setVisualState('normal')
        pos_x = self.component.membersWnd.membersTable.position.x
        self.component.membersWnd.sort_caption_btn.position.x = self.component.membersWnd.membersTable.script.get_label_row_position(0, column) + pos_x + 4

    def getDurationText(self, duration):
        ret = u''
        if duration:
            day = int(duration / 86400)
            if day > 0:
                return u' {0} '.format(day) + lc('Clans.Messages.DAYS')
                duration -= day * 86400
            hours = int(duration / 3600)
            if hours > 0:
                return u' {0} '.format(hours) + lc('Clans.Messages.HOURS')
                duration -= hours * 3600
            minutes = int(duration / 60)
            if minutes > 0:
                return u' {0} '.format(minutes) + lc('Clans.Messages.MINUTES')
                duration -= minutes * 60
            elif not ret:
                ret += u' ' + lc('Clans.Messages.LESS_THEN_MINUTE')
        else:
            ret += u' ' + lc('Clans.Messages.LESS_THEN_MINUTE')
        return ret

    def getMemberStrStatus(self, lastLogin):
        from time import time
        if lastLogin == 0:
            return {'text': lc('Clans.Interface.ONLINE'),
             'color': (0, 255, 0, 255)}
        else:
            return lc('Clans.Interface.LAST_TIME').format(self.getDurationText(int(time() - lastLogin)))

    def _update_table_silence(self):
        tbl = self.component.membersWnd.membersTable.script
        old_offset = tbl.offset
        self._updateMemberTable()
        tbl.vScrollMoved(old_offset)

    def _updateMemberTable(self):
        if self.__updateMemberTimerID:
            BigWorld.cancelCallback(self.__updateMemberTimerID)
            self.__updateMemberTimerID = None
        player = BigWorld.player()
        if not player:
            return
        elif not hasattr(player, 'name'):
            return
        else:
            only_online = False
            if self.component.membersWnd.cbShowOnlyOnline and self.component.membersWnd.cbShowOnlyOnline.script.isChecked():
                only_online = True
            if BWPersonality.GUICore.clanDataSection.has_key('members'):
                self.membersData = deepcopy(BWPersonality.GUICore.clanDataSection['members'])
            self.members = []
            for member in self.membersData:
                status = self.membersData[member][-1]
                if only_online and status != 0:
                    continue
                name = member
                rank = self.membersData[member][1]
                points_mounth = int(self.membersData[member][2])
                points = int(self.membersData[member][-2])
                self.members.append((name,
                 rank,
                 points_mounth,
                 points,
                 status))
                if member == player.name:
                    self.my_rank = rank
                    self.my_points = int(self.membersData[member][2])
                    self.my_points_all = int(self.membersData[member][-2])

            self.sortCaptionClick(self.members_sort_index, silence=True)
            if self.component.membersWnd.membersTable.visible:
                self.__updateMemberTimerID = BigWorld.callback(self.UPDATE_TIME, self._update_table_silence)
            self._updateInfoData()
            return

    def set_my_rank(self, value):
        self.my_rank = value

    def _updateInfoData(self):
        player = BigWorld.player()
        if not player:
            return
        max_members = ClanSettings.get_max_players(player.clan_level)
        clanpoints_month = 0
        if player.clanRoster.has_key('members'):
            for member in player.clanRoster['members'].values():
                clanpoints_month += int(member[2])

        data = {'name': self.get_clan_name(),
         'emblem': player.clanEmblemID,
         'motto': player.clan_motto.decode('utf-8'),
         'message': player.clan_message.decode('utf-8'),
         'count': '{0}/{1}'.format(len(player.clanRoster['members']), max_members) if player.clanRoster.has_key('members') else '0/0',
         'rank': self.my_rank,
         'my_clan_points': int(self.my_points),
         'level': player.clan_level,
         'clanpoints': player.clanpoints,
         'clanpoints_month': clanpoints_month,
         'list_bases': 'List'}
        self.infoWnd.set_data_info(data)

    def get_clan_name(self):
        p = BigWorld.player()
        clan_name = p.clanName.decode('utf-8')
        return clan_name

    def _update_title(self):
        if self.component.wndFrame.nameLabel:
            self.component.wndFrame.nameLabel.text = lc('PlayerAvatarForSoClanScreen.client.CLAN_NAME_CAPTION') + BWPersonality.get_action_key('ToggleClanGUI')

    def update(self):
        self._update_title()
        self.update_button_locks()
        self.checkLock()
        self._updateInfoData()
        if self.component.rightsWnd.visible:
            self.rightsWnd.update()
        if self.relativeWnd.component.visible:
            self.relativeWnd.update()
        if BWPersonality.GUICore.clanDataSection is None:
            return
        else:
            self._updateMemberTable()
            return

    @PyGUIEvent('membersBtn', 'onClick')
    def onMembersClick(self):
        self.switchToMode(self.MODE_MEMBERS)
        self.hide_all_tabs()
        self.membersWnd.visible = True

    def onAllianceBtnClick(self):
        self.switchToMode(self.MODE_ALLIANCE)
        self.hide_all_tabs()
        self.relativeWnd.show()

    def onPerksBtnClick(self):
        self.hide_all_tabs()
        self.switchToMode(self.MODE_PERKS)
        self.perksWnd.show()

    def onInfoBtnClick(self):
        self._updateInfoData()
        self.switchToMode(self.MODE_INFO)
        self.hide_all_tabs()
        self.infoWnd.show()
        BigWorld.player().base.get_clan_bases_list()

    def hide_all_tabs(self):
        self.membersWnd.visible = False
        self.relativeWnd.hide()
        self.infoWnd.hide()
        self.rightsWnd.hide()
        self.perksWnd.hide()
        self._recr_list.hide()

    def setDataPremissions(self, data):
        self.rightsWnd.setDataPremissions(data)

    def onRightsBtnClick(self):
        self.switchToMode(self.MODE_RANKS)
        self.hide_all_tabs()
        self.rightsWnd.show()

    @PyGUIEvent('membersWnd.membersTable', 'onElementEvent')
    def onMembersElem(self, col, row, event, data):
        if row == 0:
            self.sortCaptionClick(col)
            return
        if event == 'RIGHTMOUSE':
            playerName = data['name']
            BWPersonality.GUICore.clanMemberActionsRequest(playerName)
        elif event == 'LEFTMOUSE':
            pass
        elif event == 'SELECT_LIST':
            pass
        elif event == 'CHECK':
            BigWorld.player().setClanMemberVisible(data['name'], data['value'])

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    def set_bases(self, clan_bases):
        self.infoWnd.set_bases(clan_bases)

    def set_donat_bases(self, clan_bases):
        self.infoWnd.set_donat_bases(clan_bases)

    def set_aggression(self, war_list):
        self.relativeWnd.set_aggression(war_list)

    def handleMouseEvent(self, component, event):
        return False

    def startDragging(self):
        DraggableComponent.startDragging(self)
        self.relativeWnd.hide_drop_downs()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def onInviteClanClick(self):

        def onClanIntive(text):
            BigWorld.player().inviteFriendToClan(text.encode('utf-8'))

        gui_jokes.inputBox(lc('GUI.ClanGUI.INVITE_TO_CLAN_CAPTION'), lc('GUI.ClanGUI.INVITE_TO_CLAN_TEXT'), onClanIntive, active=True)

    def stopDragging(self):
