        GUIPositions.stopDragging(self)

    def on_select_all(self):
        tbl = self.component.membersWnd.membersTable.script
        tbl.select_all_checkboxes()

    def on_deselect_all(self):
        tbl = self.component.membersWnd.membersTable.script
        tbl.deselect_all_checkboxes()

    def _on_recruit_click(self):
        p = BigWorld.player()
        if p.clanID and p.checkClanRights(Clan.FLAG_CAN_RECRUT):
            self._recr_list.show()
        else:
            gui_jokes.askUserOk(u'', lc('GUI.ClanGUI.RECRUITING.Norights'))

    def reset_position(self):
        """ \xd1\x81\xd0\xb1\xd1\x80\xd0\xb0\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd """
        self.component.position = (0.0, 0.0, 0.1)