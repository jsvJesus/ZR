        return None

    @FlashTeamWorker.exchanging_method
    def validate_input(self, data):
        validator = self.validators[data['id']]
        if validator:
            result = validator(data['newchar'], data['text'], data['offset'])
        else:
            result = True
        data = {'name': data['id'],
         'result': result}
        return data

    @FlashTeamWorker.exchanging_method
    def localized_resource(self, paths):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x89\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd1\x8b \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5 json."""
        return super(MessageBoxFlash, self).localized_resource(paths)

    @FlashTeamWorker.receiving_method
    def onInputFocus(self, now_input):
        self.now_input = now_input

    @FlashTeamWorker.receiving_method
    def showError(self, text):
        print text

    @FlashTeamWorker.receiving_method
    def on_click_btn(self, name, btn, event, input = False, input_text = ''):
        callback = self.callbacks[name]
        call_data = {'btn': btn}
        if input:
            call_data['add_controls'] = {}
            call_data['add_controls']['edit_box'] = input_text
        callback(event, call_data)
        if self.callbacks.get(name, False):
            del self.callbacks[name]
        if self.validators.get(name, False):
            del self.validators[name]
        if self.msg_boxes.get(name, False):
            del self.msg_boxes[name]
        self.check_msg_boxes()