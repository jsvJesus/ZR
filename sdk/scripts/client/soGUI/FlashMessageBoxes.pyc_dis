         'lock': isModal,
         'input': False,
         'buttons': [BTN_OK, BTN_CANCEL]}
        self.show_message(data)

    def check_msg_boxes(self):
        if not len(self.msg_boxes):
            self.is_showed = False
            self.hide()
        else:
            self.show()
        BWPersonality.GUICore.setBestCursor()

    @FlashTeamWorker.sending_method
    def show_message(self, data):
        self.msg_boxes[data['name']] = True
        self.check_msg_boxes()
        return data

    def hide_message(self, msg_id):
        if not self.msg_boxes.has_key(msg_id):
            return
        self.send_hide_message(msg_id)

    @FlashTeamWorker.sending_method
    def send_hide_message(self, msg_id):
        """\xd1\x81\xd0\xba\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbd\xd0\xba\xd1\x80\xd0\xb5\xd1\x82\xd0\xbd\xd0\xbe\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb5\xd1\x88\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5"""
        self.on_click_btn(msg_id, BTN_CANCEL, None)
        return msg_id

    @FlashTeamWorker.sending_method
