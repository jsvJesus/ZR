        self.validators[id] = input_validator
        data = {'name': str(id),
         'title': title,
         'text': subtitle,
         'lock': isModal,
         'input': True,
         'buttons': [BTN_OK, BTN_CANCEL],
         'default': default,
         'active': active}
        self.show_message(data)

    def messageBox(self, id = 'msgBox.default', title = u'', subtitle = u'', callback = lambda event, data: True, isModal = False):
        self.callbacks[id] = callback
        flash_data = {'name': str(id),
         'title': title,
         'text': subtitle,
         'lock': isModal,
         'input': False,
         'buttons': [BTN_OK]}
        self.show_message(flash_data)

    def ask_yes_no(self, id = 'yes_no_box.default', title = u'', subtitle = u'', callback = lambda event, data: True, isModal = False):
