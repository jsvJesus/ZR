        self.btn_ok.setVisualState('normal')
        self.btn_ok.onClick = self.hide
        return

    def get_main_text(self):
        text = u''
        if self.data['credits']:
            text += u'{0} {1}\n'.format(self.data['credits'], lc('GUI.QuestItems.RUBLES'))
        if self.data['exp']:
            text += u'{0} {1}\n'.format(self.data['exp0'], lc('GUI.QuestItems.OTHER_EXP'))
        rep = self.data['reputation']
        if rep:
            text += u'\n'
            for key, value in rep.items():
                fraction_name = lc(Fractions.FractionNames[key])
                text += u'{0} {1}\n'.format(fraction_name, value)

        return text

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'questrewardWindow' + str(self.child_id))
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        return

    def merge_dict(self, dict1, dict2):
        """ \xd1\x81\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb8 dic1 \xd0\xb8 dict2 \xd1\x81\xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb8\xd1\x8f \xd0\xb8\xd1\x85 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f """
        for key, value in dict2.items():
            if key not in dict1 or not dict1[key]:
                dict1[key] = value
                continue
            if isinstance(value, dict):
                self.merge_dict(dict1[key], value)
                continue
            dict1[key] += value

    def append_reward(self, reward):
        self.merge_dict(self.data, reward)
        self.update()

    def update(self):
        self.main_text.text = self.get_main_text()
        text_height = self.main_text.stringDimensions(self.main_text.text)[1]
        if self.main_text.text:
            self.text_frame.visible = True
            self.item_view.position[0] = self.item_view_position
        else:
            self.text_frame.visible = False
            self.item_view.position[0] = 1
        if self.data['items']:
            self.item_view.visible = True
            items_count = len(self.data['items'])
            min_rows_count = math.ceil(text_height / 64.0)
            rows_default = max(4, min_rows_count)
            cols_count = int(min(3, math.ceil(float(items_count) / rows_default)))
            rows_count = int(max(min_rows_count, int(math.ceil(float(items_count) / cols_count))))
            self.item_view.script.change_size(cols_count, rows_count)
            items = []
            for item_type, item_count in self.data['items'].items():
                items.append({'complexItemType': item_type,
                 'amount': item_count})

            self.item_view.script.setItems(items)
            self.component.width = self.item_view.position[0] + self.item_view.width + 2
        else:
            self.item_view.visible = False
            self.component.width = self.text_frame.width + 10
        frame_height = max(self.item_view.height, text_height)
        self.component.height = frame_height + self.item_view.position[1] + 38
        self.text_frame.height = frame_height
        self.component.wndFrame.width = self.component.width
        self.component.wndFrame.height = self.component.height
        self.btn_ok.component.position[0] = self.component.width * 0.5 - self.btn_ok.component.width * 0.5
        self.btn_ok.component.position[1] = self.component.height - 33
        self.close_btn.position[0] = self.component.width - 8

    def clear_data(self):
        for key in self.data:
            self.data[key] = None

        return

    def hide(self):
        self.component.visible = False
        self.manager.win_hidden(self)
        BWPersonality.GUICore.setBestCursor()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)