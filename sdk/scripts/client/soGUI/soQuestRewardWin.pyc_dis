class QuestItemSlot(BarterPaySlot):

    def _added_item_text(self, data):
        return ' x {0}'.format(data['amount'])


class soQuestRewardWin(PyGUIBase, DraggableComponent):

    def __init__(self, component, manager, child_id):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        component.script = self
        self.manager = manager
        self.setupRoot()
        self.setupContent()
        self.child_id = child_id
        params = ['credits',
         'exp',
         'reputation',
         'items']
        self.data = dict.fromkeys(params, None)
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 800
        cmp.height = 400
        cmp.position = (0.0, 0.0, 0.1)
        cmp.textureName = ''
        cmp.visible = False
        cmp.filterType = 'POINT'
        cmp.pixelSnap = False
        cmp.dragFocus = True
        self.component.mouseButtonFocus = 1

    def setupContent(self):
        cmp = GUI.Frame2('soGUI/frame/basic_frame_1.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.component.width
        cmp.height = self.component.height
        cmp.position = (0, 0, 1.0)
        self.component.addChild(cmp, 'wndFrame')
        parent = self.component.wndFrame
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/elements/closeBox.xml')
        self.close_btn = btn.component
        self.close_btn.horizontalPositionMode = self.close_btn.verticalPositionMode = 'PIXEL'
        self.close_btn.widthMode = self.close_btn.heightMode = 'PIXEL'
        self.close_btn.horizontalAnchor = 'RIGHT'
        self.close_btn.verticalAnchor = 'TOP'
        self.close_btn.colour = (255, 255, 255, 255)
        self.close_btn.materialFX = 'BLEND'
        self.close_btn.width = 18
        self.close_btn.height = 18
        self.close_btn.position = (parent.position[0] + 30, 6, 0.2)
        btn.onClick = self.hide
        self.component.wndFrame.addChild(self.close_btn, 'closeBox')
        btn.onBound()
        btn._updateVisualState()
        parent = self.component.wndFrame
        self.text_frame = GUI.Frame2('soGUI/frame/con_frame_2.dds')
        self.text_frame.horizontalPositionMode = self.text_frame.verticalPositionMode = 'PIXEL'
        self.text_frame.widthMode = self.text_frame.heightMode = 'PIXEL'
        self.text_frame.horizontalAnchor = 'LEFT'
        self.text_frame.verticalAnchor = 'TOP'
        self.text_frame.colour = (255, 255, 255, 255)
        self.text_frame.materialFX = 'BLEND'
        self.text_frame.width = 200
        self.text_frame.height = parent.height - 70
        self.text_frame.position = (6, 32, 1.0)
        self.component.wndFrame.addChild(self.text_frame, 'textFrame')
        self.main_text = GUI.Text('')
        parent = self.component.wndFrame.textFrame
        self.main_text.horizontalPositionMode = self.main_text.verticalPositionMode = 'PIXEL'
        self.main_text.horizontalAnchor = 'LEFT'
        self.main_text.multiline = True
        self.main_text.width = 50
        self.main_text.verticalAnchor = 'TOP'
        self.main_text.font = 'ruRU_Cyrvetica_Extra_16i.font'
        self.main_text.colour = (175, 166, 112, 255)
        self.main_text.materialFX = 'BLEND'
        self.main_text.position = (parent.position[0] + 6, parent.position[1] + 6, 0.3)
        parent.addChild(self.main_text, 'descLabel')
        itemView = soItemView(GUI.Window(), QuestItemSlot, rowWidth=3, cols=3, rows=3, vScroll=True, hScroll=False, borderWidth=0)
        self.item_view_position = self.text_frame.position[0] + self.text_frame.width + 2
        self.item_view = itemView.component
        self.item_view.horizontalPositionMode = self.item_view.verticalPositionMode = 'PIXEL'
        self.item_view.horizontalAnchor = 'LEFT'
        self.item_view.verticalAnchor = 'TOP'
        self.item_view.position = (self.item_view_position, self.text_frame.position[1], 0.5)
        self.item_view.colour = (255, 255, 255, 255)
        self.item_view.materialFX = 'BLEND'
        self.component.wndFrame.addChild(self.item_view, 'itemView')
        itemView.onBound()
        itemView.setRestrictingComponent(None)
        itemView.setItems(None)
