# Embedded file name: ./client/soGUI/SubsWindow.py
import BigWorld
import BWPersonality
import GUI
import soGUI
from soGUI.soTextField import soTextField3
from Helpers.PyGUI.PyGUIBase import PyGUIBase
instance = None

class SubsWindow(PyGUIBase):
    """Subtitles for NPC"""
    factoryString = 'soGUI.SubsWindow'

    def __init__(self, component):
        raise instance is None or AssertionError
        PyGUIBase.__init__(self, component)
        component.script = self
        self.setupRoot()
        self.setupContent()
        self.component.textureName = 'soGUI/black.dds'
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255, 255, 255, 100)
        cmp.position = (0, -0.9, 1)
        cmp.materialFX = 'BLEND'

    def setupContent(self):
        width, height = BigWorld.screenSize()
        width *= 0.5
        height *= 0.5
        tf = soTextField3(GUI.Window(), width=width, height=height, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=0, autosize=1)
        cmp = tf.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.position = (0, 0, 0)
        self.component.addChild(cmp, 'tf')
        tf.onBound()
        tf.setText(u'')

    def show(self):
        if self.component.parent is None:
            subWinLayer = getattr(BWPersonality.GUICore, 'subWinLayer', None)
            if not subWinLayer:
                layer = soGUI.soGUILayer(GUI.Window())
                cmp = layer.component
                cmp.position.z = 0.0
                cmp.visible = True
                cmp.dropFocus = False
                GUI.addRoot(cmp)
                BWPersonality.GUICore.subWinLayer = cmp
            BWPersonality.GUICore.subWinLayer.addChild(self.component, 'subWin')
        self.component.visible = True
        return

    def hide(self):
        self._hide_subs_cid = 0
        self.component.visible = False
        BWPersonality.GUICore.subWinLayer.delChild('subWin')

    _hide_subs_cid = None

    def output_subs(self, text, duration):
        if self._hide_subs_cid:
            BigWorld.cancelCallback(self._hide_subs_cid)
        self._hide_subs_cid = BigWorld.callback(duration, self.hide)
        double_border_w = 24
        self.component.tf.script.setText('<font=RobotoCondensedRegular_20.font>' + text, immidiate=True)
        self.component.width = self.component.tf.width + double_border_w
        self.component.height = self.component.tf.height + double_border_w
        self.onBound()
        self.show()
        return self._hide_subs_cid

    def hide_subtitles(self, hide_subs_cid):
        if self._hide_subs_cid != hide_subs_cid:
            return
        if self._hide_subs_cid:
            BigWorld.cancelCallback(self._hide_subs_cid)
            self.hide()


instance = SubsWindow(GUI.Window())