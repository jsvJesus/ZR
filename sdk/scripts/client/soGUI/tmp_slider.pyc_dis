        self.width = cmp.width = 500
        self.height = cmp.height = 150
        if not self.pos:
            self.pos = (sW / 2.0, sH / 2, 0.0)
        cmp.position = self.pos
        closeBox = soButton(GUI.Window())
        cmp = closeBox.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.component.width - 5, 5, 0.3)
        closeBox.initVSC('soGUI/elements/closeBox.xml')
        closeBox.onBound()
        closeBox.onClick = self.hide
        closeBox.setVisualState('normal')
        self.component.addChild(cmp, 'closeBox')
        cmp = GUI.Frame2('soGUI/frame/basic_frame_no_footer.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp, 'dFrame')
        cmp = GUI.Text(self.name)
        cmp.font = 'ruRU_calibri_small.font'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'CENTER'
        cmp.horizontalAnchor = 'LEFT'
        cmp.colour = (175, 166, 112, 200)
        cmp.position = (50, 15, 0.0)
        self.component.addChild(cmp, 'caption')

    def setupContent(self):
        cmp = GUI.Text('255,255,255')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'CENTER'
        cmp.horizontalAnchor = 'LEFT'
        cmp.colour = (175, 166, 112, 200)
        cmp.position = (120, self.height - 25, 0.0)
        cmp.multiline = 1
        self.component.addChild(cmp, 'txt')
        hScrollHeight = self.width - 10
        self._bars = []
        for i, name in enumerate(('Y', 'P', 'R')):
            scroll = soScrollBar2(GUI.Window(), width=20, height=hScrollHeight, steps=0, horizontal=True)
            comp = scroll.component
            self._bars.append(comp)
            comp.horizontalAnchor = 'LEFT'
            comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
            comp.position = (5, 50 + i * 20, 0)
            scroll.onBound()
            self.component.addChild(comp, 'hScrollR_%s' % name)
            scroll.setSteps(200)
            scroll.scrollLeft = lambda i = i, comp = comp: self.scrollHandler('LEFT', None, i=i, comp=comp)
            scroll.scrollRight = lambda i = i, comp = comp: self.scrollHandler('RIGHT', None, i=i, comp=comp)
            scroll.scrollMoved = lambda val, i = i, comp = comp: self.scrollHandler('hMOVE', val, i=i, comp=comp)
            self.scrollHandler('hMOVE', 50, i=i, comp=comp)

    def scrollHandler(self, event, data, i = 1000, comp = None):
        if event == 'RIGHT':
            self.cursor[i] += 1
        elif event == 'LEFT':
            self.cursor[i] -= 1
        elif event == 'hMOVE':
            self.cursor[i] = data
        comp.script.setValue(self.cursor[i])
        step = math.pi / 100
        vector = map(lambda x: (x - 100) * step, self.cursor)
        t = 'Y : %.2f    ' % vector[0]
        t += 'P : %.2f    ' % vector[1]
        t += 'R : %.2f    ' % vector[2]
        t += '\n'
        t += '          %s    ' % int(math.degrees(vector[0]))
        t += '          %s    ' % int(math.degrees(vector[1]))
        t += '          %s    ' % int(math.degrees(vector[2]))
        self.component.txt.text = t
        try:
            self.callback(Math.Vector3(vector))
        except:
            traceback.print_exc()

    def callback(self, value):
        pass

    def handleMouseEvent(self, cmp, event):
        return False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def show(self):
        self.component.visible = 1
        BWPersonality.GUICore.worldLayer.delChild(self.name)
        BWPersonality.GUICore.worldLayer.addChild(self.component, self.name)
        step = math.pi / 100
        for i, angle in enumerate(self.vector):
            data = 100 + round(angle / step)
            self.scrollHandler('hMOVE', int(data), i=i, comp=self._bars[i])

    def hide(self):
        self.component.visible = False