DraggableComponent = Helpers.PyGUI.DraggableComponent.DraggableComponent

def clamp_val(val, min_val, max_val):
    return min(max_val, max(val, min_val))


class TmpSlider(PyGUIBase, DraggableComponent):
    factoryString = 'soGUI.TmpSlider'

    def __init__(self, component, name = 'TmpSlider', pos = None, value = 0.0, min_value = 0.0, max_value = 1.0):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, 1, 1, 0)
        component.script = self
        self.pos = pos
        self.name = name
        self._min_value = min_value
        self._max_value = max_value
        self._value = clamp_val(value, self._min_value, self._max_value)
        self.cursor = 0
        self.setupRoot()
        self.setupContent()
        self.component.visible = False

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        sW, sH = BigWorld.screenSize()
        self.width = cmp.width = 500
        self.height = cmp.height = 70
        if not self.pos:
            self.pos = (self.width + 5, sH - self.height - 5, 0.0)
        cmp.position = self.pos
        closeBox = soButton(GUI.Window())
        cmp = closeBox.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.component.width - 5, 5, 0.3)
        closeBox.initVSC('soGUI/elements/closeBox.xml')
        closeBox.onBound()
        closeBox.onClick = self.hide
        closeBox.setVisualState('normal')
        self.component.addChild(cmp, 'closeBox')
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (0, 0, 0, 250)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp, 'dFrame')
        cmp = GUI.Text(self.name)
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'CENTER'
        cmp.horizontalAnchor = 'LEFT'
        cmp.colour = (175, 166, 112, 200)
        cmp.position = (70, 15, 0.0)
        self.component.addChild(cmp, 'caption')

    def setupContent(self):
        cmp = GUI.Text('255,255,255')
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'CENTER'
        cmp.horizontalAnchor = 'LEFT'
        cmp.colour = (175, 166, 112, 200)
        cmp.position = (10, 15, 0.0)
        cmp.multiline = 1
        self.component.addChild(cmp, 'txt')
        hScrollHeight = self.width - 10
        scroll = soScrollBar2(GUI.Window(), width=20, height=hScrollHeight, steps=0, horizontal=True)
        comp = scroll.component
        comp.horizontalAnchor = 'LEFT'
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.position = (5, 50, 0)
        scroll.onBound()
        self.component.addChild(comp, 'hScroll')
        scroll.setSteps(self.SCR_STEPS)
        scroll.scrollLeft = lambda comp = comp: self.scrollHandler('LEFT', None, comp=comp)
        scroll.scrollRight = lambda comp = comp: self.scrollHandler('RIGHT', None, comp=comp)
        scroll.scrollMoved = lambda val, comp = comp: self.scrollHandler('hMOVE', val, comp=comp)
        self._scroll = scroll

    SCR_STEPS = 200

    def scrollHandler(self, event, data, i = 1000, comp = None):
        if event == 'RIGHT':
            self.cursor += 1
        elif event == 'LEFT':
            self.cursor -= 1
        elif event == 'hMOVE':
            self.cursor = data
        step = (self._max_value - self._min_value) / self.SCR_STEPS
        value = self._min_value + self.cursor * step
        self._value = clamp_val(value, self._min_value, self._max_value)
        comp.script.setValue(self.cursor)
        t = '%.2f    ' % self._value
        self.component.txt.text = t
        try:
            self.callback(self._value)
        except:
            traceback.print_exc()

    def callback(self, value):
        pass

    def handleMouseEvent(self, cmp, event):
        return False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def show(self):
        self.component.visible = 1
        BWPersonality.GUICore.worldLayer.delChild(self.name)
        BWPersonality.GUICore.worldLayer.addChild(self.component, self.name)
        step = (self._max_value - self._min_value) / self.SCR_STEPS
        cursor = (self._value - self._min_value) / step
        self.scrollHandler('hMOVE', cursor, comp=self._scroll.component)

    def hide(self):
        self.component.visible = False


class TmpSlider_x3(PyGUIBase, DraggableComponent):
    factoryString = 'soGUI.TmpSlider_x3'

    def __init__(self, component, name = 'TmpSlider_x3', pos = None, vector = None):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, 1, 1, 0)
        component.script = self
        self.pos = pos
        self.name = name
        self.vector = Vector3(0, 0, 0)
        if vector:
            self.vector = Vector3(vector)
        self.cursor = Vector3(10, 0, 0)
        self.setupRoot()
        self.setupContent()
        self.component.visible = False

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
