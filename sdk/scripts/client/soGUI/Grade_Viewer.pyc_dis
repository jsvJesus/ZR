    def set_weapon(self, item):
        if item and ItemsCatalog.GetItemClass(item['complexItemType']) != ItemsCatalog.WEAPON:
            return
        self.weapon = item
        self.update_params()

    def update_params(self):
        if self.weapon is None:
            for key in xrange(grades_utils.PARAM_COUNT):
                self.grade_controls[key].clear()

        else:
            item_params = ItemsCatalog.GetItemParam(self.weapon['complexItemType'])
            inc_params = ItemsUtils.GetComplexItemInconstanParams(self.weapon, BigWorld.player())
            weapon_grades = inc_params.get(ItemsCatalog.INC_WEAPON_GRADES, 0)
            init_grade = inc_params.get(ItemsCatalog.INC_WEAPON_INIT_GRADES, 0)
            grades_data = item_params.get('Grade_data', {})
            for key in xrange(grades_utils.PARAM_COUNT):
                grade_type = grades_utils.get_grage_type(key)
                if not grades_data.get(key):
                    tmp = grades_utils.default_data[key]
                    tmp = copy.deepcopy(tmp)
                    item_condition = key == grades_utils.CONDITION and ItemsUtils.GetItemCondition(BigWorld.player(), self.weapon, inc_params, item_params)
                    current_max_condition = ItemsUtils.GetItemMaxConditionWithRepairs(BigWorld.player(), self.weapon, inc_params, item_params)
                    full_max_condition = grades_utils.get_current_param('MaxCondition', self.weapon, BigWorld.player())
                    item_max_condition = item_params.get('MaxCondition', 99999.0)
                    max_value = round(current_max_condition / float(item_max_condition) * ItemsCatalog.PERCENT_MODIFYER, 1)
                    full_max_value = round(full_max_condition / float(item_max_condition) * ItemsCatalog.PERCENT_MODIFYER, 1)
                    tmp['max_value'] = 100.0
                    tmp['count'] = 200
                    tmp['id'] = key
                    tmp['value'] = max_value
                    tmp['value_index'] = int(round((tmp['value'] - tmp['min_value']) / ((float(tmp['max_value']) - tmp['min_value']) / float(tmp['count']))))
                    current_value = round(item_condition / float(item_max_condition) * ItemsCatalog.PERCENT_MODIFYER, 1)
                    current_value = min(current_value, full_max_value)
                    value_index = int(round((current_value - tmp['min_value']) / ((float(tmp['max_value']) - tmp['min_value']) / float(tmp['count']))))
                    tmp['value_index'] = value_index
                    full_max_value_index = round((full_max_value - tmp['min_value']) / ((float(tmp['max_value']) - tmp['min_value']) / float(tmp['count'])), 1)
                    self.grade_controls[key].kostil_value = full_max_value_index
                    self.grade_controls[key].kostil_value_cond = current_value
                else:
                    if grade_type == grades_utils.GRADE_TYPES.VALUE:
                        tmp['value'] = item_params.get(grades_utils.get_weapon_grade_name(key))
                        tmp['value_index'] = int(round((tmp['value'] - tmp['min_value']) / ((float(tmp['max_value']) - tmp['min_value']) / float(tmp['count']))))
                    tmp['id'] = key
                    value_index = grades_utils.get_inc_param(key, weapon_grades) if 1 << key & init_grade else tmp['value_index']
                self.grade_controls[key].set_default_value(tmp)
                self.grade_controls[key].set_value_index(value_index)

        return


class Grade_widget(PyGUIBase):

    def __init__(self, component, width, height):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.width = width
        self.height = height
        self.data = {}
        self.default_data = {}
        self.value = 0
        self.value_index = 0
        self.kostil_value = 0
        self.kostil_value_cond = 0
        self.component.focus = True
        self.component.moveFocus = True
        self.component.crossFocus = True
        self.component.mouseButtonFocus = True
        self.component.moveFocus = True
        self.setup_root()
        self.setup_UI()

    def setup_root(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = self.height
        cmp.width = self.width
        cmp.visible = True
        cmp.textureName = ''

    def setup_UI(self):
        cmp = GUI.Text()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.colour = (174, 174, 174, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 4, 0.5)
        cmp.text = u''
        self.component.addChild(cmp, 'name')
        cmp = GUI.Text()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'RobotoCondensedRegular_14.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (180, 4, 0.5)
        cmp.text = u'0'
        self.component.addChild(cmp, 'value')
        gs = Grade_slider(GUI.Window(), 360, 12)
        cmp = gs.component
        cmp.position = (186, 3, 0.1)
        self.component.addChild(cmp, 'slider')
        self.component.slider.script.set_segments([0, 0, 0], 100)
        comp = GUI.Simple('soGUI/frame/grades/Baseline.dds')
        comp.materialFX = 'BLEND'
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'CENTER'
        comp.verticalAnchor = 'TOP'
        comp.width = 3
        comp.height = 14
        comp.position = (186, 3, 0.01)
        comp.visible = 0
        self.component.addChild(comp, 'baseline')

    def get_value(self):
        return self.value

    def clear(self):
        self.value_index = 0
        self.value = 0
        self.component.name.text = u''
        self.component.slider.script.set_segments([0, 0, 0], 100)
        self.component.slider.script.set_default_value(0)
        self.component.slider.script.set_value(0)
        self.component.value.text = ''

    def set_value(self, data):
        self.data = data
        self.update_text_val()

    def set_default_value(self, data):
        self.default_data = data
        self.clear()
        self.component.name.text = grades_utils.get_param_local(self.default_data['id'])
        min_value = self.default_data['min_value']
        max_value = self.default_data['max_value']
        if grades_utils.GRADE_TYPES.VALUE == grades_utils.get_grage_type(self.default_data['id']):
            self.value = self.default_data['value']
            self.default_data['value_index'] = int(round((self.value - min_value) / ((max_value - min_value) / float(self.default_data['count']))))
            self.value_index = self.default_data['value_index']
        else:
            self.value_index = self.default_data['value_index']
            self.default_data['value'] = min_value + (max_value - min_value) / float(self.default_data['count']) * self.value_index
            self.value = self.default_data['value']
        self.update_text_val()
        self.component.slider.script.set_segments(self.default_data['params'], self.default_data['count'])
        self.component.slider.script.set_default_value(self.default_data['value_index'])
        self.component.slider.script.set_value(self.default_data['value_index'])

    def update_text_val(self):
        change_val = self.value_index - self.default_data['value_index']
        if self.value_index == self.default_data['value_index'] and self.default_data['id'] != grades_utils.CONDITION:
            self.component.value.text = ''
            return
        if self.default_data['id'] == grades_utils.CONDITION:
            percent = self.kostil_value_cond
        else:
            percent = round(change_val / float(self.default_data['count']) * 100, 1)

        def cut_zeros(t):
            if t.endswith('.0'):
                return cut_zeros(t[:-2])
            if '.' in t and t.endswith('0'):
                return cut_zeros(t[:-1])
            return t

        text = cut_zeros(str(percent))
        self.component.value.text = text + '%'
        colour = GRADE_CLIENT_COLORS2[0] if self.value_index - self.default_data['value_index'] > 0 else GRADE_CLIENT_COLORS2[1]
        if self.default_data['id'] == grades_utils.CONDITION:
            colour = (255, 255, 255, 255)
        self.component.value.colour = colour

    def set_value_index(self, value_index):
        """
                \xd1\x82\xd1\x83\xd1\x82 \xd1\x83\xd0\xb6\xd0\xb5 \xd0\xba\xd0\xbe\xd0\xbd\xd0\xba\xd1\x80\xd0\xb5\xd1\x82\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd1\x80\xd1\x83\xd0\xb6\xd0\xb8\xd1\x8f \xd1\x81 \xd1\x83\xd1\x87\xd1\x91\xd1\x82\xd0\xbe\xd0\xbc \xd0\xb3\xd1\x80\xd0\xb5\xd0\xb9\xd0\xb4\xd0\xb0
        """
        if value_index < 0:
            return
        self.value_index = value_index
        self.component.slider.script.set_value(self.value_index)
        self.component.baseline.visible = bool(self.kostil_value)
        if self.kostil_value:
            self.component.baseline.position.x = 186 + self.kostil_value * 360.0 / self.default_data['count']
        self.update_text_val()

    def get_value_index(self):
        return int(self.value_index)

    def handleMouseEnterEvent(self, comp):
        import BWPersonality
        if not self.default_data:
            return True
        if self.default_data['id'] == grades_utils.CONDITION:
            BWPersonality.GUICore.showToolTip(colorCodes.tf3_regular_text_color + lc('soGrades.gui.condition_hint'))
        return True

    def handleMouseLeaveEvent(self, comp):
        import BWPersonality
        if not self.default_data:
            return True
        if self.default_data['id'] == grades_utils.CONDITION:
            BWPersonality.GUICore.hideToolTip()
        return True


class Grade_slider(PyGUIBase):

    def __init__(self, component, width, height):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.width = width
        self.height = height
        self.count = 100.0
        self.segments = []
        self.segment_controls = []
        self.value = 0
        self.def_value = 0
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.component.moveFocus = True
        self.setup_root()

    def setup_root(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = self.height
        cmp.width = self.width
        cmp.visible = True
        cmp.textureName = ''

    def setup_segments(self):
        for i in self.segment_controls:
            self.component.delChild(i)

        x = 0
        self.segment_controls = []
        tmp = 0

        def create_comp():
            comp = GUI.Simple('textures/default/white.dds')
            comp.materialFX = 'BLEND'
            comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
            comp.widthMode = comp.heightMode = 'PIXEL'
            comp.horizontalAnchor = 'LEFT'
            comp.verticalAnchor = 'TOP'
            comp.tiled = True
            comp.tileWidth = self.get_width_one()
            return comp

        cmp = create_comp()
        cmp.colour = GRADE_CLIENT_COLORS[0]
        cmp.width = self.def_value * self.get_width_one()
        cmp.height = self.height - 4
        cmp.position = (x, 4, 0.4)
        self.component.addChild(cmp, 'segment_{0}'.format(0))
        x += cmp.width
        tmp += cmp.width
        self.segment_controls.append(cmp)
        width = self.width - x
        cmp = create_comp()
        cmp.colour = GRADE_CLIENT_COLORS[-1]
        cmp.width = width
        cmp.height = self.height - 4
        cmp.position = (x, 4, 0.4)
        self.component.addChild(cmp, 'segment_{0}'.format(1))
        self.segment_controls.append(cmp)
        tmp += width
        diff = self.value - self.def_value
        if diff != 0:
            cmp = create_comp()
            cmp.colour = GRADE_CLIENT_COLORS2[0] if diff > 0 else GRADE_CLIENT_COLORS2[1]
            cmp.width = diff * self.get_width_one()
            cmp.height = self.height - 4
            cmp.position = (x, 4, 0.3)
            self.component.addChild(cmp, 'segment_{0}'.format(2))
            self.segment_controls.append(cmp)

    def get_width_one(self):
        return self.width / self.count

    def set_segments(self, value, count):
        self.segments = value
        self.count = float(count)
        self.setup_segments()

    def set_default_value(self, value):
        self.def_value = value

    def set_value(self, value):
        self.value = max(0, min(self.count, value))
        self.setup_segments()