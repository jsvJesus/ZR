# Embedded file name: ./client/soGUI/ClanCardGui.py
import GUI
import BigWorld
import UCManager
import BWPersonality
from Localization import lc
from soGUI.soButton import soButton
from soGUI.soTextField import soTextField3
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from Helpers.PyGUI.DraggableComponent import DraggableComponent

class ClanCardGui(PyGUIBase, DraggableComponent):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, 1, 1, 1, xoffset=0, yoffset=0)
        component.script = self
        self.has_motto = False
        self.setupRoot()
        self.setupContent()
        self.createLabels()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 460
        cmp.height = 220
        cmp.position = (0, 0, 0.001)
        cmp.textureName = ''
        cmp.visible = False
        cmp.filterType = 'POINT'
        cmp.pixelSnap = False
        cmp.dragFocus = True
        cmp.crossFocus = True
        cmp = GUI.Frame2('soGUI/frame/con_frame_for_options.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 2
        cmp.height = 2
        cmp.position = (0, 0, 2)
        self.component.addChild(cmp, 'background')

    def setupContent(self):
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/elements/closeBox.xml')
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.component.width - 8, 8, 0.2)
        self.component.addChild(cmp, 'closeBox')
        btn.onBound()
        btn._updateVisualState()
        btn.onClick = self.hide
        cmp = GUI.Text(lc('GUI.ClanInfo.card_title'))
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 5, 0.2)
        self.component.addChild(cmp, 'title')
        cmp = GUI.Simple('')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.width = 128
        cmp.height = 128
        cmp.colour = (255, 255, 255, 120)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.5)
        cmp.texture = None
        cmp.visible = False
        self.component.addChild(cmp, 'clan_icon')
        return

    def createLabels(self):
        cmp = GUI.Text(lc('GUI.ClanInfo.name'))
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (146, 146, 146, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (14, 42, 0.2)
        self.component.addChild(cmp, 'clan_name')
        cmp = GUI.Text(lc('GUI.ClanInfo.motto'))
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.colour = (146, 146, 146, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (14, 68, 0.2)
        self.component.addChild(cmp, 'clan_motto')
        for i, key in enumerate(['clan_level',
         'clan_info_points',
         'clan_info_points_month',
         'clan_rating']):
            cmp = GUI.Text(lc('GUI.ClanInfo.{0}'.format(key)))
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.verticalAnchor = 'TOP'
            cmp.horizontalAnchor = 'LEFT'
            cmp.font = 'RobotoCondensedRegular_16.font'
            cmp.colour = (146, 146, 146, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (14, 144 + i * 26, 0.2)
            self.component.addChild(cmp, key)

        tf = soTextField3(GUI.Window(), 432, 55, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        cmp = tf.component
        cmp.horizontalPositionMode, cmp.verticalPositionMode = ('CLIP', 'PIXEL')
        cmp.horizontalAnchor, cmp.verticalAnchor = ('CENTER', 'TOP')
        cmp.widthMode, cmp.heightMode = ('PIXEL', 'PIXEL')
        cmp.colour = (220, 220, 220, 255)
        cmp.position = (0, 184, 0.3)
        cmp.width, cmp.height = (460, 55)
        cmp.focus = False
        cmp.moveFocus = False
        cmp.position = (0, 42 + 52, 0.2)
        self.component.addChild(cmp, 'clan_motto_value')
        for i in ['clan_name',
         'clan_level',
         'clan_info_points',
         'clan_info_points_month',
         'clan_rating']:
            label = getattr(self.component, i, None)
            w, h = label.stringDimensions(label.text)
            cmp = GUI.Text()
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.verticalAnchor = 'TOP'
            cmp.horizontalAnchor = 'LEFT'
            cmp.font = 'RobotoCondensedRegular_16.font'
            cmp.colour = (220, 220, 220, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (label.position.x + w + 2, label.position.y, 0.2)
            self.component.addChild(cmp, i + '_value')

        return

    def show(self, data):
        self.has_motto = False
        for i in data.keys():
            if i == 'emblemID':
                self.loadClanIcon(data['emblemID'])
                continue
            if i == 'motto':
                self.has_motto = bool(data[i].strip())
                text = u'<font=RobotoCondensedRegular_16.font><alignment=center>' + data[i].decode('utf-8')
                self.component.clan_motto_value.script.setText(text)
                continue
            if i == 'clanpoints':
                label = getattr(self.component, 'clan_info_points_value', None)
            elif i == 'clanpoints_month':
                label = getattr(self.component, 'clan_info_points_month_value', None)
            else:
                label = getattr(self.component, 'clan_{0}_value'.format(i), None)
            label.text = str(data[i]) if isinstance(data[i], int) else data[i].decode('utf-8')

        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'clanCard')
        self.component.visible = True
        self.update_positions()
        return

    def _drawIcon(self, imgID, feedName = '', texture = None):
        component = self.component.clan_icon
        if imgID and texture:
            component.visible = True
            component.texture = texture
        else:
            component.visible = False
            component.texture = None
        return

    def loadClanIcon(self, iconID):
        pl = BigWorld.player()
        if pl:
            if iconID != 0:
                UCManager.ucmanager.loadImg(iconID, self._drawIcon)
            else:
                self._drawIcon(0)

    def hide(self):
        self.component.visible = False

    def update_positions(self):
        offset = 0
        if self.has_motto:
            offset = 50
        for i, key in enumerate(['clan_level',
         'clan_info_points',
         'clan_info_points_month',
         'clan_rating']):
            label = getattr(self.component, key)
            cmp = getattr(self.component, key + '_value')
            cmp.position.y = 94 + i * 26 + offset
            label.position.y = 94 + i * 26 + offset

        self.component.height = 196 + offset

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True