            cmp.verticalAnchor = 'CENTER'
            cmp.position = (90, y, 0.5)
            ddMode.onSelectedElement = self._onSelectedMode
            self.win_cmp.addChild(cmp, 'ddMode')
            _data = [ (i, s) for i, s in enumerate(PVP_MODE_LIST) ]
            ddMode.addElements(_data)
            ddMode.setSelectionByValue(0)
