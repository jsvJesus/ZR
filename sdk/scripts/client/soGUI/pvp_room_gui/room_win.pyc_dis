        self.win_cmp = cmp
        comp = GUI.Frame2('soGUI/frame/con_frame_for_options.dds')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'CLIP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.materialFX = 'SOLID'
        comp.width = w
        comp.height = h
        comp.position = (0, 0, 0.9)
        self.win_cmp.addChild(comp, 'frame2')
        cmp = GUI.Text(lc('soFlashPVP.room_win.create_room_title'), 'RobotoCondensedRegular_16.font')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = cc.active_rgba
        cmp.materialFX = 'BLEND'
        cmp.position = (w / 2, 10, 0.5)
        self.win_cmp.addChild(cmp, 'label_name')

        def to_clear_error(func0, *args, **kw):
            self.win_cmp.labelError.text = u''
            return func0(*args, **kw)

        def roomNameSection(y):
            cmp = GUI.Text(lc('soFlashPVP.room_win.room_name'), 'RobotoCondensedRegular_16.font')
