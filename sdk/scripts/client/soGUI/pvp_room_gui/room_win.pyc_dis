PVP_MODE_LIST = []
PVP_SPACE_LIST = []

def parse_pvp_config():
    import csconstans
    import pvp_inst_config
    mode_ids = [csconstans.GAMEPLAY_DM,
     csconstans.GAMEPLAY_TEAM_DM,
     csconstans.GAMEPLAY_FLAG,
     csconstans.GAMEPLAY_BUTTON_MODE,
     csconstans.GAMEPLAY_FREE_MODE]
    for mode_id in mode_ids:
        mode_config = pvp_inst_config.configs[mode_id]
        title = lc(mode_config['title'])
        spaces = [ lc(t[1]) for t in mode_config['geometrylist'] ]
        PVP_MODE_LIST.append(title)
        PVP_SPACE_LIST.append(spaces)


parse_pvp_config()

class PVPRoomWin(Interceptor):
    factoryString = 'soGUI.PVPRoomWin'

    def __init__(self):
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        Interceptor.__init__(self, comp, interscept_keys=True)
        self.setupRoot()
        self.setupContent()
        self.init_words_filter()

    def init_words_filter(self):
        bad_words_path = 'scripts/client/data/Chat/badwords.txt'
        text = ResMgr.openSection(bad_words_path).asBinary
        text = text.replace('\r', '')
        words = text.split('\n')
        comment_patt = re.compile(u'-.*?-', re.MULTILINE | re.UNICODE)
        self._words_filter = words_filter.WordsFilter(words, u'*', comment_patt=comment_patt)

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.width = cmp.height = 3
        cmp.colour = (0, 0, 0, 0)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.0)

    def setupContent(self):
        w = 328
        h = 250
        cmp = GUI.Window('soGUI/frame/paint/white.dds')
