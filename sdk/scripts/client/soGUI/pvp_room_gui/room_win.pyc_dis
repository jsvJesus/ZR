        cmp.materialFX = 'BLEND'
        cmp.width = 130
        cmp.height = 30
        cmp.position = (0, 200, 0.5)
        cmp.script.onClick = self._onBtnCreateRoom
        self.win_cmp.addChild(cmp, 'button_ok')
        btn.onBound()
        closeBox = soButton(GUI.Window())
        cmp = closeBox.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (w - 6, 6, 0.3)
        closeBox.onClick = self.hide
        closeBox.initVSC('soGUI/elements/closeBox.xml')
        closeBox.onBound()
        closeBox.setVisualState('normal')
        self.win_cmp.addChild(cmp, 'closeBox')

    def _onBtnCreateRoom(self):
        roomName = self.editName.getValue()[0]
        pvpConfID = self.ddMode.getSelection()[1] + 1
        spaceIndex = self.ddSpace.getSelection()[1]
        passHash = zlib.crc32(self.editPass.getValue()[0].encode('utf-8', 'ignore')) & 65535
        if not roomName:
            self.editName.runErrorNotify()
            return
        replaced = self._words_filter.replace_bad_words(roomName)
        if replaced != roomName:
            self.editName.runErrorNotify()
            return
        player = BigWorld.player()
        player.base.createPrivateRoom(roomName, pvpConfID, spaceIndex, passHash)

    def _onSelectedMode(self, mode_index):
        self.ddSpace.clear()
        _data = [ (i, s) for i, s in enumerate(PVP_SPACE_LIST[mode_index]) ]
        self.ddSpace.addElements(_data)
        self.ddSpace.setSelectionByValue(0)

    def show(self):
        self.component.visible = True
        self.component.focus = True
        self.component.dragFocus = True
        self.component.dropFocus = True
        self.component.crossFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True

    def hide(self):
        self.component.visible = False
        self.component.focus = False
        self.component.dragFocus = False
        self.component.dropFocus = False
        self.component.crossFocus = False
        self.component.moveFocus = False
        self.component.mouseButtonFocus = False
        self.ddMode.showList(False)
        self.ddSpace.showList(False)
        self.editName.on_hide()
        self.editPass.on_hide()

    def show_error(self, text):
        self.win_cmp.labelError.text = text