            self.win_cmp.addChild(comp, 'labelError')

        roomNameSection(50)
        roomSpaceSection(110)
        roomModeSection(80)
        roomPassSection(140)
        errorLabelSection(220)
        btn = soButton(GUI.Window())
        cmp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        cmp.horizontalPositionMode, cmp.verticalPositionMode = ('CLIP', 'PIXEL')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
