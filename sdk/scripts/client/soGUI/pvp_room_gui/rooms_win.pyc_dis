    def setupPageNav(self):
        sW, sH = BigWorld.screenSize()
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 32)
        comp.position = (0, 0, 0.5)
        self._page_nav_block = PageNavBlock(comp)
        self._page_nav_block.add_listener(self._on_page_event)
        self.component.addChild(comp)
        self.do_reposition()

    def do_reposition(self):
        comp = self._page_nav_block.component
        comp.position[1] = comp.parent.height - 140
        self._page_nav_block.do_reposition()

    def _onBtnGoToCreateRoom(self):
        BWPersonality.GUICore.showCreateRoom()

    def _onBtnGoToFindRoom(self):
        BWPersonality.GUICore.showFindRoom()

    def _on_page_event(self, event_type, data):
        if event_type == PageET.OnClick:
            mode = data
            if mode == BtnType.Next:
                self.page_index += 1
            elif mode == BtnType.Prev:
                self.page_index -= 1
            elif mode == BtnType.Start:
                self.page_index = 0
            elif mode == BtnType.End:
                self.page_index = self.n_pages - 1
            self._correct_page_index()

    def show(self):
        self.component.visible = True
        self.component.focus = True
        self.component.dragFocus = True
        self.component.dropFocus = True
        self.component.crossFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        if self._tid:
            BigWorld.cancelCallback(self._tid)
        self._tid = BigWorld.callback(1, self._updateText)

    def _updateText(self):
        if not self.component.visible:
            return
        if not self.component.parent:
            return
        if not self.component.parent.visible:
            return
        self._tid = BigWorld.callback(5, self._updateText)
        BigWorld.player().getBoardPVPRooms()
        self._apply_page_index()

    def hide(self):
        self.component.visible = False
        self.component.focus = False
        self.component.dragFocus = False
        self.component.dropFocus = False
        self.component.crossFocus = False
        self.component.moveFocus = False
        self.component.mouseButtonFocus = False
        if self._tid:
            BigWorld.cancelCallback(self._tid)

    def setData(self, arr):
        """\xd0\xbf\xd1\x80\xd0\xb8\xd1\x88\xd0\xbb\xd0\xb8 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x81 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb0"""
        n = len(arr)
        line1 = lc('soFlashPVP.room_win.info').format(count=n)
        line2 = BWPersonality.GUICore.soBulletinBoard.pvpboard.info.rawText
        self.info.setText(u'<color=#ffffff>%s\n%s' % (line1, line2))
        if arr:
            self._rooms_info = list(arr)
            self.n_pages = (n + self.n_rows - 1) // self.n_rows
        else:
            self._rooms_info = []
            self.n_pages = 0
        self._correct_page_index()

    def _correct_page_index(self):
        self.page_index = max(0, min(self.n_pages - 1, self.page_index))
        self._apply_page_index()
        self._page_nav_block.disable_type(self.page_index == 0, BtnType.Start)
        self._page_nav_block.disable_type(self.page_index == 0, BtnType.Prev)
        self._page_nav_block.disable_type(self.n_pages - self.page_index < 2, BtnType.Next)
        self._page_nav_block.disable_type(self.n_pages - self.page_index < 2, BtnType.End)

    def _apply_page_index(self):
        i = self.n_rows * self.page_index
        j = self.n_rows * (self.page_index + 1)
        self.roomView.setItems(self._rooms_info[i:j])

    def slotHandler(self, *e):
        pass

    def viewHandler(self, *e):
        pass

    def on_server_error(self, code):
        from csconstans import CODE_ERR
        if code == CODE_ERR.FAIL_PRIVATE_ROOM_MANY:
            BWPersonality.GUICore.room_win.show_error(lc('soPvPStats.MSG_ERR.PRIVATE_ROOM_MANY'))
        elif code == CODE_ERR.FAIL_PRIVATE_ROOM_EXISTS:
            BWPersonality.GUICore.room_win.show_error(lc('soPvPStats.MSG_ERR.PRIVATE_ROOM_EXISTS'))
        elif code == CODE_ERR.FAIL_PRIVATE_ROOM_NOT_FOUND:
            BWPersonality.GUICore.room_find_win.show_error(lc('soPvPStats.MSG_ERR.PRIVATE_ROOM_NOT_FOUND'))
        elif code == CODE_ERR.FAIL_PRIVATE_ROOM_INVALID_PASS:
            BWPersonality.GUICore.room_find_win.show_error(lc('soPvPStats.MSG_ERR.PRIVATE_ROOM_INVALID_PASS'))
        elif code == CODE_ERR.FAIL_CONNECT_MAX_PLAYER:
            BWPersonality.GUICore.room_find_win.show_error(lc('soPvPStats.MSG_ERR.ROOM_MAX_PLAYER'))

    def doReposition(self):
        child_names = [ child[0] for child in self.component.children ]
        map(self.component.delChild, child_names)
        self.setupContent()
        self.setupPageNav()