        comp.width = 170
        comp.position = (30, 7, 0.5)
        self.component.addChild(comp, 'img')
        comp = GUI.Simple('soGUI/items/item_locked.dds')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.height = 32
        comp.width = 32
        comp.position = (170, 5, 0.5)
        self.component.addChild(comp, 'hasPass')

        def create_label(lname, y):
            comp = GUI.Text(lname)
            comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
            comp.horizontalAnchor = 'LEFT'
            comp.verticalAnchor = 'CENTER'
            comp.font = 'RobotoCondensedRegular_20.font'
            comp.colour = (220, 220, 220, 255)
            comp.colourFormatting = True
            comp.materialFX = 'BLEND'
            comp.position = (234, y, 0.5)
            self.component.addChild(comp, lname)

        create_label('label_room_name', 22)
        create_label('label_room_mode', 44)
        create_label('label_room_space', 66)
        btn = soButton(GUI.Window())
        comp = btn.component
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'CENTER'
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('soFlashPVP.btn_join_room')
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.width = 130
        comp.height = 25
        comp.position = (234, 100, 0.5)
        comp.script.setDisabledState(False)
        self.component.addChild(comp, 'btn_join')
        btn.onBound()
        btn.onClick = self._onBtnJoinClick

    def _onBtnJoinClick(self):
        if not self.haveItem():
            return

        def _join(passHash):
            if not self.haveItem():
                return
            player = BigWorld.player()
            player.base.joinToPrivateRoom(self.itemData['roomName'], passHash)

        if self.itemData['hasPass']:

            def _callback(text):
                if text:
                    passHash = zlib.crc32(text.encode('utf-8', 'ignore')) & 65535
                    _join(passHash)

            title = lc('soFlashPVP.room_win.join_title')
            msg = lc('soFlashPVP.room_win.join_msg')
            gui_jokes.inputBox(title, msg, _callback, active=True, isModal=True)
        else:
            _join(0)

    def _applyItemData(self):
        _haveItem = self.haveItem()
        self.component.label_room_name.visible = _haveItem
        self.component.label_room_mode.visible = _haveItem
        self.component.label_room_space.visible = _haveItem
        self.component.img.visible = _haveItem
        self.component.hasPass.visible = _haveItem
        self.component.btn_join.visible = _haveItem
        if _haveItem:
            self.component.label_room_name.text = self.itemData['roomName']
            pvpConfID = self.itemData['pvpConfID']
            conf = pvp_inst_config.configs[pvpConfID]
            self.component.img.textureName = conf['icon']
            self.component.label_room_mode.text = u'\\c929292FF;%s: \\cdcdcdcFF;%s' % (lc('soFlashPVP.room_win.room_mode'), lc(conf['title']))
            space_name = lc(conf['geometrylist'][self.itemData['spaceIndex']][1])
            self.component.label_room_space.text = u'\\c929292FF;%s: \\cdcdcdcFF;%s' % (lc('soFlashPVP.room_win.room_space'), space_name)
            _has_pass = bool(self.itemData['hasPass'])
            self.component.hasPass.visible = _has_pass


