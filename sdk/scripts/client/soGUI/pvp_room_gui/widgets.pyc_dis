# Embedded file name: ./client/soGUI/pvp_room_gui/widgets.py
import GUI
from soGUI.soEditField import soEditBox2
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod

class EditBox(soEditBox2):

    def __init__(self, width, masc_char = None, pholder = None, max_chars = 10):
        comp = GUI.Window()
        soEditBox2.__init__(self, comp, width=width, hOffset=5, height=0, font='RobotoCondensedRegular_16.font', autosize=True, maskChar=masc_char, placeholder=pholder)
        self.onBound()

        def check_max_chars(newStr, wholeText, offset):
            full_text = wholeText[:offset] + newStr + wholeText[offset:]
            return len(full_text) <= max_chars and full_text.isalnum()

        self.setValidator(check_max_chars)

    def runErrorNotify(self):
        if self.errorNotifier:
            self.errorNotifier.stop()
        self.errorNotifier = self._special_erroneous_state()
        self.errorNotifier.run()

    @BWMemberCoroutine
    def _special_erroneous_state(self):
        for i in xrange(4):
            self.erroneous = True
            self.updateVisuals()
            yield BWWaitForPeriod(0.05)
            self.erroneous = False
            self.updateVisuals()
            yield BWWaitForPeriod(0.05)

        self.errorNotifier = None
        return

    def on_hide(self):
        self.activate(False)
        self.stopErrorNotify()