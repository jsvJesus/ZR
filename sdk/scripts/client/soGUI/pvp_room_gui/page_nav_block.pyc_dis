    def do_reposition(self):
        prev_mode = self.component.widthMode
        self.component.widthMode = 'PIXEL'
        width = self.component.width
        self.component.widthMode = prev_mode
        comp_prev = self.component.btn_left
        comp_prev.position[0] = width * 0.5 - 4
        self.component.btn_start.position[0] = comp_prev.position[0] - comp_prev.width - 2
        comp_right = self.component.btn_right
        comp_right.position[0] = width * 0.5 + 4
        self.component.btn_end.position[0] = comp_right.position[0] + comp_right.width + 2
        for r in self._repositioners:
            r.do_reposition()