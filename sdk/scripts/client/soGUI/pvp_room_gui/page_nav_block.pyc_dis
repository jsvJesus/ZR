    def disable_type(self, disable, btn_type):
        if btn_type in (BtnType.Start, BtnType.All):
            self.component.btn_start.script.enabled = not disable
        if btn_type in (BtnType.Prev, BtnType.All):
            self.component.btn_left.script.enabled = not disable
        if btn_type in (BtnType.Next, BtnType.All):
            self.component.btn_right.script.enabled = not disable
        if btn_type in (BtnType.End, BtnType.All):
            self.component.btn_end.script.enabled = not disable

