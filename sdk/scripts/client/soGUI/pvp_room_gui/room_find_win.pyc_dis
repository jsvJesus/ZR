        comp = GUI.Text(lc('soFlashPVP.room_win.find_room_title'), 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'TOP')
        comp.colour = cc.active_rgba
        comp.materialFX = 'BLEND'
        comp.position = (w / 2, 10, 0.5)
        self.win_cmp.addChild(comp, 'label_name')

        def to_clear_error(func0, *args, **kw):
            self.win_cmp.labelError.text = u''
            return func0(*args, **kw)

        def roomNameSection(y):
            comp = GUI.Text(lc('soFlashPVP.room_win.room_name'), 'RobotoCondensedRegular_16.font')
