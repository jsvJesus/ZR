# Embedded file name: ./client/soGUI/ColdGUI.py
import GUI
import BWPersonality
import PostProcessing
import Helpers.PyGUI as PyGUI
import math_bw
PP_FREEZE = ''

class ColdGUI(PyGUI.PyGUIBase):

    def __init__(self):
        component = GUI.Window()
        PyGUI.PyGUIBase.__init__(self, component)
        component.script = self
        self.pp_id = None
        self.component.verticalPositionMode = self.component.horizontalPositionMode = 'CLIP'
        self.component.horizontalAnchor = 'CENTER'
        self.component.verticalAnchor = 'CENTER'
        self.component.widthMode = 'CLIP'
        self.component.heightMode = 'CLIP'
        self.component.width = 2
        self.component.height = 2
        self.component.position = (0.0, 0.0, 99.0)
        BWPersonality.GUICore.effectsLayer.addChild(self.component, 'coldGUI')
        cmp = GUI.Simple('soGUI/maps/freeze/freeze.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.width = cmp.height = 2.0
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp, 'cold_frame')
        shader = GUI.AlphaShader()
        shader.mode = 'ALL'
        shader.alpha = 0.0
        shader.speed = 1.0
        cmp.addShader(shader, 'shader')
        return

    def update_stacks(self, stacks):
        stacks = stacks / 3
        factor = math_bw.inverse_lerpclam(30.0, 70.0, stacks)
        alpha_cold = factor
        scale_pp = factor
        self.component.cold_frame.shader.alpha = alpha_cold
        if scale_pp:
            if self.pp_id is None:
                self.pp_id = PostProcessing.addPPChainByName('freeze')
            _, effects = PostProcessing.getPPChainByID(self.pp_id)
            effect = effects[0]
            for phase in effect.phases:
                if phase.name != 'distort and transfer':
                    continue
                phase.material.scale = scale_pp
                break

        elif self.pp_id:
            PostProcessing.removePPChain(self.pp_id)
            self.pp_id = None
        return

    def doReposition(self):
        pass

    def hide(self):
        self.update_stacks(0)