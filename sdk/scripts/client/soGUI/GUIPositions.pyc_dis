# Embedded file name: ./client/soGUI/GUIPositions.py
from Math import Vector3
import os
import pyson
import utils
import BigWorld
import traceback
import BWPersonality
import functools
POSITIONS_SAVED_DIR = os.path.join(utils.stalker_path(), 'usercontent/inventory')
POSITIONS_SAVED_PATH = os.path.join(POSITIONS_SAVED_DIR, 'positon_gui.pyson')

class GUIPositions:
    _win_poses = None
    _dirty = False
    interface_objects = []

    @staticmethod
    def _load_positions():
        GUIPositions._win_poses = {}
        if os.path.exists(POSITIONS_SAVED_PATH):
            try:
                with open(POSITIONS_SAVED_PATH, 'rb') as file:
                    data = pyson.loads(file.read())
                    if type(data) != dict:
                        raise ValueError('Invalid saved GUIPositions: {0} | {1}'.format(type(data), data))
                    GUIPositions._win_poses = data
            except:
                GUIPositions._win_poses = {}
                traceback.print_exc()

    @staticmethod
    def _on_game_exit():
        if not GUIPositions._dirty:
            return
        try:
            if not os.path.exists(POSITIONS_SAVED_DIR):
                os.makedirs(POSITIONS_SAVED_DIR)
        except:
            print 'ERROR create dir ', POSITIONS_SAVED_DIR
            traceback.print_exc()
            return

        try:
            with open(POSITIONS_SAVED_PATH, 'wb+') as file:
                file.write(pyson.dumps(GUIPositions._win_poses))
        except:
            print 'ERROR create file ', POSITIONS_SAVED_PATH
            traceback.print_exc()

    @staticmethod
    def save_position(gui_id, data):
        GUIPositions._win_poses[gui_id] = data
        GUIPositions._dirty = True

    @staticmethod
    def get_positon(gui_id):
        return GUIPositions._win_poses.get(gui_id, None)

    def __init__(self):
        GUIPositions.interface_objects.append((self.gui_positions_id, self))

    def show(self):
        """ \xd0\xb7\xd0\xb4\xd0\xb5\xd1\x81\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbe\xd1\x80\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x82\xd1\x8b \xd0\xbf\xd1\x80\xd0\xbe\xd1\x87\xd0\xb8\xd1\x82\xd0\xb0\xd1\x8e\xd1\x82\xd1\x81\xd1\x8f \xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb8\xd1\x81\xd0\xb2\xd0\xbe\xd1\x8f\xd1\x82\xd1\x81\xd1\x8f """
        if GUIPositions._win_poses is None:
            GUIPositions._load_positions()
        if self.gui_positions_id in GUIPositions._win_poses:
            self.apply_save_data(GUIPositions.get_positon(self.gui_positions_id))
        self._checkNormalPosition()
        return

    def on_release(self):
        GUIPositions.interface_objects = filter(lambda o: o[0] != self.gui_positions_id, GUIPositions.interface_objects)

    def get_save_data(self):
        return tuple(self.component.position)

    def apply_save_data(self, data):
        self.component.position = Vector3(data[0], data[1], self.component.position[2])

    def _checkNormalPosition(self):
        """ \xd0\xb2\xd0\xbf\xd0\xb8\xd1\x85\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd0\xb2 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbe\xd0\xbd\xd0\xbe \xd0\xb2\xd1\x8b\xd0\xbb\xd0\xb5\xd0\xb7\xd0\xbd\xd0\xbe \xd0\xb7\xd0\xb0 \xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8b """
        pos_mode = (self.component.verticalPositionMode, self.component.horizontalPositionMode)
        size_mode = (self.component.widthMode, self.component.heightMode)
        self.component.horizontalPositionMode, self.component.verticalPositionMode = ('CLIP', 'CLIP')
        self.component.widthMode, self.component.heightMode = ('CLIP', 'CLIP')
        if self.component.horizontalAnchor == 'RIGHT':
            max_pos = self.component.position.x
            min_pos = self.component.position.x - self.component.width
        elif self.component.horizontalAnchor == 'LEFT':
            max_pos = self.component.position.x + self.component.width
            min_pos = self.component.position.x
        else:
            max_pos = self.component.position.x + self.component.width / 2
            min_pos = self.component.position.x - self.component.width / 2
        if max_pos > 1:
            self.component.position.x -= max_pos - 1
        if min_pos < -1:
            self.component.position.x += -1 - min_pos
        if self.component.verticalAnchor == 'BOTTOM':
            max_pos = self.component.position.y + self.component.height
            min_pos = self.component.position.y
        elif self.component.verticalAnchor == 'TOP':
            max_pos = self.component.position.y
            min_pos = self.component.position.y - self.component.height
        else:
            max_pos = self.component.position.y + self.component.height / 2
            min_pos = self.component.position.y - self.component.height / 2
        if max_pos > 1:
            self.component.position.y -= max_pos - 1
        if min_pos < -1:
            self.component.position.y += -1 - min_pos
        self.component.horizontalPositionMode, self.component.verticalPositionMode = pos_mode
        self.component.widthMode, self.component.heightMode = size_mode

    def stopDragging(self):
        """ \xd0\xb2 \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbe\xd1\x80\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x82\xd0\xb0 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f """
        self.flush()

    def flush(self):
        GUIPositions.save_position(self.gui_positions_id, self.get_save_data())

    @property
    def gui_positions_id(self):
        """ \xd1\x83\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd0\xb5 """
        return getattr(self, 'factoryString', self.__class__.__name__)

    def reset_position(self):
        """ \xd1\x81\xd0\xb1\xd1\x80\xd0\xb0\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd """
        pass

    @staticmethod
    def reset_positions():
        """ \xd1\x81\xd0\xb1\xd1\x80\xd0\xb0\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd """
        GUIPositions._win_poses = {}
        GUIPositions._dirty = True
        for name, obj in GUIPositions.interface_objects:
            obj.reset_position()

    def doReposition(self):
        pass

    def on_size_changed(self):
        self._checkNormalPosition()

    @staticmethod
    def onLeaveWorld():
        GUIPositions.interface_objects = []


def try_connect_to_system_events(attempts):
    if attempts < 0:
        print "GUIPositions (ERROR): can't connect to system events"
        traceback.print_stack()
        return
    if hasattr(BWPersonality, 'sys_command_event_listeners'):

        def filter_events(event_type):
            if event_type in [BWPersonality.SC_CLOSE, BWPersonality.SC_QUIT]:
                GUIPositions._on_game_exit()

        BWPersonality.sys_command_event_listeners.append(filter_events)
        BWPersonality.game.addListener('onFini', GUIPositions._on_game_exit)
    else:
        BigWorld.callback(0, functools.partial(try_connect_to_system_events, attempts - 1))


try_connect_to_system_events(10)