    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.systemLayer.addChild(self.component, 'escMenu')
        self.doReposition()
        super(soIngameMainMenu, self).show()
        BWPersonality.GUICore.setBestCursor()
        p = BigWorld.player()
        inPVPinstance = getattr(p, 'inPVPinstance', 0)
        self.change_inPVPinstance(inPVPinstance)
        self.component.dungLeave.visible = getattr(p, 'dungeon_id', 0)
        BWPersonality.GUICore.updateSoundVolumeIngameMenu()
        return

    def change_inPVPinstance(self, value):
        self.component.pvpLeave.visible = value
        self.component.changeTeam.visible = value
        player = BigWorld.player()
        if player and value:
            if player.pvpInstConfig['maxPlayers'] == player.pvpInstConfig['maxPlayersTeam']:
                self.component.changeTeam.visible = False

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.setBestCursor()
        BWPersonality.GUICore.updateSoundVolumeIngameMenu()

    def show_skip(self, show):
        self.component.skipTutorial.visible = show

    def resumeGame(self):
        BWPersonality.GUICore.showIngameMenu(False)

    def wantOptions(self):
        pass

    def logoff(self):
        player = BigWorld.player()
        if getattr(BWPersonality, '_offline_mode', None) and player and player.id >= 1073741824:
            import __debug.offline_loader
            __debug.offline_loader.exi()
            __debug.offline_loader.leave()
        else:
            player.playerLogOff()
            BWPersonality.GUICore.ingameMenuEvent(self.EVENT_LOGOFF, None)
        self.hide()
        return

    def quitGame(self):
        BigWorld.player().playerLogOff()
        BWPersonality.GUICore.ingameMenuEvent(self.EVENT_QUIT, None)
        return

    def doReposition(self):
        sW, sH = BigWorld.screenSize()
        addYpos = -157
        self.component.changeTeam.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.pvpLeave.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.skipTutorial.position = (sW // 2, sH // 2 + addYpos, 0.02)
        self.component.dungLeave.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.shopBtn.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.storeBtn.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.resumeBtn.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.optionsBtn.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.supportBtn.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.logoffBtn.position = (sW // 2, sH // 2 + addYpos, 0.02)
        addYpos += 37
        self.component.quitBtn.position = (sW // 2, sH // 2 + addYpos, 0.05)

    @PyGUIEvent('changeTeam', 'onClick')
    def onchangeTeamClick(self):
        BWPersonality.GUICore.showChoiceTeam(True)
        BWPersonality.GUICore.showIngameMenu(False)

    @PyGUIEvent('pvpLeave', 'onClick')
    def onPVPLeaveClick(self):
        BigWorld.player().base.leaveFromRoom()
        BWPersonality.GUICore.showIngameMenu(False)

    @PyGUIEvent('skipTutorial', 'onClick')
    def onSkipTutorialClick(self):
        BigWorld.player().skip_tutorial()
        BWPersonality.GUICore.showIngameMenu(False)

    @PyGUIEvent('dungLeave', 'onClick')
    def onDungLeaveClick(self):
        BigWorld.player().base.client_leave_dungeon()
        BWPersonality.GUICore.showIngameMenu(False)

    @PyGUIEvent('storeBtn', 'onClick')
    def onStoreClick(self):
        BWPersonality.GUICore.storehouse_screen.show_store()
        BWPersonality.GUICore.showIngameMenu(False)

    @PyGUIEvent('shopBtn', 'onClick')
    def onShopClick(self):
        BWPersonality.GUICore.storehouse_screen.show_shop()
        BWPersonality.GUICore.showIngameMenu(False)

    @PyGUIEvent('resumeBtn', 'onClick')
    def onResumeClick(self):
        self.resumeGame()

    @PyGUIEvent('optionsBtn', 'onClick')
    def onOptionsClick(self):
        BWPersonality.GUICore.showIngameSettings(True)

    @PyGUIEvent('supportBtn', 'onClick')
    def onSupportClick(self):
        url = get_support_url()
        webbrowser.open(url)

    @PyGUIEvent('logoffBtn', 'onClick')
    def onLogoffClick(self):
        self.logoff()

    @PyGUIEvent('quitBtn', 'onClick')
    def onQuitClick(self):
        self.hide()
        BWPersonality.GUICore.showQuitMenu(callbackYes=self.quitGame, callbackNo=self.show)
        BWPersonality.GUICore.updateSoundVolumeIngameMenu()