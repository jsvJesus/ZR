from Helpers.PyGUI.PyGUIBase import Interceptor
_colorization = {GS.WAIT_TO_OPEN: ((0, 255, 0, 255), (0, 153, 0, 255)),
 GS.IS_FORWARDED: ((175, 166, 112, 255), (128, 121, 82, 255)),
 GS.START_OPEN: ((102, 153, 72, 255), (68, 102, 48, 255)),
 GS.IS_ALREADY_OPEN: ((146, 146, 146, 255), (102, 102, 102, 255)),
 GS.RETURNED: ((155, 123, 78, 255), (76, 61, 38, 255)),
 GS.RETURNED_WAIT_TO_OPEN: ((255, 191, 116, 255), (128, 95, 57, 255)),
 GS.HAS_BEEN_SENT: ((119, 179, 84, 255), (51, 76, 36, 255))}

def _time_to_date(servertime):
    clientitme = servertime + BWPersonality.gpd.time_diff
    return time.strftime('%d.%m.%y', time.localtime(clientitme))


class ContextAction:
    RequestTimePass, CopyID, AdmDeleteGift = range(3)


class EventType:
    OnClicked, = ((r, 'gift.itemview.item') for r in range(1))


class ListItem(Interceptor, Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        Interceptor.__init__(self, component, intercept_moving=False)
        self._data_item = None
        comp = GUI.Simple('soGUI/frame/journal/load_anim/load_pips')
        comp.materialFX = 'BLEND'
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (35, 10)
        comp.position = (0, 0, 0)
        comp.visible = False
        self.component.addChild(comp, 'load_pips')
        comp = GUI.Simple(u'')
        comp.visible = False
        self.component.addChild(comp, 'content')
        comp = GUI.Simple(u'soGUI/frame/paint/white.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 1)
        comp.colour = (255, 255, 255, 50)
        comp.visible = False
        self.component.content.addChild(comp, 'selection')
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 1)
        comp.position = (-1, 1, 0.5)
        self.component.content.addChild(comp, 'sender')
        comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 1)
        comp.position = (-1, 0, 0.5)
        self.component.content.addChild(comp, 'bank')
        comp = GUI.Simple(u'soGUI/frame/paint/white.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('CLIP', 'PIXEL')
        comp.width, comp.height = (2, 1)
        comp.position = (0, -1, 0.5)
        comp.colour = (255, 255, 255, 50)
        self.component.content.addChild(comp)
        return

    def _on_data_item_event(self, event_type, data):
        if event_type in (ItemDataET.OnLoaded, ItemDataET.SelectionChanged):
            self._update_content()

    def _update_content(self):
        if self._data_item:
            if self._data_item.loaded:
                self.component.load_pips.visible = False
                content = self.component.content
                content.visible = True
                if not self._data_item.sender:
                    sender_text = u''
                    self._data_item.time and sender_text += u' ' + _time_to_date(self._data_item.time)
                content.sender.text = sender_text
                if self._data_item.bank:
                    npc_name = AP.get_npc_name_by_id(self._data_item.bank)
                    if npc_name:
                        group_id = AP.get_npc_tradegroup(npc_name)
                        if group_id:
                            bank_text = rep_utils.get_name(group_id)
                        elif not NPCs.NPCs.getName(npc_name):
                            bank_text = npc_name
                        else:
                            bank_text = unicode(self._data_item.bank)
                    else:
                        bank_text = u'undefined'
                    content.bank.text = bank_text
                    content.selection.visible = self._data_item.selected
                    colour = (255, 0, 255, 255)
                    color_data = _colorization.get(self._data_item.stat)
                    valid = color_data and self._local_bank_id and self._local_bank_id == self._data_item.bank
                    colour = color_data[0 if valid else 1]
                content.bank.colour = colour
                content.sender.colour = colour
            else:
                self.component.load_pips.visible = True
                self.component.content.visible = False
        else:
            self.component.load_pips.visible = False
            self.component.content.visible = False

    def on_restore(self, data, local_bank_id, index):
        raise not self._data_item or AssertionError
        self._local_bank_id = local_bank_id
        self._data_item = data.items[index]
        self._data_item.add_listener(self._on_data_item_event)
        self._update_content()

    def on_pool(self):
        raise self._data_item or AssertionError
        self._local_bank_id = None
        self._data_item.remove_listener(self._on_data_item_event)
        self._data_item = None
        self._update_content()
        return

    def _on_context(self, interface_id, action_id, caption, event, data):
        BWPersonality.GUICore.removeListener('contextMenuEvent', self._on_context)
        if interface_id == id(self):
            if action_id == ContextAction.RequestTimePass:
                BigWorld.player().cell.runCommand(u'/fastGift {0} {1}'.format(self._gift_id.decode('utf8'), 90000))
                BWPersonality.addChatMsg(-1, 'fastGift: %s' % self._gift_id.decode('utf8'))
            elif action_id == ContextAction.AdmDeleteGift:

                def callback(e):
                    if e != gui_jokes.GuiHandler.OK:
                        return
                    gift_type = BWPersonality.GUICore._gifts_win._tab_view.get_type_gift()
                    print 'deleteGift:', [gift_type, self._gift_id]
                    BigWorld.player().base.deleteGift(gift_type, self._gift_id)

                gui_jokes.askUserOk(u'[ADMIN]\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u043f\u043e\u0441\u044b\u043b\u043a\u0443?', u'[ADMIN]\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u043f\u043e\u0441\u043b\u044b\u043a\u0443 %s' % self._gift_id.decode('utf8'), callback)
            elif action_id == ContextAction.CopyID:
                BigWorld.clipboardSetPlainText(self._gift_id.decode('utf8'))

    @property
    def _gift_id(self):
        return self._data_item and self._data_item.gift_id

    def handleMouseButtonEvent(self, comp, event):
        if event.isKeyDown():
            if event.key == Keys.KEY_LEFTMOUSE:
                data = {'gift_id': self._gift_id}
                self.notify_listeners(EventType.OnClicked, data)
            elif event.key == Keys.KEY_RIGHTMOUSE:
                if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and BigWorld.player().isAdminAccess():
                    actions = {ContextAction.RequestTimePass: u'\u043f\u0435\u0440\u0435\u043c\u043e\u0442\u0430\u0442\u044c \u043d\u0430 25 \u0447\u0430\u0441\u043e\u0432',
                     ContextAction.CopyID: u'\u0441\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c gift_id',
                     ContextAction.AdmDeleteGift: u'admin delete'}
                    BWPersonality.GUICore.removeListener('contextMenuEvent', self._on_context)
                    BWPersonality.GUICore.showContextMenu(id(self), actions)
                    BWPersonality.GUICore.addListener('contextMenuEvent', self._on_context)
        return Interceptor.handleMouseButtonEvent(self, comp, event)