# Embedded file name: ./client/soGUI/gifts_gui/intab.py
import GUI
from mailtab import Mailtab
from Localization import lc
from soGUI.soButton import soButton, soButtonWTT
import gui_jokes
from data import EventType as DataET
from GiftBankUtils import GiftEventType as ServerET, GIFT_STATUS, GIFT_TYPE
from insettings import InSettings

class InTab(Mailtab):

    def __init__(self, component):
        Mailtab.__init__(self, component, lc('GiftGui.tabs.in.name'), GIFT_TYPE.ACCEPTED_GIFTS)

    def _setup_content(self):
        Mailtab._setup_content(self)
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('GiftGui.tabs.delempty')
        comp.width, comp.height = (148, 28)
        comp.position = (154, self.component.height, 0.1)
        btn.onClick = self._on_del_empty_click
        self._del_empty_button = btn
        self.component.addChild(comp)
        btn.onBound()
        comp = GUI.Window()
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.va, comp.ha = ('BOTTOM', 'RIGHT')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (28, 28)
        comp.position = (self.component.width, self.component.height, 0.5)
        comp.textureName = 'soGUI/frame/gifts/setting.dds'
        comp.materialFX = 'BLEND'
        self.component.addChild(comp)
        btn = soButtonWTT(comp)
        btn.buttonStyle = soButton.TOGGLEBUTTON_STYLE
        btn.initVSC('soGUI/visual_styles/btn_toggle.xml')
        btn.setVisualState('normal')
        btn.onBound()
        btn.onClick = self._on_settings_click
        self._settings_btn = btn
        comp = GUI.Window('soGUI/frame/paint/white.dds')
        comp.colour = (10, 10, 10, 255)
        comp.materialFX = 'BLEND'
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width - 1, 1, 0.1)
        comp.width, comp.height = (342, 368)
        comp.visible = False
        self.component.addChild(comp, 'settings')
        self._settings = InSettings(comp)

    def got_gifts3(self, total, request_id, items, recieve_gift_filter):
        Mailtab.got_gifts3(self, total, request_id, items, recieve_gift_filter)
        self._settings.set_filter(recieve_gift_filter)

    def _on_settings_click(self):
        self._update_visiblity()

    def _update_visiblity(self):
        if self._settings_btn.buttonActive:
            self.component.settings.visible = True
        else:
            self.component.settings.visible = False

    def show(self, selected_bid, speak_bid):
        Mailtab.show(self, selected_bid, speak_bid)
        self._update_del_empty_button()
        self._settings_btn.setToggleState(False)
        self._update_visiblity()
        self._settings.on_show()

    def _on_data_event(self, event_type, data):
        Mailtab._on_data_event(self, event_type, data)
        if event_type in (DataET.OnLoaded,
         DataET.OnCleared,
         DataET.OnDeleted,
         DataET.OnDeletedMultiple,
         DataET.OnInserted):
            self._update_del_empty_button()

    def on_gift_event3(self, event_type, gift_descs, gift_ids, gifts):
        Mailtab.on_gift_event3(self, event_type, gift_descs, gift_ids, gifts)
        if event_type == ServerET.OnDelEmpty:
            self._del_empty_button.setDisabledState(True)

    def _on_del_empty_click(self):

        def callback(ask_event):
            if ask_event == gui_jokes.GuiHandler.YES:
                self._loader.request_delete_emtpty()

        gui_jokes.askUserYesNo(lc('GiftGui.tab.deltitleempty'), lc('GiftGui.tab.deltextempty'), callback)

    def _update_del_empty_button(self):
        if self._data.items:
            enabled = True
            if self._data.items[-1].loaded:
                for item in self._data.items:
                    if item.stat == GIFT_STATUS.IS_ALREADY_OPEN:
                        break
                else:
                    enabled = False

        else:
            enabled = False
        self._del_empty_button.setDisabledState(not enabled)