# Embedded file name: ./client/soGUI/gifts_gui/mailtab.py
import GUI
from itemview.listview import ListView, EventType as ListET
from content import Content
from data import Data, EventType as DataET
from sorter import Sorter
from loader import Loader, EventType as LoaderET
from GiftBankUtils import GiftEventType as ServerET, GIFT_STATUS as gs, MAX_GIFTS, MAX_GIFTS_SENT, GIFT_TYPE as gt
from soGUI.soButton import soButton
from Localization import lc
import gui_jokes
from tab import Tab
from Helpers.PyGUI.PyGUIBase import Interceptor
import colorCodes as cc

class Mailtab(Tab):

    def __init__(self, component, name, type_gift):
        Tab.__init__(self, component, type_gift, name)
        self._data = Data()
        self._data.add_listener(self._on_data_event)
        self._loader = Loader(type_gift)
        self._loader.add_listener(self._on_loader_event)
        self._setup_content()

    def _setup_content(self):
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (246, 336)
        comp.position = (0, 28, 1)
        self._list_view = ListView(comp, self._data)
        self._list_view.add_listener(self._on_listview_event)
        self.component.addChild(comp, 'listview')
        lcomp = comp
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (255, 255, 255, 100)
        comp.horizontalPositionMode, comp.verticalPositionMode = lcomp.horizontalPositionMode, lcomp.verticalPositionMode
        comp.horizontalAnchor, comp.verticalAnchor = lcomp.horizontalAnchor, lcomp.verticalAnchor
        comp.widthMode, comp.heightMode = lcomp.widthMode, lcomp.heightMode
        comp.width, comp.height = lcomp.width, lcomp.height
        comp.position = (lcomp.position[0], lcomp.position[1], lcomp.position[2] * 0.1)
        self.component.addChild(comp, 'loader')
        comp.visible = False
        Interceptor(comp)
        comp = GUI.Simple('soGUI/frame/journal/load_anim/load_pips')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (35, 10)
        comp.position = (0, 0, 0.5)
        self.component.loader.addChild(comp)
        comp = GUI.Window()
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.position = (self.component.width, 0, 0.9)
        comp.materialFX = 'SOLID'
        comp.width, comp.height = (344, 370)
        self.component.addChild(comp)
        self._content = Content(comp, self._loader)
        comp = GUI.Window()
        comp.materialFX = 'SOLID'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.listview.width, 26
        comp.position = (0, 0, 1)
        self._sorter = Sorter(comp)
        self._sorter.on_mode_changed = self._on_sortmode_changed
        self.component.addChild(comp)
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('GiftGui.tab.delsel')
        comp.width, comp.height = (148, 28)
        comp.position = (0, self.component.height, 0.1)
        btn.onClick = self._on_del_selected_click
        self._del_sel_button = btn
        self.component.addChild(comp)
        btn.onBound()
        comp = GUI.Text('', 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (100, 32)
        comp.position = (230, 26, 0.005)
        comp.colour = cc.active_rgba
        self._limit = comp
        self.component.addChild(comp)

    def _on_del_selected_click(self):

        def callback(ask_event):
            if ask_event == gui_jokes.GuiHandler.YES:
                self._loader.request_delete(self.type_gift, self._data.selected_id)

        if self._data._selected_item:
            emergency_notification = self._data._selected_item.stat in (gs.WAIT_TO_OPEN, gs.START_OPEN)
            text = emergency_notification and lc('GiftGui.tab.deltextselopen').format(cc.red_xml, cc.inactive_xml)
            gui_jokes.askUserYesNo(lc('GiftGui.tab.deltitlesel'), text, callback)
        else:
            gui_jokes.askUserYesNo(lc('GiftGui.tab.deltitlesel'), lc('GiftGui.tab.deltextsel'), callback)

    def _on_sortmode_changed(self):
        self._loader.stop_loading()
        self._data.clear()
        self._loader.load_next(0, *self._sorter.mode)

    def _update_loader_pips(self):
        self.component.loader.visible = self._loader.list_loading

    def _update_del_sel_button(self):
        enabled = False
        if self._data.selected_id:
            if self._data._selected_item.stat not in (gs.IS_FORWARDED, gs.RETURNED):
                enabled = True
        self._del_sel_button.setDisabledState(not enabled)

    def _on_listview_event(self, event_type, data):
        if event_type == ListET.OnUnloadedVisible:
            self._loader.load_next(data['index'], *self._sorter.mode)

    def _on_data_event(self, event_type, data):
        if event_type == DataET.OnSelectedChanged:
            self._update_del_sel_button()
            self._content.set_gift(self._data.selected_id)
        elif event_type == DataET.TotalChanged:
            self._update_total()

    def _on_loader_event(self, event_type, data):
        if event_type == LoaderET.OnLoaded:
            total, index, items = data['total'], data['index'], data['items']
            self._data.set_data(total, index, items)
        elif event_type == LoaderET.OnLoadListChanged:
            self._update_loader_pips()

    def _update_total(self):
        if self.type_gift == gt.ACCEPTED_GIFTS:
            limit = MAX_GIFTS
        elif self.type_gift == gt.SENT_GIFTS:
            limit = MAX_GIFTS_SENT
        self._limit.text = '{0}/{1}'.format(self._data.total, limit)

    def on_bank_changed(self, selected_bid, speak_bid):
        Tab.on_bank_changed(self, selected_bid, speak_bid)
        self.on_close()
        self.hide()
        self._content.on_close()
        self.show(selected_bid, speak_bid)

    def show(self, selected_bid, speak_bid):
        Tab.show(self, selected_bid, speak_bid)
        self._list_view.show(selected_bid)
        self._sorter.on_show()
        self._update_del_sel_button()
        self._update_loader_pips()
        self._content.on_show(selected_bid, speak_bid)
        self._update_total()
        if self._data.items is None:
            self._loader.load_next(0, *self._sorter.mode)
        return

    def hide(self):
        Tab.hide(self)
        self._list_view.hide()

    def on_close(self):
        Tab.on_close(self)
        self._loader.stop_loading()
        self._data.clear()
        self._content.on_close()

    def got_gifts3(self, total, request_id, items, recieve_gift_filter):
        Tab.got_gifts3(self, total, request_id, items, recieve_gift_filter)
        self._loader.got_gifts4(total, request_id, items)

    def on_gift_event3(self, event_type, gift_descs, gift_ids, gifts):
        if event_type == ServerET.OnRemoved:
            self._data.remove_gifts(gift_ids)
        elif event_type == ServerET.OnInserted:
            self._data.insert_gift(gift_descs[0], *self._sorter.mode)
        elif event_type == ServerET.OnDelEmpty:
            if gift_ids:
                self._data.remove_gifts(gift_ids)
                gui_jokes.askUserOk(lc('GiftGui.tabs.delempty'), lc('GiftGui.tab.deleted').format(len(gift_ids)))
            else:
                gui_jokes.askUserOk(lc('GiftGui.tabs.delempty'), lc('GiftGui.tab.notdeleted'))
        elif event_type == ServerET.OnDesc:
            self._data.update_gift(gift_descs[0], *self._sorter.mode)
            self._content.on_gift_got(gifts[0])
        elif event_type == ServerET.OnChanged:
            self._data.update_gift(gift_descs[0], *self._sorter.mode)
            self._content.on_gift_got(gifts[0])
            self._update_del_sel_button()