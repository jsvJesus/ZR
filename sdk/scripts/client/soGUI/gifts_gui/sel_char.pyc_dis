# Embedded file name: ./client/soGUI/gifts_gui/sel_char.py
import BigWorld
import GUI
from Helpers.PyGUI.PyGUIBase import Interceptor
from Localization import lc
from soGUI.soButton import soButton
from functools import partial

class SelectCharWin(Interceptor):

    def __init__(self, component, select_callback):
        Interceptor.__init__(self, component)
        self._select_callback = select_callback
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'SOLID'
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.hpm, comp.vpm = ('CLIP', 'CLIP')
        comp.width, comp.height = (300, 210)
        comp.position = (0, 0, 0.5)
        self.component.addChild(comp)
        base_comp = comp
        comp = GUI.Window()
        btn = soButton(comp)
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.wm, comp.hm = ('PIXEL', 'PIXEL')
        comp.ha, comp.va = ('RIGHT', 'TOP')
        comp.width, comp.height = (18, 18)
        comp.position = (base_comp.width - 6, 6, 0.2)
        base_comp.addChild(comp, 'closeBox')
        btn.initVSC('soGUI/elements/closeBox.xml')
        btn.onBound()
        btn.onClick = self.hide
        comp = GUI.Text(lc('GiftGui.tabs.created.pickchar'), 'RobotoCondensedRegular_18.font')
        comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
        comp.ha, comp.va = ('CENTER', 'CENTER')
        comp.position = (0, 16, 0.5)
        base_comp.addChild(comp)

        def create_button(text, pos_y):
            comp = GUI.Window()
            btn = soButton(comp)
            btn.initVSC('soGUI/elements/button_1.xml')
            comp.hpm, comp.vpm = ('CLIP', 'PIXEL')
            comp.wm, comp.hm = ('PIXEL', 'PIXEL')
            comp.ha, comp.va = ('CENTER', 'TOP')
            comp.label.font = 'RobotoCondensedRegular_16.font'
            comp.label.text = text
            comp.width, comp.height = base_comp.width - 32, 32
            comp.position = (0, pos_y, 0.1)
            base_comp.addChild(comp)
            btn.onBound()
            return btn

        self._btns = []
        for i in range(3):
            btn = create_button(u'', i * 36 + 42)
            btn.onClick = partial(self._on_click, btn)
            self._btns.append(btn)

        btn_cancel = create_button(lc('GiftGui.tabs.created.cancel'), 164)
        btn_cancel.onClick = self.hide

    def _on_click(self, btn):
        self._select_callback(btn.component.label.text)
        self.hide()

    def show(self):
        from Account import Account
        for i in range(len(self._btns)):
            if len(Account.char_list_cache) > i:
                name = Account.char_list_cache[i][0]
                self._btns[i].component.label.text = name
                if name == BigWorld.player().name:
                    style = 'soGUI/elements/button_1_spec.xml'
                else:
                    style = 'soGUI/elements/button_1.xml'
                self._btns[i].initVSC(style)
                self._btns[i].onBound()
                self._btns[i].component.visible = True
            else:
                self._btns[i].component.visible = False

        self.component.visible = True

    def hide(self):
        self.component.visible = False