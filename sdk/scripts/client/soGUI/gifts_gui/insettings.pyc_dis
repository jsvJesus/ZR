# Embedded file name: ./client/soGUI/gifts_gui/insettings.py
import BigWorld
import colorCodes as cc
from soGUI import CheckBoxPropsStructure
import GUI
from Helpers.PyGUI.PyGUIBase import Interceptor
from soGUI.soCheckBox import soCheckBox
from Localization import lc
from GiftBankUtils import parse_income_filters, batch_income_filters, ReciveFilter

class InSettings(Interceptor):

    def __init__(self, component):
        Interceptor.__init__(self, component)
        self._update_server_handler = None
        left_margin = 16
        pos_y = 24
        comp = GUI.Text(lc('GiftGui.tabs.in.settings.title'), 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.colour = cc.active_rgba
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (left_margin, pos_y, 0.5)
        self.component.addChild(comp)
        pos_y += 32
        comp = GUI.Text(lc('GiftGui.tabs.in.settings.text'), 'RobotoCondensedRegular_16.font')
        comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
        comp.colour = cc.inactive_rgba
        comp.ha, comp.va = ('LEFT', 'CENTER')
        comp.position = (left_margin, pos_y, 0.5)
        self.component.addChild(comp)
        pos_y += 16
        for child_name, text in (('cbFriends', 'GiftGui.tabs.in.settings.friends'), ('cbAlly', 'GiftGui.tabs.in.settings.ally'), ('cbAll', 'GiftGui.tabs.in.settings.all')):
            comp = GUI.Window()
            comp.hpm, comp.vpm = ('PIXEL', 'PIXEL')
            comp.colour = cc.inactive_rgba
            comp.ha, comp.va = ('LEFT', 'CENTER')
            comp.position = (left_margin, pos_y, 0.5)
            self.component.addChild(comp, child_name)
            cb = soCheckBox(comp, CheckBoxPropsStructure(labelText=lc(text), labelColour=cc.inactive_rgba))
            cb.disable()
            cb.onStateChange = self.on_change
            cb.onBound()
            pos_y += 20

        return

    def on_change(self):
        if self._update_server_handler:
            BigWorld.cancelCallback(self._update_server_handler)
            self._update_server_handler = None
        self._update_server_handler = BigWorld.callback(1.0, self._dump_to_server)
        return

    def _dump_to_server(self):
        filter_index = batch_income_filters(ReciveFilter(has_friends=self.component.cbFriends.script.isChecked(), has_ally=self.component.cbAlly.script.isChecked(), has_all=self.component.cbAll.script.isChecked()))
        BigWorld.player().base.update_recieve_filter(filter_index)

    def on_show(self):
        pass

    def set_filter(self, filter_index):
        recieve_filter = parse_income_filters(filter_index)
        self.component.cbFriends.script.set_active(recieve_filter.has_friends)
        self.component.cbAlly.script.set_active(recieve_filter.has_ally)
        self.component.cbAll.script.set_active(recieve_filter.has_all)
        self.component.cbFriends.script.enable()
        self.component.cbAlly.script.enable()
        self.component.cbAll.script.enable()