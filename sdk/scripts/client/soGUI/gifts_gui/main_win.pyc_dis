    def _on_tab_view_event(self, event_type, data):
        if event_type == DeliveryET.OnCancel:
            self.hide()
        elif event_type == CreateET.OnCreateGiftRequest:
            self.hide()
            BigWorld.player().cell.sendGift(data['to_avatar'], data['from_bank'], data['to_bank'], data['item_ids'], data['money'], data['total_cost'], data['comment'], data['tariff_id'])

    def got_gifts1(self, *args):
        self._tab_view.got_gifts2(*args)

    def on_gift_event1(self, *args):
        self._tab_view.on_gift_event2(*args)

    def show(self):
        if self.component.visible:
            return
        self.component.visible = True
        self._tab_view.on_show(*self._get_cur_bank_id())

    def on_cur_bank_changed(self):
        self._tab_view.on_bank_changed(*self._get_cur_bank_id())

    def item_in_gift_send(self, item):
        return self.component.visible and self._tab_view.item_in_gift_send(item)

    def startDragging(self):
        self._tab_view.on_start_drag()
        return DragWin.startDragging(self)

    def hide(self):
        if not self.component.visible:
            return
        self.component.visible = False
        self._tab_view.on_hide()

    def _get_cur_bank_id(self):
        selected_bank_name = BWPersonality.GUICore.itemCacheGUI._selected_npc
        if selected_bank_name:
            if not AP.get_npc_id_by_name(selected_bank_name):
                selected_bank_name = None
            speak_bank_name = BigWorld.player().GetTraderName(BigWorld.player().cacheObjectID)
            speak_bank_name = speak_bank_name and (AP.get_npc_id_by_name(speak_bank_name) or None)
        return (selected_bank_name, speak_bank_name)

    @property
    def visible(self):
        return self.component.visible