# Embedded file name: ./client/soGUI/gifts_gui/outtab.py
import BWPersonality
import time
import BigWorld
import GUI
from mailtab import Mailtab
from Localization import lc
from GiftBankUtils import GIFT_TYPE, GIFT_STATUS, TIME_RETURN_GIFT
from soGUI.soButton import soButton
from content import EventType as ContentET
from returnwin import ReturnWin
import math
import colorCodes as cc

class ReturnButton(soButton):

    def __init__(self, *args):
        self._interface_id = 'outtab.returnbutton'
        soButton.__init__(self, *args)
        self._tttext = None
        return

    def set_tooltip(self, text):
        self._tttext = text

    def handleMouseEnterEvent(self, comp):
        if self._tttext:
            BWPersonality.GUICore.showToolTip(cc.tf3_regular_text_color + self._tttext, tooltipID=self._interface_id)
        return soButton.handleMouseEnterEvent(self, comp)

    def handleMouseLeaveEvent(self, comp):
        BWPersonality.GUICore.hideToolTip(self._interface_id)
        return soButton.handleMouseLeaveEvent(self, comp)


class OutTab(Mailtab):

    def __init__(self, component):
        Mailtab.__init__(self, component, lc('GiftGui.tabs.out.name'), GIFT_TYPE.SENT_GIFTS)
        self._content.add_listener(self._on_content_event)
        self._return_win = None
        self._last_selected_gift = None
        return

    def _setup_content(self):
        Mailtab._setup_content(self)
        comp = GUI.Window()
        btn = ReturnButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('GiftGui.tabs.out.return')
        comp.width, comp.height = (148, 28)
        comp.position = (154, self.component.height, 0.1)
        btn.onClick = self._on_return_click
        btn.setDisabledState(True)
        self._return_button = btn
        self.component.addChild(comp)
        btn.onBound()

    def _on_return_click(self):
        if not self._return_win:
            self._return_win = ReturnWin()
            pos_x = int(BigWorld.screenWidth() * 0.5)
            pos_y = int(BigWorld.screenHeight() * 0.5)
            self._return_win.component.position = (pos_x, pos_y, 0.1)
            BWPersonality.GUICore.worldLayer.addChild(self._return_win.component, 'gift_return_win')
        self._return_win.show(self._last_selected_gift)

    def _on_content_event(self, event_type, data):
        if event_type == ContentET.OnGiftChanged:
            self._update_return_button(data['gift'])

    def on_close(self):
        Mailtab.on_close(self)
        self._return_button.setDisabledState(True)
        if self._return_win:
            self._return_win.hide()

    def _update_return_button(self, gift):
        tttext = [None]

        def is_gift_valid(gift):
            if not gift:
                return False
            if gift['statusCode'] not in (GIFT_STATUS.HAS_BEEN_SENT, GIFT_STATUS.START_SHIPPING):
                return False
            life_time = time.time() - BWPersonality.gpd.time_diff - gift['timeOfArrival']
            if life_time < TIME_RETURN_GIFT:
                tttext[0] = TIME_RETURN_GIFT - life_time
                return False
            return True

        self._return_button.set_tooltip(None)
        self._last_selected_gift = gift
        self._return_button.setDisabledState(not is_gift_valid(gift))
        if tttext[0]:
            hours = int(math.ceil(tttext[0] / 60.0 / 60.0))
            tttext = lc('GiftGui.tabs.out.returntime').format(hours)
            self._return_button.set_tooltip(tttext)
        return