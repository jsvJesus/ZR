# Embedded file name: ./client/soGUI/gifts_gui/returnwin.py
import BigWorld
from Localization import lc
import colorCodes as cc
import GUI
from Helpers.PyGUI.PyGUIBase import DragWin
from soGUI.soButton import soButton
from deliverytype import DeliveryType, EventType as DeliveryET

class ReturnWin(DragWin):

    def __init__(self):
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (610, 252)
        comp.position = (0, 0, 1)
        comp.visible = False
        DragWin.__init__(self, comp)
        self._setup_content()

    def _setup_content(self):
        comp = GUI.Frame2('soGUI/frame/basic_frame_1.dds')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 1)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp)
        comp = GUI.Text(lc('GiftGui.return.header'), 'RobotoCondensedRegular_16.font')
        comp.colour = cc.active_rgba
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (14, 6, 0.3)
        self.component.addChild(comp)
        comp = GUI.Window()
        btn = soButton(comp)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.width, comp.height = (18, 18)
        comp.position = (self.component.width - 6, 6, 0.2)
        self.component.addChild(comp, 'closeBox')
        btn.initVSC('soGUI/elements/closeBox.xml')
        btn.onBound()
        btn.onClick = self.hide
        self._delivery = DeliveryType()
        self._delivery.add_listener(self._on_delivery_event)
        comp = self._delivery.component
        comp.position = ((self.component.width - comp.width) / 2, self.component.height - 16, 1)
        comp.verticalAnchor = 'BOTTOM'
        self.component.addChild(comp)

    def _on_delivery_event(self, event_type, data):
        if event_type == DeliveryET.OnCancel:
            self.hide()
        elif event_type == DeliveryET.OnConfirm:
            self.hide()
            BigWorld.player().base.returnGiftUser(self._gift_id, data['mode'])

    def show(self, gift):
        self.component.visible = True
        self._gift_id = gift['giftID']
        data = {'from_bank': gift['fromTrader'],
         'to_bank': gift['toTrader'],
         'money': gift['money'],
         'items': gift['itms']}
        self._delivery.set_data(data)

    def hide(self):
        self.component.visible = False