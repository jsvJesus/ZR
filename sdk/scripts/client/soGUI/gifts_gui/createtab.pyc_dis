from utils import Listenable
from sel_char import SelectCharWin

class EventType:
    OnCreateGiftRequest, = ((r, 'gift.createtab') for r in range(1))


class CreateTab(Tab, Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        self._sel_char_win = None
        Tab.__init__(self, component, None, lc('GiftGui.tabs.content.name'))
        self._create_content()
        return

    def _create_content(self):
        self._items_view = ItemsView(interactable=True)
        self._items_view.on_items_changed_callback = self._on_items_changed
        comp = self._items_view.component
        comp.horizontalAnchor = 'RIGHT'
        comp.position = (self.component.width, 5, 0.5)
        self.component.addChild(comp)
        pos_y = 18
        pos_x1 = 10
        pos_x2 = 22
        space_x = 30
        comp = GUI.Simple('soGUI/frame/gifts/receiver.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (pos_x1, pos_y, 0.5)
        comp.colour = cc.inactive_rgba
        self.component.addChild(comp)
        comp = GUI.Window()
        self._target_box = soEditBox2(comp, width=173, height=26, font='RobotoCondensedRegular_14.font', autosize=False)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (pos_x2, pos_y, 0.5)
        self.component.addChild(comp)
        self._target_box.onBound()
        self._target_box.setEnableCopyPaste(True)
        self._target_box.setValidator(lambda *args: len(args[1]) <= 40)
        self._target_box.onValueChange = self._target_box_change
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('GiftGui.tabs.created.self')
        comp.width, comp.height = 60, self._target_box.height
        btn_pos_x = self._target_box.component.position[0] + self._target_box.component.width + 2
        btn.onClick = self._on_self_click
        comp.position = (btn_pos_x, pos_y, 0.1)
        self.component.addChild(comp)
        btn.onBound()
        pos_y += space_x
        comp = GUI.Simple('soGUI/frame/billboard/location.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (pos_x1, pos_y, 0.5)
        comp.colour = cc.inactive_rgba
        self.component.addChild(comp)
        self._ddl = soDropDownList2(GUI.Window(), width=234, height=26)
        comp = self._ddl.component
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (pos_x2, pos_y, 0.1)
        self._ddl.onSelectedElement = self._on_ddl_selected
        self.component.addChild(comp)
        pos_y += space_x
        comp = GUI.Simple('soGUI/frame/inventory/money.dds')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = comp.texture.width, comp.texture.height
        comp.position = (pos_x1, pos_y, 0.5)
        self.component.addChild(comp)

        def gold_check(new_str, whole_text, offset):
            full_text = whole_text[:offset] + new_str + whole_text[offset:]
            full_text = full_text.replace('`', '')
            if not full_text.isdigit():
                return False
            if whole_text:
                if int(full_text) <= sys.maxint:
                    return True
                return False
            return True

        comp = GUI.Window()
        self._money_box = soEditBoxMoney(comp, width=234, height=26, font='RobotoCondensedRegular_14.font', autosize=False)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.position = (pos_x2, pos_y, 0.5)
        self.component.addChild(comp)
        self._money_box.onBound()
        self._money_box.setValidator(gold_check)
        self._money_box.onValueChange = self._money_box_change
        comp = GUI.Text(lc('GiftGui.tabs.created.comment'), 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
        comp.colour = cc.inactive_rgba
        comp.position = (0, 126, 0.5)
        self.component.addChild(comp)
        comp = GUI.Window()
        self._comment_box = soEditBox2(comp, width=self.component.width - 17, height=50, font='RobotoCondensedRegular_14.font', autosize=False, multiline=True)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (0, 138, 0.5)
        self.component.addChild(comp)
        self._comment_box.onBound()
        self._comment_box.setValidator(lambda *args: len(args[1]) <= GBU.MAX_COMMENT_LENGTH)
        self._delivery_type = DeliveryType()
        self._delivery_type.add_listener(self._on_delivery_event)
        comp = self._delivery_type.component
        comp.position = (0, self.component.height - 8, 1)
        comp.verticalAnchor = 'BOTTOM'
        self.component.addChild(comp)

    def _on_delivery_event(self, event_type, data):
        if event_type == DeliveryET.OnConfirm:
            data = {'to_avatar': self._target_box.getRaw(),
             'from_bank': str(AP.get_npc_name_by_id(self._selected_bid)),
             'to_bank': self._ddl.getSelection()[1],
             'item_ids': [ it['complexItemID'] for it in self._items_view._items ],
             'money': self._money_box.getValue(),
             'total_cost': data['total_cost'],
             'comment': self._comment_box.getRaw().encode('utf8'),
             'tariff_id': data['mode']}
            self.notify_listeners(EventType.OnCreateGiftRequest, data)
        else:
            self.notify_listeners(event_type, data)

    def _on_self_click(self):
        if not self._sel_char_win:
            comp = GUI.Window('soGUI/frame/paint/black.dds')
            comp.materialFX = 'BLEND'
            comp.colour = (255, 255, 255, 150)
            comp.wm, comp.hm = ('CLIP', 'CLIP')
            comp.hpm, comp.vpm = ('CLIP', 'CLIP')
            comp.ha, comp.va = ('CENTER', 'CENTER')
            comp.width, comp.height = (2, 2)
            comp.position = (0, 0, 0.1)
            self.component.addChild(comp)
            self._sel_char_win = SelectCharWin(comp, self._on_self_name_click)
        self._sel_char_win.show()

    def _on_self_name_click(self, name):
        self._target_box.setValue(name)

    def _update_available_banks(self, bank_id):
        was_selected = self._ddl.getSelection()[0]
        self._ddl.clear()
        from_bank = AP.get_npc_name_by_id(bank_id)
        ddl_elements = []
        can_reselect = False
        for trader_name in BigWorld.player().KnowingStorages:
            to_bank = trader_name
            trade_params = GBU.get_send_param(from_bank, to_bank)
            if not trade_params.get('can_send', False):
                continue
            bank_name_localized = _NPCs.getProfession(to_bank)
            if not bank_name_localized:
                continue
            ddl_elements.append([to_bank, bank_name_localized])
            if was_selected and bank_name_localized == was_selected:
                can_reselect = True

        self._ddl.addElements(ddl_elements)
        if can_reselect:
            self._ddl.setSelectionByText(was_selected)
        elif ddl_elements:
            self._ddl.setSelectionByValue(ddl_elements[0][0])

    def _money_box_change(self, by_user):
        self._dirty = True

    def _target_box_change(self, by_user):
        self._dirty = True

    def _on_ddl_selected(self, attachment):
        self._dirty = True

    def _on_items_changed(self):
        self._dirty = True

    def item_in_gift_send(self, item):
        return self._items_view.contains(item['complexItemID'])

    def show(self, selected_bid, speak_bid):
        Tab.show(self, selected_bid, speak_bid)
        self._dirty = True
        if self._sel_char_win:
            self._sel_char_win.hide()
        BWPersonality.register_after_input_callback(self._on_post_gui_event)
        self._update_available_banks(selected_bid)
        self._money_box.setValue(u'')
        self._comment_box.setValue(u'')
        self._dirty = True

    def on_bank_changed(self, selected_bid, speak_bid):
        Tab.on_bank_changed(self, selected_bid, speak_bid)
        self._items_view.set_items(None)
        self._update_available_banks(selected_bid)
        return

    def hide(self):
        Tab.hide(self)
        BWPersonality.unregister_after_input_callback(self._on_post_gui_event)
        self._ddl.showList(False)
        if self._sel_char_win:
            self._sel_char_win.hide()

    def _on_post_gui_event(self):
        if self._dirty:
            self._update_delivery()
            self._dirty = False
        return False

    def on_close(self):
        Tab.on_close(self)
        self._items_view.set_items(None)
        return

    def on_start_drag(self):
        self._ddl.showList(False)

    def _update_delivery(self):
        from_bank = AP.get_npc_name_by_id(self._selected_bid)
        to_bank = self._ddl.getSelection()[1]
        if not from_bank or not to_bank:
            self._delivery_type.component.visible = False
            return
        money = self._money_box.getValue()
        target = self._target_box.getRaw()
        items = self._items_view._items
        self._delivery_type.component.visible = True
        data = {'from_bank': from_bank,
         'to_bank': to_bank,
         'money': money,
         'items': items}
        self._delivery_type.set_data(data)
        disabled = not target or not money and not items
        self._delivery_type.confirm_button.setDisabledState(disabled)