# Embedded file name: ./client/soGUI/gifts_gui/sorter.py
import BWPersonality
import colorCodes as cc
from functools import partial
import BigWorld
import GUI
from Localization import lc
from Helpers.PyGUI.PyGUIBase import Interceptor
from GiftBankUtils import SortMode, SortDir
import Keys

class ToggleButton(Interceptor):

    def __init__(self, component, up_image, down_image, tooltip):
        Interceptor.__init__(self, component)
        tooltip = cc.tf3_regular_text_color + tooltip
        self._tooltip = tooltip
        self._up_image = BigWorld.PyTextureProvider(up_image)
        self._down_image = BigWorld.PyTextureProvider(down_image)
        self.direction = SortDir.Down
        self.highlighted = False
        self._update_content()

    def handleMouseEnterEvent(self, comp):
        BWPersonality.GUICore.showToolTip(self._tooltip, delay=0, tooltipID=id(self))
        return True

    def handleMouseLeaveEvent(self, comp):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        return True

    def _update_content(self):
        if self.direction == SortDir.Down:
            self.component.texture = self._down_image
        elif self.direction == SortDir.Up:
            self.component.texture = self._up_image
        if self.highlighted:
            self.component.colour = cc.highlighted_rgba
        else:
            self.component.colour = cc.active_rgba
        self.component.width = self.component.texture.width
        self.component.height = self.component.texture.height

    def set_highlighted(self, highlighted):
        self.highlighted = highlighted
        self._update_content()

    def set_direction(self, dir_mode):
        self.direction = dir_mode
        self._update_content()

    def handleMouseButtonEvent(self, comp, event):
        if event.key == Keys.KEY_LEFTMOUSE and event.isKeyDown():
            self.on_click()
        return Interceptor.handleMouseButtonEvent(self, comp, event)


class Sorter:

    def __init__(self, component):
        self.component = component
        self.mode = (SortMode.Name, SortDir.Down)
        self._buttons = {}
        self.on_mode_changed = lambda : None
        comp = GUI.Text(lc('GiftGui.sort.title'), 'RobotoCondensedRegular_16.font')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, -1, 1.0)
        comp.colour = cc.active_rgba
        self.component.addChild(comp)
        pos_x = 100
        pos_y = 0
        space = 20
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = (40, 40)
        comp.position = (pos_x, pos_y, 0.9)
        btn = ToggleButton(comp, 'soGUI/frame/gifts/sort_name_up.dds', 'soGUI/frame/gifts/sort_name_down.dds', lc('GiftGui.sort.name'))
        btn.on_click = partial(self._on_click, SortMode.Name)
        self._buttons[SortMode.Name] = btn
        self.component.addChild(comp)
        pos_x += space
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = (40, 40)
        comp.position = (pos_x, pos_y, 0.9)
        btn = ToggleButton(comp, 'soGUI/frame/gifts/sort_stat_up.dds', 'soGUI/frame/gifts/sort_stat_down.dds', lc('GiftGui.sort.status'))
        btn.on_click = partial(self._on_click, SortMode.Stat)
        self._buttons[SortMode.Stat] = btn
        self.component.addChild(comp)
        pos_x += space
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'CLIP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.width, comp.height = (40, 40)
        comp.position = (pos_x, pos_y, 0.9)
        btn = ToggleButton(comp, 'soGUI/frame/gifts/sort_time_up.dds', 'soGUI/frame/gifts/sort_time_down.dds', lc('GiftGui.sort.time'))
        btn.on_click = partial(self._on_click, SortMode.Time)
        self._buttons[SortMode.Time] = btn
        self.component.addChild(comp)

    def _on_click(self, sort_mode):
        if sort_mode == self.mode[0]:
            direction = self._buttons[sort_mode].direction
            if direction == SortDir.Up:
                direction = SortDir.Down
            elif direction == SortDir.Down:
                direction = SortDir.Up
            self.mode = (sort_mode, direction)
        else:
            direction = self._buttons[sort_mode].direction
            self.mode = (sort_mode, direction)
        self._update_content()
        self.on_mode_changed()

    def _update_content(self):
        for sort_mode, btn in self._buttons.iteritems():
            if sort_mode == self.mode[0]:
                btn.set_highlighted(True)
                btn.set_direction(self.mode[1])
            else:
                btn.set_highlighted(False)

    def on_show(self):
        self._update_content()