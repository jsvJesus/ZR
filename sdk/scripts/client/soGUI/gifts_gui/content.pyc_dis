# Embedded file name: ./client/soGUI/gifts_gui/content.py
import BigWorld
import time
import BWPersonality
import GUI
from Helpers.PyGUI.PyGUIBase import Interceptor
from Localization import lc
import colorCodes as cc
import AdditionalNPCParameters as AP
from GiftBankUtils import GIFT_STATUS
from itemview.listitem import _colorization
from itemsview import ItemsView
from soGUI.soTextField import soTextField3
from soGUI.textMoney import TextMoney
from soGUI.soButton import soButton
from utils import Listenable

class EventType:
    OnGiftChanged, = ((r, 'gift.tab.content') for r in range(1))


def _time_to_date(servertime):
    clientitme = servertime + BWPersonality.gpd.time_diff
    return time.strftime('%d.%m.%y %H:%M', time.localtime(clientitme))


class Content(Listenable):

    def __init__(self, component, loader):
        Listenable.__init__(self)
        self.component = component
        self._loader = loader
        self._gift_id = None
        self._setup_content()
        return

    def _setup_content(self):
        comp = GUI.Frame2('soGUI/frame/con_frame_rounded.dds')
        comp.materialFX = 'SOLID'
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 1)
        self.component.addChild(comp)
        comp = GUI.Window('soGUI/frame/paint/black.dds')
        comp.materialFX = 'BLEND'
        comp.colour = (255, 255, 255, 100)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('CLIP', 'CLIP')
        comp.width, comp.height = (2, 2)
        comp.position = (0, 0, 0.1)
        self.component.addChild(comp, 'loader')
        comp.visible = False
        Interceptor(comp)
        comp = GUI.Simple('soGUI/frame/journal/load_anim/load_pips')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (35, 10)
        comp.position = (0, 0, 0.5)
        self.component.loader.addChild(comp)
        comp = GUI.Simple(u'')
        comp.visible = False
        self.component.addChild(comp, 'content')
        pos_y = 16
        pic_x, text_x = (12, 28)
        space = 20

        def create_image_text(image, name, colour):
            comp = GUI.Simple(image)
            comp.colour = cc.inactive_rgba
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('CENTER', 'CENTER')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.position = (pic_x, pos_y, 1)
            comp.width, comp.height = comp.texture.width, comp.texture.height
            self.component.content.addChild(comp)
            comp = GUI.Text(u'', 'RobotoCondensedRegular_16.font')
            comp.colour = colour
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'CENTER')
            comp.position = (text_x, pos_y, 1)
            self.component.content.addChild(comp, name)

        create_image_text('soGUI/frame/gifts/sender.dds', 'sender_text', cc.highlighted_rgba)
        pos_y += space
        create_image_text('soGUI/frame/gifts/receiver.dds', 'receiver_text', cc.highlighted_rgba)
        pos_y += space
        create_image_text('soGUI/frame/billboard/location.dds', 'location_text', cc.inactive_rgba)
        pos_y += space
        create_image_text('soGUI/frame/billboard/time.dds', 'time_text', cc.active_rgba)
        pos_y += space
        create_image_text('soGUI/frame/gifts/status.dds', 'stat_text', cc.inactive_rgba)
        pos_y += space
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = self.component.width - 24, 64
        comp.position = (8, pos_y, 1)
        self.component.content.addChild(comp)
        self._comment_text = soTextField3(comp, comp.width, comp.height, textWidth=-1, hScroll=False, vScroll=False, hideScroll=True, borderWidth=0, vOffset=0, hOffset=0, textureless=1)
        self._items_view = ItemsView(interactable=False)
        self._items_view.component.position = (8, 200, 1)
        self.component.content.addChild(self._items_view.component)
        comp = GUI.Window()
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (200, 30)
        comp.position = (pic_x, self.component.height, 1)
        self.component.content.addChild(comp)
        self._money = TextMoney(comp, font='RobotoCondensedRegular_16.font')
        self._money.SEP = '.'
        self._money.move_money_icon_height(-4)
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'BOTTOM')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.label.text = lc('GiftGui.tabs.content.open')
        comp.width, comp.height = (148, 28)
        comp.position = (self.component.width - 16, self.component.height - 8, 0.1)
        btn.onClick = self._on_open_click
        self._open_button = btn
        self.component.content.addChild(comp)
        btn.onBound()

    def _on_open_click(self):
        self._open_button.setDisabledState(True)
        BigWorld.player().base.openGift(self._gift_id, 0)

    def on_show(self, selected_bid, speak_bid):
        self._bank_id = speak_bid

    def set_gift(self, gift_id):
        if self._gift_id == gift_id:
            return
        self._gift_id = gift_id
        self._show_content(False)
        if self._gift_id:
            self._loader.load_details(gift_id)
            self.component.loader.visible = True
        else:
            self.component.loader.visible = False

    def on_gift_got(self, gift):
        if self._gift_id != gift['giftID']:
            return
        else:
            self.component.loader.visible = False
            self._show_content(True)
            self.component.content.sender_text.text = gift['fromAvatar']
            self.component.content.receiver_text.text = gift['toAvatar']
            prof_name = AP.get_npc_profession_by_name(gift['toTrader'])
            self.component.content.location_text.text = lc('NPCs.PROFESSION.' + prof_name if prof_name else 'GUI.QuestLog.Reputation.Unknownprofession')
            self.component.content.time_text.text = _time_to_date(gift['timeOfArrival'])
            self.component.content.stat_text.text = GIFT_STATUS.caption[gift['statusCode']]
            npc_id = AP.get_npc_id_by_name(gift['toTrader'])
            color_data = _colorization.get(gift['statusCode'])
            colour = None
            if self._bank_id:
                valid = self._bank_id == npc_id
                if color_data:
                    colour = color_data[0 if valid else 1]
                if not colour:
                    self.component.content.stat_text.colour = (255, 0, 255, 255)
                    if gift['comment']:
                        comment_text = gift['comment'].decode('utf8')
                    else:
                        comment_text = lc('GiftGui.tabs.content.nocomment')
                    self._comment_text.setText(cc.active_xml + u'<font=RobotoCondensedRegular_16.font>' + comment_text, immidiate=True)
                    self._items_view.set_items(gift['itms'])
                    self._money.setValue(gift['money'])
                    fade_money = True
                    if gift['statusCode'] in (GIFT_STATUS.WAIT_TO_OPEN, GIFT_STATUS.RETURNED_WAIT_TO_OPEN) and valid:
                        self._open_button.setDisabledState(False)
                        fade_money = gift['money'] > 0 and False
                    self._items_view.set_enabled(True)
                else:
                    self._open_button.setDisabledState(True)
                    self._items_view.set_enabled(False)
                fade_money and self._money.textCmp.colour[3] *= 0.3
            self.notify_listeners(EventType.OnGiftChanged, {'gift': gift})
            return

    def _show_content(self, show):
        self.component.content.visible = show
        if not show:
            self.notify_listeners(EventType.OnGiftChanged, {'gift': None})
        return

    def on_close(self):
        self._gift_id = None
        self.component.loader.visible = False
        self._show_content(False)
        self._items_view.set_items(None)
        return