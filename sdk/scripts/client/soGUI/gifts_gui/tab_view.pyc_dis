# Embedded file name: ./client/soGUI/gifts_gui/tab_view.py
import GUI
from intab import InTab
from outtab import OutTab
from createtab import CreateTab
from soGUI.soButton import soButton, soButtonWFT
from functools import partial
from utils import Listenable

class TabView(Listenable):

    def __init__(self, component):
        Listenable.__init__(self)
        self.component = component
        button_height = 22

        def create_tab_component():
            comp = GUI.Window()
            comp.visible = False
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'BOTTOM')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.width, comp.height = self.component.width, self.component.height - 3 - button_height
            comp.position = (0, self.component.height, 1.0)
            self.component.addChild(comp)
            return comp

        create_tab = CreateTab(create_tab_component())
        create_tab.add_listener(self._on_create_event)
        self._tabs = [InTab(create_tab_component()), OutTab(create_tab_component()), create_tab]
        self._cur_tab_index = 0
        self._buttons = []
        space = 3
        pos_x = 0
        spaces_count = len(self._tabs) - 1
        button_width = (self.component.width - spaces_count * space) / len(self._tabs)
        for i in range(len(self._tabs)):
            comp = GUI.Window()
            btn = soButtonWFT(comp)
            btn.buttonStyle = soButton.TOGGLEBUTTON_STYLE
            btn.initVSC('soGUI/elements/tab_2.xml')
            comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
            comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
            comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
            comp.width, comp.height = button_width, button_height
            comp.position = (pos_x, 0, 0.2)
            comp.label.text = self._tabs[i].name
            self.component.addChild(comp)
            btn.onBound()
            btn.onClick = partial(self._on_tab_click, i)
            pos_x += button_width + space
            self._buttons.append(btn)

    def _on_tab_click(self, index):
        if self._cur_tab_index == index:
            return
        self._tabs[self._cur_tab_index].hide()
        self._cur_tab_index = index
        self._tabs[self._cur_tab_index].show(*self._bank_ids)
        self._update_buttons()

    def get_type_gift(self):
        return self._tabs[self._cur_tab_index].type_gift

    def on_show(self, selected_bid, speak_bid):
        self._bank_ids = (selected_bid, speak_bid)
        self._update_buttons()
        self._tabs[self._cur_tab_index].show(selected_bid, speak_bid)

    def on_bank_changed(self, selected_bid, speak_bid):
        self._bank_ids = (selected_bid, speak_bid)
        self._tabs[self._cur_tab_index].on_bank_changed(selected_bid, speak_bid)

    def item_in_gift_send(self, item):
        return self._tabs[2].item_in_gift_send(item)

    def on_hide(self):
        self._bank_ids = None
        self._tabs[self._cur_tab_index].hide()
        for tab in self._tabs:
            tab.on_close()

        return

    def on_start_drag(self):
        self._tabs[self._cur_tab_index].on_start_drag()

    def _on_create_event(self, event_type, data):
        self.notify_listeners(event_type, data)

    def got_gifts2(self, *args):
        for tab in self._tabs:
            tab.got_gifts3(*args)

    def on_gift_event2(self, event_type, gift_type, gift_descs, gift_ids, gifts):
        for tab in self._tabs:
            if tab.type_gift == gift_type:
                tab.on_gift_event3(event_type, gift_descs, gift_ids, gifts)

    def _update_buttons(self):
        for i, button in enumerate(self._buttons):
            if i == self._cur_tab_index:
                button.setVisualState('active')
                button.buttonActive = True
            else:
                button.setVisualState('normal')
                button.buttonActive = False