        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.verticalAnchor = 'CENTER'
        cmp.horizontalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.height = cmp.width = 2
        cmp.position = (0.0, 0.0, 0.5)
        cmp.textureName = 'soGUI/loading_screens/loading_mask.dds'
        cmp.filterType = 'LINEAR'
        self.component.addChild(cmp, 'ldrMask1')
        sW, sH = BigWorld.screenSize()
        cmp = GUI.Simple('soGUI/maps/loadingScreen/loadingCircle/loadingCircle.texanim')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.height = 41
        cmp.width = 41
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (sW - 64, sH - 64, 0.0)
        self.component.addChild(cmp, 'ldrAnim')
        self._border_w = 64
        text_width = BigWorld.screenWidth() * HINT_WIDTH_RATIO
        min_height = 100
        self._panel_hint_bg = Panel(self.component, 'panel_hint_bg')
        self._panel_hint_bg.transform.set_base_resolution(None)
        self._panel_hint_bg.transform.set_pixel_mode((0.5, 1), (0.5, 1), (text_width, min_height))
        self.hint_tf = WrappedText(self._panel_hint_bg.component, 'hint_tf', size=20)
        self.hint_tf.transform.set_base_resolution(None)
        self.hint_tf.set_unscalable()
        self.hint_tf.transform.set_clip_mode((0, 0, 1, 1), pixel_anchors=(self._border_w,
         self._border_w,
         -self._border_w,
         -self._border_w))
        return

    def addMessage(self, text):
        self.hint_tf.set_text(text)
        text_width = BigWorld.screenWidth() * HINT_WIDTH_RATIO
        text_height = self.hint_tf.wrapped_height + self._border_w * 2
        self._panel_hint_bg.transform.set_pixel_mode((0.5, 1), (0.5, 1), (text_width, text_height))
        self._panel_hint_bg.transform.apply_mode()

    def doReposition(self):
        sW, sH = BigWorld.screenSize()
        self._panel_hint_bg.transform.apply_mode()
        self.component.ldrAnim.position = (sW - 64, sH - 64, 0.0)
        self.component.ldrBack.width = sH * 2
        self.component.ldrBack.height = sH
        self.component.position = (0, 0, 0.0)

    def initTextureMap(self):
        xmlData = ResMgr.openSection(LOADING_SCREENS)
        spaces = xmlData.values()
        for space in spaces:
            self.spaceTextures[space.readString('name')] = space.readStrings('path')

    def setMinMax(self, min, max):
        self.min = min
        self.max = max

    def setProgress(self, value):
        range = self.max - self.min
        value = self.min + value * range

    def reset(self, value = None):
        pass

    def appendMessage(self, text):
        pass

    __progressChecker_coro = None

    def show(self):
        if self.__progressChecker_coro:
            self.__progressChecker_coro.stop()
        AudioMixer.blend_volume_to(0.001, 'LOAD_SPACE', blend_time=3.0)
        BigWorld.worldDrawEnabled(False)
        self.component.visible = True
        self.__progressChecker_coro = self.progressChecker()
        self.__progressChecker_coro.run()
        if not self._hints:
            self._hints = self._hintGenerator()
            self._hints.run()
        self.doReposition()
        self.component.moveFocus = True
        self.component.crossFocus = True
        self.component.dropFocus = True
        self.component.dragFocus = True
        self.component.mouseButtonFocus = True
        self.component.focus = True
        try:
            BigWorld.player().onShowLoadprogress()
        except:
            traceback.print_exc()

    @BWMemberCoroutine
    def _hintGenerator(self):
        while True:
            self.addMessage(BWPersonality.GUICore.hintFeeder.getHint())
            yield BWWaitForPeriod(15.0)

    def testShow(self):
        self.component.visible = True
        self.addMessage(BWPersonality.GUICore.hintFeeder.getHint())
        self.doReposition()

    def hide(self):
        AudioMixer.blend_volume_to(1.0, 'LOAD_SPACE', blend_time=3.0)
        BigWorld.worldDrawEnabled(True)
        self.component.visible = False
        BWPersonality.GUICore.screenUnFade(True)
        self.clearLoadScreen()
        player = BigWorld.player()
        try:
            if player:
                player.onHideLoadprogress()
        except:
            traceback.print_exc()

        self.component.moveFocus = False
        self.component.crossFocus = False
        self.component.dropFocus = False
        self.component.dragFocus = False
        self.component.mouseButtonFocus = False
        self.component.focus = False
        if self._hints:
            self._hints.stop()
            self._hints = None
        return

    def setTimeout(self, timeOut):
        self.timeOut = timeOut

    def setDistance(self, dst):
        self.distance = dst

    def setWaitMode(self, doWait = False):
        self.waitForReset = doWait

    def setSpaceName(self, spaceName):
        texturePath = ''
        if not self.spaceTextures.has_key(spaceName):
            spaceName = 'unknown'
        index = randint(0, len(self.spaceTextures[spaceName]) - 1)
        texturePath = self.spaceTextures[spaceName][index]
        self.component.ldrBack.textureName = texturePath

    def clearLoadScreen(self):
        self.component.ldrBack.textureName = ''

    def cancel(self):
        self.canceled = True
        self.hide()
        BWPersonality.GUICore.loaderGUIEvent(EVENT_CANCEL, (TYPE_SPACE, self.spaceName))

    @BWMemberCoroutine
    def progressChecker(self):
        plog('progressChecker distance=%s, timeout=%s, spaceName=%s, waitForReset=%s' % (self.distance,
         self.timeOut,
         self.spaceName,
         self.waitForReset))
        startTime = BigWorld.time()
        self.finished = False
        self.timedOut = False
        self.canceled = False
        self.reset()
        lastStatus = 0.0
        if self.waitForReset:
            while BigWorld.spaceLoadStatus(self.distance) == 1.0:
                yield BWWaitForPeriod(0.05)

        while not self.finished:
            if not self.canceled:
                if not self.timedOut:
                    yield BWWaitForPeriod(0.05)
                    status = BigWorld.spaceLoadStatus(self.distance)
                    finished = status >= 0.999
                    timedOut = BigWorld.time() - startTime > self.timeOut
                    if timedOut:
                        self.timedOut = True
                        BWPersonality.GUICore.loaderGUIEvent(EVENT_TIMEOUT, (TYPE_SPACE, self.spaceName))
                    self.finished = finished and True
                    BWPersonality.GUICore.loaderGUIEvent(EVENT_FINISH, (TYPE_SPACE, self.spaceName))
                    self.setProgress(1.0)
                lastStatus < status and self.setProgress(status)
                lastStatus = status

        plog('progressChecker finished=%s, timedOut=%s, canceled=%s' % (self.finished, self.timedOut, self.canceled))
        self.hide()
        self.__progressChecker_coro = None
        return

    def handleKeyEvent(self, event):
        return True

    def handleMouseEvent(self, comp, event):
        return True

    def handleMouseButtonEvent(self, comp, event):
        return True


