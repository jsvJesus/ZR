# Embedded file name: ./client/soGUI/soList_opened.py
import Quest
from soGUI.soList_optimized import soList_optimized, soListElement

class PriorityElement(soListElement):

    def __init__(self, *args, **kargs):
        self._priority = 0
        soListElement.__init__(self, *args, **kargs)

    def setVisualState(self, state_name):
        soListElement.setVisualState(self, state_name)
        self.component.label.colour = Quest.quest_priority_to_color(self._priority)

    def set_priority(self, priority):
        self._priority = priority


class soList_closed(soList_optimized):

    def get_button_label_position(self, component):
        return soList_opened.DEFAULT_POSITION

    def get_elem_class(self):
        return PriorityElement

    def apply_single_element(self, i, elem):
        attachment = self.attachments[self.indexes[elem]]
        element = self.elemComps[i]
        element.set_priority(attachment['priority'])
        soList_optimized.apply_single_element(self, i, elem)


class soList_opened(soList_optimized):
    DEFAULT_POSITION = (-0.95, 0.2, 0)
    FAV_POSITION = (-0.88, 0.2, 0)

    def get_button_label_position(self, component):
        return soList_opened.DEFAULT_POSITION

    def get_elem_class(self):
        return PriorityElement

    def apply_single_element(self, i, elem):
        attachment = self.attachments[self.indexes[elem]]
        element = self.elemComps[i]
        element.set_priority(attachment['priority'])
        if self.elements[self.indexes[elem]] == 0:
            element.buttonActive = False
            element.setVisualState('normal')
        else:
            element.buttonActive = True
            element.setToggleState(True)
        if attachment['favorite']:
            element.initVSC('soGUI/elements/listElementFav.xml')
            element.add_glyph('soGUI/maps/Options/mark.dds')
            element.myLabel.position = soList_opened.FAV_POSITION
        else:
            element.initVSC('soGUI/elements/listElement.xml')
            element.clear_glyph()
            element.myLabel.position = soList_opened.DEFAULT_POSITION
        self.elementHolder.children[i][1].label.text = self.indexes[elem]
        self.elementHolder.children[i][1].visible = True