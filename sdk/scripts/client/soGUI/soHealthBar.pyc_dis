    def setupShaders(self):
        hShader = GUI.ClipShader()
        hShader_old_val = GUI.ClipShader()
        sShader = GUI.ClipShader()
        hShader.speed = 0
        hShader_old_val.speed = 0
        sShader.speed = 0
        hShader.mode = hShader_old_val.mode = sShader.mode = 'RIGHT'
        hShader.value = hShader_old_val.value = sShader.value = 1.0
        self.container.healthBar.addShader(hShader, 'clipper')
        self.container.healthBar_old_val.addShader(hShader_old_val, 'clipper')
        self.container.staminaBar.addShader(sShader, 'clipper')

    def partySettingHandler(self):
        pass

    def _get_bonus_tooltip(self):
        text = []
        from time import time
        if self._premium_id != PREMIUM_OFF:
            config = ClientSimpleConfigs().get_premium_config(self._premium_id)
            text.append(lc(config['description']))
            rem_time = int(self._prem_end_time - (time() - BWPersonality.gpd.time_diff))
            text.append(self.get_prem_time_string(rem_time))
        if self._boost_id:
            config = BoosterConfigParser.get_config(self._boost_id)
            text.append(lc(config['description']))
            rem_time = int(self._boost_end_time - (time() - BWPersonality.gpd.time_diff))
            text.append(self.get_prem_time_string(rem_time))
        return '\n'.join(text)

    def get_prem_time_string(self, remain_time):
        import math
        real_days = int(remain_time) / 86400
        days = int(math.ceil(remain_time / 86400))
        hours = int(remain_time) / 3600
        minutes = int(remain_time) / 60
        if real_days >= 1:
            result = colorCodes.tf3_text_color_gray + lc('extendedGUI.PremiumPanel.days') + ' ' + lc('extendedGUI.PremiumPanel.toEnd') + ': ' + colorCodes.tf3_chat_default + str(days)
        elif hours >= 1:
            result = colorCodes.tf3_text_color_gray + lc('extendedGUI.PremiumPanel.hours') + ' ' + lc('extendedGUI.PremiumPanel.toEnd') + ': ' + colorCodes.tf3_chat_default + str(hours)
        else:
            result = colorCodes.tf3_text_color_gray + lc('extendedGUI.PremiumPanel.minutes') + ' ' + lc('extendedGUI.PremiumPanel.toEnd') + ': ' + colorCodes.tf3_chat_default + str(minutes)
        return result

    def set_ninja(self, ninja):
        self.container.NinjaIcon.visible = ninja

    def set_premium(self, premium_id):
        self._premium_id = premium_id
        self._update_premium_block()
        self._update_booster_block()

    def set_booster(self, boost_id):
        self._boost_id = boost_id
        self._update_premium_block()
        self._update_booster_block()

    def set_premium_time(self, end_time):
        self._prem_end_time = end_time if end_time > 0 else -1

    def set_booster_time(self, end_time):
        self._boost_end_time = end_time if end_time > 0 else -1

    def _update_booster_block(self):
        bonuses = self.component.bonuses
        if self._premium_id == PREMIUM_OFF and not self._boost_id:
            self.container.position[0] = 0
            bonuses.visible = False
            return
        self.container.position[0] = 30
        bonuses.visible = True
        if not bool(self._boost_id):
            bonuses.booster.visible = False
            return
        booster_path = BoosterConfigParser.get_icon_path(self._boost_id, self._premium_id != PREMIUM_OFF, True)
        bonuses.booster.textureName = booster_path
        bonuses.booster.visible = True

    def _update_premium_block(self):
        bonuses = self.component.bonuses
        if self._premium_id == PREMIUM_OFF and not self._boost_id:
            self.container.position[0] = 0
            bonuses.visible = False
            return
        self.container.position[0] = 30
        bonuses.visible = True
        if self._premium_id == PREMIUM_OFF:
            bonuses.premium.visible = False
            return
        config = ClientSimpleConfigs().get_premium_config(self._premium_id)
        default_path = config.get('icon_path', '')
        bonuses.premium.textureName = config.get('icon_path_small', default_path)
        bonuses.premium.visible = True

    def set_old_HP_value(self, value, step = None):
        old = self.container.healthBar_old_val.clipper.value
        if not step:
            step = float(old - value) / 10.0
        new_val = old - step
        self.container.healthBar_old_val.clipper.value = new_val
        if new_val == old:
            return
        if self.old_HP_timer_id:
            BigWorld.cancelCallback(self.old_HP_timer_id)
        self.old_HP_timer_id = BigWorld.callback(0.1, partial(self.set_old_HP_value, value, step))

    def set_stamina_value(self, value, step = None):
        old = self.container.staminaBar.clipper.value
        if not step:
            step = float(old - value) / 10.0
        new_val = old - step
        self.container.staminaBar.clipper.value = new_val
        if new_val == old:
            return
        if self.stamina_timer_id:
            BigWorld.cancelCallback(self.stamina_timer_id)
        self.stamina_timer_id = BigWorld.callback(0.1, partial(self.set_stamina_value, value, step))

    def update(self):
        data = BWPersonality.GUICore.healthDataSection
        if data.has_key('name'):
            self.container.pName.text = data['name']
        if data.has_key('abshealth') and data.has_key('maxhealth'):
            old_hp = self.hp_value
            self.hp_value = data['abshealth'] / data['maxhealth'] if data['maxhealth'] else 0.0
            self.hp_abs_value = data['abshealth']
            self.container.healthBar.clipper.value = self.hp_value
            if old_hp == self.hp_value:
                self.set_old_HP_value(self.hp_value)
        if data.has_key('absstamina') and data.has_key('maxstamina'):
            stamina = data['absstamina'] / data['maxstamina'] if data['maxstamina'] else 0.0
            self.set_stamina_value(stamina)
        if data.has_key('isPL'):
            self.container.plMark.visible = data['isPL']
        player = BigWorld.player()
        if player:
            self.container.pvpFree.colour[3] = 30 if getattr(player, 'pvpFree') else 220
            namecolor = (175, 166, 112, 255)
            if player.AgrFlag:
                namecolor = colorCodes.rgba_mark_AGR
            if player.karma >= CharacterConst.PK_KARMA_PER_AGGR:
                namecolor = colorCodes.rgba_mark_name_PK
            self.container.pName.colour = tuple(namecolor)

    def handleMouseButtonEvent(self, comp, event):
        if not event.isMouseButton():
            return False
        down = event.isKeyDown()
        key = event.key
        if key == KEY_RIGHTMOUSE:
            if down:
                self.pressed = True
            elif self.pressed:
                self.pressed = False
                BWPersonality.GUICore.playerFrameEvent(self.EVENT_CONTEXT, None)
            return True
        else:
            return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, component):
        if component is self.container.plMark:
            BWPersonality.GUICore.toolTipEvent(self.TTID_PL_MARK, self.interfaceID, soToolTipComponent.EVENT_SHOW)
            return True
        return False

    def handleMouseLeaveEvent(self, component):
        if component is self.container.plMark:
            BWPersonality.GUICore.toolTipEvent(self.TTID_PL_MARK, self.interfaceID, soToolTipComponent.EVENT_HIDE)
            return True
        return False

    def show(self):
        GUIPositions.show(self)
        self.component.visible = True

    def hide(self):
        self.component.visible = False

    def stopDragging(self):
        GUIPositions.stopDragging(self)
        DraggableComponent.stopDragging(self)