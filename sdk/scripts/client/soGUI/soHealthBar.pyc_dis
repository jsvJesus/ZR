class Bonus(PyGUIBase):

    def __init__(self, component, tooltip_text_provider):
        PyGUIBase.__init__(self, component)
        self._tooltip_text_provider = tooltip_text_provider
        component.focus = True
        component.moveFocus = True
        component.crossFocus = True
        component.script = self

    def handleMouseEnterEvent(self, component):
        BWPersonality.GUICore.showToolTip(self._tooltip_text_provider(), delay=0)
        return True

    def handleMouseLeaveEvent(self, component):
        if BWPersonality.GUICore.toolTip:
            BWPersonality.GUICore.toolTip.hide()
        return True


