    def updateHPBlink(self):
        BigWorld.callback(self.HP_BLINK_TIME, self.updateHPBlink)
        if self.hp_abs_value > 40.0:
            self.container.healthBar.colour.x = 255
        else:
            red = self.container.healthBar.colour.x
            self.container.healthBar.colour.x = 255 if red != 255 else 150

