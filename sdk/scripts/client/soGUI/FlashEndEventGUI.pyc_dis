# Embedded file name: ./client/soGUI/FlashEndEventGUI.py
import GUI
import BigWorld
import ItemsUtils
import BWPersonality
import ResourceLoader
from time import time
from Helpers.PyGUI import PyGUIBase
from Localization import lc

class FlashEndEventGUI(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.saved_time = 0
        self.update_timer_id = None
        self.delta_time = 0
        self.last_time_tick = None
        self.setupRoot()
        self.setupContent()
        self.doReposition()
        return

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (0, 0, 0, 36)
        cmp.materialFX = 'BLEND'
        cmp.width = 390
        cmp.height = 78
        cmp.position = (0, 20, 0)

    def setupContent(self):
        cmp = GUI.Simple('soGUI/frame/event_background.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.width = cmp.height = 2.0
        cmp.position = (0, 0, 1)
        self.component.addChild(cmp, 'background')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = 'PIXEL'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.position = (195, 45, 0.5)
        cmp.text = '00:00:00'
        self.component.addChild(cmp, 'text')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = 'PIXEL'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.font = 'RobotoCondensedRegular_16.font'
        cmp.position = (0, 45, 0.5)
        cmp.text = '00:00:00'
        self.component.addChild(cmp, 'time')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.multiline = True
        cmp.font = 'RobotoCondensedRegular_32.font'
        cmp.position = (0, 5, 0.5)
        cmp.text = u'0'
        self.component.addChild(cmp, 'title')

    def bind_to_parent(self):
        if self.component.parent is None:
            layer = BWPersonality.GUICore.flashWorldLayer
            self.bind_to_parrent_layer(layer)
        return

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'eventTimerGUI')
        self.component.visible = True
        return

    def hide(self):
        self.component.visible = False

    def handleKeyEvent(self, event):
        return False

    def doReposition(self):
        pass

    def on_timer_stop(self):
        self.visible = False

    def set_timer(self, duration = 0, is_win = False, event_mode = 0, custom_message = ''):
        self.saved_time = time() + duration
        self.custom_message = custom_message
        if duration > 0:
            self.update_title(is_win)
            self.update_text(is_win, event_mode)
        self.update_timer()

    def update_title(self, is_win):
        text = lc('GUI.event_gui.success') if is_win else lc('GUI.event_gui.fail')
        self.component.title.text = text
        self.component.title.colour = (0, 255, 0, 255) if is_win else (255, 0, 0, 255)

    def update_text(self, is_win, event_mode):
        print '[DEBUG] update_text is_win=%s event_mode=%s' % (is_win, event_mode)
        import traceback
        traceback.print_stack()
        time_left = max(self.saved_time - time(), 0)
        self.component.time.visible = 1
        w1 = self.component.time.stringDimensions(ItemsUtils.timeToStringSec(time_left))[0]
        position_x = 195 - w1 / 2.0 - 3
        if event_mode:
            if is_win:
                text = lc('GUI.event_gui.dung_success')
            else:
                text = lc('GUI.event_gui.dung_fail')
                position_x = 195
                self.component.time.visible = 0
        else:
            text = lc('GUI.event_gui.end_timer_text')
        if self.custom_message:
            text = lc(self.custom_message)
        self.component.text.text = text
        self.component.text.position.x = position_x
        w = self.component.text.stringDimensions(text)[0]
        self.component.time.position.x = position_x + 0.5 * w + 2

    def update_timer(self):
        if self.last_time_tick:
            duration = time() - self.last_time_tick
            self.delta_time = +duration - 1
        time_left = max(self.saved_time - time(), 0)
        self.component.time.text = ItemsUtils.timeToStringSec(time_left)
        if time_left:
            self.update_timer_id = BigWorld.callback(1, self.update_timer)
        else:
            self.hide()