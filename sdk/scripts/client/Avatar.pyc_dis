    @if_not_destroyed
    def start_looting(self, looting_type, duration, knife_type, target_id):
        if self.dead:
            return
        self.pushTrackerLockByName('looting', 'Belly-Belly2-PistolHolster', lock_track_head=True, lock_track_torso=True, print_error=False)
        self.drawStartLootingAnimation(looting_type, duration, knife_type, target_id)
        target = BigWorld.entities.get(target_id)
        if target:
            self.__looting_target_id = target_id
            if hasattr(target, 'change_model_butch'):
                target.change_model_butch(duration)

    def on_looting_stopped(self):
        self.popTrackerLock('looting')
        if self.__looting_target_id:
            target = BigWorld.entities.get(self.__looting_target_id)
            if target and target.__class__.__name__ in Constants.ALL_CREATURE_CLASSES:
                target.stop_model_butch()
            self.__looting_target_id = 0

    @if_not_destroyed
    def error_stop_looting(self):
        self.popTrackerLock('looting')
        self.stopAnimationClear()
        self.on_looting_stopped()

