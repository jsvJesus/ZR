    def setCaps(self, caps):
        self.targetCaps = caps

    def addCaps(self, caps):
        if caps not in self.targetCaps:
            self.targetCaps += [caps]

    def removeCaps(self, caps):
        if caps in self.targetCaps:
            tmp = list(self.targetCaps)
            tmp.remove(caps)
            self.targetCaps = tmp

