    def onWeaponUpgrade(self, itemID):
        slot_name = ItemsUtils.getWeaponSlotNameByItemID(self, itemID)
        if not slot_name:
            return
        else:
            if not getattr(self, '_prev_weapon_slots', None):
                self._prev_weapon_slots = {}
            if slot_name in self.weapon_slots:
                self._prev_weapon_slots[slot_name] = self.weapon_slots[slot_name]
            self.makeWeaponAndAttach(slot_name)
            self._prev_weapon_slots.pop(slot_name, None)
            return

