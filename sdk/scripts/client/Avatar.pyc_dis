    def onPourWaterToPot(self, drawwel_type = 0):
        if not self.model:
            return
        if drawwel_type == DrawWellUtil.DRAWWEL_TYPE_SOUND.PUMP:
            self._pour_water_sound = sounds.playSound('players/filling_flask', self.model)
        else:
            self._pour_water_sound = sounds.playSound('players/filling_lake', self.model)

    def onCancelPourWaterToPot(self):
        if getattr(self, '_pour_water_sound', None):
            self._pour_water_sound.stop()
            self._pour_water_sound = None
        return

