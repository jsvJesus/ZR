    def onTeleportCalled(self, teleport_type, expected_position):
        """ \xd0\xb2 GPS \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xb4\xd0\xb2\xd1\x83\xd1\x85\xd1\x81\xd1\x82\xd1\x83\xd0\xbf\xd0\xb5\xd0\xbd\xd1\x87\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb9 (\xd1\x83\xd0\xb6\xd0\xb5 \xd0\xbd\xd0\xb5\xd1\x82) \xd1\x82\xd0\xb5\xd0\xbb\xd0\xb5\xd0\xbf\xd0\xbe\xd1\x80\xd1\x82 (\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb4\xd1\x91\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xb4\xd0\xb2\xd0\xb0 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xb0) """
        self.stopVertiacalLadder()
        Cabuser.onTeleportCalled(self)
        if (self.position - expected_position).length > 0.5:
            self._teleport_positions_towait = (self.position, expected_position)
        self.filter = BigWorld.DumbFilter()

    def onTeleportEnded(self, wasSuccessful, direction):
        """
                \xd0\xb8\xd0\xb7 \xd0\xb7\xd0\xb0 \xd0\xb2\xd0\xbe\xd0\xbb\xd0\xb0\xd1\x82\xd0\xb0\xd0\xb1\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xba\xd0\xbe\xd0\xbe\xd1\x80\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x82 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8\xd0\xb9\xd1\x82\xd0\xb8 \xd1\x80\xd0\xb0\xd0\xbd\xd1\x8c\xd1\x88\xd0\xb5,
                \xd1\x87\xd0\xb5\xd0\xbc \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbe\xd1\x80\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xbd\xd0\xb0 \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb5
                onTeleportCompleted \xd0\xb3\xd0\xb0\xd1\x80\xd0\xb0\xd0\xbd\xd1\x82\xd0\xb8\xd0\xb9\xd0\xbd\xd0\xbe \xd0\xb4\xd1\x91\xd1\x80\xd0\xbd\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbe\xd1\x80\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x82
                \xd0\xb2 GPS \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f (\xd1\x83\xd0\xb6\xd0\xb5 \xd0\xbd\xd0\xb5\xd1\x82) \xd0\xb4\xd0\xb2\xd1\x83\xd1\x85\xd1\x81\xd1\x82\xd1\x83\xd0\xbf\xd0\xb5\xd0\xbd\xd1\x87\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb9 \xd1\x82\xd0\xb5\xd0\xbb\xd0\xb5\xd0\xbf\xd0\xbe\xd1\x80\xd1\x82 (\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb4\xd1\x91\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xb4\xd0\xb2\xd0\xb0 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xb0)
        """
        self.stopVertiacalLadder()
        if BigWorld.player() is not self:
            self.filter = self.default_filter()
        if not self._teleport_positions_towait:
            self.onTeleportCompleted()
            return

        def wait_for_coord_change():
            if not self._teleport_positions_towait:
                return True
            old_pos, new_pos = self._teleport_positions_towait
            to_new_pos_dist = self.position.flatDistTo(new_pos)
            if to_new_pos_dist < 0.1:
                return True
            to_old_pos_dist = self.position.flatDistTo(old_pos)
            if to_new_pos_dist < to_old_pos_dist:
                return True
            return False

        def on_end_wait(result):
            self._teleport_positions_towait = None
            if result:
                self.onTeleportCompleted()
            return

        wait(wait_for_coord_change, partial(on_end_wait, True), 30, partial(on_end_wait, False))

