    def set_clanName(self, old_value):
        player = BigWorld.player()
        if not player:
            return
        else:
            pl_clanName = getattr(player, 'clanName', None)
            if pl_clanName and pl_clanName in (self.clanName, old_value):
                player.updateOnlineClanMembers()
            self.updateVisibleForPlayer()
            return

