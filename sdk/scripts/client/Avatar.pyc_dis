    def debug_draw_figure(self, fig_type, position, radius, replace):
        """ \xd0\xbd\xd0\xb0\xd1\x80\xd0\xb8\xd1\x81\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd1\x88\xd0\xb0\xd1\x80\xd0\xb8\xd0\xba (\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb0)
                replace - \xd0\xb7\xd0\xb0\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd1\x8b\xd0\xb5 \xd1\x88\xd0\xb0\xd1\x80\xd1\x8b
        """
        import draw_utils_extend
        import DrawPrimitivesUtils
        if not hasattr(self, '_debug_sphere_holder'):
            self._debug_sphere_holder = draw_utils_extend.LinesHolder(max_lines=0)
        if replace:
            self._debug_sphere_holder.clear()
        if fig_type == Constants.TYPE_SPHERE:
            DrawPrimitivesUtils.draw_sphere(position, radius, holder=self._debug_sphere_holder)
        elif fig_type == Constants.TYPE_CYLINDER:
            DrawPrimitivesUtils.draw_cilinder(position, radius, 100, holder=self._debug_sphere_holder, alwaysdraw=False)

