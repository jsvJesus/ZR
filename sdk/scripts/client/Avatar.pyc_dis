    def onStartReloadLauncherWeapon(self, grenade_type):
        """        \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80 \xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb \xd0\xb7\xd0\xb0\xd1\x80\xd1\x8f\xd0\xb6\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd1\x82\xd0\xb2\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xb8\xd0\xba      """
        print self, 'onStartReloadLauncherWeapon', grenade_type
        item = None
        if grenade_type:
            item = ItemsUtils.CreateComplexItem(-111, grenade_type)
        self.reloadLauncherWeapon(item)
        return

    def onStartUnjammWeapon(self):
        self.unjammWeapon()

    def onStartReloadWeapon(self, weapon_slot, new_ammo_type, reload_speed = 1.0):
        if weapon_slot and not weapon_slot['itemType']:
            weapon_slot = None
        if not self.active_weapon:
            print 'WARNING no active_weapon', self
            raise ValueError
        self.active_weapon.new_ammo_type = new_ammo_type
        self.active_weapon.new_weapon_slot = weapon_slot
        self.reloadWeapon(weapon_slot, reload_speed=reload_speed)
        return

    def onCancelReloadWeapon(self, magaz_slot, new_ammo_type):
        AvatarTrackers.cancelReloadWeapon(self, True, magaz_slot=magaz_slot, ammo_type=new_ammo_type)

    def onCancelReloadWeaponManual(self):
        AvatarTrackers.cancelReloadWeapon(self, True)

    def onStartReloadWeaponManual(self, need_ammo_number, new_ammo_type, reload_speed = 1.0):
        if not self.active_weapon:
            return
        else:
            self.active_weapon.need_ammo_number = need_ammo_number
            self.active_weapon.new_ammo_type = new_ammo_type
            ammo_item = None
            if new_ammo_type:
                ammo_item = ItemsUtils.createNewItem(new_ammo_type, -1, count=need_ammo_number)
            self.reloadWeapon(ammo_or_magazine_item=ammo_item, reload_speed=reload_speed)
            return

