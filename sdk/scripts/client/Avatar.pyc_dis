        self.worldLoadReact()

    def add_collider(self):
        Victim.add_collider(self)
        if self.active_transform and self.active_transform.raw_configs.get('isHelicopter'):
            if not self.vechicle_contorled or not self.vechicle_contorled._model:
                return
        if self.active_transform and self.active_transform.colliders() != 'DEF':
            cld = self.active_transform.colliders()
            if not cld:
                return
            for bbox in cld:
                transform = bbox.get('transform', None)
                self.attach_collider_box(bbox[COLLIDER_BOX_NAME], bbox[COLLIDER_NODE_NAME], bbox[COLLIDER_BODY_ZONE], bbox[COLLIDER_MIN_BOUNDS], bbox[COLLIDER_MAX_BOUNDS], transform)

            return
        else:
            try:
                for entry in colliders_config.values():
                    bone = entry['nodeName'].asString
                    minBounds = entry['minBounds'].asVector3
                    maxBounds = entry['maxBounds'].asVector3
                    transform = entry['transform'].asMatrix if entry.has_key('transform') else None
                    body_zone = Config.Damage.get_body_zone(entry['bodyZone'].asString)
                    if transform:
                        transform.translation = transform.translation
                    self.attach_collider_box(bone, bone, body_zone, minBounds, maxBounds, transform)

            except:
                traceback.print_exc()

            box = BigWorld.ObstacleAttachment('characters2/skeleton_box/head_hb.model')
            box.bodyIndex = 100
            box.name = 'Head'
            node = self.getCurrentModel().node('Head')
            node.attach(box)
            self.skeletonCollider.addCollider(box)
            self.colliderNames['Head'] = BODY_ZONES.HEAD
            self.collider_nodes['Head'] = ('Head', node)
            self.collider_boxes['Head'] = box
            return

    def default_filter(self):
        return BigWorld.AvatarFilter()

    def onEnterWorld(self, prereqs = None):
        if self != BigWorld.player():
            self.filter = self.default_filter()
        if getattr(self, 'transformationID', 0):
            self.set_transformationID(0)
        CandleUser.onEnterWorld(self, prereqs)
        AvatarTrackers.onEnterWorld(self, prereqs)
        FootPrinter.onEnterWorld(self)
        self.UpdateAvatarModel()
        if hasattr(self, 'worldLoad'):
            self.worldLoadReact()
        BigWorld.player().avatarOnEnterWorld(self)
        BurnInterface.onEnterWorld(self)
        AvatarItemHolder.onEnterWorld(self)
        DressInterface.onEnterWorld(self)
        self._tick_caps_slope()
        Soakable.onEnterWorld(self)
        Woundable.onEnterWorld(self)
        self.last_space_name = BigWorld.player().getSpaceName()
        PersistentAvatarSfx.onEnterWorld(self)
        if self.__class__.__name__ == 'Avatar':
            avatar_name_to_id[self.name.lower()] = self.id
            if BWPersonality.GUICore.minimap:
                BWPersonality.GUICore.minimap.on_avatar_enter_world(self.id)
        TransportUser.onEnterWorld(self)
        InteractorUser.onEnterWorld(self)
        HelicopterUser.onEnterWorld(self)
        GunPointUser.onEnterWorld(self)

    def ignorGravityAnimationNotifier(self, val):
        self._ignorGravityAnimation = val
        self.updateTorsoFlags()

    def inAirNotifier(self, fallingVelocity, inAir):
        if self.in_transport and inAir:
            return
        self._inAir = inAir
        self.checkHandInAir(inAir)
        self.checkWaterinAirNotifier(fallingVelocity, inAir)
        self.updateTorsoFlags()

    def onInAir(self, inAir):
        self.inAirNotifier(0, inAir)
        self.updateBlendNodeByImpacting()

    def isJump(self):
        return self.lock_move_by_jump or self._is_jump or self._jmp_down_played

