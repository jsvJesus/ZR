            if not speakarea:
                foo = partial(BigWorld.player().goto_point, position, yaw, arrived)
                BigWorld.callback(0.1, foo)
                return
            speakarea.cell.arrived(BigWorld.player().id, success)

        BigWorld.player().goto_point(position, yaw, arrived)

