    def _get_nearest_flag(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3 \xd1\x80\xd1\x8f\xd0\xb4\xd0\xbe\xd0\xbc \xd1\x81 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xbc \xd1\x81\xd1\x82\xd0\xbe\xd0\xb8\xd1\x82 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80."""
        for ent in BigWorld.entities.values():
            if isinstance_ext(ent, 'BaseFlagToCapture') and ent.position.distTo(self.position) <= ANIMATION_DIST + 0.2:
                return ent

        return None

    def cancel_raise_flag_animation(self):
        if not self.hoisting_flag:
            return
        else:
            if self.model:
                self.model.use_flag_in.stop()
                self.model.use_flag_loop.stop()
                self.model.use_flag_out.stop()
            self.moving_locked = False
            self.setControlLock(Constants.ControlLockTypes.HOST_FLAG, False)
            self.hoisting_flag = None
            self.popTrackerLock('go_raise_flag_animation')
            BigWorld.cancelCallback(self._raise_flag_id)
            return

    def go_raise_flag_animation(self):
        """\xd0\x97\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbf\xd0\xbe\xd0\xb4\xd1\x8a\xd1\x91\xd0\xbc\xd0\xb0 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0."""
        if self != BigWorld.player():
            if not self.hoisting_flag:
                self.hoisting_flag = self._get_nearest_flag()

        def start_raising():
            self.pushTrackerLockByName('go_raise_flag_animation', 'Belly-Belly2-PistolHolster', lock_track_head=True, lock_track_torso=True, print_error=False)
            self.setControlLock(Constants.ControlLockTypes.HOST_FLAG, True)
            self.stopPlayerMoving()
            self.resetFootTwist()

        if self.hoisting_flag and self.clanName == self.hoisting_flag.clan_owner_name and self.hoisting_flag.is_max_height:
            self.model.use_flag_in().use_flag_loop()
            start_raising()
        if 'use_flag_loop' not in self.model.queue:
            self.model.use_flag_loop()
            start_raising()
            self.moving_locked = True
            self.resetFootTwist()
        self.update_turn_states()

        def stop_raising():
            if self.isDestroyed:
                return
            else:

                def onEndAnim(*e):
                    self.popTrackerLock('go_raise_flag_animation')

                self.model.use_flag_loop.stop()
                self.model.use_flag_out(0, onEndAnim)
                self.moving_locked = False
                self.setControlLock(Constants.ControlLockTypes.HOST_FLAG, False)
                self.hoisting_flag = None
                self.update_turn_states()
                return

        BigWorld.cancelCallback(self._raise_flag_id)
        self._raise_flag_id = BigWorld.callback(CHECK_INTERVAL + 0.5, stop_raising)

