    def world_teleport_from_map(self, position, space_name):
        if self.offline_mode:
            position = Math.Vector3(position[0], 0, position[1])
            res = BigWorld.collideIgnoreFlags(self.spaceID, Math.Vector3(0, 500, 0) + position, position - Math.Vector3(0, 500, 0))
            if res and res[0]:
                position = res[0]
            self.physics.teleport(position, (self.yaw, 0, 0))
        else:
            self.cell.teleportFromGPS(position, space_name)

