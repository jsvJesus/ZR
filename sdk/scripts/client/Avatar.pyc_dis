        SFXer.DeathEffect(self, underwater=self.underWaterLevel3)

    def set_dead_oldBaseModel(self, old_value):
        if not self.dead:
            try:
                self.model.action('Dead%i' % old_value).stop()
                self.model.action('Die%i' % old_value).stop()
            except:
                print 'set_dead error', self, 'old_value = ', old_value
                traceback.print_exc()

            self.UpdateAvatarAnimationCaps()
        if self.dead:

            def __onDeathDrawn(*e):
                if self.isDestroyed:
                    return
                self.UpdateAvatarAnimationCaps()

            getattr(self.model.action('Die%i' % self.dead)(0, __onDeathDrawn), 'Dead%i' % self.dead)()

    @property
    def respawned_recently(self):
        """ \xd0\x98\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba \xd0\xbd\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xb2\xd0\xbd\xd0\xbe \xd0\xb2\xd0\xbe\xd0\xb7\xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xbb\xd1\x81\xd1\x8f \xd0\xb8 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xb5\xd1\x82 \xd0\xb1\xd0\xb5\xd1\x81\xd0\xbc\xd0\xb5\xd1\x80\xd1\x82\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd1\x83\xd0\xbb\xd1\x8c \xd0\xb4\xd1\x80\xd1\x83\xd0\xb3\xd0\xb8\xd1\x85 \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba\xd0\xbe\xd0\xb2
        http://hz-dev.stalker.so:8090/issues/11568 """
        return self._respawned_recently

    def _set_respawned_recently(self, delay):
        self._respawned_recently = True

        def disable():
            if self.isDestroyed:
                return
            self._respawned_recently = False

        if getattr(self, '_rr_id', 0):
            BigWorld.cancelCallback(self._rr_id)
        self._rr_id = BigWorld.callback(delay, disable)

    @ignoreError
    def set_dead(self, old_value):
        if not self.model:
            return
        try:
            if self.dead:
                self.model.CloseEyes()
            else:
                self.model.Wink()
        except:
            pass

        self.cancelThrowGrenade()
        self.cancel_raise_flag_animation()
        self.model.isCalcBoundBoxFromNodes = self.dead
        if self.active_transform:
            dead = self.active_transform.getparam('Dead_animation')
            die = self.active_transform.getparam('Die_animation')
            if dead and die:
                dead = str(dead)
                die = str(die)
                if not self.dead and old_value:
                    try:
                        self.model.action(dead).stop()
                        self.model.action(die).stop()
                    except:
                        print 'set_dead error', self, [dead, die]
                        traceback.print_exc()

                else:
                    getattr(self.model.action(die)(), dead)()
                return
        if getattr(self, 'npcSuit', False):
            try:
                self.set_dead_oldBaseModel(old_value)
            except:
                traceback.print_exc()

            return
        if not self.dead:
            BigWorld.player().checkCancelPlayFinishDead(self.id)
        if not self.dead and old_value:

            def stop_action(act_name):
                try:
                    self.model.action(act_name).stop()
                except:
                    print 'error for', self, act_name
                    traceback.print_exc()

            dead_in, dead_loop, dead_up = self.getDeadAnimations(old_value)
            stop_action(dead_in)
            stop_action(dead_loop)

            def onEndAnimUp(*e):
                if self.isDestroyed:
                    return
                self.onGetUpPlayed(False)
                self.setDirectionProviderParam(force=True)
                self.popTrackerLock('looting')

            if self.teamID:
                self.setDirectionProviderParam(force=True)
            else:
                dead_up = self.model.action(dead_up)
                duration = max(1.0, dead_up.duration - 0.1)
                dead_up()
                BigWorld.callback(duration, onEndAnimUp)
                self.onGetUpPlayed(True)
            self.UpdateAvatarAnimationCaps()
            self.updateHandControl()
            self.updateCrawlMode()
            self.update_turn_states()
            self.onDeadChange()
            self._set_respawned_recently(2.5)
            return

        def __onDeathDrawn():
            if self.isDestroyed:
                return
            self.UpdateAvatarAnimationCaps()
            self.updateBlendNodeByImpacting(only_factor=True)

        dead_in, dead_loop, dead_up = self.getDeadAnimations(self.dead)
        try:
            ob = self.model.action(dead_in)(0, __onDeathDrawn)
            getattr(ob, dead_loop)()
        except Exception:
            print
            print self, [dead_in, dead_loop, dead_up]
            traceback.print_exc()

        try:
            if self.isRelaodWeaponProgress:
                self.cancelReloadWeapon()
        except:
            print self
            traceback.print_exc()

        BigWorld.callback(0.25, self.UpdateAvatarAnimationCaps)
        self.updateHandControl()
        self.updateCrawlMode()
        self.setDirectionProviderParam(force=True)
        self.update_turn_states()
        self.onDeadChange()

    def on_revive(self):
        Victim.on_revive(self)
        PartyMember.on_revive(self)
        AnimationCaps.setCap(self.model, 'Dead', False)
        self.stopUsingItemAnimation()
        if self._craft_animation:
            self.drawEndCrafting()
        if self._disassembling_animation:
            self.drawEndDisassembling()
        if self.deadCallback:
            BigWorld.cancelCallback(self.deadCallback)
            self.deadCallback = None
        if hasattr(self, 'respawn_msgbox_id') and self.respawn_msgbox_id:
            BWPersonality.GUICore.closeMessageBox(self.respawn_msgbox_id)
        if hasattr(self, 'askIDteamNo') and self.askIDteamNo:
            BWPersonality.GUICore.closeMessageBox(self.askIDteamNo)
            self.askIDteamNo = None
        return

    def setInjuredMode(self, injured = True):
        self._is_injured = injured
        self.UpdateAvatarAnimationCaps()

    def onInjuredHurting(self):
        if getattr(self, '_injuredhurting_played', False):
            return
        if not self.model:
            return
        if self.dead:
            return

        def on_end_injuredhurting(*e):
            self._injuredhurting_played = False
            self.popTrackerLock('injuredhurting')
            self.setControlLock('injuredhurting', False)

        self.pushTrackerLockByName('injuredhurting', weapon_to='Belly-Belly2-PistolHolster', lock_track_torso=True, lock_track_head=True, print_error=False)
        self.setControlLock('injuredhurting', True)
        self._injuredhurting_played = True
        self.model.idle_injuredhurting_stay_unarmed(0, on_end_injuredhurting)
        return True

    def on_damaged(self, source_data, damagetaken_data):
        self.on_damaged_transform(source_data, damagetaken_data)
        Victim.on_damaged(self, source_data, damagetaken_data)
        if source_data['entity_id'] == BigWorld.player().id:
            return
        self.bleed_on_damage(source_data, damagetaken_data)
        damager = BigWorld.entity(source_data['entity_id'], True)
        if damager:
            if source_data['type'] == Config.Damage.SourceTypes.CREATURE:
                damager_pos = damager.position + (0, damager.get_height_idle_scaled(), 0)
                self.wound_directed(damager_pos)

    def on_grenade_damaged(self, damage, grenade_position, collided_id, collision_data):
        if self.id != collided_id:
            self.wound_directed(grenade_position)

