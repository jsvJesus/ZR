    def UpdateAvatarAnimationCaps(self):
        if self.isDestroyed:
            return
        caps_list = self.getAvatarAnimationCaps()
        AnimationCaps.setCapsList(self.model, caps_list)

    def getCurrentModelAnimationCaps(self):
        """\xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba matchCaps \xd0\xb2 \xd1\x87\xd0\xb8\xd1\x82\xd0\xb0\xd0\xb5\xd0\xbc\xd0\xbe\xd0\xbc \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5"""
        res = []
        if not self.model:
            return res
        if not self.model.motors:
            return res
        if not hasattr(self.model.motors[0], 'matchCaps'):
            return res
        for caps in sorted(self.model.motors[0].matchCaps):
            res.append('%s:%s' % (caps, AnimationCaps.getCapNameById(caps)))

        return res

    def getEquippedItemType(self):
        return ItemsUtils.GetEquippedItemType(self)

    def UpdateCrouch(self):
        self.UpdateAvatarAnimationCaps()

    def UpdateCrawl(self):
        self.UpdateAvatarAnimationCaps()

    def onLoadModel(self, model):
        if self.isDestroyed:
            return
        visible = True
        if self.model:
            visible = self.model.visible
            self._last_model_yaw = self.model.yaw
        self.model = model
        raise ValueError('old!')

