    _is_injured = False

    def getAvatarAnimationCaps(self):
        caps_list = []
        if self.dead:
            caps_list.append('Dead')
        weapon = self.active_weapon
        if self.active_transform:
            caps = self.active_transform.getparam('AnimationCaps')
            caps and caps_list.extend(caps)
            return caps_list
        else:
            if not weapon:
                weapon = self.active_transform.getparam('force_to_weapon_incombat')
            if self.active_weapon and not self.active_weapon.isPistol() and self.candle:
                weapon = None
            if self.active_melee:
                caps_list.append('ACTIVE_MELEE')
            if weapon or self.active_melee:
                caps_list.append('AutogunArmed')
                if self.weaponStatus == Constants.WEAPON_SNIPING:
                    caps_list.append('Aiming')
                if self.weaponStatus == Constants.WEAPON_BORED:
                    caps_list.append('BORED')
                if self.hasCapWeaponRightHand():
                    caps_list.append('WEAPON_RIGHT_HAND')
            else:
                caps_list.append('Unarmed')
            if self.isFPSmode():
                caps_list.append('FPS')
            if self.IsAvatarCrawling():
                caps_list.append('CRAWL')
            if self.IsAvatarCrouched():
                caps_list.append('Crouching')
            if self._isladder:
                caps_list.append('LADDER_DOWN')
            elif self._slope_caps == 'DOWN':
                caps_list.append('SLOPE_DOWN')
            if self.patrol_mode:
                caps_list.append('PATROL')
            if self._is_tired or self._is_tired_after_sprint:
                caps_list.append('TIRED')
            if self.underWaterLevel2:
                caps_list.append('InWaterHips')
            if self.underWaterLevel3:
                caps_list.append('InWaterHead')
            if self._is_injured:
                caps_list.append('Injured')
            return caps_list

    def set_patrol_mode(self, old_value):
        self.UpdateAvatarAnimationCaps()

