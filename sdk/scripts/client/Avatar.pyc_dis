            return 600
        else:
            return self.active_weapon.getAmmoType()

    __shot_played = False

    def palyAnimationShot(self):
        if self.__shot_played:
            return
        elif not self.model:
            return
        else:
            self.__shot_played = True
            try:
                framerate = self.model.shot.frameRate
                if self.active_weapon:
                    self.active_weapon.triggerPressAnimation(True)
                    trigger_time = self.active_weapon.getTriggeringTime()
                    if trigger_time:
                        framerate = self.model.shot.frameRate * self.model.shot.duration / trigger_time
                        if framerate < 1:
                            framerate = 1
                self.model.shot(0, None, 0, -1, -1, framerate)
            except:
                traceback.print_exc()
                print 'palyAnimationShot error:', self

            return

    _left_mouse_button = False

    def stopAnimationShot(self):
        if self.active_weapon:
            self.active_weapon.onStopAnimationShot()
        if self._left_mouse_button:
            return
        self.__shot_played = False
        try:
            if self.model:
                self.model.shot.stop()
        except:
            traceback.print_exc()
            print 'stopAnimationShot error:', self

        if self.active_weapon:
            self.active_weapon.triggerPressAnimation(False)

    __shot_played_left = False

    def playAnimationShotLeft(self):
        if self.__shot_played_left:
            return
        if not self.model:
            return
        self.__shot_played_left = True
        try:
            if self.active_weapon:
                self.active_weapon.triggerPressAnimationLeft(True)
            self.model.handgrip_left_shot()
        except:
            traceback.print_exc()

    def stopAnimationShotLeft(self):
        if self._left_mouse_button:
            return
        self.__shot_played_left = False
        if self.model:
            try:
                self.model.handgrip_left_shot.stop()
            except:
                traceback.print_exc()

        if self.active_weapon:
            self.active_weapon.triggerPressAnimationLeft(False)

