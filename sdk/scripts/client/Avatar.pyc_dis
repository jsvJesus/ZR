    _eff_anim_id2count = defaultdict(int)

    def beginEffAnimation(self, animId):
        if not self.model:
            return
        self.cancel_reload()
        conf = ANIMATIONS_BY_EFF[animId]
        model_action = self.model.action(conf['action'])
        self._eff_anim_id2count[animId] += 1
        if conf['trackerLock'] and not self.hasTrackerLockByName('beginEffAnimation_%s' % animId):
            self.pushTrackerLockByName(('beginEffAnimation_%s' % animId), **conf['trackerLock'])
        BigWorld.callback(model_action.duration, partial(self._onCompleteEffAnimation, animId))
        model_action()

    def _onCompleteEffAnimation(self, animId):
        if self.isDestroyed:
            return
        self._eff_anim_id2count[animId] -= 1
        if self._eff_anim_id2count[animId] < 1:
            del self._eff_anim_id2count[animId]
            self.popTrackerLock('beginEffAnimation_%s' % animId)

    def endEffAnimation(self, animId):
        self.popTrackerLock('beginEffAnimation_%s' % animId)
        conf = ANIMATIONS_BY_EFF[animId]
        model_action = self.model.action(conf['action'])
        model_action.stop()

