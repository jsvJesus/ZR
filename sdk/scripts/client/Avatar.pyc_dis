    def onLeaveWorld(self):
        PersistentAvatarSfx.onLeaveWorld(self)
        CandleUser.onLeaveWorld(self)
        Woundable.onLeaveWorld(self)
        Mailable.onLeaveWorld(self)
        BurnInterface.onLeaveWorld(self)
        PartyMember.onLeaveWorld(self)
        SprayerHolder.onLeaveWorld(self)
        self.clearPistolHolster()
        if hasattr(self, 'nameBoxAtch') and self.model:
            self.model.root.detach(self.nameBoxAtch)
        if self.showNameCallbacker is not None:
            BigWorld.cancelCallback(self.showNameCallbacker)
        if self.hideNameCallbacker is not None:
            BigWorld.cancelCallback(self.hideNameCallbacker)
        self.nameBoxAtch = None
        self.nameBox = None
        self.clanBox = None
        self.right_hand_model_sound_node = None
        self.clearAvatarGuns()
        player = BigWorld.player()
        if player and player.__class__.__name__ == 'PlayerAvatar':
            player.avatarLeaveWorld(self.id)
            player.checkCancelPlayFinishDead(self.id)
        FootPrinter.onLeaveWorld(self)
        self.autogunModel = None
        self._using_attach_model = None
        self.active_weapon = None
        self.active_weapon_model = None
        if self.radiometer:
            self.radiometer.onLeaveWorld()
            self.radiometer = None
        AvatarItemHolder.onLeaveWorld(self)
        BigWorld.cancelCallback(self._id_slope_timer)
        TurnAvatar.stop_loop_turn(self)
        AvatarTrackers.onLeaveWorld(self)
        Soakable.onLeaveWorld(self)
        TransportUser.onLeaveWorld(self)
        UsingItemAnimation.onLeaveWorld(self)
        Gestures.onLeaveWorld(self)
        Transformation.onLeaveWorldTransform(self)
        if self._headlight:
            self._headlight.onLeaveWorld()
        self._headlight = None
        self.model = None
        self.clearColliders()
        if self.__class__.__name__ == 'Avatar':
            avatar_name_to_id.pop(self.name.lower(), None)
            if BWPersonality.GUICore.minimap:
                BWPersonality.GUICore.minimap.on_avatar_leave_world(self.id)
        InteractorUser.onLeaveWorld(self)
        return

    def throw_grenade(self, position, velocity, original_id, target_id, duration, grenade_type):
        """ \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80 \xd1\x82\xd1\x80\xd0\xb5\xd0\xb1\xd1\x83\xd0\xb5\xd1\x82 \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0\xd1\x82\xd1\x83 \xd0\xb8 \xd1\x81\xd0\xbe\xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb5\xd0\xb9 \xd0\xb1\xd1\x80\xd0\xbe\xd1\x81\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f """
        params = {'fromServer': True,
         'originalID': original_id,
         'targetID': target_id}
        self.DrawThrow(velocity)
        self.throw(params, position, velocity, grenade_type)

    def end_throw_grenade(self, position, velocity, clientGrenadeID, throw_type):
        self.cell.throwGrenade(position, velocity, clientGrenadeID, throw_type)

    def fire_grenade(self, position, velocity, original_id, grenade_type):
        self.throw({'originalID': original_id,
         'fromServer': True}, position, velocity, grenade_type)

    def onFireLauncherGreande(self, position, velocity, original_id, grenade_type, prematureExplosion = False, callbackOnThrow = None, fromServer = True):
        param = {}
        if fromServer:
            param = {'originalID': original_id,
             'fromServer': True}
        if prematureExplosion:
            param['prematureExplosion'] = True
        self.throw(param, position, velocity, grenade_type, callbackOnThrow=callbackOnThrow)
        launcher = self.active_weapon._first_launcher
        self.active_weapon.drawLaunch(position, velocity, grenade_type)
        if getattr(self, '_pygunRWnode', None):
            self._pygunRWnode.onFire(isBrust=False, launcher=launcher)
            self._pygunnode.onFire(isBrust=False, launcher=launcher)
        self.torsoRecoil(launcher=launcher)
        if fromServer:
            self.playAnimationShotLeft()
            BigWorld.callback(1, self.stopAnimationShotLeft)
        return

    def onFireGrenadeGun(self, position, velocity, clientGrenadeID, grenade_type, prematureExplosion):
        self.onPlayerFire()
        self.active_weapon.spendAmmo(1, False)
        param = {'originalID': clientGrenadeID,
         'fromServer': True}
        param['prematureExplosion'] = prematureExplosion
        self.throw(param, position, velocity, grenade_type)

    def returnModelToDefaultAfterThrow(self):
        self.is_throwing = False
        self.stopAnimGrenadeSwnig()
        self.returnModelToDefault()

    def DrawThrow(self, velocity, callback_on_throw_item = None):
        """Effects and actions for grenade throwing. """
        if not self.model:
            return

        def onEndAnim(*e):
            if self.isDestroyed:
                return
            self.popTrackerLock('drawStartThrowGrenade')
            self.is_throwing = False
            self.clearThrowModel()

        self.model.cue('onThrowItem', callback_on_throw_item or self.clearThrowModel)
        self.stopAnimGrenadeSwnig()
        offset_mult = 0.5
        if self.active_weapon and self.active_weapon.isPistol():
            offset_mult = self.LLLL
        self.playAnimation(self.model.use_stone_out, self.model.use_stone_out.duration, onEndAnim, stretch=True, offset_mult=offset_mult)

    LLLL = 0.4

    def drawStartCrafting(self):
        pass

    def drawCrafting(self, duration):
        UsingItemAnimation.drawCrafting(self, duration)

    def playAnimationByServer(self, action_name, duration, callback = None):
        if not action_name:
            return
        else:
            action = getattr(self.model, action_name, None)
            if duration == 0:
                duration = action.duration
            self.playAnimationClear(action, duration, callback or self.stopAnimationClear, stretch=True)
            return

    def stopGestures(self):
        self.stop_all_animations()

    def onStopGestueAniamtion(self, data = None):
        self.gesture_played_out = True
        self.update_turn_states()

    def onStopGestueAniamtionComplete(self, data = None):
        self.gesture_played_out = False
        self.update_turn_states()

    def drawPickupItem(self, duration):
        if not self.model:
            return
        self.flashlight_suspend()
        self.pushTrackerLockByName('drawPickupItem', 'Belly-Belly2-PistolHolster', lock_track_head=True, comment='drawPickupItem', print_error=False)
        self.setControlLock(Constants.ControlLockTypes.PICKUPING, True)
        action = self.model.use_pickup
        self.playAnimation(action, duration, self.DrawPickupItemEnd, stretch=True, offset_mult=0.9, on_cancel_callback=self.DrawPickupItemEnd)
        self._draw_pickup = True
        self.updateCameraPosition()
        self.update_turn_states()

    def getFiringPoint(self):
        raise ValueError
        if self.hp_barrel is not None:
            try:
                return Matrix(self.hp_barrel.node('HP_effect')).translation
            except:
                pass

        if self.hp_barrel_node is not None and self.hp_barrel_node.isActualCoords:
            return Matrix(self.hp_barrel_node).translation
        else:
            if self.crouching_or_crawling:
                spine_y = 0.64
            else:
                spine_y = 1.24
                if self.weaponStatus == Constants.WEAPON_SNIPING:
                    xshift = 0.1
                    yshift = 0.4
                else:
                    xshift = 0.2
                    yshift = 0.1
            avg_gun_length = 0.9
            return self.position + (0, spine_y, 0) + rotate_by_yaw_pitch((xshift, yshift, avg_gun_length), self.yaw, self.pitch)

    def nextSingleShot(self):
        self.nextSingleShotTimer = None
        if self.doNextSingleShot:
            self.singleShot()
        return

    def traceBullet(self, src, vector, potential_victims = None):
        """ \xd1\x82\xd1\x80\xd0\xb0\xd1\x81\xd1\x81\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb0 \xd0\xbf\xd1\x83\xd0\xbb\xd0\xb8 (\xd0\xbe\xd1\x81\xd0\xba\xd0\xbe\xd0\xbb\xd0\xba\xd0\xb0)
                src - \xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb0 \xd1\x82\xd1\x80\xd0\xb0\xd1\x81\xd1\x81\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb8
                vector - \xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x82\xd1\x80\xd0\xb0\xd1\x81\xd1\x81\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb8
                potential_victims - \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x81\xd1\x83\xd1\x89\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd0\xb5\xd0\xb9 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb8 \xd0\xba\xd0\xbe\xd0\xbb\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb8\xd0\xb9
                        (\xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 None - \xd0\xb1\xd1\x83\xd0\xb4\xd0\xb5\xd1\x82 \xd0\xb8\xd1\x81\xd0\xba\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81\xd0\xb0\xd0\xbc \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xb8\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb5\xd0\xb9 \xd0\xbf\xd0\xbe \xd0\xb2\xd1\x81\xd0\xb5\xd0\xbc \xd1\x81\xd1\x83\xd1\x89\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8f\xd0\xbc, \xd1\x82\xd0\xb0\xd0\xba \xd1\x87\xd1\x82\xd0\xbe \xd0\xbb\xd1\x83\xd1\x87\xd1\x88\xd0\xb5 \xd0\xba\xd1\x8d\xd1\x88\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c)
        """
        hitPoint = None
        hitPointDistSqr = vector.length ** 2
        valid_impact_threshold = 0.01
        hitKind = Avatar.traceBullet.HitKindNone
        hitParams = {'src': vector}
        hitParams = {'fireVector': vector}
        col = utils_bw.collideIgnoreNoVisible(self.spaceID, src, src + vector)
        if col and col[0]:
            pointWC, triWC, mat_id, _, _ = col
            vector = pointWC - src
            distToCollisionSqr = src.distSqrTo(pointWC)
            if distToCollisionSqr < hitPointDistSqr:
                hitPoint = pointWC
                hitPointDistSqr = distToCollisionSqr
                hitKind = Avatar.traceBullet.HitKindWorld
                hitParams.update({'triangle': triWC,
                 'material': mat_id})
        watercollide = self.waterCollide(src, src + vector)
        if watercollide:
            watercollide = watercollide[0]
        if watercollide:
            hitParams.update({'water_pos': watercollide})

        def checkWater(point):
            """
            \xd0\xbf\xd0\xbe\xd0\xb4 \xd0\xb2\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xb9 \xd0\xbf\xd1\x83\xd0\xbb\xd1\x8f \xd0\xbb\xd0\xb5\xd1\x82\xd0\xb8\xd1\x82 1 \xd0\xbc\xd0\xb5\xd1\x82\xd1\x80 (TODO config)
            """
            if watercollide and watercollide.distSqrTo(point) > 1:
                return False
            return True

        if DEBUG_TEST_CPPTRACE:
            dst = src + vector
            res = BigWorld.traceBullet(src, dst, self.id)
            if res:
                entityID, point, collider_name = res
                if not point:
                    print 'WARNING! BigWorld.traceBullet empty point!!!'
                    print 'src=', src
                    print 'dst=', dst
                    print 'self.id=', self.id
                    print 'point', point
                    print 'entityID', entityID
                    print 'collider_name', collider_name
                    traceback.print_stack()
                elif checkWater(point):
                    hitPoint = point
                    hitKind = Avatar.traceBullet.HitKindVictim
                    victim = BigWorld.entity(entityID)
                    if victim.colliderNames.has_key(collider_name):
                        hitParams.update({'entity': victim,
                         'reflection': -vector / vector.length,
                         'bodyZone': victim.colliderNames[collider_name]})
        else:
            if not potential_victims:

                def is_victim(entity):
                    return isinstance(entity, Victim) and entity != self and entity.position.distSqrTo(src) <= hitPointDistSqr + 5.0 and hasattr(entity, 'skeletonCollider') and entity.model.visible

                potential_victims = filter(is_victim, BigWorld.entities.values())
            for victim in potential_victims:
                direction = Vector3(vector)
                direction.normalise()
                if victim.skeletonCollider.doCollide(src, direction):
                    p = victim.skeletonCollider.impactPoint
                    if math.isnan(p[0]) or p[0] <= -1e+308:
                        continue
                    if not is_point_in_cylinder(p, src, direction, valid_impact_threshold):
                        continue
                    distToVictimSqr = p.distSqrTo(src)
                    if distToVictimSqr >= hitPointDistSqr:
                        continue
                    hitPoint = p
                    hitPointDistSqr = distToVictimSqr
                    hitKind = Avatar.traceBullet.HitKindVictim
                    hitParams.update({'entity': victim,
                     'reflection': Vector3(victim.skeletonCollider.impactReflection),
                     'bodyZone': victim.colliderNames[victim.skeletonCollider.impactCollider.name]})

        hitParams['hitKind'] = hitKind
        hitParams['hitPoint'] = hitPoint
        return hitParams

    traceBullet.HitKindNone = None
    traceBullet.HitKindVictim = 1
    traceBullet.HitKindWorld = 2

    def getNormalFiringOffset(self, speed):
        return abs(random.gauss(0, 0.4 * (1 + speed / 3)))

    def m1garand_clip_out(self):
        SFXer.WeaponM1GarandClipOut(self)

    def randomize_vector(self, vector, speed, accuracy):
        randRoll = 2 * math.pi * random.random()
        diff = self.getNormalFiringOffset(speed)
        max_diff = accuracy * 0.5
        randYawDiff = math.asin(math.cos(randRoll) * math.sin(diff * max_diff))
        randPitchDiff = math.asin(math.sin(randRoll) * math.sin(diff * max_diff))
        return rotate_by_yaw_pitch((0, 0, vector.length), vector.yaw + randYawDiff, vector.pitch + randPitchDiff)

