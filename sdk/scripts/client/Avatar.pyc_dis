        raise NotImplementedError

    def onPlayerFire(self, *e):
        self.playerFire(isBrust=False)

    def spawn_bullets(self, weapon_in_water, shot_directions):
        ammo_type = self.active_weapon.getAmmoType()
        weapon_item_id = self.active_weapon.getItemID()
        weapon_item_type = self.active_weapon.getItemType()
        if self.offline_mode or ammo_type == 0:
            ammo_type = 600
        point = self.get_firing_point()[1]
        for shot_direction in shot_directions:
            BulletsController.spawn(self, point, shot_direction, ammo_type, weapon_item_id, weapon_item_type, weapon_in_water)

    def playerFire(self, isBrust = False, shot_number = 1, time_per_shot = 0):
        res = self.getPlayerFireResult(shot_number=shot_number)
        if not res:
            if isBrust:
                self.endBurstWeapon()
            return
        weapon_in_water, shot_directions = res
        if not self.active_weapon.isGrenadeGun():
            pass
        if self.active_weapon.isSprayer():
            self.spawn_spray(weapon_in_water, shot_directions, shot_number=shot_number, time_per_shot=time_per_shot)
        else:
            self.spawn_bullets(weapon_in_water, shot_directions)
        weapon_in_shell = not BigWorld.player().isOutsideShellPos(self.position)
        self.drawPlayerFire(weapon_in_water, isBrust=isBrust, weapon_in_shell=weapon_in_shell, time_per_shot=time_per_shot, shot_number=shot_number)

    _shot_number = 0
    _last_shot_time = 0

    def startBurstWeapon(self):
        if self.__brust_id:
            BigWorld.cancelCallback(self.__brust_id)
        self.palyAnimationShot()
        if not self.active_weapon:
            return
        if not self.active_weapon.getParam()['recoil_and_spread'].get('delay_burst_end'):
            delay_burst_end = 1.5
            self._shot_number = BigWorld.time() - self._last_shot_time > delay_burst_end and 0
        self.__brust_w_tick(self.active_weapon.timePerShot)

    def __brust_w_tick(self, timePerShot):
        if self.isDestroyed:
            return
        if not self.active_weapon:
            return self.endBurstWeapon()
        if not self.active_weapon_model:
            return self.endBurstWeapon()
        if not self.active_weapon_model.visible:
            return self.endBurstWeapon()
        if self.active_weapon.getJammed():
            return self.endBurstWeapon()
        self._shot_number += 1
        self._last_shot_time = BigWorld.time()
        self.playerFire(isBrust=True, shot_number=self._shot_number, time_per_shot=timePerShot)
        self.__brust_id = BigWorld.callback(timePerShot, partial(self.__brust_w_tick, timePerShot))

    def endBurstWeapon(self):
        if self.__brust_id:
            BigWorld.cancelCallback(self.__brust_id)
            self.__brust_id = 0
        self.stopAnimationShot()

