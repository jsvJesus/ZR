    def updateVisibleForPlayer(self):
        if not self.model:
            return
        player = BigWorld.player()
        if self != player and self.__class__.__name__ == 'Avatar':
            self.model.visible = player.canVisibleMe(self)
            self.initTargetCaps(hide=not self.model.visible)
            CandleUser.updateVisible(self)
            self.updateFlashLight()
            if self._headlight:
                self._headlight.updateVisible()

