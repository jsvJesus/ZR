    __checkWeaponSet2_id = 0

    def __checkWeaponSet2(self):
        if self.npcSuit:
            raise TypeError, 'old npc %s' % str(self)
        if self.__checkWeaponSet2_id:
            BigWorld.cancelCallback(self.__checkWeaponSet2_id)
        if self.active_transform and self.active_transform.isCustomModel:
            return

        def continueCheck():
            if self.isDestroyed:
                return
            if not self.model:
                return
            self.checkWeaponSet2()

        self.__checkWeaponSet2_id = BigWorld.callback(0, continueCheck)

