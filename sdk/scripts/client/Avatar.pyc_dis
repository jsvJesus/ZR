    _anim_to_played = False

    @property
    def isAnimationChangeCrawl(self):
        """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb8\xd0\xb3\xd1\x80\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f - \xd1\x81\xd0\xb5\xd1\x81\xd1\x82\xd1\x8c \xd0\xb8\xd0\xbb\xd0\xb8 \xd0\xb2\xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c...
        """
        return self._anim_to_played

    def _play_anim_crouch_crawl(self, action_name, need_free_left_hand, lock_direction = False):
        if action_name:
            action = getattr(self.model, action_name, None)
            if not action:
                print 'WARNING!', 'not found paly_animation_crouch_crawl', self, repr(action_name)
                return
            if not self.isFencePlayed():
                action()

            def callb():
                if self.isDestroyed:
                    return
                self._anim_to_played = False
                self.onEndToSatyCrouchAnimPlay()
                self.update_turn_states()

            self._anim_to_played = True
            BigWorld.callback(action.duration, callb)
            self.onStartToSatyCrouchAnimPlay(action.duration, need_free_left_hand, lock_direction=lock_direction)
        return

    MAX_SPEED_ENABLE_ANIMATION_CROUCH_TO_IDLE = 0.3

    def paly_animation_crouch_crawl(self, old):
        new = self.crouching_or_crawling
        if old == new:
            return
        elif self.isFPSmode():
            return
        elif self.isImpactingPlayed():
            return
        else:
            lock_direction = False
            tmp_force_anim = None
            is_sliding = False
            if self is BigWorld.player():
                if self._last_action_type == 'sprint' and old == STAY and new == CROUCHING:
                    if self.can_start_sliding():
                        is_sliding = True
                        self.cell.start_sliding()
                    else:
                        BWPersonality.gpd.sendHightMessage(lc('PlayerAvatar.client.not_enough_stamina'), MT.PERSONAL)
            if is_sliding:
                tmp_force_anim = 'pose_stay_sprint_to_crouch_unarmed'
                lock_direction = True
            elif self._last_action_type == 'sprint' and old == STAY and new == CRAWLING:
                tmp_force_anim = 'pose_stay_sprint_to_crawl_unarmed'
            elif self._last_action_type == 'run' and old == STAY and new == CRAWLING:
                tmp_force_anim = 'pose_stay_run_to_crawl_unarmed'
            elif old != CRAWLING and self.model.motors[0].lastSpeed > self.MAX_SPEED_ENABLE_ANIMATION_CROUCH_TO_IDLE:
                return
            if tmp_force_anim:
                anim = tmp_force_anim
            elif self.getActiveWeaponItemType():
                anim = anims_weapon.get((old, new))
            else:
                anim = anims_unarmed.get((old, new))
            need_free_left_hand = False
            if old == CRAWLING or new == CRAWLING:
                need_free_left_hand = True
            self._play_anim_crouch_crawl(anim, need_free_left_hand, lock_direction)
            return

    def on_start_sliding(self):
        action_name = 'pose_stay_sprint_to_crouch_unarmed'
        need_free_left_hand = False
        lock_direction = True
        self._play_anim_crouch_crawl(action_name, need_free_left_hand, lock_direction)

