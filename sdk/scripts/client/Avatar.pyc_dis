    def showPosition(self, args, info):
        BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.GENERAL, 'found %s entities, ' % len(args) + info)
        if hasattr(self, '_last_showdrop_lines'):
            for line_id in self._last_showdrop_lines:
                BigWorld.getGeometricInstance().remove(line_id)

        self._last_showdrop_lines = []
        for pos in args:
            line_id = BigWorld.getGeometricInstance().addLine(pos, pos + Math.Vector3(0, 30, 0), (1, 0, 0, 0), 1)
            self._last_showdrop_lines.append(line_id)

        if args and len(args) < 50:
            for pos in args:
                line_id = BigWorld.getGeometricInstance().addLine(self.position, pos + Math.Vector3(0, 5, 0), (1, 0.3, 0.3, 1), 1)
                self._last_showdrop_lines.append(line_id)

