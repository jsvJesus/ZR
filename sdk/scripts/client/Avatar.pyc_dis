    def __str__(self):
        if self.isDestroyed:
            return '%s(%s)Destroyed' % (self.__class__.__name__, self.id)
        return '%s(%s, %s)' % (self.__class__.__name__, self.id, self.name.encode('utf-8'))

    def initTargetCaps(self, hide = False):
        self.addCaps(CAP_CAN_EXCHANGE)
        if hide:
            self.addCaps(CAP_EXCLUDE)
        else:
            self.removeCaps(CAP_EXCLUDE)

