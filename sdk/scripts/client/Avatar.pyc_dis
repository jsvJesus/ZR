        UsingItemAnimation.onPostModelChange(self)
        AvatarTrackers.onPostModelChange(self)
        PersistentAvatarSfx.onPostModelChange(self)
        Effects.onPostModelChange(self)
        CandleUser.onPostModelChange(self)
        self.updateVisibleForPlayer()
        self._headlight.onPostModelChange()
        if self.model:
            self.model.setWetParams(getattr(self, '_wet_weather_value', 0.0))
        SnowClothModels.updateSnowTexture(self)
        HelicopterUser.onPostModelChange(self)
        GunPointUser.onPostModelChange(self)

    def onPreModelChange(self):
        if self.model:
            self._wet_weather_value = self.model.getWetParams()
        CandleUser.onPreModelChange(self)
        AvatarTrackers.onPreModelChange(self)
        PersistentAvatarSfx.onPreModelChange(self)
        Effects.onPreModelChange(self)
        Trackable.onPreModelChange(self)
        self._headlight.onPreModelChange()

    def UpdateAvatarModel(self, new_model = None):
        """ \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba\xd0\xb0 \xd1\x81\xd0\xb8\xd0\xbd\xd1\x85\xd1\x80\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xbe """
        self._update_avatar_model(new_model=new_model)

    def UpdateAvatarModelAsync(self, new_model = None, callback = None):
        """ \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba\xd0\xb0 \xd0\xb0\xd1\x81\xd0\xb8\xd0\xbd\xd1\x85\xd1\x80\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xbe """

        def on_model_updated():
            if callback:
                callback()

        if self.isDestroyed:
            return
        self._update_avatar_model(new_model=new_model, callback=on_model_updated)

    def _update_avatar_model(self, new_model = None, callback = None):
        """ \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba\xd0\xb0
                new_model - \xd0\xb3\xd0\xbe\xd1\x82\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb2\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xba\xd0\xb8
                \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb5\xd1\x81\xd1\x82\xd1\x8c callback - \xd0\xbf\xd0\xbe\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb0\xd1\x81\xd0\xb8\xd0\xbd\xd1\x85\xd1\x80\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xbe \xd0\xb8 \xd0\xb4\xd1\x91\xd1\x80\xd0\xbd\xd0\xb5\xd1\x82 \xd0\xb2 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x86\xd0\xb5 callback
                \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5\xd1\x82 callback - \xd0\xbf\xd0\xbe\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xb8\xd0\xbd\xd1\x85\xd1\x80\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xbe
        """
        if self.isDestroyed:
            return

        def on_end_load(model):
            if self.isDestroyed:
                return
            else:
                try:
                    self.onDestroyModel()
                except:
                    traceback.print_exc()

                self._prev_weapon_slots = dict(getattr(self, 'weapon_slots', {}))
                self.onPreModelChange()
                self.clearTrakers()
                self.clearPistolHolster()
                self.model = model
                self._head_exist = StalkerModel.isHeadExist(model)
                self.reAtachWaterVolumeDealayed(0.2)
                if isinstance(self, BurnInterface):
                    BurnInterface.onChangeModel(self)
                Soakable.onChangeModel(self)
                BigWorld.player().onAvatarModelChangedForPlayer(self)
                self.updateWaterNotifer()
                self.updatePistolHolster()
                self.setAvatarGuns()
                self.createTrakers()
                self.createDiffDirProviders()
                self.setDirectionProviderParam(force=True)
                self.onNewModel()
                self.onAvatarModelChanged()
                self.onPostModelChange()
                self.onChangeVisibleWeaponModel(self.active_weapon, self.active_weapon_model)
                self.update_isMovingTest(isinit=True)
                TurnAvatar.start_loop_turn(self)
                self.updateFlashLight()
                if self.active_weapon:
                    self.attachHandToWeaponTMP()
                    self.forceUpdateHandWeapon()
                    self.setDirectionProviderParam(force=True)
                    self.onCreateWeaponProvAfterLoadHand()
                self.UpdateAvatarAnimationCaps()
                Climb.onPostModelChange(self)
                self._update_transport_seat()
                self._prev_weapon_slots = {}
                CASC.update_slots_model(self)
                try:
                    if self.dead:
                        self.model.CloseEyes()
                    else:
                        self.model.Wink()
                except:
                    pass

                try:
                    CueModel.onLoadModel(self, self.model)
                except:
                    print '----------'
                    print self, self.id, self.position
                    if self.model:
                        print self.model.sources
                    traceback.print_exc()

                slacefactor = None
                if self.active_transform:
                    slacefactor = self.active_transform.getScale()
                    if slacefactor:
                        if slacefactor > 0:
                            self.model.scale = (slacefactor, slacefactor, slacefactor)
                            self.model.newScaleTest = (slacefactor, slacefactor, slacefactor)
                            self.model.moveScale = 1.0 / slacefactor
                            self.model.motors[0].matchModelScale = True
                            self.model.motors[0].matchModelScaleInv = True
                            self.changeFootsScaleFix(True)
                        if slacefactor > 1.0:
                            self.bbRadius = 3.0 * slacefactor
                    if self.active_transform.raw_configs.get('isHelicopter'):
                        self.bbRadius = 30.0
                    transform_sound = self.active_transform.raw_configs.get('environment_sound')
                    if transform_sound:
                        self.active_sounds = sounds.playSound(transform_sound, self.model)
                    self.onLoadModelForTransform()
                if callback:
                    callback()
                return

        if not new_model:
            ready_model = self.get_base_model_from_prereqs()
            ready_model and StalkerModel.ComposePlayerModelTraker(self, callback=on_end_load, ready_model=ready_model)
        elif callback:
            StalkerModel.ComposePlayerModelTraker(self, callback=on_end_load)
        else:
            model = StalkerModel.ComposePlayerModelTraker(self)
            on_end_load(model)

    belly_weapon = None
    ActiveItemID = 0
    BellyItemID = 0

    def _update_transport_seat(self):
        """ \xd0\xb1\xd0\xb5\xd0\xb7 \xd1\x8d\xd1\x82\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb8 \xd0\xbb\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb6\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xb9 \xd0\xbd\xd0\xb0 \xd0\xbd\xd0\xbe\xd0\xb4\xd0\xb5 (\xd1\x81\xd0\xba\xd0\xbe\xd0\xbf\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbb \xd0\xb8\xd0\xb7 \xd0\xb2\xd0\xb5\xd1\x80\xd1\x82\xd0\xbe\xd0\xbb\xd1\x91\xd1\x82\xd0\xb0, \xd1\x85\xd0\xb7 \xd0\xba\xd0\xb0\xd0\xba \xd1\x8d\xd1\x82\xd0\xbe \xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xb0\xd0\xb5\xd1\x82) """
        if self.transport_seat and not self.is_gunpoint:
            self.torso_nodeinfo.disableAddHipsEffect = True
            self.tracker_torso.drawEnabled = False
            self.fniLeft.enableCollides = False
            self.fniRight.enableCollides = False
            self.rememberlastFootTwist(False, channel='Transport')
            self.model.motors[0].resetFootTwist()
            self.model.motors[0].lockChangeAction = True
            self.model.motors[0].useEntityPitchAndRoll = True
            if self.heli_weapon:
                self.tracker_torso.drawEnabled = True

