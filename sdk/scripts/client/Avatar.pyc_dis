    def update_isMovingTest(self, isinit = False):
        if self.model:
            if self.STOP_MODE == 0:
                self.model.motors[0].isInputMove = self.isMovingTest
                self.model.motors[0].useAntiSlipping = False
            if self.STOP_MODE == 1:
                self.model.motors[0].isInputMove = self.isMovingTest
                self.model.motors[0].useAntiSlipping = True
            elif self.STOP_MODE == 2:
                self.model.motors[0].isInputMove = False
                self.model.motors[0].useAntiSlipping = not self.isMovingTest
            elif self.STOP_MODE == 3:
                self.model.motors[0].isInputMove = False
                self.model.motors[0].useAntiSlipping = True
            elif self.STOP_MODE == 4:
                self.model.motors[0].isInputMove = True
                self.model.motors[0].useAntiSlipping = False

