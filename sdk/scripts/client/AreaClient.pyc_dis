# Embedded file name: ./client/AreaClient.py
import BigWorld

class AreaClient(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.pot_id = None
        self.trap_id = None
        return

    def onEnterPot(self, enteredTrap, handle):
        if not self.name:
            return
        if enteredTrap:
            BigWorld.player().cell.onEnterAreaFromClient(self.name)
        else:
            BigWorld.player().cell.onLeaveAreaFromClient(self.name)

    def onEnterWorld(self, prereqs):
        self.pot_id = BigWorld.addPot(self.matrix, self.radius, self.onEnterPot)

    def onLeaveWorld(self):
        if self.pot_id:
            BigWorld.delPot(self.pot_id)
        self.pot_id = None
        return