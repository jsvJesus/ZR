# Embedded file name: ./client/CreatureWithBubbles.py
import BigWorld
import Math
import math
from Creature import Creature
from PopAttacher import PopAttacher
from EntityHealthBar import EntityHealthBar

class CreatureWithBubbles(Creature, PopAttacher, EntityHealthBar):

    def __init__(self):
        Creature.__init__(self)
        PopAttacher.__init__(self)
        EntityHealthBar.__init__(self)

    def onEnterWorld(self, prereqs):
        Creature.onEnterWorld(self, prereqs)
        PopAttacher.onEnterWorld(self, prereqs)

    def bleedFromShoot(self, pos, blood_orientation, collider_name, ammo_type, damager_id):
        if self.its_pop(collider_name):
            PopAttacher.bleedFromShoot(self, pos, blood_orientation, collider_name, ammo_type, damager_id)
        else:
            Creature.bleedFromShoot(self, pos, blood_orientation, collider_name, ammo_type, damager_id)

    def recompose(self):
        Creature.recompose(self)
        PopAttacher.recompose(self)

    def on_death(self, source_data, item_type, noSound = False):
        Creature.on_death(self, source_data, item_type, noSound)
        PopAttacher.on_death(self, source_data, item_type, noSound)

    def get_custom_mark(self, distance):
        if not self.is_boss:
            return None
        else:
            return EntityHealthBar.get_custom_mark(self, distance)