# Embedded file name: ./client/ClanDecoration.py
import json
import ResMgr
import BigWorld
import UCManager
import StalkerModel
section = ResMgr.openSection('scripts/common/EnumProps/ClanDecoration.json')
CONFIG = json.loads(section.asBinary)['model_index']['values']
section = ResMgr.openSection('scripts/client/data/clan_decorarion_config.json')
MODELS = json.loads(section.asBinary)
no_texture = BigWorld.PyTextureProvider('textures/default/alpha.dds')

def get_model_path(model_path, level):
    model_data = MODELS.get(model_path)
    if not model_data:
        return model_path
    return model_data.get(str(level), {}).get('model', '')


def get_model_animation(model_path, level):
    model_data = MODELS.get(model_path)
    if not model_data:
        return ''
    return model_data.get(str(level), {}).get('animation', '')


def get_model_offset(model_path, level):
    model_data = MODELS.get(model_path)
    if not model_data:
        return (0, -1, -0.5)
    return model_data.get(str(level), {}).get('offset', (0, -1, -0.5))


class ClanDecoration(BigWorld.Entity):
    """docstring for  DungeonModelSFX"""

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._model_path = next((model for index, model in CONFIG if index == self.model_index), None)
        self.filter = BigWorld.NoneFilter()
        self.current_path = ''
        return

    def onEnterWorld(self, prereqs):
        self.load_model()

    def onLeaveWorld(self):
        self.model = None
        return

    def onClanChangeEmblemID(self, emblemID):
        self.load_emblem()

    def _drawIcon(self, imgID = 0, feedName = '', texture = None):
        if self.isDestroyed:
            return
        elif imgID != self.emblemID:
            return
        else:
            if imgID and texture:
                StalkerModel.setFeed(self.model, None, 'flag_color', 'DiffMapDecal', texture)
            else:
                StalkerModel.setFeed(self.model, None, 'flag_color', 'DiffMapDecal', no_texture)
            return

    def set_emblemID(self, old_value):
        self.load_emblem()

    def set_level(self, old_value):
        self.load_model()

    def load_model(self):

        def on_load(model):
            self.model = model
            self.model.isObstacle = True
            try:
                self.model.flag_color = 'flag'
            except Exception:
                pass

            self.load_emblem()
            action = get_model_animation(self._model_path, self.level)
            self.model.action(action)()

        new_model = get_model_path(self._model_path, self.level)
        if new_model and (self.current_path != new_model or not self.model):
            BigWorld.fetchModel(new_model.encode('utf8'), on_load)
            self.current_path = new_model
            return

    def load_emblem(self):
        if self.emblemID:
            UCManager.ucmanager.loadImg(self.emblemID, self._drawIcon)
        else:
            self._drawIcon(self.emblemID)