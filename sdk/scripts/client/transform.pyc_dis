    def applyThrowGrenadeAttack(self, action_id, skill, dead_also = False):
        return []

    def applyThrowGrenadeAttack2(self, action_id, skill):
        pass

    def transformWeaponFire(self, action_id, skill, dead_also = False):
        if self.transform_weapon:
            self.transform_weapon.fire(action_id, skill)
        return []

    def applyBoxAttack(self, action_id, skill):
        targets = self._getEntitiesBoxAttack(action_id, skill)
        return targets

    def _getEntitiesBoxAttack(self, action_id, skill):
        box_width = skill.param.get('box_width')
        if not box_width:
            print '[ERROR] not box_width:', skill
            return []
        box_height = skill.param.get('box_height')
        if not box_height:
            print '[ERROR] not box_heigh:', skill
            return []
        w_min, w_max = box_width
        h_min, h_max = box_height
        dist_attack = skill.param.get('dist_attack', 3.0)
        matrix = Matrix(self.model.matrix)
        m_r = Matrix()
        m_r.setRotateYPR(Vector3(0, -math.pi * 0.5, 0))
        matrix.preMultiply(m_r)
        minBounds = Vector3(w_min, 0, h_min)
        maxBounds = Vector3(w_max, -dist_attack, h_max)
        res = BigWorld.traceOrientedBoxWithEntities(matrix, minBounds, maxBounds, self.id)
        targets = []
        for e_id, hitbox, local_pos in res:
            entity = BigWorld.entity(e_id)
            if not isinstance(entity, Victim):
                continue
            if not entity.canTakeDamage:
                continue
            targets.append(entity)

        if DEBUG_DRAW:
            drawer.clear()
            from DrawPrimitivesUtils import DrawBBox2
            color = (1, 0, 0, 1)
            DrawBBox2(matrix, minBounds, maxBounds, color=color, holder=drawer)
            self._show_targets(targets)
        return targets

    def applySectorAttack(self, action_id, skill, dead_also = False):
        targets = self._getEntitiesSectorAttack(action_id, skill, dead_also=False)
        self._show_sector(skill, targets)
        return targets

    def _getEntitiesSectorAttack(self, action_id, skill, dead_also = False, yaw = None):
        angles_sector = skill.param.get('angles_sector')
        if not angles_sector:
            return []
        else:
            min_sector_local = math.radians(angles_sector[0])
            max_sector_local = math.radians(angles_sector[1])
            entities = self._getEntitiesInSkillAOE(action_id, skill, dead_also=dead_also)
            targets = []
            my_dir = Vector3()
            if yaw is None:
                yaw = self.model.yaw
            my_dir.setPitchYaw(0, yaw)
            my_pos = self.position
            offset = skill.param.get('offset_position_attack')
            if offset:
                offset = tuple(offset)
                my_pos = Matrix(self.model.matrix).applyPoint(offset)
            for ent in entities:
                to_ent = ent.position - my_pos
                to_ent.normalise()
                dot = to_ent.dot(my_dir)
                dot = max(-1, min(1, dot))
                angle = math.acos(dot)
                if (my_dir * to_ent)[1] < 0:
                    angle = -angle
                if min_sector_local <= angle <= max_sector_local:
                    targets.append(ent)

            return targets

    def applyAOEAttack(self, action_id, skill, dead_also = False):
        targets = self._getEntitiesInSkillAOE(action_id, skill, dead_also=dead_also)
        self._show_aoe(skill, targets)
        return targets

    def applySelfEffectAttack(self, action_id, skill, dead_also = False):
        targets = [self]
        return targets

    def applySummonElf(self, action_id, skill):
        pass

    def _getEntitiesInSkillAOE(self, action_id, skill, dead_also = False):
        position = self.position
        radius = skill.param['radius']
        radiusSq = radius ** 2
        from_radiusSq = skill.param.get('from_radius', 0) ** 2
        offset = skill.param.get('offset_position_attack')
        if offset:
            offset = tuple(offset)
            position = Matrix(self.model.matrix).applyPoint(offset)
        targets = []
        height_attack_limit = skill.param.get('height_attack_limit')
        if height_attack_limit:
            min_h, max_h = height_attack_limit
            min_h = min_h + position[1]
            max_h = max_h + position[1]
        for ent in BigWorld.entities.values():
            if ent == self:
                continue
            if not isinstance(ent, Victim):
                continue
            if not dead_also:
                if ent.is_dead():
                    continue
                if not ent.canTakeDamage:
                    continue
            if height_attack_limit:
                if not min_h <= ent.position[1] <= max_h:
                    continue
            distSq = (ent.position - position).lengthSquared
            if distSq > radiusSq:
                continue
            if from_radiusSq and distSq < from_radiusSq:
                continue
            targets.append(ent)

        return targets

    def funSfx(self, path):
        if path:
            FX.bufferedOneShotEffect(path, self.model)

    def on_damaged_transform(self, source_data, damagetaken_data):
        if self.active_transform:
            animation_on_damage = self.active_transform.getparam('animation_on_damage')
            if animation_on_damage:
                try:
                    anim = self.model.action(animation_on_damage)
                    anim()
                except:
                    traceback.print_exc()

            sfx_on_damage = self.active_transform.getparam('sfx_on_damage')
            try:
                self.funSfx(sfx_on_damage)
            except:
                traceback.print_exc()

    @debug_draw
    def _show_aoe(self, skill, targets):
        drawer.clear()
        pos = self.position
        offset = skill.param.get('offset_position_attack')
        if offset:
            offset = tuple(offset)
            pos = Matrix(self.model.matrix).applyPoint(offset)
        hh = []
        radius = skill.param.get('radius', 1.0)
        from_radius = skill.param.get('from_radius', 0)
        height_attack_limit = skill.param.get('height_attack_limit')
        if height_attack_limit:
            hh.append(Vector3(pos[0], pos[1] + height_attack_limit[0], pos[2]))
            hh.append(Vector3(pos[0], pos[1] + height_attack_limit[1], pos[2]))
        else:
            hh.append(Vector3(pos[0], pos[1] + 1.0, pos[2]))
        drawer.add(hh[0], hh[-1], (1, 0, 0, 1))
        v = Vector3()

        def drawCircles(radius, colour = (1, 0, 0, 1)):
            vert_lines_list = []
            for centr in hh:
                vert_lines = []
                vert_lines_list.append(vert_lines)
                last = None
                w = 0
                segments = 20
                for x in xrange(segments + 1):
                    w += 6.28 / segments
                    v.setPitchYaw(0, w)
                    pos1 = centr + v * radius
                    if last:
                        vert_lines.append(pos1)
                        drawer.add(last, pos1, colour)
                    last = pos1

            for x in xrange(len(vert_lines_list[0])):
                drawer.add(vert_lines_list[0][x], vert_lines_list[1][x], colour)

            return

        drawCircles(radius)
        if from_radius:
            drawCircles(from_radius, (0, 1, 0, 1))
        self._show_targets(targets)

    @debug_draw
    def _show_sector(self, skill, targets, yaw = None):
        print '_show_sector', skill, targets, yaw
        if yaw is None:
            yaw = self.model.yaw
        drawer.clear()
        pos = self.position
        offset = skill.param.get('offset_position_attack')
        if offset:
            offset = tuple(offset)
            pos = Matrix(self.model.matrix).applyPoint(offset)
        hh = []
        height_attack_limit = skill.param.get('height_attack_limit')
        if height_attack_limit:
            hh.append(Vector3(pos[0], pos[1] + height_attack_limit[0], pos[2]))
            hh.append(Vector3(pos[0], pos[1] + height_attack_limit[1], pos[2]))
        else:
            hh.append(Vector3(pos[0], pos[1] + 1.0, pos[2]))
        radius = skill.param.get('radius', 1.0)
        from_radius = skill.param.get('from_radius', 0)
        drawer.add(hh[0], hh[-1], (1, 0.0, 0.0, 1))
        v = Vector3()
        angles_sector = skill.param.get('angles_sector')
        if not angles_sector:
            return
        else:
            min_s_local = math.radians(angles_sector[0])
            max_s_local = math.radians(angles_sector[1])
            min_s = min_s_local + yaw
            max_s = max_s_local + yaw
            v = Vector3()

            def drawSectors(radius, colour = (1, 0, 0, 1)):
                vert_lines = []
                for centr in hh:
                    vert = []
                    vert_lines.append(vert)
                    last = None
                    v.setPitchYaw(0, min_s)
                    drawer.add(centr, centr + v * radius, colour, 0)
                    v.setPitchYaw(0, max_s)
                    drawer.add(centr, centr + v * radius, colour, 0)
                    v.setPitchYaw(0, yaw)
                    drawer.add(centr, centr + v * radius, (1, 1, 1, 1), 0)
                    w = min_s
                    segments = 20
                    for x in xrange(segments + 1):
                        v.setPitchYaw(0, w)
                        w += (max_s - min_s) / segments
                        pos1 = centr + v * radius
                        if last:
                            vert.append(pos1)
                            drawer.add(last, pos1, colour, 0)
                        last = pos1

                for x in xrange(len(vert_lines[0])):
                    drawer.add(vert_lines[0][x], vert_lines[1][x], colour, 0)

                return

            drawSectors(radius)
            if from_radius:
                drawSectors(from_radius, (0, 1, 0, 1))
            self._show_targets(targets)
            return

    def _show_targets(self, targets):
        for ent in targets:
            drawer.add(ent.position, ent.position + (0, 5, 0), (1, 1, 0.0, 1), 0)
            drawer.add(ent.position + (0.5, 0.01, 0), ent.position + (-0.5, 0.01, 0), (1, 1, 0.0, 1), 0)
            drawer.add(ent.position + (0, 0.01, 0.5), ent.position + (0, 0.01, -0.5), (1, 1, 0.0, 1), 0)