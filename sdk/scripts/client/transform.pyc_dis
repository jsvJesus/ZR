DEBUG_DRAW = False

def change_debug_mode():
    global DEBUG_DRAW
    DEBUG_DRAW = not DEBUG_DRAW
    drawer.clear()


def debug_draw(foo):

    def wrapped(self, *e, **kw):
        if not DEBUG_DRAW:
            return
        if self.isDestroyed:
            return
        if BigWorld.isConsumer():
            return
        if not self.active_transform and not self._active_skill:
            return
        return foo(self, *e, **kw)

    return wrapped


class Transformation(object):
    active_transform = None
    vechicle_contorled = None
    active_sounds = None
    transform_weapon = None
    _last_transf = None
    _saved_transf_att = None
    _saved_sfxs = []

    def onInitTransform(self, transf):
        self.forceClearTrackerLock()
        if self._last_transf and self._last_transf.getModelPath() == transf.getModelPath() and self._last_transf.get_equipped_items() == transf.get_equipped_items():
            BigWorld.callback(0.0, self.onLoadModelForTransform)
        else:
            BigWorld.callback(0.0, self._update_avatar_model)

    def onResetTransform(self, transf):
        if self._saved_transf_att:
            for node, m in self._saved_transf_att:
                try:
                    node.detach(m)
                except:
                    print 'ERROR for:', [self, node, m]
                    traceback.print_exc()

        self._saved_transf_att = []
        for sfx in self._saved_sfxs:
            sfx.release()

        self._saved_sfxs = []
        self._last_transf = None
        self.forceClearTrackerLock()
        self.autogunModelVisible = True
        if not self.transformationID:
            BigWorld.callback(0.0, self._update_avatar_model)
        else:
            self._last_transf = transf
        if self.vechicle_contorled:
            self.vechicle_contorled.onReset()
            self.vechicle_contorled = None
        if self.transform_weapon:
            try:
                self.transform_weapon.onDestroy()
            except:
                print 'ERROR FOR', self
                traceback.print_exc()

            self.transform_weapon = None
        try:
            if self.model and transf:
                for action in transf.raw_configs.get('persistent_actions', []):
                    self.model.action(action).stop()

        except:
            traceback.print_exc()

        self.rememberlastFootTwist(True, channel='transform')
        return

    def onLeaveWorldTransform(self):
        if not self.active_transform:
            return
        else:
            try:
                transf = self.active_transform
                self.active_transform = None
                transf.resetTransformation()
            except:
                traceback.print_exc()

            return

    def onLoadModelForTransform(self):
        if not self.active_transform:
            return
        else:
            if self.active_transform.getparam('fix_last_foot_twist'):
                self.rememberlastFootTwist(False, channel='transform')
            if self.active_transform.raw_configs.get('disable_foot_tracker'):
                if getattr(self, 'torso_nodeinfo', None):
                    self.torso_nodeinfo.leftFootNodeInfo = None
                    self.torso_nodeinfo.rightFootNodeInfo = None
            transform_weapon_conf = self.active_transform.raw_configs.get('transform_weapon')
            if transform_weapon_conf:
                self.transform_weapon = TransformWeapon(self, transform_weapon_conf)
            try:
                for action in self.active_transform.raw_configs.get('persistent_actions', []):
                    self.model.action(action)()

            except:
                traceback.print_exc()

            attach_models = self.active_transform.raw_configs.get('attach_models')
            if attach_models:
                for node_name, model_path in attach_models.items():
                    BigWorld.fetchModel(str(model_path), partial(self.onLoadAttachTransform, str(node_name), model_path))

            for sfx_path in self.active_transform.raw_configs.get('persistent_sfxs', []):
                sfx = PersistentWrapper(sfx_path, self.model)
                sfx.run()
                self._saved_sfxs.append(sfx)

            return

    def onLoadAttachTransform(self, node_name, model_path, model):
        if self.isDestroyed:
            return
        if not self.active_transform:
            return
        if not model:
            print 'onLoadAttachTransform not load model', [node_name, model_path], self
            return
        if not self.model:
            return
        attach_models = self.active_transform.raw_configs.get('attach_models', {})
        if node_name not in attach_models:
            return
        if attach_models[node_name] != model_path:
            return
        if node_name[-11:] == '__to_origin':
            node_name = node_name[:-11]
            model.origin(node_name)
        modelnode = self.model.node(node_name)
        modelnode.attach(model)
        if not self._saved_transf_att:
            self._saved_transf_att = []
        self._saved_transf_att.append((modelnode, model))

    def onChangePrimaryActionForTransf(self, prev_type, new_type):
        if not self.model:
            return
        if prev_type == 'sprint':
            if self.active_transform.raw_configs.get('force_to_weapon_incombat'):
                self.SetWeaponStatus(Constants.WEAPON_INCOMABAT)
        if not self.active_transform.raw_configs.get('persistent_actions_pause_by_sprint'):
            return
        if prev_type == 'sprint':
            for action in self.active_transform.raw_configs.get('persistent_actions', []):
                self.model.action(action)()

        elif new_type == 'sprint':
            for action in self.active_transform.raw_configs.get('persistent_actions', []):
                self.model.action(action).stop()

    def getCurrentModel(self):
        if self.vechicle_contorled and self.vechicle_contorled._model:
            return self.vechicle_contorled._model
        return self.model

    def startTransformAction(self, *e):
        return False

    def set_transformationID(self, old = None):
        if self.active_transform:
            transf = self.active_transform
            self.active_transform = None
            transf.resetTransformation()
        if self.active_sounds:
            self.active_sounds.stop()
            self.active_sounds = None
        if self.transformationID:
            self.active_transform = FunTransformation(self, self.transformationID)
            self.active_transform.init(self)
            if self.vechicle_contorled:
                self.vechicle_contorled.onReset()
            if self.active_transform.raw_configs.get('isHelicopter'):
                self.vechicle_contorled = helicopter_transform.Helicopter(self)
                self.vechicle_contorled.onInit()
            transform_sound = self.active_transform.raw_configs.get('environment_sound')
            if transform_sound and self.model:
                self.active_sounds = sounds.playSound(transform_sound, self.model)
        self.EnableCrosshair()
        return

    def breakBoredTimer(self):
        pass

    def onActionEvent(self, actionName, okayToGo, event):
        return False

    def onFireHelicopterRoket(self, weaponNodeID, position, velocity, clientGrenadeID, grenade_type):
        if not self.vechicle_contorled:
            return
        self.vechicle_contorled.onFireHelicopterRoket(weaponNodeID, position, velocity, clientGrenadeID, grenade_type)

    def onFireHelicopterMachineGun(self, status, weaponType):
