        self.vechicle_contorled.onHelicopterBurn()

    def onHelicopterEvent(self, event_id, event_status, event_value, event_dir):
        if not self.vechicle_contorled:
            return
        self.vechicle_contorled.onHelicopterEvent(event_id, event_status, event_value, event_dir)

    def set_transformationProperty(self, old = None):
        if not self.vechicle_contorled:
            return
        self.vechicle_contorled.onTransformationProperty(old)

    def onTransformFireGrenade(self, position, velocity, original_id, grenade_type):
        self.fire_grenade(position, velocity, original_id, grenade_type)

    def transformEvent(self, skill_id, status):
        if not self.active_transform:
            return
        skill = self.active_transform.getSkill(skill_id)
        skill.serverEvent(status)

    def startTSAction(self, action_id, action_name, skill):
        if skill.getActionClass() == 'ANIMATION_SEQUENCE':
            self._startTSActionSeqAnim(action_id, action_name, skill)
        else:
            animation = skill.param['animation']
            if animation:
                try:
                    act = self.model.action(animation)
                    act()
                except:
                    print '\nERROR FOR', self, self.model, self.transformationID,
                    print '  ', skill.getActionClass(), animation
                    print '  ', self.model.sources
                    traceback.print_stack()
                    traceback.print_exc()

        self.funSfx(skill.param.get('sfx_start_animation'))
        lock_trackers = skill.param.get('lock_trackers', {})
        if any(lock_trackers.values()):
            lock_id = 'SKILL-%s-%s' % (action_name, action_id)
            self.pushTrackerLockByName(lock_id, lock_track_torso=lock_trackers.get('lock_track_torso'), lock_track_head=lock_trackers.get('lock_track_head'), lock_track_foot=lock_trackers.get('lock_track_foot'))

    def _startTSActionSeqAnim(self, action_id, action_name, skill):
        try:
            animation_in = skill.param['animation_in']
            animation_loop = skill.param['animation']
            a_in = self.model.action(animation_in)
            getattr(a_in(), animation_loop)()
        except:
            traceback.print_exc()

    def checkEffectBsp(self, action_id, action_name, skill):
        bsp_config = skill.param.get('on_effect_bsp_collide')
        if not bsp_config:
            return
        collide_height = bsp_config.get('collide_height')
        collide_dist = bsp_config.get('collide_dist')
        apply_self_effect = bsp_config.get('apply_self_effect')
        if collide_height is None:
            return
        elif collide_dist is None:
            return
        elif apply_self_effect is None:
            return
        pos = self.position + (0, collide_height, 0)
        my_dir = Vector3()
        my_dir.setPitchYaw(0, self.model.yaw)
        end_pos = pos + my_dir * collide_dist
        if utils_bw.collide(self.spaceID, pos, end_pos):
            return True
        else:
            return

    def startTSAapply(self, action_id, action_name, skill, dead_also = True):
        action_class = skill.getActionClass()
        targets = None
        if action_class == 'AOE':
            targets = self.applyAOEAttack(action_id, skill, dead_also=dead_also)
        elif action_class == 'SECTOR_MELEE':
            targets = self.applySectorAttack(action_id, skill, dead_also=dead_also)
        elif action_class == 'BOX_MELEE':
            targets = self.applyBoxAttack(action_id, skill)
        elif action_class == 'ANIMATION':
            pass
        elif action_class == 'ANIMATION_SEQUENCE':
            pass
        elif action_class == 'SUMMON_ELF':
            self.applySummonElf(action_id, skill)
        elif action_class == 'SELF_EFFECT':
            targets = self.applySelfEffectAttack(action_id, skill)
        elif action_class == 'THROW_GRENADE':
            targets = self.applyThrowGrenadeAttack(action_id, skill, dead_also=dead_also)
        elif action_class == 'THROW_GRENADE2':
            self.applyThrowGrenadeAttack2(action_id, skill)
        elif action_class == 'FIRE_TRANSFORM_WEAPON':
            targets = self.transformWeaponFire(action_id, skill, dead_also=dead_also)
        else:
            print self
            print [action_id, action_name, skill]
            raise ValueError('uncknow FunnSkill action_class %s' % action_class)
        if targets:
            self.funSfx(skill.param.get('sfx_apply_effect_hit'))
            for victim in targets:
                if isinstance(victim, Transformation):
                    victim.onVictimApplyFTSkill(self, action_id, action_name, skill)

        else:
            self.funSfx(skill.param.get('sfx_apply_effect_boner'))
        return

    def onVictimApplyFTSkill(self, damager, action_id, action_name, skill):
        if not self.model:
            return
        if self.dead:
            return
        rand_victim_hit_actions = skill.param.get('rand_victim_hit_actions')
        if not rand_victim_hit_actions:
            return

        def callback(*e):
            self.popTrackerLock(tr_lock)

        act = random.choice(rand_victim_hit_actions)
        tr_lock = self.pushTrackerLock('Right', lock_track_torso=True, lock_track_head=True, comment='onVictimApplyFTSkill')
        self.model.action(act)(0, callback)

    def endTSAnimation(self, action_id, action_name, skill):
        if skill.getActionClass() == 'ANIMATION_SEQUENCE':
            self._endTSAnimationSeqAnim(action_id, action_name, skill)
        self.funSfx(skill.param.get('sfx_end_animation'))
        lock_trackers = skill.param.get('lock_trackers', {})
        if any(lock_trackers.values()):
            lock_id = 'SKILL-%s-%s' % (action_name, action_id)
            self.popTrackerLock(lock_id)

    def _endTSAnimationSeqAnim(self, action_id, action_name, skill):
        try:
            animation_out = skill.param['animation_out']
            animation = skill.param['animation']
            self.model.action(animation_out)()
            self.model.action(animation).stop()
        except:
            traceback.print_exc()

    def endTSReuseTimer(self, action_id, action_name, skill):
        pass

    def onStopSkill(self, action_id, action_name, skill):
        pass

    def onEndSkillAmmo(self, action_id, action_name, skill):
