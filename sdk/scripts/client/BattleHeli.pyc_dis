class BattleHeli(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.filter = BigWorld.NoneFilter()

    def prerequisites(self):
        if show_debug_info:
            return [model_name]
        return []

    def onEnterWorld(self, prereqs):
        if show_debug_info:
            self.model = prereqs[model_name]
            self.model.stipple = True