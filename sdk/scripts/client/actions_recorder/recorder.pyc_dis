# Embedded file name: ./client/actions_recorder/recorder.py
import BigWorld
import time

class Recorder(object):

    def __init__(self):
        self.running = False
        self.data = None
        self._tick_callback = None
        return

    def rec_attr_demo(self, atr, old_val, new_val):
        if not self.running:
            return
        is_attr = True
        self.data['keys'][-1]['actions'].append((is_attr,
         atr,
         old_val,
         new_val))

    def rec_foo_demo(self, function_name, *w, **kw):
        if not self.running:
            return
        is_attr = False
        self.data['keys'][-1]['actions'].append((is_attr,
         function_name,
         w,
         kw))

    def _tick(self):
        self._tick_callback = BigWorld.callback(0, self._tick)
        p = BigWorld.player()
        self.data['keys'].append({'time': time.time() - self._start_rec_time,
         'coords': (tuple(p.position), p.yaw, p.pitch),
         'actions': []})
        if len(self.data['keys']) == 1:
            self.data['keys'][0]['time'] = 0

    def rec(self):
        self.stop()
        self.running = True
        self._start_rec_time = time.time()
        p = BigWorld.player()
        initial_params = {'name': u'\u041f\u043e\u0442\u0435\u0440\u0435\u0431\u043e\u043d\u044c\u043a\u0430',
         'usingGesture': p.usingGesture,
         'ActiveWeaponSet2': p.ActiveWeaponSet2,
         'ActiveItemID': p.ActiveItemID,
         'BellyItemID': p.BellyItemID,
         'EquipModes': p.EquipModes,
         'personality': p.personality,
         'EquippedArmor': p.EquippedArmor,
         'coloriseEmblems': p.coloriseEmblems,
         'colorDelegates': p.colorDelegates,
         'playedAnimationIndexList': p.usingGesture,
         'isMovingTest': p.isMovingTest,
         'weaponStatus': p.weaponStatus,
         'transformationID': p.transformationID,
         'transformationProperty': p.transformationProperty,
         'crouching_or_crawling': p.crouching_or_crawling}
        self.data = {'name': 'rename_me_' + str(int(BigWorld.time())),
         'params': initial_params,
         'id': time.time(),
         'keys': []}
        self._tick()

    def stop(self):
        if self._tick_callback:
            BigWorld.cancelCallback(self._tick_callback)
            self._tick_callback = None
        self.running = False
        return