    def _update_content(self):
        play_button = self.component.content.play_button
        stop_button = self.component.content.stop_button
        status_box = self.component.content.status_box
        if not self.haveItem():
            play_button.visible = False
            stop_button.visible = False
            status_box.visible = False
        elif self._imitator.state == S.Stop:
            play_button.visible = True
            stop_button.visible = False
            play_button.label.text = 'Play'
            status_box.visible = False
        elif self._imitator.state == S.Play:
            play_button.label.text = '||'
            play_button.visible = True
            stop_button.visible = True
            status_box.visible = True
        elif self._imitator.state == S.Pause:
            play_button.label.text = '>'
            play_button.visible = True
            stop_button.visible = True
            status_box.visible = True
        else:
            raise RuntimeError
        if self.haveItem():
            checkbox = self.component.content.loop_check.script
            if self._imitator.loop:
                checkbox.setActive()
            else:
                checkbox.setInactive()
            checkbox = self.component.content.npc_check.script
            if self._imitator.npc:
                checkbox.setActive()
            else:
                checkbox.setInactive()
            if self._imitator.loop_end or self._imitator.state == S.Pause:
                status_box.colour = (50, 0, 0, 255)
            else:
                status_box.colour = (150, 0, 0, 255)

    def onRClick(self):
        if not self.haveItem():
            return
        self.parent_script.on_context_menu(self._imitator.npc, self._data)

    def _npc_click(self):
        self._imitator.set_npc(not self._imitator.npc)

    def _loop_click(self):
        self._imitator.set_loop(not self._imitator.loop)

    def _on_del_click(self):
        self.parent_script.on_del_click(self._data)

    def _on_play_pause_click(self):
        if self._imitator.state == S.Stop:
            self._imitator.play()
        elif self._imitator.state == S.Play:
            self._imitator.set_pause(True)
        elif self._imitator.state == S.Pause:
            self._imitator.set_pause(False)
        else:
            raise RuntimeError

    def on_imitator_event(self, event_type, data):
        if event_type in (ET.NpcChanged,
         ET.LoopChanged,
         ET.StateChanged,
         ET.LoopEndChanged):
            self._update_content()

    def _on_stop_click(self):
        self._imitator.stop()

    def _applyItemData(self):
        if self.haveItem():
            self.component.content.visible = True
            self.component.content.name.text = self._data['name']
            self._imitator.remove_listener(self)
            self._imitator.add_listener(self)
        else:
            self.component.content.visible = False
        self._update_content()

    @property
    def _data(self):
        return self.itemData['data']

    @property
    def _imitator(self):
        return self.itemData and self.itemData['imitator']