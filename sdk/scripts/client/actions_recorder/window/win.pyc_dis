# Embedded file name: ./client/actions_recorder/window/win.py
from Math import Vector3
import BigWorld
import soGUI
import GUI
from Helpers.PyGUI.PyGUIBase import DragWin
import BWPersonality
from soGUI.soButton import soButton
from soGUI.soItemView import soItemView
from ..data_provider import EventType as ET
from row import Row
from soGUI.soCheckBox import soCheckBox
import gui_jokes
import TutorialUtils

class Win(DragWin):

    def __init__(self, data_provider, imitators):
        self.on_rec_callback = lambda : None
        self.on_stop_callback = lambda : None
        self.on_close_callback = lambda : None
        self._context_menu_id = 'actions_recorder.win'
        self._imitators = imitators
        self._data_provider = data_provider
        self._data_provider.add_listener(self)
        self._rec_running = False
        comp = GUI.Window('textures/default/white.dds')
        comp.colour = (25, 25, 25, 255)
        comp.materialFX = 'BLEND'
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.width, comp.height = (450, 320)
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'BOTTOM')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('CLIP', 'CLIP')
        comp.position = (1, -1, 0.4)
        DragWin.__init__(self, comp)
        BWPersonality.GUICore.worldLayer.addChild(self.component, 'RecGUI')
        self.component.visible = False
        self.component.script = self
        closeBox = soButton(GUI.Window())
        comp = closeBox.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('RIGHT', 'TOP')
        comp.materialFX = 'BLEND'
        comp.width, comp.height = (15, 15)
        comp.position = (self.component.width - 5, 5, 0)
        comp.script.onClick = self.hide
        closeBox.initVSC('soGUI/elements/closeBox.xml')
        closeBox.onBound()
        closeBox.setVisualState('normal')
        self.component.addChild(comp, 'closeButton')
        comp = GUI.Window()
        btn = soButton(comp)
        btn.initVSC('soGUI/elements/button_1.xml')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.label.font = 'RobotoCondensedRegular_16.font'
        comp.materialFX = 'BLEND'
        comp.width, comp.height = (90, 25)
        comp.position = (8, 8, 0.1)
        comp.script.onClick = self._on_rec_stop_click
        self.component.addChild(comp, 'start_stop_rec')
        btn.onBound()
        comp = GUI.Window()
        self._item_view = soItemView(comp, Row, rowWidth=1, rows=10, cols=1, hScroll=False, parent_script=self)
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (5, 50, 0.5)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'itemView')
        self._item_view.onBound()
        self._item_view.setRestrictingComponent(None)
        self._item_view.setItems(None)
        comp = GUI.Text('npc/loop/single')
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.widthMode, comp.heightMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.font = 'RobotoCondensedRegular_16.font'
        comp.width, comp.height = (140, 24)
        comp.colour = (150, 150, 150, 255)
        comp.position = (230, 5, 0.1)
        self.component.addChild(comp, 'title')
        btn.onBound()
        comp = GUI.Window()
        cb = soCheckBox(comp, soGUI.CheckBoxPropsStructure())
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (300, 30, 0.5)
        self.component.addChild(comp, 'singleton_check')
        cb.onStateChange = self._on_singleton_click
        cb.onBound()
        comp = GUI.Window()
        cb = soCheckBox(comp, soGUI.CheckBoxPropsStructure())
        comp.horizontalPositionMode, comp.verticalPositionMode = ('PIXEL', 'PIXEL')
        comp.horizontalAnchor, comp.verticalAnchor = ('LEFT', 'TOP')
        comp.position = (259, 30, 0.4)
        self.component.addChild(comp, 'loop_check')
        cb.onStateChange = self._loop_click
        cb.setActive()
        cb.onBound()
        self._update_content()
        return

    def _on_singleton_click(self):
        self._imitators.set_singleton(not self._imitators.singleton)
        self._update_content()

    def _loop_click(self):
        value = self.component.loop_check.script.isChecked()
        self._imitators.set_all_loop(value)

    def on_del_click(self, data):
        self._data_provider.del_data(data)

    def _on_context_menu(self, interface_id, event_id, caption, event, data):
        if interface_id != self._context_menu_id:
            self._remove_context_menu()
            return
        if event == soGUI.soContextMenuComponent.EVENT_SHOW:
            return
        is_npc, data = data['is_npc'], data['data']
        self._remove_context_menu()
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            if event_id == 'rename':

                def callback(text):
                    if text:
                        self._data_provider.rename_data(data, text)

                gui_jokes.inputBox(u'\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435', callback=callback)
            elif event_id == 'save':
                self._data_provider.save_data(is_npc, data)
            elif event_id == 'teleport_start':
                BigWorld.player().cell.TeleportTo(Vector3(data['keys'][0]['coords'][0]))
            elif event_id == 'teleport_end':
                BigWorld.player().cell.TeleportTo(Vector3(data['keys'][-1]['coords'][0]))

    def _remove_context_menu(self):
        BWPersonality.GUICore.removeListener('contextMenuEvent', self._on_context_menu)

    def on_context_menu(self, is_npc, data):
        self._remove_context_menu()
        actions = {'rename': u'\u043f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c',
         'teleport_start': u'\u0442\u0435\u043b\u0435\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u043d\u0430\u0447\u0430\u043b\u043e',
         'teleport_end': u'\u0442\u0435\u043b\u0435\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u043a\u043e\u043d\u0435\u0446'}
        if TutorialUtils.is_space_tutor(BigWorld.player().getSpaceName()):
            actions['save'] = u'\u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c'
        BWPersonality.GUICore.addListener('contextMenuEvent', self._on_context_menu)
        data = {'data': data,
         'is_npc': is_npc}
        BWPersonality.GUICore.showContextMenu(self._context_menu_id, actions, data=data)

    def _update_content(self):
        self.component.start_stop_rec.label.text = 'Stop' if self._rec_running else 'Rec'
        if self._imitators.singleton:
            self.component.singleton_check.script.setActive()
        else:
            self.component.singleton_check.script.setInactive()

    def _rebuild_items(self):
        item_data = []
        for data in self._data_provider.datas:
            item_data.append({'data': data,
             'imitator': self._imitators.get_imitator(data)})

        self._item_view.setItems(item_data)

    def _on_rec_stop_click(self):
        self._rec_running = not self._rec_running
        self._update_content()
        if self._rec_running:
            self.on_rec_callback()
        else:
            self.on_stop_callback()

    def on_data_event(self, event_type, data = None):
        if event_type in (ET.DataAppended, ET.DataRemoved, ET.DataRenamed):
            self._rebuild_items()

    def show(self):
        self._rebuild_items()
        self._update_content()
        self.component.visible = True

    def hide(self):
        self._rec_running = False
        if self.component.visible:
            self.component.visible = False
            self.on_close_callback()