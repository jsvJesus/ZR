    def loadNPCAsync(self, animation):
        self._imitators.start_play_and_pause_singleton_animation(animation)

    def playNPCDemo(self, animation, callback):
        self._imitators.play_singleton_animation(animation)

    def isNPCDemoPlayed(self):
        if self._imitators.is_singleton_loop_end():
            return False
        if self._imitators.is_singleton_paused():
            return False
        return True

