class ActionsRecorder:

    def __init__(self):
        self._data_provider = DataProvider()
        self._imitators = ImitatorsProvider(self._data_provider)
        self._win = Win(self._data_provider, self._imitators)
        self._recorder = Recorder()
        self._win.on_rec_callback = self._on_rec_click
        self._win.on_stop_callback = self._on_stop_click
        self._win.on_close_callback = self._on_win_close

    def show(self):
        if TutorialUtils.is_space_tutor(BigWorld.player().getSpaceName()):
            self._data_provider.preload_tutorial_data()
        self._win.show()

    def _on_stop_click(self):
        raise self._recorder.running or AssertionError
        self._recorder.stop()
        self._data_provider.append_data(self._recorder.data)

    def _on_win_close(self):
        if self._recorder and self._recorder.running:
            self._recorder.stop()
            self._data_provider.append_data(self._recorder.data)
        self._imitators.destroy_all()

    def _on_rec_click(self):
        raise not self._recorder.running or AssertionError
