# Embedded file name: ./client/actions_recorder/data_provider.py
import ResMgr
import json
import os
SECTION_PATH = 'scripts/client/data/tutorial_npc_animations_2'
SAVE_PATH = os.path.join('../res', SECTION_PATH)

class EventType:
    DataAppended, DataRemoved, DataRenamed = xrange(3)


class DataProvider:

    def __init__(self):
        self._listeners = []
        self.datas = []
        self._tutorial_preloaded = False

    def preload_tutorial_data(self):
        if self._tutorial_preloaded:
            return
        self._tutorial_preloaded = True
        for f_section in ResMgr.openSection(SECTION_PATH).values():
            data = json.loads(f_section.asBinary)
            self.append_data(data)

    def add_listener(self, listener):
        self._listeners.append(listener)

    def del_data(self, data):
        index = next((i for i, d in enumerate(self.datas) if d['id'] == data['id']))
        del self.datas[index]
        data = {'data': data,
         'index': index}
        self._notify_listeners(EventType.DataRemoved, data)

    def save_data(self, is_npc, data):
        data = next((d for d in self.datas if d['id'] == data['id']), None)
        if not data:
            return
        else:
            from utils import PY
            data = PY(data)
            if is_npc:
                from tmp_demo_recorder import tutorial_demos_npc_config
                data['params'].update(tutorial_demos_npc_config)
                data['id'] = data['name']
            with open(self._get_path(data), 'wb+') as f:
                f.write(json.dumps(data))
            return

    def _get_path(self, data):
        name = '{0}{1}'.format(data['name'], '.npc_demo')
        return os.path.join(SAVE_PATH, name)

    def rename_data(self, data, name):
        for d in self.datas:
            if d['id'] == data['id']:
                d['name'] = name
                self._notify_listeners(EventType.DataRenamed)
                break

    def append_data(self, data):
        self.datas.append(data)
        data = {'data': data,
         'index': len(data) - 1}
        self._notify_listeners(EventType.DataAppended, data)

    def _notify_listeners(self, event_type, data = None):
        for listener in self._listeners:
            listener.on_data_event(event_type, data)