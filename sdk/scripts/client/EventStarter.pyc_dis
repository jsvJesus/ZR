# Embedded file name: ./client/EventStarter.py
import BigWorld
import BWPersonality
from time import time
from Math import Vector3
from Localization import lc
from ItemHolder import ItemHolder
from Helpers.Caps import CAP_CAN_OPEN_AND_EXPLORE
from soGUI.soInworldMarkers import soInworldMarker

class EventStarter(BigWorld.Entity, ItemHolder):
    """" client/EventStarter """

    def __init__(self):
        BigWorld.Entity.__init__(self)
        if self.need_items:
            self.targetCaps = [CAP_CAN_OPEN_AND_EXPLORE]
        else:
            self.targetCaps = []
        self.name = lc('TriggerNames.event.{0}'.format(self.local_name))

    def onEnterWorld(self, prereqs):

        def onLoadModel(model):
            if self.isDestroyed:
                return
            else:
                self.model = model
                if self.model:
                    self.model.isObstacle = True
                    direction = Vector3()
                    direction.setPitchYaw(self.pitch, self.yaw)
                    self.model.alignToVector(direction, self.position, False)
                    self.model.scale = Vector3(self.scale, self.scale, self.scale)
                    self.model.newScaleTest = Vector3(self.scale, self.scale, self.scale)
                    self.set_phase(None)
                    try:
                        self.model.no_draw = 'no_draw'
                    except:
                        pass

                return

        BigWorld.fetchModel(self.starter_model, onLoadModel)

    def onLeaveWorld(self):
        self.model = None
        self.clear_event(True)
        return

    def set_phase(self, old):
        if self.phase == 0:
            return
        if self.phase == -1:
            self.phase = 0
        time_duration = time() - (self.lastphasetime + BWPersonality.gpd.time_diff)
        for udo in self.additional_models:
            if hasattr(udo, 'event_phase') and udo.event_phase <= self.phase:
                udo.activate(time_duration)
            if hasattr(udo, 'user_string') and str(self.phase) in udo.user_string:
                udo.activate(time_duration)

    def set_starters_left(self, old):
        self.update_counter()

    def start_event(self):
        if BWPersonality.GUICore.eventStarter:
            BWPersonality.GUICore.eventStarter.start_start_timer()

    def set_starters_count(self, old):
        self.update_counter()

    def clear_event(self, force = False):
        for udo in self.additional_models:
            if hasattr(udo, 'event_phase'):
                udo.deactivate(force)
            if hasattr(udo, 'user_string'):
                udo.deactivate(force)

    def clear_start(self):
        if BWPersonality.GUICore.eventStarter and hasattr(BWPersonality.GUICore.eventStarter, 'stop_start_timer'):
            BWPersonality.GUICore.eventStarter.stop_start_timer(self)
            BWPersonality.GUICore.eventStarter.on_fail_start(self)

    def set_cooldown(self, old):
        self.update_gui()

    def set_CarryingItems(self, old):
        self.update_gui()

    def update_counter(self):
        if not BWPersonality.GUICore.eventStarter:
            return
        BWPersonality.GUICore.eventStarter.update_left_counter(self)

    def update_gui(self):
        if not BWPersonality.GUICore.eventStarter:
            return
        BWPersonality.GUICore.eventStarter.update(self)

    def get_interaction_dist(self):
        return self.radius

    def get_target_mark(self, distance):
        if self.get_hightlight(distance):
            return soInworldMarker.MARKER_USE
        else:
            return None

    def get_hightlight(self, distance):
        if distance > self.get_interaction_dist():
            return None
        else:
            return True