# Embedded file name: ./client/devil_utils/tremble_controller.py
import BigWorld
from functools import partial
from cdevil_utils.dutils import d_config

class TrembleController:

    def __init__(self):
        self._subscribed_model = None
        self.update_config(d_config)
        return

    def susubscribe_to_model(self, model):
        self._unsubscribe()
        self._subscribed_model = model
        if self._subscribed_model:
            self._subscribed_model.cue('Tremble_low', partial(self._on_stomp, 'low'))
            self._subscribed_model.cue('Treble_mid', partial(self._on_stomp, 'mid'))
            self._subscribed_model.cue('Tremble_high', partial(self._on_stomp, 'high'))

    def update_config(self, config):
        self._config = config['tremble']

    def _on_stomp(self, config_name):
        self._on_stomp_debug(config_name)

    def _on_stomp_debug(self, config_name):
        if not self._subscribed_model:
            return
        distance = BigWorld.player().position.distTo(self._subscribed_model.position)
        config = self._config[config_name]
        if distance >= config['radius']:
            return
        intencity = distance / config['radius']
        if intencity <= 0:
            return
        intencity_x = intencity * config['x']
        intencity_y = intencity * config['y']
        try:
            BigWorld.camera().shake(config['time'], (intencity_x, 0, intencity_y))
        except:
            pass

    def _unsubscribe(self):
        if self._subscribed_model:
            self._subscribed_model.cue('Tremble_low', None)
            self._subscribed_model.cue('Treble_mid', None)
            self._subscribed_model.cue('Tremble_high', None)
            self._subscribed_model = None
        return

    def release(self):
        self._unsubscribe()