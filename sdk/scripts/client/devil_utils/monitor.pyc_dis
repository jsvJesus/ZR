    def _on_del_click(self):
        self._run_debug('obj', 0)

    def _on_clone_click(self):
        self._run_debug('obj', 1)

    def _on_respawn_click(self):
        self._run_debug('obj', 2)


class ManualWin(AdditionalWin):

    def __init__(self, entity, pos_x):
        AdditionalWin.__init__(self, entity, pos_x, height=240)
        self._is_active = False
        self._cb = self.create_check(u'\u0420\u0443\u0447\u043d\u043e\u0439 \u0440\u0435\u0436\u0438\u043c', self._on_manual_change)
        self._buttons = []
        for sp in strike_params.values():
            action_name = sp.get('action')
            if action_name:
                foo = partial(self._on_click, action_name)
                self._buttons.append(self.create_button(action_name, foo, width=120))

        foo = partial(self._on_click, 'boss_pain')
        self._buttons.append(self.create_button('pain', foo, width=120))
        self._update_buttons()

    def _on_click(self, action_name):
        self.entity.debug_animation(action_name)

    def _update_buttons(self):
        for button in self._buttons:
            button.setDisabledState(not self._is_active)

    def _on_manual_change(self, is_checked):
        self._run_debug('debug_mode', Flags.ManualMode)
        self._is_active = is_checked
        self._update_buttons()

    def _mark_place(self, position):
        path = 'models/bolvan/box_trigger_05x05x05.model'
        model = BigWorld.Model(path)
        BigWorld.addModel(model)
        model.position = Vector3(position)
        BigWorld.callback(0.5, partial(BigWorld.delModel, model))

    def on_mouse_event(self, event):
        if event.key == Keys.KEY_RIGHTMOUSE:
            if self._is_active:
                from_pos, direction = client_utils.getMousePosDir()
                direction.normalise()
                direction *= 500
                to_pos = from_pos + direction
                res = BigWorld.collideIgnoreFlags(BigWorld.player().spaceID, from_pos, to_pos)
                if res:
                    hit = Vector3(res[0])
                    hit and self._mark_place(hit)
                    self._run_debug('manual', tuple(hit))

    def set_data(self, debug_mode):
        self._cb.set_active(debug_mode & 1 << Flags.ManualMode)


class BrainWin(AdditionalWin):

    def __init__(self, entity, pos_x):
        AdditionalWin.__init__(self, entity, pos_x, height=176)
        self.create_text(text=u'\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435:')
        self._states_text = self.create_text()
        self._phase_text = self.create_text()
        self._phase4_win = self.create_win(Phase4Win)
        self._manual_win = self.create_win(ManualWin)
        self.create_button(u'\u0421\u043f\u0438\u043d\u043e\u0424\u0430\u0437\u0430 4', partial(self.toggle_win, self._phase4_win))
        self.create_button(u'\u0420\u0443\u0447\u043d\u043e\u0439 \u0440\u0435\u0436\u0438\u043c', partial(self.toggle_win, self._manual_win))
        self.create_button(u'next stage', self._on_next_stage_click)
        self.create_button(u'final stage', self._on_final_stage_click)

    def _on_next_stage_click(self):
        self.notify_listeners(EventType.OnNextStageRequest)

    def _on_final_stage_click(self):
        self.notify_listeners(EventType.OnFinalStageRequest)

    def set_data(self, brain_data, debug_mode, nav_data):
        self._manual_win.set_data(debug_mode)
        if brain_data:
            states_path, (phase_index, state_data) = brain_data
            self._states_text.text = '/'.join(states_path)
            self._phase_text.text = u'\u0424\u0430\u0437\u0430: ' + str(phase_index)
            if self._phase4_win.component.visible:
                if phase_index == 4:
                    self._phase4_win.set_data(True, state_data)
                else:
                    self._phase4_win.set_data(False, None)
        return


class AnimWin(AdditionalWin):

    def __init__(self, entity, pos_x):
        AdditionalWin.__init__(self, entity, pos_x, height=100)
        self._filters = {0: ('Python', BigWorld.PythonFilter),
         1: ('AvatarDrop', BigWorld.AvatarDropFilter),
         2: ('AvatarSpline', BigWorld.AvatarSplineFilter)}
        self.create_button(u'reload model', partial(self._on_reload_click))
        self._ddl = self.create_ddl()
        self._ddl.onSelectedElement = self._on_filter_selected
        elements = []
        for key_index in sorted(self._filters.keys()):
            elements.append((key_index, self._filters[key_index][0]))

        self._ddl.addElements(elements)
        for index, (_, filter_delegate) in self._filters.items():
            if isinstance(self.entity.filter, filter_delegate):
                self._ddl.setSelectionByValue(index, silent=True)
                break

    def _on_filter_selected(self, index):
        self.entity._filter.set_filter(self._filters[index][1])

    def _on_reload_click(self):
        for model_name in self.entity.model.sources:
            ResMgr.purge(model_name)

        self.entity.model = BigWorld.Model('characters/creatures/brutor_musroom/brutor_musroom_boss.model')
        self.entity.model.reloadModel()
        for model_name in self.entity.model.sources:
            self.entity.model.motors[0].debugRelaodActtion(model_name)


class Monitor(AdditionalWin, DragWin):

    def __init__(self, entity):
        AdditionalWin.__init__(self, entity, pos_x=50, pos_y=100, width=232, height=208)
        DragWin.__init__(self, self.component)
        self._request_threads = 0
        self.create_text(text=u'\u0427\u0435\u0440\u0442\u044f\u043a\u0430 id:' + str(entity.id))
        self._wins_counter = self.create_text()
        self._distance_text = self.create_text()
        BWPersonality.GUICore.worldLayer.addChild(self.component, 'Devilbdebug.GUI.' + str(entity.id))
        self._targets_win = self.create_win(TargetsWin)
        self._logs_win = self.create_win(LogsWin)
        self._body_win = self.create_win(BodyWin)
        self._body_win.add_listener(self._on_win_event)
        self._brains_win = self.create_win(BrainWin)
        self._brains_win.add_listener(self._on_win_event)
        self._obj_win = self.create_win(ObjectWin)
        self._vis_win = self.create_win(VisualisationWin)
        self._nav_win = self.create_win(NavigationWin)
        self._dung_win = self.create_win(DungWin)
        self._anim_win = self.create_win(AnimWin)
        self.set_margin(120, pos_index=1)
        self.create_space(60, pos_index=1)
        self.create_button(u'\u0426\u0435\u043b\u0438', partial(self.toggle_win, self._targets_win), pos_index=1)
        self.create_button(u'\u041b\u043e\u0433\u0438', partial(self.toggle_win, self._logs_win), pos_index=1)
        self.create_button(u'\u0422\u0435\u043b\u043e', partial(self.toggle_win, self._body_win), pos_index=1)
        self.create_button(u'\u0414\u0430\u043d\u0436', partial(self.toggle_win, self._dung_win), pos_index=1)
        self.create_button(u'reload conf', self._reload_conf, pos_index=1)
        self.create_space(60, pos_index=2)
        self.create_button(u'\u041c\u043e\u0437\u0433\u0438', partial(self.toggle_win, self._brains_win), pos_index=2)
        self.create_button(u'\u041e\u0431\u044a\u0435\u043a\u0442', partial(self.toggle_win, self._obj_win), pos_index=2)
        self.create_button(u'\u0412\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f', partial(self.toggle_win, self._vis_win), pos_index=2)
        self.create_button(u'\u041d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f', partial(self.toggle_win, self._nav_win), pos_index=2)
        self.create_button(u'\u0410\u043d\u0438\u043c\u0430\u0446\u0438\u044f', partial(self.toggle_win, self._anim_win), pos_index=2)

    def _reload_conf(self):
        config_path = 'scripts/common/cdevil_utils/d_config.pyson'
        ResMgr.purge(config_path)
        config_string = ResMgr.openSection(config_path).asBinary
        self._run_debug('reload_conf', config_string)
        config = pyson.loads(config_string)
        self.entity.update_config(config)

    def _on_win_event(self, event_type, data):
        if event_type == EventType.OnDamageBodyRequest:
            body_zone = data
            self._run_debug('damage', body_zone)
        elif event_type == EventType.OnNextStageRequest:
            self._run_debug('debug_mode', Flags.NextState)
        elif event_type == EventType.OnFinalStageRequest:
            self._run_debug('debug_mode', Flags.FinalState)

    def on_show(self):
        self._request_data()
        BWPersonality.register_key_event_interceptor(self.on_mouse_event)

    def on_hide(self):
        BWPersonality.unregister_key_event_interceptor(self.on_mouse_event)

    def _request_data(self):
        if self._request_threads != 0:
            raise RuntimeError(self._request_threads)
        debug_value = 0
        if self._targets_win.component.visible:
            debug_value |= 1
        if self._body_win.component.visible:
            debug_value |= 2
        if self._brains_win.component.visible:
            debug_value |= 4
        if self._nav_win.component.visible:
            debug_value |= 8
        self._run_debug('request_debug_data', debug_value)
        self._request_threads += 1

    def log(self, data):
        if self._logs_win.component.visible:
            self._logs_win.log(data)

    def set_data(self, data):
        self._request_threads -= 1
        if self.component.visible:
            damagable_body_data, regen_rate, brain_data, targets_data, nav_data, damage_data, debug_mode, win_counter = data
            self._distance_text.text = u'\u0420\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435: {0:.1f}'.format(self.entity.position.distTo(BigWorld.player().position))
            self._wins_counter.text = u'\u041f\u043e\u0431\u0435\u0434: ' + unicode(win_counter)
            if self._targets_win.component.visible:
                self._targets_win.set_targets(targets_data)
            if self._body_win.component.visible:
                mushroom_health = (self.entity.mushroom_health, MAX_MUSHROOM_HEALTH)
                self._body_win.set_data(damagable_body_data, regen_rate, mushroom_health, self.entity.belly_open, self.entity.heart_open, self.entity.invincible, self.entity.protection_mode, self.entity.stone_back)
            if self._brains_win.component.visible:
                self._brains_win.set_data(brain_data, debug_mode, nav_data)
            if self._vis_win.component.visible:
                self._vis_win.update_data(debug_mode)
            if self._nav_win.component.visible:
                self._nav_win.update_data(debug_mode, nav_data)
            if debug_mode & 1 << Flags.ShowStrikes:
                self.entity.debugger.draw_stun(damage_data)
            elif self.entity._debugger:
                self.entity._debugger.draw_stun(None)
            self._request_data()
        return

    def destroy(self):
        self.hide()
        self._body_win.release()
        BWPersonality.GUICore.worldLayer.delChild(self.component)