class Phase4Win(AdditionalWin):

    def __init__(self, entity, pos_x):
        AdditionalWin.__init__(self, entity, pos_x)
        self._lose_button = self.create_button(u'\u041a\u043e\u043d\u0447\u0438\u0442\u044c \u0432\u0440\u0435\u043c\u044f', self._on_lose_click)
        self._text = self.create_text()

    def _on_lose_click(self):
        self._run_debug('phase4endTimeRequest', None)
        return

    def set_data(self, active, time_remain):
        if active:
            self._text.text = u'\u0412\u0440\u0435\u043c\u044f \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c: {0:.0f}'.format(time_remain)
        else:
            self._text.text = u'\u041d\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e'
        self._lose_button.setDisabledState(not active)


