# Embedded file name: ./client/devil_utils/sounds_controller.py
import math_bw
from sounds_config import simple_sounds, healing_sound, idle_sound
from sounds_manager import playSound
from cdevil_utils.dutils import ServerEventType as SET, Stage
from devil_filter import EventType as FilterET

class SoundsController:

    def __init__(self, parent_entity):
        self._entity = parent_entity
        self._heal_sound = None
        self._idle_sound = None
        return

    def on_enter_world(self, dev_filter):
        self._dev_filter = dev_filter
        self._entity.model.allcues(self._on_que)
        if self._entity.state_index == Stage.Flowers:
            self._heal_sound = playSound(healing_sound, self._entity.model)
        if self._entity.state_index != Stage.Dead:
            self._idle_sound = playSound(idle_sound['path'], self._entity.model)
        self._dev_filter.add_listener(self._on_filter_event)
        self._update_idle_param()

    def _update_idle_param(self):
        if self._idle_sound:
            value = math_bw.clamp(float(self._dev_filter.speed) / idle_sound['maxspeed'])
            if not self._idle_sound.set_param('mob_speed', value):
                self._dev_filter.remove_listener(self._on_filter_event)

    def _on_filter_event(self, event_type, data):
        if event_type == FilterET.OnClientSpeedChanged:
            self._update_idle_param()

    def _on_que(self, cue_type, cue_name):
        if cue_name in simple_sounds:
            sound_path = simple_sounds.get(cue_name)
            playSound(sound_path, self._entity.model)

    def on_server_event(self, event_type, ints):
        if event_type == SET.OnFlowerStart:
            self._heal_sound = playSound(healing_sound, self._entity.model)
        elif event_type == SET.OnFlowerStop:
            if self._heal_sound:
                self._heal_sound.stop()
                self._heal_sound = None
        return

    def on_die(self):
        if self._idle_sound:
            self._idle_sound.stop()
            self._idle_sound = None
        return

    def release(self):
        if self._heal_sound:
            self._heal_sound.stop()
            self._heal_sound = None
        if self._idle_sound:
            self._idle_sound.stop()
            self._idle_sound = None
        self._entity.model.allcues(None)
        return