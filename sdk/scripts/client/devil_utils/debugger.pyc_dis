# Embedded file name: ./client/devil_utils/debugger.py
from Math import Vector3
import BigWorld
import draw_utils_extend
import DrawPrimitivesUtils

class Debugger(object):

    def __init__(self, entity):
        self._entity = entity
        self._sphere_holder = draw_utils_extend.LinesHolder(max_lines=0)
        self._strike_holder = draw_utils_extend.LinesHolder(max_lines=0)
        self._stun_holder = draw_utils_extend.LinesHolder(max_lines=0)
        self._trapper_ranges = None
        self._destroyed = False
        self._strike_controller_id = None
        BigWorld.callback(0, self._tick)
        return

    def set_trapper_ranges(self, range1, range2):
        self._trapper_ranges = (range1, range2)

    def draw_stun(self, stun_data):
        self._stun_holder.clear()
        if stun_data:
            radius, height = stun_data
            DrawPrimitivesUtils.draw_cilinder(self._entity.position + Vector3(0, height[0], 0), radius, height[1] - height[0], holder=self._stun_holder, alwaysdraw=False)

    def draw_strike(self, pos, radius, height):
        self._strike_holder.clear()
        DrawPrimitivesUtils.draw_cilinder(Vector3(pos), radius, height, holder=self._strike_holder, alwaysdraw=False)
        if self._strike_controller_id:
            BigWorld.cancelCallback(self._strike_controller_id)

        def clear_strikes():
            self._strike_holder.clear()
            self._strike_controller_id = None
            return

        self._strike_controller_id = BigWorld.callback(1.0, clear_strikes)

    def _tick(self):
        self._sphere_holder.clear()
        if self._destroyed or self._entity.isDestroyed:
            return
        if self._trapper_ranges:
            DrawPrimitivesUtils.draw_sphere(self._entity.position, self._trapper_ranges[0], holder=self._sphere_holder, alwaysdraw=False)
            DrawPrimitivesUtils.draw_sphere(self._entity.position, self._trapper_ranges[1], color=(0, 0, 1, 1), holder=self._sphere_holder, alwaysdraw=False)
        BigWorld.callback(0, self._tick)

    def destroy(self):
        self._destroyed = True
        self._sphere_holder.clear()
        self._strike_holder.clear()