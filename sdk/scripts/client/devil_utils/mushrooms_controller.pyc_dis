# Embedded file name: ./client/devil_utils/mushrooms_controller.py
import math_bw
from cdevil_utils.dutils import MAX_MUSHROOM_HEALTH

class MushroomsController(object):

    def __init__(self, entity):
        self._entity = entity
        self._override_mushroom_factor = None
        self._override_win_counter = None
        self._boxes = {}
        self._boxes_by_level = (('MushroomFront', 'MushroomFront2', 'MushroomBack', 'MushroomBack2'), ('MushroomFront2_lvl2', 'MushroomFront_lvl2', 'MushroomBack_lvl2', 'MushroomBack2_lvl2'), ('MushroomFront_lvl3', 'MushroomBack_lvl3'))
        return

    def on_enter_world(self):
        self._update_layers()

    def on_wincounter_changed(self):
        self._update_layers()

    def on_box_created(self, box, node_name, body_zone):
        self._boxes[box.name] = (box, node_name, body_zone)

    def on_mushroomhealth_updated(self):
        self._update_colours()

    def _assert_box_level(self, level, value):
        for box_name in self._boxes_by_level[level]:
            if value:
                if box_name in self._entity.colliderNames:
                    continue
                box, node_name, body_zone = self._boxes[box_name]
                self._entity.model.node(node_name).attach(box)
                self._entity.skeletonCollider.addCollider(box)
                self._entity.colliderNames[box.name] = body_zone
            else:
                if box_name not in self._entity.colliderNames:
                    continue
                box, node_name, body_zone = self._boxes[box_name]
                self._entity.model.node(node_name).detach(box)
                self._entity.skeletonCollider.delCollider(box)
                del self._entity.colliderNames[box.name]

    def on_stones_back_updated(self):
        self._update_stones()

    def _update_stones(self):
        model = self._entity.model
        if not model:
            return
        color = (self._entity.stone_back,) * 4
        counter = self._win_counter
        if counter <= 2:
            model.level_3_skinned._factor2 = color
        if counter <= 1:
            model.level_2_skinned._factor2 = color
        if counter <= 0:
            model.level_1_skinned._factor2 = color

    def _update_colours(self):
        model = self._entity.model
        if not model:
            return
        full_colour = (0, 0, 0, 0)
        black_colour = (0.7, 0.7, 0.7, 0.7)
        counter = self._win_counter
        if counter == 0:
            dynamic_skin = model.level_1_skinned
            model.level_2_skinned._factor1 = full_colour
            model.level_3_skinned._factor1 = full_colour
        elif counter == 1:
            dynamic_skin = model.level_2_skinned
            model.level_3_skinned._factor1 = full_colour
        elif counter == 2:
            dynamic_skin = model.level_3_skinned
        elif counter == 3:
            return
        try:
            dynamic_skin._factor1 = math_bw.lerp_rgb_colors(black_colour, full_colour, self._mushroom_factor)
        except:
            print '  Devil update skin (ERROR):', counter

    def override_mushroom_factor(self, factor):
        self._override_mushroom_factor = factor
        self._update_colours()

    def override_win_counter(self, counter):
        self._override_win_counter = counter
        self._update_layers()

    @property
    def _win_counter(self):
        if self._override_win_counter is None:
            return self._entity.win_counter
        else:
            return self._override_win_counter
            return

    @property
    def _mushroom_factor(self):
        if self._override_mushroom_factor is None:
            return math_bw.clamp(self._entity.mushroom_health / MAX_MUSHROOM_HEALTH)
        else:
            return self._override_mushroom_factor
            return

    def _update_layers(self):
        model = self._entity.model
        if not model:
            return
        counter = self._win_counter
        if counter == 0:
            model.level_1_skinned = 'on'
            model.level_2_skinned = 'on'
            model.level_3_skinned = 'on'
            self._assert_box_level(0, True)
            self._assert_box_level(1, False)
            self._assert_box_level(2, False)
        elif counter == 1:
            model.level_1_skinned = 'off'
            model.level_2_skinned = 'on'
            model.level_3_skinned = 'on'
            self._assert_box_level(0, False)
            self._assert_box_level(1, True)
            self._assert_box_level(2, False)
        elif counter == 2:
            model.level_1_skinned = 'off'
            model.level_2_skinned = 'off'
            model.level_3_skinned = 'on'
            self._assert_box_level(0, False)
            self._assert_box_level(1, False)
            self._assert_box_level(2, True)
        elif counter == 3:
            model.level_1_skinned = 'off'
            model.level_3_skinned = 'off'
            model.level_2_skinned = 'off'
            self._assert_box_level(0, False)
            self._assert_box_level(1, False)
            self._assert_box_level(2, False)
        self._update_colours()
        self._update_stones()