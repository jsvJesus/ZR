# Embedded file name: ./client/bheliclient/heli_gun.py
import math_bw
from Math import Vector3, Matrix
import BigWorld
from Bullets.BulletsController import BulletsController
from bheli.battleheli_utils import shoot_target_height, disperse_angle, scan_pitch, scan_dist

class HeliGun:

    def __init__(self, heli):
        self._heli = heli
        self._target_id = None
        self._tick_controller = None
        return

    def set_target(self, entity_id):
        self._target_id = entity_id
        if self._target_id and not self._tick_controller:
            self._tick()
        if not self._target_id and self._tick_controller:
            BigWorld.cancelCallback(self._tick_controller)
            self._tick_controller = None
        return

    def _tick(self):
        self._spawn_bullet()
        self._tick_controller = BigWorld.callback(0.1, self._tick)

    def _spawn_bullet(self):
        target = BigWorld.entities.get(self._target_id)
        if target:
            direction = target.position + Vector3(0, shoot_target_height, 0) - self._heli.position
        else:
            direction = Vector3()
            direction.setPitchYaw(scan_pitch, 0)
            direction = Matrix(self._heli.matrix).applyVector(direction)
            direction.normalise()
            direction *= scan_dist
        direction = math_bw.random_vector(direction, disperse_angle)
        position = self._heli.position
        BulletsController.spawn(self._heli, position, direction, 610041, 0, 0, False)

    def on_destroy(self):
        self.set_target(None)
        return