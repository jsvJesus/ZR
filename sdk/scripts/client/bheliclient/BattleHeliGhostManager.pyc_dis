# Embedded file name: ./client/bheliclient/BattleHeliGhostManager.py
import BWPersonality
import BigWorld
from functools import partial
from bheli import battleheli_utils

class BattleHeliGhostManager:

    def __init__(self):
        self._instances = []

    def onEnterSpace(self, space_name, space_id):
        self._del_instances()
        for heli_index in battleheli_utils.get_heli_list(space_name[7:]):
            data = {'index': heli_index}
            self._instances.append(BigWorld.createEntity('BattleHeliGhost', space_id, 0, (0, 0, 0), (0, 0, 0), data))

    def got_bheli_sync_data2(self, entity_id, heli_index, share_blob):
        for h_id in self._instances:
            heli = BigWorld.entities[h_id]
            if heli.index == heli_index:
                heli.got_bheli_sync_data3(entity_id, share_blob)
                break

    def onLeaveSpace(self):
        self._del_instances()

    def _del_instances(self):
        for bh_id in self._instances:
            BigWorld.destroyEntity(bh_id)

        self._instances = []


_helies_manager = BattleHeliGhostManager()

def add_listeners(attempts):
    if not hasattr(BWPersonality, 'game'):
        if attempts <= 0:
            raise RuntimeError
        BigWorld.callback(0.5, partial(add_listeners, attempts - 1))
        return
    BWPersonality.game.addListener('onPlayerAccount', _helies_manager.onLeaveSpace)
    BWPersonality.game.addListener('onPlayerEnteredSpace', _helies_manager.onEnterSpace)
    BWPersonality.game.addListener('onDisconnected', _helies_manager.onLeaveSpace)


add_listeners(100)

def got_bheli_sync_data1(entity_id, heli_index, share_blob):
    _helies_manager.got_bheli_sync_data2(entity_id, heli_index, share_blob)