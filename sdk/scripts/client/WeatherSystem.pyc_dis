# Embedded file name: ./client/WeatherSystem.py
import BigWorld
import ResMgr
import FX
from functools import partial
import traceback
import BloomC
import Math
import FX_extension
import math_bw
from utils import plog
from Math import Vector4
if BigWorld.component != 'editor':
    import BWPersonality as Personality
    from Settings import Settings

    def drawSound(*w, **kw):
        if Personality.GUICore:
            Personality.GUICore.drawSound(*w, **kw)


else:
    import Personality

    class Settings:

        def getEnvironmentVolume(self):
            return 1.0


    def drawSound(*w, **kw):
        pass


    class FakeMusic:

        def wind_speed_changed(self, value):
            pass


    Personality.music = FakeMusic()
import fader_object
import rainSystem
import rainConstant
config_path = 'scripts/data/weather.xml'

def loadWeatherXML(bReload = False):
    xmlobj = None
    if bReload:
        ResMgr.purge(config_path)
    if BigWorld.component != 'editor':
        xmlobj = ResMgr.openSection(config_path)
    else:
        xmlobj = ResMgr.openSection(config_path, True)
    stamp = ResMgr.modifiedTime(config_path)
    return (xmlobj, stamp)


weatherXML, weatherXMLStamp = loadWeatherXML()

class WeatherSystem:
    """
    This class represents a single weather system.  It binds together some
    skyboxes, an effect file, bloom settings, and a number of other built-in
    weather system properties.  It knows how to load all its required
    resources in the background, and fade between any existing weather system
    and its own.
    It loads from an XML data section, which by default can be found in the
    file "scripts/data/weather.xml".
    There are two main entry points for WeatherSystem
    - fadeIn
    - prepareResources
    Please see the pyDoc help for these methods for more detailed information.
    """

    def __init__(self, ds):
        self._rain_active = False
        self.shuts_down = False
        self.store_sounds = {}
        self.name = ds.name
        self._sound_fade_out_modif = 1.0
        self._sound_rain_roof_modif = 1.0
        self.skyBoxes = list(ds.readStrings('skyBox'))
        self.skyBoxModels = []
        self.rain = ds.readFloat('rain', 0.0)
        self.rainFog = ds.readVector4('rainFog', (0.208, 0.223, 0.275, 1))
        self.sun = ds.readVector4('sun', (1, 1, 1, 1))
        self.ambient = ds.readVector4('ambient', (1, 1, 1, 1))
        self.fog = ds.readVector4('fog', (1, 1, 1, 1))
        self.fogDensityMin = Math.Vector4(ds.readFloat('fogDensityMin', 0.15), 0, 0, 0)
        self.fogDensity = Math.Vector4(ds.readFloat('fogDensity', 1), 0, 0, 0)
        self.windSpeed = ds.readVector2('windSpeed', (0.0, 0.0))
        self.windGustiness = ds.readFloat('windGustiness', 0.0)
        self.fakeAmbientColour = ds.readVector4('fakeAmbientColour', Vector4(1, 1, 1, 0))
        self.fakeAmbientLightType = ds.readInt('fakeAmbientLightType', 0)
        self.terrainBlackFadeBase = ds.readFloat('terrainBlackFadeBase', 0.0)
        self.terrainBlackFadeGloss = ds.readFloat('terrainBlackFadeGloss', 0.0)
        self.terrainGlossAffect = ds.readFloat('terrainGlossAffect', 0.0)
        self.terrainAOGlossMultiplier = ds.readFloat('terrainAOGlossMultiplier', 1.0)
        self.terrainSpecularFresnelConstant = ds.readFloat('terrainSpecularFresnelConstant', 0.05)
        self.terrainSpecularFresnelMultiplier = ds.readFloat('terrainSpecularFresnelMultiplier', 4.5)
        self.terrainSpecularMultiplier = ds.readFloat('terrainSpecularMultiplier', 1.04)
        self.terrainSpecularPower = ds.readFloat('terrainSpecularPower', 60)
        self.terrainSpecularColor = ds.readVector4('terrainSpecularColor', Vector4(1, 1, 1, 1))
        self.terrainReflectionMap = ds.readString('terrainReflectionCubeMap', '')
        self.waterReflectionCubemap = ds.readString('waterReflectionCubemap', '')
        self.wetParams = (ds.readFloat('wetSpeedIn', 0.2), ds.readFloat('wetSpeedOut', 0.1), ds.readFloat('wetMaxValue', 1.0))
        self.mainLodFactor = ds.readFloat('mainLodFactor', 1.0)
        self.farPlaneFactor = ds.readFloat('farPlaneFactor', 1.0)
        self.dynamicShadowsEnabled = ds.readBool('dynamicShadowsEnabled', True)
        self.textureAnimation = ds.readString('fogAnimationTexture', '')
        self.thunder = {}
        if ds['thunder'] is not None:
            self.thunder['cooldown'] = ds['thunder'].readVector2('cooldown', (0, 0))
            self.thunder['lightning_far'] = ds['thunder'].readString('lightning_far', '')
            self.thunder['thunder_skybox'] = ds['thunder'].readString('thunder_skybox', '')
        self.skyBoxFogFactor = ds.readFloat('fogFactor', 0.15)
        self.bloom = ds['bloom']
        self.bloomPreset = ds.readString('bloom', 'Standard')
        self.fogDensityFader = Math.Vector4Morph()
        self.fogDensityFader.duration = 1.0
        f = self._fogAmount(self.fogDensity[0])
        self.fogDensityFader.target = (f,
         0,
         1,
         0)
        self.fxes = []
        self.fxNames = []
        if ds['sfx_array'] is not None:
            for key, value in ds['sfx_array'].items():
                if key != 'sfx':
                    continue
                sfx_name = value.asString
                if not sfx_name:
                    continue
                self.fxNames.append(value.asString)

        self.persistent_sfx_name = ds.readString('persistent_sfx_name')
        self.forestsound = ds.readString('forestsound')
        self.loaded = False
        self._fader_out_sound = fader_object.Fader(1.0, 1.0, self._onFaderSoundOut)
        self._fader_rain_sound = fader_object.Fader(1.0, 1.0, self._onFaderRainSound)
        self._rain_system = rainSystem.RainSystem(self._onRainSoundChange)
        return

    def _loadSkyBoxes(self, callback = None, immediate = False):
        if self.loaded:
            if callback:
                callback()
        elif not immediate:
            load_list = list(self.skyBoxes)
            if self.terrainReflectionMap != '':
                load_list.append(self.terrainReflectionMap)
            if self.waterReflectionCubemap != '':
                load_list.append(self.waterReflectionCubemap)
            BigWorld.loadResourceListBG(load_list, partial(self._onLoadSkyBoxes, callback))
        else:
            resourceRefs = {}
            for i in self.skyBoxes:
                try:
                    resourceRefs[i] = BigWorld.Model(i)
                    resourceRefs[i].splashDisabled = True
                    resourceRefs[i].alwaysDrawInReflection = True
                except ValueError:
                    resourceRefs[i] = BigWorld.Model('')

            if self.terrainReflectionMap != '':
                resourceRefs[self.terrainReflectionMap] = BigWorld.Texture(self.terrainReflectionMap)
            if self.waterReflectionCubemap != '':
                resourceRefs[self.waterReflectionCubemap] = BigWorld.Texture(self.waterReflectionCubemap)
            self._onLoadSkyBoxes(callback, resourceRefs)

    def _onLoadSkyBoxes(self, callback, resourceRef):
        self.loaded = True
        for sb in self.skyBoxes:
            try:
                self.skyBoxModels.append(resourceRef[sb])
                self.skyBoxModels[-1].splashDisabled = True
                self.skyBoxModels[-1].alwaysDrawInReflection = True
            except ValueError:
                self.skyBoxModels.append(BigWorld.Model(''))
                print '\nSB:', repr(sb)
                traceback.print_exc()

        if self.terrainReflectionMap != '':
            self.terrainReflectionMapTexture = resourceRef[self.terrainReflectionMap]
        else:
            self.terrainReflectionMapTexture = None
        self.waterReflectionMapTexture = resourceRef[self.waterReflectionCubemap] if self.waterReflectionCubemap != '' else None
        if callback != None:
            callback()
        return

    def _unload(self):
        plog('[WeatherSystem] unload name=%s' % self.name)
        for i in self.skyBoxModels:
            BigWorld.delSkyBox(i, self.fogDensityFader)

        self.skyBoxModels = []
        for fx in self.fxes:
            fx.stop()
            fx.detach()

        self.fxes = []
        self.loaded = False
        for sound in self.store_sounds.values():
            sound.stopSound()

        self.store_sounds = {}
        self._fader_out_sound.stop()
        self._fader_out_sound.destroy()
        self._fader_rain_sound.destroy()
        self._rain_system.destroy()

    def _loadFX(self, callback = None):
        if self.fxNames:
            resources = tuple()
            for fxName in self.fxNames:
                resources += FX.prerequisites(fxName)

            BigWorld.loadResourceListBG(resources, partial(self._onLoadFX, callback))
        elif callback:
            callback()

    def _onLoadFX(self, callback, resourceRef):
        plog('[WeatherSystem] onLoadFX fxNames=%s' % self.fxNames)
        for fx in self.fxes:
            fx.detach()

        self.fxes = []
        if not self.loaded:
            return
        self.store_sounds = {}
        for fxName in self.fxNames:
            self.fxes.append(FX.PersistentExt(fxName, resourceRef, store_sounds=self.store_sounds))

        if BigWorld.component == 'editor':

            class fakeSource:

                def playSound(self, arg):
                    pass

            for fx in self.fxes:
                fx.attach(fakeSource())

        else:
            if BigWorld.player():
                model = FX_extension.get_sfx_model(BigWorld.player())
                for fx in self.fxes:
                    fx.attach(model)

                self.rain > 0 and self._rain_system.attachToRain()
                Personality.gpd.weather.setStatusRain(True)
                self._rain_active = True
            BigWorld.callback(0.1, self.updateSonuds)
        for fx in self.fxes:
            fx.go()

        if callback:
            callback()

    def _fadeOutSounds(self, duration):
        if self._rain_active:
            Personality.gpd.weather.setStatusRain(False)
            self._rain_active = False
        if not self.store_sounds:
            return
        self._fader_out_sound.blendTo(0.0, duration / 1.1)

    def _onFaderSoundOut(self, volume):
        self._sound_fade_out_modif = volume
        self.updateSonuds()

    def _onRainSoundChange(self, volume, fade = True):
        self._fader_rain_sound.blendTo(volume, rainConstant.time_sounds_blend if fade else 0.1)

    def _onFaderRainSound(self, volume):
        self._sound_rain_roof_modif = volume
        self.updateSonuds()

    def updateSonuds(self):
        if not self.store_sounds:
            return
        player = BigWorld.player()
        if not player:
            return self._setSoundVolume(0.0)
        shell_modif = player.getSoundVolumeWeatherInShell()
        def_volume = Settings().getEnvironmentVolume()
        vol = def_volume * shell_modif * self._sound_fade_out_modif * self._sound_rain_roof_modif
        drawSound('W:shell', shell_modif)
        drawSound('W:fadeout', self._sound_fade_out_modif)
        drawSound('W:rain', self._sound_rain_roof_modif)
        drawSound('W:vol result', vol)
        self._setSoundVolume(vol)

    def _setSoundVolume(self, volume):
        if not self.store_sounds:
            return
        for sound_name, sound in self.store_sounds.items():
            try:
                sound.setVolume(volume)
            except:
                print 'WeatherSystem ', self.name, repr(sound_name)
                traceback.print_exc()

    def _fadeOutFX(self):
        plog('[WeatherSystem] fadeOutFX fxNames=%s' % self.fxNames)
        fade_times = [0.0]
        if self.fxes:
            for fx in self.fxes:
                fade_times.append(fx.stop())

        return max(fade_times)

    def fadeIn(self, fadingIn, fadeSpeed, immediate = False):
        """
        This method Fades in / out this weather system.  We load
        our models/textures on demand when fading in, and free them
        as soon as we have fully faded out.
        If immediate is set to True, then the natural fade out speed
        of the effect is clamped to the passed in fade time. This may cause it
        to noticeably pop when detached from the scene.  If     immediate is False,
        the effect will fade out at its own natural speed, determined by the
        effect itself to prevent popping.
        """
        plog('[WeatherSystem] fadeIn name=%s loaded=%s fadingIn=%s fadeSpeed=%s immediate=%s' % (self.name,
         self.loaded,
         fadingIn,
         fadeSpeed,
         immediate))
        curr = self.fogDensityFader.value
        if fadingIn:
            if not self.loaded:
                print "calling fadeIn on a weather system that isn't loaded.  please call prepareResources() first", self.name
                traceback.print_stack()
                return
            for sb in self.skyBoxModels:
                if sb != None:
                    sb.splashDisabled = True
                    sb.alwaysDrawInReflection = True
                    sb.batched = False
                    BigWorld.addSkyBox(sb, self.fogDensityFader)

            f = self._fogAmount(self.fogDensity[0])
            self.fogDensityFader.duration = fadeSpeed - 0.1
            self.fogDensityFader.target = (f,
             0,
             1,
             1)
            try:
                BigWorld.weather().windAverage(self.windSpeed[0], self.windSpeed[1])
                wind_speed = Math.Vector2(self.windSpeed[0], self.windSpeed[1])
                Personality.music.wind_speed_changed(math_bw.clamp(wind_speed.length, 0, 15))
                BigWorld.weather().windGustiness(self.windGustiness)
            except ValueError:
                pass
            except EnvironmentError:
                pass

            if self.bloom:
                BloomC.loadStyle(self.bloom, fadeSpeed)
            else:
                BloomC.selectPreset(self.bloomPreset, fadeSpeed)
        elif self.loaded:
            sfxFadeSpeed = self._fadeOutFX()
            if not immediate:
                fadeSpeed = max(fadeSpeed, sfxFadeSpeed)
            self._fadeOutSounds(fadeSpeed)
            BigWorld.callback(fadeSpeed, self._unload)
            self.fogDensityFader.duration = fadeSpeed - 0.1
            self.fogDensityFader.target = (curr[0],
             curr[1],
             curr[2],
             0)
        return

    def _fogAmount(self, amount):
        """
        Returns the fog amount.  This is adjusted by the sky box fog factor
        so the fog and the skyboxes interact correctly.
        """
        return (amount - 1.0) * self.skyBoxFogFactor

    def prepareResources(self, callback = None, immediate = False):
        """
        This method prepares the weather system for use.  It cues up
        resource loading in the background thread, and when ready, calls
        the supplied callback function.  If immediate is set to true,
        the callback function is called immediately, and no resources are
        preloaded.  This will probably then cause resource loading to hit
        and stall the main thread when this weather system is summoned.
        """
        if not self.loaded:
            self._loadSkyBoxes(partial(self._loadFX, callback), immediate)
        elif callback:
            callback()

    def setFadeSpeed(self, duration):
        """
        This method sets the fade in/out speed for the weather system.
        """
        self.fogDensityFader.duration = duration
        self.shuts_down = True

    def edUnloadSkyBoxes(self):
        """
        This method unsets all sky boxes used by this weather system.
        """
        for sb in self.skyBoxModels:
            if sb != None:
                BigWorld.delSkyBox(sb, self.fogDensityFader)

        return

    def edReloadSkyBoxes(self):
        """
        This method resets all sky boxes used by this weather system, and
        makes sure the skybox models list properly reflects the contents
        of the skyboxes list.
        """
        self.skyBoxModels = []
        for sb in self.skyBoxes:
            try:
                model = BigWorld.Model(sb)
            except ValueError:
                model = BigWorld.Model('')

            model.splashDisabled = True
            model.alwaysDrawInReflection = True
            model.batched = False
            self.skyBoxModels.append(model)
            BigWorld.addSkyBox(model, self.fogDensityFader)