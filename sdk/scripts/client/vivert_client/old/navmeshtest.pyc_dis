# Embedded file name: ./client/vivert_client/old/navmeshtest.py
from time import time
from drawable import DrawType, clear_channel
import BWPersonality
from Math import Matrix, Vector3
import BigWorld
from sys import float_info
f_max = float_info.max
from octotree import OctoTree, Triangle, BoundBox
from navmesh import Navmesh
BWPersonality._key_event_interceptors[:] = []
if hasattr(BigWorld, 'zim_models'):
    for m in BigWorld.zim_models:
        try:
            BigWorld.delModel(m)
        except:
            pass

BigWorld.zim_models = []
model_path = 'models/temp/test_plane/test_plane.model'
model_path = 'models/bolvan/navgen2/navgen_test1.model'
model = BigWorld.Model(model_path)
test_model1 = BigWorld.Model('models/test/xyz.model')
test_model2 = BigWorld.Model('models/test/xyz.model')
BigWorld.addModel(test_model1)
BigWorld.addModel(test_model2)
BigWorld.zim_models.append(test_model1)
BigWorld.zim_models.append(test_model2)
matrix = Matrix()
matrix.setTranslate(BigWorld.player().position + Vector3(0, 2, 0))
model.setWorldTransform(matrix)
test_model1.setWorldTransform(matrix)
matrix2 = Matrix()
matrix2.setTranslate(BigWorld.player().position + Vector3(2, 2, 0))
test_model2.setWorldTransform(matrix2)
gi = BigWorld.getGeometricInstance()
triangles = []
gi.removeAll()
p_min = Vector3(f_max, f_max, f_max)
p_max = Vector3(-f_max, -f_max, -f_max)
mesh_data = model.getMesh(model_path)
for adress1 in xrange(len(mesh_data)):
    for adress2 in xrange(len(mesh_data[adress1])):
        local_vertices = mesh_data[adress1][adress2]['vertices']
        world_vertices = map(matrix.applyPoint, local_vertices)
        indices = mesh_data[adress1][adress2]['indices']
        for i0 in range(0, len(indices), 3):
            i1, i2 = i0 + 1, i0 + 2
            p0 = world_vertices[indices[i0]]
            p1 = world_vertices[indices[i1]]
            p2 = world_vertices[indices[i2]]
            triangle = Triangle(p0, p1, p2)
            triangles.append(triangle)
            for i in range(3):
                p_min[i] = min(p_min[i], triangle.bb.p_min[i])
                p_max[i] = max(p_max[i], triangle.bb.p_max[i])

size = max(p_max - p_min)
p_max = p_min + Vector3(size, size, size)
tree = OctoTree(BoundBox(p_min, p_max), triangles)
tree.propagate_neigbours([])
tree.draw(color=(1, 1, 1, 1))
BigWorld.zim_models.append(model)
navmesh = Navmesh(tree)

def on_key(event):
    if not event.isKeyDown():
        return True
    clear_channel('x')
    dirs = {30: (-1, 0, 0),
     32: (1, 0, 0),
     17: (0, 0, 1),
     31: (0, 0, -1),
     18: (0, 1, 0),
     16: (0, -1, 0)}
    direction = Vector3(dirs.get(event.key, (0, 0, 0)))
    if event.isCtrlDown():
        direction = Vector3()
    matrix = Matrix()
    matrix.setTranslate(direction * 0.5)
    matrix.preMultiply(Matrix(test_model1.matrix))
    test_model1.setWorldTransform(matrix)
    total_time = 0
    cur_time = time()
    point = tree.bb.project_point(matrix.translation)
    dist, point, node = navmesh.search_nearest_node(point)
    total_time += time() - cur_time
    node.draw(draw_type=DrawType.Solid, channel='x')
    direction = Vector3()
    if event.isCtrlDown():
        direction = Vector3(dirs.get(event.key, (0, 0, 0)))
    matrix = Matrix()
    matrix.setTranslate(direction * 0.5)
    matrix.preMultiply(Matrix(test_model2.matrix))
    test_model2.setWorldTransform(matrix)
    cur_time = time()
    point = tree.bb.project_point(matrix.translation)
    dist, point, node = navmesh.search_nearest_node(point)
    total_time += time() - cur_time
    node.draw(draw_type=DrawType.Solid, channel='x')
    print total_time
    return True


BWPersonality._key_event_interceptors.append(on_key)