import BigWorld
from collections import defaultdict
gi = BigWorld.getGeometricInstance()

class DrawType:
    Wire, Solid = range(2)


def clear_channel(channel):
    if channel in _active_drawables:
        for drawable in _active_drawables[channel]:
            drawable.clear()

        del _active_drawables[channel]


_active_drawables = defaultdict(set)

class Drawable:

    def __init__(self):
        self._gi_handler = None
        self._channel = None
        return

    def clear(self):
        if self._channel in _active_drawables:
            if self in _active_drawables[self._channel]:
                if self._gi_handler:
                    gi.remove(self._gi_handler)
                    self._gi_handler = None
        return

    def draw(self, color = (1, 0, 0, 1), draw_type = DrawType.Wire, channel = None):
        self.clear()
        self._channel = channel
        points_list = self.get_draw_data(draw_type)
        points = [ (p, color) for p in points_list ]
        if draw_type == DrawType.Wire:
            primitive_type = 2
            primitive_count = len(points) / 2
        elif draw_type == DrawType.Solid:
            primitive_type = 4
            primitive_count = len(points) / 3
        self._gi_handler = gi.addWorldPrimitive(points, primitive_type, len(points) / primitive_count, True)
        _active_drawables[channel].add(self)

    def get_draw_data(self, draw_type):
        raise NotImplementedError