# Embedded file name: ./client/vivert_client/old/navmesh.py
from drawable import Drawable
from collections import defaultdict

class Node(Drawable):

    def __init__(self, tri):
        Drawable.__init__(self)
        self.triangle = tri

    def set_neigbours(self, nodes):
        self.neigbours = nodes

    def get_draw_data(self, draw_type):
        return self.triangle.get_draw_data(draw_type)


class Navmesh:

    def __init__(self, octotree):
        self.octotree = octotree
        triangle_to_bb = defaultdict(set)
        for bb in octotree.iterate_low_level():
            for tri in bb.triangles:
                triangle_to_bb[tri].add(bb)

        tri_to_tris = {}
        self._tri_to_node = {}
        nodes = []
        for tri, bbs in triangle_to_bb.iteritems():
            potential_tris = set()
            for bb in bbs:
                for t in bb.triangles:
                    potential_tris.add(t)

                for n in bb.neigbours:
                    for t in n.triangles:
                        potential_tris.add(t)

            potential_tris.remove(tri)
            linked_tris = []
            for ptri in potential_tris:
                if ptri.is_connected_to_tri(tri):
                    linked_tris.append(ptri)

            tri_to_tris[tri] = linked_tris
            node = Node(tri)
            self._tri_to_node[tri] = node
            nodes.append(node)

        for node in nodes:
            neigbours = []
            for t in tri_to_tris[node.triangle]:
                neigbours.append(self._tri_to_node[t])

            node.set_neigbours(neigbours)

    def search_nearest_node(self, point):
        dist, point, triangle = self.octotree.search_nearest_triangle(point)
        return (dist, point, self._tri_to_node[triangle])