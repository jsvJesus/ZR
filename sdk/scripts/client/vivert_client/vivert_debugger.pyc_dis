# Embedded file name: ./client/vivert_client/vivert_debugger.py
import DrawPrimitivesUtils
from utils import Destructable
from draw_utils_extend import LinesHolder

class VivertDebugger(Destructable):

    def __init__(self, vivert):
        self._vivert = vivert
        Destructable.__init__(self)
        self._sensor_holder = LinesHolder(max_lines=0)
        self._sensor_range = None
        return

    def on_tick(self):
        self._sensor_holder.clear()
        if self._sensor_range:
            for radius in self._sensor_range:
                DrawPrimitivesUtils.draw_sphere(self._vivert.position, radius, holder=self._sensor_holder, alwaysdraw=False)

    def set_sensor(self, sensor_range):
        self._sensor_range = sensor_range