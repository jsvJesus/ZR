# Embedded file name: ./client/vivert_client/dbug_target.py
from Math import Vector3, Matrix
import BigWorld
from utils import Destructable
import Keys

class Target(Destructable):
    _speed = 2.0

    def __init__(self, position):
        Destructable.__init__(self)
        self._model = BigWorld.Model('models/test/xyz.model')
        BigWorld.addModel(self._model)
        self._matrix = Matrix()
        self._matrix.setTranslate(position)

    def on_tick(self):
        up = 0
        translation = Vector3()
        if BigWorld.isKeyDown(200):
            if BigWorld.isKeyDown(Keys.KEY_LSHIFT) or BigWorld.isKeyDown(Keys.KEY_RSHIFT):
                up += 1
            else:
                translation[1] += 1
        if BigWorld.isKeyDown(208):
            if BigWorld.isKeyDown(Keys.KEY_LSHIFT) or BigWorld.isKeyDown(Keys.KEY_RSHIFT):
                up -= 1
            else:
                translation[1] -= 1
        if BigWorld.isKeyDown(Keys.KEY_LEFTARROW):
            translation[0] -= 1
        if BigWorld.isKeyDown(Keys.KEY_RIGHTARROW):
            translation[0] += 1
        cam_matrix = Matrix(BigWorld.camera().matrix)
        cam_matrix.invert()
        translation = cam_matrix.applyVector(translation)
        translation[1] = up
        if translation.length > 0:
            translation.normalise()
            translation *= BigWorld.getTimeDelta() * Target._speed
            t = Matrix()
            t.setTranslate(translation)
            self._matrix.postMultiply(t)
        self._model.setWorldTransform(self._matrix)

    @property
    def position(self):
        return self._model.position

    def on_release(self):
        BigWorld.delModel(self._model)