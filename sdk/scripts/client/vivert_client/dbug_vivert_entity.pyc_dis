# Embedded file name: ./client/vivert_client/dbug_vivert_entity.py
from Math import Vector3, Matrix
import Keys
from utils import Destructable
import BigWorld
from vivert_common.vivert_utils import model_path
gi = BigWorld.getGeometricInstance()

class DebugVivert(Destructable):
    _speed = 2.0
    _rot_speed = 2.0

    def __init__(self, position):
        Destructable.__init__(self)
        self._position = Vector3(position)
        self._rotation = Vector3()
        self._entity = None
        self._model = None
        self._entity = self._create_entity(position)
        self._cross_model = BigWorld.Model('models/test/xyz.model')
        self._cross_entity = BigWorld.Model('models/test/xyz.model')
        self._cross_mine = BigWorld.Model('models/test/xyz.model')
        BigWorld.addModel(self._cross_model)
        BigWorld.addModel(self._cross_entity)
        BigWorld.addModel(self._cross_mine)
        return

    def _create_entity(self, position):
        p = BigWorld.player()
        props = {'modelString': model_path}
        entity_id = BigWorld.createEntity('EmptyEntity', p.spaceID, 0, position, (0, 0, 0), props)
        entity = BigWorld.entities[entity_id]
        entity.filter = BigWorld.PythonFilter()
        entity.filter.resetFilter = lambda time: None
        entity.filter.inputFilter = self._input
        entity.filter.outputFilter = self._output
        entity.filter.lastInputFilter = self._last_input
        ac = BigWorld.ActionController(entity.model)
        ac.attach()
        return entity

    def _input(self, time, space_id, vehicle_id, pos, pos_error, rotation):
        pass

    def _output(self, time):
        return (self._position, self._rotation, Vector3())

    def _last_input(self, *args):
        return None

    def _create_model(self, position):
        model = BigWorld.Model(model_path)
        BigWorld.addModel(model)
        return model

    def on_tick(self, target, gi_handlers):
        up = 0
        cross_t = Matrix()
        translation = Vector3()
        rotation = Vector3()
        if not BigWorld.isKeyDown(Keys.KEY_LSHIFT):
            shifted = BigWorld.isKeyDown(Keys.KEY_RSHIFT)
            if BigWorld.isKeyDown(200):
                if shifted:
                    up += 1
                else:
                    translation[1] += 1
            if BigWorld.isKeyDown(208):
                if shifted:
                    up -= 1
                else:
                    translation[1] -= 1
            if BigWorld.isKeyDown(Keys.KEY_LEFTARROW):
                if shifted:
                    rotation[0] -= 1
                else:
                    translation[0] -= 1
            if BigWorld.isKeyDown(Keys.KEY_RIGHTARROW):
                if shifted:
                    rotation[0] += 1
                else:
                    translation[0] += 1
            if BigWorld.isKeyDown(Keys.KEY_PGDN):
                if shifted:
                    rotation[1] += 1
                else:
                    rotation[2] += 1
            if BigWorld.isKeyDown(Keys.KEY_PGUP):
                if shifted:
                    rotation[1] -= 1
                else:
                    rotation[2] -= 1
            cam_matrix = Matrix(BigWorld.camera().matrix)
            cam_matrix.invert()
            translation = cam_matrix.applyVector(translation)
            translation[1] = up
            matrix = Matrix()
            if rotation.length > 0:
                rotation.normalise()
                rotation *= BigWorld.getTimeDelta() * DebugVivert._rot_speed
                self._rotation += rotation
            if translation.length > 0:
                translation.normalise()
                translation *= BigWorld.getTimeDelta() * DebugVivert._speed
                self._position += translation
            r = Matrix()
            r.setRotateYPR(self._rotation)
            t = Matrix()
            t.setTranslate(self._position)
            matrix.postMultiply(r)
            matrix.postMultiply(t)
            if self._entity:
                cross_t.setTranslate((0, 1.5, 0))
                m = Matrix(self._entity.matrix)
                m.preMultiply(cross_t)
                self._cross_entity.setWorldTransform(m)
                if self._entity.model:
                    m = Matrix(self._entity.model.matrix)
                    cross_t.setTranslate((0, 1, 0))
                    m.preMultiply(cross_t)
                    self._cross_model.setWorldTransform(m)
            self._model and self._model.setWorldTransform(matrix)
        m = Matrix(matrix)
        cross_t.setTranslate((0, 2, 0))
        m.preMultiply(cross_t)
        self._cross_mine.setWorldTransform(m)

    @property
    def position(self):
        return self._position

    def on_release(self):
        if self._entity:
            BigWorld.destroyEntity(self._entity.id)
        if self._model:
            BigWorld.delModel(self._model)
            self._model = None
        BigWorld.delModel(self._cross_model)
        BigWorld.delModel(self._cross_entity)
        BigWorld.delModel(self._cross_mine)
        return