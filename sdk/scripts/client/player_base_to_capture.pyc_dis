# Embedded file name: ./client/player_base_to_capture.py
""" \xd0\xb2\xd0\xb7\xd0\xb0\xd0\xb8\xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb5 \xd1\x81 \xd0\xb1\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbe\xd0\xb9 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0. \xd0\xa2\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f PlayerAvatar

"""
import BWPersonality
import base_constants
from utils import ignoreError
from collections import defaultdict
from Constants import ControlLockTypes
from Helpers.PyGUI.PyGUIBase import Interceptor
_base_flags = defaultdict(list)
_base_states_under_atack = {}

@ignoreError
def registerBaseflag(base_name, flag):
    _base_flags[base_name].append(flag)
    under_attack_style = _base_states_under_atack.get(base_name, False)
    flag.setMarkVisibleMode(under_attack_style)


@ignoreError
def unRegisterBaseflag(base_name, flag):
    if flag in _base_flags[base_name]:
        _base_flags[base_name].remove(flag)


class PlayerBaseToCapture:
    _capture_flag_buying = False
    _capture_current_base = None

    def onEnterWorld(self, *e):
        self._back_comp = None
        return

    def onLeaveWorld(self, *e):
        _base_flags.clear()
        _base_states_under_atack.clear()
        self.capture_flag_buying = False
        self._capture_current_base = None
        return

    @ignoreError
    def _updateFlagsVisibleMode(self, base_name):
        under_attack_style = _base_states_under_atack.get(base_name, False)
        for base_flag in _base_flags.get(base_name, []):
            base_flag.setMarkVisibleMode(under_attack_style)

    def adjust_base_flags_data(self, base_name, volatile_data):
        """\xd0\xa3\xd1\x82\xd0\xbe\xd1\x87\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xb2 \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.adjust_flags_data(base_name, volatile_data)
        self._capture_current_base = base_name

    def rewrite_flags_data(self, base_name, new_data):
        """\xd0\xa3\xd1\x82\xd0\xbe\xd1\x87\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xb2 \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.rewrite_flags_data(base_name, new_data)
        self._capture_current_base = base_name

    def remove_base_flags_data(self, base_name):
        if base_name != self._capture_current_base:
            return
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.remove_base_data(base_name)
        _base_states_under_atack[base_name] = False
        self._updateFlagsVisibleMode(base_name)
        self._append_event('left', base_name)

    def set_init_base_capture_time(self, base_name, inti_capture_time, cycle_time, time_of_capture, silence = False):
        """\xd0\x97\xd0\xb0\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2 GUI \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xb8\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbe \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8 \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.set_init_base_capture_time(base_name, inti_capture_time, cycle_time, time_of_capture, silence)
        self._append_event('entered', base_name)

    def send_full_b2c_data(self, base_name, inti_capture_time, cycle_time, time_of_capture, base_owner_name, state_code, start_capture_time_server, next_capture_time_server, volatile_data):
        self.set_base_owner_name(base_name, base_owner_name)
        self.set_init_base_capture_time(base_name, inti_capture_time, cycle_time, time_of_capture, True)
        self.adjust_base_flags_data(base_name, volatile_data)
        self.set_base_state(base_name, state_code, start_capture_time_server, next_capture_time_server)
        gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        gui.show()
        gui.fully_update_component(base_name)

    @property
    def is_capture_member(self):
        if not BWPersonality.GUICore.is_base_to_capture_gui_visible():
            return False
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        return base_gui.is_current_under_attack()

    def get_current_base_name(self):
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        return base_gui.get_current_base_name()

    def get_current_base_owner(self):
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        return base_gui.get_current_base_owner()

    def set_base_state(self, base_name, state_code, start_capture_time_server, next_capture_time_server):
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        start_capture_time = start_capture_time_server + BWPersonality.gpd.time_diff
        next_capture_time = next_capture_time_server + BWPersonality.gpd.time_diff
        base_gui.change_status(base_name, state_code, start_capture_time, next_capture_time)
        if state_code != base_constants.PEACEFUL_STATE:
            BWPersonality.GUICore.showBaseMoneyInfo(False)
        _base_states_under_atack[base_name] = state_code == base_constants.UNDERATACK_STATE
        self._updateFlagsVisibleMode(base_name)
        self._append_event('state', (base_name, _base_states_under_atack[base_name]))

    def _append_event(self, event_type, data):
        """ \xd1\x81\xd0\xbe\xd0\xb1\xd0\xb8\xd1\x80\xd0\xb0\xd1\x8e \xd0\xb2 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb1\xd0\xb0\xd0\xb7\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f \xd0\xb8 \xd0\xb7\xd0\xb4\xd0\xb5\xd1\x81\xd1\x8c \xd0\xb8\xd1\x85 \xd0\xb0\xd0\xbd\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb8\xd1\x80\xd1\x83\xd1\x8e
                \xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xb3\xd0\xb5\xd0\xbd\xd0\xb5\xd1\x80\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbd\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb5 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbb\xd0\xb5\xd0\xba\xd1\x81\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f
        """
        if not hasattr(self, '_events_history'):
            self._events_history = []
        if event_type == 'entered':
            for i in xrange(len(self._events_history) - 1, -1, -1):
                et = self._events_history[i][0]
                if et == 'entered':
                    return
                if et == 'left':
                    break

        if len(self._events_history) > 0:
            if (event_type, data) == self._events_history[-1]:
                return
        self._events_history.append((event_type, data))
        self._events_history = self._events_history[-5:]
        if event_type == 'state' and len(self._events_history) > 2:
            base_name, under_attack = data
            prev_event_type, prev_data = self._events_history[-2]
            if prev_event_type == 'state':
                prev_base_name, prev_under_attack = prev_data
                if prev_base_name == base_name:
                    if not prev_under_attack and under_attack:
                        self.on_base_attack_start(base_name)
                    elif prev_under_attack and not under_attack:
                        self.on_base_attack_stop(base_name)
        if event_type == 'left':
            base_name = data
            self.on_base_left(base_name)
        if event_type == 'entered':
            base_name = data
            self.on_base_entered(base_name)

    def set_base_owner_name(self, base_name, base_owner_name):
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.base_owner(base_name, base_owner_name)

    def set_flags_on_purchase_data(self, base_name, flags_on_purchase, camera_nodes, flag_cost, base_money):
        """
        \xd0\x91\xd0\xb0\xd0\xb7\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbe \xd0\xba\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x80\xd0\xb0\xd1\x85 \xd0\xbd\xd0\xb0\xd0\xb4 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0\xd0\xbc\xd0\xb8 \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5 
        \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0 send_flags_on_purchase (\xd1\x83 \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b).
        """
        BWPersonality.GUICore.updateBase2CaptureMoney(base_name, base_money)
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.start_flag_buying(base_name, flags_on_purchase, camera_nodes, flag_cost, base_money)
        self.capture_flag_buying = True

    def buy_flag(self, base_name, unique_str_id):
        """\xd0\x9a\xd1\x83\xd0\xbf\xd0\xb8\xd1\x82\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3."""
        self.cell.buy_flag(base_name, unique_str_id)

    def on_buy_flag(self, base_name, unique_str_id, success, base_money):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x80\xd0\xb5\xd0\xb7\xd1\x83\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb0\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbf\xd1\x8b\xd1\x82\xd0\xba\xd0\xb8 \xd0\xba\xd1\x83\xd0\xbf\xd0\xb8\xd1\x82\xd1\x8c \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3."""
        BWPersonality.GUICore.updateBase2CaptureMoney(base_name, base_money)
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.on_buy_flag(base_name, unique_str_id, success, base_money)

    def stop_buying(self, base_name):
        """\xd0\x9e\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8 \xd0\xbd\xd0\xb0 \xd0\xb1\xd0\xb0\xd0\xb7\xd0\xb5."""
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.stop_buying()
        self.capture_flag_buying = False

    def on_buy_guard(self, base_name, success, data):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x80\xd0\xb5\xd0\xb7\xd1\x83\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb0\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbf\xd1\x8b\xd1\x82\xd0\xba\xd0\xb8 \xd0\xba\xd1\x83\xd0\xbf\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0."""
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.on_buy_guard(base_name, success)
        base_gui.on_change_guard_count(base_name, data)

    def start_guardians_buying(self):
        """\xd0\x9d\xd0\xb0\xd1\x87\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd1\x83 \xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb2-NPC."""
        self.cell.start_guardians_buying()

    def set_guard_zone_data(self, base_name, data):
        """\xd0\x97\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb0\xd1\x88\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8 \xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb2."""
        base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
        base_gui.start_guardians_buying(base_name, data)

    def post_guardian(self, base_name, guard_type):
        """\xd0\x9a\xd1\x83\xd0\xbf\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b."""
        self.cell.post_guardian(base_name, guard_type)

    def remove_guardians(self, base_name):
        self.cell.remove_guardians(base_name)

    @property
    def capture_flag_buying(self):
        return self._capture_flag_buying

    @capture_flag_buying.setter
    def capture_flag_buying(self, value):
        if self._capture_flag_buying == value:
            return
        self._capture_flag_buying = bool(value)
        self.setControlLock(ControlLockTypes.INTERFACE, self._capture_flag_buying)
        if self._capture_flag_buying:
            if not self._back_comp:
                import GUI
                comp = GUI.Window()
                comp.hpm, comp.vpm = ('CLIP', 'CLIP')
                comp.wm, comp.hm = ('CLIP', 'CLIP')
                comp.ha, comp.va = ('CENTER', 'CENTER')
                comp.width, comp.height = (2, 2)
                comp.position = (0, 0, 1.0)
                BWPersonality.GUICore.flashWorldLayer.addChild(comp)
                Interceptor(comp, True, True, True)
                self._back_comp = comp
            self._back_comp.visible = True
            BWPersonality.GUICore.worldLayer.visible = False
        elif self._back_comp:
            self._back_comp.visible = False
            if not BWPersonality.GUICore.hiddenState:
                BWPersonality.GUICore.worldLayer.visible = True