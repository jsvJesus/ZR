from Math import Matrix, Vector3, Vector2

class LinearBlendVec3:

    def __init__(self, step = 0.1):
        self.curentValue_ = Vector3()
        self.valueTo_ = Vector3()
        self.accelerationStep_ = step

    def setValueTo(self, val):
        self.valueTo_ = Vector3(val)

    def setCurrentValue(self, val):
        self.curentValue_ = Vector3(val)

    def getCurrentValue(self):
        return self.curentValue_

    def updateBlend(self, dtime):
        step = self.accelerationStep_ * dtime
        deltavec = self.valueTo_ - self.curentValue_
        deltaPos = deltavec.length
        if step > deltaPos:
            step = deltaPos
        deltavec.normalise()
        self.curentValue_ = self.curentValue_ + deltavec * step


class PercentBlendVec3(LinearBlendVec3):

    def updateBlend(self, dtime):
        deltavec = self.valueTo_ - self.curentValue_
        self.curentValue_ = self.curentValue_ + deltavec * self.accelerationStep_


class IntertionBlendVec3(LinearBlendVec3):

    def __init__(self, step = 10.0, speed_step = 0.92):
        self.min_fps = 5
        self.curentValue_ = Vector3()
        self.valueTo_ = Vector3()
        self.accelerationStep_ = step
        self.accelerationStepSpeed_ = speed_step
        self.speed_ = LinearBlendVec3(speed_step)

    def updateBlend(self, dtime):
        if dtime > 1.0 / self.min_fps:
            self.speed_.valueTo_ = Vector3(0, 0, 0)
            self.speed_.curentValue_ = Vector3(0, 0, 0)
            self.curentValue_ = Vector3(self.valueTo_)
        deltavec = self.valueTo_ - self.curentValue_
        deltaPos = deltavec.length
        self.speed_.accelerationStep_ = self.accelerationStepSpeed_
        self.speed_.setValueTo(deltavec)
        self.speed_.updateBlend(dtime)
        step = self.accelerationStep_ * dtime
        self.curentValue_ = self.curentValue_ + self.speed_.getCurrentValue() * step


class IntertionBlendVec3_v2(PercentBlendVec3):
    inertinon_mode = False
    _inert_speed = 0
    _inert_speedcos = 0
    _inert_dir = Vector3(0, 0, 1)

    def updateBlend(self, dtime):
        if self.inertinon_mode:
            if self._inert_speed <= 0.001:
                self.curentValue_ *= 0.01
            else:
                factor = -self._inert_speed ** 2 * math.cos(self._inert_speedcos)
                self.curentValue_ = self._inert_dir * factor
                self._inert_speed -= dtime * 1.3
                self._inert_speedcos -= dtime * 5.5
        else:
            deltavec = self.valueTo_ - self.curentValue_
            self.curentValue_ = self.curentValue_ + deltavec * self.accelerationStep_
            self._inert_speedcos = math.pi
            self._inert_speed = 1.0
            self._inert_dir = Vector3(self.curentValue_)