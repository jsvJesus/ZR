# Embedded file name: ./client/ClientDebugInfo.py
import BWPersonality
import BigWorld
import soGUI
import Stats
ENABLE_DEBUG_INFO = True
speedLabelID = 1
distanceLabelID = 2
target_id = 0

def setTarget(entity_id):
    target_id = entity_id


def update(avatar):
    if not ENABLE_DEBUG_INFO:
        return
    moveSpeed = avatar.GetStatValue(Stats.ch_MoveSpeed)
    text = 'Speed: %.1f' % moveSpeed
    BWPersonality.GUICore.drawLabel(text=text, id=speedLabelID, x=235, y=7)
    try:
        ent = BigWorld.entities[target_id]
        dist = avatar.position.distTo(ent.position)
        text = 'Dist: %.1f' % dist
        BWPersonality.GUICore.drawLabel(text=text, id=distanceLabelID, x=235, y=15)
    except KeyError:
        pass