# Embedded file name: ./client/FireWorks.py
import BigWorld
import ResourceLoader
import random
import ItemsUtils
import FX
from sounds_manager import playSound
from Constants import FireWorksType
import traceback
from functools import partial
PARTICLE_FIREWORKS_PATH = 'particles/fireworks_fuse_white.xml'
PARTICLE_FIREWORKS_NG_PATH = 'particles/ng_fireworks.xml'
PARTICLE_FIREWORKS_SPARKS_PATH = 'particles/fireworks_sparks.xml'

class FireWorks(BigWorld.Entity):
    """" client/FireWorks """
    MODEL_NAME = 'models/props/ng/fireworks_01_lod1.model'
    SOUND_BOOMS = 'environment/fireworks/booms'
    SOUND_FIRELINE = 'environment/fireworks/fireline'
    SOUND_ROCKETSTART = 'environment/fireworks/rocketstart'
    SOUND_SPARKLE = 'environment/fireworks/sparkler_big'

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.modelFuseS = None
        self.sparkler_sound = None
        return

    def prerequisites(self):
        return [self.MODEL_NAME, PARTICLE_FIREWORKS_PATH]

    def onEnterWorld(self, prereqs):
        self.model = prereqs[self.MODEL_NAME]
        self.modelFuse = BigWorld.Model('')
        self.model.node('HP_flare').attach(self.modelFuse)
        self.PFuse = prereqs[PARTICLE_FIREWORKS_PATH]
        if self.fuseIsBurning:
            self.set_fuseIsBurning(333)

    def set_fuseIsBurning(self, old):
        if self.fuseIsBurning:
            if self.model:
                self.model.visible = True
            self.modelFuse.root.attach(self.PFuse)
            self.modelFuseS = BigWorld.Model('')
            self.addModel(self.modelFuseS)
            self.modelFuseS.position = self.position
            playSound(self.SOUND_FIRELINE, self.modelFuseS)
        else:
            self.modelFuse.root.detach(self.PFuse)
            if self.modelFuseS:
                self.delModel(self.modelFuseS)
                self.modelFuseS = None
            if self.fireWorksType == FireWorksType.SALUTE:
                if self.model:
                    self.model.visible = False
        return

    def onLeaveWorld(self):
        self._delHelpsModels()
        self.model = None
        self.modelFuseS = None
        self.modelFuse = None
        self.PFuse = None
        self.flyModel = None
        self.explodeModel = None
        self.FWtrain = None
        self.PSparkle = None
        if self.sparkler_sound:
            try:
                self.sparkler_sound.stop()
            except Exception as e:
                print e

        self.sparkler_sound = None
        return

    def startSparkle(self):

        def on_load(prereqs):
            if self.isDestroyed:
                return
            self.PSparkle = prereqs.produce(0)
            BigWorld.callback(0.5, self._startSparkle)

        ResourceLoader.asyncLoad([(ResourceLoader.PARTICLE, PARTICLE_FIREWORKS_NG_PATH)], on_load)

    def _startSparkle(self):
        if self.isDestroyed:
            return
        modelSpark = BigWorld.Model('')
        self.addModel(modelSpark)
        modelSpark.position = self.position + (0, 0.1, 0)
        modelSpark.root.attach(self.PSparkle)
        self.sparkler_sound = playSound(self.SOUND_SPARKLE, self.model)

    def explodeFireWorks(self):
        explode_sfx = 'sfx/weapons/grenades/explosion_fake.xml'
        FX.bufferedOneShotEffect(explode_sfx, self.model)

    def startFire(self, endPos, isColision):

        def on_load(prereqs):
            if self.isDestroyed:
                return
            self.FWtrain = prereqs.produce(0)
            self.endPos = endPos
            self.isColision = isColision
            self.flyModel = BigWorld.Model('')
            self.explodeModel = BigWorld.Model('')
            self.addModel(self.flyModel)
            self.addModel(self.explodeModel)
            self.explodeModel.position = self.endPos
            self.flyModel.position = self.position
            self.flyModel.root.attach(self.FWtrain)
            self.onFly()
            playSound(self.SOUND_ROCKETSTART, self.model)

        ResourceLoader.asyncLoad([(ResourceLoader.PARTICLE, PARTICLE_FIREWORKS_SPARKS_PATH)], on_load)

    def onFly(self):
        if self.isDestroyed:
            return
        if self.flyModel.position[1] >= self.endPos[1]:
            self.flyEnd()
            return
        dH = self.fwspeed * 0.02
        self.flyModel.position = self.flyModel.position + (0, dH, 0)
        self.flyid = BigWorld.callback(0.02, self.onFly)

    def flyEnd(self):
        try:
            self.FWtrain.system(0).actions[0].sleepPeriod = 2.0
        except:
            traceback.print_exc()

        def delModel():
            if self.isDestroyed:
                return
            if not self.flyModel:
                return
            self.delModel(self.flyModel)

        BigWorld.callback(2.0, delModel)
        if self.isColision:
            self.explodeModel.position = self.explodeModel.position - (0, 0.5, 0)
            BigWorld.callback(0.01, self.explode)
            return
        BigWorld.callback(0.6, self.explode)

    def explode(self):
        if self.isDestroyed:
            return
        if self.isColision:
            explode_sfx = 'sfx/weapons/grenades/explosion_fake.xml'
            FX.bufferedOneShotEffect(explode_sfx, self.explodeModel)
            return
        lasttime = 0.0
        for i in xrange(self.number):
            lasttime += random.randrange(0.1, 0.6, int=float)
            BigWorld.callback(lasttime, self.randomExpl)

    def randomExpl(self):
        if self.isDestroyed:
            return
        mexpl = BigWorld.Model('')
        self.addModel(mexpl)
        r = self.radius
        if r > 0:
            r3 = (random.randrange(-r, r, int=float), random.randrange(-r / 2, r / 2, int=float), random.randrange(-r, r, int=float))
        else:
            r3 = (0, 0, 0)
        mexpl.position = self.explodeModel.position + r3
        names = '\n\t\t\t\tfx_expanding_sprite02\n\t\t\t\tfw_green_white_burst\n\t\t\t\tfw_purple_burst\n\t\t\t\tfw_red_green_burst\n\t\t\t\tfw_red_yellow_burst\n\t\t\t\tfw_white_jitter_burst\n\t\t\t\tfw_white_sparse_burst'.split()

        def on_load(prereqs):
            if self.isDestroyed:
                return
            part = prereqs.produce(0)
            mexpl.root.attach(part)
            BigWorld.callback(0.3, partial(self._soundPlay, mexpl))

        ResourceLoader.asyncLoad([(ResourceLoader.PARTICLE, 'particles/%s.xml' % random.choice(names))], on_load)

    def _soundPlay(self, model):
        if self.isDestroyed:
            return
        playSound(self.SOUND_BOOMS, model)
        model.scale = (5, 5, 5)

        def scaleOff():
            if self.isDestroyed:
                return
            self._scaleOff(model)

        def _delExpl():
            if self.isDestroyed:
                return
            self.delExpl(model)

        BigWorld.callback(0.5, scaleOff)
        BigWorld.callback(4.0, _delExpl)

    def _scaleOff(self, model):
        if self.isDestroyed:
            return
        model.scale = (0.1, 10, 0.1)

    def delExpl(self, model):
        self.delModel(model)

    def _delHelpsModels(self):
        try:
            self.delModel(self.flyModel)
        except Exception:
            pass

        try:
            self.delModel(self.explodeModel)
        except Exception:
            pass

        if self.modelFuseS:
            try:
                self.delModel(self.modelFuseS)
            except Exception:
                pass