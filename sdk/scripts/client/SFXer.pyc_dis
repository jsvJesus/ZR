    pass


def tri_normal(triangle):
    tri_normal = (triangle[2] - triangle[0]) * (triangle[2] - triangle[1])
    tri_normal.normalise()
    return tri_normal


def Explode(player, shoot_source, shoot_target, shoot_normal, target_triangle, material):
    explosion_model = BigWorld.Model('')
    player.addModel(explosion_model)
    target_normal = tri_normal(target_triangle)
    near_shoot_target = shoot_target + target_normal * 0.1
    v = shoot_normal * Vector3(0, 1, 0)
    explosion_model.alignTriangle(near_shoot_target, near_shoot_target + v * 0.05, near_shoot_target + shoot_normal * v * 0.05, False)
    FX.bufferedOneShotEffect('sfx/weapons/grenades/explosion_fake.xml', explosion_model, DecalInfo=[shoot_target - (0, 1, 0), shoot_target + (0, 1, 0)])
    BigWorld.callback(3.3, _del_model(player, explosion_model))


def footWaterStep(player, position, sfx_path, alignToVector = None, lifeTime = 3.3):
    explosion_model = BigWorld.Model('')
    explosion_model.position = position
    player.addModel(explosion_model)
    if alignToVector:
        pass
    FX.bufferedOneShotEffect(sfx_path, explosion_model)
    BigWorld.callback(lifeTime, _del_model(player, explosion_model))


def waterHit(player, position, sfx_path, alignToVector = None, lifeTime = 3.3):
    if player.isDestroyed:
        return
    hiden_model = BigWorld.Model('characters/items/weapons/sphere_water_spl.model')
    explosion_model = BigWorld.Model('')
    explosion_model.position = position
    hiden_model.position = position + Math.Vector3(0, 1, 0)
    player.addModel(explosion_model)
    player.addModel(hiden_model)
    if alignToVector:
        pass

    def dwn():
        hiden_model.position = position + Math.Vector3(0, -1, 0)

    FX.bufferedOneShotEffect(sfx_path, explosion_model)
    BigWorld.callback(0.1, dwn)
    BigWorld.callback(lifeTime, _del_model(player, explosion_model))
    BigWorld.callback(lifeTime, _del_model(player, hiden_model))


class _del_model:

    def __init__(self, player, model):
        self._player = player
        self._model = model

    def __call__(self):
        if not self._player.isDestroyed:
            try:
                self._player.delModel(self._model)
            except:
                traceback.print_exc()
                print self._player, self._model, '\n'

        self._player = None
        self._model = None
        return


def _calc_matrix(target_normal, point):
    m = Matrix()
    m.setRotateYPR(Vector3(target_normal.yaw, target_normal.pitch + math.pi * 0.5, 0))
    m_translation = Matrix()
    m_translation.setTranslate(point)
    m.postMultiply(m_translation)
    return m


def Pierce(player, sfx_name, target_triangle, point):
    if player.isDestroyed:
        return
    pierce_model = BigWorld.Model('')
    player.addModel(pierce_model)
    target_normal = tri_normal(target_triangle)
    m = _calc_matrix(target_normal, point)
    pierce_model.setWorldTransform(m)
    FX.bufferedOneShotEffect(sfx_name, pierce_model, DecalInfo=[point + target_normal, point - target_normal], forceDecal=True)
    BigWorld.callback(2.0, _del_model(player, pierce_model))


def Reflect(player, shoot_target, target_triangle, sfx_name):
    if player.isDestroyed:
        return
    ricochet_model = BigWorld.Model('')
    ricochet_model.position = shoot_target
    player.addModel(ricochet_model)
    target_normal = tri_normal(target_triangle)
    m = _calc_matrix(target_normal, shoot_target)
    ricochet_model.setWorldTransform(m)
    FX.bufferedOneShotEffect(sfx_name, ricochet_model, DecalInfo=[shoot_target + target_normal, shoot_target - target_normal], forceDecal=True)
    BigWorld.callback(2.0, _del_model(player, ricochet_model))


def Ricochet(player, shoot_source, shoot_target, target_triangle, material, ammo_type = None):
    """ Ricochet - \xd0\xbd\xd0\xb0\xd0\xb7\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb8\xd1\x81\xd1\x82\xd0\xbe\xd1\x80\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd0\xba\xd0\xbe\xd0\xb5, \xd0\xbf\xd0\xbe \xd1\x81\xd1\x83\xd1\x82\xd0\xb8 \xd1\x8d\xd1\x82\xd0\xbe \xd0\xbe\xd0\xb1\xd1\x8b\xd1\x87\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbf\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f
            \xd0\xb8 \xd0\xba \xd1\x80\xd0\xb8\xd0\xba\xd0\xbe\xd1\x88\xd0\xb5\xd1\x82\xd1\x83 \xd0\xbe\xd1\x82\xd0\xbd\xd0\xbe\xd1\x88\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbd\xd0\xb5 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xb5\xd1\x82, \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd0\xbe\xd1\x8f\xd1\x89\xd0\xb8\xd0\xb5 \xd1\x80\xd0\xb8\xd0\xba\xd0\xbe\xd1\x88\xd0\xb5\xd1\x82\xd1\x8b - \xd1\x8d\xd1\x82\xd0\xbe \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 Reflect
    """
    if player.isDestroyed:
        return
    ricochet_model = BigWorld.Model('')
    ricochet_model.position = shoot_target
    player.addModel(ricochet_model)
    target_normal = tri_normal(target_triangle)
    m = _calc_matrix(target_normal, shoot_target)
    ricochet_model.setWorldTransform(m)
    sfx_category = ammo_type and ItemsCatalog.GetItemParam(ammo_type).get('HitSfxCategory') or 'Default'
    catalog = SFX_HIT_CATALOG[sfx_category]
    sfx_hit_name = catalog.get(material) or catalog.get('default')
    FX.bufferedOneShotEffect(sfx_hit_name, ricochet_model, DecalInfo=[shoot_target + target_normal, shoot_target - target_normal], forceDecal=True)
    BigWorld.callback(2.0, _del_model(player, ricochet_model))


def BloodBodyHit(entity, hitPos, blood_orientation, sfx_path):
    if entity.isDestroyed:
        return
    if not sfx_path:
        return
    hit_model = BigWorld.Model('')
    up = (0, 1, 0)
    if blood_orientation[1] > 0.9:
        up = (1, 0, 0)
    cached_matrix.lookAt(hitPos, blood_orientation, up)
    try:
        cached_matrix.invert()
    except:
        print '[ERROR] BloodBodyHit. Failed invert', cached_matrix.desc
        traceback.print_stack()
        return

    hit_model.setWorldTransform(cached_matrix)
    entity.addModel(hit_model)
    FX.bufferedOneShotEffect(sfx_path, hit_model, DecalInfo=[hitPos, hitPos + blood_orientation * 2])

    def deleteModel():
        if entity.isDestroyed:
            return
        entity.delModel(hit_model)

    BigWorld.callback(2.0, deleteModel)


def BodyHit(hitPos, entity, shoot_normal, reflection, sfx_path):
    if entity.isDestroyed:
        return
    if not sfx_path:
        return
    hit_model = BigWorld.Model('')
    entity.addModel(hit_model)
    target_triangle = []
    triangle = getTriangleByZ(reflection)
    for AnglesNum in xrange(len(triangle)):
        target_triangle.append(triangle[AnglesNum] + hitPos)

    hit_model.alignTriangle(target_triangle[0], target_triangle[1], target_triangle[2], False)
    back_normal = Vector3(shoot_normal)
    back_normal.normalise()
    hit_height = hitPos[1] - entity.position.y
    hit_height -= random.random()
    height_shift_vector = Vector3(0, max(0, hit_height), 0)
    back_normal -= height_shift_vector
    back_normal = back_normal * 5
    if not hit_model.position:
        print 'BodyHit  not not hit_model.position!!!'
        print 'position:', hit_model.position
        print 'hitPos:', hitPos
        print 'entity:', entity, entity.position
        print 'shoot_normal:', shoot_normal
        print 'sfx_path:', sfx_path
        print 'back_normal:', back_normal
        print 'triangle:', triangle
        print 'target_triangle:', target_triangle
        print
        traceback.print_stack()
        print
        print
        hit_model.position = hitPos
    FX.bufferedOneShotEffect(sfx_path, hit_model, DecalInfo=[hitPos, hitPos + back_normal])

    def deleteModel():
        if entity.isDestroyed:
            return
        entity.delModel(hit_model)

    BigWorld.callback(2.0, deleteModel)


