def AddPixieToEntity(entity, particle_name, node = None, callBackFn = None):

    def onLoadLensFlare(prereqs):
        if entity.isDestroyed:
            return
        ps = prereqs.produce(0)
        node.attach(ps)
        ps.force()
        if callBackFn:
            callBackFn(ps)

    if node == None:
        node = entity.model.root
    ResourceLoader.asyncLoad([(ResourceLoader.PARTICLE, particle_name)], onLoadLensFlare)
    return


def playSFX(sfx_path, position, direction = None, delay = 0.0, timeLife = 10.0):
    explosion_model = BigWorld.Model('')
    explosion_model.position = position
    player = BigWorld.player()
    player.addModel(explosion_model)
    if not direction:
        direction = Math.Vector3(0, -1, 0)

    def play():
        FX.bufferedOneShotEffect(sfx_path, explosion_model, DecalInfo=[position - direction, position + direction], forceDecal=True)
        BigWorld.callback(timeLife, _del_model(player, explosion_model))

    BigWorld.callback(delay, play)


def play_sfx_by_matrix(sfx_path, matrix, delay = 0.0, timeLife = 10.0):
    explosion_model = BigWorld.Model('')
    explosion_model.setWorldTransform(matrix)
    player = BigWorld.player()
    player.addModel(explosion_model)

    def play():
        direction = matrix.applyToAxis(1) * 0.2
        position = matrix.translation
        FX.bufferedOneShotEffect(sfx_path, explosion_model, DecalInfo=[position - direction, position + direction], forceDecal=True)
        BigWorld.callback(timeLife, _del_model(player, explosion_model))

    BigWorld.callback(delay, play)


class _CameraSide:
    NORMAL = 0
    LEFT_TO_RIGHT = 1
    RIGHT_TO_LEFT = 2


_pool_empty_models = [ BigWorld.Model('') for i in xrange(50) ]

def bulletsPassby(lst):
    for position, camera_side in lst:
        if camera_side == _CameraSide.NORMAL:
            sound_path = 'guns/passby/passby'
        elif camera_side == _CameraSide.LEFT_TO_RIGHT:
            sound_path = 'guns/passby/passby_lr'
        elif camera_side == _CameraSide.RIGHT_TO_LEFT:
            sound_path = 'guns/passby/passby_rl'
        _playBulletPassby(position, sound_path)


def _playBulletPassby(position, sound_path):
    if not _pool_empty_models:
        return
    m = _pool_empty_models.pop()
    m.position = position
    BigWorld.addModel(m)
    sounds.playSound(sound_path, model=m)

    def delmodel():
        BigWorld.delModel(m)
        _pool_empty_models.append(m)

    BigWorld.callback(3, delmodel)