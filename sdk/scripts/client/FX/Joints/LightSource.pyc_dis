# Embedded file name: ./client/FX/Joints/LightSource.py
from FX import s_sectionProcessors
from FX import typeCheck
from FX.Joint import Joint
from bwdebug import *
import BigWorld
from Math import Matrix, MatrixProduct
import functools

class LightSource(Joint):
    """
    This class implements a Joint that attaches a light to a PyModelNode.
    
    The actor must be a PyChunkLight.
    """

    def load(self, pSection, prereqs = None):
        """
        This method loads the LightSource Joint from a data section.  The node
        name is read from the section name.
        """
        self._offset = None
        self.nodeName = pSection.asString
        offsetPosition = pSection['offsetPosition']
        if offsetPosition is not None:
            self._offset = offsetPosition.asVector3
        return self

    def attach(self, actor, source, target = None):
        if source == None:
            return
        else:
            node = None
            if self.nodeName:
                try:
                    node = source.node(self.nodeName)
                except TypeError:
                    ERROR_MSG('Type error - probably a blank model', self.nodeName)
                except ValueError:
                    ERROR_MSG('No such node', self.nodeName)

            if not node:
                node = source.root
                try:
                    if self._offset:
                        matr = MatrixProduct()
                        m_add = Matrix()
                        m_add.setTranslate(self._offset)
                        matr.a = source.matrix
                        matr.b = m_add
                        actor.source = matr
                    else:
                        actor.source = source.matrix
                    actor.visible = True
                except:
                    ERROR_MSG('error in set light source', self, actor, source)

                return
            self._apply_light(5, node, actor, source)
            return

    def _apply_light(self, attempts, node, actor, source):
        self._apply_light_callback_id = None
        try:
            if node.isActualCoords:
                actor.source = node
                actor.visible = True
                return
            if attempts <= 0:
                actor.position = source.position
            else:
                self._apply_light_callback_id = BigWorld.callback(0, functools.partial(self._apply_light, attempts - 1, node, actor, source))
        except:
            ERROR_MSG('error in set light source', self, actor, source)

        return

    _apply_light_callback_id = None

    def detach(self, actor, source, target = None):
        actor.visible = False
        actor.source = None
        if self._apply_light_callback_id:
            BigWorld.cancelCallback(self._apply_light_callback_id)
            self._apply_light_callback_id = None
        return


s_sectionProcessors['LightSource'] = LightSource