# Embedded file name: ./client/FX/Joints/Node.py
from FX import s_sectionProcessors
from FX.Joint import Joint
from bwdebug import *
import traceback
from Math import Matrix

class Node(Joint):
    """
    This class implements a Joint that attaches an actor to a node.
    
    The actor may be any PyAttachment, for example a model or a
    particle system.
    """
    _last_at_model = None

    def load(self, pSection, prereqs = None):
        """
        This method loads the Joint from a data section.  The node
        name is read from the section name.
        """
        self.nodeName = pSection.asString
        rotation = pSection['rotation']
        self._rotation = None if rotation is None else rotation.asVector3
        offset = pSection['offset']
        self._offset = None if offset is None else offset.asVector3
        return self

    def attach(self, actor, source, target = None):
        if source is None:
            return 0
        else:
            parent_model = source
            if hasattr(source, 'model'):
                parent_model = source.model
            if getattr(actor, 'attached', False):
                ERROR_MSG('actor is already attached!', actor, self.nodeName, self, source, target)
                return 0
            try:
                if self.nodeName == 'root':
                    parent_model.root.attach(actor)
                elif self._rotation is None and self._offset is None:
                    parent_model.node(self.nodeName).attach(actor)
                else:
                    m_res = Matrix()
                    if self._rotation is not None:
                        m_res.setRotateYPR(self._rotation)
                    if self._offset is not None:
                        m_res.translation = self._offset
                    self._node = parent_model.node(self.nodeName, m_res)
                    self._node.attach(actor)
            except (AttributeError, ValueError):
                print '/----attach'
                print 'actor:', actor
                print 'source:', source
                print 'parent_model:', parent_model
                print 'parent_model.sources:', getattr(parent_model, 'sources', 'no attr')
                ERROR_MSG('No such node', self.nodeName, self.fileName)
                traceback.print_exc()
                print '----/'

            return

    def detach(self, actor, source, target = None):
        self._do_detach(actor, source, target)
        self._last_at_model = None
        return

    def _do_detach(self, actor, source, target = None):
        if source is None:
            return
        elif not actor.attached:
            ERROR_MSG('actor is not attached!', actor, self.nodeName, self, source, target, self.fileName)
            return 0
        else:
            parent_model = source
            if hasattr(source, 'model'):
                parent_model = source.model
            try:
                if self.nodeName == 'root':
                    parent_model.root.detach(actor)
                else:
                    _node = getattr(self, '_node', None)
                    if _node is None:
                        parent_model.node(self.nodeName).detach(actor)
                    else:
                        _node.detach(actor)
                        self._node = None
            except (ValueError, AttributeError):
                print '('
                traceback.print_stack()
                print ')'
                ERROR_MSG('No such node', actor, self.nodeName, self, source, target, self.fileName)
                traceback.print_exc()
                print '\n\n'

            return


s_sectionProcessors['Node'] = Node