    \xd0\x9f\xd0\xbe\xd0\xb7\xd0\xb2\xd0\xbe\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbe\xd0\xb4\xd0\xbd\xd1\x83 \xd0\xb8\xd0\xb7 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0 \xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xbe\xd1\x81\xd1\x82\xd0\xb5\xd0\xb9.
    \xd0\x95\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb8 \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xb8\xd0\xb7 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0, sfx \xd0\xbd\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f.
    """

    def load(self, pSection, prereqs = None):
        self.nodeName = None
        self.nodeList = pSection.readStrings('Node')
        return self

    def attach(self, actor, source, target = None):
        if source is None:
            return 0
        elif getattr(actor, 'attached', False):
            ERROR_MSG('actor is already attached!', actor, self.nodeName, self, source, target)
            return 0
        else:
            parent_model = source
            if hasattr(source, 'model'):
                parent_model = source.model
            for nodeName in self.nodeList:
                try:
                    parent_model.node(nodeName).attach(actor)
                except (AttributeError, ValueError):
                    pass
                else:
                    self.nodeName = nodeName
                    print_debug("attach to node: '%s'" % self.nodeName, self.fileName, self.nodeList, self, actor, source, target)
                    return

            model_sources = None
            try:
                model_sources = parent_model.sources
            except:
                pass

            print_debug('No such nodes', self.nodeList, self.fileName, self, '\n actor={0}'.format(actor), '\n parent_model={0}'.format(parent_model), '\n model_sources={0}'.format(model_sources), '\n source={0}'.format(source), '\n target={0}\n'.format(target))
            return

    def detach(self, actor, source, target = None):
        self._do_detach(actor, source, target)

    def _do_detach(self, actor, source, target = None):
        if source is None:
            return
        elif self.nodeName is None:
            return
        elif not actor.attached:
            print_debug('actor is not attached!', actor, self.nodeName, self, source, target, self.fileName)
            return
        else:
            parent_model = source
            if hasattr(source, 'model'):
                parent_model = source.model
            try:
                if self.nodeName == 'root':
                    parent_model.root.detach(actor)
                else:
                    parent_model.node(self.nodeName).detach(actor)
            except (ValueError, AttributeError):
                print '('
                traceback.print_stack()
                print ')'
                ERROR_MSG('No such node', actor, self.nodeName, self, source, target, self.fileName)
                traceback.print_exc()
                print '\n\n'

            return


