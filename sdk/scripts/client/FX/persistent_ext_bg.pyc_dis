import FX
import BigWorld
import ResourceLoader
from Effects.PersistentExt import PersistentExt
from Effects._Effect import prerequisites

def loadPersistentExtAsync(sfx_paths, on_load_callback):
    """
    \xd0\xb0\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb5\xd1\x80\xd0\xbd\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xb0\xd1\x8f \xd0\xb7\xd0\xb0\xd0\xb3\xd1\x80\xd1\x83\xd0\xb7\xd0\xba\xd0\xb0 \xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 ResourceLoader.asyncLoad
    """
    resource_list = tuple(((ResourceLoader.SFX, sfx_path) for sfx_path in sfx_paths))
    ResourceLoader.asyncLoad(resource_list, on_load_callback)


def loadPersistentExtBG(sfx_path, onLoadCallback, presq = None, store_sounds = None):

    def loadStep1(resourceRefs):
        resourse_list = prerequisites(sfx_path, resourceRefs)
        resourse_list = filter(lambda x: x, resourse_list)
        BigWorld.loadResourceListBG(resourse_list, loadStep2)

    def loadStep2(resourceRefs2):
        fx_obj = PersistentExt(sfx_path, resourceRefs2, store_sounds=store_sounds)
        onLoadCallback(fx_obj)

    loaded_datasect_sfx = False
    if presq:
        try:
            presq[sfx_path]
            loaded_datasect_sfx = True
        except KeyError:
            pass

    if loaded_datasect_sfx:
        loadStep1(presq)
    else:
        BigWorld.loadResourceListBG((sfx_path,), loadStep1)


class PersistentWrapper:
    """ wpapper \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xb8\xd0\xbd\xd1\x85\xd1\x80\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb9 \xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd1\x8b persistent \xd1\x87\xd0\xb0\xd1\x81\xd1\x82\xd0\xb8\xd1\x86 """

    def __init__(self, sfx_path, model):
        raise model and sfx_path or AssertionError
        self._sfx_path = sfx_path
        self._sfx = None
        self._run = False
        self._model = model
        loadPersistentExtAsync([sfx_path], self._on_loaded)
        return

    def _on_loaded(self, prereqs):
        if not self._model:
            return
        self._sfx = FX.PersistentExt(self._sfx_path, prereqs)
        self._sfx.attach(self._model)
        if self._run:
            self._sfx.go()

    def run(self):
        if self._run:
            return
        self._run = True
        if self._sfx:
            self._sfx.go()

    def stop(self):
        if not self._run:
            return
        self._run = False
        if self._sfx:
            self._sfx.stop()

    def release(self):
        self.stop()
        if self._sfx:
            self._sfx.detach()
        self._sfx = None
        self._model = None
        return