# Embedded file name: ./client/FX/Events/SpawnParticleActivePeriod.py
from FX.Event import Event
from FX.Event import TRANSFORM_DEPENDENT_EVENT
from FX import s_sectionProcessors
import traceback
from bwdebug import ERROR_MSG

class SpawnParticleActivePeriod(Event):

    def __call__(self):
        return self

    def getDuration(self, ps):
        max_period = 0.001
        for sys_id in xrange(ps.nSystems()):
            system = ps.system(sys_id)
            for action in system.actions:
                period = getattr(action, 'activePeriod', 0)
                max_period = max(period, max_period)

        return max_period + ps.duration() + 0.001

    def go(self, sfx, actor, source, target, **kargs):
        try:
            actor.clear()
            return self.getDuration(actor)
        except:
            ERROR_MSG('actor is not a particle system! \nactor=', actor, '\nsfx=', sfx, '\nsfx.fileName=', getattr(sfx, 'fileName'))
            traceback.print_exc()
            return 0.0

    def duration(self, actor, source, target):
        return self.getDuration(actor)

    def eventTiming(self):
        return TRANSFORM_DEPENDENT_EVENT


s_spawmParticle = SpawnParticleActivePeriod()
s_sectionProcessors['SpawnParticleActivePeriod'] = s_spawmParticle