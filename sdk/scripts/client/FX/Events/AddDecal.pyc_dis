# Embedded file name: ./client/FX/Events/AddDecal.py
from FX.Event import Event
from FX.Event import TRANSFORM_DEPENDENT_EVENT
from FX import s_sectionProcessors
from Math import Vector3, Vector4
from bwdebug import *
import BigWorld
import traceback

class AddDecal(Event):
    """
    This class implements the AddDecal event,  It adds a decal to the world.
    """

    def __init__(self):
        self.decalIndex = -1
        self.decalSize = 0.0
        self.decalExtent = (0, 0, 0)
        self.decalDist = 0
        self.specularColor = (0, 0, 0)
        self.specularPower = 0
        self.reflectionAmmount = 0
        self.fresnelConst = 0
        self.fresnelFalloff = 1

    def load(self, pSection, prereqs = None):
        """
        This method loads the AddDecal event from a data section.
        It reads decalIndex, decalSize and decalExtent from the data section.
        """
        try:
            self.decalIndex = BigWorld.decalTextureIndex(pSection.asString)
        except:
            return

        if self.decalIndex != -1:
            self.decalSize = pSection.readFloat('size', 1)
            self.decalExtent = pSection.readVector3('extent', (0, -1, 0))
            self.decalDist = pSection.readFloat('maxDist', 0)
            self.specularColor = Vector3([ min(c / 255.0, 1) for c in pSection.readVector3('specularColor', (0, 0, 0)) ])
            self.specularPower = pSection.readFloat('specularPower', 0)
            self.reflectionAmmount = pSection.readFloat('reflectionAmmount', 0)
            self.fresnelConst = pSection.readFloat('fresnelConst', 0)
            self.fresnelFalloff = pSection.readFloat('fresnelFalloff', 1)
        else:
            WARNING_MSG('AddDecal had no associated tag')
        return self

    def go(self, effect, actor, source, target, **kargs):
        """
        This method initiates the AddDecal event.  From the variable arguments
        dictionary, it reads an "DecalInfo", which is a tuple of (start point,
        end point).
        This tuple specifies a collision ray for choosing where the decal
        should appear.
        """
        if self.decalIndex == -1:
            return 0.01
        elif source == None:
            return 0.01
        else:
            try:
                start = kargs['DecalInfo'][0]
                end = kargs['DecalInfo'][1]
                forceDecal = kargs.get('forceDecal', False)
                if not forceDecal:
                    if not self.decalDist:
                        return 0.01
                    normal = end - start
                    normal.normalise()
                    end = start + normal * self.decalDist
            except KeyError:
                start = Vector3(source.position)
                for i in xrange(0, 3):
                    start[i] -= self.decalExtent[i] * 0.5

                end = start + self.decalExtent

            if not start or not end:
                traceback.print_stack()
                print 'fileName:', repr(self.fileName)
                print 'incorect position', [end, start]
                print self, actor, source, target
                print 'kargs:', kargs
                print
                return 0.01
            try:
                specInfo = Vector4(self.specularColor.x, self.specularColor.y, self.specularColor.z, self.specularPower)
                decalInfo = (specInfo,
                 self.reflectionAmmount,
                 self.fresnelConst,
                 self.fresnelFalloff)
                BigWorld.addDecal(start, end, self.decalSize, self.decalIndex, decalInfo)
            except:
                ERROR_MSG('Could not add decal')

            return 0.01

    def eventTiming(self):
        return TRANSFORM_DEPENDENT_EVENT


s_sectionProcessors['AddDecal'] = AddDecal