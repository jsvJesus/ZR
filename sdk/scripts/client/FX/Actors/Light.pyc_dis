# Embedded file name: ./client/FX/Actors/Light.py
import BigWorld
from bwdebug import *
from FX.Actor import Actor
from FX import s_sectionProcessors

class Light(Actor):
    """
    This class implements an Actor that is a PyChunkLight.
    """

    def load(self, pSection, prereqs = None):
        """
        This method loads a PyChunkLight from a data section. The
        the light reads its innerRadius, outerRadius and colour from the
        data section.
        """
        try:
            actor = BigWorld.PyChunkLight()
            actor.innerRadius = pSection.readFloat('innerRadius', 0)
            actor.outerRadius = pSection.readFloat('outerRadius', 10)
            actor.colour = pSection.readVector4('colour', (255, 255, 255, 255))
            actor.priority = pSection.readInt('priority', 0)
            actor.specular = pSection.readBool('specular', True)
            actor.diffuse = pSection.readBool('diffuse', True)
        except:
            ERROR_MSG('Could not create Light', pSection.asString)
            actor = None

        if actor:
            self.apply_params(pSection, actor)
        return actor

    def apply_params(self, pSection, actor):
        """
        called during synchronous and asynchronous loading
        """
        try:
            multiplier = pSection.readFloat('multiplier', 1)
            if multiplier != 1:
                colour = pSection.readVector4('colour', (255, 255, 255, 255))
                for i in xrange(4):
                    colour[i] *= multiplier

                actor.colour = colour
        except:
            ERROR_MSG('Failed apply_params', pSection.asString)
            actor = None

        return


s_sectionProcessors['Light'] = Light