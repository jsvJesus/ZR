# Embedded file name: ./client/survey_players.py
import BWPersonality
import BigWorld
import UCManager
import json
import Localization
import base64
from utils import force_utf8, force_unicode
SURVEY_URL = 'https://survey.stalker.so'

class SurveyPlayers:

    def __init__(self):
        pass

    def on_clear_surv(self):
        BWPersonality.GUICore.loginFlash.account_actions.hide_survey()

    def on_new_surv(self, title, descr, sec_left):
        BWPersonality.GUICore.loginFlash.account_actions.show_survey(title, descr, sec_left)

    def open_surv(self):
        url = SURVEY_URL + '/' + self._args()
        BWPersonality.GUICore.showWebEmbdeded(True, force_unicode(url))

    def bind_events(self):
        BWPersonality.game.addListener('onPlayerAccount', self.check_surv)

    def _args(self):
        args = '?lang=%s' % force_utf8(Localization.get_lang_short())
        args += '&tok=%s' % self._create_tok()
        return args

    def _create_tok(self):
        auth = BigWorld.auth
        info = auth.getCurrnetServerInfo()
        server_id = info.get('uid')
        if not server_id or not auth.LoginID:
            return
        data = {'LoginID': auth.LoginID,
         'login': auth.login,
         'reg': auth._created,
         'survh': auth._survh,
         'serv': server_id}
        simpletoken = json.dumps(data)
        return base64.urlsafe_b64encode(simpletoken)

    def check_surv(self):
        self.on_clear_surv()
        if BigWorld.player().__class__.__name__ != 'PlayerAccount':
            print 'SURV not acc'
            return
        if not self._create_tok():
            print 'SURV not tok'
            return
        url = SURVEY_URL + '/check' + self._args()
        UCManager.ucmanager.downloadFromUrl(url, self._on_load, verify=False)

    def _on_load(self, rawdata):
        if not rawdata:
            return
        print 'SURV check:', repr(rawdata)
        data = json.loads(rawdata)
        print data
        if data.get('error'):
            print data
            return
        if not data.get('exist'):
            return
        title = data.get('title', '')
        descr = data.get('descr', '')
        sec_left = int(data.get('tleft', 0))
        self.on_new_surv(title, descr, sec_left)


surveys = SurveyPlayers()