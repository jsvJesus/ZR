# Embedded file name: ./client/Subtitles.py
import pyson
import ResMgr
import BigWorld
from Localization import lc
SUB_PATH = 'scripts/client/data/Subtitles.pyson'
SUB_DATA = {}
try:
    section = ResMgr.openSection(SUB_PATH)
    SUB_DATA = pyson.loads(section.asBinary)
except Exception as e:
    print 'ERROR :: Failed read_phrases:', SUB_PATH
    raise e

class Subtitles:

    @staticmethod
    def get_subtitle(sound_name):
        sub_data = SUB_DATA.get(sound_name)
        if not sub_data:
            return (None, 0, 0)
        else:
            duration = sub_data.get('duration', 0)
            text = lc(sub_data.get('text', ''))
            radius = sub_data.get('radius', 45)
            return (text, duration, radius)

    @staticmethod
    def play(sound_player, sound_name, speaker = ''):
        from soGUI.SubsWindow import instance as sub_wind
        text, duration, radius = Subtitles.get_subtitle(sound_name)
        if not text or not duration:
            return
        if BigWorld.player().position.distTo(sound_player.position) > radius:
            return
        subtitles = '{0}: {1}'.format(speaker, text) if speaker else text
        sub_wind.output_subs(subtitles, duration)