    def applyBoxAttack(self, action_id, skill):
        targets = self._getEntitiesBoxAttack(action_id, skill)
        targets = Transformation.applyBoxAttack(self, action_id, skill)
        targets_id = [ e.id for e in targets[:30] ]
        if targets_id:
            self.cell.transformAttack(self.transformationID, action_id, targets_id)
        return targets

    def applySectorAttack(self, action_id, skill, dead_also = False):
        targets = Transformation.applySectorAttack(self, action_id, skill, dead_also=False)
        targets_id = [ e.id for e in targets[:30] ]
        if targets_id:
            self.cell.transformAttack(self.transformationID, action_id, targets_id)
        return targets

    def applyAOEAttack(self, action_id, skill, dead_also = False):
        targets = Transformation.applyAOEAttack(self, action_id, skill, dead_also=False)
        targets_id = [ e.id for e in targets[:30] ]
        if targets_id:
            self.cell.transformAttack(self.transformationID, action_id, targets_id)
        return targets

    def applySelfEffectAttack(self, action_id, skill, dead_also = False):
        targets = Transformation.applySelfEffectAttack(self, action_id, skill, dead_also=False)
        self.cell.transformAttack(self.transformationID, action_id, [self.id])
        return targets

    def applyThrowGrenadeAttack2(self, action_id, skill):
        grenade_type = skill.param.get('grenade_type')
        throw_power = skill.param.get('throw_power', 1)
        self.throwGrenade(isDown=True, throw_power=throw_power, grenade_type=grenade_type)
        self.throwGrenade(isDown=False, throw_power=throw_power, grenade_type=grenade_type)

    def applyThrowGrenadeAttack(self, action_id, skill, dead_also = False):
        targets = Transformation.applyThrowGrenadeAttack(self, action_id, skill, dead_also=False)
        grenade_params = {}
        grenade_type = skill.param.get('grenade_type')
        grenade_velocity = skill.param.get('grenade_velocity')
        if not grenade_type:
            print 'TSKill ERROR not grenade_type', skill, self, self.active_transform
            return
        if not grenade_velocity:
            print 'TSKill ERROR not grenade_velocity', skill, self, self.active_transform
            return
        node_hand = self.model.node('HP_Rhand')

        def callbackOnThrow(param):
            if not param:
                return
            position, velocity, clientGrenadeID, timeBeforeFlyEnd, destPos = param
            self.cell.throwGrenade(position, velocity, clientGrenadeID, grenade_type)

        def continue_throw():
            position = Matrix(node_hand).translation
            velocity = self.getDirection() * grenade_velocity
            self.throw(grenade_params, position, velocity, grenade_type, callbackOnThrow=callbackOnThrow)

        if node_hand.isActualCoords:
            continue_throw()
        else:
            BigWorld.callback(0.01, continue_throw)
        return targets

    def applySummonElf(self, action_id, skill):
        Transformation.applySummonElf(self, action_id, skill)
        self.cell.applySummonElf(action_id)

    def onVictimApplyFTSkill(self, damager, action_id, action_name, skill):
        Transformation.onVictimApplyFTSkill(self, damager, action_id, action_name, skill)
        if skill.param.get('victim_phys_push'):
            self._apply_phys_push(damager, action_id, action_name, skill)

    def _apply_phys_push(self, damager, action_id, action_name, skill):
        victim_phys_push = skill.param.get('victim_phys_push')
        direction = self.position - damager.position
        direction.normalise()
        m = Math.Matrix(self.model.matrix)
        m.invert()
        velocity = m.applyVector(direction)
        velocity *= victim_phys_push
        victim_phys_push_up = skill.param.get('victim_phys_push_up')
        if victim_phys_push_up:
            velocity += (0, victim_phys_push_up, 0)
        self.physics.fall = 0
        self.physics.velocity = velocity
        self.moving_locked = True

        def stop():
            self.physics.velocity = (0, 0, 0)
            self.physics.fall = 1
            self.moving_locked = False
            self.UpdateVelocity()

        def go_fall():
            self.physics.fall = 1

        BigWorld.callback(skill.param.get('victim_phys_push_up_time', 0.2), go_fall)
        BigWorld.callback(skill.param.get('victim_phys_push_time', 0.5), stop)

    def lockMove(self, status):
        self.look_move_status = status

