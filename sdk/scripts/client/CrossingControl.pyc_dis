# Embedded file name: ./client/CrossingControl.py
import BigWorld
import CrossingCommon
import Math
from Helpers.Caps import CAP_INTERACT
import sounds_manager as sounds
from Localization import lc

class CrossingControl(BigWorld.Entity):
    DISABLE_MARK = False

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.targetCaps = [CAP_INTERACT]
        self._next_interaction_time = 0
        self._interactor_id = 0
        self._sound = None
        return

    @property
    def model_path(self):
        return CrossingCommon.CROSSING_TURNER_MODELS[self.modelSelect]

    def get_mark_name(self):
        return lc('CrossingControl.MARK_NAME')

    def prerequisites(self):
        return [self.model_path]

    def onEnterWorld(self, prereqs):
        self.model = prereqs[self.model_path]

    def onLeaveWorld(self):
        self.model = None
        if self._sound:
            self._sound.releaseSound()
            self._sound = None
        return

    def interact(self, interactor):
        if BigWorld.time() >= self._next_interaction_time:
            self._next_interaction_time = BigWorld.time() + 1.0
            interactor.startInteract(self)

    @property
    def hoist_positon(self):
        x, y, z = self.position
        return Math.Vector4(x, y, z, self.yaw)

    def onStartInteract(self, avatar_id):
        if self._interactor_id and avatar_id != self._interactor_id:
            avatar = BigWorld.entity(self._interactor_id)
            if avatar and not avatar.isDestroyed:
                avatar.stopInteractByEntity(self)
        self._interactor_id = avatar_id

    def onStopInteract(self, avatar_id):
        self._interactor_id = 0

    def on_group_action_state_change(self, group_action):
        need_play = group_action.state == group_action.RUN_STATE
        if need_play and not self._sound:
            self._sound = sounds.getSound('transport/trolley/rotation', model=self.model)
        if self._sound:
            if need_play:
                self._sound.play()
            else:
                self._sound.stop()