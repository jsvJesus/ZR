# Embedded file name: ./client/DialogHideArea.py
import BigWorld

class DialogHideArea(BigWorld.Entity):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.trapped = []
        self.trap = None
        return

    def activate(self):
        if self.trap:
            self.delTrap(self.trap)
        self.trap = self.addTrap(self.radius, self.onTrap)

    def deactivate(self):
        if self.trap:
            self.delTrap(self.trap)
        for ent_id in self.trapped:
            entity = BigWorld.entities.get(ent_id)
            if entity:
                entity.model.visible = True

        self.trapped = []

    def onTrap(self, entitiesInTrap):
        for ent_id in self.trapped:
            entity = BigWorld.entities.get(ent_id)
            if entity:
                entity.model.visible = True

        self.trapped = []
        for entity in entitiesInTrap:
            if entity.__class__.__name__ == 'Avatar':
                self.trapped.append(entity.id)
                entity.model.visible = False

    def onLeaveWorld(self):
        self.deactivate()

    def onEnterWorld(self, prereqs):
        pass