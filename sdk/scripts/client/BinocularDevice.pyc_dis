# Embedded file name: ./client/BinocularDevice.py
import BigWorld
from Items import ItemsCatalog
from math_bw import clamp
import binoculars_settings

class BinocularDevice(object):

    def __init__(self, item_type):
        self.item_type = item_type
        self._zoom_id = 0
        self.night_vision = False

    def setScroll(self, z_shift):
        if z_shift > 0:
            self._zoom_id += 1
        if z_shift < 0:
            self._zoom_id -= 1
        zoom_list = self.getSettings()['zoom']
        self._zoom_id = clamp(self._zoom_id, 0, len(zoom_list) - 1)

    def getSettings(self):
        key = ItemsCatalog[self.item_type]['BinocularSettings']
        return binoculars_settings.all_binoculars[key]

    def getCurrentZoom(self):
        zoom_list = self.getSettings()['zoom']
        return zoom_list[self._zoom_id]

    def getNightVision(self):
        if not self.getSettings().get('nightvision_enable'):
            self.night_vision = False
        return self.night_vision

    def switchNightVision(self):
        if self.getSettings().get('nightvision_enable'):
            self.night_vision = not self.night_vision
        else:
            self.night_vision = False