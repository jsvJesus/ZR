# Embedded file name: ./client/KnowledgeUser.py
import MapNotes
import BWPersonality
from knowledge import knowledge_parser as kp
from ChatChannelConfig import CHANNEL_CONSTS
from Localization import lc
import AdditionalNPCParameters as AP
import rep_utils
from NPCs import NPCs
NpcEventType = kp.NpcEventType

class KnowledgeUser:

    def __init__(self):
        self._controller_id = 0
        self._knowledge_requesters = {}

    def on_knowledge_npc_event0(self, event_type, npc_id):
        BWPersonality.GUICore.on_knowledge_npc_event1(event_type, npc_id)
        if event_type == NpcEventType.NpcGotCoords:
            self.marks_data.new_npc_visited(npc_id)
        elif event_type == NpcEventType.KnowledgeWiped:
            self.marks_data.wipe_npcs_and_ctriggers()

    def on_ctrigger_gotknowledge0(self, space_name, ctrigger_index):
        self.marks_data.new_ctrigger_visited(space_name, ctrigger_index)

    def request_knowledge_from_ctrigger0(self, ctrigger_id):
        index = MapNotes.get_ctrigger_data(ctrigger_id)['index']
        space_name = BWPersonality.game.get_space_name_advanced(self.spaceID)
        self.base.request_knowledge_from_ctrigger1(space_name, index)

    def notify_knowledge0(self, knowledge_ids, listener):
        self._controller_id += 1
        self._knowledge_requesters[self._controller_id] = listener
        self.base.notify_knowledge1(self._controller_id, knowledge_ids)

    def notify_knowledge2(self, controller_id, result):
        requester = self._knowledge_requesters[controller_id]
        del self._knowledge_requesters[controller_id]
        requester(result)

    def on_got_knowledge(self, know_id):
        text = None
        npc_id = kp.get_npcid_from_knowledge(know_id)
        if npc_id:
            local_key = None
            if kp.is_acquaintance(know_id):
                local_key = 'KnowledgeUser.gotknowledge.npc.acquaintance'
            elif kp.is_coords(know_id):
                local_key = 'KnowledgeUser.gotknowledge.npc.coords'
            elif not kp.is_root(know_id):
                local_key = 'KnowledgeUser.gotknowledge.npc.additional'
            if local_key:
                npc_name = AP.get_npc_name_by_id(npc_id)
                local_name = lc(NPCs.names_by_npcName[npc_name])
                text = u'({0}): {1}'.format(local_name, lc(local_key))
        group_id = kp.get_groupid_from_knowledge(know_id)
        if group_id:
            if not rep_utils.is_group_hidden(group_id):
                local_key = None
                if kp.is_acquaintance(know_id):
                    local_key = 'KnowledgeUser.gotknowledge.group.acquaintance'
                elif not kp.is_root(know_id):
                    local_key = 'KnowledgeUser.gotknowledge.group.additional'
                if local_key:
                    text = u'({0}): {1}'.format(rep_utils.get_name(group_id), lc(local_key))
        if text:
            BWPersonality.GUICore.chatPrint(CHANNEL_CONSTS.ACHIEVMENTS, text)
        return