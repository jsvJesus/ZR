# Embedded file name: ./common/recoil_and_spread_table.py
data = '\nincombat-idle\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.1 \t\t\t1.0\nincombat-walk\t\t\t\t1.2\t\t\t\t1.0\t\t\t\t0.1 \t\t\t1.2\nincombat-run\t\t\t\t1.5\t\t\t\t1.0\t\t\t\t0.1 \t\t\t1.5\n\nincombat-crouch_idle\t\t1.0\t\t\t\t1.0\t\t\t\t0.1 \t\t\t1.0\nincombat-crouch_walk\t\t1.4\t\t\t\t1.4\t\t\t\t0.1 \t\t\t1.4\nincombat-crouch_run\t\t\t2.0\t\t\t\t2.0\t\t\t\t0.1 \t\t\t2.0\n\nincombat-crawl_walk\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.1 \t\t\t1.0\nincombat-crawl_idle\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.1 \t\t\t1.0\n\naim-idle\t\t\t\t\t0.7\t\t\t\t0.9\t\t\t\t1.0 \t\t\t0.8\naim-walk\t\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t1.0 \t\t\t1.5\naim-run\t\t\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t1.0 \t\t\t1.0\n\naim-crouch_idle\t\t\t\t0.6\t\t\t\t0.8\t\t\t\t1.0 \t\t\t0.65\naim-crouch_walk\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t1.0 \t\t\t2.0\naim-crouch_run\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t1.0 \t\t\t1.0\n\naim-crawl_idle\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t1.0 \t\t\t1.0\naim-crawl_walk\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t1.0 \t\t\t1.0\n\nbored-idle\t\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.0 \t\t\t0.0\nbored-walk\t\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.0 \t\t\t0.0\nbored-run\t\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t1.0 \t\t\t0.0\n\nbored-crouch_idle\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.0 \t\t\t0.0\nbored-crouch_walk\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.0 \t\t\t0.0\n\nbored-crawl_idle\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.0 \t\t\t0.0\nbored-crawl_walk\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.0 \t\t\t0.0\nbored-crouch_run\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.0 \t\t\t0.0\nbored-sprint\t\t\t\t1.0\t\t\t\t1.0\t\t\t\t0.0 \t\t\t0.0\n'
REC_SPR_MULT_BY_STATE = {}
for line in data.split('\n'):
    line = line.strip()
    if not line:
        continue
    name, torso, recoil, grade_recoil, spread = line.split()
    status_name, action_type = name.split('-')
    key = ('tracker', status_name, action_type)
    REC_SPR_MULT_BY_STATE[key] = dict(torso=float(torso), recoil=float(recoil), spread=float(spread), grade_recoil=float(grade_recoil))

def getRecoilTorsoCoef(player):
    mult = REC_SPR_MULT_BY_STATE[player._getTrackerKey()]['torso']
    if player.active_weapon:
        mult = mult * player.active_weapon.getRecoilModifier()
    speed_mult = 1.0
    return (mult, speed_mult)


def getPerkAndGradeRecoil(player):
    mult_perc_grade = 1.0
    if player.active_weapon:
        mult_perc_grade = player.active_weapon.getRecoilModifier()
        grade_coef = REC_SPR_MULT_BY_STATE[player._getTrackerKey()]['grade_recoil']
        mult_perc_grade = 1.0 - (1.0 - mult_perc_grade) * grade_coef
        weapon_param = player.active_weapon.getParam()
        perk_recoil = player.get_perk_action_val('W_RECOIL', gun=weapon_param['GunType'], weapon=player.weaponStatus, player=player.getLastActionType())
        if perk_recoil:
            mult_perc_grade *= 1 - perk_recoil
    return mult_perc_grade


def getRecoilGunCoef(player):
    mult = REC_SPR_MULT_BY_STATE[player._getTrackerKey()]['recoil']
    mult_perc_grade = getPerkAndGradeRecoil(player)
    recoil_pos = mult * (1 + (mult_perc_grade - 1.0) * 0.3)
    recoil_rot = mult * mult_perc_grade
    speed_mult = 1.0
    return (recoil_pos, recoil_rot, speed_mult * mult_perc_grade)


def getRecoilGunRWCoef(player):
    return getRecoilGunCoef(player)


def getSpreadGunCoef(player):
    mult = REC_SPR_MULT_BY_STATE[player._getTrackerKey()]['spread']
    if player.isBreathHolding:
        mult *= 0.7
        holding_power = player.get_perk_action_val('BREATHHOLD_POWER')
        mult *= 1.0 - holding_power
    if player.active_weapon:
        mult = mult * player.active_weapon.getSpreadModifier()
        weapon_param = player.active_weapon.getParam()
        perk_recoil = player.get_perk_action_val('W_SPREAD', gun=weapon_param['GunType'], weapon=player.weaponStatus, player=player.getLastActionType())
        if perk_recoil:
            mult = mult * (1 - perk_recoil)
    return mult


def getSpreadGunRWCoef(player):
    return getSpreadGunCoef(player)