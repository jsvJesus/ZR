# Embedded file name: ./common/GesturesUtils.py
import json
import ResMgr
ANIMATIONS_PATH = 'scripts/common/data/emotions.json'
animations_data = None

def load_animation_data():
    global animations_data
    try:
        if animations_data:
            return
        py_data_section = ResMgr.openSection(ANIMATIONS_PATH)
        animations_data = json.loads(py_data_section.asBinary, encoding='utf-8')
        emotions = animations_data['emotions']
        for entry in emotions:
            if isinstance(entry['action'], (str, unicode)):
                entry['action'] = str(entry['action'])
            else:
                entry['action'] = map(str, entry['action'])

    except:
        print 'error file:', repr(ANIMATIONS_PATH)

    return animations_data


load_animation_data()

def get_anim_data():
    if not animations_data:
        return None
    else:
        return animations_data


def get_anim_action(index):
    if not animations_data:
        return load_animation_data()
    return animations_data['emotions'][index - 1]