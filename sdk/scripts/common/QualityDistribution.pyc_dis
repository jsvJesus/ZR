# Embedded file name: ./common/QualityDistribution.py
import random
TRIANGLE, CONSTANT, RANDOM = xrange(1, 4)
distributions = {'DEFAULT': {'selling': {'valueCond': 0,
                         'typeCond': CONSTANT,
                         'valueRepairs': 0,
                         'typeRepairs': CONSTANT}},
 'BAD': {'selling': {'valueCond': (30, 50, 70),
                     'typeCond': TRIANGLE,
                     'valueRepairs': (0, 5, 15),
                     'typeRepairs': TRIANGLE}},
 'NORMAL': {'selling': {'valueCond': (70, 80, 90),
                        'typeCond': TRIANGLE,
                        'valueRepairs': (0, 4, 10),
                        'typeRepairs': TRIANGLE}},
 'GOOD': {'selling': {'valueCond': (90, 95, 100),
                      'typeCond': TRIANGLE,
                      'valueRepairs': (0, 1, 5),
                      'typeRepairs': TRIANGLE}},
 'PERFECT': {'selling': {'valueCond': 100,
                         'typeCond': CONSTANT,
                         'valueRepairs': 0,
                         'typeRepairs': CONSTANT}},
 'WEAPON_OLD': {'selling': {'valueCond': (0, 50, 80),
                            'typeCond': TRIANGLE,
                            'valueRepairs': (0, 4, 10),
                            'typeRepairs': TRIANGLE}},
 'WEAPON_REGULAR': {'selling': {'valueCond': (30, 70, 99),
                                'typeCond': TRIANGLE,
                                'valueRepairs': (0, 1, 2),
                                'typeRepairs': TRIANGLE}},
 'WEAPON_NEW': {'selling': {'valueCond': (70, 80, 100),
                            'typeCond': TRIANGLE,
                            'valueRepairs': (0, 1, 2),
                            'typeRepairs': TRIANGLE}},
 'CLOTH_STANDART': {'selling': {'valueCond': (70, 80, 99),
                                'typeCond': TRIANGLE,
                                'valueRepairs': (0, 2, 5),
                                'typeRepairs': TRIANGLE}},
 'ELECTONICS_OLD': {'selling': {'valueCond': (0, 40, 90),
                                'typeCond': TRIANGLE,
                                'valueRepairs': (0, 5, 10),
                                'typeRepairs': TRIANGLE}},
 'ELECTONICS_USED': {'selling': {'valueCond': (20, 50, 95),
                                 'typeCond': TRIANGLE,
                                 'valueRepairs': (0, 1, 3),
                                 'typeRepairs': TRIANGLE}},
 'ELECTONICS_NEW': {'selling': {'valueCond': (70, 80, 99),
                                'typeCond': TRIANGLE,
                                'valueRepairs': (0, 0, 0),
                                'typeRepairs': TRIANGLE}},
 'ARTIFACT_NEW': {'selling': {'valueCond': 100,
                              'typeCond': CONSTANT,
                              'valueRepairs': (0, 0, 0),
                              'typeRepairs': TRIANGLE}},
 'AAAAAAAAA': {'selling': {'valueCond': 0,
                           'typeCond': CONSTANT,
                           'valueRepairs': (0, 0, 0),
                           'typeRepairs': TRIANGLE}}}

def generate_repairs_quality(distribution_type):
    distribution = distributions.get(distribution_type)
    if not distribution:
        print 'QualityDistribution (ERROR): {0} type does not exist'.format(distribution_type)
        distribution = distributions['DEFAULT']
    return _generate_value(distribution['selling']['typeRepairs'], distribution['selling']['valueRepairs'], None)


def generate_condition_quality(distribution_type, disp = None):
    typeCond, valueCond = get_quality_distribution_by_type(distribution_type)
    return _generate_value(typeCond, valueCond, disp)


def get_quality_distribution_by_type(distribution_type):
    distribution = distributions.get(distribution_type)
    if not distribution:
        print 'QualityDistribution (ERROR): {0} type does not exist'.format(distribution_type)
        distribution = distributions['DEFAULT']
    return (distribution['selling']['typeCond'], distribution['selling']['valueCond'])


def _generate_value(distribution_type, distribution_value, disp):
    try:
        if distribution_type == CONSTANT:
            return distribution_value
        if distribution_type == TRIANGLE:
            min_value, peak_value, max_value = distribution_value
            if disp:
                min_value += disp[0]
                peak_value += disp[1]
                max_value += disp[2]
            if min_value > max_value:
                min_value, max_value = max_value, min_value
            peak_value = max(min_value, min(peak_value, max_value))
            if min_value == max_value:
                return min_value
            return int(random.triangular(min_value, max_value, peak_value))
        if distribution_type == RANDOM:
            min_value, max_value = distribution_value
            return random.randint(min_value, max_value)
    except Exception as e:
        print '\tERROR::_generate_value', distribution_type, distribution_value
        import traceback
        traceback.format_exc()
        raise e