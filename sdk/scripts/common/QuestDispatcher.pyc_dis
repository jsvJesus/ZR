def get_quest_craft_data(quest_id):
    quest = getQuestOnID(quest_id)
    raise get_type(quest) == Quest.TYPE_CRAFT_ITEM or AssertionError
    recipe_id = quest['Target']['ObjectType']
    amount = quest['Target']['NumOfObjects']
    return (recipe_id, amount)


