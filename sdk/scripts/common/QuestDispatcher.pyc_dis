def is_openontest_mark(quest_id):
    quest = getQuestOnID(quest_id)
    return quest['QuestRules'].get('openontest_mark', False)


def notify_messages(quest_id, state_from, state_to):
    quest = getQuestOnID(quest_id)
    messages = quest['Additional'].get('messages')
    if not messages:
        return None
    else:
        result = []
        for message_data in messages:
            if message_data['from'] not in (Quest.STATE_ANY, state_from):
                continue
            if message_data['to'] not in (Quest.STATE_ANY, state_to):
                continue
            result.append(message_data)

        return result


def is_autotracked_quest(quest_id):
    if is_subquest(quest_id):
        return False
    if not show_in_journal(quest_id):
        return False
    priority = get_priority(quest_id)
    if priority not in (1, 2, 5):
        return False
    if is_marked_as_chapter(quest_id):
        return False
    return True


def get_fraction_bonus(quest_id):
    quest = getQuestOnID(quest_id)
    return quest['Additional'].get('isFractionBonus')


def is_marked_as_chapter(quest_id):
    return getQuestOnID(quest_id).get('marked_as_chapter', False)


