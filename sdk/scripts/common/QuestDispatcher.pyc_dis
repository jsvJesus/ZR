parseAll()
if BigWorld.component == 'base':
    from Config import Creatures

    def _validateAll():
        result = True
        for quest_id, quest in Quests.items():
            if get_type(quest) in (Quest.TYPE_KILLMOBS, Quest.TYPE_KILLMOBS_WITH_ONTEST):
                sub_type = quest['Target'].get('str_param', 0)
                if sub_type:
                    mob_type = quest['Target']['ObjectType']
                    if not Creatures.has_subtype(mob_type, sub_type):
                        result = False
                        print '  QuestDispatcher (CRITICAL ERROR): bad mob in quest {0}, mob_type {1}, mob_subtype {2}'.format(quest_id, mob_type, sub_type)

        return result


    if not _validateAll():
        raise RuntimeError