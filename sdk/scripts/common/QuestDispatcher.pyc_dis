    return (reward.get('dungeonTarget'), reward.get('dungeonTargetMode', 0))


def get_autoquest_replica(quest_id):
    quest = getQuestOnID(quest_id)
    if quest['Target']['QuestType'] == Quest.TYPE_KILLMOBS_WITH_ONTEST:
        mob_type, subtype_name = quest['Target']['ObjectType'], quest['Target']['str_param']
        mob_level = Cfg.get_subtype_index(mob_type, subtype_name)
        mob_name = Cfg.get_mob_name(mob_type, mob_level)
        return lc('Quests.AutoQuest.KillReplica').format(mob_name, quest['Target']['NumOfObjects'])
    if quest['Target']['QuestType'] == Quest.TYPE_FARM:
        item_name = ItemsUtils.GetItemName(quest['Target']['ObjectType'])
        return lc('Quests.AutoQuest.FarmReplica').format(item_name, quest['Target']['NumOfObjects'])
    raise NotImplementedError()


def get_penalty_string(quest_id, groups_data = None):

    def get_rep_string(rep):
        result = lc('Quests.CancelQuest.Reputation')
        for fraction_id, value in rep.items():
            fraction_name = lc(Fractions.FractionNames[fraction_id])
            result += u' {0} {repa},'.format(fraction_name, repa=-value)

        return result[:-1]

    def get_penalty_string(rep):
        result = u''
        for group_id, value in rep.items():
            if rep_utils.is_group_hidden(group_id):
                continue
            if not groups_data.get(group_id):
                continue
            group_name = rep_utils.get_name(group_id)
            result += u' {0} {repa}\n'.format(group_name, repa=-value)

        if result:
            result = (lc('Quests.CancelQuest.Reputation') + result)[:-1]
        return result

    penalty = getQuestOnID(quest_id)['Penalty']
    result = u''
    if penalty['Credits']:
        result += u'{0} {1}\n'.format(lc('Quests.CancelQuest.Money'), -penalty['Credits'])
    if penalty['Expirience']:
        result += u'{0} {1}\n'.format(lc('Quests.CancelQuest.Expirience'), -penalty['Expirience'])
    if penalty['KarmaPK']:
        result += u'{0} {karmas:+}\n'.format(lc('Quests.CancelQuest.Karma'), karmas=-penalty['KarmaPK'])
    if penalty.get('Reputation2'):
        result += get_penalty_string(penalty['Reputation2'])
    return result


def get_autoquests_localizeddata(npc_name, quest_type, target_index):
    return autoquests_localizeddata.get((npc_name, quest_type, target_index), u'no local data {0} {1} {2}'.format(npc_name, quest_type, target_index))


