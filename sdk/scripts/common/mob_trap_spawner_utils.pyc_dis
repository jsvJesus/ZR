# Embedded file name: ./common/mob_trap_spawner_utils.py
import pyson
import ResMgr
from random import random
from Config.Creatures import get_subtype_index
PATH = 'scripts/common/data/MobTrapSpawnerConfig.pyson'
DEFAULT_CHANCE = 1.0
spawners_data = None

def load_data():
    global spawners_data
    if spawners_data:
        return
    try:
        py_data_section = ResMgr.openSection(PATH)
        spawners_data = pyson.loads(py_data_section.asBinary)
    except:
        print 'invalid file:', repr(PATH)
        import traceback
        print traceback.print_exc()
        return

    def validate():
        for spawner_name, mob_list in spawners_data.items():
            n = len(mob_list)
            total_sm = 0.0
            for i in xrange(n - 1, -1, -1):
                mob_data = mob_list[i]
                if 'mobsType' in mob_data and 'mobs_subtype' in mob_data and 'mob_uniq_id' in mob_data:
                    mob_data['spawn_chance'] = max(mob_data.get('spawn_chance', DEFAULT_CHANCE), DEFAULT_CHANCE)
                    total_sm += mob_data['spawn_chance']
                    mobsType = mob_data['mobsType']
                    mobs_subtype = mob_data['mobs_subtype']
                    subtype = get_subtype_index(mobsType, mobs_subtype)
                    if subtype is None:
                        print "DESIGNER_ERROR :: Spawner '{0}' has invalid mob config, no such creature subtype {1} for type {2}".format(spawner_name, mobs_subtype, mobsType)
                        del mob_list[i]
                else:
                    print "DESIGNER_ERROR :: Spawner '{0}' has invalid mob_data: {1}".format(spawner_name, mob_data)
                    del mob_list[i]

            for mob_data in mob_list:
                mob_data['spawn_chance'] /= total_sm

        return

    validate()


def get_random_mob_data(spawner_name):
    mob_list = spawners_data.get(spawner_name)
    if mob_list:
        random_chance = random()
        _from = 0.0
        for mob_data in mob_list:
            _to = _from + mob_data['spawn_chance']
            if _from <= random_chance < _to:
                return (mob_data['mobsType'], mob_data['mobs_subtype'], mob_data['mob_uniq_id'])
            _from = _to

    else:
        print "Invalid spawner_name: '{0}'".format(spawner_name)


def get_spawner_names():
    return spawners_data.keys()


load_data()