def GetLoadAmmoInMagazineDuration(self, magazine_type, loaded_ammo_count = 0, loading_count = 1):
    """
    \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x80\xd1\x8f\xd0\xb4\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xb0\xd1\x82\xd1\x80\xd0\xbe\xd0\xbd\xd0\xbe\xd0\xb2 \xd0\xb2 \xd1\x81\xd1\x8a\xd1\x91\xd0\xbc\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbc\xd0\xb0\xd0\xb3\xd0\xb0\xd0\xb7\xd0\xb8\xd0\xbd \xd1\x81 \xd1\x83\xd1\x87\xd1\x91\xd1\x82\xd0\xbe\xd0\xbc \xd0\xbf\xd0\xb5\xd1\x80\xd0\xba\xd0\xbe\xd0\xb2
    """
    mult = 1 - self.get_perk_action_val('LOAD_AMMO_SPEED')
    item_param = ItemsCatalog.GetItemParam(magazine_type)
    one_duration = item_param.get('LoadAmmoTime', 0.5) * float(mult)
    magazine_capacity = item_param.get('AmmoCapacity', 0)
    need_ammo_count = magazine_capacity - loaded_ammo_count
    if need_ammo_count < 0:
        raise ValueError('ERROR:: Durations::GetLoadAmmoInMagazineDuration {0}, {1}'.format(magazine_capacity, loaded_ammo_count))
    ammo_count = min(need_ammo_count, loading_count)
    return (ammo_count * one_duration + 1.1 + 0.7, one_duration)


def GetEquipDuration(self, gun_type):
    duration = 2.0
    if gun_type != None:
        if hasattr(self, 'getEquipTimeModifyer'):
            duration *= self.getEquipTimeModifyer(gun_type)
        return duration
    else:
        return 0.0
        return


def getThrowUnEquipDuration(self):
    return 0.5


def getUnEquipDuration(self):
    gun_type = ItemsUtils.getEquipedWeaponType(self)
    if gun_type:
        return self.getEquipTimeModifyer(gun_type)


def calcPutOnDuration(entity, equip_item_type):
    unec_dur = getUnEquipDuration(entity)
    if not unec_dur:
        unec_dur = 0
    return unec_dur + 3.0


def calcPutOffDuration(entity, item_type):
    unec_dur = getUnEquipDuration(entity)
    if not unec_dur:
        unec_dur = 0
    return unec_dur + 2.0


def calcEquipDuration(entity, gun_type):
    unec_dur = getUnEquipDuration(entity)
    if not unec_dur:
        unec_dur = 0
    if gun_type is not None:
        unec_dur += entity.getEquipTimeModifyer(gun_type)
    return unec_dur


def GetPutOnDuration(self, equip_item_type, unequip_item_type):
    return 3.0


def GetItemUseDuration(self, item_type):
    return 5.0


def GetAttachGasmaskDuration(self):
    return 2.0


def GetGrenadeThrowDuration(self):
    return getThrowUnEquipDuration(self)


