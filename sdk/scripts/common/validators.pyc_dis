# Embedded file name: ./common/validators.py
import re
from Localization import lc
import ResMgr
import utils_bw
import words_filter
import DataManagerConst

class AvatarName:
    MAX_LEN = 32
    MIN_LEN = 3
    MAX_GROUNDS = 1
    ERR__NOT_ALLOWED_SYMBOLS = 1
    ERR__TOO_SHORT = 2
    ERR__TOO_LONG = 3
    ERR__BEGIN_WITH_GROUND = 4
    ERR__END_WITH_GROUND = 5
    ERR__TOO_MANY_GROUNDS = 6
    REGEX = re.compile(utils_bw.REGEX_NAME)
    errmsg = {ERR__NOT_ALLOWED_SYMBOLS: lc('Codes.common.FORBIDDEN_CHARS'),
     ERR__TOO_SHORT: lc('Codes.common.SHORT_NAME'),
     ERR__TOO_LONG: lc('Codes.common.LONG_NAME'),
     ERR__BEGIN_WITH_GROUND: lc('Codes.common.STARTS_WITH_UNDERSCORE'),
     ERR__END_WITH_GROUND: lc('Codes.common.ENDS_WITH_UNDERSCORE'),
     ERR__TOO_MANY_GROUNDS: lc('Codes.common.MANY_UNDERSCORES')}

    @staticmethod
    def validate(name):
        name = name.strip()
        if len(name) < AvatarName.MIN_LEN:
            error = AvatarName.ERR__TOO_SHORT
        elif len(name) > AvatarName.MAX_LEN:
            error = AvatarName.ERR__TOO_LONG
        else:
            uid = name.lower()
            if AvatarName.REGEX.match(uid):
                if uid.count(u'_') > AvatarName.MAX_GROUNDS:
                    error = AvatarName.ERR__TOO_MANY_GROUNDS
                elif uid[0] == u'_':
                    error = AvatarName.ERR__BEGIN_WITH_GROUND
                elif uid[-1] == u'_':
                    error = AvatarName.ERR__END_WITH_GROUND
                else:
                    return {'valid': True,
                     'uid': name}
            else:
                error = AvatarName.ERR__NOT_ALLOWED_SYMBOLS
        return {'valid': False,
         'error': (error, AvatarName.errmsg[error])}

    if utils_bw.isClient():
        bad_words_path = 'scripts/client/data/Chat/badwords.txt'
        text = ResMgr.openSection(bad_words_path).asBinary
        text = text.replace('\r', '')
        words = text.split('\n')
        comment_patt = re.compile(u'-.*?-', re.MULTILINE | re.UNICODE)
        wrds_filter = words_filter.WordsFilter(words, u'*', comment_patt=comment_patt)

        @staticmethod
        def abuse_in_name(name):
            """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb5\xd1\x81\xd1\x82\xd1\x8c \xd0\xbb\xd0\xb8 \xd1\x80\xd1\x83\xd0\xb3\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd1\x82\xd0\xb2\xd0\xb0 \xd0\xb2 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8."""
            checked_name = AvatarName.wrds_filter.replace_bad_words(name)
            return checked_name != name


def NeedValidateAccountStatus(function):
    """\xd0\x94\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x89\xd0\xb8\xd1\x82\xd1\x8b \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0 \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd0\xb9 \xd0\xbe\xd1\x82 \xd0\xbd\xd0\xb5\xd0\xb2\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xb0."""

    def wrapper(*args, **kwargs):
        account = args[0]
        if account.LoginStatus != DataManagerConst.ACC_LOGINT_STATUS_OK:
            print 'Account {0} NeedValidate! LoginStatus != OK ({1}). Callable function: {2}.'.format(account, args[0].LoginStatus, function)
            return
        result = function(*args, **kwargs)
        return result

    return wrapper