# Embedded file name: ./common/heli/points_parser.py
import BigWorld
_cache = {}

def on_start_parse_space(space_id):
    _cache[space_id] = []


def on_end_parse_space(space_id):
    if _cache[space_id]:
        space_complect = _prepare_space_complect(_cache[space_id])
        BigWorld.globalData[space_id, 'HeliPoints'] = space_complect
    del _cache[space_id]


def _prepare_space_complect(complect):
    guid_to_index = {}
    for index, (section, _) in enumerate(complect):
        guid_to_index[section['guid'].asString] = index

    points = []
    for index, (udo_section, matrix) in enumerate(complect):
        props = udo_section['properties']
        point_id = ''
        if props.has_key('id'):
            point_id = props['id'].asString
        speed = 0
        if props.has_key('speed'):
            speed = props['speed'].asFloat
        point = {'matrix': matrix,
         'speed': speed,
         'next': [],
         'guid': udo_section['guid'].asString,
         'index': index,
         'id': point_id}
        if props.has_key('trigger_mode'):
            point['mode'] = props['trigger_mode'].asInt
        if props.has_key('target'):
            point['target_name'] = props['target'].asString
        next_point_id = guid_to_index.get(props['next_point']['guid'].asString)
        if next_point_id is not None:
            point['next'].append(next_point_id)
        points.append(point)

    return points


def path_point_parsed(space_id, udo_section, matrix):
    _cache[space_id].append((udo_section, matrix))