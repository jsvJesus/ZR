def profiler(f):

    def wrapper(*args, **kwargs):
        t0 = time.time()
        response = f(*args, **kwargs)
        t = time.time() - t0
        print '[profiler] ---------------------- {0} | {1:.4f} sec'.format(f.func_name, t)
        return response

    return wrapper


def get_gmt_timestamp_from_str(datestr, _format = '%d/%m/%Y %H:%M'):
    return int(calendar.timegm(time.strptime(datestr, _format)))


def get_gmt_str_from_timestamp(timestamp, _format = '%d/%m/%Y %H:%M'):
    return time.strftime(_format, time.gmtime(timestamp))


ALLLETTERS = string.letters + '0123456789'

def generateRandStr(size = 10):
    outstr = ''
    for _ in xrange(size):
        outstr += random.choice(ALLLETTERS)

    return outstr


def generateKey(pairsize = 4):
    num = '1234579'
    leters = 'ACDEFGHKLMNPRSTVWXYZ'
    outstr = ''
    for _ in xrange(pairsize):
        outstr += random.choice(leters)
        outstr += random.choice(num)

    return outstr


def hash_data(data, return_hex = True):
    r = hashlib.sha1(data)
    if return_hex:
        return r.hexdigest()
    return r


def weighted_random_choice(choices_list):
    """        \xd0\x92\xd1\x8b\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbd \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb8\xd0\xba \xd0\xb8\xd0\xb7 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0 \xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xb2\xd0\xb5\xd1\x81
            choices_list - \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9, \xd1\x81 \xd0\xbe\xd0\xb1\xd1\x8f\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xbc \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xbe\xd0\xbc 'chance'
            \xd0\xbf\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd1\x80:
            [{'Effect': EffectNames.Vodka, 'chance': 0.5}, {'Effect': EffectNames.Poison, 'chance': 0.7}]
    """
    weights = [ entry['chance'] for entry in choices_list ]
    total = 0
    cum_weights = []
    for w in weights:
        total += w
        cum_weights.append(total)

    x = random.random() * total
    i = bisect(cum_weights, x)
    return choices_list[i]


