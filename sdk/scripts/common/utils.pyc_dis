def ignoreError(foo):
    u"""
    \u0414\u0435\u043a\u043e\u0440\u0430\u0442\u043e\u0440 \u0434\u043b\u044f \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043e\u0448\u0438\u0431\u043e\u043a \u0432 \u043c\u0435\u0442\u043e\u0434\u0435
    """

    def wrapper(*w, **kw):
        try:
            return foo(*w, **kw)
        except:
            print '\n\n' + '----------'
            print 'foo:', foo
            print 'arg:', (w, kw)
            traceback.print_stack()
            print '-----'
            traceback.print_exc()
            print '----------\n\n'

    return wrapper


def time_test(f):
    """ \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb2\xd1\x8b\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd0\xb8
    """

    def wrapper(self, *args, **kwargs):
        start_ = time.time()
        try:
            out = f(self, *args, **kwargs)
        except:
            print 'ERROR FOR', getattr(self, 'id', 'NO-ID'), self, repr(f)
            print [args, kwargs]
            raise

        prof_time = time.time() - start_
        if prof_time > 0.025:
            print 'WARNING  prof_time', '[{0:3.0f} ms]'.format(prof_time * 1000), self, repr(f), [args, kwargs]
        return out

    return wrapper


