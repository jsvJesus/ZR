def genEndTime10Y():
    return int(time.time()) + 315360000


def plog(msg, *args):
    if args:
        try:
            line = msg % args
        except:
            line = '%s: %s' % (msg, ' | '.join(map(str, args)))

    else:
        line = msg
    print '[%s] %s' % (str(datetime.datetime.now())[:-3], line)


