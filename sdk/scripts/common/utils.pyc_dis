def __check_type(value):
    if value.__class__.__name__ in ('PyArrayDataInstance', 'list', 'tuple'):
        value = __convert_py_array(value)
    elif value.__class__.__name__ in ('PyFixedDictDataInstance', 'dict'):
        value = __convert_py_fixed_dict(value)
    elif value.__class__.__name__ in ('Vector3', 'Vector2', 'Vector4'):
        value = tuple(value)
    return value


def __convert_py_array(py_array):
    lst = []
    for elem in py_array:
        elem = __check_type(elem)
        lst.append(elem)

    return lst


def __convert_py_fixed_dict(fix_dict):
    dct = {}
    for key, value in fix_dict.items():
        value = __check_type(value)
        dct[key] = value

    return dct


