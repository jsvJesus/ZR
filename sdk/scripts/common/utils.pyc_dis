def filewalk(root_path, subpath = ''):
    """  \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd0\xbe\xd0\xb2 \xd1\x81 \xd0\xbf\xd1\x83\xd1\x82\xd1\x8f\xd0\xbc\xd0\xb8 \xd0\xbe\xd1\x82\xd0\xbd\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe root_path
    """
    for name in os.listdir(os.path.join(root_path, subpath)):
        full = os.path.join(root_path, subpath, name)
        if os.path.isdir(full):
            for w in filewalk(root_path, os.path.join(subpath, name)):
                yield w

        else:
            yield (subpath, name)


def create_mob_properties(str_mob_type, subtype_name = None, str_mob_uniq_id = None):
    from Config.Creatures import KEYWORDS, get_subtype_index
    try:
        mob_type = int(str_mob_type)
    except ValueError:
        return

    properties = {'creatureType': mob_type,
     'annihilateOnDecompose': 1}
    if subtype_name is None:
        subtype_name = KEYWORDS.DEFAULT_LEVEL
    properties['creatureSubType'] = str(subtype_name)
    subtype_index = get_subtype_index(mob_type, subtype_name)
    if subtype_index is None:
        return False
    else:
        properties['level'] = subtype_index
        if str_mob_uniq_id is not None:
            properties['uniq_id'] = str_mob_uniq_id.encode('utf-8')
        return properties


class LogMethods(object):

    def __init__(self, method_names = None, logger = None, print_args = False, print_private = False, print_special = False, print_traceback = False):
        if method_names is None:
            self.method_names = {}
        elif isinstance(method_names, (list, tuple)):
            self.method_names = dict.fromkeys(method_names, None)
        elif isinstance(method_names, dict):
            self.method_names = method_names
        else:
            raise AttributeError('first argument must be list, tuple, dictionary or None')
        self.cls = None
        self.logger = self.check_or_create_logger(logger)
        self.print_args = print_args
        self.print_private = print_private
        self.print_special = print_special
        self.print_stack = print_traceback
        return

    def check_or_create_logger(self, logger):
        if logger is not None and not isinstance(logger, logging.Logger):
            raise AttributeError("'logger' must be instance of logging.Logger")
        logger = self._create_logger() if logger is None else logger
        return logger

    def logging_method(self, method, msg):
        """\xd0\x94\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0, \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0."""

        @functools.wraps(method)
        def wrapper(*args, **kws):
            result = method(*args, **kws)
            if self.print_args:
                message = '{0} *** Arguments: {1} {2}'.format(msg, args, kws)
            else:
                message = msg
            self.logger.info(message)
            if self.print_stack:
                traceback.print_stack()
            return result

        return wrapper

    def decorate_methods(self):

        def predicat(obj_attr):
            if not inspect.ismethod(obj_attr) and not inspect.isfunction(obj_attr):
                return False
            if not self.print_special and obj_attr.__name__.endswith('__') and obj_attr.__name__.startswith('__'):
                return False
            if not self.print_private and obj_attr.__name__.startswith('_'):
                return False
            if self.method_names and obj_attr.__name__ not in self.method_names:
                return False
            return True

        for method_name, obj in inspect.getmembers(self.cls, predicate=predicat):
            comment = self._create_comment(method_name, obj)
            setattr(self.cls, method_name, self.logging_method(obj, comment))

    def _create_comment(self, method_name, method):
        log_source = '{0}::{1}'.format(self.cls.__name__, method_name)
        if self.method_names and self.method_names[method_name] is not None:
            user_comment = self.method_names[method_name]
            comment = '{0} *** {1}'.format(log_source, user_comment)
        else:
            comment = log_source
        return comment

    def _create_logger(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb4\xd0\xb5\xd0\xb1\xd0\xb0\xd0\xb3\xd0\xb0 \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb5\xd1\x80."""
        logger = logging.getLogger('debug')
        if logger.handlers:
            return logger
        logger.setLevel(logging.DEBUG)
        formatter = logging.Formatter('%(asctime)-20s %(levelname)-10s %(message)s')
        crit_hand = logging.StreamHandler(sys.stderr)
        crit_hand.setLevel(logging.DEBUG)
        crit_hand.setFormatter(formatter)
        logger.addHandler(crit_hand)
        return logger

    def __call__(self, cls):
        self.cls = cls
        self.decorate_methods()
        return cls


def log_methods(method_names_or_class = None, logger = None):
    """\xd0\x94\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xb0, \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb0\xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x81\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xb2.
    
    \xd0\x94\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xbb\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c, \xd0\xba\xd0\xb0\xd0\xba \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xbf\xd0\xb0\xd1\x80\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80\xd1\x8b, \xd1\x82\xd0\xb0\xd0\xba \xd0\xb8 \xd0\xb1\xd0\xb5\xd0\xb7
    \xd0\xbf\xd0\xb0\xd1\x80\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80\xd0\xbe\xd0\xb2, \xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe \xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd1\x8f\xd0\xbc\xd1\x83\xd1\x8e \xd0\xbe\xd0\xb1\xd0\xbe\xd1\x80\xd0\xb0\xd1\x87\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81.
    
    \xd0\x9d\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x8f \xd0\xb4\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2\xd0\xb5\xd1\x81\xd1\x8c \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81, \xd1\x81\xd0\xbe\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb6\xd0\xb0\xd1\x89\xd0\xb8\xd0\xb9 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb5 \xd0\xb8 \xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd0\xba\xd0\xb8\xd0\xb5 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd1\x8b
    (\xd1\x82.\xd0\xb5. \xd0\xbd\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xb2 \xd0\xbd\xd0\xb8 \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbf\xd0\xb0\xd1\x80\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80\xd0\xb0) \xd0\xb8\xd0\xbb\xd0\xb8 \xd0\xb2 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd0\xbe\xd0\xbc \xd0\xb0\xd1\x80\xd0\xb3\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb5 \xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c 
    \xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd0\xba\xd0\xb8\xd0\xb5 \xd0\xb8 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb5 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd1\x8b.
    
    method_names_or_class - \xd0\xb2 \xd1\x8d\xd1\x82\xd0\xbe \xd0\xb0\xd1\x80\xd0\xb3\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f:
            1. \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xb2, \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd1\x85 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb7\xd0\xb0\xd1\x84\xd0\xb8\xd0\xba\xd1\x81\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c
            2. \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8c, \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87 \xd0\xb2 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbc \xd1\x8d\xd1\x82\xd0\xbe \xd0\xb8\xd0\xbc\xd1\x8f \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0, \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb3\xd0\xbe
               \xd0\xbd\xd0\xb0\xd0\xb4\xd0\xbe \xd0\xb7\xd0\xb0\xd1\x84\xd0\xb8\xd0\xba\xd1\x81\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c, \xd0\xb0 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 - \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb5
               \xd0\xb1\xd1\x83\xd0\xb4\xd0\xb5\xd1\x82 \xd0\xb2\xd1\x8b\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5 \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0
            3. \xd0\xb4\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd0\xbc\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81; \xd0\xb2 \xd1\x8d\xd1\x82\xd0\xbe\xd0\xbc \xd1\x81\xd0\xbb\xd1\x83\xd1\x87\xd0\xb0\xd0\xb5 \xd0\xb1\xd1\x83\xd0\xb4\xd1\x83\xd1\x82 \xd0\xb2\xd1\x8b\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f
               \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd1\x8b \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xb2
    
    logger - \xd1\x8d\xd0\xba\xd0\xb7\xd0\xb5\xd0\xbc\xd0\xbf\xd0\xbb\xd1\x8f\xd1\x80 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xb0 logging.Logger; \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd
    \xd0\xb8\xd1\x81\xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb5\xd1\x80 \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9\xd1\x81\xd1\x8f \xd0\xb2 \xd0\xb4\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80\xd0\xb5.
    """
    if logger is not None and not isinstance(logger, logging.Logger):
        raise AttributeError("'logger' must be instance of logging.Logger")

    def create_logger():
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb4\xd0\xb5\xd0\xb1\xd0\xb0\xd0\xb3\xd0\xb0 \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb5\xd1\x80."""
        logger = logging.getLogger('debug')
        if logger.handlers:
            return logger
        logger.setLevel(logging.DEBUG)
        formatter = logging.Formatter('%(asctime)-20s %(levelname)-10s %(message)s')
        crit_hand = logging.StreamHandler(sys.stderr)
        crit_hand.setLevel(logging.DEBUG)
        crit_hand.setFormatter(formatter)
        logger.addHandler(crit_hand)
        return logger

    logger = create_logger() if logger is None else logger

    def logging_method(method, msg = None):
        """\xd0\x94\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0, \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0."""

        @functools.wraps(method)
        def wrapper(*args, **kws):
            log_source = '{0}::{1}'.format(method.im_class.__name__, method.__name__)
            result = method(*args, **kws)
            message = '{0}: {1}'.format(log_source, 'OK' if msg is None else msg)
            logger.info(message)
            return result

        return wrapper

    if inspect.isclass(method_names_or_class):
        cls = method_names_or_class

        def predicat(obj_attr):
            if not inspect.ismethod(obj_attr):
                return False
            if obj_attr.__name__.startswith('_'):
                return False
            return True

        for method_name, _obj in inspect.getmembers(cls, predicate=predicat):
            method = getattr(cls, method_name)
            setattr(cls, method_name, logging_method(method, None))

        return cls
    else:
        method_names = method_names_or_class

        def wrapper(cls):
            if method_names is None:

                def methods_generator():

                    def predicat(obj_attr):
                        if not inspect.ismethod(obj_attr):
                            return False
                        if obj_attr.__name__.startswith('_'):
                            return False
                        return True

                    for method_name, _obj in inspect.getmembers(cls, predicate=predicat):
                        yield (method_name, None)

                    return

                meth_names = methods_generator()
            elif isinstance(method_names, (list, tuple)):
                meth_names = ((method_name, None) for method_name in method_names)
            elif isinstance(method_names, dict):
                meth_names = method_names.iteritems()
            else:
                raise AttributeError("'methods_name' must be list, tuple, dictionary or None")
            for method_name, msg in meth_names:
                method = getattr(cls, method_name)
                setattr(cls, method_name, logging_method(method, msg))

            return cls

        return wrapper


def dup_log(message):
    path = '../var/log/bigworld/dupes.log'
    time_ = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S ')
    open(path, 'a+').write(time_ + message)


class Singlton(object):
    """\xd0\x9f\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbe\xd0\xba \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2-\xd1\x81\xd0\xb8\xd0\xbd\xd0\xb3\xd0\xbb\xd1\x82\xd0\xbe\xd0\xbd\xd0\xbe\xd0\xb2.
    
    \xd0\x98\xd0\xbd\xd0\xb8\xd1\x86\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xb1\xd1\x8a\xd0\xb5\xd0\xba\xd1\x82\xd0\xb0 \xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb0\xd1\x82\xd1\x8c \xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4
    initialization.
    """
    __meteclass__ = abc.ABCMeta
    instance = None
    inited = False

    def __new__(cls, *args, **kwargs):
        if cls.instance is None:
            cls.instance = super(Singlton, cls).__new__(cls, *args, **kwargs)
        return cls.instance

    def __init__(self, *args, **kw):
        if self.inited:
            return
        self.initialization(*args, **kw)
        self.__class__.inited = True

    @abc.abstractmethod
    def initialization(self, *args, **kw):
        """\xd0\x9c\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4 \xd0\xb8\xd0\xbd\xd0\xb8\xd1\x86\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8."""
        pass


class ReadOnly(object):
    """\xd0\x90\xd1\x82\xd1\x80\xd0\xb8\xd0\xb1\xd1\x83\xd1\x82\xd1\x8b \xd0\xbe\xd0\xb1\xd1\x8a\xd0\xb5\xd0\xba\xd1\x82\xd0\xb0 \xd0\xb1\xd1\x83\xd0\xb4\xd1\x83\xd1\x82 \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x87\xd1\x82\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f.
    
    \xd0\x9f\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbe\xd0\xba \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2 \xd1\x81 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd1\x82\xd0\xb0\xd0\xbc\xd0\xb8.
    \xd0\x90\xd1\x82\xd1\x80\xd0\xb8\xd0\xb1\xd1\x83\xd1\x82\xd1\x8b \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd1\x82\xd1\x8c \xd0\xb2 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81, \xd0\xbd\xd0\xbe \xd0\xbd\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x8f \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8f\xd1\x82\xd1\x8c
    \xd0\xb8 \xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c.
    """

    def __setattr__(self, name, value):
        """\xd0\x9e\xd1\x82\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd0\xb5\xd0\xbc \xd0\xb7\xd0\xb0\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c \xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd0\xb1\xd1\x83\xd1\x82\xd0\xbe\xd0\xb2."""
        if name not in self.__dict__:
            self.__dict__[name] = value
        else:
            raise ValueError('cannot change a const attribute')

    def __delattr__(self, name):
        """\xd0\x9e\xd1\x82\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd0\xb5\xd0\xbc \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd0\xb1\xd1\x83\xd1\x82\xd0\xbe\xd0\xb2."""
        raise ValueError('cannot delete a const attribute')


class ReadOnlyDict(dict):

    def __init__(self):
        self.__readonly = False

    def readonly(self, value = True):
        if BigWorld.component == 'client':
            return
        self.__readonly = value

    def __setitem__(self, key, value):
        if self.__readonly:
            raise RuntimeError('Cannot modify ReadOnly')
        return dict.__setitem__(self, key, value)

    def __delitem__(self, key, value):
        if self.__readonly:
            raise RuntimeError('Cannot modify ReadOnly')
        return dict.__delitem__(self, key, value)

    def pop(self, key):
        if self.__readonly:
            raise RuntimeError('Cannot modify ReadOnly')
        return dict.pop(self, key)

    def popitem(self):
        if self.__readonly:
            raise RuntimeError('Cannot modify ReadOnly')
        return dict.popitem(self)

    def clear(self):
        if self.__readonly:
            raise RuntimeError('Cannot modify ReadOnly')
        return dict.clear(self)

    def update(self, other):
        if self.__readonly:
            raise RuntimeError('Cannot modify ReadOnly')
        return dict.update(self, other)

    def setdefault(self, key, default):
        if self.__readonly:
            raise RuntimeError('Cannot modify ReadOnly')
        return dict.setdefault(self, key, default)


class ConstantDictMeta(type):
    """\xd0\x9c\xd0\xb5\xd1\x82\xd0\xb0\xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbd\xd0\xb5\xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd0\xbc\xd1\x8b\xd1\x85 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9.
    
    \xd0\x9d\xd0\xb0\xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb8 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xb0 dict \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd0\xb2\xd1\x88\xd0\xb8\xd0\xb5 \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0\xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81
    \xd0\xbc\xd0\xbe\xd0\xb3\xd1\x83\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xb8\xd0\xbd\xd0\xb8\xd1\x86\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb8
    \xd0\xbd\xd0\xb5 \xd0\xbc\xd0\xbe\xd0\xb3\xd1\x83\xd1\x82 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd1\x82\xd1\x8c \xd1\x81\xd0\xb2\xd0\xbe\xd0\xb8 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f, 
    \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd1\x82\xd1\x8c \xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd0\xb1\xd1\x83\xd1\x82\xd1\x8b \xd0\xbd\xd0\xb0 \xd1\x87\xd1\x82\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5.
    """

    def __new__(cls, classname, bases, dictionary):
        disable_attrs = ['__delattr__',
         '__delitem__',
         '__reduce__',
         '__reduce_ex__',
         '__setattr__',
         '__setitem__',
         'clear',
         'fromkeys',
         'pop',
         'popitem',
         'setdefault',
         'update']
        if 'constant' not in classname.lower():
            classname = 'Constant{0}'.format(classname.capitalize())
        exception_code_string = 'def {attr}(*args, **kw):\n    raise AttributeError("\'{cls}\' \xd1\x81\xd0\xbe\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb6\xd0\xb8\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd1\x81\xd0\xb0\xd0\xbd\xd1\x82\xd1\x8b \xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xb2 \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd1\x8e\xd1\x89\xd0\xb8\xd1\x85 \xd0\xb0\xd1\x82\xd1\x80\xd0\xb8\xd0\xb1\xd1\x83\xd1\x82\xd1\x8b (\xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd1\x80, \'{attr}\')")'
        for attr in disable_attrs:
            exec (exception_code_string.format(attr=attr, cls=classname), dictionary)

        return type.__new__(cls, classname, bases, dictionary)


class ConstantDict(dict):
    """\xd0\x9d\xd0\xb5\xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd0\xbc\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8c.
    
    \xd0\x9f\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb0\xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9-\xd0\xba\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd1\x82.
    """
    __metaclass__ = ConstantDictMeta


def encode_data(data):
    """\xd0\x9a\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb7 \xd1\x8e\xd0\xbd\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb4\xd0\xb0 \xd0\xb2 utf-8 \xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xba\xd0\xb8 \xd0\xb2 json \xd0\xbe\xd0\xb1\xd1\x8a\xd0\xb5\xd0\xba\xd1\x82\xd0\xb5.
    
    \xd0\x98\xd0\xa1\xd0\x9f\xd0\x9e\xd0\x9b\xd0\xac\xd0\x97\xd0\x9e\xd0\x92\xd0\x90\xd0\xa2\xd0\xac \xd0\xa2\xd0\x9e\xd0\x9b\xd0\xac\xd0\x9a\xd0\x9e \xd0\x95\xd0\xa1\xd0\x9b\xd0\x98 \xd0\x9e\xd0\xa1\xd0\x9d\xd0\x9e\xd0\x92\xd0\x9d\xd0\x9e\xd0\x99 \xd0\x9e\xd0\x91\xd0\xaa\xd0\x95\xd0\x9a\xd0\xa2 - \xd0\xad\xd0\xa2\xd0\x9e \xd0\xa1\xd0\x9b\xd0\x9e\xd0\x92\xd0\x90\xd0\xa0\xd0\xac (\xd1\x81\xd0\xbe \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xbe\xd0\xbc \xd0\xbd\xd0\xb5 \xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xb0\xd0\xb5\xd1\x82).
    \xd0\x9f\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb0\xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd1\x87\xd0\xb8 \xd0\xb2 \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8e json.loads \xd0\xb2 \xd0\xb0\xd1\x80\xd0\xb3\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 object_hook.
    \xd0\x91\xd0\xb5\xd0\xb7 \xd0\xbd\xd0\xb5\xd1\x91 \xd0\xb2\xd1\x81\xd0\xb5 \xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xba\xd0\xb8 \xd0\xb1\xd1\x83\xd0\xb4\xd1\x83\xd1\x82 \xd0\xb2 \xd1\x8e\xd0\xbd\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb4\xd0\xb5.
    """

    def _encode_dict(data):
        result = {}
        for key, value in data.items():
            if isinstance(key, unicode):
                key = key.encode('utf-8')
            if isinstance(value, unicode):
                value = value.encode('utf-8')
            elif isinstance(value, list):
                value = _encode_list(value)
            elif isinstance(value, dict):
                value = _encode_dict(value)
            result[key] = value

        return result

    def _encode_list(data):
        result = []
        for item in data:
            if isinstance(item, unicode):
                item = item.encode('utf-8')
            elif isinstance(item, list):
                item = _encode_list(item)
            elif isinstance(item, dict):
                item = _encode_dict(item)
            result.append(item)

        return result

    result = _encode_dict(data)
    return result


def hierarchy_get(fromDict, keys, default = None, use_default = True):
    """
            Works as dict.get, but for hierarchy of dicts/lists and list of keys, respectively.
            If use_default = = False then errors will thow instead of returning default
    """
    try:
        if len(keys) == 0:
            return fromDict
    except TypeError:
        if use_default:
            return default
        raise

    try:
        current = fromDict
        for i in xrange(len(keys)):
            current = current[keys[i]]

        return current
    except TypeError as AttributeError:
        if use_default:
            return default
        raise
    except KeyError:
        if use_default:
            return default
        raise


def hierarchy_set(obj, keys, value, create_dicts = False):
    tmp_obj = obj
    for key in keys[:-1]:
        try:
            tmp_obj = tmp_obj[key]
        except KeyError as IndexError:
            if create_dicts:
                tmp_obj[key] = {}
                tmp_obj = tmp_obj[key]
            else:
                raise

    tmp_obj[keys[-1]] = value


def iterate_dict_leaves(d, return_path = False):
    """Iterate through hierarchy of dicts to get leaves"""

    def get_leaf_recursive(obj):
        if isinstance(obj, dict):
            for key, value in obj.items():
                for inner_obj, inner_key in get_leaf_recursive(value):
                    yield (inner_obj, [key] + inner_key)

        else:
            yield (obj, [])

    for obj, path in get_leaf_recursive(d):
        if return_path:
            yield (obj, path)
        else:
            yield obj


def multi_get(d, *keys, **options):
    """ Return a tuple of values from dict by keys.
            options can have 'default' key (acts as default value in dict.get)
    """
    default = options.get('default')
    return tuple((d.get(key, default) for key in keys))


def hierarchial_update(dict_to, dict_from):
    """Updates a hierarchial dict using another dict. """

    def merge_objects_recursive(object_to, object_from):
        if isinstance(object_to, dict) and isinstance(object_from, dict):
            for key_from, value_from in object_from.items():
                object_to[key_from] = merge_objects_recursive(object_to.get(key_from), value_from)

            return object_to
        else:
            return object_from

    merge_objects_recursive(dict_to, dict_from)


def setattr_dict(object, values_dict):
    for key, value in values_dict.items():
        setattr(object, key, value)


def get_first(predicate, l, default = None):
    """Return first matching element of list, or default if not found."""
    try:
        return ifilter(predicate, l).next()
    except StopIteration:
        return default


def remove_first(predicate, l, default = None):
    """Remove and return first matching element of list, or default if not found."""
    for i, v in enumerate(l):
        if predicate(v):
            return l.pop(i)

    return default


def add_nonexistent(dictTo, dictFrom):
    """Add key:value pairs from dictFrom that are absent in dictTo."""
    for key, value in dictFrom.items():
        if key not in dictTo:
            dictTo[key] = value


def is_identifier(str):
    """Return True if str is valid Python identifier."""
    return bool(re.match(is_identifier.regexp, str))


is_identifier.regexp = re.compile('^[A-Za-z_]+\\w*$')

def dict_get(dictionary, key, default = None):
    """Get for PyFixedDictDataInstance."""
    try:
        return dictionary[key]
    except KeyError:
        return default


def has_branching(d):
    """Retrurn true if hierarchy of d has branching"""
    if isinstance(d, dict):
        if len(d) == 0:
            return False
        if len(d) == 1:
            for val in d.values():
                return has_branching(val)

        else:
            return True
    else:
        return False


def isDictOrFixedDict(val):
    if isinstance(val, dict):
        return True
    if val.__class__.__name__ == 'PyFixedDictDataInstance':
        return True
    return False


def safe_dicts_add(first, second):
    if first is not None and second is not None:
        return first + second
    elif first is not None:
        return first
    elif second is not None:
        return second
    else:
        return
        return


def add_dicts(first_dict, second_dict, custom_add_function = None, before_add_tree_function = None):
    """ \xd1\x81\xd0\xbc\xd0\xb5\xd1\x80\xd0\xb4\xd0\xb6\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb2\xd0\xb0 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8f \xd1\x80\xd0\xb5\xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xbe, \xd1\x81\xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f """
    if isDictOrFixedDict(first_dict) and isDictOrFixedDict(second_dict):
        for second_key in second_dict.keys():
            first_dict_value = first_dict[second_key] if first_dict.has_key(second_key) else None
            second_dict_value = second_dict[second_key]
            if first_dict_value is not None:
                first_dict[second_key] = add_dicts(first_dict_value, second_dict_value, custom_add_function, before_add_tree_function)
            elif before_add_tree_function:
                first_dict[second_key] = before_add_tree_function(second_dict_value)
            else:
                first_dict[second_key] = second_dict_value

        return first_dict
    elif custom_add_function is not None:
        return custom_add_function(first_dict, second_dict)
    else:
        return first_dict + second_dict
        return


def format_price(cost):
    if type(cost) in (float, decimal.Decimal):
        return '%.2f' % cost
    return str(cost)


def format_exc():
    exctype, ex, tb = sys.exc_info()
    try:
        md, ln, fn = traceback.extract_tb(tb)[-1][:3]
        path, md = os.path.split(md)
        result = '{classname}({message}) at `{modulename}`[line {line}] function `{function}`'.format(classname=ex.__class__.__name__, message=ex.args[0] if ex.args else '', modulename=md, line=ln, function=fn)
    finally:
        exctype = ex = tb = None

    return result


def deque_remove_by_index(dq, idx):
    l = len(dq)
    if idx <= l / 2:
        dq.rotate(-idx)
        dq.popleft()
        dq.rotate(idx)
    else:
        dq.rotate(l - 1 - idx)
        dq.pop()
        dq.rotate(idx - l + 1)


def get_items_count(items, key = lambda k: k):
    """Get a dict of counts, where keys is key(item), default keys == items."""
    res = defaultdict(int)
    for item in items:
        res[key(item)] += 1

    return res


def cached_results(func, _cache = {}):

    def call(*args, **kwargs):
        key = (args, frozenset(kwargs.items()))
        try:
            return _cache[key]
        except TypeError:
            print "ERROR: can't use unhashable args in <cached_results> decorator.", args, kwargs
            raise
        except KeyError:
            _cache[key] = func(*args, **kwargs)
            return _cache[key]

    return call


def get_list_diff(list1, list2):
    """
    \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbd\xd0\xb8\xd1\x86\xd1\x83 \xd0\xbc\xd0\xb5\xd0\xb6\xd0\xb4\xd1\x83 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0\xd0\xbc\xd0\xb8
    list1 - new list
    list2 - old list
    return result = {"added":[], "removed":[]}
    """
    result = {'added': [],
     'removed': []}
    for i in list1:
        if i not in list2:
            result['added'].append(i)

    for i in list2:
        if i not in list1:
            result['removed'].append(i)

    return result


def get_funcs_count():
    res = defaultdict(int)
    for obj in gc.get_objects():
        if isinstance(obj, types.FunctionType):
            res[obj.__name__] += 1

    return res


def get_funcs_count_sorted(top = 0, count = 0):
    funcs = [ (k, v) for k, v in get_funcs_count().items() if v > count ]
    return sorted(funcs, key=lambda kv: kv[1])[-top:]


def get_func_count(*func_names):
    """Return a list of funcs objects count, respectively."""
    key = lambda f: f.__name__
    res = [ get_items_count(get_all_funcs(), key=key)[f] for f in func_names ]
    return res


def get_object_by_id(obj_id):
    """Get object by internal Python id."""
    for obj in gc.get_objects():
        if id(obj) == obj_id:
            return obj


def force_unicode(s):
    if isinstance(s, unicode):
        return s
    if isinstance(s, str):
        return s.decode('utf-8', 'ignore')
    raise ValueError()


def force_utf8(s):
    if isinstance(s, str):
        return s
    elif isinstance(s, unicode):
        return s.encode('utf-8', 'ignore')
    else:
        return str(s)


def groupNumber(number, sep = ' '):
    """ \xd0\xb2\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb1\xd0\xb5\xd0\xbb\xd1\x8b \xd0\xb2 \xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd0\xb0 """
    number = str(number)
    prefix = ''
    if number.startswith('-'):
        prefix = '-'
        number = number.lstrip('-')
    aftert = ''
    if '.' in number:
        number, aftert = number.split('.', 1)
    ln = list(number)
    ln.reverse()
    out = []
    for x, n in enumerate(ln):
        out.append(n)
        if x and not (x + 1) % 3 and x + 1 < len(ln):
            out.append(sep)

    out.reverse()
    number = ''.join(out)
    if aftert:
        number += '.' + aftert
    return prefix + number


def format_money(money):
    from Localization import lc
    return '%s %s' % (groupNumber(money, sep='`'), lc('GiftGui.return.rub'))


DUMP_BASE, DUMP_CELL = xrange(2)

def dump_entity(entity_id, dump_type):
    entity = BigWorld.entities.get(entity_id)
    if not entity:
        return 'Entity not found: ' + str(entity_id)
    if dump_type == DUMP_CELL and not entity.isReal():
        return 'Entity is a ghost: ' + str(entity)

    def attribs_filter(attrib):
        if attrib == 'cellData':
            return False
        if attrib == 'bandwidthPerSecond':
            return False
        if attrib.startswith('__') and attrib.endswith('__'):
            return False
        value = getattr(entity, attrib)
        if str(type(value)) in ("<type 'function'>", "<type 'method-wrapper'>", "<type 'builtin_function_or_method'>", "<type 'instancemethod'>", "<type 'EntityExtraMethod'>"):
            return False
        return True

    if dump_type == DUMP_CELL:
        all_attribs = entity.getDict()
    elif dump_type == DUMP_BASE:
        all_attribs = dir(entity)
    attribs = filter(attribs_filter, all_attribs)
    do_not_align_list = ['complexItemParametresValues',
     'complexItemParametresKeys',
     'AccStandModsKeys',
     'Freez',
     'Failed',
     'Opened',
     'Closed',
     'OnTest',
     'quickSlotBars']

    def represent_value(depth, value):
        value = pyFixedToNativePythonType(value)
        if str(type(value)) in ("<type 'dict'>",):
            if not value:
                return '{}'
            result = '{\n' + '\t' * (depth + 2)
            for i, (key, v) in enumerate(value.items()):
                if key not in do_not_align_list:
                    v = represent_value(depth + 1, v)
                if i != 0:
                    result += ',\n' + '\t' * (depth + 2)
                result += '{{{0} : {1}}}'.format(key, v)

            result += '\n' + '\t' * (depth + 1) + '}'
            return result
        if str(type(value)) in ("<type 'list'>",):
            if not value:
                return '[]'
            result = '[\n' + '\t' * (depth + 2)
            for i, v in enumerate(value):
                v = represent_value(depth + 1, v)
                if i != 0:
                    result += ',\n' + '\t' * (depth + 2)
                result += str(v)

            result += '\n' + '\t' * (depth + 1) + ']'
            return result
        if isinstance(value, unicode):
            value = value.encode('utf-8')
        return str(value)

    if dump_type == DUMP_BASE:
        file_path = '../var/log/bigworld/dump_entity_base_' + str(entity_id) + '.txt'
    elif dump_type == DUMP_CELL:
        file_path = '../var/log/bigworld/dump_entity_cell_' + str(entity_id) + '.txt'
    file = open(file_path, 'w')
    file.write('{')
    for index, attribute in enumerate(attribs):
        value = getattr(entity, attribute)
        if attribute not in do_not_align_list:
            value = represent_value(0, value)
        if index != 0:
            file.write(',')
        to_write = '\n\t{0} : {1}'.format(attribute, value)
        file.write(to_write)

    file.write('\n}')
    file.close()
    return 'Entity dumped: ' + str(entity)


class CaseInsensitiveStringListSet(list):
    """ - \xd0\xbd\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x81\xd0\xb8\xd1\x82 \xd0\xbe\xd1\x82 \xd1\x80\xd0\xb5\xd0\xb3\xd0\xb8\xd1\x81\xd1\x82\xd1\x80\xd0\xb0
            - \xd0\xbd\xd0\xb5 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb6\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb2\xd1\x8b\xd1\x85 \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xbe\xd0\xb2
    """

    def add(self, item):
        self.append(item)

    def append(self, item):
        if item in self:
            return
        super(CaseInsensitiveStringListSet, self).append(item)

    def remove(self, item):
        lower_item = lower(item)
        for i in xrange(len(self) - 1, -1, -1):
            if lower(self[i]) == lower_item:
                del self[i]

    def __contains__(self, item):
        lower_item = lower(item)
        for i in self:
            if lower(i) == lower_item:
                return True

        return False


def lower(text):
    if isinstance(text, unicode):
        return text.lower().encode('utf-8')
    else:
        return text.decode('utf-8').lower().encode('utf-8')


def time_struct_to_seconds(time_struct):
    return time_struct.tm_hour * 3600 + time_struct.tm_min * 60 + time_struct.tm_sec


def time_ms_to_string(time_ms):
    minutes = int(time_ms) / 60
    hours = minutes / 60 % 24
    minutes = minutes % 60
    return '{0:02d}:{1:02d}'.format(hours, minutes)


def _infinity_generator_id(from_id = 0):
    id_ = from_id
    while True:
        id_ += 1
        yield id_


def infinity_range_generator(from_id = 0, max_id = 100):
    while True:
        for i in xrange(from_id, max_id):
            yield i


def infinity_array_generator(array):
    while True:
        for i in array:
            yield i


__MATERIAL_SOUND_BY_ID = {}

def get_material_sound_by_id(material_id, default = None):
    if not __MATERIAL_SOUND_BY_ID:
        for material_desc in BigWorld.getMaterialKinds():
            try:
                mat_id = material_desc[1]['id'].asInt
                sound_section = material_desc[1]['sound']
                mat_sound = sound_section is not None and sound_section.asString
                __MATERIAL_SOUND_BY_ID[mat_id] = mat_sound
            except:
                print "Materials (ERROR): can't parse material kinds"
                traceback.print_stack()
                traceback.print_exc()

        __MATERIAL_SOUND_BY_ID['default'] = 'Default'
    return __MATERIAL_SOUND_BY_ID.get(material_id, default)


__TRANSPORT_MATERIAL_BY_ID = {}

def get_transport_material_by_id(material_id, default = 'gravel'):
    if not __TRANSPORT_MATERIAL_BY_ID:
        for mat_id, material_desc in BigWorld.getMaterialKinds():
            try:
                section = material_desc['transport_material']
                mat = section is not None and section.asString
                __TRANSPORT_MATERIAL_BY_ID[mat_id] = mat
            except:
                print "Materials (ERROR): can't parse material kinds"
                traceback.print_stack()
                traceback.print_exc()

        __TRANSPORT_MATERIAL_BY_ID['default'] = 'gravel'
    return __TRANSPORT_MATERIAL_BY_ID.get(material_id, default)


def secToTimerText(secs):
    secs = max(0.0, secs)
    hours = math.floor(secs / 3600.0)
    minutes = math.floor((secs - hours * 3600.0) / 60.0)
    seconds = secs - (hours * 3600.0 + minutes * 60.0)
    minutes = int(minutes)
    seconds = int(seconds)
    return '{0:02}:{1:02}'.format(minutes, seconds)


def secToTimerTextWithHours(secs):
    secs = max(0.0, secs)
    hours = math.floor(secs / 3600.0)
    days = int(hours / 24)
    minutes = math.floor((secs - hours * 3600.0) / 60.0)
    seconds = secs - (hours * 3600.0 + minutes * 60.0)
    minutes = int(minutes)
    seconds = int(seconds)
    prefix = ''
    if hours:
        prefix = '{0:02}:'.format(int(hours))
    return prefix + '{0:02}:{1:02}'.format(minutes, seconds)


def get_int16_hash(value):
    return abs(hash(value)) % 32766


def get_creature_class(creature_type, is_boss = 0, silence = 1):
    if not silence:
        print 'get_creature_class', creature_type, creature_type in (22,)
    if creature_type in (22,):
        return 'CreatureWithBubbles'
    if is_boss:
        return 'CreatureBoss'
    return 'Creature'


def readable_location(spacename, pos):
    try:
        location = spacename.replace('spaces/', '')
        location += '[%.1f %.1f %.1f]' % (pos[0], pos[1], pos[2])
    except:
        print 'ERROR FOR:', repr(spacename), repr(pos)
        traceback.print_exc()

    return force_utf8(location)


def get_int_ts():
    return int(time.time())


class Destructable(object):

    def __init__(self):
        self._destroyed = False

    def release(self):
        if self._destroyed:
            return
        self._destroyed = True
        self.on_release()

    def on_release(self):
        pass

    @property
    def destroyed(self):
        return self._destroyed


class ListenableEventType:
    OnDestroy, = (('listenable.ListenableET', r) for r in xrange(1))


class Listenable(Destructable):

    def __init__(self):
        Destructable.__init__(self)
        self._listeners = []

    def add_listener(self, callback):
        if callback not in self._listeners:
            self._listeners.append(callback)

    def remove_listener(self, callback):
        if callback in self._listeners:
            self._listeners.remove(callback)

    def ask_listeners(self, event_type, data = None):
        for listener in list(self._listeners):
            if listener in self._listeners:
                try:
                    result = listener(event_type, data)
                    if result:
                        return result
                except:
                    traceback.print_exc()
                    traceback.print_stack()

    def notify_listeners(self, event_type, data = None):
        """ \xd0\xb2\xd0\xbe \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb8\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xbe\xd1\x87\xd0\xb5\xd0\xbd\xd1\x8c \xd1\x81\xd0\xb8\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f """
        for listener in list(self._listeners):
            if listener in self._listeners:
                try:
                    listener(event_type, data)
                except:
                    traceback.print_exc()
                    traceback.print_stack()

    def on_release(self):
        Destructable.on_release(self)
        data = {'listenable': self}
        self.notify_listeners(ListenableEventType.OnDestroy, data)
        self._listeners = []


class Tickable(object):

    def __init__(self, tick_delay = 0):
        self.__tick_handler = None
        self._tick_delay = tick_delay
        return

    def __stop_tick(self):
        if self.__tick_handler:
            BigWorld.cancelCallback(self.__tick_handler)
            self.__tick_handler = None
        return

    def __start_tick(self):
        self.__stop_tick()
        self.__tick_handler = BigWorld.callback(self._tick_delay, self.__tick)

    def __tick(self):
        self.__stop_tick()
        if self.can_tick():
            self.on_tick()
            if self.on_check_tick():
                self.__start_tick()

    def start_tick(self):
        self.__start_tick()

    def stop_tick(self):
        self.__stop_tick()

    def can_tick(self):
        return True

    def on_tick(self):
        pass

    def on_check_tick(self):
        return True


class ImmutableDict:

    def __init__(self, data):
        self._data = dict(data)
        self._mutating_methods = ['update',
         'pop',
         'popitem',
         'clear',
         'setdefault',
         '__setitem__',
         '__delitem__']

    def __getitem__(self, key):
        return self._data[key]

    def __iter__(self):
        return iter(self._data)

    def __len__(self):
        return len(self._data)

    def __str__(self):
        return str(self._data)

    def __repr__(self):
        return 'ReadOnlyDict(%s)' % self._data

    def __getattr__(self, name):
        if name in self._mutating_methods:
            raise AttributeError("'%s' object has no attribute '%s'" % (self.__class__.__name__, name))
        attr = getattr(self._data, name)
        if callable(attr):
            return attr
        raise AttributeError("'%s' object has no attribute '%s'" % (self.__class__.__name__, name))


def make_immutable(obj):
    if isinstance(obj, dict):
        new_dict = {}
        for k, v in obj.iteritems():
            new_dict[k] = make_immutable(v)

        return ImmutableDict(new_dict)
    if isinstance(obj, list):
        return tuple((make_immutable(item) for item in obj))
    if isinstance(obj, set):
        return frozenset((make_immutable(item) for item in obj))
    return obj


def get_overlapping_area_of_squares(square1, square2):
    """
    \xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82, \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd0\xb5\xd0\xba\xd0\xb0\xd1\x8e\xd1\x82\xd1\x81\xd1\x8f \xd0\xbb\xd0\xb8 \xd0\xb4\xd0\xb2\xd0\xb0 \xd0\xbd\xd0\xb5\xd0\xbf\xd0\xbe\xd0\xb2\xd1\x91\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb0\xd0\xb4\xd1\x80\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xbb\xd0\xbe\xd1\x81\xd0\xba\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8,
    \xd0\xb8 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbb\xd0\xbe\xd1\x89\xd0\xb0\xd0\xb4\xd1\x8c \xd0\xb8\xd1\x85 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd0\xb5\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f (\xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xba\xd1\x80\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f).
    \xd0\x90\xd1\x80\xd0\xb3\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd1\x8b:
            square1: \xd0\xba\xd0\xbe\xd1\x80\xd1\x82\xd0\xb5\xd0\xb6 \xd0\xb8\xd0\xb7 \xd0\xb4\xd0\xb2\xd1\x83\xd1\x85 \xd1\x82\xd0\xbe\xd1\x87\xd0\xb5\xd0\xba ((x_min, z_min), (x_max, z_max)) \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xb2\xd0\xb0\xd0\xb4\xd1\x80\xd0\xb0\xd1\x82\xd0\xb0
            square2: \xd0\xba\xd0\xbe\xd1\x80\xd1\x82\xd0\xb5\xd0\xb6 \xd0\xb8\xd0\xb7 \xd0\xb4\xd0\xb2\xd1\x83\xd1\x85 \xd1\x82\xd0\xbe\xd1\x87\xd0\xb5\xd0\xba ((x_min, z_min), (x_max, z_max)) \xd0\xb2\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xb2\xd0\xb0\xd0\xb4\xd1\x80\xd0\xb0\xd1\x82\xd0\xb0
    \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82:
            \xd0\x9f\xd0\xbb\xd0\xbe\xd1\x89\xd0\xb0\xd0\xb4\xd1\x8c \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd0\xb5\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xb2\xd0\xb0\xd0\xb4\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd0\xb2 (0 \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd0\xb5\xd0\xba\xd0\xb0\xd1\x8e\xd1\x82\xd1\x81\xd1\x8f)
    """

    def get_overlap_length(min1, max1, min2, max2):
        left = max(min1, min2)
        right = min(max1, max2)
        return max(right - left, 0)

    square1_x_min, square1_z_min = square1[0]
    square1_x_max, square1_z_max = square1[1]
    square2_x_min, square2_z_min = square2[0]
    square2_x_max, square2_z_max = square2[1]
    x_overlap = get_overlap_length(square1_x_min, square1_x_max, square2_x_min, square2_x_max)
    z_overlap = get_overlap_length(square1_z_min, square1_z_max, square2_z_min, square2_z_max)
    if x_overlap > 0 and z_overlap > 0:
        return x_overlap * z_overlap
    return 0


def letters_gen(first_letter = None):
    import string
    if first_letter is None:
        letters = string.ascii_uppercase
    else:
        index = string.ascii_uppercase.index(first_letter)
        letters = string.ascii_uppercase[index:]
    prefix_gen = letters_gen()
    prefix = ''
    while True:
        for letter in letters:
            yield prefix + letter

        prefix = next(prefix_gen)
        letters = string.ascii_uppercase

    return