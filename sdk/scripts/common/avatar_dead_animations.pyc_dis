# Embedded file name: ./common/avatar_dead_animations.py
import random
DEFAULT_DEADID = 1
UNDER_WATER_DEADID = 200
COLD_DEADID = 201
CROUCH_DEADID = 202
CRAWL_DEADID = 203
BOAR_DEADID = 204
DEAD_ANIMATIONS = {DEFAULT_DEADID: ('death_1', 'idle_dead1_crawl_incombat', 'getup_unarmed'),
 2: ('death_front_2', 'idle_death_front_2', 'getup_unarmed'),
 3: ('death_front_3', 'idle_death_front_3', 'getup_unarmed'),
 4: ('death_front_4', 'idle_death_front_4', 'getup_unarmed'),
 5: ('death_back_2', 'idle_death_back_2', 'getup_back_2'),
 6: ('death_right_3', 'idle_death_right_3', 'getup_right_1'),
 7: ('death_left_1', 'idle_death_left_1', 'getup_left_1')}
DEAD_ANIMATIONS_SPECCIAL = {UNDER_WATER_DEADID: ('death_200', 'idle_dead200', 'getup_unarmed'),
 COLD_DEADID: ('death_201', 'idle_dead201', 'getup_unarmed'),
 CRAWL_DEADID: ('death_run_front', 'idle_dead1_crawl_incombat', 'getup_unarmed'),
 CROUCH_DEADID: ('death_crouch', 'idle_dead1_crawl_incombat', 'getup_unarmed'),
 BOAR_DEADID: ('death_hit_boar', 'dead_hit_boar', 'getup_unarmed')}
_all_animations = dict(DEAD_ANIMATIONS)
_all_animations.update(DEAD_ANIMATIONS_SPECCIAL)
_dead_ids = DEAD_ANIMATIONS.keys()

class AvatarDeadAnimations:

    def getRandomDeadID(self):
        return random.choice(_dead_ids)

    def getDeadAnimations(self, dead_id):
        if dead_id in _all_animations:
            return _all_animations[dead_id]
        print 'WARNING not found dead_id', dead_id, self
        return _all_animations[DEFAULT_DEADID]