# Embedded file name: ./common/Config/DungeonsConfig.py
import json
import ResMgr
CONFIG_PATH = 'scripts/common/data/dungeon_data.json'
json_data = ResMgr.openSection(CONFIG_PATH).asBinary
CONFIG = json.loads(json_data)

def get_config(dungeon_id):
    global CONFIG
    return CONFIG.get(str(dungeon_id))


def is_dungeon_space(space_name):
    for dungeon_id, dungeon_data in CONFIG.items():
        if str(dungeon_data['space']) == str(space_name):
            return True

    return False


def is_single_dungeon(dungeon_id):
    return get_config(dungeon_id).get('solo', None)