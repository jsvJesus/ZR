# Embedded file name: ./common/Config/Anomalies/CommonConfig.py
from Config import load_json, DATA_PATH
ANOMALIES_DATA_PATH = DATA_PATH + 'Anomalies/'
COMMON_CONFIG_PATH = ANOMALIES_DATA_PATH + '__config__.json'
common_config = load_json(COMMON_CONFIG_PATH)
type_to_name = {}
name_to_type = {}
for str_type, anomaly_name in common_config['type_to_name'].items():
    type = int(str_type)
    type_to_name[type] = anomaly_name
    name_to_type[anomaly_name] = type

type_to_category = {}
for str_category, anomaly_names in common_config['category_types'].items():
    for anomaly_name in anomaly_names:
        anomaly_type = name_to_type[anomaly_name]
        type_to_category[anomaly_type] = int(str_category)

terrains_config = common_config['terrains']
terrains = {}
indexes = []
for i in terrains_config:
    try:
        index, text = i.split()
    except Exception as e:
        print "ERROR PARSE Anomaly TERRAIN_TYPE. Wrong terrain name [{0}]. Must be '<index> <name>'".format(i)
        raise e

    index = int(index)
    if index in indexes:
        raise TypeError('ERROR PARSE Anomaly TERRAIN_TYPE. Found dublicate index[{0}] TERRAIN_TYPE [{1}]'.format(index, i))
    indexes.append(index)
    terrains[text] = index

del indexes