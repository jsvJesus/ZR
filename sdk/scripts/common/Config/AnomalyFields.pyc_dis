# Embedded file name: ./common/Config/AnomalyFields.py
import copy
import json
try:
    import ResMgr
except ImportError:
    pass

from Config import DATA_PATH
anomaly_field_path = DATA_PATH + 'AnomalyField/'
anomalies_path = anomaly_field_path + 'Anomalies/'
anomalyFields = dict()

def recursiveAnomalyLoad(path):
    dataSection = ResMgr.openSection(anomalies_path + path)
    anomData = json.loads(dataSection.asBinary)
    anomPath = anomData.get('path')
    if anomPath:
        return recursiveAnomalyLoad(anomPath)
    else:
        return anomData


def loadAnomalyField(afName):
    path = anomaly_field_path + afName + '.json'
    dataSection = ResMgr.openSection(path)
    data = json.loads(dataSection.asBinary)
    af = anomalyFields[afName] = dict()
    af['cells'] = []
    af['groups'] = dict()
    for rowData in data['cells']:
        row = []
        af['cells'].append(row)
        for cellData in reversed(rowData.split(',')):
            row.append(int(cellData))

    for groupName, groupData in data['groups'].items():
        af['groups'][groupName] = group = dict()
        for anomId, anomData in groupData.items():
            anomId = int(anomId)
            path = anomData.get('path')
            if path:
                group[anomId] = recursiveAnomalyLoad(path)
            else:
                group[anomId] = anomData

    return af


def getAnomalyFieldData(afName):
    if afName not in anomalyFields:
        return loadAnomalyField(afName)
    else:
        return anomalyFields[afName]


def getCellsXNum(afName):
    return len(getAnomalyFieldData(afName)['cells'])


def getCellsZNum(afName):
    return len(getAnomalyFieldData(afName)['cells'][0])


def getCellData(afName, cellX, cellZ):
    return getAnomalyFieldData(afName)['cells'][cellX][cellZ]


def getGroupData(afName, groupName):
    return getAnomalyFieldData(afName)['groups'][groupName]


def getAnomalyData(afName, groupName, anomalyId):
    return getGroupData(afName, groupName)[anomalyId]


def getSFXes(afName, groupName, anomalyId, sfxType):
    ad = getAnomalyData(afName, groupName, anomalyId)
    return ad['sfxes'].get(sfxType)