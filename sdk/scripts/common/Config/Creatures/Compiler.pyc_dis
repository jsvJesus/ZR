import re

class CriteriaCompiler(ICompiler):
    replaces = ['targets_count',
     'health_percent',
     'state',
     'health',
     'is_dead',
     'target_distance',
     'state_time']

    def compile(self, name, value):
        return eval(self.parse_criteria(value))

    def parse_criteria(self, criteria_data):

        def get_replacement(key):
            return "self.get_logic_param('{0}', for_state=for_state)".format(key)

        def get_regex(key):
            return '\\b{0}\\b'.format(key)

        for key in CriteriaCompiler.replaces:
            if key in criteria_data:
                criteria_data = re.sub(get_regex(key), get_replacement(key), criteria_data)

        return 'lambda self, for_state:({0})'.format(criteria_data)


class ModelPathCompiler(StringCompiler):

    def precompile(self, name, value):
        model_path = self.compile(name, value)
        self.set_param('model_path', model_path)


class ColliderPathCompiler(StringCompiler):

    def precompile(self, name, value):
        file_path = self.compile(name, value)
        self.set_param(HITBOX_PATH, file_path or self.default)


class CollidersCompiler(ICompiler):

    def is_generator(self):
        return True

    def generate(self):
        file_name = self.get_param(HITBOX_PATH)
        config_path = 'characters/creatures/' + file_name
        return Colliders.get_colliders_cfg(config_path)


class CapsCompiler(ICompiler):
    caps_str_to_ind = {}
    for entry in ResMgr.openSection('scripts/common/capabilities.xml').values():
        if entry.name == 'state':
            ind = entry.asInt
            name = get_first(lambda sub_entry: sub_entry.name == 'name', entry.values()).asString
            caps_str_to_ind[name] = ind

    def compile(self, name, cap_name):
        return CapsCompiler.caps_str_to_ind[cap_name]


class StateTimerCompiler(ICompiler):

    def compile(self, name, value):
        return (value[STATE_TIMER_TIME], self.get_index(STATES, value[STATE_TIMER_STATE]))


