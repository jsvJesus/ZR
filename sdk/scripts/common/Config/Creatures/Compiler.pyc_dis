class CreatureConfigCompiler(ConfigCompiler):

    def __init__(self):
        params = {'skill_dmg_coef': stat_rate * stat_base['damage'],
         'health_coef': stat_rate * stat_base['health']}
        ConfigCompiler.__init__(self, config_definition, params=params)