{
	"model" : "characters/creatures/bear/bear_polar.model",
	"colliders" : "characters/creatures/bear/hitbox_general.xml",
	"radius" : 2.0,
	"velocity" : 4.0,
	"health" : 2000,
	"name" : "Monster.name.MEDVED",
	"experience" : 20,
	"loot": "Bear_brown",

	"combos" : [

		{
			"name" : "BEAR_COMBO",
			"actions" : ["Bear_AttackPawRight", "Bear_AttackPawLeft"],
			"timing" : [

				{"pause" : 0.8},
				{"strike" : 50.0},
				{"pause" : 0.8},
				{"strike" : 50.0},
				{"pause" : 1.0}
			]
		}
	],

	"states" : [

		{
			"class" : "WanderState",
			"velocity" : 2.0,
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "PersueState",
					"condition" : "self.has_targets"
				},
				{
					"to_state" : "IdleState",
					"condition" : "self.cur_state.cooldowned"
				}
			]
		},

		{
			"class" : "IdleState",
			"on_entry" : "self.model.Bear_LieIn().Bear_Lie()",
			"on_exit" : "self.model.Bear_LieUp()",
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "PersueState",
					"condition" : "self.has_targets"
				},
				{
					"to_state" : "WanderState",
					"condition" : "self.cur_state.cooldowned"
				}
			]
		},

		{
			"class" : "PersueState",
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "WanderState",
					"condition" : "not self.has_targets"
				},
				{
					"to_state" : "AttackState",
					"condition" : "self.can_apply_combo_on_target"
				}
			]
		},

		{
			"class" : "AttackState",
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "WanderState",
					"condition" : "not self.has_targets"
				},
				{
					"to_state" : "PersueState",
					"condition" : "self.cur_state.cooldowned"
				}
			]
		},

		{
			"class" : "DeadState",
			"entry_action" : "Bear_Die",
			"persistent_action" : "Bear_Dead",
			"on_exit" : "self.model.Bear_Dead.stop()",
			"transitions" : [
				{
					"to_state" : "WanderState",
					"condition" : "not self.dead"
				}
			]
		}
	]
}