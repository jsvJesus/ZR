			"persistent_action" : "Verlioka_Dead",
			"transitions" : [
				{
					"to_state" : "WanderState",
					"condition" : "not self.dead"
				}
			]
		},

		{
			"class" : "EscapeState",
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "WanderState",
					"condition" : "not self.has_targets and self.cur_state.cooldowned"
