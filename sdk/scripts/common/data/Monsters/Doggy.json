{
	"model" : "characters/creatures/dog/dog.model",
	"colliders" : "characters/creatures/dog/hitbox_general.xml",
	"radius" : 1.0,
	"health" : 200,
	"velocity" : 8.0,
	"name" : "Monster.name.DOGGY",
	"experience" : 5,
	"loot" : "Dog",

	"combos" : [

		{
			"name" : "DOG_MELEE",
			"actions" : ["Dog_AttackPaws"],
			"timing" : [

				{"pause" : 0.8},
				{"strike" : 30.0},
				{"pause" : 1.5}
			]
		}
	],

	"states" : [

		{
			"class" : "WanderState",
			"velocity" : 4.0,
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "EscapeState",
					"condition" : "self.has_targets and self.life_ratio < 0.3"
				},
				{
					"to_state" : "PersueState",
					"condition" : "self.has_targets"
				},
				{
					"to_state" : "IdleState",
					"condition" : "self.cur_state.cooldowned"
				}
			]
		},

		{
			"class" : "IdleState",
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "PersueState",
					"condition" : "self.has_targets"
				},
				{
					"to_state" : "WanderState",
					"condition" : "self.cur_state.cooldowned"
				}
			]
		},

		{
			"class" : "PersueState",
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "WanderState",
					"condition" : "not self.has_targets"
				},
				{
					"to_state" : "EscapeState",
					"condition" : "self.life_ratio < 0.3 or (self.just_damaged and not self.can_catch_target)"
				},
				{
					"to_state" : "AttackState",
					"condition" : "self.can_apply_combo_on_target"
				}
			]
		},

		{
			"class" : "AttackState",
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "WanderState",
					"condition" : "not self.has_targets"
				},
				{
					"to_state" : "EscapeState",
					"condition" : "self.life_ratio < 0.3"
				},
				{
					"to_state" : "PersueState",
					"condition" : "self.cur_state.cooldowned"
				}
			]
		},

		{
			"class" : "DeadState",
			"entry_action" : "Dog_Die",
			"persistent_action" : "Dog_Dead",
			"on_exit" : "self.model.Dog_Dead.stop()",
			"transitions" : [
				{
					"to_state" : "WanderState",
					"condition" : "not self.dead"
				}
			]
		},

		{
			"class" : "EscapeState",
			"transitions" : [
				{
					"to_state" : "DeadState",
					"condition" : "self.dead"
				},
				{
					"to_state" : "WanderState",
					"condition" : "not self.has_targets and self.cur_state.cooldowned"
				}
			]
		}
	]
}