# Embedded file name: ./common/PathFollower/parser.py
import BigWorld
import traceback
_cache = {}

def on_start_parse_space(space_id):
    _cache[space_id] = []


def on_end_parse_space(space_id):
    if _cache[space_id]:
        data_dict = {}
        for guid, next_point_guids, position, target, trigger_mode, pause, speed in _cache[space_id]:
            data_dict[guid] = {'guid': guid,
             'next_point_guids': next_point_guids,
             'position': position,
             'target': target,
             'trigger_mode': trigger_mode,
             'pause': pause,
             'speed': speed}

        BigWorld.globalData[space_id, 'SimpleWayPoints'] = data_dict
    del _cache[space_id]


def path_point_parsed(space_id, udo_section, matrix):
    try:
        props = udo_section['properties']
        if props['next_points'] is None:
            next_point_guids = []
        else:
            next_point_guids = [ p['guid'].asString for p in props['next_points'].values() ]
            next_point_guids = filter(lambda g: g, next_point_guids)
        target = props['target'].asString if props.has_key('target') else ''
        trigger_mode = props['trigger_mode'].asInt if props.has_key('trigger_mode') else 1
        pause = props['pause'].asFloat if props.has_key('pause') else 0.0
        speed = props['speed'].asFloat if props.has_key('speed') else 0.0
        _cache[space_id].append((udo_section['guid'].asString,
         next_point_guids,
         matrix.translation,
         target,
         trigger_mode,
         pause,
         speed))
    except:
        BigWorld.last_path_follower_data = (space_id, udo_section, matrix)
        print 'parser (ERROR):', props['guid'].asString
        print matrix.translation
        traceback.print_exc()
        raise

    return