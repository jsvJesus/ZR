# Embedded file name: ./common/PathFollower/circuit.py
import bisect
import math_bw
import sys

class RoutePoint:

    def __init__(self, position, direction):
        self.position = position
        self.direction = direction


class WayPointCircuit(object):

    def __init__(self, waypoints, cycled):
        self._length = 0
        self._num_points = 0
        self._smooth_route = True
        self._cycled = cycled
        self._visualization_substeps = 1000
        self._cache_positions_and_distances(waypoints)

    def _cache_positions_and_distances(self, waypoints):
        self._points = []
        self._distances = []
        self.waypoints = waypoints
        self._num_points = len(waypoints)
        accumulate_distance = 0.0
        for i in xrange(self._num_points + (1 if self._cycled else 0)):
            t1 = self.waypoints[i % self._num_points]
            t2 = self.waypoints[(i + 1) % self._num_points]
            p1 = t1.position
            p2 = t2.position
            self._points.append(self.waypoints[i % self._num_points].position)
            self._distances.append(accumulate_distance)
            accumulate_distance += p1.distTo(p2)

    def calculate_dist(self, position):
        min_distance = sys.float_info.max
        index = None
        for i, wp in enumerate(self.waypoints):
            dist = wp.position.distSqrTo(position)
            if dist < min_distance:
                min_distance = dist
                index = i

        return self._distances[index]

    def get_waypoint(self, index):
        distance = self._distances[index]
        return self.get_route_point(distance)

    def get_route_point(self, dist, datagetter = None):
        p1 = self.get_route_position(dist, datagetter)
        p2 = self.get_route_position(dist + 0.1, datagetter)
        delta = p2 - p1
        delta.normalise()
        return RoutePoint(p1, delta)

    def get_route_position(self, dist, datagetter = None):
        if self._length == 0:
            self._length = self._distances[-1]
        if self._cycled:
            dist = dist % self._length
        else:
            dist = math_bw.clamp(dist, 0, self._length)
        point = bisect.bisect_left(self._distances, dist)
        if not self._cycled:
            border_case = True
            if point <= 1:
                p1n = 0
                p2n = 1
            elif point >= self._num_points - 1:
                p1n = -1
                p2n = -2
            else:
                border_case = False
            if border_case:
                i = math_bw.inverse_lerp(self._distances[p1n], self._distances[p2n], dist)
                p1 = self._points[p1n]
                p2 = self._points[p2n]
                if datagetter is not None:
                    datagetter['waypoint_index'] = p1n
                return math_bw.lerp(p1, p2, i)
        p1n = (point - 1 + self._num_points) % self._num_points
        p2n = point
        i = math_bw.inverse_lerp(self._distances[p1n], self._distances[p2n], dist)
        if self._smooth_route:
            p0n = (point - 2 + self._num_points) % self._num_points
            p3n = (point + 1) % self._num_points
            p2n = p2n % self._num_points
            p0 = self._points[p0n]
            p1 = self._points[p1n]
            p2 = self._points[p2n]
            p3 = self._points[p3n]
            if datagetter is not None:
                datagetter['waypoint_index'] = p1n
            return math_bw.catmull_rom(p0, p1, p2, p3, i)
        else:
            p1 = self._points[p1n]
            p2 = self._points[p2n]
            if datagetter is not None:
                datagetter['waypoint_index'] = p1n
            return math_bw.lerp(p1, p2, i)
            return

    def debug_draw(self, lines_holder):
        """ \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0 """
        if self._num_points <= 1:
            return
        self._length = self._distances[-1]
        prev = self.waypoints[0].position
        if self._smooth_route:
            dist = 0.0
            step = float(self._length) / self._visualization_substeps
            while dist < self._length:
                nextp = self.get_route_position(dist + 1.0)
                lines_holder.addLine(prev, nextp, ower=True)
                prev = nextp
                dist += step

            lines_holder.addLine(prev, self.waypoints[0].position)
        else:
            for n in xrange(self._num_points):
                nextp = self.waypoints[(n + 1) % self._num_points].position
                lines_holder.addLine(prev, nextp, ower=True)
                prev = nextp

    @property
    def length(self):
        return self._length