# Embedded file name: ./common/PathFollower/progress_tracker.py
import math_bw
from Math import Vector3
POINT_TO_POINT_THRESHOLD = 2.0
LOOK_AHEAD_FOR_TARGET_OFFSET = 6.0
LOOK_AHEAD_FOR_TARGET_FACTOR = 0.2
LOOK_AHEAD_FOR_DIR_OFFSET = 6.0
LOOK_AHEAD_FOR_DIR_FACTOR = 0.2

class WayPointProgressTracker(object):
    POINT_TO_POINT_STYLE, SMOOTH_ALONG_ROUTE_STYLE = xrange(2)

    def __init__(self, follower, container, target, circuit):
        self._container = container
        self._follower = follower
        self._target = target
        self._progress_style = self.SMOOTH_ALONG_ROUTE_STYLE
        self._circuit = circuit
        self._target_distance = 0.0
        datagetter = {}
        self._progress_point = self._circuit.get_route_point(self._progress_distance, datagetter)
        self._waypoint_index = datagetter['waypoint_index']
        if self._progress_style == self.POINT_TO_POINT_STYLE:
            self._target.set_position(circuit.waypoints[self._progress_num].get_position())
            self._target.set_direction(circuit.waypoints[self._progress_num].get_direction())

    def update(self, dtime):
        datagetter = {}
        if self._progress_style == self.SMOOTH_ALONG_ROUTE_STYLE:
            self._speed = math_bw.lerp(self._speed, (self._last_position - self._follower.get_position()).length / dtime, dtime)
            self._target_distance = self._progress_distance + LOOK_AHEAD_FOR_TARGET_OFFSET + LOOK_AHEAD_FOR_TARGET_FACTOR * self._speed
            self._target.set_position(self._circuit.get_route_point(self._target_distance).position)
            rd_rotate = self._progress_distance + LOOK_AHEAD_FOR_DIR_OFFSET + LOOK_AHEAD_FOR_DIR_FACTOR * self._speed
            rd_rotate = self._circuit.get_route_point(rd_rotate).direction
            rd_rotate = Vector3(0, rd_rotate.pitch, rd_rotate.yaw)
            self._target.set_direction(rd_rotate)
            self._progress_point = self._circuit.get_route_point(self._progress_distance, datagetter)
            progress_delta = self._progress_point.position - self._follower.get_position()
            if progress_delta.dot(self._progress_point.direction) < 0:
                self._progress_distance += progress_delta.length * 0.5
            elif self._target.get_position().distTo(self._follower.get_position()) < 2.0:
                self._progress_distance = self._target_distance
            self._last_position = self._follower.get_position()
        else:
            target_delta = self._target.get_position() - self._follower.get_position()
            if target_delta.length < POINT_TO_POINT_THRESHOLD:
                self._progress_num = (self._progress_num + 1) % len(self._circuit.waypoints)
            self._target.set_position(self._circuit.waypoints[self._progress_num].get_position())
            self._target.set_direction(self._circuit.waypoints[self._progress_num].get_direction())
            self._progress_point = self._circuit.get_route_point(self._progress_distance, datagetter)
            progress_delta = self._progress_point.position - self._follower.get_position()
            if progress_delta.dot(self._progress_point.direction) < 0:
                self._progress_distance += progress_delta.length
            self._last_position = self._follower.get_position()
        self._waypoint_index = datagetter['waypoint_index']

    @property
    def _waypoint_index(self):
        return self._container['waypoint_index']

    @_waypoint_index.setter
    def _waypoint_index(self, value):
        self._container['waypoint_index'] = value

    @property
    def _speed(self):
        return self._container['speed']

    @_speed.setter
    def _speed(self, value):
        self._container['speed'] = value

    @property
    def _last_position(self):
        return self._container['last_position']

    @_last_position.setter
    def _last_position(self, value):
        self._container['last_position'] = value

    @property
    def _progress_distance(self):
        return self._container['progress_distance']

    @_progress_distance.setter
    def _progress_distance(self, value):
        self._container['progress_distance'] = value

    @property
    def _progress_num(self):
        return self._container['progress_num']

    @_progress_num.setter
    def _progress_num(self, value):
        self._container['progress_num'] = value

    @property
    def progress_distance(self):
        return self._progress_distance

    @property
    def target_distance(self):
        return getattr(self, '_target_distance', 0.0)