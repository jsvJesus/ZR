# Embedded file name: ./common/Butchering.py
import BigWorld
from Items import ItemsCatalog
import ItemsUtils
import CharacterUtils
MIN_BUTCH_CONST = 0.005
MIN_LOOT_CONST = 0.005

class Butchering:

    def GetButchuingAbilityModelPath(self):
        if not self.ActiveGadgetList:
            return {}
        for gadget in self.ActiveGadgetList:
            if not gadget.GadjetID:
                continue
            gadget_param = ItemsCatalog.GetItemParam(gadget.GadjetType)
            if gadget_param.get('SubType', {}) == ItemsCatalog.KNIFE:
                return gadget_param.get('ModelNames', {})

        return {}

    def GetKnifeMultiplier(self):
        if not self.ActiveGadgetList:
            return
        else:
            for gadget in self.ActiveGadgetList:
                if not gadget.GadjetID:
                    continue
                gadget_param = ItemsCatalog.GetItemParam(gadget.GadjetType)
                if gadget_param.get('SubType', None) == ItemsCatalog.KNIFE:
                    time = gadget_param.get('Butching_speed', 1)
                    item = ItemsUtils.GetComplexItemByID(self, gadget.GadjetID)
                    item_inconstant_params = ItemsUtils.GetComplexItemInconstanParams(item)
                    current_cond_ratio = ItemsUtils.GetItemConditionRatio(self, item, item_inconstant_params)
                    time += time * (1 - current_cond_ratio)
                    time = time * (1.0 - self.get_perk_action_val('BUTCHERING_MULTIPLIER'))
                    return max(time, 0.1)

            return

    def GetContainerSearchMultiplier(self):
        multiplier = 1.0 - self.get_perk_action_val('LOOT_SEARCHING_MULTIPLIER')
        return max(multiplier, 0.1)

    def GetSearchMultiplier(self):
        multiplier = 1.0 - self.get_perk_action_val('SEARCHING_MULTIPLIER')
        return max(multiplier, 0.1)

    def GetEquipKnifeID(self):
        if not self.ActiveGadgetList:
            return 0
        else:
            for gadget in self.ActiveGadgetList:
                if not gadget.GadjetID:
                    continue
                gadget_param = ItemsCatalog.GetItemParam(gadget.GadjetType)
                if gadget_param.get('SubType', None) == ItemsCatalog.KNIFE:
                    return gadget.GadjetID

            return 0

    def GetEquipKnifeType(self):
        if not self.ActiveGadgetList:
            return 0
        else:
            for gadget in self.ActiveGadgetList:
                if not gadget.GadjetID:
                    continue
                gadget_param = ItemsCatalog.GetItemParam(gadget.GadjetType)
                if gadget_param.get('SubType', None) == ItemsCatalog.KNIFE:
                    return gadget.GadjetType

            return 0

    def checkKnifeCond(self, creature_stiffness):
        if not self.ActiveGadgetList:
            return False
        else:
            for gadget in self.ActiveGadgetList:
                if not gadget.GadjetID:
                    continue
                gadget_param = ItemsCatalog.GetItemParam(gadget.GadjetType)
                if gadget_param.get('SubType', None) == ItemsCatalog.KNIFE:
                    item = ItemsUtils.GetComplexItemByID(self, gadget.GadjetID)
                    if not item:
                        return False
                    item_inconstant_params = ItemsUtils.GetComplexItemInconstanParams(item)
                    current_cond = ItemsUtils.GetItemCondition(None, item, item_inconstant_params, gadget_param)
                    if current_cond <= creature_stiffness:
                        return False
                    return True

            return False