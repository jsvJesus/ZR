# Embedded file name: ./common/NYTeleportUtils.py
import json
import ResMgr
from Items import ItemsCatalog
TELEPORT_DATA_PATH = 'scripts/common/data/NY_teleports.json'
ny_teleport_data = None

def load_teleport_data():
    global ny_teleport_data
    try:
        ResMgr.purge(TELEPORT_DATA_PATH, True)
        py_data_section = ResMgr.openSection(TELEPORT_DATA_PATH)
        ny_teleport_data = json.loads(py_data_section.asBinary, encoding='utf-8')
    except:
        print 'error file:', repr(TELEPORT_DATA_PATH)


load_teleport_data()

def get_teleport_data(space_name, index):
    if not ny_teleport_data:
        return None
    else:
        data = ny_teleport_data.get(space_name, [])
        if index >= len(data):
            return None
        return data[index]['position']


def get_teleport_names(space_name):
    result = []
    data = ny_teleport_data.get(space_name, [])
    for i in data:
        result.append(i['name'])

    return result