# Embedded file name: ./common/client_lights/spot.py
import BigWorld
import Pixie
import math
import Math
import traceback
from light import Light
from light import STATE_UND, STATE_OFF, STATE_ON

class SpotLight(Light):

    def __init__(self, guid, udo, parent_entity, state = STATE_OFF):
        self._light = BigWorld.PyChunkSpotLight()
        self._light.visible = False
        Light.__init__(self, guid, udo, parent_entity, state=state)

    def getMatrix(self, fix_pitch = True):
        prod = Math.MatrixProduct()
        matr_rot = Math.Matrix()
        if fix_pitch:
            matr_rot.setRotateYPR((0, math.pi / 2, 0))
        prod.a = matr_rot
        matr_pos = Math.Matrix()
        matr_dir = Math.Matrix()
        matr_pos.setTranslate(self.getParam('position'))
        matr_dir.setRotateYPR((self.getParam('yaw'), self.getParam('pitch'), self.getParam('roll')))
        matr_pos.preMultiply(matr_dir)
        prod.b = matr_pos
        return prod

    def createModel(self):
        Light.createModel(self)

    def onEndCreateModel(self):
        matr = Math.Matrix(self.getMatrix(fix_pitch=False))
        self.model.setWorldTransform(matr)

    def lightON(self):
        if not self.model:
            return
        if not self.getParam('light_enable'):
            self._light.priority = -1000
            self._light.visible = False
            return
        self.model.visibleAttachments = True
        innerRadius = self.getParam('light_innerRadius', 4.5)
        outerRadius = self.getParam('light_outerRadius', 5.0)
        if innerRadius > outerRadius:
            outerRadius = innerRadius
        self._light.innerRadius = innerRadius
        self._light.outerRadius = outerRadius
        self._light.colour = self.getColor()
        self._light.specular = True
        self._light.diffuse = True
        self._light.priority = self.getParam('light_priority', 1)
        self._light.source = self.getMatrix()
        angle = math.radians(self.getParam('light_angle'))
        self._light.cosConeAngle = math.cos(angle)
        self._light.visible = True

    def lightOFF(self):
        self._light.visible = False

    def destroy(self):
        self._light.visible = False
        Light.destroy(self)
        self._light = None
        return