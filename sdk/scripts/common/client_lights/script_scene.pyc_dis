        Light.__init__(self, guid, udo, parent_entity, state=state)

    def setState(self, new_state, parent_id):
        if new_state == STATE_UND:
            return
        print 'setState', self, self.id, self.state, '->', new_state
        self.updateChildState(new_state)
        if new_state == self.state:
            return
        self.state = new_state
        if self.state == STATE_ON:
            self.runScript()
        elif self.state == STATE_OFF:
            self.stopScript()

