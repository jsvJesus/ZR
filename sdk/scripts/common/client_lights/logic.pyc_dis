# Embedded file name: ./common/client_lights/logic.py
import BigWorld
import Pixie
import GUI
import math
import Math
import traceback
from light import Light
from light import STATE_UND, STATE_OFF, STATE_ON
LOGIC_OR = 0
LOGIC_AND = 1
LOGIC_AND_NO = 2
LOGIC_OR_NO = 3

class Logic(Light):

    def __init__(self, guid, udo, parent_entity, state = STATE_OFF):
        self.input = {}
        self._timer_id = 0
        Light.__init__(self, guid, udo, parent_entity, state=state)

    def createModel(self):
        self.model = None
        return

    def addInputChannel(self, obj_id, state):
        self.input[obj_id] = state

    def setState(self, new_state, parent_id):
        if new_state == STATE_UND:
            new_state = STATE_OFF
        self.input[parent_id] = new_state
        if self._timer_id:
            BigWorld.cancelCallback(self._timer_id)
        delay = self.getParam('delay')
        self._timer_id = BigWorld.callback(delay, self._calc_status)

    def _calc_status(self):
        input_val = self.input.values()
        if not input_val:
            raise ValueError('logic %s, not found parent ' % self.id)
        typeLogic = self.getParam('typeLogic')
        if typeLogic == LOGIC_OR:
            out = any(input_val)
        elif typeLogic == LOGIC_AND:
            out = all(input_val)
        elif typeLogic == LOGIC_AND_NO:
            out = not all(input_val)
        elif typeLogic == LOGIC_OR_NO:
            out = not any(input_val)
        out = bool(out)
        if self.getParam('enableOutPositiveSignal') and out:
            self.updateChildState(out)
        elif self.getParam('enableOutNegativeSignal') and not out:
            self.updateChildState(out)

    def destroy(self):
        if self._timer_id:
            BigWorld.cancelCallback(self._timer_id)
        Light.destroy(self)

    def lightON(self):
        pass

    def lightOFF(self):
        pass

    def attachPixie(self):
        pass

    def detachPixie(self):
        pass