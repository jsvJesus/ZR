# Embedded file name: ./common/client_lights/helpText.py
import BigWorld
import Pixie
import GUI
import math
import Math
import traceback
from light import Light
from light import STATE_UND, STATE_OFF, STATE_ON

class HelpText(Light):

    def __init__(self, guid, udo, parent_entity, state = STATE_OFF):
        Light.__init__(self, guid, udo, parent_entity, state=state)

    def createModel(self):
        self.model = BigWorld.Model('models/bolvan/helpers/editor_help.model')
        self.parent_entity.addModel(self.model)
        self.model.visibleAttachments = True
        text = self.getParam('text_help')
        textnode = GUI.Text(self._get_text(text))
        textnode.explicitSize = True
        textnode.multiline = True
        textnode.size = self.get_text_size(self._get_text(text))
        textnode.colour = (255, 205, 149, 245)
        textnode.filterType = 'LINEAR'
        textnode.verticalAnchor = 'BOTTOM'
        textnode.position = (0, 1.5, 0)
        atch = GUI.Attachment()
        atch.component = textnode
        atch.faceCamera = True
        self.model.position = self.getParam('position')
        yaw = self.getParam('yaw', 0)
        pitch = self.getParam('pitch', 0)
        roll = self.getParam('roll', 0)
        self.model.rotate(roll, (0, 0, 1))
        self.model.rotate(yaw, (0, 1, 0))
        self.model.rotate(pitch, (1, 0, 0))
        self.model.root.attach(atch)
        self.textnode = textnode
        self.onEndCreateModel()

    def get_text_size(self, text):
        scale = self.getParam('text_scale', 1)
        arr = text.split('\n')
        count = 0
        for i in arr:
            count += len(i)

        count = float(count) / len(arr)
        return (count * 0.3 * scale, len(arr) * 0.7 * scale)

    def _get_text(self, text):
        text = text.replace('\\', '\n')
        text = text.replace('<n>', '\n')
        text = text.replace('<b>', '\n')
        return text.decode('utf8', 'ignore')

    def setState(self, new_state, parent_id):
        pass

    def updateChildState(self, new_state):
        pass

    def getChildGuid(self):
        return []

    def getChildUDO(self):
        return []

    def lightON(self, *e):
        pass

    def lightOFF(self):
        pass

    def attachPixie(self):
        pass

    def detachPixie(self):
        pass