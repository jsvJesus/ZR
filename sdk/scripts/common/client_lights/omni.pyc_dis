# Embedded file name: ./common/client_lights/omni.py
import BigWorld
import Pixie
import math
import Math
import traceback
from light import Light
from light import STATE_UND, STATE_OFF, STATE_ON

class OmniLight(Light):

    def __init__(self, guid, udo, parent_entity, state = STATE_OFF):
        self._light = BigWorld.PyChunkLight()
        self._light.visible = False
        Light.__init__(self, guid, udo, parent_entity, state=state)

    def lightON(self):
        if not self.model:
            return
        if not self.getParam('light_enable'):
            self._light.visible = False
            return
        self.model.visibleAttachments = True
        innerRadius = self.getParam('light_innerRadius', 4.5)
        outerRadius = self.getParam('light_outerRadius', 5.0)
        if innerRadius > outerRadius:
            outerRadius = innerRadius
        self._light.innerRadius = innerRadius
        self._light.outerRadius = outerRadius
        self._light.colour = self.getColor()
        self._light.priority = self.getParam('light_priority', 0)
        self._light.specular = True
        self._light.diffuse = True
        self._light.position = self.getParam('position')
        self._light.visible = True

    def lightOFF(self):
        self._light.visible = False

    def destroy(self):
        self._light.visible = False
        Light.destroy(self)
        self._light = None
        return