# Embedded file name: ./common/ClanSettings.py
import os
import Clan
import pyson
import ResMgr
CONFIG_PATH = 'scripts/common/data/ClanConfig.pyson'
CONFIG_DATA = {}
section = ResMgr.openSection(CONFIG_PATH)
CONFIG_DATA = pyson.loads(section.asBinary)

def get_config(level, config_name, default = True):
    level_config = CONFIG_DATA.get(int(level))
    if level_config is None:
        return default
    else:
        return level_config.get(config_name, default)


def get_max_level():
    return max(CONFIG_DATA.keys())


def get_levels():
    keys = CONFIG_DATA.keys()
    keys.sort()
    return keys


def get_upgrade_cost(level):
    level_config = CONFIG_DATA.get(int(level))
    if not level_config:
        return (0, 0, 0)
    return (level_config.get('cost_upgrade_money'), level_config.get('cost_upgrade_CP'), level_config.get('cost_players'))


def get_invite_cost(level):
    level_config = CONFIG_DATA.get(int(level))
    if not level_config:
        return (0, 0)
    return (level_config.get('cost_invite_money'), level_config.get('cost_invite_CP'))


def get_max_players(level):
    return get_config(level, 'max_players', 1)


def is_hide_clan_icon(level):
    return get_config(level, 'hide_clan_icon', 0)


def is_hide_clan_tag(level):
    return get_config(level, 'hide_clan_tag', 0)


def is_block_war(level):
    return get_config(level, 'block_clanwar', 0)


def get_mounthly_cost(level):
    return get_config(level, 'mounthly_cost', 0)


def get_diplomacy_cost(level, dip_type):
    return get_config(level, 'diplomacy_cost_{0}'.format(dip_type), 0)


def get_perk_buy_cp_cost(level):
    return get_config(level, 'perk_buy_cp_cost', 0)


def get_perk_buy_money_cost(level):
    return get_config(level, 'perk_buy_money_cost', 0)


def get_union_count(level):
    return get_config(level, 'clan_union', 0)


def get_alliances_count(level):
    return get_config(level, 'alliances', 0)


def can_change_emblem(level):
    return get_config(level, 'emblem', 0)


def can_buy_base_entities(level):
    return get_config(level, 'buy_base_entities', 0)


def can_buy_base(level):
    return get_config(level, 'have_donat_base', 0)


def get_ranks_maxcount(level):
    return get_config(level, 'max_ranks', 0)


def is_block_alliances(level):
    return get_config(level, 'block_alliances', 0)


def get_weekly_clan_cost(level):
    return get_config(level, 'war_cost_weekly', 0)


def get_war_free_slots(level):
    return get_config(level, 'war_slots_free', 0)


_reward_data = None

def get_clan_reward_data():
    global _reward_data
    if not _reward_data:
        section = ResMgr.openSection('scripts/common/data/clan_rate_reward.pyson')
        _reward_data = pyson.loads(section.asBinary)
    return _reward_data