    @staticmethod
    def to_bit_flags(ignorePK = 0, ignorePVP = 0, ignoreWAR = 0, isAgressive = 0):
        bit_flags = 0
        if ignorePK:
            bit_flags |= 1
        if ignorePVP:
            bit_flags |= 2
        if ignoreWAR:
            bit_flags |= 4
        if isAgressive:
            bit_flags |= 8
        return bit_flags

    @staticmethod
    def getProfession(npcName, avatar = None):
        prof_name = AdditionalNPCParameters.get(npcName, 'prof_name')
        if not prof_name:
            return u''
        return lc('NPCs.PROFESSION.%s' % prof_name, user=avatar)

    @staticmethod
    def getName(npcName, avatar = None):
        local_path = NPCs.names_by_npcName.get(npcName)
        if not local_path:
            return u''
        return lc(local_path, user=avatar)

    @staticmethod
    def key_name_to_local(name, avatar = None):
        _tmp = name.split()
        if len(_tmp) == 2:
            return u'{0} {1}'.format(lc(_tmp[0], user=avatar), lc(_tmp[1], user=avatar))
        return lc(name, user=avatar)

