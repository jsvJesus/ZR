# Embedded file name: ./common/Balance.py
__author__ = 'Madcat'
import ResMgr
BALANCE_FILE = 'scripts/common/data/Balance.xml'
reputation_balance = {}

def parse_balanceXML():
    if not reputation_balance:
        ResMgr.purge(BALANCE_FILE, True)
        resXML = ResMgr.openSection(BALANCE_FILE)
        for fraction_settings in resXML['fractions'].values():
            id = fraction_settings['id'].asInt
            limit = fraction_settings['limit'].asInt
            cat_1 = float(fraction_settings['cat_1'].asString.replace(',', '.'))
            cat_2 = float(fraction_settings['cat_2'].asString.replace(',', '.'))
            cat_3 = float(fraction_settings['cat_3'].asString.replace(',', '.'))
            reputation_balance[id] = {'limit': limit,
             1: cat_1,
             2: cat_2,
             3: cat_3,
             'penalty': dict()}
            for penalty in fraction_settings['penalty'].values():
                penalty_id = penalty['id'].asInt
                penalty_cat_1 = float(penalty['cat_1'].asString.replace(',', '.'))
                penalty_cat_2 = float(penalty['cat_2'].asString.replace(',', '.'))
                penalty_cat_3 = float(penalty['cat_3'].asString.replace(',', '.'))
                reputation_balance[id]['penalty'][penalty_id] = {1: penalty_cat_1,
                 2: penalty_cat_2,
                 3: penalty_cat_3}


def getFractionReputation(fraction_id, category, current_day_limit):
    parse_balanceXML()
    ret = []
    fraction = reputation_balance.get(fraction_id)
    if fraction:
        can_add = fraction['limit'] - current_day_limit
        if can_add > 0:
            to_add = fraction[category] / 100 * fraction['limit']
            precentage = can_add / float(to_add) if can_add - to_add < 0 else 1.0
            ret.append(dict(value=round(to_add * precentage), id=fraction_id))
            for pen_id in fraction['penalty'].keys():
                ret.append(dict(id=pen_id, value=round(fraction['penalty'][pen_id][category] / 100 * precentage * fraction['limit'])))

    return ret


def getDayLimit(fraction_id):
    parse_balanceXML()
    day_limit = 0
    fraction = reputation_balance.get(fraction_id)
    if fraction:
        day_limit = fraction['limit']
    return day_limit