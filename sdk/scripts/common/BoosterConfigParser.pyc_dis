# Embedded file name: ./common/BoosterConfigParser.py
import ResMgr
import json
import copy
_default_config = {'CreditsCoefficient': 1.0,
 'name': '???'}
_config = {0: copy.deepcopy(_default_config)}
path = 'scripts/common/data/BoosterAccountConfig.json'
section = ResMgr.openSection(path)
data = json.loads(section.asBinary)
for string_id, config_data in data.iteritems():
    c = copy.deepcopy(_default_config)
    c.update(config_data)
    _config[int(string_id)] = c

del data
del path
del section

def get_config(booster_id):
    return _config[booster_id]


def get_all_icons():
    result = []
    for booster_id in _config:
        if not booster_id:
            continue
        booster = {'booster_id': booster_id}
        booster['icon_path'] = get_config(booster_id).get('icon_path', '')
        booster['icon_path_with_prem'] = get_config(booster_id).get('icon_path_with_prem', '')
        result.append(booster)

    return result


def get_icon_path(booster_id, have_premium = False, small = False):
    key = 'icon_path'
    tmp = get_config(booster_id).get(key, '')
    if have_premium:
        key += '_with_prem'
        tmp = get_config(booster_id).get(key, tmp)
    if small:
        key += '_small'
    return get_config(booster_id).get(key, tmp)