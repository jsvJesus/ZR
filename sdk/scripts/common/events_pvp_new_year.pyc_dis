def _toStrTime(timestamp):
    return datetime.datetime.fromtimestamp(timestamp).strftime('%d/%m/%Y %H:%M')


def _toTimeStamp(str_data):
    return time.mktime(datetime.datetime.strptime(str_data, '%d/%m/%Y %H:%M').timetuple())


def delayToString(delay):
    if delay < 0:
        return 'NOPE'
    days = int(delay // 86400)
    delay = delay - days * 86400
    hour = int(delay // 3600)
    delay = delay - hour * 3600
    minutes = int(delay // 60)
    return '{0}d {1}h {2}m'.format(days, hour, minutes)


class _PeriodSystemPVP(object):
    instance = None

    def __new__(cls, *dt, **mp):
        if cls.instance is None:
            cls.instance = object.__new__(cls, *dt, **mp)
        return cls.instance

    def getCurrentGames(self):
        return [TEAM_SNOWBALLS_DAILY, GINGERBREAD, NY_PROTECT]

    def getActivePrizeConfigID(self):
        init_date = _toTimeStamp(INIT_DATE)
        cur_time = time.time()
        full_time = ACTIVE_TIME + SLEEP_TIME
        current_play = cur_time - init_date
        rat_cycles = int(current_play // full_time)
        play = current_play - rat_cycles * full_time
        if play > ACTIVE_TIME:
            return 0
        active_games = self.getCurrentGames()
        if not active_games:
            return 0
        rating_game_index = rat_cycles % len(active_games)
        rating_game = active_games[rating_game_index]
        return rating_game

    def gettimeToNextActiveGame(self):
        init_date = _toTimeStamp(INIT_DATE)
        cur_time = time.time()
        full_time = ACTIVE_TIME + SLEEP_TIME
        current_play = cur_time - init_date
        rat_cycles = int(current_play // full_time)
        play = current_play - rat_cycles * full_time
        delay = full_time - play
        if delay < 5.0:
            delay += full_time
        return delay + 3.0


periodSystemPVP = _PeriodSystemPVP()
if __name__ == '__main__':
    print periodSystemPVP.getActivePrizeConfigID()
    print periodSystemPVP.gettimeToNextActiveGame()