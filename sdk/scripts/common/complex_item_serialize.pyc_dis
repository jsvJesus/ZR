# Embedded file name: ./common/complex_item_serialize.py
from a64tool import int_to_a64
from a64tool import a64_to_int
from Items import ItemsCatalog
import ItemsUtils
incs_keys = [ItemsCatalog.INC_WEAPON_GRADES,
 ItemsCatalog.INC_WEAPON_INIT_GRADES,
 ItemsCatalog.INC_COLORISE_A,
 ItemsCatalog.INC_COLORISE_B,
 ItemsCatalog.INC_EMBLEM_ID]

def serialize_inc(complex_item):
    inc = ItemsUtils.get_inc_param(complex_item)
    s = []
    for k in incs_keys:
        if inc.get(k):
            s.append('%s|%s' % (int_to_a64(k), int_to_a64(inc[k])))

    return ';'.join(s)


def decode_inc(text):
    inc = {}
    for e in text.split(';'):
        key, val = map(a64_to_int, e.split('|'))
        inc[key] = val

    if ItemsCatalog.INC_COLORISE_A in inc and ItemsCatalog.INC_COLORISE_B not in inc:
        inc[ItemsCatalog.INC_COLORISE_B] = 0
    if ItemsCatalog.INC_COLORISE_B in inc and ItemsCatalog.INC_COLORISE_A not in inc:
        inc[ItemsCatalog.INC_COLORISE_A] = 0
    if ItemsCatalog.INC_WEAPON_GRADES in inc and ItemsCatalog.INC_WEAPON_INIT_GRADES not in inc:
        inc[ItemsCatalog.INC_WEAPON_INIT_GRADES] = 0
    if ItemsCatalog.INC_WEAPON_INIT_GRADES in inc and ItemsCatalog.INC_WEAPON_GRADES not in inc:
        inc[ItemsCatalog.INC_WEAPON_GRADES] = 0
    return inc