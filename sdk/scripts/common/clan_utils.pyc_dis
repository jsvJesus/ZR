# Embedded file name: ./common/clan_utils.py
import re
import Clan
CLAN_NAME_FILTERS = [u'^[\u0430-\u044f\u0451\u0410-\u042f\u0401\\_0123456789]*$', u'^[a-zA-Z\\_0123456789]*$']

def check_clan_name(clan_name):
    if not isinstance(clan_name, unicode):
        raise TypeError('clan_name mast be unicode,  clan_name={0}, type={1}'.format(repr(clan_name), type(clan_name)))
    if len(clan_name) <= 1:
        return Clan.STATUS_CLAN_NAME_IS_TOO_SHORT
    if len(clan_name) > 32:
        return Clan.STATUS_CLAN_NAME_IS_TOO_LONG
    if not any([ re.match(regex_params, clan_name) for regex_params in CLAN_NAME_FILTERS ]):
        return Clan.STATUS_CLAN_NAME_HAVE_FORBIDDEN_CHAR
    if clan_name.count(u'_') > 1:
        return Clan.STATUS_CLAN_NAME_HAVE_TOO_MUCH_UNDERLINE
    if clan_name.startswith(u'_'):
        return Clan.STATUS_CLAN_NAME_CANT_BEGIN_WITH_UNDERLINE
    if clan_name[-1] == u'_':
        return Clan.STATUS_CLAN_NAME_CANT_ENDS_WITH_UNDERLINE
    return Clan.STATUS_CLAN_NAME_OK


def check_union_name(name):
    union_name = name.decode('utf-8')
    if len(union_name) <= 1:
        return Clan.STATUS_UNION_NAME_IS_TOO_SHORT
    if len(union_name) > 4:
        return Clan.STATUS_UNION_NAME_IS_TOO_LONG
    if not any([ re.match(regex_params, union_name) for regex_params in CLAN_NAME_FILTERS ]):
        return Clan.STATUS_UNION_NAME_HAVE_FORBIDDEN_CHAR
    if union_name.count(u'_') > 1:
        return Clan.STATUS_UNION_NAME_HAVE_TOO_MUCH_UNDERLINE
    if union_name.startswith(u'_'):
        return Clan.STATUS_UNION_NAME_CANT_BEGIN_WITH_UNDERLINE
    if union_name[-1] == u'_':
        return Clan.STATUS_UNION_NAME_CANT_ENDS_WITH_UNDERLINE
    return Clan.STATUS_CLAN_NAME_OK


if __name__ == '__main__':
    print 'test:'
    for clan_name in [u'1',
     u'2221',
     u' space',
     u'Ok',
     '\xd0\xb0\xd0\xb5'.decode('utf8'),
     u'\u0412\u042b\u0412',
     u'\u0417\u0414\u0415\u0421\u042c \u041f\u0420\u041e\u0411\u0415\u041b',
     u'\u0412Z\u042b\u0412',
     u'\u0451\u041a\u043b\u0430\u043d',
     u'BERZLOY\u0130',
     u'[asd]']:
        res = check_union_name(clan_name)
        print 'OK     ' if res == Clan.STATUS_CLAN_NAME_OK else 'ERROR %s' % res, repr(clan_name), len(clan_name)

    print len('abc'), len(u'abc'), len('\xd0\xb0\xd0\xb1\xd0\xb2'), len(u'\u0430\u0431\u0432')