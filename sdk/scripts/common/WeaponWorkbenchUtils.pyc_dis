# Embedded file name: ./common/WeaponWorkbenchUtils.py
import json
import ResMgr
from Items import ItemsCatalog
WORKBENCH_WEAPON_PARAM_PATH = 'scripts/common/data/grade_config.json'
workbench_weapon_data = None

def load_workbench_weapon_data():
    global workbench_weapon_data
    try:
        ResMgr.purge(WORKBENCH_WEAPON_PARAM_PATH, True)
        py_data_section = ResMgr.openSection(WORKBENCH_WEAPON_PARAM_PATH)
        workbench_weapon_data = json.loads(py_data_section.asBinary, encoding='utf-8')
    except:
        print 'error file:', repr(WORKBENCH_WEAPON_PARAM_PATH)


load_workbench_weapon_data()

def get_workbench_data(config_name):
    load_workbench_weapon_data()
    if not workbench_weapon_data:
        return None
    else:
        return workbench_weapon_data.get(config_name)


def get_workbench_config(entity):
    if entity.__class__.__name__ == 'NPC':
        return entity.getAdditionalParam('grade_config')
    else:
        return entity.grade_config


def get_grade_params(complexItem, entity):
    if complexItem is None or entity is None:
        return (0, 0)
    else:
        item_params = ItemsCatalog.GetItemParam(complexItem['complexItemType'])
        level = max(0, item_params.get('exp_Level', 5) - 1)
        grade_config_name = get_workbench_config(entity)
        grade_config = get_workbench_data(grade_config_name) or get_workbench_data('default')
        return (grade_config['chance'][level], grade_config['price'][level])


def get_grade_level(entity):
    if not entity or entity.isDestroyed:
        return 0
    if entity.__class__.__name__ == 'NPC':
        grade_config_name = entity.getAdditionalParam('grade_config')
    else:
        grade_config_name = entity.grade_config
    grade_config = get_workbench_data(grade_config_name) or get_workbench_data('default')
    max_level = 0
    for index, i in enumerate(grade_config['chance']):
        if i > 0:
            max_level = index + 1

    return max_level