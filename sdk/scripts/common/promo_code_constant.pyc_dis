# Embedded file name: ./common/promo_code_constant.py
from Localization import lc

class PCODE:
    OK = 1
    OK_SEND_REG_EMAI_KEY = 2
    OK_REG = 3
    OK_SUBSC_SEND_EMAIL = 4
    OK_SUBSC = 5
    ER_ALREADY_PARTNER = 10
    ER_EMAIL_ALREADY_REGISTERED = 11
    ER_EMAIL_INVALID = 12
    ER_EMAIL_CODE_INCORRECT = 13
    ER_SUBSC_EMAIL_CODE_INCORRECT = 14
    ER_NOT_FOUND_PARTNER = 15
    ER_AUTH = 16
    ER_LIMIT_GAME_ACCOUNTS = 17
    ER_TRANSACTION_EXIST = 18
    ER_CORRUPT_DATA = 19
    ER_NOT_ENOUGH_MONEY = 20
    ER_NOT_FOUND_ORDER = 21
    ER_PARTNER = 22
    ER_POMOCODE_NO_ACTIVE = 23
    ER_NO_GAME_ACCOUNT_SUB = 24
    ER_NOT_FOUND_PROMO_CODE = 25
    ER_ALREADY_USED_PROMO_CODE = 26
    ER_ALREADY_USED_PROMO_CODE_PARTNER = 27
    ER_ALREADY_ENTER_PROMO_CODE_PARTNER = 28
    ER_TIME_PROMO_CODE_PARTNER = 29
    ER_PARTNER_DISABLED = 30

    @staticmethod
    def is_error(code):
        return code >= 10

    @staticmethod
    def get_lc(code, utf8 = False):
        for code_name in dir(PCODE):
            if getattr(PCODE, code_name) == code:
                key = 'promo_code_constant.codes.%s' % code_name
                return lc(key, utf8=utf8)

        return 'CODE:%s' % code


class ERRCODES(PCODE):
    pass


class OKCODES(PCODE):
    pass


if __name__ == '__main__':
    print PCODE.get_lc(ERRCODES.ER_PARTNER_DISABLED)