def get_filter(cat_id):
    """ \xd0\xbe\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xba\xd0\xb0\xd0\xba\xd0\xbe\xd0\xbc\xd1\x83 \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd1\x83 \xd1\x81\xd0\xbe\xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xb0\xd1\x8f \xd0\xba\xd0\xb0\xd1\x82\xd0\xb5\xd0\xb3\xd0\xbe\xd1\x80\xd0\xb8\xd1\x8f """
    try:
        return category_filters.get(cat_id) or get_filter(get_parent(cat_id))
    except:
        return None

    return None


def parse_item(items, get_local_name, parent):
    for item in items:
        key = item['id']
        children = [ child_item['id'] for child_item in item.get('children', []) ]
        hierarchy[key] = {'parent': parent,
         'children': children,
         'name': get_local_name(item['name']),
         'id': key}
        parse_item(item.get('children', []), get_local_name, key)


try:
    import BigWorld
    raise BigWorld.component != 'emulator' or AssertionError
    from ordereddict import OrderedDict
    from Localization import lc
    hierarchy = OrderedDict()
    parse_item(ALL_ITEMS, lambda name: lc('ItemCategories.' + name.encode('utf-8')), None)
except:
    from collections import OrderedDict
    import os
    import xml.etree.ElementTree
    hierarchy = OrderedDict()

    def getFilePath(path, level = 0):
        if level > 9:
            return None
        else:
            path = '../' + path
            if os.path.isfile(path):
                return path
            return getFilePath(path, level + 1)


    file_path = getFilePath('res/local/Russian/ItemCategories.xml')
    if file_path is None:
        raise
    local_file = os.path.join(os.path.join(os.getcwd(), file_path))
    local_file = os.path.normpath(local_file)
    root = xml.etree.ElementTree.parse(local_file).getroot()

    def get_local_name(name):
        children = root.findall(name)
        if children:
            return children[0].text
        return name


    parse_item(ALL_ITEMS, get_local_name, None)

def get_parent(cat_id):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb5\xd0\xbf\xd0\xbe\xd1\x81\xd1\x80\xd0\xb5\xd0\xb4\xd1\x81\xd1\x82\xd0\xb2\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f
            (None, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5\xd1\x82 \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f)
    """
    return hierarchy[cat_id]['parent']


def get_toplevel_parent(cat_id):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f \xd1\x81\xd0\xb0\xd0\xbc\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xb2\xd1\x8b\xd1\x81\xd0\xba\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x83\xd1\x80\xd0\xbe\xd0\xb2\xd0\xbd\xd1\x8f
            (\xd0\xb2\xd0\xb5\xd1\x80\xd0\xbd\xd1\x91\xd1\x82 \xd1\x81\xd0\xb0\xd0\xbc \xd1\x81\xd0\xb5\xd0\xb1\xd1\x8f, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5\xd1\x82 \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f)
    """
    parent = get_parent(cat_id)
    if parent is None:
        return cat_id
    else:
        return get_toplevel_parent(parent)


def has_parent(cat_id):
    return bool(hierarchy[cat_id]['parent'])


def get_children(cat_id, sub_include = False):
    """ sub_include - \xd1\x80\xd0\xb5\xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xb8\xd0\xb2\xd0\xbd\xd0\xbe \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xbf\xd0\xbe\xd1\x82\xd0\xbe\xd0\xbc\xd0\xba\xd0\xbe\xd0\xb2, \xd0\xbb\xd0\xb8\xd0\xb1\xd0\xbe \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbf\xd1\x80\xd1\x8f\xd0\xbc\xd1\x8b\xd1\x85 \xd0\xbf\xd0\xbe\xd1\x82\xd0\xbe\xd0\xbc\xd0\xba\xd0\xbe\xd0\xb2 \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x83\xd1\x80\xd0\xbe\xd0\xb2\xd0\xbd\xd1\x8f
    """
    if not sub_include:
        return hierarchy[cat_id]['children']
    else:
        result = []
        for child in hierarchy[cat_id]['children']:
            sub_children = get_children(child, sub_include)
            result.extend(sub_children)

        result.extend(hierarchy[cat_id]['children'])
        return result


def has_children(cat_id, valid_only = False):
    if not valid_only:
        return bool(hierarchy[cat_id]['children'])
    for child_id in hierarchy[cat_id]['children']:
        if child_id not in (HIDDEN, UNDEFINED):
            return True

    return False


def get_all_names_classes_indices():
    return [ (item['name'], item['id'], i) for i, item in enumerate(hierarchy.values()) ]


def get_name(cat_id):
    item = hierarchy.get(cat_id)
    return item and item['name'] or 'UNDEFINED'


def get_top_level():
    return [ item['id'] for item in ALL_ITEMS ]


def get_level(cat_id):
    result = 0
    item = hierarchy[cat_id]
    while item['parent'] is not None:
        result += 1
        item = hierarchy[item['parent']]

    return result


def get_all_bottom_level_weapons_and_undefined():
    """ \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xba\xd0\xb0\xd1\x82\xd0\xb5\xd0\xb3\xd0\xbe\xd1\x80\xd0\xb8\xd0\xb9 \xd0\xbe\xd1\x80\xd1\x83\xd0\xb6\xd0\xb8\xd0\xb9 """
    ids = filter(lambda weapon_id: not has_children(weapon_id), get_children(WEAPON, sub_include=True))
    ids = [UNDEFINED] + ids
    names = map(get_name, ids)
    return (names, ids)


def get_top_level_names():
    return [ get_name(item['id']) for item in ALL_ITEMS ]


def is_subcategory(child_cat_id, parent_cat_id):
    if child_cat_id == parent_cat_id:
        return True
    else:
        parent_id = get_parent(child_cat_id)
        if parent_id is None:
            return False
        return is_subcategory(parent_id, parent_cat_id)