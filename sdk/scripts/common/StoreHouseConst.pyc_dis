class PAYMENT_RU_STEAM:
    DISABLE = 0
    UKASSA_XSOLLA = 1
    ORIGINAL_STEAM = 9
    _names = {DISABLE: 'DISABLE',
     UKASSA_XSOLLA: 'UKASSA_XSOLLA',
     ORIGINAL_STEAM: 'ORIGINAL_STEAM'}

    @staticmethod
    def getName(pay_type):
        return PAYMENT_RU_STEAM._names.get(pay_type)

    @staticmethod
    def info():
        res = ''
        for k, v in sorted(PAYMENT_RU_STEAM._names.items()):
            res += '%s -%s\n' % (k, v)

        return res


class GIFTKEY_CONST:
    SUCCESS = 0
    ERROR_AVATAR_NOT_FOUND = 1
    ERROR_GIFTKEY_NOTFOUND = 2
    ERROR_GIFTKEY_ALREADY_USED = 3
    ERROR_SERVER_TIMEOUT = 4
    ERROR_UNKNOWN = 5
    _text = {SUCCESS: lc('Codes.GIFTKEY_CONST.SUCCESS'),
     ERROR_AVATAR_NOT_FOUND: lc('Codes.GIFTKEY_CONST.ERROR_AVATAR_NOT_FOUND'),
     ERROR_GIFTKEY_NOTFOUND: lc('Codes.GIFTKEY_CONST.ERROR_GIFTKEY_NOTFOUND'),
     ERROR_GIFTKEY_ALREADY_USED: lc('Codes.GIFTKEY_CONST.ERROR_GIFTKEY_ALREADY_USED'),
     ERROR_SERVER_TIMEOUT: lc('Codes.GIFTKEY_CONST.ERROR_SERVER_TIMEOUT'),
     ERROR_UNKNOWN: lc('Codes.GIFTKEY_CONST.ERROR_UNKNOWN')}

    @staticmethod
    def getCodeFromName(code_name):
        code = getattr(GIFTKEY_CONST, code_name, GIFTKEY_CONST.ERROR_UNKNOWN)
        if code not in GIFTKEY_CONST._text:
            code = GIFTKEY_CONST.ERROR_UNKNOWN
        return code

    @staticmethod
    def getText(code):
        return GIFTKEY_CONST._text.get(code, u'')


def checkFreeSpaceBuyDonate(entity, buy_items):
    """ \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd1\x81\xd0\xb2\xd0\xbe\xd0\xb1\xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xba\xd1\x83\xd0\xbf\xd0\xba\xd0\xb8
    """
    buy_count = sum((e['count'] for e in buy_items if not ItemsUtils.isStackedItemType(e['item_type'])))
    buy_count += len([ e for e in buy_items if ItemsUtils.isStackedItemType(e['item_type']) ])
    if buy_count + len(entity.store_house_items) > MAX_COUNT_STOREHOUSE:
        return False
    return True


