STEAM_CURRENCIES_INCREMENTS = {'CLP': 100,
 'CNY': 100,
 'COP': 100,
 'CRC': 500,
 'IDR': 100,
 'INR': 100,
 'JPY': 100,
 'KRW': 1000,
 'KZT': 100,
 'TWD': 100,
 'UAH': 100,
 'UYU': 100,
 'VND': 50000,
 'RUB': 100,
 'GOLD': 100,
 'PLATINA': 100}

def _round(cent, value):
    ro = cent % value
    if ro:
        cent += value - ro
    return cent


def calculateAndRoundingPrice(cent, discount, currency):
    cent = int(cent - cent * discount)
    if currency in STEAM_CURRENCIES_INCREMENTS:
        cent = _round(cent, STEAM_CURRENCIES_INCREMENTS[currency])
    return int(cent)


def calculateSteamTax(cent, steam_tax, currency):
    if not steam_tax:
        return int(cent)
    cent = cent + cent * (steam_tax / 100.0)
    cent = math.ceil(cent)
    cent = int(cent)
    if currency in STEAM_CURRENCIES_INCREMENTS:
        cent = _round(cent, STEAM_CURRENCIES_INCREMENTS[currency])
    return int(cent)


def kop_to_str_rub(price_cent, always_cents = False):
    rub = str(int(price_cent / 100.0))
    kop = int(price_cent % 100)
    if kop or always_cents:
        rub += '.%02i' % int(kop)
    return rub


def to_stritems(item_type, count, price_cent):
    rub = kop_to_str_rub(price_cent)
    return '%s,%s,%s|' % (item_type, count, rub)


def defEndBlockTime():
    return BLOCK_STEAM_ITEM_TIME + int(time.time())