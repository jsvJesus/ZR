BLOCK_STEAM_ITEM_TIME = 1209600
DONAT_BANNER_IMAGES_PATH = 'soGUI/maps/donat_banner/'

def getDonatBannerID(banner_name):
    if banner_name:
        banner_name = banner_name.strip()
        if banner_name and banner_name.isdigit():
            return int(banner_name)
    return 0


def getDonatBannerPath(banner_id):
    language = str(get_global_language())
    if language not in ('russian', 'english'):
        language = 'english'
    return DONAT_BANNER_IMAGES_PATH + language + '/%s.dds' % banner_id


