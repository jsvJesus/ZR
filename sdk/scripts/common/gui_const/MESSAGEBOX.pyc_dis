def isClosingBtn(btn):
    if btn in [BTN_OK,
     BTN_CANCEL,
     BTN_YES,
     BTN_NO,
     BTN_CONFIRM,
     BTN_PAYEDRESET,
     BTN_BUY]:
        return True
    return False


