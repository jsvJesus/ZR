def calc_craft_chance(recipe_param, perks, workbench_type, kickstart_types):
    from perks_system import perks_parser
    recipe_chance = recipe_param.get('CraftChance', 1.0)
    workbench_chance = perks_parser.get_perk_action_val('WORKBENCH_CHANCE', perks, workbench=workbench_type)
    inst_chance = 0
    total_chance = perks_parser.get_perk_action_val('CRAFT_ALL', perks)
    for set_data in kickstart_set:
        for i, item_type in enumerate(set_data['item_ids']):
            if item_type in kickstart_types:
                perk_action = set_data['perk_actions'][i]
                if perk_action:
                    inst_chance += perks_parser.get_perk_action_val(perk_action, perks)
                inst_chance += set_data['chances'][i]

    res_chance = sum([recipe_chance,
     workbench_chance,
     inst_chance,
     total_chance])
    return min(res_chance, 1.0001)


def get_sound(wtype):
    return _sounds.get(wtype)


def get_model_path(wtype):
    return _models.get(wtype, _models[WorkbenchTypes.NONE])


def get_local_name(wtype, user = None):
    return lc(_names.get(wtype, _names[WorkbenchTypes.NONE]), user=user)