class ShopProcedureResult:
    OK, ERROR, ERROR_PENDING, ERROR_CACHE, ERROR_CATALOG_INDEX, ERROR_SELLERNAME, ERROR_PRICE, ERROR_STATUS, ERROR_ITEMNOTFOUND, ERROR_SELLERNOTFOUND, ERROR_ITEMREMOVE0, ERROR_ITEMREMOVE1, ERROR_ITEMREMOVE2, ERROR_ITEMREMOVE3, ERROR_ITEMREMOVE4, ERROR_ITEMREMOVE5, ERROR_TIMEOUT, ERROR_NODBID, ERROR_ITEM_HASH, ERROR_SENDER_NOT_READY, FAIL_BANK_OVERFLOW = xrange(21)

    @staticmethod
    def to_message(error_code):
        if error_code == ShopProcedureResult.ERROR_CACHE:
            return lc('Codes.ShopResponses.ShopErrorCache').encode('utf8')
        if error_code == ShopProcedureResult.FAIL_BANK_OVERFLOW:
            return lc('Codes.ShopResponses.FAIL_BANK_OVERFLOW').encode('utf8')
        return lc('Codes.ShopResponses.FAIL_BUY').format(error_code).encode('utf8')


