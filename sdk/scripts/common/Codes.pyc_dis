class CabmanNotifications:

    @staticmethod
    def get_message(event):
        if event == CabmanNotifications.SOON_TELEPORT:
            return lc('Cabman.process.CABMAN_DEPART')
        if event == CabmanNotifications.TOO_FAR:
            return lc('Cabman.process.CABMAN_TOOFAR')

    SOON_TELEPORT, TOO_FAR = xrange(2)


class TransportProcess:
    INTERACT_OK, INTERACT_NOT_WAITING, INTERACT_NO_ROOM, INTERACT_NO_TICKET, CANT_LEAVE, SUMMON_BUSY, SUBSCRIBED, UNSUBSCRIBED, ST_BUSY, ST_WAITING, ST_LAZY, ST_STATION, ST_ARRIVE, ST_DEPART, BELL_TERMINAL_LAZY, BILL_TERMINAL_WAITING, BILL_STATION, BILL_SOMEWHERE, BELL_LEAVE, BELL_LAZY = xrange(20)

    @staticmethod
    def get_message(code):
        if code == TransportProcess.INTERACT_NO_TICKET:
            return lc('Transport.interactions.noticked')
        if code == TransportProcess.INTERACT_NOT_WAITING:
            return lc('Transport.interactions.notwait')
        if code == TransportProcess.INTERACT_NO_ROOM:
            return lc('Transport.interactions.noroom')
        if code == TransportProcess.INTERACT_OK:
            return lc('Transport.interactions.ok')
        if code == TransportProcess.SUMMON_BUSY:
            return lc('Transport.interactions.busy')
        if code == TransportProcess.CANT_LEAVE:
            return lc('Transport.interactions.cantleave')
        return u'transport process error: ' + str(code)

    @staticmethod
    def compile_event(code, int_data = 0, float_data = 0):
        return {'code': code,
         'int_data': int_data,
         'float_data': float_data}


