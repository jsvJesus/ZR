class LogType:
    NoLog = 0
    LogChat = 1
    LogCassChange = 4
    LogCassGain = 6
    LogCass = LogCassGain | LogCassChange
    LogAll = LogCass | LogChat

    @staticmethod
    def need_log_cassandra_item_changed(log_type):
        return bool(log_type & LogType.LogCassChange)

    @staticmethod
    def need_log_cassandra_item_gained(log_type):
        return bool(log_type & LogType.LogCassGain)

    @staticmethod
    def need_log_chat(log_type):
        return bool(log_type & LogType.LogChat)


class InventoryActionProhibitError:
    Ok, Hood, Visor, Equip, Item = range(5)

    @staticmethod
    def get_message(code, item_type):
        """ client only """
        import ItemsUtils
        itemname = ItemsUtils.GetItemName(item_type)
        if code == InventoryActionProhibitError.Visor:
            return lc('Inventory.client.prohibit_action_visor').format(itemname=itemname)
        elif code == InventoryActionProhibitError.Hood:
            return lc('Inventory.client.prohibit_action_hood').format(itemname=itemname)
        elif code == InventoryActionProhibitError.Equip:
            return lc('Inventory.client.prohibit_action').format(itemname=itemname)
        else:
            return
            return


