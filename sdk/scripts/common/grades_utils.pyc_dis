     PENETRATION: u'\u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u043e\u0431\u0438\u0442\u0438\u0435',
     CONDITION_RELIABILITY_AFFECTION: u'\u041a\u043b\u0438\u043d \u043e\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f',
     SCORCHING_RELIABILITY_AFFECTION: u'\u041a\u043b\u0438\u043d \u043e\u0442 \u0437\u0430\u0433\u0440\u044f\u0437\u043d\u0435\u043d\u0438\u044f',
