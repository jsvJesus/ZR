    return data.get(param_id, 'ERROR')


def save_params_relations():
    with open('../../../res/scripts/common/data/grades_param_relations.pyson', 'w') as f:
        f.write(pyson.dumps(PARAMS_RELATIONS))


def get_grade_default_relations(key_id):
    return PARAMS_RELATIONS.get(key_id, [])


def set_inc_param(key_id, inc_val, value):
    if key_id >= PARAM_COUNT:
        raise ValueError('Grade param key > max count')
    value = int8(value)
    for i in xrange(8):
        bin_val = value & 1 << i
        if int(bin_val):
            inc_val |= 1 << i + key_id * 8
        else:
            inc_val &= ~(1 << i + key_id * 8)

    return inc_val


def get_inc_param(key_id, inc_val):
    result = 0
    for i in xrange(8):
        bin_val = int(bool(inc_val & 1 << i + key_id * 8))
        result += bin_val << i

    return uint8(result)


def get_current_index(id_or_string, complex_item, entity = None):
    import ItemsUtils
    from Items import ItemsCatalog
    item_params = ItemsCatalog.GetItemParam(complex_item['complexItemType'])
    if ItemsCatalog.GetItemClass(complex_item['complexItemType']) != ItemsCatalog.WEAPON:
        raise TypeError('ERROR::WRONG WEAPON')
    if isinstance(id_or_string, int):
        grade_name = get_weapon_grade_name(id_or_string)
        grade_id = id_or_string
    else:
        grade_name = id_or_string
        grade_id = get_weapon_grade_id(id_or_string)
    if grade_id is None:
        raise TypeError('ERROR::WRONG GRADE ID')
    inc_params = ItemsUtils.GetComplexItemInconstanParams(complex_item, entity)
    inc_weapon_grades = uint64(inc_params.get(ItemsCatalog.INC_WEAPON_GRADES, 0))
    value_index = get_inc_param(grade_id, inc_weapon_grades)
    init_grade = 1 << grade_id & inc_params.get(ItemsCatalog.INC_WEAPON_INIT_GRADES, 0)
    grade_type = get_grage_type(grade_id)
    grades_data = item_params.get('Grade_data', {})
    tmp = grades_data.get(grade_id) or default_data[grade_id]
    if init_grade:
        return value_index
    elif grade_type == GRADE_TYPES.VALUE:
        value = item_params.get(grade_name)
        return int(round((value - tmp['min_value']) / ((float(tmp['max_value']) - tmp['min_value']) / float(tmp['count']))))
    else:
        return tmp['value_index']
        return


def get_current_param(id_or_string, complex_item, entity = None, default = None):
    import ItemsUtils
    from Items import ItemsCatalog
    item_params = ItemsCatalog.GetItemParam(complex_item['complexItemType'])
    if ItemsCatalog.GetItemClass(complex_item['complexItemType']) != ItemsCatalog.WEAPON:
        return item_params.get(id_or_string, default)
    else:
        if isinstance(id_or_string, int):
            grade_name = get_weapon_grade_name(id_or_string)
            grade_id = id_or_string
        else:
            grade_name = id_or_string
            grade_id = get_weapon_grade_id(id_or_string)
        if grade_id is None:
            return item_params.get(grade_name, default)
        inc_params = ItemsUtils.GetComplexItemInconstanParams(complex_item, entity)
        inc_weapon_grades = uint64(inc_params.get(ItemsCatalog.INC_WEAPON_GRADES, 0))
        value_index = get_inc_param(grade_id, inc_weapon_grades)
        init_grade = 1 << grade_id & inc_params.get(ItemsCatalog.INC_WEAPON_INIT_GRADES, 0)
        grade_type = get_grage_type(grade_id)
        grades_data = item_params.get('Grade_data', {})
        if not grades_data.get(grade_id):
            tmp = default_data[grade_id]
            value = init_grade and tmp['min_value'] + (tmp['max_value'] - tmp['min_value']) / float(tmp['count']) * value_index
        elif grade_type == GRADE_TYPES.VALUE:
            value = item_params.get(grade_name, default)
        else:
            value = tmp['min_value'] + (tmp['max_value'] - tmp['min_value']) / float(tmp['count']) * tmp['value_index']
        return value


def check_weapon_and_tool(weapon_item, tool_item, gold_tool):
    from Items import ItemsCatalog
    import ItemsUtils
    if not weapon_item:
        return False
    if ItemsCatalog.GetItemClass(weapon_item['complexItemType']) != ItemsCatalog.WEAPON:
        return False
    if tool_item:
        tool_params = ItemsCatalog.GetItemParam(tool_item['complexItemType'])
        if not ItemsUtils.CanRepairByKit(weapon_item, tool_item) and not tool_params.get('GradeItem', False):
            return False
        if tool_params.get('isGoldRepair', False):
            return False
    if gold_tool:
        tool_params = ItemsCatalog.GetItemParam(gold_tool['complexItemType'])
        if not ItemsUtils.CanRepairByKit(weapon_item, gold_tool) and not tool_params.get('GradeItem', False):
            return False
        if not tool_params.get('isGoldRepair', False):
            return False
    return bool(tool_item) or bool(gold_tool)


def get_grade_chance(value_index, chance_points):
    for i, point in enumerate(chance_points):
        if value_index <= point[0]:
            x1, y1 = point
            x2, y2 = chance_points[i - 1]
            k = (y1 - y2) / float(x1 - x2)
            b = y2 - k * x2
            return k * value_index + b

    return 0


def get_grade_color_result(value_index, color_params, target_params):
    color_index = -1
    sum_tmp = 0
    for index, color_count in enumerate(color_params):
        sum_tmp += color_count
        if value_index < sum_tmp:
            color_index = index
            break

    return target_params[color_index]


def get_total_grades_points(complex_item, entity = None):
    from Items import ItemsCatalog
    import ItemsUtils
    if ItemsCatalog.GetItemClass(complex_item['complexItemType']) != ItemsCatalog.WEAPON:
        return 0
    item_params = ItemsCatalog.GetItemParam(complex_item['complexItemType'])
    inc_params = ItemsUtils.GetComplexItemInconstanParams(complex_item, entity)
    grades_data = item_params.get('Grade_data', {})
    inc_weapon_grades = uint64(inc_params.get(ItemsCatalog.INC_WEAPON_GRADES, 0))
    init_mask = inc_params.get(ItemsCatalog.INC_WEAPON_INIT_GRADES, 0)
    total = 0
    for grade_id in xrange(PARAM_COUNT):
        if 1 << grade_id & init_mask:
            current_index = int(get_inc_param(grade_id, inc_weapon_grades))
            grade_name = get_weapon_grade_name(grade_id)
            grade_type = get_grage_type(grade_id)
            if not grades_data.get(grade_id):
                tmp = default_data[grade_id]
                if grade_type == GRADE_TYPES.VALUE:
                    base_index = int(round((item_params.get(grade_name) - tmp['min_value']) / ((float(tmp['max_value']) - tmp['min_value']) / float(tmp['count']))))
                else:
                    base_index = tmp['value_index']
                diff = current_index - base_index
                diff > 0 and total += diff

    return total