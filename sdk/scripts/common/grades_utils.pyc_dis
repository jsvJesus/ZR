def load_grade_relations():
    global PARAMS_RELATIONS
    path = 'scripts/common/data/grades_param_relations.pyson'
    ResMgr.purge(path, True)
    PARAMS_RELATIONS = pyson.loads(ResMgr.openSection(path).asBinary)


load_grade_relations()

def get_grage_type(id_or_string):
    param_name = id_or_string
    if isinstance(id_or_string, int):
        param_name = get_weapon_grade_name(id_or_string)
    data = {'gun_bulletSpreadGrad': GRADE_TYPES.VALUE,
     'rateOfFireSM': GRADE_TYPES.VALUE,
     'Kickback': GRADE_TYPES.MULT,
     'gun_spread_ratio': GRADE_TYPES.MULT,
     'Penetration': GRADE_TYPES.VALUE,
     'ConditionReliabilityAffection': GRADE_TYPES.MULT,
     'ScorchingReliabilityAffection': GRADE_TYPES.MULT,
     'MaxCondition': GRADE_TYPES.VALUE}
    return data[param_name]


def get_weapon_grade_name(param_id):
    data = {SPREAD_GRAD: 'gun_bulletSpreadGrad',
     RATE_OF_FIRE: 'rateOfFireSM',
     KICKBACK: 'Kickback',
     SPREAD_RATIO: 'gun_spread_ratio',
     PENETRATION: 'Penetration',
     CONDITION_RELIABILITY_AFFECTION: 'ConditionReliabilityAffection',
     SCORCHING_RELIABILITY_AFFECTION: 'ScorchingReliabilityAffection',
     CONDITION: 'MaxCondition'}
    return data.get(param_id)


def get_weapon_grade_id(param_name):
    data = {'gun_bulletSpreadGrad': SPREAD_GRAD,
     'rateOfFireSM': RATE_OF_FIRE,
     'Kickback': KICKBACK,
     'gun_spread_ratio': SPREAD_RATIO,
     'Penetration': PENETRATION,
     'ConditionReliabilityAffection': CONDITION_RELIABILITY_AFFECTION,
     'ScorchingReliabilityAffection': SCORCHING_RELIABILITY_AFFECTION,
     'MaxCondition': CONDITION}
    return data.get(param_name)


