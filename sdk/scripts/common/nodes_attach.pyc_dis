\t\t\t\tYES\t\t0.0  \t-0.0\t\t\t\t0\t\t\t\t0.014\t\t\t\t\tCYL\n\t\t155\t\tMOSIN_SUPRESSOR\t\t\t\t\t\tHP_mosin_supressor\t\t\t\t\t\tYES\t\t0.0  \t-0.0\t\t\t\t0\t\t\t\t0.01\t\t\t\t\tCYL\n\t\t156\t\tSKS_MUZZLE\t\t\t\t\t\t\tHP_sks_muzzle\t\t\t\t\t\t\tYES\t\t0.0  \t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tCYL\n\t\t157\t\tSKS_ADAPTOR\t\t\t\t\t\t\tHP_sks_adapter\t\t\t\t\t\t\tYES\t\t0.0  \t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tCYL\n\t\t158\t\tFAMAS_PICATINI_MOUNT\t\t\t\tHP_pikatini_famas\t\t\t\t\t\tYES\t\t0.0  \t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tBOX\n\t\t159\t\tGROZA_PICATINI_MOUNT\t\t\t\tHP_OC_pikatini\t\t\t\t\t\t\tYES\t\t0.0\t\t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tBOX\n\t\t160\t\tCLAMP_PO4_SCOPE\t\t\t\t\t\tHP_scope\t\t\t\t\t\t\t\tYES\t\t0.0 \t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tCYL\n\t\t161\t\tSIG552_556\t\t\t\t\t\t\tHP_sig552_556\t\t\t\t\t\t\tYES\t\t0.0 \t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tCYL\n\t\t162\t\tSPRAYER_MAG_MOUNT\t\t\t\t\tHP_ak_762\t\t\t\t\t\t\t\tYES\t\t0.0  \t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tCYL\n\t\t163\t\tZENIT_2DS_FLASHLIGHT\t\t\t\tHP_light\t\t\t\t\t\t\t\tYES\t\t0.0  \t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tCYL\n\t\t164\t\tAK_FLASHLIGHT\t\t\t\t\t\tHP_ak_mount_Light\t\t\t\t\t\tYES\t\t0.0  \t-0.0\t\t\t\t0\t\t\t\t0.008\t\t\t\t\tCYL\n\n\n\t\t'.split('\n'))
        attach_node_name = map(lambda x: x.strip(), attach_node_name)
        self._bones = {self.DEF_MAGAZINE_ID: self.DEF_MAGAZINE_BONE}
        self._nodes = {self.DEF_MAGAZINE_NAME: self.DEF_MAGAZINE_ID}
        self._nodesID2LIM = {}
        self._nodesID2Const = {self.DEF_MAGAZINE_ID: self.DEF_MAGAZINE_NAME}
        self._nodesIDshowInfo = {self.DEF_MAGAZINE_ID: True}
        self._nodesID2bbheight = {self.DEF_MAGAZINE_ID: 0.01}
        self._nodesID2drawMounrModel = {self.DEF_MAGAZINE_ID: TYPES_MOUNTS_MODEL['BOX']}
        self._nodesID2Snap = {}
        for x in attach_node_name:
            nodeID, node_const, bone, show_info, max_, min_, snap, bb_height, type_mount_m = x.split()
            nodeID = int(nodeID)
            snap = float(snap)
            show_info = show_info == 'YES'
            max_ = float(max_)
            min_ = float(min_)
            bb_height = float(bb_height)
            if nodeID in self._bones:
                raise ValueError('nodeID already exist %s' % nodeID)
            if node_const in self._nodes:
                raise ValueError('nodeName already exist %s' % node_const)
            self._bones[nodeID] = bone
            self._nodes[node_const] = nodeID
            self._nodesID2Const[nodeID] = node_const
            self._nodesID2Snap[nodeID] = snap
            self._nodesID2LIM[nodeID] = {'max': max_,
             'min': min_}
            self._nodesID2bbheight[nodeID] = bb_height
            self._nodesID2drawMounrModel[nodeID] = TYPES_MOUNTS_MODEL[type_mount_m]
            self._nodesIDshowInfo[nodeID] = show_info
            setattr(self, node_const, nodeID)

    def getNodeName(self, nodeID):
        return self._bones.get(nodeID, '<error node: %r>' % nodeID)

    def getSnap(self, nodeID):
        return self._nodesID2Snap.get(nodeID, 0)

    def getNodeLC(self, nodeID):
        node_const = self._nodesID2Const.get(nodeID)
        if not node_const:
            return u'<error node: %r>' % nodeID
        from Localization import lc
        return lc('nodesNames.%s' % node_const)


