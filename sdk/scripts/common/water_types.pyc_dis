# Embedded file name: ./common/water_types.py
import BigWorld
import ResMgr
WATERS_TYPES = {}
for type_, entry in ResMgr.openSection('system/data/water_type.xml').items():
    if type_ != 'type':
        continue
    id_ = entry['id'].asInt
    name = entry['name'].asString
    effect = entry.readInt('effect', 0)
    WATERS_TYPES[id_] = {'name': name,
     'effect': effect}

def getEffectID(waterType):
    if waterType in WATERS_TYPES:
        return WATERS_TYPES[waterType]['effect']