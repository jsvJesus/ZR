CAM_POSITION = {}
from ordereddict import OrderedDict
VERTICAL_LADDER_MATERIAL_KIND = 140
STOP_ANIMATION_ID = 0

class LADDERIDS:
    VERTIVAL_LADDER_UP_ID = 2
    VERTIVAL_LADDER_IDLE_ID = 3
    VERTIVAL_LADDER_DOWN_ID = 4
    VERTIVAL_LADDER_UP_ROOF_ID = 5
    VERTIVAL_LADDER_ENTERUP_ID = 6
    VERTIVAL_LADDER_ENTERUP_END_ID = 7


VERTICAL_LADDER_UP_OFFSET = 0.95

class ClimbAnimation(object):
    lock_camera = False

    def __init__(self, index, data):
        self.index = index
        self.name = data[0]
        self.action = data[1]
        self.pre_action = data[2]
        self.player_speed_min = data[3][0]
        self.player_speed_max = data[3][1]
        self.wall_height_min = data[4][0]
        self.wall_height_max = data[4][1]
        self.dist_to_wall_min = data[5][0]
        self.dist_to_wall_max = data[5][1]
        self.wall_depth_min = data[6][0]
        self.wall_depth_max = data[6][1]
        self.need_push_up = data[7]
        self.need_push_fw = data[8]
        self.need_push_frame = data[9]
        self.need_push_down_frame = data[10]
        self.empty_end_ground_frame = data[11]
        self.can_in_air = data[12]
        self.lock_y_camera = data[13]
        if self.need_push_down_frame:
            if len(self.need_push_down_frame) != 2:
                raise ValueError('%s - push down must be 2 number or False' % self)
            if self.need_push_down_frame[1] > -1:
                self.need_push_down_frame[1] = -1
            if self.need_push_down_frame[0] > self.need_push_down_frame[1]:
                self.need_push_down_frame[0] = self.need_push_down_frame[1]
        self.left_hand_to_anim = data[14]
        self.right_hand_to_anim = data[15]
        self.weapon_action = data[16]
        self.stamina = data[17]
        self.camera_to_head_anim = True

    def canDetachWeapon(self):
        return self.weapon_action in (LEFT_HAND, RIGHT_HAND)

    def getWeaponCommand(self):
        convert = {NOTHING: 'Track',
         LEFT_HAND: 'Left',
         RIGHT_HAND: 'Right',
         TO_BORED: 'Belly'}
        return convert[self.weapon_action]

    def check(self, player_speed, adv_forward, geom_height, free_space, geom_depth, pl_in_air):
        if self.player_speed_min > player_speed or player_speed > self.player_speed_max:
            return False
        if self.dist_to_wall_min > adv_forward or adv_forward > self.dist_to_wall_max:
            return False
        if self.wall_height_min > geom_height or geom_height > self.wall_height_max:
            return False
        if self.wall_depth_min > geom_depth or geom_depth > self.wall_depth_max:
            return False
        if pl_in_air and not self.can_in_air:
            return False
        return True

    def __repr__(self):
        return "<{0}:{1} {2}'{3}'>".format(self.__class__.__name__, self.name, self.index, self.action)

    def __str__(self):
        return repr(self)

    def getCameraSettings(self):
        if self.name in CAM_POSITION:
            return CAM_POSITION[self.name]


class LadderAnimation(ClimbAnimation):

    def __init__(self, index, action, name = ''):
        self.index = index
        self.action = action
        self.name = name
        self.isLadder = True
        self.left_hand_to_anim = True
        self.right_hand_to_anim = True
        self.weapon_action = TO_BORED
        self.camera_to_head_anim = False
        self.stamina = 0

    def check(self, *e):
        return False


class ClimbAnimationDict(OrderedDict):
    _MAX_SEARCH_FORWARD = 0
    _MAX_SEARCH_GEOMETRY_HEIGHT = 0
    _MAX_GEOMETRY = 0
    LADDERS = []

    def create(self):
        self.LADDERS[:] = [LadderAnimation(LADDERIDS.VERTIVAL_LADDER_UP_ID, 'ladder_up_test', 'l:up'),
         LadderAnimation(LADDERIDS.VERTIVAL_LADDER_IDLE_ID, 'ladder_idle_test', 'l:idle'),
         LadderAnimation(LADDERIDS.VERTIVAL_LADDER_DOWN_ID, 'ladder_down_test', 'l:down'),
         LadderAnimation(LADDERIDS.VERTIVAL_LADDER_UP_ROOF_ID, 'up_roof_test', 'l:uproof'),
         LadderAnimation(LADDERIDS.VERTIVAL_LADDER_ENTERUP_ID, 'climb_ladder_enterup', 'l:enterup'),
         LadderAnimation(LADDERIDS.VERTIVAL_LADDER_ENTERUP_END_ID, 'climb_ladder_enterup_end_loop', 'l:enterupend')]
        for anim in self.LADDERS:
            self[anim.index] = anim

        for index, data in enumerate(_climb_animations, 30):
            if index in self:
                raise KeyError('index:%s %s %s' % (index, data, self[index]))
            anim = ClimbAnimation(index, data)
            self[index] = anim
            if anim.dist_to_wall_max > self._MAX_SEARCH_FORWARD:
                self._MAX_SEARCH_FORWARD = anim.dist_to_wall_max
            if anim.wall_height_max > self._MAX_SEARCH_GEOMETRY_HEIGHT:
                self._MAX_SEARCH_GEOMETRY_HEIGHT = anim.wall_height_max

        self._MAX_SEARCH_GEOMETRY_HEIGHT += 0.1
        self._MAX_SEARCH_GEOMETRY_HEIGHT = min(self._MAX_SEARCH_GEOMETRY_HEIGHT, 10.0)
        raise self._MAX_SEARCH_FORWARD < INF or AssertionError


ANIMS = ClimbAnimationDict()
ANIMS.create()