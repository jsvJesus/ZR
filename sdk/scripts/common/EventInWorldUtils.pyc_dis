# Embedded file name: ./common/EventInWorldUtils.py
import json
import ResMgr
import traceback
import BigWorld
EVENT_DATA_PATH = 'scripts/common/data/events_data.json'
EVENT_MUSIC_PATH = 'scripts/client/data/mae_data.json'
events_data = None
events_names = []
sounds_data = {}

def load_events_data():
    global events_data
    global events_names
    try:
        if events_data:
            return
        py_data_section = ResMgr.openSection(EVENT_DATA_PATH)
        events_data = json.loads(py_data_section.asBinary, encoding='utf-8')
        events_names = events_data.keys()
        events_names.sort()
    except:
        print 'error file:', repr(EVENT_DATA_PATH)

    return events_data


def load_sounds_data():
    global sounds_data
    try:
        if sounds_data:
            return
        py_data_section = ResMgr.openSection(EVENT_MUSIC_PATH)
        sounds_data = json.loads(py_data_section.asBinary, encoding='utf-8')
    except:
        print 'error file:', repr(EVENT_MUSIC_PATH)

    return sounds_data


load_events_data()
if BigWorld.component == 'client':
    load_sounds_data()

def get_event_name_by_id(event_id):
    if not events_data:
        load_events_data()
    return events_names[event_id]


def get_event_id_by_name(event_name):
    if not events_data:
        load_events_data()
    return events_names.index(event_name)


def get_event_sound(event_id, tag):
    event_name = get_event_name_by_id(event_id)
    sounds = sounds_data.get(event_name, {})
    sound_name = sounds.get(tag)
    if sound_name is None:
        return sounds_data.get('default').get(tag)
    else:
        return sound_name


def get_start_message(event_id):
    return get_event_sound(event_id, 'msg_start')


def get_start_sound(event_id):
    return get_event_sound(event_id, 'sound_start')


def get_phase_message(event_id, phase):
    from Localization import lc
    tag = 'msg_phase_{0}'.format(phase)
    message = get_event_sound(event_id, tag)
    if message:
        return lc(message)
    return lc('GUI.QuestLog.Events.Phase').format(phase)


def get_win_message(event_id):
    return get_event_sound(event_id, 'msg_win')


def get_fail_message(event_id):
    return get_event_sound(event_id, 'msg_fail')


def get_phase_sound(event_id, phase):
    tag = 'sound_phase_{0}'.format(phase)
    return get_event_sound(event_id, tag)


def get_events_data(event_name):
    if not events_data:
        load_events_data()
    return events_data[event_name]


def get_event_id(event_name):
    if not events_data:
        load_events_data()
    return events_data[event_name]['id']


def get_event_name(event_id):
    if not events_data:
        load_events_data()
    for event_name, event_data in events_data.items():
        if event_data['id'] == event_id:
            return event_name

    return None


def get_reward(event_name, rank):
    data = get_events_data(event_name)
    if not data:
        return None
    else:
        if not data.has_key('reward'):
            traceback.print_stack()
            print 'EVENT REWARD ERROR::', data.keys()
        if rank <= 3:
            reward = data['reward'].get(str(rank))
        elif rank <= 10:
            reward = data['reward'].get('4-10')
        else:
            reward = data['reward'].get('other')
        return (reward, data['reward'].get('bank', u''), data['reward'].get('sender', u''))


def get_reward_icon(rank):
    if rank == '1':
        return 'soGUI/maps/Icons/blackboxes/crate_asvss_magazine.dds'
    elif rank == '2':
        return 'soGUI/maps/Icons/blackboxes/bag_bandit2.dds'
    elif rank == '3':
        return 'soGUI/maps/Icons/blackboxes/icon_250.dds'
    elif rank == '4-10':
        return 'soGUI/maps/Icons/blackboxes/icon_ammo_20.dds'
    elif rank == 'other':
        return 'soGUI/maps/Icons/blackboxes/bag_ugly.dds'
    else:
        return ''