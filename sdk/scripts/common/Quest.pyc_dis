def get_string_quest_type(quest):
    q_type = quest['Target']['QuestType']
    str_types = {TYPE_FARM: 'TYPE_FARM',
     TYPE_FARM_AUTO: 'TYPE_FARM_AUTO',
     TYPE_TALK: 'TYPE_TALK',
     TYPE_KILLMOBS_WITH_ONTEST: 'TYPE_KILLMOBS_WITH_ONTEST',
     TYPE_KILLMOBS: 'TYPE_KILLMOBS',
     TYPE_AREA_DISCOVER: 'TYPE_AREA_DISCOVER',
     TYPE_MONEYBACK: 'TYPE_MONEYBACK',
     TYPE_TRIGGER_ACTION: 'TYPE_TRIGGER_ACTION',
     TYPE_QITEM_USE: 'TYPE_QITEM_USE',
     TYPE_AREA_LEAVE: 'TYPE_AREA_LEAVE',
     TYPE_TIMER: 'TYPE_TIMER',
     TYPE_DIE: 'TYPE_DIE',
     TYPE_ITEM_EQIP: 'TYPE_ITEM_EQIP',
     TYPE_GIVE_EFFECT: 'TYPE_GIVE_EFFECT',
     TYPE_REPUTATION: 'TYPE_REPUTATION',
     TYPE_REPUTATION_AUTO: 'TYPE_REPUTATION_AUTO'}
    return str_types.get(q_type, 'UNCK_TYPE:%s' % q_type)


def quest_priority_to_color(priority):
    if priority == 0:
        return (175, 166, 112, 255)
    if priority == 1:
        return (190, 177, 107, 255)
    if priority == 2:
        return (200, 180, 100, 255)
    if priority == 3:
        return (211, 187, 89, 255)
    if priority == 4:
        return (226, 197, 79, 255)
    if priority == 5:
        return (255, 153, 51, 255)


