class CTQ:
    """
    ERROR_BOARD1 - \xd0\xb4\xd0\xbe\xd1\x81\xd0\xba\xd0\xb0 \xd0\xbd\xd0\xb5 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xb5\xd1\x82 \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82
    ERROR_BOARD2 - \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba \xd1\x83\xd0\xb6\xd0\xb5 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xb5\xd1\x82 \xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbd \xd0\xb4\xd0\xbe\xd1\x81\xd0\xbe\xd1\x87\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82
    ERROR_BOARD3 - \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba \xd0\xb4\xd0\xbe\xd1\x81\xd0\xba\xd0\xbe\xd0\xb9 \xd0\xb7\xd0\xb0\xd0\xb1\xd0\xbb\xd0\xbe\xd0\xba\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd
    """
    OK, ERROR_NOQUEST, ERROR_BADSTATE, ERROR_SUBQUEST, ERROR_PROHIBITED, ERROR_TIMEPOS, ERROR_BOARD1, ERROR_BOARD2, CHAPTER_CLOSE, ERROR_BOARD3, ERROR_AUTOFAILER = xrange(11)

    @staticmethod
    def get_error_message(error_code):
        if error_code == CTQ.ERROR_TIMEPOS:
            return lc('Quests.Board.ERROR_TIMEPOS')
        elif error_code == CTQ.ERROR_BADSTATE:
            return lc('Quests.Board.ERROR_BADSTATE')
        elif error_code == CTQ.ERROR_BOARD1:
            return lc('Quests.Board.ERROR_BOARD1')
        elif error_code == CTQ.ERROR_BOARD2:
            return lc('Quests.Board.ERROR_BOARD2')
        elif error_code == CTQ.ERROR_BOARD3:
            return lc('Quests.Board.ERROR_BOARD3')
        else:
            return lc('Quests.Board.DEFAULT_ERROR')


