def pack_quest_type(opened, closed, failed):
    res = 0
    if opened:
        res += 4
    if closed:
        res += 2
    if failed:
        res += 1
    return res


def unpack_quest_type(value):
    """ open, closed, failed """
    return (bool(value & 4), bool(value & 2), bool(value & 1))


class SortMode:
    TitleUp, TitleDown, TimeUp, TimeDown = xrange(4)


def pack_double_count(kills, deaths):
    """ \xd0\xb7\xd0\xb4\xd0\xb5\xd1\x81\xd1\x8c \xd0\xb4\xd0\xb2\xd0\xb0 int16 \xd1\x83\xd0\xbf\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x8e\xd1\x82\xd1\x81\xd1\x8f \xd0\xb2 int32 """
    return deaths << 16 | kills


def unpack_double_count(packed):
    """ \xd0\xb7\xd0\xb4\xd0\xb5\xd1\x81\xd1\x8c \xd0\xb4\xd0\xb2\xd0\xb0 int16 \xd1\x80\xd0\xb0\xd1\x81\xd0\xbf\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x8e\xd1\x82\xd1\x81\xd1\x8f \xd0\xb8\xd0\xb7 int32 """
    return (packed & 65535, packed >> 16)