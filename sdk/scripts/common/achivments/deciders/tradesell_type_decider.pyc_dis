# Embedded file name: ./common/achivments/deciders/tradesell_type_decider.py
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, money):
    common_decider.decide(user, _trade_ach_ids, get_col_name, lambda ach_id: True, 0, incremenation=money)


def filter_send_to_base(achmask):
    for ach_id in _trade_ach_ids:
        if not achives_parser.get_bitvalue(ach_id, achmask):
            return True

    return False


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.TraderSell or AssertionError
    return ('ess' + str(essence['id']), essence['id'])


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_trade_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.TraderSell) ]