# Embedded file name: ./common/achivments/deciders/simple_decider.py
import common_decider
from collections import defaultdict
from achivments import achives_parser
from achivments.deciders import simple_validators
from achivments.deciders import simple_colnames
ET = achives_parser.EssenceTypes
_essence_parameters = {ET.AnomalyStone: {'counter_index': None,
                   'validator': simple_validators.check_anomalystone,
                   'colname': simple_colnames.no_column},
 ET.FireSit: {'counter_index': None,
              'validator': simple_validators.check_firesit,
              'colname': simple_colnames.no_column},
 ET.FireFeed: {'counter_index': None,
               'validator': simple_validators.check_firefeed,
               'colname': simple_colnames.no_column},
 ET.Paint: {'counter_index': None,
            'validator': simple_validators.check_simple,
            'colname': simple_colnames.no_column},
 ET.AnomalyLast: {'counter_index': None,
                  'validator': simple_validators.check_anomaly,
                  'colname': simple_colnames.no_column},
 ET.Dialog: {'counter_index': None,
             'validator': simple_validators.check_dialog,
             'colname': simple_colnames.no_column},
 ET.Disassemble: {'counter_index': 0,
                  'validator': simple_validators.check_simple,
                  'colname': simple_colnames.simple_column},
 ET.Transform: {'counter_index': None,
                'validator': simple_validators.check_transform,
                'colname': simple_colnames.no_column},
 ET.KilledByMob: {'counter_index': None,
                  'validator': simple_validators.check_killedbymob,
                  'colname': simple_colnames.no_column},
 ET.NpcAterdeath: {'counter_index': None,
                   'validator': simple_validators.check_simple,
                   'colname': simple_colnames.no_column},
 ET.Magazine: {'counter_index': 0,
               'validator': simple_validators.check_simple,
               'colname': simple_colnames.simple_column},
 ET.Suicide: {'counter_index': None,
              'validator': simple_validators.check_suicide,
              'colname': simple_colnames.no_column},
 ET.Event: {'counter_index': 2,
            'validator': simple_validators.check_event,
            'colname': simple_colnames.event_column},
 ET.KilledByAnomaly: {'counter_index': None,
                      'validator': simple_validators.check_simple,
                      'colname': simple_colnames.no_column},
 ET.KilledByAvatar: {'counter_index': 1,
                     'validator': simple_validators.check_killedbyavatar,
                     'colname': simple_colnames.killedbyavatar_column}}
_all_essence_types = set()
for ess_id, ess_data in _essence_parameters.items():
    raise ess_id not in _all_essence_types or AssertionError
    _all_essence_types.add(ess_id)

def decide(user, essence_type, *args):
    raise essence_type in _all_essence_types or AssertionError
    counter_index = _essence_parameters[essence_type]['counter_index']

    def validate_ach(ach_id):
        validator = _essence_parameters[essence_type]['validator']
        return validator(ach_id, *args)

    common_decider.decide(user, esid_to_achids[essence_type], get_col_name, validate_ach, counter_index)


def filter_send_to_base(achmask, essence_type, *args):
    raise essence_type in _all_essence_types or AssertionError
    for ach_id in esid_to_achids[essence_type]:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _essence_parameters[essence_type]['validator'](ach_id, *args):
            return True

    return False


def filter_send_to_base_from_client(ach_ids, essence_type, *args):
    raise essence_type in _all_essence_types or AssertionError
    for ach_id in esid_to_achids[essence_type]:
        if ach_id in ach_ids:
            continue
        if _essence_parameters[essence_type]['validator'](ach_id, *args):
            return True

    return False


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    ess_id = essence['id']
    return (_essence_parameters[ess_id]['colname'](ach_id), essence['id'])


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


esid_to_achids = defaultdict(list)
for ach_id in achives_parser.get_all_achiv_ids():
    ach = achives_parser.get_achiv(ach_id)
    ess_id = ach.get('essence', {}).get('id')
    if ess_id in _all_essence_types:
        esid_to_achids[ess_id].append(ach_id)