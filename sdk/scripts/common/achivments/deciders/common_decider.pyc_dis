# Embedded file name: ./common/achivments/deciders/common_decider.py
from achivments import achives_parser, SqlUtils
from collections import defaultdict
from functools import partial

def decide(user, ach_ids, get_col_name, validate_ach, counter_index, incremenation = 1):
    combined_achs = defaultdict(list)
    for ach_id in ach_ids:
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        col_name = get_col_name(ach_id)
        if validate_ach(ach_id):
            if col_name is None:
                user.complete_achivement(ach_id)
            else:
                combined_achs[col_name].append(ach_id)

    for col_name, ach_ids in combined_achs.iteritems():

        def on_increment(_ach_ids, value):
            for ach_id in _ach_ids:
                amount = achives_parser.get_achiv(ach_id)['essence']['params'][counter_index]
                if value >= amount:
                    user.complete_achivement(ach_id)
                else:
                    user.on_ach_value_changed(ach_id, value)

        SqlUtils.increment_and_get_value(user.databaseID, col_name, partial(on_increment, ach_ids), incremenation=incremenation)

    return