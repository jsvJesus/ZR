# Embedded file name: ./common/achivments/deciders/playtime_type_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user):
    min_remain_time = None
    for ach_id in _playtime_achs_ids:
        remain_time = _decide_ach(user, ach_id)
        if remain_time is not None:
            if min_remain_time is None or remain_time < min_remain_time:
                min_remain_time = remain_time

    if remain_time is not None and remain_time < 86400:
        user.call_once(user.check_time_played, remain_time + 5)
    return


def _decide_ach(user, ach_id):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 remain_time \xd0\xb8\xd0\xbb\xd0\xb8 None """
    if achives_parser.get_bitvalue(ach_id, user.achs):
        return None
    needed_time = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    needed_time *= 3600
    cur_time = user.parentAccount.getAccountPlayTime()
    if cur_time >= needed_time:
        user.complete_achivement(ach_id)
        return None
    else:
        return needed_time - cur_time


def get_ach_value(user, ach_id):
    return int(user.parentAccount.getAccountPlayTime() / 3600.0)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.PlayTime or AssertionError
    return None


_playtime_achs_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.PlayTime) ]