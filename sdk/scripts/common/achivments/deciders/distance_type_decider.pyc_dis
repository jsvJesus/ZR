# Embedded file name: ./common/achivments/deciders/distance_type_decider.py
import BigWorld
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes
if BigWorld.component == 'client':
    from Math import Vector3

    class DistanceCounter(object):
        """ \xd0\xa2\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0
        """

        def __init__(self):
            self._controller_id = None
            self.reset()
            return

        def destroy(self):
            if self._controller_id:
                BigWorld.cancelCallback(self._controller_id)
                self._controller_id = None
            return

        def reset(self):
            if not self._is_user_valid():
                self.destroy()
                return
            self._accumulator = 0.0
            self._prev_position = Vector3(self._user.position)
            if self._controller_id:
                BigWorld.cancelCallback(self._controller_id)
            self._controller_id = BigWorld.callback(5.0, self._tick)

        def _tick(self):
            if not self._is_user_valid():
                self._controller_id = None
                self.destroy()
                return
            else:
                accumulation = self._user.position.flatDistTo(self._prev_position)
                if accumulation > 50:
                    accumulation = 0.0
                self._prev_position = Vector3(self._user.position)
                self._controller_id = BigWorld.callback(5.0, self._tick)
                self._accumulator += accumulation
                if self._accumulator > 10.0:
                    self._user.on_distance_change(int(self._accumulator))
                    self._accumulator = 0.0
                return

        @property
        def _user(self):
            return BigWorld.player()

        def _is_user_valid(self):
            return self._user.__class__.__name__ == 'PlayerAvatar' and not self._user.isDestroyed


def decide(user, distance):
    common_decider.decide(user, dist_ach_ids, get_col_name, lambda ach_id: True, 0, incremenation=distance)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Distance or AssertionError
    return 'ess' + str(ach_id)


dist_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Distance) ]