# Embedded file name: ./common/achivments/deciders/pkstatus_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, count):
    for ach_id in karma_ach_ids:
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        if _validate_ach(ach_id, count):
            user.complete_achivement(ach_id)


def filter_send_to_base(achmask, count):
    for ach_id in karma_ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, count):
            return True

    return False


def _validate_ach(ach_id, count):
    _count = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    return count >= _count


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.PKStatus or AssertionError
    return ('ess' + str(essence['id']), essence['id'])


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


karma_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.PKStatus) ]