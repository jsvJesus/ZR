# Embedded file name: ./common/achivments/deciders/barter_decider.py
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5

def decide(user, res_list, add_list):

    def validate_ach(ach_id):
        return _validate_ach(ach_id, res_list, add_list)

    common_decider.decide(user, _ach_ids, get_col_name, validate_ach, 2)


def filter_send_to_base(achmask, res_list, add_list):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, res_list, add_list):
            return True

    return False


def _validate_ach(ach_id, res_list, add_list):
    res_item, add_item, _ = achives_parser.get_achiv(ach_id)['essence']['params']
    if res_item is not None and res_item not in res_list:
        return False
    elif add_item is not None and add_item not in add_list:
        return False
    else:
        return True


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.Barter:
        raise AssertionError
        res_item, add_item, amount = essence['params']
        return amount in (0, 1, None) and (None, None)
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        if res_item is not None:
            db_sub_key += '_r' + str(res_item)
        if add_item is not None:
            db_sub_key += '_a' + str(add_item)
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return (db_key + db_sub_key, (res_item, add_item))


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Barter) ]