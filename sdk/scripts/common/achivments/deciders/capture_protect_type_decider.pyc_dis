# Embedded file name: ./common/achivments/deciders/capture_protect_type_decider.py
import BigWorld
from achivments import achives_parser
ET = achives_parser.EssenceTypes
if BigWorld.component == 'client':

    class ProtectCounter(object):

        def __init__(self, callback):
            self._start_owner = self._user.get_current_base_owner()
            self._on_base_protect_callback = callback

        def on_attack_stop(self):
            new_owner = self._user.get_current_base_owner()
            user_clan_name = self._user.clanName
            if self._start_owner == new_owner and new_owner == user_clan_name and self._on_base_protect_callback:
                self._on_base_protect_callback()

        def destroy(self):
            self._on_base_protect_callback = None
            return

        @property
        def _user(self):
            return BigWorld.player()


    def filter_send_to_basapp(ach_ids):
        for ach_id in protect_ach_ids:
            if ach_id not in ach_ids:
                return True

        return False


def decide(user):
    for ach_id in protect_ach_ids:
        if not achives_parser.get_bitvalue(ach_id, user.achs):
            user.complete_achivement(ach_id)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.CaptureProtect or AssertionError
    return None


protect_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.CaptureProtect) ]