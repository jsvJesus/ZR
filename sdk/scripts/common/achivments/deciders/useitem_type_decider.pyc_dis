# Embedded file name: ./common/achivments/deciders/useitem_type_decider.py
import common_decider
from collections import defaultdict
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5
from itertools import chain

def filter_send_to_basapp(item_type, achmask):
    none_achs = _itemtype_to_achivs.get(None, [])
    type_achs = _itemtype_to_achivs.get(item_type, [])
    if not none_achs and not type_achs:
        return False
    else:
        for ach_id in chain(none_achs, type_achs):
            if not achives_parser.get_bitvalue(ach_id, achmask):
                break
        else:
            return False

        return True


def decide(user, item_type):

    def validate_ach(ach_id):
        item_types = achives_parser.get_achiv(ach_id)['essence']['params'][0]
        if item_types is not None and item_type not in item_types:
            return False
        else:
            return True

    ach_ids = chain(_itemtype_to_achivs.get(None, []), _itemtype_to_achivs.get(item_type, []))
    common_decider.decide(user, ach_ids, get_col_name, validate_ach, 1)
    return


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.UseItem:
        raise AssertionError
        item_types, amount = essence['params']
        return amount in (0, None, 1) and (None, None)
    else:
        if item_types is None:
            item_types = []
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        for item_type in item_types:
            db_sub_key += '_' + str(item_type)

        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return (db_key + db_sub_key, item_types)


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_itemtype_to_achivs = defaultdict(list)
for ach in achives_parser.filter_achs_by_essence(ET.UseItem):
    item_types = ach['essence']['params'][0]
    if item_types is None:
        _itemtype_to_achivs[None].append(ach['id'])
    else:
        for item_type in item_types:
            _itemtype_to_achivs[item_type].append(ach['id'])