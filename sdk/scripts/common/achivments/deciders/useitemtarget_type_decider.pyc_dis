# Embedded file name: ./common/achivments/deciders/useitemtarget_type_decider.py
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5

def decide(user, item_type, is_dead):

    def validate_ach(ach_id):
        return _validate_ach(ach_id, item_type, is_dead)

    common_decider.decide(user, _ach_ids, get_col_name, validate_ach, 1)


def filter_send_to_base(achmask, item_type, is_dead):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, item_type, is_dead):
            return True

    return False


def _validate_ach(ach_id, item_type, is_dead):
    _item_type_s, _, _is_dead = achives_parser.get_achiv(ach_id)['essence']['params']
    if item_type is not None and item_type not in _ach_id_to_set_cache[ach_id]:
        return False
    elif _is_dead is not None and bool(_is_dead) != bool(is_dead):
        return False
    else:
        return True


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.UseItemTarget:
        raise AssertionError
        item_types, amount, is_dead = essence['params']
        return amount in (0, None, 1) and (None, None)
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        if item_types is not None:
            db_sub_key += '_' + str(hash(item_types))
        if is_dead is not None:
            db_sub_key += '_d' + str(int(is_dead))
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return (db_key + db_sub_key, (item_types, is_dead))


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_ach_id_to_set_cache = {}
_ach_ids = []
for ach in achives_parser.filter_achs_by_essence(ET.UseItemTarget):
    item_types = ach['essence']['params'][0]
    _ach_id_to_set_cache[ach['id']] = set(item_types)
    _ach_ids.append(ach['id'])