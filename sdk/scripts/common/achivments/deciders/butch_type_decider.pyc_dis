# Embedded file name: ./common/achivments/deciders/butch_type_decider.py
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, mob_type):

    def validate_ach(ach_id):
        return _validate_ach(ach_id, mob_type)

    common_decider.decide(user, _ach_ids, get_col_name, validate_ach, 1)


def filter_send_to_base(achmask, mob_type):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, mob_type):
            return True

    return False


def _validate_ach(ach_id, mob_type):
    _mob_type = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    if _mob_type is not None and _mob_type != mob_type:
        return False
    else:
        return True


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.Butch:
        raise AssertionError
        mob_type, amount = essence['params']
        return amount in (0, 1, None) and (None, None)
    else:
        db_key = 'ess' + str(essence['id'])
        if mob_type is not None:
            db_key += '_' + str(mob_type)
        return (db_key, (mob_type,))


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Butch) ]