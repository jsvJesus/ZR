# Embedded file name: ./common/achivments/deciders/area_decider.py
import BigWorld
from achivments import achives_parser, SqlUtils
ET = achives_parser.EssenceTypes
from functools import partial
if BigWorld.component == 'client':

    class AreaCounter(object):

        def __init__(self):
            self._values = {}
            self._user.add_ach_listener(self)

        def on_trigger_visited(self, trigger_name):
            notify_server = False
            for ach_id in area_ach_ids:
                if ach_id in self._user.achiv_ids:
                    continue
                space_names = achives_parser.get_achiv(ach_id)['essence']['params'][0]
                if trigger_name not in space_names:
                    continue
                if len(space_names) == 1:
                    notify_server = True
                    continue
                if ach_id not in self._values:
                    self._values[ach_id] = None
                    notify_server = True
                    continue
                value = self._values[ach_id]
                if value is None:
                    continue
                index = space_names.index(trigger_name)
                if value & 1 << index:
                    continue
                notify_server = True

            if notify_server:
                self._user.base.on_ach_area_visited(trigger_name)
            return

        def on_achivs_event(self, event_type, data):
            from AchUser import EventType as AET
            if event_type == AET.GotAchValue:
                ach_data = data
                if ach_data['ach_id'] in self._values:
                    self._values[ach_data['ach_id']] = ach_data['value']
            elif event_type == AET.AchmaskUpdated:
                for ach_id in self._values.keys():
                    if ach_id not in self._user.achiv_ids:
                        del self._values[ach_id]

        def destroy(self):
            self._user.remove_ach_listener(self)

        @property
        def _user(self):
            return BigWorld.player()


def decide(user, area_name):
    for ach_id in area_ach_ids:
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        area_names = achives_parser.get_achiv(ach_id)['essence']['params'][0]
        if area_name not in area_names:
            continue
        if len(area_names) == 1:
            user.complete_achivement(ach_id)
            continue
        col_name = get_col_name(ach_id)
        index = area_names.index(area_name)
        raise col_name or AssertionError

        def on_mark(_ach_id, value):
            bit_len = len(achives_parser.get_achiv(_ach_id)['essence']['params'][0])
            if value == (1 << bit_len) - 1:
                user.complete_achivement(ach_id)
            else:
                user.on_ach_value_changed(_ach_id, value)

        SqlUtils.mark_bit_and_get_value(user.databaseID, col_name, partial(on_mark, ach_id), index)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.Area:
        raise AssertionError
        area_names = essence['params'][0]
        return len(area_names) <= 1 and None
    else:
        return 'ach' + str(ach_id)


area_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Area) ]