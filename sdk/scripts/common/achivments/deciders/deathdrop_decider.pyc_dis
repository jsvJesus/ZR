# Embedded file name: ./common/achivments/deciders/deathdrop_decider.py
import ItemCategories
from Items import ItemsCatalog
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, item_types):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        if _validate_ach(ach_id, item_types):
            user.complete_achivement(ach_id)


def filter_send_to_base(achmask, item_types):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, item_types):
            return True

    return False


def _validate_ach(ach_id, item_types):
    cat_id = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    for item_type in item_types:
        _cat_id = ItemsCatalog.GetItemCategory(item_type)
        if ItemCategories.is_subcategory(_cat_id, cat_id):
            return True

    return False


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.DeathDrop or AssertionError
    return None


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.DeathDrop) ]