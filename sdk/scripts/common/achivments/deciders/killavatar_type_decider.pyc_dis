# Embedded file name: ./common/achivments/deciders/killavatar_type_decider.py
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5

def decide(user, *args):

    def validate_ach(ach_id):
        return _validate_ach(ach_id, *args)

    common_decider.decide(user, _ach_ids, get_col_name, validate_ach, 4)


def _validate_ach(ach_id, weapon_item_type, is_grenade_launcher, is_grenade, distance, is_pvp, is_capture, is_pk, from_scope, from_silincer, headshot, has_helmet, pvp_arena, aly_capture):
    essence_params = achives_parser.get_achiv(ach_id)['essence']['params']
    _weapon_types, _is_grenade_launcher, _is_grenade, _distance, _, _is_pvp, _is_capture, _is_pk, _from_scope, _from_silencer, _headshot, _has_helmet, _pvp_arena, _aly_capture = essence_params
    if _weapon_types is not None and weapon_item_type not in _weapon_types:
        return False
    elif _is_grenade_launcher is not None and is_grenade_launcher != _is_grenade_launcher:
        return False
    elif _is_grenade is not None and is_grenade != _is_grenade:
        return False
    elif _distance is not None and distance < _distance:
        return False
    elif _is_pvp is not None and is_pvp != _is_pvp:
        return False
    elif _is_capture is not None and is_capture != _is_capture:
        return False
    elif _is_pk is not None and is_pk != _is_pk:
        return False
    elif _from_scope is not None and from_scope != _from_scope:
        return False
    elif _from_silencer is not None and from_silincer != _from_silencer:
        return False
    elif _headshot is not None and headshot != _headshot:
        return False
    elif _has_helmet is not None and has_helmet != _has_helmet:
        return False
    elif _pvp_arena is not None and pvp_arena != _pvp_arena:
        return False
    elif _aly_capture is not None and aly_capture != _aly_capture:
        return False
    else:
        return True


def filter_send_to_base(achmask, *args):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, *args):
            return True

    return False


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.KillAvatar:
        raise AssertionError
        weapon_types, is_grenade_launcher, is_grenade, distance, amount, is_pvp, is_capture, is_pk, from_scope, from_silencer, headshot, has_helmet, pvp_arena, aly_capture = essence['params']
        return amount in (None, 0, 1) and (None, None)
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        if weapon_types is not None:
            for wt in weapon_types:
                db_sub_key += '_w' + str(wt)

        if is_grenade_launcher is not None:
            db_sub_key += '_gl' + str(int(is_grenade_launcher))
        if is_grenade is not None:
            db_sub_key += '_g' + str(int(is_grenade))
        if distance is not None:
            distance = round(distance, 3)
            db_sub_key += '_d' + str(distance)
        if is_pvp is not None:
            db_sub_key += '_pvp' + str(int(is_pvp))
        if is_capture is not None:
            db_sub_key += '_c' + str(int(is_capture))
        if is_pk is not None:
            db_sub_key += '_pk' + str(int(is_pk))
        if from_scope is not None:
            db_sub_key += '_fsc' + str(int(from_scope))
        if from_silencer is not None:
            db_sub_key += '_fsi' + str(int(from_silencer))
        if headshot is not None:
            db_sub_key += '_hs' + str(int(headshot))
        if has_helmet is not None:
            db_sub_key += '_hh' + str(int(headshot))
        if pvp_arena is not None:
            db_sub_key += '_pa' + str(int(pvp_arena))
        if aly_capture is not None:
            db_sub_key += '_ac' + str(int(aly_capture))
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return (db_key + db_sub_key, (is_grenade_launcher,
          is_grenade,
          distance,
          is_pvp,
          is_capture,
          is_pk,
          from_scope,
          from_silencer,
          headshot,
          pvp_arena,
          aly_capture))


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.KillAvatar) ]