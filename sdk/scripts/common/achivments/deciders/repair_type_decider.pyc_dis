# Embedded file name: ./common/achivments/deciders/repair_type_decider.py
import ItemCategories
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5
from Items import ItemsCatalog
import common_decider

def decide(user, item_type):

    def validate_ach(ach_id):
        return _validate_ach(ach_id, item_type)

    common_decider.decide(user, _ach_ids, get_col_name, validate_ach, 1)


def filter_send_to_base(achmask, item_type):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, item_type):
            return True

    return False


def _validate_ach(ach_id, item_type):
    _cat_ids = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    if _cat_ids is not None:
        cat_id = ItemsCatalog.GetItemCategory(item_type)
        for needed_cat_id in _cat_ids:
            if ItemCategories.is_subcategory(cat_id, needed_cat_id):
                break
        else:
            return False

    return True


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.Repair:
        raise AssertionError
        cat_ids, amount = essence['params']
        return amount in (0, 1, None) and (None, None)
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        if cat_ids is not None:
            db_sub_key += '_' + '_'.join(map(str, cat_ids))
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return (db_key + db_sub_key, cat_ids)


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Repair) ]