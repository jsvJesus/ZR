# Embedded file name: ./common/achivments/deciders/art_set_decider.py
from itertools import chain
from collections import defaultdict
from functools import partial
from achivments import achives_parser, SqlUtils
ET = achives_parser.EssenceTypes
from hashlib import md5

def decide(user, art_type, art_condition):
    for ach_id in chain(_art_type_to_achids.get(None, []), _art_type_to_achids.get(art_type, [])):
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        quality, art_types = achives_parser.get_achiv(ach_id)['essence']['params']
        if art_types and art_type not in art_types:
            continue
        if art_condition * 100.0 < quality:
            continue
        if len(art_types) <= 1:
            user.complete_achivement(ach_id)
            continue
        col_name = get_col_name(ach_id)
        index = art_types.index(art_type)
        raise col_name or AssertionError

        def on_mark(_ach_id, value):
            bit_len = len(achives_parser.get_achiv(_ach_id)['essence']['params'][1])
            if value == (1 << bit_len) - 1:
                user.complete_achivement(_ach_id)
            else:
                user.on_ach_value_changed(_ach_id, value)

        SqlUtils.mark_bit_and_get_value(user.databaseID, col_name, partial(on_mark, ach_id), index)

    return


def override_column_data():
    return {'type': 'BIGINT'}


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.AnomalyArt_Set:
        raise AssertionError
        quality, art_types = essence['params']
        return len(art_types) <= 1 and None
    else:
        if not len(art_types) <= 63:
            raise AssertionError
            db_key = 'ess' + str(essence['id'])
            db_sub_key = '_' + str(quality and int(quality) or None)
            for art_type in art_types:
                db_sub_key += ':' + str(art_type)

            db_sub_key = len(db_sub_key) > 10 and md5(db_sub_key).hexdigest()[:9]
        return db_key + db_sub_key


_art_type_to_achids = defaultdict(list)
for ach in achives_parser.filter_achs_by_essence(ET.AnomalyArt_Set):
    art_types = ach['essence']['params'][1]
    if art_types is None:
        _art_type_to_achids[None].append(ach['id'])
    else:
        for art_type in art_types:
            _art_type_to_achids[art_type].append(ach['id'])