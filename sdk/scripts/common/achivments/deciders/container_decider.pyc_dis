# Embedded file name: ./common/achivments/deciders/container_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, container_name):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        if _validate_ach(ach_id, container_name):
            user.complete_achivement(ach_id)


def filter_send_to_base(achmask, container_name):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, container_name):
            return True

    return False


def _validate_ach(ach_id, container_name):
    _cont_names = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    return container_name in _cont_names


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Container or AssertionError
    return None


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Container) ]