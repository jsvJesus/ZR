# Embedded file name: ./common/achivments/deciders/massquest_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, massquest_id):
    for ach_id in _ach_ids:
        if not achives_parser.get_bitvalue(ach_id, user.achs):
            _massquest_id = achives_parser.get_achiv(ach_id)['essence']['params'][0]
            if massquest_id == _massquest_id:
                user.complete_achivement(ach_id)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.MassQuest or AssertionError
    return None


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.MassQuest) ]