# Embedded file name: ./common/achivments/deciders/equip_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, cat_id):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        if _validate_ach(ach_id, cat_id):
            user.complete_achivement(ach_id)


def filter_send_to_base(achmask, cat_id):
    for ach_id in _ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, cat_id):
            return True

    return False


def _validate_ach(ach_id, cat_id):
    _cat_id = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    return _cat_id == cat_id


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Equip or AssertionError
    return None


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Equip) ]