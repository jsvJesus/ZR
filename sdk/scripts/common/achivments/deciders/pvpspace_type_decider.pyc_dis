# Embedded file name: ./common/achivments/deciders/pvpspace_type_decider.py
import common_decider
from achivments import achives_parser
from hashlib import md5
ET = achives_parser.EssenceTypes
import csconstans

def decide(user, game_type, command, place):

    def validate_ach(ach_id):
        needed_game_type, _, needed_command, needed_place = achives_parser.get_achiv(ach_id)['essence']['params']
        if needed_game_type is not None and needed_game_type != game_type:
            return False
        else:
            if needed_command not in (None, csconstans.TEAM_ANY):
                if needed_command != command:
                    return False
            if needed_place is not None and needed_place != place:
                return False
            return True

    common_decider.decide(user, _pvp_achs_ids, get_col_name, validate_ach, 1)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.PvpSpace:
        raise AssertionError
        game_type, amount, command, place = essence['params']
        return amount in (None, 0, 1) and None
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        if game_type is not None:
            db_sub_key += '_gt' + str(game_type)
        if command is not None:
            db_sub_key += '_c' + str(command)
        if place is not None:
            db_sub_key += '_p' + str(place)
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return db_key + db_sub_key


_pvp_achs_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.PvpSpace) ]