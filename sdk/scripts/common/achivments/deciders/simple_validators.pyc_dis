def check_firesit(ach_id, duration_sec):
    _duration_hours = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    _duration_sec = _duration_hours * 3600
    return duration_sec >= _duration_sec


def check_firefeed(ach_id, item_type):
    _item_type = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    return _item_type == item_type


def check_dialog(ach_id, dialog_id):
