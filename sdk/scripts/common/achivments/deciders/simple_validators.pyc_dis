def check_anomaly(ach_id, duration, anomaly_type):
    _anomaly_type, _duration = achives_parser.get_achiv(ach_id)['essence']['params']
    if _anomaly_type is not None and _anomaly_type != anomaly_type:
        return False
    elif duration < _duration:
        return False
    else:
        return True


