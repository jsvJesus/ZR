# Embedded file name: ./common/achivments/deciders/simple_colnames.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5

def no_column(ach_id):
    return None


def simple_column(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    return 'ess' + str(essence['id'])


def killedbyavatar_column(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.KilledByAvatar:
        raise AssertionError
        map_name, amount = essence['params']
        return amount in (None, 0, 1) and None
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        if map_name is not None:
            db_sub_key += '_m' + map_name
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return db_key + db_sub_key


def event_column(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.Event:
        raise AssertionError
        event, rating, amount, reward = essence['params']
        return amount in (None, 0, 1) and None
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        if event is not None:
            db_sub_key += '_e' + event
        if rating is not None:
            db_sub_key += '_rt' + str(rating)
        if reward is not None:
            db_sub_key += '_rw' + str(int(reward))
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return db_key + db_sub_key