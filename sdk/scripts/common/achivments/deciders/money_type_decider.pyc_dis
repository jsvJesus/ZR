# Embedded file name: ./common/achivments/deciders/money_type_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, money):
    for ach_id in money_ach_ids:
        _decide_ach(user, money, ach_id)


def _decide_ach(user, money, ach_id):
    if achives_parser.get_bitvalue(ach_id, user.achs):
        return
    need_money = achives_parser.get_achiv(ach_id)['essence']['params'][0]
    if money >= need_money:
        user.complete_achivement(ach_id)


def filter_send_to_base(money, achs):
    for ach_id in money_ach_ids:
        if achives_parser.get_bitvalue(ach_id, achs):
            continue
        need_money = achives_parser.get_achiv(ach_id)['essence']['params'][0]
        if money >= need_money:
            return True

    return False


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Money or AssertionError
    return None


money_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Money) ]