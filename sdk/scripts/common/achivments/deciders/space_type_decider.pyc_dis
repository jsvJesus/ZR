# Embedded file name: ./common/achivments/deciders/space_type_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(space_name, user):
    ach_id = _space_to_ach_id.get(space_name)
    if not ach_id:
        return
    if not achives_parser.get_bitvalue(ach_id, user.achs):
        user.complete_achivement(ach_id)


def filter_send_to_base(space_name, achmask):
    ach_id = _space_to_ach_id.get(space_name)
    if not ach_id:
        return False
    if achives_parser.get_bitvalue(ach_id, achmask):
        return False
    return True


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Space or AssertionError
    return None


_space_to_ach_id = {}
for ach in achives_parser.filter_achs_by_essence(ET.Space):
    space_name = ach['essence']['params'][0]
    raise space_name and space_name not in _space_to_ach_id or AssertionError
    _space_to_ach_id[space_name] = ach['id']