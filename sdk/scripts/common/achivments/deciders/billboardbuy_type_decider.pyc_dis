# Embedded file name: ./common/achivments/deciders/billboardbuy_type_decider.py
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5
from Items import ItemsCatalog
import ItemsUtils

def decide(user, complex_item, money):

    def validate_ach(ach_id):
        item_type = complex_item['complexItemType']
        cat_id, _, broken, needed_money = achives_parser.get_achiv(ach_id)['essence']['params']
        if cat_id is not None and cat_id != ItemsCatalog.GetItemCategory(item_type):
            return False
        elif broken is not None and broken == ItemsUtils.isItemGoodForAchivment(complex_item):
            return False
        elif needed_money is not None and money < needed_money:
            return False
        else:
            return True

    common_decider.decide(user, _ach_ids, get_col_name, validate_ach, 1)


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.BillboardBuy:
        raise AssertionError
        cat_id, amount, broken, money = essence['params']
        return amount in (None, 0, 1) and (None, None)
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        if cat_id is not None:
            db_sub_key += '_cat' + str(cat_id)
        if broken is not None:
            db_sub_key += '_br' + str(int(broken))
        if money:
            db_sub_key += '_mon' + str(money)
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return (db_key + db_sub_key, (cat_id, broken, money))


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.BillboardBuy) ]