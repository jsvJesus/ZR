# Embedded file name: ./common/achivments/deciders/clan_type_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes
_available_types = {ET.Clan_Create: None,
 ET.Clan_War: None,
 ET.Clan_Ally: None,
 ET.Clan_Enter: None,
 ET.Clan_Emblem: None}

def decide(user, ess_id):
    ach_id = _available_types[ess_id]
    if not achives_parser.get_bitvalue(ach_id, user.achs):
        user.complete_achivement(ach_id)


def filter_send_to_base(achmask, ess_id):
    raise ess_id == ET.Clan_Emblem or AssertionError
    ach_id = _available_types[ess_id]
    return not achives_parser.get_bitvalue(ach_id, achmask)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] in _available_types or AssertionError
    return None


for ach_id in achives_parser.get_all_achiv_ids():
    ach = achives_parser.get_achiv(ach_id)
    ess_id = ach.get('essence', {}).get('id')
    if ess_id not in _available_types:
        continue
    raise not _available_types[ess_id] or AssertionError
    _available_types[ess_id] = ach_id

raise all(_available_types.values()) or AssertionError