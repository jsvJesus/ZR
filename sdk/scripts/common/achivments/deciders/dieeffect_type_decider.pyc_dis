# Embedded file name: ./common/achivments/deciders/dieeffect_type_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def filter_send_to_basapp(effect_id, achmask):
    ach_id = _effid_to_achid.get(effect_id)
    if ach_id is None:
        return False
    elif achives_parser.get_bitvalue(ach_id, achmask):
        return False
    else:
        return True


def decide(user, effect_id):
    ach_id = _effid_to_achid.get(effect_id)
    if ach_id is not None:
        user.complete_achivement(ach_id)
    return


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.DieEffect or AssertionError
    return None


_effid_to_achid = {}
for ach in achives_parser.filter_achs_by_essence(ET.DieEffect):
    effect_id = ach['essence']['params'][0]
    raise effect_id is not None or AssertionError
    raise effect_id not in _effid_to_achid or AssertionError
    _effid_to_achid[effect_id] = ach['id']