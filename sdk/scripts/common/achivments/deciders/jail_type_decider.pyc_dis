# Embedded file name: ./common/achivments/deciders/jail_type_decider.py
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user):
    common_decider.decide(user, _jail_ach_ids, get_col_name, lambda ach_id: True, 0)


def filter_send_to_base(achmask):
    for ach_id in _jail_ach_ids:
        if not achives_parser.get_bitvalue(ach_id, achmask):
            return True

    return False


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.Jail:
        raise AssertionError
        amount = essence['params'][0]
        return amount in (None, 0, 1) and (None, None)
    else:
        return ('ess' + str(essence['id']), essence['id'])


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_jail_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Jail) ]