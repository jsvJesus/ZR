# Embedded file name: ./common/achivments/deciders/timekill_type_decider.py
import BigWorld
from achivments import achives_parser
ET = achives_parser.EssenceTypes
if BigWorld.component == 'client':

    class KillCounter(object):
        """ \xd0\xa2\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0
        """

        def __init__(self):
            self._kill_data = []

        def on_avatar_killed(self, weapon_item_type, health, from_scope, is_capture, headshot):
            self._kill_data.append((BigWorld.time(), (weapon_item_type,
              health,
              from_scope,
              is_capture,
              headshot)))
            self._kill_data = self._kill_data[-_max_count:]
            self._analize_data()

        def _analize_data(self):
            for ach_id in kill_ach_ids:
                if ach_id in self._user.achiv_ids:
                    continue
                if self._analize_ach(ach_id):
                    self._user.request_complete_ach1(ach_id)

        def _analize_ach(self, ach_id):
            weapon_types, count, time, health, is_scope, is_capture, headshot = achives_parser.get_achiv(ach_id)['essence']['params']
            if len(self._kill_data) < count:
                return False
            else:
                if weapon_types is not None:
                    if self._get_common_value_from_kill_data(0, count) not in weapon_types:
                        return False
                if time is not None:
                    time *= 60
                    delay_time = BigWorld.time() - self._kill_data[-count][0]
                    if delay_time > time:
                        return False
                if health is not None:
                    if self._get_common_value_from_kill_data(1, count) > health:
                        return False
                if is_scope is not None:
                    if self._get_common_value_from_kill_data(2, count) != is_scope:
                        return False
                if is_capture is not None:
                    if self._get_common_value_from_kill_data(3, count) != is_capture:
                        return False
                if headshot is not None:
                    if self._get_common_value_from_kill_data(4, count) != headshot:
                        return False
                return True

        def _get_common_value_from_kill_data(self, index, count):
            if len(self._kill_data) < count:
                return None
            length = len(self._kill_data)
            values = set()
            for i in xrange(length - 1, length - count - 1, -1):
                values.add(self._kill_data[i][1][index])

            if len(values) != 1:
                return None
            else:
                return values.pop()

        def destroy(self):
            pass

        @property
        def _user(self):
            return BigWorld.player()


def request_complete_ach(user, ach_id):
    if not achives_parser.get_bitvalue(ach_id, user.achs):
        user.complete_achivement(ach_id)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.TimeKill or AssertionError
    return None


kill_ach_ids = []
_max_count = 0
for ach in achives_parser.filter_achs_by_essence(ET.TimeKill):
    _max_count = max(_max_count, ach['essence']['params'][1])
    kill_ach_ids.append(ach['id'])