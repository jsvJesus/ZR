# Embedded file name: ./common/achivments/deciders/items_decider.py
from Items import ItemsCatalog
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user, item_type, item_count):
    for ach_id in items_ach_ids:
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        if _validate_ach(ach_id, item_type, item_count):
            user.complete_achivement(ach_id)


def is_interested_in_item_type(achmask, item_type):
    for ach_id in items_ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        _cat_ids, _item_type, _ = achives_parser.get_achiv(ach_id)['essence']['params']
        if _cat_ids is not None:
            cat_id = ItemsCatalog.GetItemCategory(item_type)
            if cat_id not in _cat_ids:
                continue
        if _item_type is not None and _item_type != item_type:
            continue
        return True

    return False


def _validate_ach(ach_id, item_type, item_count):
    _cat_ids, _item_type, _count = achives_parser.get_achiv(ach_id)['essence']['params']
    if _cat_ids is not None:
        cat_id = ItemsCatalog.GetItemCategory(item_type)
        if cat_id not in _cat_ids:
            return False
    if _item_type is not None and _item_type != item_type:
        return False
    elif item_count < _count:
        return False
    else:
        return True


def filter_send_to_base(achmask, item_type, item_count):
    for ach_id in items_ach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id, item_type, item_count):
            return True

    return False


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Items or AssertionError
    return None


items_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Items) ]