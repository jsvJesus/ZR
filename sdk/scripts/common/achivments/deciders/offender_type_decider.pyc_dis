# Embedded file name: ./common/achivments/deciders/offender_type_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes

def decide(user):
    if not achives_parser.get_bitvalue(_ach_id, user.achs):
        user.complete_achivement(_ach_id)


def filter_send_to_base(achmask):
    return not achives_parser.get_bitvalue(_ach_id, achmask)


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Offender or AssertionError
    return None


ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Offender) ]
raise len(ach_ids) == 1 or AssertionError
_ach_id = ach_ids[0]