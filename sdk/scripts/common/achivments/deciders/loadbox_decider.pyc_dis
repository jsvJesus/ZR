# Embedded file name: ./common/achivments/deciders/loadbox_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes
import common_decider

def decide(user):

    def validate_ach(ach_id):
        return _validate_ach(ach_id)

    common_decider.decide(user, _boxach_ids, get_col_name, validate_ach, 0)


def filter_send_to_base(achmask):
    for ach_id in _boxach_ids:
        if achives_parser.get_bitvalue(ach_id, achmask):
            continue
        if _validate_ach(ach_id):
            return True

    return False


def _validate_ach(ach_id):
    return True


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.LoadBox:
        raise AssertionError
        amount = essence['params'][0]
        return amount in (0, 1, None) and None
    else:
        db_key = 'ess' + str(essence['id'])
        return db_key


_boxach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.LoadBox) ]