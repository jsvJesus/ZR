# Embedded file name: ./common/achivments/deciders/quest_type_decider.py
import common_decider
from collections import defaultdict
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5

def decide(user, quest_id):
    if quest_id not in _questid_to_achids:
        return
    ach_ids = _questid_to_achids[quest_id]
    common_decider.decide(user, ach_ids, get_col_name, lambda ach_id: True, 1)


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.Quest:
        raise AssertionError
        quest_ids, amount = essence['params']
        return (not quest_ids or amount in (None, 0, 1)) and (None, None)
    else:
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        for q_id in quest_ids:
            db_sub_key += '_' + str(q_id)

        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return (db_key + db_sub_key, quest_ids)


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_questid_to_achids = defaultdict(list)
for ach in achives_parser.filter_achs_by_essence(ET.Quest):
    quest_ids = ach['essence']['params'][0]
    for quest_id in quest_ids:
        _questid_to_achids[quest_id].append(ach['id'])