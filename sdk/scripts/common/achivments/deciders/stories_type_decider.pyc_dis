# Embedded file name: ./common/achivments/deciders/stories_type_decider.py
from achivments import achives_parser
import traceback
ET = achives_parser.EssenceTypes

def check_missed_achs(user):
    try:
        for ach_id in story_ach_ids:
            if achives_parser.get_bitvalue(ach_id, user.achs):
                continue
            needed_group_id = achives_parser.get_achiv(ach_id)['essence']['params'][1]
            if needed_group_id is None:
                continue
            if user.has_story_group_completed(needed_group_id):
                user.complete_achivement(ach_id)

    except:
        print 'stories type decider (ERROR): check missed achs', user, ach_id
        traceback.print_exc()
        traceback.print_stack()

    return


def decide(user, story_id):
    for ach_id in story_ach_ids:
        _decide_ach(user, story_id, ach_id)


def _decide_ach(user, story_id, ach_id):
    if achives_parser.get_bitvalue(ach_id, user.achs):
        return
    else:
        ess_params = achives_parser.get_achiv(ach_id)['essence']['params']
        needed_story_id, needed_group_id = ess_params
        if needed_story_id is not None:
            if story_id != needed_story_id:
                return
        if needed_group_id is not None:
            if not user.has_story_group_completed(needed_group_id):
                return
        user.complete_achivement(ach_id)
        return


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Stories or AssertionError
    return None


story_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Stories) ]