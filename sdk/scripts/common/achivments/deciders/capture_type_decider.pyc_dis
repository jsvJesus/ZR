# Embedded file name: ./common/achivments/deciders/capture_type_decider.py
from achivments import achives_parser
ET = achives_parser.EssenceTypes
import BigWorld
if BigWorld.component == 'client':

    class CaptureCounter(object):

        def __init__(self, callback):
            self._start_owner = self._user.get_current_base_owner()
            self._protectors = 0
            self._on_base_capture_callback = callback

        def on_attack_stop(self):
            new_owner = self._user.get_current_base_owner()
            base_name = self._user.get_current_base_name()
            user_clan_name = self._user.clanName
            if self._start_owner != new_owner and new_owner == user_clan_name and self._on_base_capture_callback:
                self._on_base_capture_callback(base_name, self._protectors)

        def on_protector_killed(self):
            self._protectors += 1

        def destroy(self):
            self.on_base_capture_callback = None
            return

        @property
        def _user(self):
            return BigWorld.player()


    def filter_send_to_basapp(base_name, frags, ach_ids):
        for ach_id in capture_ach_ids:
            if ach_id in ach_ids:
                continue
            if _validate_ach(ach_id, base_name, frags):
                return True

        return False


def decide(user, base_name, frags):
    for ach_id in capture_ach_ids:
        if achives_parser.get_bitvalue(ach_id, user.achs):
            continue
        if _validate_ach(ach_id, base_name, frags):
            user.complete_achivement(ach_id)


def _validate_ach(ach_id, base_name, frags):
    _frags, _base_name = achives_parser.get_achiv(ach_id)['essence']['params']
    if _frags is not None and frags < _frags:
        return False
    elif _base_name is not None and base_name != _base_name:
        return False
    else:
        return True


def get_col_name(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    raise essence['id'] == ET.Capture or AssertionError
    return None


capture_ach_ids = [ ach['id'] for ach in achives_parser.filter_achs_by_essence(ET.Capture) ]