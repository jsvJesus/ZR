# Embedded file name: ./common/achivments/deciders/getfrom_fire_decider.py
import common_decider
from achivments import achives_parser
ET = achives_parser.EssenceTypes
from hashlib import md5
from collections import defaultdict
from itertools import chain

def filter_send_to_basapp(item_type, is_grill, achmask):
    none_achs = _itemtype_to_achivs.get(None, [])
    type_achs = _itemtype_to_achivs.get(item_type, [])
    if not none_achs and not type_achs:
        return False
    else:
        for ach_id in chain(none_achs, type_achs):
            if achives_parser.get_bitvalue(ach_id, achmask):
                continue
            if _validate_ach(ach_id, item_type, is_grill):
                return True

        return False


def _validate_ach(ach_id, item_type, is_grill):
    item_types, _, needed_is_grill = achives_parser.get_achiv(ach_id)['essence']['params']
    if item_types is None and needed_is_grill is None:
        return True
    elif item_types is None:
        return is_grill == needed_is_grill
    elif needed_is_grill is None:
        return item_type in item_types
    else:
        return is_grill == needed_is_grill and item_type in item_types
        return


def decide(user, item_type, is_grill, count):

    def validate_ach(ach_id):
        return _validate_ach(ach_id, item_type, is_grill)

    ach_ids = chain(_itemtype_to_achivs.get(None, []), _itemtype_to_achivs.get(item_type, []))
    common_decider.decide(user, ach_ids, get_col_name, validate_ach, 1, incremenation=count)
    return


def get_colname_and_hashkey(ach_id):
    essence = achives_parser.get_achiv(ach_id)['essence']
    if not essence['id'] == ET.GetFromFire:
        raise AssertionError
        item_types, amount, is_grill = essence['params']
        return amount in (0, None, 1) and (None, None)
    else:
        if item_types is None:
            item_types = []
        db_key = 'ess' + str(essence['id'])
        db_sub_key = ''
        for item_type in item_types:
            db_sub_key += '_' + str(item_type)

        if is_grill is not None:
            db_sub_key += '_g' + str(int(is_grill))
        if len(db_sub_key) > 10:
            db_sub_key = md5(db_sub_key).hexdigest()[:9]
        return (db_key + db_sub_key, (item_types, is_grill))


def get_col_name(ach_id):
    return get_colname_and_hashkey(ach_id)[0]


_itemtype_to_achivs = defaultdict(list)
for ach in achives_parser.filter_achs_by_essence(ET.GetFromFire):
    item_types = ach['essence']['params'][0]
    if item_types is None:
        _itemtype_to_achivs[None].append(ach['id'])
    else:
        for item_type in item_types:
            _itemtype_to_achivs[item_type].append(ach['id'])