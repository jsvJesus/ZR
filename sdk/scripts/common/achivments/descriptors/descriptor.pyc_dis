# Embedded file name: ./common/achivments/descriptors/descriptor.py
import BigWorld
import common_type_descriptor as CTD
from Localization import lc
from achivments import achives_parser
ET = achives_parser.EssenceTypes
import ItemsUtils
_simple_type_descriptos = set([ET.DieEffect,
 ET.Space,
 ET.Offender,
 ET.TimeKill,
 ET.Capture,
 ET.CaptureProtect,
 ET.CaptureFlag,
 ET.Clan_Create,
 ET.Clan_War,
 ET.Clan_Ally,
 ET.Clan_Enter,
 ET.Clan_Emblem,
 ET.DeathDrop,
 ET.MultiWar,
 ET.MassQuest,
 ET.Container,
 ET.Equip,
 ET.NpcAterdeath,
 ET.Suicide,
 ET.KilledByMob,
 ET.KilledByAnomaly,
 ET.Dialog,
 ET.AnomalyLast,
 ET.Paint,
 ET.FireFeed,
 ET.Items,
 ET.FireSit,
 ET.AnomalyStone])

def compile_description(ach_id, value, data_provider):
    achivment = achives_parser.get_achiv(ach_id)
    ess_id = achivment['essence']['id']
    if ess_id == ET.Quest:
        return CTD.compile_description(lc('AchivGui.tab.quest.completed'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.AnomalyArt:
        return CTD.compile_description(lc('AchivGui.tab.anomaly.gathered'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.BillboardBuy:
        return CTD.compile_description(lc('AchivGui.tab.billboardbuy.bought'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.BillboardSell:
        return CTD.compile_description(lc('AchivGui.tab.billboardsell.sold'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.UseItem:
        return CTD.compile_description(lc('AchivGui.tab.useitem.used'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.PlayTime:
        return CTD.compile_description(lc('AchivGui.tab.playtime.spent'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.Items:
        if value is None:
            item_type = achives_parser.get_achiv(ach_id)['essence']['params'][1]
            value = ItemsUtils.get_item_number_by_type(BigWorld.player(), item_type)
        return CTD.compile_description(lc('AchivGui.tab.completed'), ess_id, ach_id, value, data_provider, 2)
    elif ess_id in _simple_type_descriptos:
        return CTD.compile_description(lc('AchivGui.tab.completed'), ess_id, ach_id, 0, data_provider, None, 1)
    elif ess_id == ET.PvpSpace:
        return CTD.compile_description(lc('AchivGui.tab.pvpspace.completed'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.KillAvatar:
        return CTD.compile_description(lc('AchivGui.tab.killavatar.killed'), ess_id, ach_id, value, data_provider, 4)
    elif ess_id == ET.Jail:
        return CTD.compile_description(lc('AchivGui.tab.jail.completed'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.Distance:
        return CTD.compile_description(lc('AchivGui.tab.distance.completed'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.TraderSell:
        return CTD.compile_description(lc('AchivGui.tab.tradesell.traded'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.Headhunter:
        return CTD.compile_description(lc('AchivGui.tab.headhunter.punished'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.UseItemTarget:
        return CTD.compile_description(lc('AchivGui.tab.useitemtarget.used'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.Finish:
        return CTD.compile_description(lc('AchivGui.tab.finish.finished'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.Butch:
        return CTD.compile_description(lc('AchivGui.tab.butch.butched'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.OpenMob:
        return CTD.compile_description(lc('AchivGui.tab.search.searched'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.Repair:
        return CTD.compile_description(lc('AchivGui.tab.repair.repaired'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.Clean:
        return CTD.compile_description(lc('AchivGui.tab.clean.cleaned'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.KillMob:
        return CTD.compile_description(lc('AchivGui.tab.killmob.killed'), ess_id, ach_id, value, data_provider, 2)
    elif ess_id == ET.Magazine:
        return CTD.compile_description(lc('AchivGui.tab.magazine.reloaded'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.PKStatus:
        return CTD.compile_description(lc('AchivGui.tab.carma.carma'), ess_id, ach_id, data_provider.karma, data_provider, 0)
    elif ess_id == ET.Money:
        return CTD.compile_description(lc('AchivGui.tab.money.accumulated'), ess_id, ach_id, data_provider.CreditNumber, data_provider, 0)
    elif ess_id == ET.Barter:
        return CTD.compile_description(lc('AchivGui.tab.barter.changed'), ess_id, ach_id, value, data_provider, 2)
    elif ess_id == ET.Event:
        return CTD.compile_description(lc('AchivGui.tab.event.completed'), ess_id, ach_id, value, data_provider, 2)
    elif ess_id == ET.KilledByAvatar:
        return CTD.compile_description(lc('AchivGui.tab.killedbyavatar.killed'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.Disassemble:
        return CTD.compile_description(lc('AchivGui.tab.disasseble.disassebled'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.Area:
        needed_spaces_count = len(achivment['essence']['params'][0])
        return CTD.compile_description(lc('AchivGui.tab.area.visited'), ess_id, ach_id, value, data_provider, None, needed_spaces_count)
    elif ess_id == ET.AnomalyCatStone:
        needed_anomaly_count = len(achivment['essence']['params'][0])
        if value is not None:
            value = bin(value).count('1')
        return CTD.compile_description(lc('AchivGui.tab.anomalycat.marked'), ess_id, ach_id, value, data_provider, None, needed_anomaly_count)
    elif ess_id == ET.GetFromFire:
        return CTD.compile_description(lc('AchivGui.tab.fromfire.cooked'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.Craft:
        return CTD.compile_description(lc('AchivGui.tab.craft.crafted'), ess_id, ach_id, value, data_provider, 1)
    elif ess_id == ET.LoadBox:
        return CTD.compile_description(lc('AchivGui.tab.boxes.gathered'), ess_id, ach_id, value, data_provider, 0)
    elif ess_id == ET.Transform:
        return CTD.compile_description(lc('AchivGui.tab.event.completed'), ess_id, ach_id, value, data_provider, 4)
    elif ess_id == ET.Stories:
        ess_params = achives_parser.get_achiv(ach_id)['essence']['params']
        needed_story_id, needed_group_id = ess_params
        if needed_story_id is not None:
            needed_amount = 1
            cur_amount = int(data_provider.has_story(needed_story_id))
        if needed_group_id is not None:
            group_stories = data_provider.get_group_stories(needed_group_id)
            needed_amount = len(group_stories)
            cur_amount = len([ st for st in group_stories if data_provider.has_story(st) ])
        return CTD.compile_description(lc('AchivGui.tab.stories.stories'), ess_id, ach_id, cur_amount, data_provider, None, needed_amount)
    elif ess_id == ET.AnomalyArt_Set:
        needed_art_count = len(achivment['essence']['params'][1])
        if value is not None:
            value = bin(value).count('1')
        return CTD.compile_description(lc('AchivGui.tab.artsets.gathered'), ess_id, ach_id, value, data_provider, None, needed_art_count)
    else:
        print ess_id
        print u'(ERROR:) not implemented yet'
        return u'(ERROR:) not implemented yet'
        return