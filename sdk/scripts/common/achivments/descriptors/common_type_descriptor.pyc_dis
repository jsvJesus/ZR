# Embedded file name: ./common/achivments/descriptors/common_type_descriptor.py
from achivments import achives_parser
from Localization import lc
import colorCodes as CC

def compile_description(completed_local, type_id, ach_id, value, data_provider, needed_amount_param_index, needed_amount = None):
    ach = achives_parser.get_achiv(ach_id)
    ess_id = ach['essence']['id']
    if not ess_id == type_id:
        raise AssertionError
        if needed_amount is None:
            needed_amount = ach['essence']['params'][needed_amount_param_index]
            if needed_amount in (0, 1, None):
                needed_amount = 1
        cur_amount = None
        if ach_id in data_provider.achiv_ids:
            cur_amount = needed_amount
        elif needed_amount == 1:
            cur_amount = 0
        elif value is not None:
            cur_amount = min(value, needed_amount)
        exp = CC.inactive_xml + lc('AchivGui.tab.exp') + u' ' + CC.active_xml + unicode(ach.get('expvalue', 0))
        status = CC.inactive_xml + lc('AchivGui.tab.status.title') + u' '
        if ach_id in data_provider.achiv_ids:
            status += CC.green_xml + lc('AchivGui.tab.status.completed')
        else:
            status += CC.active_xml + lc('AchivGui.tab.status.process')
        completed = cur_amount is None and completed_local
        data_provider.request_ach_value0(ach_id)
    else:
        completed = CC.inactive_xml + u'{0} {1}{2}/{3}'.format(completed_local, CC.active_xml, cur_amount, needed_amount)
    return u'{font}{inactive_color}{header}\n{exp}\n{status}\n{completed}'.format(font='<font=RobotoCondensedRegular_16.font>', inactive_color=CC.inactive_xml, header=lc('AchivGui.tab.chars'), exp=exp, status=status, completed=completed)