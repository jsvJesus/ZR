section = ResMgr.openSection('scripts/common/achivments/achivements.pyson')
_unregistered = []
for ach in pyson.loads(section.asBinary):
    if ach['id'] in ach:
        raise RuntimeError(ach)
    visibility = ach.get('alwaysvisible', AchVis.Common)
    if ach['id'] not in _achid_to_bit_index:
        if visibility != AchVis.Broken:
            _unregistered.append(ach['id'])
        continue
    if 'essence' in ach and 'params' in ach['essence']:
        params = ach['essence']['params']
        for i in xrange(len(params)):
            if isinstance(params[i], list):
                params[i] = tuple(params[i])

    if _is_client:
        ach['name'] = lc('Achivements.name.id{0}'.format(ach['id']))
        ach['description'] = lc('Achivements.desc.id{0}'.format(ach['id']))
    if visibility != AchVis.Broken:
        _ach_data[ach['id']] = ach

if _unregistered:
    raise RuntimeError('unregistered achivments: ' + repr(_unregistered))
_used_achives_list = []
for ach_id in _ach_bits:
    if ach_id in _ach_data:
        _used_achives_list.append(ach_id)
    else:
        print 'achives_parser (ERROR): unused achivment', ach_id

all_achivments = []
bits_count = len(_ach_bits)
while bits_count > 64:
    all_achivments.append(Constants.UINT64_MAXVALUE)
    bits_count -= 64

if bits_count > 0:
    all_achivments.append(Constants.UINT64_MAXVALUE >> 64 - bits_count)

class DummyDecider:

    def get_col_name(self, ach_id):
