_dummy_decider_instance = DummyDecider()

def get_achiv(ach_id):
    return _ach_data.get(ach_id)


def get_all_achiv_ids():
    return _used_achives_list


def filter_achs_by_essence(ess_id):
    return filter(lambda ach: ach.get('essence', {}).get('id') == ess_id, _ach_data.values())


def get_bitvalue(ach_id, achmask):
    MASK_LEN = 64
    bit_index = _achid_to_bit_index[ach_id]
    int_index = bit_index / MASK_LEN
    if len(achmask) <= int_index:
        return False
    bit_index = bit_index % MASK_LEN
    return bool(achmask[int_index] & 1 << bit_index)


def set_bitvalue(ach_id, achmask):
    MASK_LEN = 64
    bit_index = _achid_to_bit_index[ach_id]
    int_index = bit_index / MASK_LEN
    while len(achmask) <= int_index:
        achmask.append(0)

    bit_index = bit_index % MASK_LEN
    bi = 1 << bit_index
    if achmask[int_index] & bi:
        return False
    achmask[int_index] |= bi
    return True


def convert_achmask_to_achids(achmask):
    indices = math_bw.int64_bool_array_to_int_set(achmask)
    return set([ _ach_bits[i] for i in indices ])


