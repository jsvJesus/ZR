# Embedded file name: ./common/Waypoint.py
import Math
import BigWorld
import traceback
from random import choice

class Waypoint:
    EMPTY_POS = Math.Vector3(0.0, 0.0, 0.0)
    EMPTY_ID = 0
    EMPTY_RADIUS = 0.0
    EMPTY_POINTS = []
    EMPTY_TIME = Math.Vector2(0.0, 0.0)

    def __init__(self, **properties):
        self.position = properties.get('position', Waypoint.EMPTY_POS)
        self.id = properties.get('id', Waypoint.EMPTY_ID)
        self.radius = properties.get('radius', Waypoint.EMPTY_RADIUS)
        self.points = properties.get('points', Waypoint.EMPTY_POINTS)
        self.promenade_time = properties.get('promenade_time', Waypoint.EMPTY_TIME)
        self.scenario_animation = properties.get('scenario_animation', '')
        self.scenario_sound = properties.get('scenario_sound', '')
        self.can_talk = properties.get('can_talk', False)
        self.crouch = properties.get('crouch', False)
        self.target = properties.get('target', '')
        self.trigger_mode = properties.get('trigger_mode', 0)
        self.yaw = properties.get('yaw', 0)
        self._validate()

    def _validate(self):
        for p in self.points:
            if p is None:
                print 'DESIGNER_WARNING:\xd0\xb2 Waypoint.points \xd0\xb5\xd1\x81\xd1\x82\xd1\x8c \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd1\x8f \xd1\x82\xd0\xbe\xd1\x87\xd0\xba\xd0\xb0'
                print 'self.position: ', self.position
                print 'self.points: ', self.points
                traceback.print_stack()
                return

        return

    def set_id(self, id):
        self.id = id

    def isReal(self):
        return self.position.distTo(Waypoint.EMPTY_POS) >= 0.1

    def askWaypoint(self, mb, last_way_position = Math.Vector3(0.0, 0.0, 0.0)):
        if not self.points:
            return False
        else:
            points = self.points
            next_point = None
            try:
                if last_way_position.length > 0.1:
                    points = [ p for p in self.points if p.position.distTo(last_way_position) > 0.1 ]
                    if not points:
                        points = self.points
                next_point = choice(points)
                mb.setWaypoint(Waypoint(id=self.id + 1, position=next_point.position, radius=next_point.radius, points=next_point.points, promenade_time=next_point.promenade_time, scenario_animation=next_point.scenario_animation, scenario_sound=next_point.scenario_sound, yaw=next_point.yaw, can_talk=next_point.can_talk, target=next_point.target, trigger_mode=next_point.trigger_mode, crouch=next_point.crouch))
            except BigWorld.UnresolvedUDORefException:
                mb.setWaypoint(self)
            except:
                print '\n\n'
                print 'ERROR FOR:', self, self.id, self.position
                print 'points', self.points
                print 'mb', mb, mb.id
                print 'next_point', next_point
                raise

            return True

    @staticmethod
    def fromUDO(udo, id = 0):
        if udo and udo.__class__.__name__ == 'WaypointUDO':
            try:
                pos = udo.position
                rad = udo.radius
                return Waypoint(id=id, position=pos, radius=rad)
            except BigWorld.UnresolvedUDORefException:
                pass


class WaypointConverter:

    def getDictFromObj(self, obj):
        return dict(id=obj.id, position=obj.position, radius=obj.radius, points=obj.points, promenade_time=obj.promenade_time, scenario_animation=obj.scenario_animation, scenario_sound=obj.scenario_sound, can_talk=obj.can_talk, crouch=obj.crouch, yaw=obj.yaw, target=obj.target, trigger_mode=obj.trigger_mode)

    def createObjFromDict(self, dic):
        return Waypoint(**dic)

    def isSameType(self, obj):
        return isinstance(obj, Waypoint)


converter = WaypointConverter()