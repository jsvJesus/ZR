    def GetEquippedItemSnipingNightVisionAbility(self):
        if self.ActiveItemType and self.ActiveItemID:
            for item in self.CarryingItems:
                if item['complexItemID'] == self.ActiveItemID:
                    for subitem in item['itemList']:
                        subitem_param = ItemsCatalog.GetItemParam(subitem['itemType'])
                        if subitem_param.has_key('isNightVision') and subitem_param['isNightVision']:
                            return True

                    return False

        return False

    def has_item_type(self, item_type):
        """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xbd\xd0\xb0\xd0\xbb\xd0\xb8\xd1\x87\xd0\xb8\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x82\xd0\xb8\xd0\xbf\xd0\xb0 \xd0\xb2 \xd0\xb8\xd0\xbd\xd0\xb2\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x80\xd0\xb5 """
        for item in self.CarryingItems:
            if item.complexItemType == item_type:
                return True

