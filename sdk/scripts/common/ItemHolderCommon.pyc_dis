    def CanAcceptItemsAdvanced(self, items):
        return self.CanAcceptItemTypesAdvanced([ item['complexItemType'] for item in items ])

    def CanAcceptItemTypesAdvanced(self, item_types, unique_count = 0):
        """ \xd1\x81 \xd1\x83\xd1\x87\xd1\x91\xd1\x82\xd0\xbe\xd0\xbc \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb2 """
        if len(self.CarryingItems) + len(item_types) <= ItemsUtils.MAX_AVATAR_ITEMS - unique_count:
            return True
        free_slots = self.getMaxInventorySlots() - ItemsUtils.visual_carring_items_length(self) - unique_count
        if len(item_types) <= free_slots:
            return True
        for i in range(len(item_types) - 1, -1, -1):
            item_type = item_types[i]
            if not ItemsUtils.isStackedItemType(item_type):
                free_slots -= 1
                if free_slots < 0:
                    return False
                del item_types[i]

        if not item_types:
            return True
        carring_types = set((item['complexItemType'] for item in self.CarryingItems))
        item_types = set(item_types)
        for item_type in item_types:
            if item_type in carring_types:
                continue
            free_slots -= 1
            if free_slots < 0:
                return False

        return True