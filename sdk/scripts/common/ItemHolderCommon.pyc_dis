# Embedded file name: ./common/ItemHolderCommon.py
__author__ = 'Leviathan'
import ItemsUtils
import ItemCategories
from Items import ItemsCatalog
import copy

class ItemHolderCommon(object):

    def findEquippedGadgetByID(self, item_id):
        for gadget in self.ActiveGadgetList:
            if gadget['GadjetID'] == item_id:
                return True

        return False

    def findEquippedArtifactByID(self, item_id):
        for gadget in self.ActiveArtifactList:
            if gadget['ArtifactID'] == item_id:
                return True

        return False

    def getEquippedThrowID(self):
        for gadget in self.ActiveGadgetList:
            if ItemsCatalog.GetItemClass(gadget['GadjetType']) == ItemsCatalog.EXPLOSION:
                return gadget['GadjetID']

        return 0

    def getEquippedThrowType(self):
        for gadget in self.ActiveGadgetList:
            if ItemsCatalog.GetItemClass(gadget['GadjetType']) == ItemsCatalog.EXPLOSION:
                return gadget['GadjetType']

        return 0

    def checkActiveGadgets(self):
        """ \xd0\x96\xd0\xb5\xd1\x81\xd1\x82\xd0\xba\xd0\xb0\xd1\x8f \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xb8\xd1\x81\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb0\xd1\x8f \xd0\xb2\xd1\x81\xd0\xb5 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbe\xd1\x88\xd0\xb8\xd0\xb1\xd0\xba\xd0\xb8 """

        def to_many_equipped_gadgets():
            max_items = min(ItemsUtils.MAX_GADGET_EQUIP, ItemsUtils.GetMaximumGadgetSlots(self))
            current = len(self.ActiveGadgetList) + len(self.ActiveArtifactList)
            if current > max_items:
                return True
            return False

        def remove_gadget_by_id(gadget_id):
            for index, gadget in enumerate(self.ActiveGadgetList):
                if gadget_id == gadget['GadjetID']:
                    self.ActiveGadgetList.pop(index)
                    return True

            for index, artifact in enumerate(self.ActiveArtifactList):
                if gadget_id == artifact['ArtifactID']:
                    self.ActiveArtifactList.pop(index)
                    return True

            return False

        for index in xrange(len(self.FakeActiveGadgetList) - 1, -1, -1):
            gadget_id = self.FakeActiveGadgetList[index]
            if not ItemsUtils.GetComplexItemByID(self, gadget_id):
                remove_gadget_by_id(gadget_id)
                continue
            if to_many_equipped_gadgets():
                remove_gadget_by_id(gadget_id)
                continue

        for index, gadget in enumerate(self.ActiveGadgetList):
            if not gadget['GadjetID']:
                continue
            if to_many_equipped_gadgets() or not ItemsUtils.GetComplexItemByID(self, gadget['GadjetID']):
                self.ActiveGadgetList.remove(gadget)
                if gadget['GadjetID'] in self.FakeActiveGadgetList:
                    self.FakeActiveGadgetList.remove(gadget['GadjetID'])
                continue
            if gadget['GadjetID'] not in self.FakeActiveGadgetList:
                self.FakeActiveGadgetList.append(gadget['GadjetID'])

        for index, artifact in enumerate(self.ActiveArtifactList):
            if not artifact['ArtifactID']:
                continue
            if to_many_equipped_gadgets() or not ItemsUtils.GetComplexItemByID(self, artifact['ArtifactID']):
                self.ActiveArtifactList.remove(artifact)
                if artifact['ArtifactID'] in self.FakeActiveGadgetList:
                    self.FakeActiveGadgetList.remove(artifact['ArtifactID'])
                continue
            if artifact['ArtifactID'] not in self.FakeActiveGadgetList:
                self.FakeActiveGadgetList.append(artifact['ArtifactID'])

    def getEquippedGadgets(self):
        _ids = []
        for gadget in self.ActiveGadgetList:
            if gadget['GadjetID']:
                _ids.append(gadget['GadjetID'])

        for artifact in self.ActiveArtifactList:
            if artifact['ArtifactID']:
                _ids.append(artifact['ArtifactID'])

        return _ids

    def removeGadgetsByIDs(self, gadget_ids, stop_actions = True):
        gadget_list = copy.copy(self.ActiveGadgetList)
        for gadget in gadget_list:
            if gadget['GadjetID'] in gadget_ids:
                self.ActiveGadgetList.remove(gadget)
                if gadget['GadjetID'] in self.FakeActiveGadgetList:
                    self.FakeActiveGadgetList.remove(gadget['GadjetID'])
                gadget_param = ItemsCatalog.GetItemParam(gadget['GadjetType'])
                gadget_action = gadget_param.get('Action', None)
                if gadget_action and stop_actions:
                    self.client.stopGadgetActionByID(gadget_action, gadget['GadjetID'])

        artifact_list = copy.copy(self.ActiveArtifactList)
        for artifact in artifact_list:
            if artifact['ArtifactID'] in gadget_ids:
                self.ActiveArtifactList.remove(artifact)
                if artifact['ArtifactID'] in self.FakeActiveGadgetList:
                    self.FakeActiveGadgetList.remove(artifact['ArtifactID'])

        return

    def equipped_gadgets_full(self):
        max_items = min(ItemsUtils.MAX_GADGET_EQUIP, ItemsUtils.GetMaximumGadgetSlots(self))
        current = len(self.ActiveGadgetList) + len(self.ActiveArtifactList)
        if current >= max_items:
            return True
        return False

    def is_gadget(self, item_type):
        gadget_class = ItemsCatalog.GetItemClass(item_type)
        if gadget_class in [ItemsCatalog.GADGET, ItemsCatalog.EXPLOSION]:
            return True
        if ItemsCatalog.GetItemCategory(item_type) == ItemCategories.AMULET:
            return True
        if gadget_class == ItemsCatalog.PART:
            gadget_param = ItemsCatalog.GetItemParam(item_type)
            if gadget_param.get('SubType'):
                return True
        return False

    def removeFamiliarGadgetIfExist(self, gadget_type):
        import ClothAttachSlotsConfig as CASC
        new_gadget_param = ItemsCatalog.GetItemParam(gadget_type)
        gadget_class = ItemsCatalog.GetItemClass(gadget_type)
        if gadget_class == ItemsCatalog.EXPLOSION:
            return False
        else:

            def remove_gadget(_gadget):
                if _gadget in self.ActiveGadgetList:
                    self.ActiveGadgetList.remove(_gadget)
                if _gadget['GadjetID'] in self.FakeActiveGadgetList:
                    self.FakeActiveGadgetList.remove(_gadget['GadjetID'])

            gadget_category = ItemsCatalog.GetItemCategory(gadget_type)
            if gadget_category == ItemCategories.AMULET:
                for gadget in self.ActiveGadgetList:
                    if ItemsCatalog.GetItemCategory(gadget['GadjetType']) == gadget_category:
                        remove_gadget(gadget)
                        return True

                return False
            sub_class = new_gadget_param.get('SubType', None)
            if not sub_class:
                return False
            for gadget in self.ActiveGadgetList:
                gadget_param = ItemsCatalog.GetItemParam(gadget['GadjetType'])
                equipped_sub_class = gadget_param.get('SubType', None)
                if sub_class == equipped_sub_class:
                    remove_gadget(gadget)
                    return True
                radio_classes = [ItemsCatalog.RADIO, ItemsCatalog.RADIO_TANGENT]
                if sub_class in radio_classes and equipped_sub_class in radio_classes:
                    remove_gadget(gadget)
                    return True

            for slot_type, attach_type in self.EquippedVisibleAttaches.items():
                if not attach_type:
                    continue
                subtypes = CASC.get_possible_subtypes(slot_type)
                if sub_class in subtypes:
                    self.EquippedVisibleAttaches[slot_type] = 0
                    self.EquippedVisibleAttachesIDS[slot_type] = 0
                    return True

            return False

    def CheckEquippedGadgetSubType(self, gadget_type):
        import ClothAttachSlotsConfig as CASC
        new_gadget_param = ItemsCatalog.GetItemParam(gadget_type)
        gadget_class = ItemsCatalog.GetItemClass(gadget_type)
        if gadget_class == ItemsCatalog.EXPLOSION:
            return True
        elif gadget_class == ItemsCatalog.ARTIFACT:
            return True
        elif ItemsCatalog.GetItemCategory(gadget_type) == ItemCategories.AMULET:
            for gadget in self.ActiveGadgetList:
                if ItemsCatalog.GetItemCategory(gadget['GadjetType']) == ItemCategories.AMULET:
                    return False

            return True
        else:
            sub_class = new_gadget_param.get('SubType', None)
            if not sub_class:
                return False
            for gadget in self.ActiveGadgetList:
                gadget_param = ItemsCatalog.GetItemParam(gadget['GadjetType'])
                equipped_sub_class = gadget_param.get('SubType', None)
                if sub_class == equipped_sub_class:
                    return False
                radio_classes = [ItemsCatalog.RADIO, ItemsCatalog.RADIO_TANGENT]
                if sub_class in radio_classes and equipped_sub_class in radio_classes:
                    return False

            for slot_type, attach_type in self.EquippedVisibleAttaches.items():
                if not attach_type:
                    continue
                subtypes = CASC.get_possible_subtypes(slot_type)
                if sub_class in subtypes:
                    return False

            return True

    def checkEquippedThrow(self):
        for gadget in self.ActiveGadgetList:
            equipped_gadget_class = ItemsCatalog.GetItemClass(gadget['GadjetType'])
            if equipped_gadget_class == ItemsCatalog.EXPLOSION:
                return True

        return False

    def GetMaxItemStorageNumber(self, trader_name):
        return ItemsUtils.DEFAULT_TRADER_STORAGE_SPACE

    def GetEquippedItemSnipingAbility(self):
