# Embedded file name: ./common/compound_quest_utils.py
import pyson
import ResMgr
PATH = 'scripts/common/data/CompoundQuestConfig.pyson'
scenario_data = None
indexes = []

def load_data():
    global scenario_data
    global indexes
    try:
        if scenario_data:
            return
        py_data_section = ResMgr.openSection(PATH)
        scenario_data = pyson.loads(py_data_section.asBinary)
        indexes = scenario_data.keys()
        indexes.sort()
    except:
        print 'error file:', repr(PATH)
        import traceback
        print traceback.print_exc()

    return scenario_data


load_data()

def get_scenarios():
    return scenario_data.keys()


def get_index_by_name(scenatio_name):
    return indexes.index(scenatio_name)


def get_name_by_index(scenatio_index):
    return indexes[scenatio_index]


def get_space_message(scenatio_index, state_id):
    scenatio_name = get_name_by_index(scenatio_index)
    data = get_state_data(scenatio_name, state_id)
    return data.get('space_message')


def get_states(scenatio_name):
    return [ (state_id, i['name']) for state_id, i in scenario_data.get(scenatio_name, {}).items() ]


def get_model_tint(scenatio_name, state):
    return scenario_data[scenatio_name][state].get('model_tint', 'default')


def get_state_data(scenatio_name, state):
    return scenario_data.get(scenatio_name, {}).get(state)


def get_state_by_name(scenatio_name, state_name):
    for state_id, data in scenario_data.get(scenatio_name, {}).items():
        if state_name == data['name']:
            return state_id

    return None