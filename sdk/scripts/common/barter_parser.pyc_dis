# Embedded file name: ./common/barter_parser.py
import ResMgr

def get_barter_assortment(barter_list_name):
    return _data.get(barter_list_name, [])


_data = {}
section = ResMgr.openSection('scripts/common/data/BarterList.xml')
for barter_name, barter_list_data in section.items():
    lists = []

    def item_types_and_quantity(types_data, search_key):
        types_and_quantity_list = []
        types_and_quantity_dict = {}
        for key, value in types_data.items():
            if key != search_key:
                continue
            item_type = value['ItemType'].asInt
            item_quantity = value['Quantity'].asInt
            types_and_quantity_list.append((item_type, item_quantity))
            if item_type not in types_and_quantity_dict:
                types_and_quantity_dict[item_type] = 0
            types_and_quantity_dict[item_type] += item_quantity

        return (types_and_quantity_list, types_and_quantity_dict)


    for item_list_data in barter_list_data.values():
        for item_data in item_list_data.values():
            result_items, result_items_dict = item_types_and_quantity(item_data, 'ObtainedItemType')
            resource_items, resource_items_dict = item_types_and_quantity(item_data, 'LostItemType')
            list_data = {'barterListName': item_data['Name'].asString,
             'resultItems': result_items,
             'resultItemsDict': result_items_dict,
             'resourceItemsDict': resource_items_dict,
             'resourceItems': resource_items}
            lists.append(list_data)

    _data[barter_name] = lists