# Embedded file name: ./common/AnomalyUtils.py
import math
import Math
import Config.Anomalies
from Config.Anomalies import CommonConfig
from Constants import ScanArtsMode

def getMaxAnomalyRadius(terrainType, AnomalyRadiusType):
    if AnomalyRadiusType == 1:
        return 5
    if AnomalyRadiusType == 2:
        return 7
    if AnomalyRadiusType == 3:
        return 15
    radius = 0
    terrain_anomalies = Config.Anomalies.get_anomalies_for_terrain(terrainType)
    for anomaly_id in terrain_anomalies:
        anom_cfg = Config.Anomalies.get_config(anomaly_id)
        if anom_cfg['radius'] > radius:
            radius = anom_cfg['radius']

    return radius


PDA_ANOMALIES = set([CommonConfig.name_to_type['Led']])

def is_valid_for_scan(scan_mode, anomaly):
    if scan_mode == ScanArtsMode.Extractor:
        return anomaly.anomalyType not in PDA_ANOMALIES
    if scan_mode == ScanArtsMode.Pda:
        return anomaly.anomalyType in PDA_ANOMALIES
    raise RuntimeError


def getMaximumAnomaliesCount(spawnRadius, anomalyRadius):
    anomalyDiametr = anomalyRadius * 2
    if anomalyDiametr < 1.0:
        return 0
    numberCircle = int(spawnRadius / anomalyDiametr)
    if numberCircle == 0:
        return 0
    if numberCircle == 1:
        return 1
    allnumberCircle = 0
    for circle in xrange(1, numberCircle):
        circleRadius = circle * anomalyDiametr
        c = 6.28 * circleRadius
        counthere = int(c / anomalyDiametr)
        allnumberCircle += counthere

    return allnumberCircle


def getAnomaliePositionGenerator(spawPos, spawnRadius, anomalyRadius):
    anomalyDiametr = anomalyRadius * 2
    numberCircle = int(spawnRadius / anomalyDiametr)
    if numberCircle == 0:
        yield (spawPos, -1)
    if numberCircle == 1:
        yield (spawPos, 0)
    else:
        allnumberCircle = 0
        xc, yc, zc = spawPos
        currentPoint = -1
        for circle in xrange(1, numberCircle):
            circleRadius = circle * anomalyDiametr
            c = 6.28 * circleRadius
            counthere = c / anomalyDiametr
            allnumberCircle += counthere
            curent = -3.14
            step = 6.28 / counthere
            for sub in xrange(int(counthere)):
                currentPoint += 1
                curent += step
                x = xc + circleRadius * math.cos(curent)
                z = zc + circleRadius * math.sin(curent)
                yield (Math.Vector3(x, yc, z), currentPoint)


def getAnomaliePosition(spawPos, spawnRadius, anomalyRadius, pointID):
    anomalyDiametr = anomalyRadius * 2
    numberCircle = int(spawnRadius / anomalyDiametr)
    if numberCircle == 0:
        return spawPos
    elif numberCircle == 1:
        return spawPos
    else:
        allnumberCircle = 0
        xc, yc, zc = spawPos
        currentPoint = -1
        for circle in xrange(1, numberCircle):
            circleRadius = circle * anomalyDiametr
            c = 6.28 * circleRadius
            counthere = c / anomalyDiametr
            allnumberCircle += counthere
            curent = -3.14
            step = 6.28 / counthere
            for sub in xrange(int(counthere)):
                currentPoint += 1
                curent += step
                if pointID == currentPoint:
                    x = xc + circleRadius * math.cos(curent)
                    z = zc + circleRadius * math.sin(curent)
                    return Math.Vector3(x, yc, z)

        return None