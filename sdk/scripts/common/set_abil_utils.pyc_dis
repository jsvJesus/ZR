data = ResMgr.openSection('scripts/common/data/set_abil_data.pyson')
data = pyson.loads(data.asBinary)
_abils = {}
for abil in data['abils']:
    _abils[abil['name']] = abil
    _abils[abil['id']] = abil

_set_to_abil = {}
for set_abil in data['sets']:
    _set_to_abil[set_abil['name']] = _abils[set_abil['abil']]

def get_abil_config(set_name):
    return _set_to_abil[set_name]


def get_abil_charge_config(set_name):
    return _set_to_abil[set_name]['charge']


def get_abil_cooldown(abil_id):
    return _abils[abil_id]['cooldown']


def get_abil_config_by_abil_id(abil_id):
    return _abils[abil_id]


def parse_main_set_item(entity):
    for item_data in entity.EquippedArmor.values():
        item_id, item_type = item_data['itemID'], item_data['itemType']
        if item_id <= 0 or item_type <= 0:
            continue
        item_params = ItemsCatalog.GetItemParam(item_type)
        is_main = item_params.get('SetEquipMain', False)
        if is_main:
            main_item = ItemsUtils.GetComplexItemByID(entity, item_id)
            main_item_set = item_params['SetEquip']
            break
    else:
        return None

    charge_config = get_abil_charge_config(main_item_set)
    if not ItemsUtils.GetSingleInconstantParam(main_item, ItemsCatalog.INC_SETCHARGE):
        cur_charge = 0
        needed_charges = max(0, charge_config['max'] - cur_charge)
        result = {'item_id': main_item['complexItemID'],
         'needed_charges': needed_charges,
         'main_item': main_item,
         'set_name': main_item_set}
        return needed_charges == 0 and result
    else:
        result['total_money'] = charge_config['cost']['money'] * needed_charges
        spend_item_data = charge_config['cost'].get('item', (None, None))
        result['spend_item_type'], result['spend_count'] = spend_item_data
        if result['spend_count']:
            result['spend_count'] *= needed_charges
        return result