# Embedded file name: ./common/msgchecker.py
"""\xd0\x9c\xd0\xbe\xd0\xb4\xd1\x83\xd0\xbb\xd1\x8c \xd1\x80\xd0\xb5\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb8\xd0\xb7 \xd1\x87\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xbd\xd0\xb0 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb5\xd1\x89\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb5."""
import collections
import time
try:
    from Localization import lc
except Exception:

    def lc(string, utf8 = None):
        return string


try:
    from ChatChannelConfig import CHANNEL_CONSTS
except Exception:

    class CHANNEL_CONSTS:
        GENERAL = 0
        TRADE = 3


PUBLIC_CHANELLS = set([CHANNEL_CONSTS.GENERAL, CHANNEL_CONSTS.TRADE])

class CanItSendException(Warning):
    pass


class MsgCheckCode(object):
    """\xd0\x9a\xd0\xbe\xd0\xb4\xd1\x8b \xd1\x80\xd0\xb5\xd0\xb7\xd1\x83\xd0\xbb\xd1\x8c\xd1\x82\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb8."""
    IT_CAN_BE_SENT = 0
    EMPTY_TEXT = 1
    TOO_OFTEN_SENDING = 2
    SPAM = 3
    TOO_LONG_MESSAGE = 4


class MsgChecker(object):
    """\xd0\xa0\xd0\xb5\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xbb \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb9."""
    MAX_MESSAGE_LEN = 128
    MIN_MESSAGE_FREQUENCY = 1
    MAX_SPAM_MSG = 2
    MAX_REMEMBER_MSG = 20

    def __init__(self):
        self._last_msg_time = 0
        self._stored_msgs = []
        self._msgs_cnter = collections.defaultdict(int)
        self._msg_cnt = 0
        self._fail_code_to_txt = {MsgCheckCode.IT_CAN_BE_SENT: "It's alright.",
         MsgCheckCode.EMPTY_TEXT: 'Common.chat.EMPTY_TEXT',
         MsgCheckCode.TOO_OFTEN_SENDING: 'Common.chat.TOO_OFTEN_SENDING',
         MsgCheckCode.SPAM: 'Common.chat.SPAM',
         MsgCheckCode.TOO_LONG_MESSAGE: 'Common.chat.TOO_LONG_MESSAGE'}

    def can_it_be_sent(self, text, channel_id):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbd\xd0\xb0 \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbe\xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f."""
        check_code = self.check(text, channel_id)
        result, reason = self.get_result_and_reason(check_code)
        return (result, reason)

    def check(self, text, channel_id):
        try:
            if not text.strip():
                raise CanItSendException(MsgCheckCode.EMPTY_TEXT)
            if time.time() - self._last_msg_time < self.MIN_MESSAGE_FREQUENCY:
                raise CanItSendException(MsgCheckCode.TOO_OFTEN_SENDING)
            if channel_id in PUBLIC_CHANELLS and self._is_it_spam(text):
                raise CanItSendException(MsgCheckCode.SPAM)
            text_ = text if isinstance(text, unicode) else text.decode('utf-8')
            if len(text_) > self.MAX_MESSAGE_LEN:
                raise CanItSendException(MsgCheckCode.TOO_LONG_MESSAGE)
        except CanItSendException as err:
            result = err.message
        else:
            result = MsgCheckCode.IT_CAN_BE_SENT

        self._last_msg_time = time.time()
        return result

    def get_result_and_reason(self, check_code):
        """\xd0\xa1\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb9\xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xbb\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb8\xd1\x87\xd0\xb8\xd0\xbd\xd1\x83 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbb\xd0\xb0."""
        if MsgCheckCode.IT_CAN_BE_SENT == check_code:
            result = True
            reason = None
        else:
            result = False
            reason = lc(self._fail_code_to_txt[check_code], utf8=True)
        return (result, reason)

    def _is_it_spam(self, msg):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb5 \xd1\x8f\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbb\xd0\xb8 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x81\xd0\xbf\xd0\xb0\xd0\xbc\xd0\xbe\xd0\xbc."""
        if msg in self._msgs_cnter and self._msgs_cnter[msg] >= self.MAX_SPAM_MSG:
            return True
        self._msgs_cnter[msg] += 1
        self._stored_msgs.append(msg)
        self._msg_cnt += 1
        if self._msg_cnt > self.MAX_REMEMBER_MSG:
            first_elem = self._stored_msgs.pop(0)
            self._msg_cnt -= 1
            self._msgs_cnter[first_elem] -= 1
            if self._msgs_cnter[first_elem] <= 0:
                del self._msgs_cnter[first_elem]
        return False


class ClientMsgChecker(MsgChecker):
    """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xbd\xd0\xb0 \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb5."""
    MAX_SPAM_ATTEMPT = 3

    def __init__(self):
        super(ClientMsgChecker, self).__init__()
        self._spam_attempt = 0

    def can_it_be_sent(self, text, channel_id):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbd\xd0\xb0 \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbe\xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f."""
        check_code = self.check(text, channel_id)
        result, reason = self.get_result_and_reason(check_code)
        if check_code == MsgCheckCode.SPAM:
            self._spam_attempt += 1
        return (result, reason)

    def is_exceed_spam_limit(self):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb2\xd1\x8b\xd1\x81\xd0\xb8\xd0\xbb \xd0\xba\xd0\xbe\xd0\xbb-\xd0\xb2\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xbf\xd1\x8b\xd1\x82\xd0\xbe\xd0\xba \xd0\xbf\xd0\xb8\xd1\x81\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81\xd0\xbf\xd0\xb0\xd0\xbc."""
        return self._spam_attempt > self.MAX_SPAM_ATTEMPT