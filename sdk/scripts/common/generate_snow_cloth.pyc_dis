# Embedded file name: ./common/generate_snow_cloth.py
import os
import json
import xml.etree.ElementTree as ET
RES_PATH = os.path.abspath(os.path.join(os.getcwd(), '../res'))
DATA_PATH = os.path.join(RES_PATH, 'scripts/client/data/snow_cloth_textures.json')

def walkmodels(root):

    def rec(subdir):
        for p in os.listdir(root + '/' + subdir):
            if p.lower().endswith('.model'):
                yield subdir + '/' + p
            elif os.path.isdir(root + '/' + subdir + '/' + p):
                for x in rec(subdir + '/' + p):
                    yield x

    for x in rec('characters2'):
        yield x


def _parse_nonbw(model_path):
    full_path = os.path.join(RES_PATH, model_path)
    tree = ET.parse(full_path)
    dye = tree.find('dye')
    if dye is None:
        return
    else:
        matter = dye.find('matter')
        if matter is None:
            return
        for tint in dye.findall('tint'):
            for prop in tint.findall('property'):
                name = prop.find('name')
                if name is None:
                    continue
                if name.text.strip() != 'MaskForDiffuse':
                    continue
                default = prop.find('default')
                if default is None:
                    continue
                def_texture = default.text.strip()
                snow_texture = os.path.splitext(def_texture)[0] + '_snow.dds'
                if os.path.exists(os.path.join(RES_PATH, snow_texture)):
                    return {'dye': matter.text.strip(),
                     'def': def_texture,
                     'snow': snow_texture}
                return

        return


def _parse(model_path):
    import ResMgr
    data = ResMgr.openSection(model_path)
    if data is None:
        print 'ERROR OPEN', repr(model_path)
        return
    else:
        res = []
        for tag, subdata in data.items():
            if tag == 'dye':
                conf = _parse_dye(subdata)
                if conf:
                    res.append(conf)

        return res


def _parse_dye(dye):
    if dye is None:
        return
    else:
        matter = dye['matter']
        if matter is None:
            return
        for tinttag, tint in dye.items():
            if tinttag != 'tint':
                continue
            for prop_tag, prop in tint.items():
                if prop_tag != 'property':
                    continue
                name = prop['name']
                if name is None:
                    continue
                if name.asString != 'MaskForDiffuse':
                    continue
                default = prop['default']
                if default is None:
                    continue
                def_texture = default.asString
                snow_texture = os.path.splitext(def_texture)[0] + '_snow.dds'
                if os.path.exists(os.path.join(RES_PATH, snow_texture)):
                    return {'dye': matter.asString,
                     'def': def_texture,
                     'snow': snow_texture}
                return

        return


def generate():
    print 'generate_snow_cloth'
    print '\nDATA_PATH:', DATA_PATH
    DATA = {}
    print
    for model_path in walkmodels(RES_PATH):
        res = _parse(model_path)
        if res:
            DATA[model_path] = res

    print 'FOUND MODELS:', len(DATA)
    with open(DATA_PATH, 'w') as f:
        json.dump(DATA, f, indent=2, sort_keys=True)
    print 'done'


if __name__ == '__main__':
    RES_PATH = os.path.abspath(os.path.dirname(__file__) + '../../../../../res')
    DATA_PATH = os.path.join(RES_PATH, 'scripts/client/data/snow_cloth_textures.json')
    _parse = _parse_nonbw
    generate()