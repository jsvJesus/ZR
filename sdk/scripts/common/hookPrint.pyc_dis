# Embedded file name: ./common/hookPrint.py
"""
Module for printing information about 'print' statement calling.
Replaces the sys.stdout
"""
import sys
import traceback
import os

def path_and_linenum_format_func(path, lineNum, caller, line):
    return path + ', ' + str(lineNum)


def full_format_func(path, lineNum, caller, line):
    return '%s:%d, %s, %s' % (path,
     lineNum,
     caller,
     line)


def short_format_func(path, lineNum, caller, line):
    res = '<%s, %d>' % (os.path.split(path)[1], lineNum)
    return '%-30s' % res


def short_format_func_2(path, lineNum, caller, line):
    fileName = os.path.split(path)[1]
    if fileName.endswith('.py'):
        fileName = fileName[:-3]
    res = '%s %d' % (fileName, lineNum)
    return '%-30s' % res


format_func = short_format_func
_lastCallInfo = None

def _write(arg):
    global _lastCallInfo
    stack_info = traceback.extract_stack(limit=2)
    if len(stack_info) == 1:
        currentCallInfo = ['No stack info (not Python call) ',
         0,
         None,
         '']
    else:
        currentCallInfo = stack_info[-2]
    if _lastCallInfo != currentCallInfo:
        _saved_stdout.write(format_func(*currentCallInfo))
        _lastCallInfo = currentCallInfo
    elif arg == '\n':
        _lastCallInfo = None
    _saved_stdout.write(arg)
    return


_write.write = _write
__all__ = ['enable', 'disable']

def enable():
    """ Enables info printing """
    global _saved_stdout
    if sys.stdout is not _write:
        _saved_stdout = sys.stdout
        sys.stdout = _write
        print '================== hookPrint enabled', _saved_stdout, sys.stdout


def disable():
    """ Disables info printing """
    print '================== hookPrint disabled', _saved_stdout, sys.stdout
    sys.stdout = _saved_stdout