# Embedded file name: ./common/TimeWork.py
from time import strptime
from time import localtime
from time import gmtime
MINUTES_IN_DAY = 1440
SECONDS_IN_DAY = MINUTES_IN_DAY * 60

def timeStrToMinutes(timeStr):
    """ converts a string of 'hh::mm' format to number of minutes """
    try:
        time = strptime(timeStr, '%H:%M')
        return time.tm_hour * 60 + time.tm_min
    except Exception as msg:
        return None

    return None


def getCurrentMinute():
    """ get current minute of the day """
    currentTime = localtime()
    return currentTime.tm_hour * 60 + currentTime.tm_min


def getCurrentSecond():
    """ get current minute of the day """
    currentTime = localtime()
    return currentTime.tm_hour * 3600 + currentTime.tm_min * 60 + currentTime.tm_sec


def getCurrentUTCSecond():
    """ get current minute of the day """
    currentTime = gmtime()
    return currentTime.tm_hour * 3600 + currentTime.tm_min * 60 + currentTime.tm_sec