# Embedded file name: ./common/tick_coro.py
import BigWorld
from Helpers.BWCoroutine import BWCoroutine, BWWaitForPeriod
from collections import deque
import traceback

class TickCoro:

    def __init__(self, tick_time):
        self._coro = None
        self._tick_time = tick_time
        return

    def run_coro(self):
        if self._coro:
            self._coro.stop()
        self._coro = self._tick_coro(self)
        self._coro.run()

    def stop_coro(self):
        if self._coro:
            self._coro.stop()
            self._coro = None
        return

    @BWCoroutine
    def _tick_coro(self):
        while True:
            yield BWWaitForPeriod(self._tick_time)
            try:
                self.on_tick()
            except:
                print '[ERROR] TickCoro.on_tick', self
                traceback.print_exc()
                traceback.print_stack()
                break

        self._coro = None
        return

    def on_tick(self):
        raise NotImplementedError


class PQueue:

    def __init__(self):
        self.max_size = 200
        self.q = deque()
        self.sm = 0

    def put(self, val):
        old = 0 if len(self.q) < self.max_size else self.q.popleft()
        self.sm += val - old
        self.q.append(val)

    def get_mean(self):
        return self.sm / max(len(self.q), 1)


class pCoro(TickCoro):

    def __init__(self, tick_time):
        TickCoro.__init__(self, tick_time)
        self.q = PQueue()

    def on_tick(self):
        ping = BigWorld.LatencyInfo().value[3]
        self.q.put(ping)

    def get_mean(self):
        return self.q.get_mean()