class WordsFilter(object):
    """\xd0\xa4\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2.
    
    \xd0\x97\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x88\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb2 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80\xd0\xb5 \xd0\xbe\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc \xd1\x81\xd0\xb8\xd0\xbc\xd0\xb2\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xbc.
    \xd0\xa1\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c, \xd0\xba\xd0\xb0\xd0\xba \xd1\x86\xd0\xb5\xd0\xbb\xd1\x8b\xd0\xb5, \xd1\x82\xd0\xb0\xd0\xba \xd0\xb8 \xd1\x81 \xd1\x81\xd0\xb8\xd0\xbc\xd0\xb2\xd0\xbe\xd0\xbb\xd0\xb0\xd0\xbc\xd0\xb8 \xd0\xb7\xd0\xb2\xd1\x91\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x87\xd0\xb5\xd0\xba
