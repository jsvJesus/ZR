    \xd0\xbe\xd1\x82\xd1\x81\xd1\x83\xd1\x82\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb5 \xd1\x81\xd0\xb8\xd0\xbc\xd0\xb2\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2. 
    """

    def __init__(self, rules, repl_sym = u'*', additional_reg_patt = None, comment_patt = None):
        """\xd0\x9a\xd0\xbe\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        self._rules = rules
        self._repl_sym = repl_sym
        self._additional_reg_patt = additional_reg_patt
        self._comment_patt = comment_patt
        self._patts = []

    @lazyproperty
    def bad_words_patt(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb0\xd1\x82\xd1\x82\xd0\xb5\xd1\x80\xd0\xbd \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2 \xd0\xbd\xd0\xb0 \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x80\xd0\xb5\xd0\xb3\xd1\x83\xd0\xbb\xd1\x8f\xd1\x80\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xb2\xd1\x8b\xd1\x80\xd0\xb0\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f."""

        def statsub(matchobj):
            word = matchobj.groups()[0]
            pattern = matchobj.group()
            new_patt = pattern.replace(word, u'({0})'.format(word))
            new_patt = new_patt.replace(u'*', u'\\w*?')
            return new_patt

        sub_patt = re.compile(u'\\**(\\w+)\\**', re.UNICODE | re.IGNORECASE)

        def patt_gen(fh):
            for word in fh:
                word = word.strip()
                if not word:
                    continue
                word = word.decode('utf-8')
                if self._comment_patt is not None and self._comment_patt.match(word):
                    continue
                if '*' in word:
                    word = sub_patt.sub(repl=statsub, string=word)
                word = u'\\b{0}\\b'.format(word)
                yield word

            return

        def add_patt(words):
            patt_str = u'{0}'.format(u'|'.join(words))
            patt = re.compile(patt_str, re.IGNORECASE | re.UNICODE)
            self._patts.append(patt)

        words = []
        cntr = 0
        for word in patt_gen(self._rules):
            cntr += 1
            words.append(word)
            if cntr == 99:
                add_patt(words)
                cntr = 0
                words[:] = []

        if words:
            add_patt(words)
        if self._additional_reg_patt is not None:
            self._patts.append(self._additional_reg_patt)

        class MultipleRegExps(object):

            def __init__(self, word_filter):
                self._word_filter = word_filter

            def sub(self, repl, string, count = 0, flags = 0):
                for patt in self._word_filter._patts:
                    try:
                        string = patt.sub(repl=self._word_filter._replace_bad_words_statsub, string=string)
                    except:
                        print repr(string)
                        print repr(patt)
                        import traceback
                        traceback.print_exc()

                return string

        return MultipleRegExps(self)

    def replace_bad_words(self, string):
        """\xd0\x97\xd0\xb0\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc \xd1\x81\xd0\xb8\xd0\xbc\xd0\xb2\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xbc \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb5\xd1\x89\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0."""
        is_str = False
        if isinstance(string, str):
            string = string.decode('utf-8')
            is_str = True
        string = self.bad_words_patt.sub(repl=self._replace_bad_words_statsub, string=string)
        if is_str:
            string = string.encode('utf-8')
        return string

    def _replace_bad_words_statsub(self, matchobj):
        """\xd0\xa4\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8f \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81n\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb8 \xd0\xb2 re.sub \xd0\xb2 \xd0\xb0\xd1\x80\xd0\xb3\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 repl"""
        word = matchobj.group()
        bad_sub_word = first_not_None(matchobj)
        if bad_sub_word is None:
            word = self._repl_sym * len(word)
        else:
            word = word.replace(bad_sub_word, self._repl_sym * len(bad_sub_word))
        return word