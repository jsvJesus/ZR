def get_point_data(space_name, point_id):
    """ point_id \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb1\xd1\x8b\xd1\x82\xd1\x8c \xd0\xba\xd0\xb0\xd0\xba point_guid \xd1\x82\xd0\xb0\xd0\xba \xd0\xb8 point_index """
    _parse_space_if_needed(space_name)
    return _data[space_name][0].get(point_id)


def get_heli_data(space_name, heli_index):
    _parse_space_if_needed(space_name)
    return _data[space_name][1][heli_index]


def get_heli_list(space_name):
    _parse_space_if_needed(space_name)
    return _data[space_name][1]


def _parse_space_if_needed(space_name):
    if space_name not in _data:
        space_data = {}
        heli_data = {}
        section = ResMgr.openSection('spaces/{0}/hpoints.pyson'.format(space_name))
        if section is not None:
            for chunk_data in pyson.loads(section.asBinary).values():
                for point_data in chunk_data:
                    if 'start_point' in point_data:
                        heli_data[point_data['index']] = point_data
                    else:
                        point_data['position'] = Vector3(point_data['position'])
                        matrix = Matrix()
                        matrix.setRotateYPR(point_data['rotation'])
                        point_data['matrix'] = matrix
                        space_data[point_data['guid']] = point_data
                        space_data[point_data['index']] = point_data

        _data[space_name] = (space_data, heli_data)
    return