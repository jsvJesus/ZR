class PremiumConfigs:
    """\xd0\x91\xd0\xb0\xd0\xb7\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb9 \xd0\xb0\xd0\xb1\xd1\x81\xd1\x82\xd1\x80\xd0\xb0\xd0\xba\xd1\x82\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xbe \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd1\x83\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f\xd1\x85 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb8\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xbe\xd0\xb2."""
    __metaclass__ = abc.ABCMeta

    def initialize(self):
        self.configs_path = 'scripts/common/data/PremiumAccountConfig.json'
        self.premium_off_conf = make_immutable({'ExpCoefficient': 1,
         'CreditsCoefficient': 1,
         'AdditionalTradeSlots': 0,
         'days': TIME_IS_OVER})
        raw_configs = self.read_raw_configs()
        self._configs = make_immutable(self.processing_raw_configs(raw_configs))

    def config_id(self, config):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xb0\xd0\xb6\xd0\xb4\xd0\xbe\xd0\xb9 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd1\x83\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8."""
        name = config['premium_id']
        return name

    def read_raw_configs(self):
        """\xd0\xa1\xd1\x87\xd0\xb8\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 json \xd1\x81 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd0\xb0\xd0\xbc\xd0\xb8."""
        py_data_section = ResMgr.openSection(self.configs_path)
        raw_configs = json.loads(py_data_section.asBinary)
        return raw_configs

    @abc.abstractmethod
    def processing_raw_configs(self, raw_configs):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82 \xd0\xbe\xd0\xb6\xd0\xb8\xd0\xb4\xd0\xb0\xd0\xbc\xd1\x83\xd1\x8e \xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd1\x83\xd1\x80\xd1\x83 \xd0\xb8\xd0\xb7 json"""
        return raw_configs

    def get_premium_config(self, config_id):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3 \xd0\xbf\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xbc\xd1\x83 id."""
        if config_id == PREMIUM_OFF:
            config = self.premium_off_conf
        else:
            config = self._configs.get(config_id, None)
        return config

    def all_configs(self):
        return self._configs

    def is_holiday(self, config_id):
        conf = self.get_premium_config(config_id)
        if conf and conf.get('holiday', False):
            return True
        return False


class ServerPremiumConfigs(Singlton, PremiumConfigs):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd1\x83\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb9 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb8\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb0."""

    def initialization(self):
        super(ServerPremiumConfigs, self).initialize()

    def processing_raw_configs(self, raw_configs):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82 \xd0\xbe\xd0\xb6\xd0\xb8\xd0\xb4\xd0\xb0\xd0\xbc\xd1\x83\xd1\x8e \xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd1\x83\xd1\x80\xd1\x83 \xd0\xb8\xd0\xb7 json"""
        configs = {}
        for conf in raw_configs['configs']:
            premium_id = self.config_id(conf)
            conf = self._remome_redundant_config_keys(conf)
            seconds = conf.pop('days') * SECONDS_IN_DAY
            conf['premium_time'] = seconds
            configs[premium_id] = conf
            if 'CreditsCoefficient' not in conf:
                conf['CreditsCoefficient'] = float(self.premium_off_conf['CreditsCoefficient'])
            if 'AdditionalTradeSlots' not in conf:
                conf['AdditionalTradeSlots'] = self.premium_off_conf['AdditionalTradeSlots']

        return configs

    def _remome_redundant_config_keys(self, config):
        removing_keys = ('description', 'premium_id')
        for key in removing_keys:
            config.pop(key, None)

        return config


class ClientSimpleConfigs(ServerPremiumConfigs):

    def _remome_redundant_config_keys(self, config):
        return config


class ClientPremiumConfigs(PremiumConfigs):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd1\x83\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb9 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb8\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0."""

    def __init__(self, current_conf_id, actual_ids):
        self.current_conf_id = current_conf_id
        self.actual_ids = actual_ids
        self.configs_list = []
        self.no_premium_icon_path = None
        super(ClientPremiumConfigs, self).initialize()
        return

    def processing_raw_configs(self, raw_configs):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82 \xd0\xbe\xd0\xb6\xd0\xb8\xd0\xb4\xd0\xb0\xd0\xbc\xd1\x83\xd1\x8e \xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd1\x83\xd1\x80\xd1\x83 \xd0\xb8\xd0\xb7 json"""
        configs = {}
        self.no_premium_icon_path = raw_configs.get('noPremiumIcon')
        for conf in raw_configs['configs']:
            premium_id = self.config_id(conf)
            seconds = conf.pop('days') * SECONDS_IN_DAY
            conf['premium_time'] = seconds
            conf['name'] = lc(conf['name'])
            conf['description'] = lc(conf['description'])
            if 'CreditsCoefficient' not in conf:
                conf['CreditsCoefficient'] = float(self.premium_off_conf['CreditsCoefficient'])
            configs[premium_id] = conf
            self.configs_list.append(conf)

        self.configs_list = self.configs_list
        return configs

    def all_order_configs(self):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb4\xd0\xbe\xd1\x81\xd1\x82\xd1\x83\xd0\xbf\xd0\xbd\xd1\x8b\xd0\xb5 (+ \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xb0\xd1\x8f \xd0\xbd\xd0\xb0 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbc\xd0\xbe\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82) \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd1\x83\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb8\xd1\x83\xd0\xbc \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xb0."""
        return copy.deepcopy(self.configs_list)