def getCenterPoly(tri):
    """
    tri - \xd0\xbc\xd0\xb0\xd1\x81\xd1\x81\xd0\xb8\xd0\xb2 Vector3
    \xd0\xb2\xd0\xbe\xd0\xb7\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x86\xd0\xb5\xd0\xbd\xd1\x82\xd1\x80 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xbd\xd0\xb0 \xd0\xbe\xd1\x81\xd0\xb8 XZ \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xb8\xd0\xb3\xd0\xbe\xd0\xbd\xd0\xb0
    """
    max_ = -1
    best = None
    last = None
    for v in tri:
        if last:
            dist = v.flatDistSqrTo(last)
            if dist > max_:
                max_ = dist
                best = (v, last)
        last = v

    return (best[0] + best[1]) / 2


def getUpDowndPoly(tri):
    """
    tri - \xd0\xbc\xd0\xb0\xd1\x81\xd1\x81\xd0\xb8\xd0\xb2 Vector3
    \xd0\xb2\xd0\xbe\xd0\xb7\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xb0\xd0\xbc\xd1\x83\xd1\x8e \xd0\xbd\xd0\xb8\xd0\xb7\xd0\xba\xd1\x83\xd1\x8e, \xd1\x81\xd0\xb0\xd0\xbc\xd1\x83\xd1\x8e \xd0\xb2\xd1\x8b\xd1\x81\xd0\xbe\xd0\xba\xd1\x83\xd1\x8e \xd1\x82\xd0\xbe\xd1\x87\xd0\xba\xd1\x83
    """
    up = None
    down = None
    for v in tri:
        if not up or up.y < v.y:
            up = v
        if not down or down.y > v.y:
            down = v

    return (down, up)


def int16(n):
    n &= 65535
    return (n ^ 32768) - 32768


def uint16(n):
    return n & 65535


def int8(n):
    n &= 255
    return (n ^ 128) - 128


def uint8(n):
    return n & 255


def uint64(n):
    return n & 18446744073709551615L


def int64(n):
    return (n ^ 9223372036854775808L) - 9223372036854775808L


def setbit(variable, index = 0, value = True):
    """
    flags = 0
    flags = setbit(flags, 5, True)
    ...
    if getbit(flags, 5):
            ...
    """
    mask = 1 << index
    if value:
        variable |= mask
    else:
        variable &= ~mask
    return variable


def getbit(variable, index = 0):
    mask = 1 << index
    if variable & mask:
        return 1
    return 0