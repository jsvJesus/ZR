# Embedded file name: ./common/EffectsFormulas.py
from FiringDefs import DamageTypes, BODY_ZONES
import math
import Stats

def Value(subEf, baseEf, stacks, entity):
    return subEf['value']


def UseStacks(subEf, baseEf, stacks, entity):
    return subEf['value'] * stacks


def UseStacksMinus(subEf, baseEf, stacks, entity):
    return subEf['value'] * max(stacks - subEf['stacksMinus'], 0)


def FullDuration(subEf, baseEf, stacks, entity):
    duration = baseEf['duration'] + (baseEf['stacks'] - 1) * baseEf['stackDuration']
    return duration


def Radiation(subEf, baseEf, stacks, entity):
    radiationDef = entity.get_defence(BODY_ZONES.TORSO, DamageTypes.RADIATION)
    return stacks * round(subEf['value'] * (1 - min(0.95, radiationDef * 0.001)))


def BioDefOnHead(subEf, baseEf, stacks, entity):
    bioDef = entity.get_defence(BODY_ZONES.HEAD, DamageTypes.BIO)
    return subEf['value'] * stacks * (1.0 - min(1.0, bioDef * 0.001))


def damageTypeStacksFormula(subEf, baseEf, stacks, entity):
    _damageType = baseEf['damageType']
    _dmgDef = entity.get_defence(BODY_ZONES.TORSO, _damageType)
    return subEf['value'] * round(stacks * (1 - min(0.95, _dmgDef * 0.001)))


def MulOtherEffectStacks(subEf, baseEf, stacks, entity):
    otherEffectStacks = entity.getEffectStacks(subEf['otherEffectIDlist'][0])
    return subEf['value'] * min(otherEffectStacks, 1)


def MoreStackLessValue(subEf, baseEf, stacks, entity):
    power = 0.5
    return math.ceil(subEf['value'] * (1 - math.pow(power, stacks)) / (1 - power))


def impactIfHas_AND_Effects(subEf, baseEf, stacks, entity):
    for other_eff_id in subEf['otherEffectIDlist']:
        otherEffectStacks = entity.getEffectStacks(other_eff_id)
        if otherEffectStacks <= 0:
            return 0

    return subEf['value']


def impactIfHas_NOT_AND_Effects(subEf, baseEf, stacks, entity):
    for other_eff_id in subEf['otherEffectIDlist']:
        otherEffectStacks = entity.getEffectStacks(other_eff_id)
        if otherEffectStacks <= 0:
            return subEf['value']

    return 0


def impactIfHas_OR_Effects(subEf, baseEf, stacks, entity):
    for other_eff_id in subEf['otherEffectIDlist']:
        otherEffectStacks = entity.getEffectStacks(other_eff_id)
        if otherEffectStacks > 0:
            return subEf['value']

    return 0


def impactIfHas_NOT_OR_Effects(subEf, baseEf, stacks, entity):
    for other_eff_id in subEf['otherEffectIDlist']:
        otherEffectStacks = entity.getEffectStacks(other_eff_id)
        if otherEffectStacks > 0:
            return 0

    return subEf['value']


def waterFormula(subEf, baseEf, stacks, entity):
    enableEffectLevel = entity.position[1] + 0.2
    if enableEffectLevel < entity.waterHeight:
        return subEf['value'] * round(entity.waterHeight - enableEffectLevel)
    else:
        return 0


def waterUnderFormula(subEf, baseEf, stacks, entity):
    entity_h = entity.position[1]
    waterHeight = entity.waterHeight
    underWaterLevel = waterHeight - entity_h if entity_h < waterHeight else 0
    stamina_drain = subEf.get('stamina_drain', 0)
    above_water_mult = subEf.get('above_water_mult', 0)
    SIT_LEVEL = {1: 0.69,
     3: 0.69,
     2: 0.98,
     4: 0.81}
    NOSE_LEVEL = {(False, False): 1.58,
     (True, False): 1.5,
     (False, True): 1.1,
     (True, True): 1.18}
    sit_pose = entity.IsAvatarHaveSitPose()
    if sit_pose:
        enableEffectLevel = SIT_LEVEL.get(sit_pose, 0.69)
    else:
        is_weapon = not entity.ActiveItemID == 0
        is_crouch = entity.IsAvatarCrouched()
        enableEffectLevel = NOSE_LEVEL[is_weapon, is_crouch]
    if enableEffectLevel < underWaterLevel:
        stamina = entity.GetStatValue(Stats.ch_Stamina)
        if stamina_drain and stamina > stamina_drain:
            entity.SetStatValue(Stats.ch_Stamina, stamina - stamina_drain)
            return subEf['value'] // 2
        else:
            return subEf['value']
    else:
        return above_water_mult * subEf['value']


def waterSlowing(subEf, baseEf, stacks, entity):
    enableEffectLevel = entity.position[1] + 0.15
    maxValue = 2
    if enableEffectLevel < entity.waterHeight:
        return subEf['value'] * min(entity.waterHeight - enableEffectLevel, maxValue)
    else:
        return 0


def regenerationHPAvatar(subEf, baseEf, stacks, entity):
    regeneration_value = entity.GetStatValue(Stats.ch_HitPointsRegeneration)
    return regeneration_value


def regenerationMPAvatar(subEf, baseEf, stacks, entity):
    regeneration_value = entity.GetStatValue(Stats.ch_StaminaRegeneration)
    return regeneration_value


def regenerationCPAvatar(subEf, baseEf, stacks, entity):
    regeneration_value = entity.GetStatValue(Stats.ch_CombatPointsRegeneration)
    return regeneration_value


FORMULA = {'F.Value': Value,
 'F.UseStacks': UseStacks,
 'F.UseStacksMinus': UseStacksMinus,
 'F.MoreStackLessValue': MoreStackLessValue,
 'F.FullDuration': FullDuration,
 'F.Radiation': Radiation,
 'F.BioDefOnHead': BioDefOnHead,
 'F.MulOtherEffectStacks': MulOtherEffectStacks,
 'F.impactIfHas_OR_Effects': impactIfHas_OR_Effects,
 'F.impactIfHas_AND_Effects': impactIfHas_AND_Effects,
 'F.impactIfHas_NOT_OR_Effects': impactIfHas_NOT_OR_Effects,
 'F.impactIfHas_NOT_AND_Effects': impactIfHas_NOT_AND_Effects,
 'F.waterFormula': waterFormula,
 'F.waterUnderFormula': waterUnderFormula,
 'F.waterSlowing': waterSlowing,
 'F.regenerationHPAvatar': regenerationHPAvatar,
 'F.regenerationMPAvatar': regenerationMPAvatar,
 'F.regenerationCPAvatar': regenerationCPAvatar}

def getFormula(subeff):
    return FORMULA[subeff['formula']]