                                           {'sound_name': 'environment/loudspeaker/lightsout/phrase5',
                                            'subtitles': 'megaphone_subtitles.night_lubech_phrase5'}]}}}
CONFIG_DATA = {}
SOUND_NAME_TO_SUBTITLES = {}
for _id, data in _CONFIG_DATA.items():
    time_periods = []
    for period_name_time, raw_sound_list in data['timetable'].items():
        try:
            time_h, time_m = period_name_time.split(':')
        except Exception as e:
            print '[ERROR] Failed parse:', [period_name_time]
            raise e

        sound_list = []
        for d in raw_sound_list:
            sound_name = d['sound_name']
            if not sound_name:
                raise ValueError('empty sound_name: [%s][%s]' % (_id, period_name_time))
            sound_list.append(sound_name)
            subtitles = d.get('subtitles')
            if subtitles:
                SOUND_NAME_TO_SUBTITLES[sound_name] = subtitles

        if not sound_list:
            raise ValueError('empty sound_list: [%s][%s]' % (_id, period_name_time))
        period_time = int(time_h) * 3600 + int(time_m) * 60
        period = dict(name=str(period_name_time), time=period_time, sound_list=sound_list)
        time_periods.append(period)
        time_periods.sort(key=lambda period: period['time'])

    CONFIG_DATA[_id] = time_periods