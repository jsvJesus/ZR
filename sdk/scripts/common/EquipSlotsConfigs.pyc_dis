    _apply_now = True
    _pending_changes = {}

    @staticmethod
    def get_substrate(slot_type):
        """ \xd0\xba\xd0\xbe\xd1\x80\xd1\x82\xd0\xb5\xd0\xb6 (\xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd1\x80\xd0\xb0, \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb7\xd1\x80\xd0\xb0\xd1\x87\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c) """
        return EquipSlotTypes._slot_type_to_substrate.get(slot_type)

    @staticmethod
    def get_default_equipped_armor():
        result = {}
        for value in EquipSlotTypes._slot_type_to_attr.values():
            if value is None:
                continue
            result[value] = {'itemID': 0,
             'itemType': 0}

        return result

    @staticmethod
    def get_face_slots():
        return EquipSlotTypes._face_slots

    @staticmethod
    def get_ungangable_slots():
        return EquipSlotTypes.get_face_slots()

    @staticmethod
    def get_slots_from_body_zone(body_zone):
        return EquipSlotTypes._body_zone_to_slots.get(body_zone, [])

    @staticmethod
    def is_slot_empty(avatar, slot_type):
        slot_data = avatar.EquippedArmor[EquipSlotTypes._slot_type_to_attr[slot_type]]
        return slot_data['itemType'] == 0

    @staticmethod
    def get_slot_data(avatar, slot_type):
        return avatar.EquippedArmor[EquipSlotTypes._slot_type_to_attr[slot_type]]

    @staticmethod
    def clear_slot(avatar, slot_type):
        EquipSlotTypes.set_slot_data(avatar, slot_type, {'itemID': 0,
         'itemType': 0})

    @staticmethod
    def clear_multiple_slots(avatar, slot_types):
        EquipSlotTypes.set_multiple_slots_data(avatar, slot_types, [{'itemID': 0,
          'itemType': 0}] * len(slot_types))

    @staticmethod
    def set_slot_data(avatar, slot_type, item, reset_tuck_on_new_boots = True):
        """ reset_tuck_on_new_boots == True - \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb4\xd0\xb5\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb8 \xd0\xbd\xd0\xbe\xd0\xb2\xd1\x8b\xd1\x85 \xd0\xb1\xd0\xbe\xd1\x82\xd0\xb8\xd0\xbd\xd0\xbe\xd0\xba tuck \xd1\x81\xd0\xb1\xd1\x80\xd0\xb0\xd1\x81\xd1\x8b\xd0\xb2\xd0\xb0\xd1\x82\xd1\x81\xd1\x8f
        """
        if item['itemID'] < 0 and avatar.__class__.__name__ == 'Avatar':
            print 'DUP_WARNING set_slot_data <0', avatar, repr(slot_type), PY(item)
            traceback.print_stack()
        attr = EquipSlotTypes._slot_type_to_attr.get(slot_type)
        if not attr:
            attr = EquipSlotTypes._slot_type_to_attr.get(int(slot_type))
        if not attr:
            print 'ERROR::EquipSlotsConfigs', avatar, slot_type, item
            raise RuntimeError('non existing attribute {0}'.format(attr))

        def need_keep_hood(item_type, prev_item_type):
            if item_type <= 0:
                if not prev_item_type <= 0:
                    return not ItemsUtils.has_item_hood(prev_item_type)
                return slot_type not in EquipSlotTypes._hood_slots and True
            return ItemsCatalog.GetItemParam(item_type).get('KeepHood')

        prev_item_type = avatar.EquippedArmor[attr]['itemType']
        if EquipSlotTypes.is_mode_on(avatar, EquipSlotTypes.MODE_HOOD):
            put_hood_off = not need_keep_hood(item['itemType'], prev_item_type)

            def need_change_tuck():
                """ None - \xd0\xbd\xd0\xb8\xd1\x87\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbd\xd0\xb5 \xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb0\xd1\x82\xd1\x8c
                        True - \xd1\x81\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc \xd0\xbd\xd0\xb0 ON
                        False - \xd1\x81\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc \xd0\xbd\xd0\xb0 OFF
                """
                if slot_type not in [EquipSlotTypes.PANTS, EquipSlotTypes.SHOES]:
                    return None
                mode_on = EquipSlotTypes.is_mode_on(avatar, EquipSlotTypes.MODE_TUCK)
                if slot_type == EquipSlotTypes.PANTS:
                    pants_item_type = item['itemType']
                    shoes_item_type = EquipSlotTypes.get_slot_data(avatar, EquipSlotTypes.SHOES)['itemType']
                elif slot_type == EquipSlotTypes.SHOES:
                    pants_item_type = EquipSlotTypes.get_slot_data(avatar, EquipSlotTypes.PANTS)['itemType']
                    shoes_item_type = item['itemType']
                if pants_item_type <= 0 or shoes_item_type <= 0:
                    if mode_on:
                        return False
                    return None
                pants_params = ItemsCatalog.GetItemParam(pants_item_type)
                if not pants_params.get('Tuckable', False):
                    if mode_on:
                        return False
                    return None
                shoes_params = ItemsCatalog.GetItemParam(shoes_item_type)
                if not shoes_params.get('TuckAnimation'):
                    if mode_on:
                        return False
                    return None
                elif shoes_params.get('TuckForce', False):
                    if not mode_on:
                        return True
                    return None
                elif reset_tuck_on_new_boots:
                    if mode_on:
                        return False
                    return None
                else:
                    return None

            untuck_pants = need_change_tuck()

            def need_remove_visor(item_type):
                if not item_type:
                    return False
                return ItemsUtils.has_item_visor(item_type)

            def has_visor_lock_item():
                for equipped_type in ItemsUtils.get_equipped_item_types(avatar):
                    if ItemsCatalog.GetItemParam(equipped_type).get('LockVisor', False):
                        return True

                return False

            if EquipSlotTypes.is_mode_on(avatar, EquipSlotTypes.MODE_VISOR) and any(map(need_remove_visor, (prev_item_type, item['itemType']))):
                close_visor = not has_visor_lock_item()
                if EquipSlotTypes.is_mode_on(avatar, EquipSlotTypes.MODE_HEADLIGHT):
                    close_headlight = ItemsUtils.has_item_headlight(prev_item_type)
                    if EquipSlotTypes._apply_now:
                        avatar.EquippedArmor[attr] = item
                        if put_hood_off:
                            EquipSlotTypes.set_mode(avatar, EquipSlotTypes.MODE_HOOD, False)
                        close_visor and EquipSlotTypes.set_mode(avatar, EquipSlotTypes.MODE_VISOR, False)
                    close_headlight and EquipSlotTypes.set_mode(avatar, EquipSlotTypes.MODE_HEADLIGHT, False)
                untuck_pants is not None and EquipSlotTypes.set_mode(avatar, EquipSlotTypes.MODE_TUCK, untuck_pants)
        else:
            EquipSlotTypes._pending_changes[attr] = item
            if put_hood_off:
                EquipSlotTypes._pending_changes['set_hood'] = False
            if close_visor:
                EquipSlotTypes._pending_changes['set_visor'] = False
            if close_headlight:
                EquipSlotTypes._pending_changes['set_headlight'] = False
            if untuck_pants is not None:
                EquipSlotTypes._pending_changes['set_tuck'] = untuck_pants
        return

    @staticmethod
    def _apply_pending_changes(avatar):
        equipped_armor_copy = dict(zip(avatar.EquippedArmor.keys(), avatar.EquippedArmor.values()))
        for key, value in EquipSlotTypes._pending_changes.iteritems():
            if key not in EquipSlotTypes._attr_to_slot_type:
                continue
            equipped_armor_copy[key] = value

        avatar.EquippedArmor = equipped_armor_copy
        if 'set_hood' in EquipSlotTypes._pending_changes:
            EquipSlotTypes.set_mode(avatar, EquipSlotTypes.MODE_HOOD, EquipSlotTypes._pending_changes['set_hood'])
        if 'set_visor' in EquipSlotTypes._pending_changes:
            EquipSlotTypes.set_mode(avatar, EquipSlotTypes.MODE_VISOR, EquipSlotTypes._pending_changes['set_visor'])
        if 'set_headlight' in EquipSlotTypes._pending_changes:
            EquipSlotTypes.set_mode(avatar, EquipSlotTypes.MODE_HEADLIGHT, EquipSlotTypes._pending_changes['set_headlight'])
        if 'set_tuck' in EquipSlotTypes._pending_changes:
            EquipSlotTypes.set_mode(avatar, EquipSlotTypes.MODE_TUCK, EquipSlotTypes._pending_changes['set_tuck'])

    @staticmethod
    def set_multiple_slots_data(avatar, slot_types, items):
        if len(slot_types) == 1 or len(items) == 1:
            EquipSlotTypes.set_slot_data(avatar, slot_types[0], items[0])
            return
        EquipSlotTypes._apply_now = False
        for slot_type, item in zip(slot_types, items):
            EquipSlotTypes.set_slot_data(avatar, slot_type, item)

        EquipSlotTypes._apply_pending_changes(avatar)
        EquipSlotTypes._apply_now = True
        EquipSlotTypes._pending_changes.clear()

    @staticmethod
    def get_slot_type_from_cloth_mode(mode):
        if mode == EquipSlotTypes.MODE_HOOD:
            copy_slot = EquipSlotTypes.HAT
        elif mode == EquipSlotTypes.MODE_VISOR:
            copy_slot = EquipSlotTypes.EYES
        elif mode == EquipSlotTypes.MODE_HEADLIGHT:
            copy_slot = EquipSlotTypes.EYES
        elif mode == EquipSlotTypes.MODE_TUCK:
            copy_slot = EquipSlotTypes.SHOES
        else:
            raise RuntimeError
        return copy_slot

    @staticmethod
    def get_cloth_mode_action(avatar, mode, on, use = False):
        slot_type = EquipSlotTypes.get_slot_type_from_cloth_mode(mode)
        if on:
            action_string = EquipSlotTypes.get_slot_action_on(slot_type, armed=avatar.isArmed(), use=use)
        else:
            action_string = EquipSlotTypes.get_slot_action_off(slot_type, armed=avatar.isArmed(), use=use)
        return getattr(avatar.model, action_string)

    @staticmethod
    def get_cloth_mode_action_duration_mul(mode, on):
        slot_type = EquipSlotTypes.get_slot_type_from_cloth_mode(mode)
        return EquipSlotTypes.get_slot_action_duration_mul(slot_type, on)

    @staticmethod
    def get_slot_action_duration_mul(slot_type, on):
        action = EquipSlotTypes._slot_type_to_action.get(slot_type)
        if not action:
            return 1.0
        key = 'off_update_model_duration_mul'
        if on:
            key = 'on_update_model_duration_mul'
        return action.get(key, EquipSlotTypes._default_update_model_duration_mul)

    @staticmethod
    def get_slot_action_on(slot_type, armed = False, use = False):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 action \xd0\xb8 duration """
        action = EquipSlotTypes._slot_type_to_action.get(slot_type)
        if not action or 'on_action' not in action:
            return None
        else:
            action_name = action['on_action']
            if armed and action.get('on_action_armed'):
                action_name = action['on_action_armed']
            if use and action.get('on_action_use'):
                action_name = action['on_action_use']
            return action_name

    @staticmethod
    def get_slot_action_off(slot_type, armed = False, use = False):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 action \xd0\xb8 duration """
        action = EquipSlotTypes._slot_type_to_action.get(slot_type)
        if not action or 'off_action' not in action:
            return None
        else:
            action_name = action['off_action']
            if armed and action.get('off_action_armed'):
                action_name = action['off_action_armed']
            if use and action.get('off_action_use'):
                action_name = action['off_action_use']
            return action_name

    @staticmethod
    def can_be_empty(slot_type):
        return slot_type not in EquipSlotTypes._replaceonly_slots

    @staticmethod
    def get_slot_type_from_attr(attr):
        return EquipSlotTypes._attr_to_slot_type[attr]

    @staticmethod
    def is_mode_on(avatar, mode, visual = False):
        """ \xd1\x81\xd0\xbf\xd0\xb5\xd1\x86\xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc\xd1\x8b \xd0\xbe\xd0\xb4\xd0\xb5\xd0\xb6\xd0\xb4\xd1\x8b (\xd0\xba\xd0\xb0\xd0\xbf\xd1\x8e\xd1\x88\xd0\xbe\xd0\xbd, \xd0\xb7\xd0\xb0\xd0\xb1\xd1\x80\xd0\xb0\xd0\xbb\xd0\xbe \xd0\xb8 \xd0\xbf\xd1\x80.) """
        if visual and hasattr(avatar, 'VisualEquipModes'):
            return avatar.VisualEquipModes & 1 << mode
        return bool(getattr(avatar, 'EquipModes', 0) & 1 << mode)

    @staticmethod
    def set_mode(avatar, mode, on = True):
        if EquipSlotTypes.is_mode_on(avatar, mode) == on:
            return
        if on:
            avatar.EquipModes |= 1 << mode
        else:
            avatar.EquipModes &= ~(1 << mode)
        if hasattr(avatar, 'on_cloth_mode_changed'):
            avatar.on_cloth_mode_changed(mode, on)

    @staticmethod
    def can_use_mode(avatar, mode, on):
        if mode == EquipSlotTypes.MODE_HOOD:
            for slot_type in EquipSlotTypes._hood_slots:
                item_type = EquipSlotTypes.get_slot_data(avatar, slot_type)['itemType']
                if item_type <= 0:
                    continue
                if not ItemsCatalog.GetItemParam(item_type).get('KeepHood', False):
                    return False

            return True
        if mode == EquipSlotTypes.MODE_VISOR:
            if not on:
                for equipped_type in ItemsUtils.get_equipped_item_types(avatar):
                    if ItemsCatalog.GetItemParam(equipped_type).get('LockVisor', False):
                        return False

            return True
        if mode in [EquipSlotTypes.MODE_HEADLIGHT, EquipSlotTypes.MODE_TUCK]:
            return True
        return False


EquipSlotTypes._slots_list = sorted(EquipSlotTypes._slot_type_to_attr.keys())
for slot_type, attr in EquipSlotTypes._slot_type_to_attr.items():
    EquipSlotTypes._attr_to_slot_type[attr] = slot_type