CROSSING_TURNER_MODELS = {0: 'models/props/caves/winch_system/lever/lever.model'}
CROSSING_CARRIAGE_MODELS = {0: 'models/bolvan/crossing_carriage.model'}
CROSSING_TURNER_MODELS_TO_INDEX = dict(((v, k) for k, v in CROSSING_TURNER_MODELS.items()))
CROSSING_CARRIAGE_MODELS_TO_INDEX = dict(((v, k) for k, v in CROSSING_CARRIAGE_MODELS.items()))

def calcPosition(points, pos_perc):
    max_index = len(points) - 1
    step = 1.0 / max_index
    first = int(pos_perc / step)
    sec = min(first + 1, max_index)
    inside_pos = pos_perc % step / step
    ds = points[sec] - points[first]
    return points[first] + ds * inside_pos


