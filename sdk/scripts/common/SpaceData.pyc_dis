# Embedded file name: ./common/SpaceData.py
import BigWorld
WEATHER_SYSTEM_NAME = 256
PERIOD_SYSTEM_NAME = 257
SECONDS_PER_DAY = 86400
SPACE_SOUND_PLAY = 258

def _get_name_to_space_key(name):
    return ('nametospace', name)


def register_space(space_id, name, mailbox):
    key = _get_name_to_space_key(name)
    BigWorld.globalData[key] = (space_id, mailbox)


def _get_wander_point_key(name):
    return ('wanderpoint', name)


def register_wander_point(name, position, direction, space_id, npc_actions, mailbox):
    key = _get_wander_point_key(name)
    BigWorld.globalData[key] = {'position': position,
     'direction': direction,
     'space_id': space_id,
     'mailbox': mailbox,
     'actions': npc_actions}


def get_wander_point(name):
    key = _get_wander_point_key(name)
    return BigWorld.globalData.get(key)


def get_space_id_by_name(name):
    key = _get_name_to_space_key(name)
    value = BigWorld.globalData.get(key)
    return value and value[0]


def get_space_loader_by_name(name):
    key = _get_name_to_space_key(name)
    value = BigWorld.globalData.get(key)
    return value and value[1]


def set_space_time_of_day(space_id, time, time_speed):
    """ \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xbf\xd0\xb5\xd0\xb9\xd1\x81\xd0\xb5 """
    key = _get_space_time_key(space_id)
    result = BigWorld.setSpaceTimeOfDay(space_id, time, time_speed)
    BigWorld.globalData[key] = {'global_time': BigWorld.time(),
     'speed': time_speed,
     'local_time': BigWorld.timeOfDay(space_id)}
    return result


def _get_space_time_key(space_id):
    return ('space_time_key', space_id)


def get_space_time_of_day(space_id):
    key = _get_space_time_key(space_id)
    data = BigWorld.globalData[key]
    global_time_elapsed = BigWorld.time() - data['global_time']
    local_time_elapsed = global_time_elapsed * data['speed']
    cur_local_time = data['local_time'] + local_time_elapsed
    return cur_local_time % SECONDS_PER_DAY


def get_space_time_speed(space_id):
    key = _get_space_time_key(space_id)
    return BigWorld.globalData[key]['speed']


def release_space_time(space_id):
    key = _get_space_time_key(space_id)
    if BigWorld.globalData.has_key(key):
        del BigWorld.globalData[key]


def is_space_loaded(space_id):
    key = _get_space_time_key(space_id)
    return BigWorld.globalData.has_key(key)


def space_exisit(space_name, space_id):
    space_info = BigWorld.globalData.get('space%s' % space_id)
    if not space_info:
        return False
    mb, name = space_info
    return name == space_name