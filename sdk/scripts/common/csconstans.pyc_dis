def sort_players_table(players, teamID = 0, sort_param = 'plscore'):
    if teamID:
        pl_list = [ x for x in players if x['teamID'] == teamID ]
    else:
        pl_list = list(players)
    pl_list.sort(key=lambda pl: (-pl[sort_param], pl['deaths']))
    return pl_list


def sort_dm_players(players):
    pl_list = [ x for x in players if x['teamID'] ]
    pl_list.sort(key=lambda pl: (-pl['kills'], pl['deaths']))
    return pl_list


def sort_team_dm_players(players, team = TEAM_RED):
    pl_list = [ x for x in players if x['teamID'] == team ]
    pl_list.sort(key=lambda pl: (-pl['kills'], pl['deaths']))
    return pl_list


def sort_flag_players(players):
    pl_list = [ x for x in players if x['teamID'] ]
    pl_list.sort(key=lambda pl: (-pl['brought_flags'] - pl['kills'], pl['deaths']))
    return pl_list


def sort_bm_players(players):
    pl_list = [ x for x in players if x['teamID'] ]
    pl_list.sort(key=lambda pl: (-pl['cnt_button'] - pl['kills'], pl['deaths']))
    return pl_list


_xoffset = -200
_yoffset = -200

def packPvPFlagPosition(pos, home):
    x = int(pos[0] - _xoffset)
    y = int(pos[2] - _yoffset)
    x = max(0, min(511, x))
    y = max(0, min(511, y))
    res = 1 if home else 0
    res += x * 2
    res += y * 1024
    return res


def unpackPVPFlagPosition(data):
    home = data & 1
    x = data >> 1 & 511
    y = data >> 10 & 511
    return ((x + _xoffset, 0, y + _yoffset), home)


def _testpack():
    test = [((0, 0, 0), 1),
     ((0, 0, 0), 0),
     ((500, 0, 500), 0),
     ((1500, 0, 515), 0),
     ((-100, 0, -20), 0)]
    for e in test:
        pdata = packPvPFlagPosition(*e)
        print e, pdata, bin(pdata)
        print unpackPVPFlagPosition(pdata)
        print


if __name__ == '__main__':
    _testpack()