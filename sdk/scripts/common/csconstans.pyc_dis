class CODE_ERR:

    @staticmethod
    def init():
        CODE_ERR._lc = {}
        codes = ('OK', 'FAIL_CONNECT_MAX_PLAYER', 'FAIL_CONNECT_STATUS_ROOM_CONNECT_NO', 'FAIL_CONNECT_ALREADY_ROOM', 'FAIL_DISCONNECT_ROOM_NOT_FOUND_ROOM', 'FAIL_CH_TEAM_FORBIDDEN', 'FAIL_CH_TEAM_MAXPLAYERS', 'FAIL_NOT_FOUND_PARTY', 'FAIL_PRIVATE_ROOM_MANY', 'FAIL_PRIVATE_ROOM_FORBIDDEN', 'FAIL_PRIVATE_ROOM_EXISTS', 'FAIL_PRIVATE_ROOM_NOT_FOUND', 'FAIL_PRIVATE_ROOM_INVALID_PASS', 'RECONNECT', 'FAIL_PVP_BANNED')
        for index, c in enumerate(codes):
            setattr(CODE_ERR, c, index)
            CODE_ERR._lc[index] = 'soPvPStats.CODE_ERR.%s' % c

    @staticmethod
    def getLocaliseKey(code):
        return CODE_ERR._lc[code]


CODE_ERR.init()
