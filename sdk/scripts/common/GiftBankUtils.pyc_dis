     ERROR_NO_ROOM: lc('Codes.GiftResponses.ERROR_NO_ROOM'),
     ERROR_PREMIUM: lc('Codes.GiftResponses.ERROR_PREMIUM'),
     ERROR_RET_NOTFOUND: lc('Codes.GiftResponses.ERROR_RET_NOTFOUND'),
     ERROR_UNKNOWN: 'ERROR_UNKNOWN'}

    @staticmethod
    def get(err_id):
        for name in dir(ERROR_CODE):
            if getattr(ERROR_CODE, name) == err_id:
                return '[%s]%s' % (err_id, name)

        return '[%s]???' % err_id


class EVENTS:
