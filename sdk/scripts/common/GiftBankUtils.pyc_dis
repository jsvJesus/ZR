def get_bank_param(bank_name):
    global item_bank_config
    if not item_bank_config:
        _load_bank_config()
    if bank_name in item_bank_config:
        return item_bank_config[bank_name]
    return item_bank_config['default']


def bank_is_only_read(bank_name):
    if not item_bank_config:
        _load_bank_config()
    bank_param = get_bank_param(str(bank_name))
    if not bank_param:
        bank_param = get_bank_param('default')
    return bank_param.get('only_read')


def get_send_param(bank_name, to_bank):
    if not bank_name:
        return {}
    if not item_bank_config:
        _load_bank_config()
    bank_param = get_bank_param(str(bank_name))
    if not bank_param:
        bank_param = get_bank_param('default')
    if to_bank not in bank_param:
        return bank_param.get('default', {'money': 1,
         'time': 1,
         'can_send': False})
    return bank_param[to_bank]


def _load_bank_config():
    global keeper_name_to_id
    global keeper_names_list
    py_data_section = ResMgr.openSection(path)
    data = json.loads(py_data_section.asBinary)
    for i, item in enumerate(data):
        keeper_name = item.keys()[0]
        keeper_names_list.append(keeper_name)
        item_bank_config[keeper_name] = item[keeper_name]
        keeper_name_to_id[keeper_name] = i


def get_keeper_names_list(show_hidden = True):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xbe\xd0\xb2\xd1\x89\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb2 """
    if not keeper_names_list:
        _load_bank_config()
    if show_hidden:
        return keeper_names_list
    else:
        return filter(lambda name: name not in HIDE_IN_SHOP, keeper_names_list)


def get_keeper_index(keeper_name):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xbd\xd0\xb4\xd0\xb5\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 (\xd0\xb8\xd0\xbd\xd0\xb4\xd0\xb5\xd0\xba\xd1\x81) \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xbe\xd0\xb2\xd1\x89\xd0\xb8\xd0\xba\xd0\xb0 """
    if not keeper_name_to_id:
        _load_bank_config()
    return keeper_name_to_id.get(keeper_name)


def get_keeper_name(keeper_index):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xbc\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xbe\xd0\xb2\xd1\x89\xd0\xb8\xd0\xba\xd0\xb0 \xd0\xbf\xd0\xbe \xd0\xb8\xd0\xbd\xd0\xb4\xd0\xb5\xd0\xba\xd1\x81\xd1\x83 (\xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80\xd1\x83) """
    keeper_list = get_keeper_names_list()
    if keeper_index >= len(keeper_list):
        return None
    else:
        return keeper_list[keeper_index]


def getBaseCost(tariff_id, from_bank, to_bank):
    bank_param = get_send_param(from_bank, to_bank)
    multiplier_money = bank_param.get('money', 1)
    base_cost = COST_TRANSFER[tariff_id][0] * multiplier_money
    return int(math.ceil(base_cost))


def getAllTax(tariff_id, send_money, items, from_bank, to_bank):
    bank_param = get_send_param(from_bank, to_bank)
    multiplier_money = bank_param.get('money', 1)
    money_tax = getMoneyTax(tariff_id, send_money)
    for complexItem in items:
        money_tax += item_tax(tariff_id, multiplier_money, complexItem)

    return money_tax


def getFullCost(tariff_id, send_money, items, from_bank, to_bank):
    cost = getAllTax(tariff_id, send_money, items, from_bank, to_bank)
    cost += getBaseCost(tariff_id, from_bank, to_bank)
    return cost


def getTimeTransfer(tariff_id, from_bank, to_bank):
    bank_param = get_send_param(from_bank, to_bank)
    multiplier_time = bank_param.get('time', 1)
    return TIME_TRANSFER[tariff_id] * multiplier_time