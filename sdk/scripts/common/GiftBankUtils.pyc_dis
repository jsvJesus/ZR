ReciveFilter = namedtuple('ReciveFilter', ['has_friends', 'has_ally', 'has_all'])

def parse_income_filters(filter_index):
    return ReciveFilter(has_friends=not bool(filter_index & 1), has_ally=not bool(filter_index & 2), has_all=not bool(filter_index & 4))


def batch_income_filters(recive_filter):
    filter_index = 7
    if recive_filter.has_friends:
        filter_index &= -2
    if recive_filter.has_ally:
        filter_index &= -3
    if recive_filter.has_all:
        filter_index &= -5
    return filter_index


def getMoneyTax(tariff, money, isPremium = False):
    """
            \xd0\x9d\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3 \xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd1\x8b\xd0\xbb\xd0\xb0\xd0\xb5\xd0\xbc\xd1\x8b\xd0\xb5 \xd0\xb4\xd0\xb5\xd0\xbd\xd1\x8c\xd0\xb3\xd0\xb8 \xd0\xb2 \xd0\xb7\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x81\xd0\xb8\xd0\xbc\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xbe\xd1\x82 \xd1\x82\xd0\xb0\xd1\x80\xd0\xb8\xd1\x84\xd0\xb0
            @ret: money
    """
    if tariff == TRANSFER_TYPE_BASE:
        return int(math.ceil(money * 0.05))
    if tariff == TRANSFER_TYPE_EXPRESS:
        return int(math.ceil(money * 0.1))
    if tariff == TRANSFER_TYPE_GOLD:
        return int(math.ceil(money * 0.1))
    raise ValueError('Unknow tariff %s.' % tariff)


def item_tax(tariff, multiplier_money, complexItem):
    """
            \xd0\x9d\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3 \xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x81\xd1\x8b\xd0\xbb\xd0\xb0\xd0\xb5\xd0\xbc\xd1\x8b\xd0\xb9 \xd0\xb8\xd1\x82\xd0\xb5\xd0\xbc \xd0\xb2 \xd0\xb7\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x81\xd0\xb8\xd0\xbc\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xbe\xd1\x82 \xd1\x82\xd0\xb0\xd1\x80\xd0\xb8\xd1\x84\xd0\xb0 \xd0\xb8 \xd0\xb5\xd0\xb3\xd0\xbe \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb2
            @ret: money
    """
    itemparam = ItemsCatalog.GetItemParam(complexItem['complexItemType'])
    item_cost = max(1, itemparam.get('Cost', 1))
    package_size = max(1, ItemsUtils.GetItemPackageSize(item=complexItem))
    stack_number = ItemsUtils.GetItemNumber(complexItem)
    item_weight = itemparam.get('Weight', 100.0)
    item_class = ItemsCatalog.GetItemClass(complexItem['complexItemType'])
    if item_class == ItemsCatalog.AMMO:
        stack_number = stack_number / float(package_size)
    if tariff == TRANSFER_TYPE_BASE:
        item_cost = min(20000, item_cost * 0.025)
        tax_1 = item_cost * stack_number
        tax_2 = stack_number ** 1.2
        tax_3 = item_weight * stack_number / 10.0 * 20000
        return int((tax_1 + tax_2 + tax_3) * multiplier_money)
    if tariff == TRANSFER_TYPE_EXPRESS or tariff == TRANSFER_TYPE_GOLD:
        item_cost = min(40000, item_cost * 0.041)
        tax_1 = item_cost * stack_number
        tax_2 = stack_number ** 1.39
        tax_3 = item_weight * stack_number / 10.0 * 20000
        return int((tax_1 + tax_2 + tax_3) * multiplier_money)
    raise ValueError('Unknow tariff %s.' % tariff)


