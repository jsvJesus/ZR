import math
from time import time
from Math import Matrix, Vector3
LOOP_INTERVAL = 0.01
MAX_LOOP_INTERVAL = LOOP_INTERVAL * 4
MATH_PI = math.pi
MATH_2PI = math.pi * 2

class LoopYPRSim:
    """
    \xd0\x94\xd0\xbb\xd1\x8f \xd1\x81\xd0\xb8\xd0\xbc\xd1\x83\xd0\xbb\xd1\x8f\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f
    """

    def __init__(self):
        pass

    def _reset(self):
        self.rotation = Vector3()
        self._angle = 0.0

    def set_params(self, y, p, r, speed):
        self._y = y
        self._p = p
        self._r = r
        self._speed = speed
        self._reset()

    def update(self, time_delta):
        self._angle += time_delta * self._speed
        if self._angle >= MATH_2PI:
            self._angle = 0
        elif self._angle <= -MATH_2PI:
            self._angle = 0
        y = self._y * self._angle
        p = self._p * self._angle
        r = self._r * self._angle
        self.rotation = Vector3(y, p, r)


class Spinner:

    def __init__(self, y, p, r, speed, matrix):
        self._loop_ypr_sim = LoopYPRSim()
        self._loop_ypr_sim.set_params(y, p, r, speed)
        self._start_matrix = matrix

    _last_dt = 0

    def get_new_matrix(self):
        now = time()
        dt = now - getattr(self, '_last_t', 0)
        self._last_t = now
        self._last_dt = min(dt, MAX_LOOP_INTERVAL)
        self._loop_ypr_sim.update(self._last_dt)
        m_r = Matrix()
        m_r.setRotateYPR(self._loop_ypr_sim.rotation)
        res_matrix = Matrix(self._start_matrix)
        res_matrix.preMultiply(m_r)
        return res_matrix