# Embedded file name: ./common/MessageConstants.py
from Localization import lc
import traceback
from Codes import ShopProcedureResult as SPR
from achivments import achives_parser

def _time_to_string(time):
    if time < 0:
        return '-'
    MIN = 60
    HOUR = MIN * 60
    DAY = HOUR * 24
    if time < MIN:
        return lc('ServerClientMessages.special_cases.less_min')
    days = time // DAY
    hours = time % DAY // HOUR
    mins = time % DAY % HOUR // MIN
    return lc('ServerClientMessages.special_cases.time_to_str').format(int(days), int(hours), int(mins))


def parse_special_cases(code, string_args, int_args):
    """ \xd0\xbe\xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f, \xd1\x82\xd1\x80\xd0\xb5\xd0\xb1\xd1\x83\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb5 \xd0\xbe\xd1\x82\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xb2\xd1\x8b\xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb9 """
    if code == MC.DonateBases_Messages_time_left:
        return code_to_message(code).format(_time_to_string(int_args[0]))
    elif code == MC.Quests_MassQuests_WIN_MESSAGE:
        contest_name = lc('Quests.MassQuests.{0}'.format(string_args[0]))
        return code_to_message(code).format(int_args[0], contest_name)
    elif code == MC.ItemHolder_ITEMPACK_CHANGED:
        import ItemsUtils
        item_name = ItemsUtils.GetItemName(int_args[0])
        return code_to_message(code).format(*([item_name] + int_args[1:]))
    elif code == MC.Shop_Procedure_error:
        return SPR.to_message(int_args[0])
    elif code == MC.CsPlayer_Connect_Room_Error:
        return lc('soPvPStats.soGUI.error_{0}'.format(int_args[0]))
    elif code in (MC.BaseToCapture_YOUR_CLAN_HAS_LOST_BASE, MC.BaseToCapture_YOUR_CLAN_HAS_CAPTURED_BASE):
        base_name = lc('BaseToCaptureNames.{0}'.format(string_args[0]))
        return code_to_message(code).format(base_name)
    elif code == MC.Achivs_got_ach:
        ach_name = lc(achives_parser.get_achiv(int_args[0])['name'])
        return lc('AchivGui.notify.gotach').format(ach_name)
    elif code == MC.RecipeAppended:
        import ItemsUtils
        recipe_name = ItemsUtils.GetItemName(int_args[0], fGetShortName=True)
        return code_to_message(code).format(recipe_name)
    elif code == MC.RepUser_RepChanged:
        import rep_utils
        group_id, value, old_value = int_args
        group_name = rep_utils.get_name(group_id)
        delta = value - old_value
        return code_to_message(code).format(group_name, delta, value)
    elif code == MC.RepUser_RepPointsChanged:
        import rep_utils
        group_id, points, old_points = int_args
        group_name = rep_utils.get_name(group_id)
        delta = points - old_points
        return code_to_message(code).format(group_name, delta, points)
    elif code in (MC.Clans_Messages_RECR_DUPLICATION, MC.Clans_Messages_RECR_TIMEOUT):
        import client_utils
        time_remain = client_utils.time_to_string(int_args[0])
        return code_to_message(code).format(time_remain)
    elif code in (MC.RepUser_RepChangedVirtuallyUp, MC.RepUser_RepChangedVirtuallyDown, MC.Trader_lost_fraction):
        import rep_utils
        group_name = rep_utils.get_name(int_args[0])
        return code_to_message(code).format(group_name)
    else:
        return


def code_to_message(code):
    """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 int \xd0\xb2 \xd0\xb3\xd0\xbe\xd1\x82\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 """
    return lc('ServerClientMessages.' + code_to_key(code))


def get_coded_message(code, string_args, int_args):
    try:
        text = parse_special_cases(code, string_args, int_args)
        if text:
            return text
        text = code_to_message(code)
        if not text:
            return u''
        args = [ s.decode('utf8') for s in string_args ] + list(int_args)
        return text.format(*args)
    except:
        from utils import PY
        print code, PY(string_args), PY(int_args)
        traceback.print_stack()
        print traceback.format_exc()
        return lc('ServerClientMessages.special_cases.error').format(code)


def code_to_key(code):
    """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 int \xd0\xb2 \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87 \xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xba\xd0\xb8 \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 """
    return code_to_key_dict.get(code)


def key_to_code(key):
    """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87 \xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xba\xd0\xb8 \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb2 int """
    return key_to_code_dict.get(key)


