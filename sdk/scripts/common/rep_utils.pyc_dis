class Feature:
    """ \xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd1\x81\xd0\xb8\xd0\xbd\xd1\x85\xd1\x80\xd0\xbe\xd0\xbd\xd0\xb8\xd0\xb7\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc \xd1\x81 \xd1\x82\xd1\x83\xd0\xbb\xd0\xb7\xd0\xbe\xd0\xb9 (sys/tools/reputation_editor/utils.py) """
    Political, Geographical, Professional, Singleton, Hidden = xrange(5)


class Bonus:
