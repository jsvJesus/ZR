def get_synergy(art_gr1, art_gr2):
    key = (min(art_gr1, art_gr2), max(art_gr1, art_gr2))
    return _synergy_data[key]


def parse_synergy():
    type_shield, type_absorbs, type_stats = xrange(1, 4)
    amulet_synergy_path = 'scripts/common/amulet_arts.txt'
    section = ResMgr.openSection(amulet_synergy_path)
    lines = filter(lambda l: l and '#' not in l, section.asBinary.splitlines())
    header = lines.pop(0).split('\t')
    syn_data = {}
    del header[0]
    for line in lines:
        line_data = line.split('\t')
        art1 = int(line_data.pop(0))
        for i, data in enumerate(line_data):
            art2 = int(header[i])
            if data:
                key = (min(art1, art2), max(art1, art2))
                if key in syn_data and syn_data[key] != data:
                    print 'amulet_utils: synergy error', art1, art2, syn_data[key], data
                    raise RuntimeError
                syn_data[key] = data

    result = defaultdict(lambda : deepcopy(_synergy_default_value))
    for key, data in syn_data.items():
        for action_data in data.split(';'):
            action_type, param_id, value = map(int, action_data.split(':'))
            if action_type == type_shield:
                result[key]['shield'][param_id] += value
            elif action_type == type_absorbs:
                result[key]['absorb'][param_id] += value
            elif action_type == type_stats:
                result[key]['stats'][param_id] += value
            else:
                print 'amulets_utils: wrong action type', action_data
                raise RuntimeError

    return result


_synergy_default_value = {'shield': defaultdict(int),
 'absorb': defaultdict(int),
 'stats': defaultdict(int)}
try:
    _synergy_data = parse_synergy()
except:
    traceback.print_exc()
    traceback.print_stack()
    _synergy_data = defaultdict(lambda : deepcopy(_synergy_default_value))

