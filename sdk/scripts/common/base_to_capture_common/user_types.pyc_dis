class bw_flag_data:
    """\xd0\xa1\xd0\xbc. \xd0\xb4\xd0\xbe\xd0\xba\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xbe 'Custom Property Data Types'."""

    @staticmethod
    def getDictFromObj(obj):
        flag_names = []
        heights = []
        clan_owners = []
        clan_invaders = []
        last_changes = []
        for flag_data in obj.values():
            flag_names.append(flag_data['name'])
            heights.append(flag_data['height'])
            clan_owners.append(flag_data['clan_owner_name'])
            clan_invaders.append(flag_data['clan_invader'])
            last_changes.append(flag_data['last_change'])

        return {'flag_names': flag_names,
         'heights': heights,
         'clan_owners': clan_owners,
         'clan_invaders': clan_invaders,
         'last_changes': last_changes}

    @staticmethod
    def createObjFromDict(d):
        obj = {}
        data = zip(d.flag_names, d.heights, d.clan_owners, d.clan_invaders, d.last_changes)
        for flag_name, height, clan_name, clan_invader, last_change in data:
            obj[flag_name] = {'name': flag_name,
             'height': height,
             'clan_owner_name': clan_name,
             'clan_invader': clan_invader,
             'last_change': last_change}

        return obj

    @staticmethod
    def isSameType(obj):
        return isinstance(obj, dict)