class lazyproperty(object):

    def __init__(self, func):
        self.func = func

    def __get__(self, instance, cls):
        if instance is None:
            return self
        else:
            value = self.func(instance)
            if value is not None:
                setattr(instance, self.func.__name__, value)
                setattr(instance, 'lazy_' + self.func.__name__, value)
            return value


def encode_data(data):

    def _encode_dict(data):
        result = {}
        for key, value in data.items():
            if isinstance(key, unicode):
                key = key.encode('utf-8')
            if isinstance(value, unicode):
                value = value.encode('utf-8')
            elif isinstance(value, list):
                value = _encode_list(value)
            elif isinstance(value, dict):
                value = _encode_dict(value)
            result[key] = value

        return result

    def _encode_list(data):
        result = []
        for item in data:
            if isinstance(item, unicode):
                item = item.encode('utf-8')
            elif isinstance(item, list):
                item = _encode_list(item)
            elif isinstance(item, dict):
                item = _encode_dict(item)
            result.append(item)

        return result

    result = _encode_dict(data)
    return result


class Loader(object):
    """\xd0\x91\xd0\xb0\xd0\xb7\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb3\xd1\x80\xd1\x83\xd0\xb7\xd1\x87\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb2 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85."""

    def __init__(self, path):
        self._properties_path = path

    @lazyproperty
    def loaded_properties(self):
        py_data_section = ResMgr.openSection(self._properties_path)
        try:
            props_dct = json.loads(py_data_section.asBinary, object_hook=encode_data)
        except Exception as err:
            print 'ERROR FILE:', repr(self._properties_path)
            raise err

        return props_dct

    def get_value(self, name):
        return self.loaded_properties[name]

    def all_properties(self):
        return dict(self.loaded_properties)


class BasesDataLoader(Loader):
    _instance = None

    @staticmethod
    def get_instance():
        if not BasesDataLoader._instance:
            BasesDataLoader._instance = BasesDataLoader()
        return BasesDataLoader._instance

    def __init__(self):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        self._path = 'scripts/common/data/BaseToCapture/BasesConfig.json'
        super(BasesDataLoader, self).__init__(self._path)
        self._links = defaultdict(set)
        all_properties = self.all_properties()
        for base_name, data in all_properties.iteritems():
            for link_base in data.get('links', []):
                raise link_base != base_name or AssertionError
                self._links[base_name].add(link_base)
                self._links[link_base].add(base_name)

        self._spots = {}
        for base_name in all_properties:
            if base_name in self._spots:
                continue
            spot = self.find_spot(base_name)
            if len(spot) == 1:
                continue
            for bn in spot:
                self._spots[bn] = spot

        sorted_names = sorted(all_properties.keys())
        self._ids = {}
        for i, name in enumerate(sorted_names):
            self._ids[name] = i
            self._ids[i] = name

        self._outer_links = defaultdict(dict)
        for outer_data in _outer_trade_links:
            self._outer_links[outer_data['from']][outer_data['to']] = outer_data['point']

    def get_outer_link_point(self, base_from, base_to):
        return self._outer_links.get(base_from, {}).get(base_to)

    def get_outer_links(self, base_name):
        return self._outer_links.get(base_name, {}).keys()

    def get_links(self, base_name):
        return self._links.get(base_name) or set()

    def get_id(self, base_name):
        return self._ids.get(base_name)

    def get_name(self, base_id):
        return self._ids.get(base_id)

    def get_spot(self, base_name):
        return self._spots.get(base_name)

    def find_spot(self, base_name, base_validator = None):
        searched = set()
        border = [base_name]
        while border:
            base_name = border[-1]
            del border[-1]
            searched.add(base_name)
            for near_base in self._links.get(base_name, []):
                if near_base in searched:
                    continue
                if base_validator:
                    if not base_validator(near_base):
                        continue
                border.append(near_base)

        return searched

    def guardian_cost(self, base_name, guard_name):
        """\xd0\xa6\xd0\xb5\xd0\xbd\xd0\xb0 NPC-\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb0.
        
        \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8c \xd1\x81 \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd0\xbc\xd0\xb8 'cost_ruble', 
        """
        cost = self.get_value(base_name)['prices'][guard_name]
        return cost

    def entity_cost(self, base_name, entity_type):
        cost = self.get_value(base_name)['prices'].get(entity_type)
        return cost

    def flag_cost(self, base_name):
        """\xd0\xa6\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xb4\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb0.
        
        \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8c \xd1\x81 \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd0\xbc\xd0\xb8 'cost_ruble',
        """
        cost = self.get_value(base_name)['prices']['FLAG']
        cost['gold_cost'] = 0
        return cost

    def get_fraction(self, base_name):
        return self.get_value(base_name).get('fraction')


class RewardLoader(Loader):

    def __init__(self):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        self._path = 'scripts/common/data/BaseToCapture/BasesConfig.json'
        super(RewardLoader, self).__init__(self._path)

    def get_reward(self, base_name, is_winner, is_attack):
        base_param = self.get_value(base_name)['reward']
        key = 'win' if is_winner else 'fail'
        reward_param = base_param.get(key, {})
        key = 'attack' if is_attack else 'defence'
        return reward_param.get(key, {})

    def get_fraction(self, base_name):
        return self.get_value(base_name).get('fraction', 0)

    def get_friend_coeff(self, base_name):
        return self.get_value(base_name).get('reward', {}).get('friend_help_coef', 1)


