# Embedded file name: ./common/a64tool.py
"""
 a64tool  \xd0\xbc\xd0\xbe\xd0\xb4\xd1\x83\xd0\xbb\xd1\x8c \xd0\xba\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb8 - \xd0\xb4\xd0\xb5\xd0\xba\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb8 \xd1\x87\xd0\xb8\xd1\x81\xd0\xb5\xd0\xbb \xd0\xb2 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xb8\xd0\xb7 64 \xd0\xb1\xd0\xb8\xd1\x82\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xb1\xd1\x83\xd0\xba\xd0\xb2


"""
_abc = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_+'
_negative = '-'
char_i = {}
i_char = {}
for i, char in enumerate(_abc):
    i_char[i] = char
    if char in char_i:
        print 'error:', (i, char), char
        raise ValueError
    char_i[char] = i

raise len(i_char) == 64 or AssertionError

def int_to_a64(input_n):
    n = int(input_n)
    chars = ''
    if n < 0:
        chars = _negative
        n *= -1
    counter = 0
    while n:
        counter += 1
        if counter > 1000:
            raise ValueError('input_n=%s, n=%s' % (input_n, n))
        chars += i_char[n & 63]
        n = n >> 6

    return chars


def a64_to_int(chars):
    res = 0
    mul = 1
    for c in chars[::-1]:
        if c == _negative:
            mul = -1
        else:
            n = char_i[c]
            res = n + (res << 6)

    return res * mul


if __name__ == '__main__':
    import random
    for _ in range(10):
        n = random.randint(-18446744073709551616L, 18446744073709551616L)
        char = int_to_a64(n)
        back_n = a64_to_int(char)
        print
        print 'n=      ', n
        print 'char=   ', char
        print 'back_n= ', back_n
        raise n == back_n or AssertionError