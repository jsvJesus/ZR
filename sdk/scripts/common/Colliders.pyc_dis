# Embedded file name: ./common/Colliders.py
import ResMgr
import BigWorld
from Config.Damage import get_body_zone
COLLIDER_NODE_NAME = 'nodeName'
COLLIDER_BOX_NAME = 'boxName'
COLLIDER_BODY_ZONE = 'bodyZone'
COLLIDER_MIN_BOUNDS = 'minBounds'
COLLIDER_MAX_BOUNDS = 'maxBounds'
COLLIDER_TRANSFORM = 'transform'

def get_colliders_cfg(file_path, do_reload = False):
    """ Load colliders configuration from xml as exported from 3DMax.
    
            Example:
            <Worm.xml>
              <SkeletonCollider>
                <BoxAttachment>
                  <nodeName>Bone01</nodeName>
                  <boxName>head_Bone01_bwhitbox</boxName>
                  <bodyZone>HEAD</bodyZone>
                  <minBounds>-0.827802 -0.044755 -0.040000</minBounds>
                  <maxBounds>0.962385 0.044755 0.040000</maxBounds>
                </BoxAttachment>
                <BoxAttachment>
                    ...
                </BoxAttachment>
                ...
              </SkeletonCollider>
            </Worm.xml>
    """
    cfg = []
    if BigWorld.component != 'client':
        return cfg
    else:
        if do_reload:
            ResMgr.purge(file_path)
        data = ResMgr.openSection(file_path)
        if data is None:
            print 'WARNING colliders! not found', repr(file_path)
            import traceback
            traceback.print_stack()
            return cfg
        for entry in data.values():
            if entry.name == 'BoxAttachment':
                obj = {COLLIDER_NODE_NAME: entry[COLLIDER_NODE_NAME].asString,
                 COLLIDER_BOX_NAME: entry[COLLIDER_BOX_NAME].asString,
                 COLLIDER_MIN_BOUNDS: entry[COLLIDER_MIN_BOUNDS].asVector3,
                 COLLIDER_MAX_BOUNDS: entry[COLLIDER_MAX_BOUNDS].asVector3}
                if entry.has_key(COLLIDER_BODY_ZONE) and entry[COLLIDER_BODY_ZONE].asString:
                    obj[COLLIDER_BODY_ZONE] = get_body_zone(entry[COLLIDER_BODY_ZONE].asString)
                if entry.has_key(COLLIDER_TRANSFORM):
                    obj[COLLIDER_TRANSFORM] = entry[COLLIDER_TRANSFORM].asMatrix
                    obj[COLLIDER_TRANSFORM].translation = obj[COLLIDER_TRANSFORM].translation
                cfg.append(obj)

        return cfg