def cvtColor(old_color):
    old_color = old_color.replace(' ', '')
    return '<color=%s>' % ''.join((str(int(old_color[x * 2:x * 2 + 2], 16)).zfill(3) for x in xrange(len(old_color) / 2) if x != 0))


def hex2rgba(old_color):
    return [ int(old_color[x * 2:x * 2 + 2], 16) for x in xrange(len(old_color) / 2) if x != 0 ]


def rgba_to_hex(rgba):
    return '\\c{0:02x}{1:02x}{2:02x}{3:02x};'.format(*rgba)


def rgba_to_xml(rgba):
    return '<color={0:0=3d}{1:0=3d}{2:0=3d}{3:0=3d}>'.format(*rgba)


