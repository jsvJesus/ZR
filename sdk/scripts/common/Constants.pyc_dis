class KnowledgeTypes:
    _codes = range(7)
    _names = ('UNDEFINE', 'FAMILIARITY', 'COORD', 'FRACTION', 'CHAPTER', 'CHOICE', 'TEXT')
    _code2name = dict(zip(_codes, _names))
    _name2code = dict(zip(_names, _codes))
    UNDEFINE, ACQUAINTANCE, COORD, FRACTION, CHAPTER, CHOICE, TEXT = _codes

    @classmethod
    def to_str(cls, code):
        return cls._code2name.get(code, '')

    @classmethod
    def to_code(cls, name):
        return cls._name2code.get(name, 0)


