class FROD_STATUS:
    ACTIVE = 0
    FROD = 1
    TRUSTED = 2

    @staticmethod
    def getName(status):
        if FROD_STATUS.ACTIVE == status:
            return 'ACTIVE'
        if FROD_STATUS.FROD == status:
            return 'FROD'
        if FROD_STATUS.TRUSTED == status:
            return 'TRUSTED'
        return 'INDEF %s' % status


