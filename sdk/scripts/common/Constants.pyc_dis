class EnterCheckTriggerType:
    Rep29, = range(1)

    @staticmethod
    def check_trigger(avatar, trigger_type):
        check_bit = 1 << trigger_type
        if avatar.enter_check_triggers & check_bit == 0:
            avatar.enter_check_triggers |= check_bit
            return True
        return False


