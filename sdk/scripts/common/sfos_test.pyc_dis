# Embedded file name: ./common/sfos_test.py
import sys
import os

def _parse_opt(line):
    opt_dict = {}
    for opt in line.split('-'):
        opt = opt.strip()
        data = opt.split('=', 1)
        if len(data) == 2:
            opt_dict['class'] = data[1]
            continue
        data = opt.split(' ', 1)
        if len(data) != 2:
            continue
        name_opt, val = data
        opt_dict[name_opt] = val.lower()

    return opt_dict


def _parse_settings(path):
    porgs = []
    classes = {}
    with open(path) as f_obj:
        for line in f_obj:
            line = line.strip()
            if line.startswith('filter='):
                opt = _parse_opt(line)
                if 'prog' not in opt:
                    continue
                porgs.append(opt)
            if line.startswith('class='):
                opt = _parse_opt(line)
                classes[opt['class']] = opt

    return (porgs, classes)


def test_delay():
    path = os.path.join(os.environ.get('ProgramData'), 'cFos/cFosSpeed/settings.ini')
    if not os.path.isfile(path):
        return False
    fname = os.path.basename(sys.executable).lower()
    porgs, classes = _parse_settings(path)
    for opt in porgs:
        if fname not in opt['prog']:
            continue
        _class_name = opt.get('c')
        if not _class_name:
            continue
        _class = classes.get(_class_name)
        if not _class:
            continue
        delay = _class.get('delay')
        if delay and delay.isdigit():
            if int(delay) > 300:
                return delay


if __name__ == '__main__':
    print test_delay()