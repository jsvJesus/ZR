def getLokalizedSpaceNameByName(space_name, default = None):
    space_name = space_name.replace('spaces/', '')
    if not default:
        default = lc('spaceName.UNKNOWN_REGION') + ' ' + space_name
    if not space_name:
        return default
    name = lc('spaceName.space.%s' % space_name, default=default)
    if name == space_name:
        name = lc('DonateBases.name.%s' % space_name, default=default)
    return name


def get_space_names_from_mask(mask):
    index = 0
    result = []
    while mask:
        if mask & 1:
            result.append(_space_index_to_name[index])
        mask >>= 1
        index += 1

    return result


def get_all_spaces():
    return _space_index_to_name.items()


def get_static_id_by_dynamic_id(dynamic_id):
    """ sever only """
    if not dynamic_id:
        return 0
    from server_utils import getSpaceNameCachedShort
    space_name = getSpaceNameCachedShort(dynamic_id)
    if not space_name:
        return 0
    return get_space_id_by_name(space_name) or 0


def get_space_id_by_name(space_name):
    """ \xd0\xbd\xd0\xb5 \xd0\xbf\xd1\x83\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81 \xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb0\xd0\xbc\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd0\xba\xd0\xb8\xd0\xbc spaceID, \xd0\xb7\xd0\xb4\xd0\xb5\xd1\x81\xd1\x8c space_id \xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd0\xb8\xd1\x87\xd0\xbd\xd1\x8b\xd0\xb9 """
    return _space_name_to_index.get(space_name)


def get_short_space_name_by_id(space_id):
    return _space_index_to_name.get(space_id)


def get_long_space_name_by_id(space_id):
    short_name = get_short_space_name_by_id(space_id)
    if short_name:
        return 'spaces/' + short_name


_space_index_to_name = {}
_space_name_to_index = {}
section = ResMgr.openSection('scripts/common/data/Spaces.xml')
for _, s in section.items():
    space_index = s['id'].asInt
    space_name = s['dir'].asString
    _space_index_to_name[space_index] = space_name
    _space_name_to_index[space_name] = space_index

priority_by_space_id = {}
for i in range(len(_priority)):
    priority_by_space_id[get_space_id_by_name(_priority[i])] = i

del _priority