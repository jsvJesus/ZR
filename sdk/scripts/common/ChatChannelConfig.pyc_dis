# Embedded file name: ./common/ChatChannelConfig.py
"""\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x87\xd1\x82\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb8 \xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xba\xd0\xb8 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd1\x83\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb8\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xb0\xd0\xba\xd0\xba\xd0\xb0\xd1\x83\xd0\xbd\xd1\x82\xd0\xbe\xd0\xb2."""
import copy
import json
import ResMgr
from utils import Singlton, ReadOnly

class ChannelConfig(Singlton):

    def initialization(self):
        self.path = 'scripts/common/data/ChatChannels.json'
        self._data = self._read_channel_data()

    def _read_channel_data(self):
        py_data_section = ResMgr.openSection(self.path)
        raw_configs = json.loads(py_data_section.asBinary)
        return raw_configs

    def channel_data(self):
        lst = []
        for channel in self._data['channels']:
            dct = copy.deepcopy(channel)
            dct.pop('constant_name')
            lst.append(dct)

        return lst

    def get_constants(self):
        """
        \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8c, \xd1\x83 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87 - \xd0\xb8\xd0\xbc\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd1\x82\xd1\x8b 
        (\xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd1\x80, "SYSTEM"), \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 - int.
        """
        dct = {}
        for channel in self._data['channels']:
            constant_name = channel['constant_name']
            value = channel['id']
            dct[constant_name] = value

        return dct

    def get_sounds(self):
        dct = {}
        for channel in self._data['channels']:
            sound = channel.get('sound')
            ch_id = channel['id']
            if sound:
                dct[ch_id] = sound

        return dct


class ChannelConsts(Singlton, ReadOnly):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd1\x82\xd1\x8b \xd0\xba\xd0\xb0\xd0\xbd\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb2.
    
    \xd0\x97\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82\xd1\x81\xd1\x8f \xd0\xb8\xd0\xb7 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd0\xb0 ChatChannels.json
    """

    def initialization(self):
        c_conf = ChannelConfig()
        self.const_names = {}
        self.sounds = c_conf.get_sounds()
        for attr_name, value in c_conf.get_constants().items():
            setattr(self, attr_name, value)
            self.const_names[value] = attr_name


CHANNEL_CONSTS = ChannelConsts()