# Embedded file name: ./common/GesturesCommon.py
import GesturesUtils
SIT_GESTURES = [18,
 19,
 20,
 21]

class GesturesCommon:

    def __init__(self):
        pass

    def isSitPose(self, sit_id):
        return sit_id in SIT_GESTURES

    def isSitting(self):
        if not self.usingGesture:
            return 0
        data = GesturesUtils.get_anim_action(self.usingGesture)
        if not data:
            return False
        return data.get('id') in SIT_GESTURES

    def getSitPose(self):
        data = GesturesUtils.get_anim_action(self.usingGesture)
        if not data:
            return 0
        if not self.usingGesture:
            return 0
        if data.get('id') in SIT_GESTURES:
            return data.get('id')
        return 0