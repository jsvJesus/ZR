class DialogPender:
    NOT_PENDING, STARTED, REQUEST_QUESTS_FROM_DIALOG, REWARDING, COMPLETING, MONEY_EVENT = xrange(6)


BUY_REP_PRICE = 30

class DialogAdditionalData:
    MustBreak, CabCheckIn, ControllerPath = range(3)

    @staticmethod
    def parse(int_data):
        cursor = 0
        result = {}
        while cursor < len(int_data):
            data_type = int_data[cursor]
            if data_type == DialogAdditionalData.MustBreak:
                result[data_type] = None
            elif data_type in (DialogAdditionalData.CabCheckIn, DialogAdditionalData.ControllerPath):
                cursor += 1
                result[data_type] = int_data[cursor]
            else:
                raise NotImplementedError
            cursor += 1

        return result