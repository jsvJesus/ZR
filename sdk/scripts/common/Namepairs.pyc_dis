def get_scientists():
    section = ResMgr.openSection('local/Russian/Namepairs.xml')
    names = [ 'Namepairs.scientists.names.%s' % k for k in section['scientists']['names'].keys() ]
    surnames = [ 'Namepairs.scientists.surnames.%s' % k for k in section['scientists']['surnames'].keys() ]
    return dict(names=names, surnames=surnames)


scientists = get_scientists()

def getRandomFullName(npc_role = None):
    if npc_role is None:
        first_name = random.choice(names.values())
        second_name = random.choice(surnames.values())
    else:
        first_name = random.choice(scientists['names'])
        second_name = random.choice(scientists['surnames'])
    return '{0} {1}'.format(first_name, second_name)