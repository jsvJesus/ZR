# Embedded file name: ./common/blender_object.py
import time
from Helpers.BWCoroutine import BWCoroutine, BWWaitForPeriod

class Blender:

    def __init__(self, tick_time, total_time):
        self._coro = None
        self._tick_time = tick_time
        self._total_time = total_time
        return

    def run_blend(self, callback):
        if self._coro:
            self._coro.stop()
        self._coro = self._blend(self, callback)
        self._coro.run()

    @BWCoroutine
    def _blend(self, callback):
        start_time = time.time()
        weight = 0
        while weight < 1:
            yield BWWaitForPeriod(self._tick_time)
            delta_time = time.time() - start_time
            weight = min(1, delta_time / self._total_time)
            callback(weight)

        self._coro = None
        return