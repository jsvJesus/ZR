# Embedded file name: ./common/app_version.py
from ctypes import *
import os
import subprocess
import array

def _get_file_version_cmd(filename):
    filename = os.path.abspath(filename)
    filename = filename.replace('/', '\\')
    filename = filename.replace('\\', '\\\\')
    cmd = 'wmic datafile where name="%s" get Version /value ' % filename
    _proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE)
    res, _err = _proc.communicate()
    res = res.strip()
    return res


def get_version(filename):
    str_ver = _get_file_version_cmd(filename)
    if not str_ver:
        return None
    else:
        str_ver = str_ver.split('=')[-1]
        version = map(int, str_ver.split('.'))
        return tuple(version)


def get_file_info(filename, info = 'FileVersion'):
    """
    Extract information from a file.
    """
    size = windll.version.GetFileVersionInfoSizeA(filename, None)
    if not size:
        return ''
    else:
        res = create_string_buffer(size)
        windll.version.GetFileVersionInfoA(filename, None, size, res)
        r = c_uint()
        l = c_uint()
        windll.version.VerQueryValueA(res, '\\VarFileInfo\\Translation', byref(r), byref(l))
        if not l.value:
            return ''
        codepages = array.array('H', string_at(r.value, l.value))
        codepage = tuple(codepages[:2].tolist())
        windll.version.VerQueryValueA(res, ('\\StringFileInfo\\%04x%04x\\' + info) % codepage, byref(r), byref(l))
        return string_at(r.value, l.value)


if __name__ == '__main__':
    print get_file_info('../../../../game/x64/sogame.exe', 'FileVersion')
    print repr(get_file_version_cmd('../../../../game/x64/sogame.exe'))