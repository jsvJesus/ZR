def not_safe_animation_callback(foo):

    def wrap(*w, **kw):
        return foo(*w, **kw)

    wrap.not_safe_call = True
    return wrap


def execute_db_command(command, callback, *args, **kargs):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbe sql-\xd0\xb8\xd0\xbd\xd1\x8a\xd0\xb5\xd0\xba\xd1\x86\xd0\xb8\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb5 \xd1\x81\xd1\x80\xd0\xb5\xd0\xb4\xd1\x81\xd1\x82\xd0\xb2\xd0\xbe """
    args = list(args)
    for i in xrange(len(args)):
        args[i] = escape_value(args[i])

    for key in kargs:
        kargs[key] = escape_value(kargs[key])

    try:
        command = command.format(*args, **kargs)
    except:
        print 'sql utils ERROR', (args, kargs)
        raise

    BigWorld.executeRawDatabaseCommand(command, callback)


def escape_value(value):
    if isinstance(value, str):
        return escape_string(value)
    elif isinstance(value, unicode):
        return escape_unicode(value)
    else:
        return escape_string(str(value))


def escape_string(value):
    value = value.replace('\\', '\\\\')
    value = value.replace('\x00', '\\0')
    value = value.replace('\n', '\\n')
    value = value.replace('\r', '\\r')
    value = value.replace('\x1a', '\\Z')
    value = value.replace("'", "\\'")
    value = value.replace('"', '\\"')
    value = value.replace('\x08', '\\b')
    value = value.replace('\t', '\\t')
    value = value.replace('\x1a', '\\z')
    value = value.replace('%', '\\%')
    return value


_escape_table = [ unichr(x) for x in xrange(128) ]
_escape_table[0] = u'\\0'
_escape_table[ord('\\')] = u'\\\\'
_escape_table[ord('\n')] = u'\\n'
_escape_table[ord('\r')] = u'\\r'
_escape_table[ord('\x1a')] = u'\\Z'
_escape_table[ord('"')] = u'\\"'
_escape_table[ord("'")] = u"\\'"
_escape_table[ord('\x08')] = u'\\b'
_escape_table[ord('\t')] = u'\\t'
_escape_table[ord('\x1a')] = u'\\z'
_escape_table[ord('%')] = u'\\%'

def escape_unicode(value):
    return value.translate(_escape_table)