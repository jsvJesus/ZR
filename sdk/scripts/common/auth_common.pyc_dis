class AuthEntity:

    def isLoginPaswAcc(self):
        return ACCOUNT_TYPE.isGoldAcc(self.actype)

    def isThirdPartyAuthAcc(self):
        return not ACCOUNT_TYPE.isGoldAcc(self.actype)

    def isSteamOrMGAcc(self):
        return ACCOUNT_TYPE.isSteamOrMGAcc(self.actype)

    def isSteamAcc(self):
        return ACCOUNT_TYPE.isSteamAcc(self.actype)

    def isMyGamesAcc(self):
        return ACCOUNT_TYPE.isMyGamesAcc(self.actype)

    def isGoldAcc(self):
        return ACCOUNT_TYPE.isGoldAcc(self.actype)

    def isGoldEmbdPaymentAcc(self):
        return ACCOUNT_TYPE.isRuUkassaPaymentAcc(self.actype)


class ACCOUNT_TYPE:
    ERROR = 0
    SITE = 1
    STEAM = 2
    MG = 3
    VK = 4
    OK = 5
    YANDEX = 6
    GOOGLE = 7
    EPIC = 8
    MAILRU = 9
    prefix = {SITE: 'SITE:',
     STEAM: 'STEAM:',
     MG: 'MG:',
     VK: 'VK:',
     OK: 'OK:',
     YANDEX: 'YANDEX:',
     GOOGLE: 'GOOGLE:',
     EPIC: 'EPIC:',
     MAILRU: 'MAILRU:'}
    btns_url = {MAILRU: '/btns/mailru',
     GOOGLE: '/btns/google',
     YANDEX: '/btns/yandex',
     VK: '/btns/vk',
     OK: '/btns/ok',
     EPIC: '/btns/eg'}
    ddspath = {MAILRU: 'soGUI/frame/loginwin/mail.dds',
     GOOGLE: 'soGUI/frame/loginwin/google.dds',
     YANDEX: 'soGUI/frame/loginwin/yandex.dds',
     VK: 'soGUI/frame/loginwin/vk.dds',
     OK: 'soGUI/frame/loginwin/odnoklass.dds',
     EPIC: 'soGUI/frame/loginwin/epic.dds',
     STEAM: 'soGUI/frame/loginwin/steam.dds',
     MG: 'soGUI/frame/loginwin/vkplay.dds'}

    @staticmethod
    def isSteamOrMGAcc(actype):
        return ACCOUNT_TYPE.isSteamAcc(actype) or ACCOUNT_TYPE.isMyGamesAcc(actype)

    @staticmethod
    def isSteamAcc(actype):
        return actype == ACCOUNT_TYPE.STEAM

    @staticmethod
    def isMyGamesAcc(actype):
        return actype == ACCOUNT_TYPE.MG

    @staticmethod
    def isGoldAcc(actype):
        return actype == ACCOUNT_TYPE.SITE

    @staticmethod
    def isRuUkassaPaymentAcc(actype):
        return actype in (ACCOUNT_TYPE.VK,
         ACCOUNT_TYPE.OK,
         ACCOUNT_TYPE.YANDEX,
         ACCOUNT_TYPE.GOOGLE,
         ACCOUNT_TYPE.MAILRU,
         ACCOUNT_TYPE.EPIC)


