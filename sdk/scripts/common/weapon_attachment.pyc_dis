def rot_matrix(pos, ypr, pre_mult = True):
    m_left = Matrix()
    m_left.setRotateYPR(ypr)
    m_ = Matrix()
    m_.setTranslate(pos)
    if pre_mult:
        m_left.preMultiply(m_)
    else:
        m_left.postMultiply(m_)
    return m_left


class WeaponAttachment(object):
    TMP_LIGHT_COUNT = 0

    def __init__(self, parentAttach = None, itemID = 0, itemType = 0, COLORISEID = (0, 0), attachPosY = 0.0, parentItemID = 0, parentNodeID = None, sub_prop = None, parent_entity = None, weapon_id = 0):
