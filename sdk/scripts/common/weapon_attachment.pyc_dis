    def getLODColor(self, def_value = (255, 0, 0, 255)):
        if self._COLORISEID and any(self._COLORISEID):
            r1, g1, b1, r2, g2, b2, camo_id = ItemsUtils.int64ToColor(self._COLORISEID[0])
            r3, g3, b3, r4, g4, b4, dayEnd = ItemsUtils.int64ToColor(self._COLORISEID[1])
            return ((r1 + r2 + r3 + r4) * 0.25,
             (g1 + g2 + g3 + g4) * 0.25,
             (b1 + b2 + b3 + b4) * 0.25,
             255)
        else:
            lod_color = self.getProp().get('LOD_COLOR')
            if lod_color:
                return lod_color
            if self.getItemType() in DyeConstant.item_colours:
                ret_color = [0,
                 0,
                 0,
                 255]
                res = StalkerModel.getColorsFromModel(self.getModel(), None, 'tint_weapon')
                if res:
                    for key, ch_color in res.items():
                        for i in xrange(3):
                            ret_color[i] += ch_color[i]

                    for i in xrange(3):
                        ret_color[i] *= 0.25

                    return tuple(ret_color)
            return def_value

    def getLODVisible(self, def_value = True):
