class BaseGuardianType():
    GUARD_SIMPLE, GUARD_PATROL, GUARD_SNIPER = xrange(3)

    @staticmethod
    def get_name_type(guard_type):
        if guard_type == BaseGuardianType.GUARD_SIMPLE:
            return 'simple_guard'
        elif guard_type == BaseGuardianType.GUARD_PATROL:
            return 'patrol_guard'
        elif guard_type == BaseGuardianType.GUARD_SNIPER:
            return 'sniper_guard'
        else:
            return None

    @staticmethod
    def get_type_name(guard_name):
        return ['simple_guard', 'patrol_guard', 'sniper_guard'].index(guard_name)

    @staticmethod
    def get_names():
        return [ BaseGuardianType.get_name_type(i) for i in xrange(3) ]