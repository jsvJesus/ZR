    def ReleaseRestriction(self, channel):
        curr_time = time.time()
        self.restrictions[channel] = curr_time

    def canShoot(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        if not self.CheckRestriction(CHANNEL_ITEMS):
            if self.is_gunpoint:
                return True
            return False
        return not self.sprinting and not self.binoculing and not self.is_throwing

    def canSprint(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        if self.dead or self.crouching_or_crawling or self.binoculing:
            return False
        if utils_bw.isClient():
            if self.is_throwing:
                return True
            if self._is_using_mode():
                return True
            return self.CheckRestriction(CHANNEL_ITEMS, check_server=False)
        return self.CheckRestriction(CHANNEL_ITEMS)

    def canCrouch(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.sprinting and not self.dead

    def canCrawl(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.dead

    def canJump(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.crouching_or_crawling and self.CheckRestriction(CHANNEL_ITEMS)

    def canPickUp(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.sprinting and not self.dead and self.CheckRestriction(CHANNEL_ITEMS)

    def canUse(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.sprinting and not self.dead

    def canReload(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.sprinting and not self.dead

    def canLoadAmmo(self, id):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.sprinting and not self.dead

    def canEquip(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.dead

    def canDrop(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.dead

    def canInformJamm(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.sprinting and not self.dead

    def canThrowStone(self):
        if not self.canShoot() or not self.canDamage or self.isSitting():
            return False
        return True

    def canBinoculing(self):
        if utils_bw.isClient() and self.is_hoist_flag:
            return False
        return not self.IsAvatarSniping() and not self.sprinting and not self.dead