# Embedded file name: ./common/WayFollowerCommon.py
from PathFollower import const

class WayFollowerCommon:

    def is_paused_in_channel(self, channel, pause = None):
        if pause is None:
            pause = self.pause
        return bool(pause & 1 << channel)

    @property
    def is_paused(self):
        return bool(self.pause)

    @property
    def isInjury(self):
        return self.is_paused_in_channel(const.PAUSE_HEAL) or self.is_paused_in_channel(const.PAUSE_DEAD)

    @property
    def isIdle(self):
        if not self.is_paused:
            return False
        if self.isInjury:
            return False
        if self.is_paused_in_channel(const.PAUSE_START):
            return False
        return True

    def getPausedStr(self):
        ret = ''
        for p_id, p_name in const.PAUSE_NAMES.items():
            if self.is_paused_in_channel(p_id):
                ret += ' [%s]%s' % (p_id, p_name)

        return ret or 'NO'