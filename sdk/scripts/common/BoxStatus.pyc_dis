    LOW_DAMAGED 69%-30% \xd1\x85\xd0\xbf- \xd1\x82\xd0\xb8\xd0\xbd\xd1\x82 \xd1\x8f\xd1\x89\xd0\xb8\xd0\xba\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9(\xd0\x96\xd0\xb5\xd0\xbb\xd1\x82\xd1\x8b\xd0\xb9 \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82).
    DAMAGED         29%-1% \xd1\x85\xd0\xbf- \xd1\x82\xd0\xb8\xd0\xbd\xd1\x82 \xd1\x8f\xd1\x89\xd0\xb8\xd0\xba\xd0\xb0 \xd1\x81\xd0\xb8\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9(\xd0\x9a\xd1\x80\xd0\xb0\xd1\x81\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82).
    DEAD            0% \xd1\x85\xd0\xbf - \xd1\x80\xd0\xb0\xd0\xb7\xd1\x80\xd1\x83\xd1\x88\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xb0\xd1\x8f \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c \xd1\x8f\xd1\x89\xd0\xb8\xd0\xba\xd0\xb0(\xd0\xa7\xd0\xb5\xd1\x80\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x86\xd0\xb2\xd0\xb5\xd1\x82)- \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb6.
    COMPLETE        \xd0\xaf\xd1\x89\xd0\xb8\xd0\xba \xd0\xb4\xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd (\xd1\x81 \xd0\xb3\xd0\xb0\xd0\xbb\xd0\xbe\xd1\x87\xd0\xba\xd0\xbe\xd0\xb9) - \xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbd\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x8f \xd0\xb2\xd0\xb7\xd1\x8f\xd1\x82\xd1\x8c \xd0\xb8 \xd0\xbe\xd0\xbd \xd0\xbd\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x83\xd1\x80\xd0\xbe\xd0\xbd \xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xb0\xd0\xb3\xd1\x80\xd0\xb8\xd1\x82 \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xb5\xd0\xb1\xd1\x8f \xd0\xbc\xd1\x83\xd1\x82\xd0\xb0\xd0\xbd\xd1\x82\xd0\xbe\xd0\xb2.
    
    """
    NORMAL, LOW_DAMAGED, DAMAGED, DEAD, COMPLETE = range(5)
    status2name = {NORMAL: 'normal',
     LOW_DAMAGED: 'low_damaged',
     DAMAGED: 'damaged',
     DEAD: 'dead',
     COMPLETE: 'complete'}

    @staticmethod
    def get_path():
        if BigWorld.component in ('server', 'editor'):
            path = '../../../res/scripts/common/data/box_models.pyson'
        else:
            path = 'scripts/common/data/box_models.pyson'
        return path

    @staticmethod
    def get_status(health_ratio):
        if health_ratio >= 0.7:
            return BoxStatus.NORMAL
        if health_ratio < 0.7 and health_ratio >= 0.3:
            return BoxStatus.LOW_DAMAGED
        if health_ratio < 0.3 and health_ratio > 0:
            return BoxStatus.DAMAGED
        return BoxStatus.DEAD

    @staticmethod
    def get_model_by_type(box_type, status):
        global DATA
        BoxStatus.load_data()
        default_model = DATA[box_type].get(BoxStatus.status2name[BoxStatus.NORMAL], 'models/entities/movable_box.model')
        return DATA[box_type].get(BoxStatus.status2name[status], default_model)

    @staticmethod
    def load_data():
        global DATA
        if not DATA:
            section = ResMgr.openSection(BoxStatus.get_path())
            DATA = pyson.loads(section.asBinary)
        return DATA

    @staticmethod
    def get_name_by_type(box_type):
        BoxStatus.load_data()
        return DATA.get(box_type, DATA[-1]).get('name')

    @staticmethod
    def get_anim_by_type(box_type):
        BoxStatus.load_data()
        return DATA.get(box_type, DATA[-1]).get('anim')