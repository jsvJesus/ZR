from Math import Vector3
from math import sqrt
import heapq

def closer_distance(point, p1, p2):
    if p1 is None:
        return p2
    elif p2 is None:
        return p1
    d1 = p1.distSqrTo(point)
    d2 = p2.distSqrTo(point)
    if d1 < d2:
        return p1
    else:
        return p2


class PriorityQueue:

    def __init__(self):
        self._elements = []

    def clear(self):
        self._elements[:] = []

    def empty(self):
        return bool(not self._elements)

    def put(self, item, priority):
        heapq.heappush(self._elements, (priority, item))

    def get(self):
        return heapq.heappop(self._elements)[1]


class Triangle:

    def __init__(self, p0, p1, p2, pp, n):
        self.points = (p0, p1, p2)
        self.p0, self.p1, self.p2 = self.points
        self.pivot = pp
        self.n = n
        self.neigbours = []
        self.portals = []
        self.costs = []

    def add_neigbour(self, neigbour, portal, cost):
        self.neigbours.append(neigbour)
        self.costs.append(cost)
        self.portals.append(portal)

    def get_portal(self, other):
        return self.portals[self.neigbours.index(other)]

    def to_point_distance(self, P):
        B = Vector3(self.p0)
        E0 = Vector3(self.p1) - B
        E1 = Vector3(self.p2) - B
        D = B - P
        a = E0.dot(E0)
        b = E0.dot(E1)
        c = E1.dot(E1)
        d = E0.dot(D)
        e = E1.dot(D)
        f = D.dot(D)
        det = a * c - b * b
        s = b * e - c * d
        t = b * d - a * e
        if s + t <= det:
            if s < 0.0:
                if t < 0.0:
                    if d < 0:
                        t = 0.0
                        if -d >= a:
                            s = 1.0
                            sqrdistance = a + 2.0 * d + f
                        else:
                            s = -d / a
                            sqrdistance = d * s + f
                    else:
                        s = 0.0
                        if e >= 0.0:
                            t = 0.0
                            sqrdistance = f
                        elif -e >= c:
                            t = 1.0
                            sqrdistance = c + 2.0 * e + f
                        else:
                            t = -e / c
                            sqrdistance = e * t + f
                else:
                    s = 0
                    if e >= 0:
                        t = 0
                        sqrdistance = f
                    elif -e >= c:
                        t = 1
                        sqrdistance = c + 2.0 * e + f
                    else:
                        t = -e / c
                        sqrdistance = e * t + f
            elif t < 0:
                t = 0
                if d >= 0:
                    s = 0
                    sqrdistance = f
                elif -d >= a:
                    s = 1
                    sqrdistance = a + 2.0 * d + f
                else:
                    s = -d / a
                    sqrdistance = d * s + f
            else:
                invDet = 1.0 / det
                s = s * invDet
                t = t * invDet
                sqrdistance = s * (a * s + b * t + 2.0 * d) + t * (b * s + c * t + 2.0 * e) + f
        elif s < 0.0:
            tmp0 = b + d
            tmp1 = c + e
            if tmp1 > tmp0:
                numer = tmp1 - tmp0
                denom = a - 2.0 * b + c
                if numer >= denom:
                    s = 1.0
                    t = 0.0
                    sqrdistance = a + 2.0 * d + f
                else:
                    s = numer / denom
                    t = 1 - s
                    sqrdistance = s * (a * s + b * t + 2 * d) + t * (b * s + c * t + 2 * e) + f
            else:
                s = 0.0
                if tmp1 <= 0.0:
                    t = 1
                    sqrdistance = c + 2.0 * e + f
                elif e >= 0.0:
                    t = 0.0
                    sqrdistance = f
                else:
                    t = -e / c
                    sqrdistance = e * t + f
        elif t < 0.0:
            tmp0 = b + e
            tmp1 = a + d
            if tmp1 > tmp0:
                numer = tmp1 - tmp0
                denom = a - 2.0 * b + c
                if numer >= denom:
                    t = 1.0
                    s = 0
                    sqrdistance = c + 2.0 * e + f
                else:
                    t = numer / denom
                    s = 1 - t
                    sqrdistance = s * (a * s + b * t + 2.0 * d) + t * (b * s + c * t + 2.0 * e) + f
            else:
                t = 0.0
                if tmp1 <= 0.0:
                    s = 1
                    sqrdistance = a + 2.0 * d + f
                elif d >= 0.0:
                    s = 0.0
                    sqrdistance = f
                else:
                    s = -d / a
                    sqrdistance = d * s + f
        else:
            numer = c + e - b - d
            if numer <= 0:
                s = 0.0
                t = 1.0
                sqrdistance = c + 2.0 * e + f
            else:
                denom = a - 2.0 * b + c
                if numer >= denom:
                    s = 1.0
                    t = 0.0
                    sqrdistance = a + 2.0 * d + f
                else:
                    s = numer / denom
                    t = 1 - s
                    sqrdistance = s * (a * s + b * t + 2.0 * d) + t * (b * s + c * t + 2.0 * e) + f
        if sqrdistance < 0:
            sqrdistance = 0
        dist = sqrt(sqrdistance)
        PP0 = B + s * E0 + t * E1
        return (dist, PP0)