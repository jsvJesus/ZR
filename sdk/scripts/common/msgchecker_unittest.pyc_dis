# Embedded file name: ./common/msgchecker_unittest.py
import random
import unittest
from msgchecker import MsgChecker, ClientMsgChecker

def str_random_symbols(qty):
    symbols = ''
    for _ in xrange(qty):
        num = int(random.random() * 26) + 97
        symbols = symbols + chr(num)

    return symbols


class MsgCheckerTest(unittest.TestCase):

    def setUp(self):
        self.msg_checker = MsgChecker()

    def test_can_it_be_sent(self):
        result, reason = self.msg_checker.can_it_be_sent(' ', 0)
        self.assertIs(result, False)
        self.assertNotEqual(reason.strip(), '')
        self.msg_checker._last_msg_time = 0
        text = u'someText'
        for _ in xrange(3):
            result, reason = self.msg_checker.can_it_be_sent(text, 0)

        self.assertIs(result, False)
        self.assertNotEqual(reason.strip(), '')
        self.msg_checker._last_msg_time = 0
        text = u"It's spam."
        for _ in xrange(MsgChecker.MAX_SPAM_MSG + 1):
            result, reason = self.msg_checker.can_it_be_sent(text, 0)
            self.msg_checker._last_msg_time = 0

        self.assertIs(result, False)
        self.assertNotEqual(reason.strip(), '')
        self.msg_checker._last_msg_time = 0
        for _ in xrange(MsgChecker.MAX_REMEMBER_MSG):
            text = str_random_symbols(8)
            result, reason = self.msg_checker.can_it_be_sent(text, 0)
            self.msg_checker._last_msg_time = 0

        text = u"It's not spam."
        result, reason = self.msg_checker.can_it_be_sent(text, 0)
        self.assertIs(result, True)
        self.assertIs(reason, None)
        self.msg_checker._last_msg_time = 0
        text = u'X' * (MsgChecker.MAX_MESSAGE_LEN + 1)
        result, reason = self.msg_checker.can_it_be_sent(text, 0)
        self.assertIs(result, False)
        self.assertNotEqual(reason.strip(), '')
        self.msg_checker._last_msg_time = 0
        text = u'Simple text'
        result, reason = self.msg_checker.can_it_be_sent(text, 0)
        self.assertIs(result, True)
        self.assertIs(reason, None)
        return


class ClientMsgCheckerTest(MsgCheckerTest):

    def setUp(self):
        self.msg_checker = ClientMsgChecker()

    def test_is_exceed_spam_limit(self):
        for i in xrange(ClientMsgChecker.MAX_SPAM_ATTEMPT + 1):
            text = u"It's spam."
            for j in xrange(MsgChecker.MAX_SPAM_MSG + 2):
                result, reason = self.msg_checker.can_it_be_sent(text, 0)
                self.msg_checker._last_msg_time = 0

            self.assertIs(result, False)
            self.assertNotEqual(reason.strip(), '')
            self.msg_checker._last_msg_time = 0
            for _ in xrange(MsgChecker.MAX_REMEMBER_MSG):
                text = str_random_symbols(8)
                result, reason = self.msg_checker.can_it_be_sent(text, 0)
                self.msg_checker._last_msg_time = 0

            text = u"It's not spam."
            result, reason = self.msg_checker.can_it_be_sent(text, 0)
            self.assertIs(result, True)
            self.assertIs(reason, None)

        self.assertTrue(self.msg_checker.is_exceed_spam_limit)
        return


if __name__ == '__main__':
    unittest.main()