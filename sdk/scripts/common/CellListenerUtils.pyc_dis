# Embedded file name: ./common/CellListenerUtils.py
import zlib

class EventType:
    MoneyChanged, NpcScenarioKilled, SomethingKilled, QuestItemUsed, ItemEquipped, CraftCompleted, AnomalyExtracted, NpcKilled, ObjectVisible, Finish, HealDead = xrange(11)


class Channel:
    Default, Quest = xrange(2)


class VisibleObjectType:
    QuestEntity, Creature, TimeEntity = xrange(3)


def objectname_to_objecttype(object_name):
    if object_name == 'QuestEntity':
        return VisibleObjectType.QuestEntity
    if object_name == 'Creature':
        return VisibleObjectType.Creature
    if object_name == 'TimeEntity':
        return VisibleObjectType.TimeEntity
    raise RuntimeError


def calc_visibleobject_hash(object_type, *data):
    if object_type == VisibleObjectType.QuestEntity:
        model_name = data[0]
        return zlib.crc32(model_name) & 65535
    if object_type == VisibleObjectType.Creature:
        mob_type, mob_subtype = data
        return zlib.crc32('{0} {1}'.format(mob_type, mob_subtype)) & 65535
    if object_type == VisibleObjectType.TimeEntity:
        config_name, model_name = data
        return zlib.crc32('{0} {1}'.format(config_name, model_name)) & 65535
    raise RuntimeError