DEFAULT_POSITION = (0, 0, 0)
DEFAULT_DIRECTION = (0, 0, 0)
DEFAULT_SPEED = 1.0
DEFAULT_SPEED_ANGLE = 60
DEFAULT_YAW = 0
DEFAULT_PITCH = 0
DEFAULT_ROLL = 0
DEFAULT_MATRIX_INTERPOLATION = False
DEFAULT_LEV_SPEED = 1.0
DEFAULT_LEV_AMPLITUDE = 0.1
DEFAULT_LEV_START = False
