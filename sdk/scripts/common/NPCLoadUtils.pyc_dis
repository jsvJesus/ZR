# Embedded file name: ./common/NPCLoadUtils.py
import json
import ResMgr
import BigWorld
import traceback
import BigWorld
NPC_ANIMATIONS_PATH = 'scripts/common/data/npc_animations.json'
NPC_ARMOR_PATH = 'scripts/server_data/NPC_defences.json'
animations_data = None
npc_stat_data = None

def load_stat_data():
    global npc_stat_data
    if BigWorld.component == 'client':
        return
    try:
        if npc_stat_data:
            return
        py_data_section = ResMgr.openSection(NPC_ARMOR_PATH)
        npc_stat_data = json.loads(py_data_section.asBinary, encoding='utf-8')
    except:
        print 'error file:', repr(NPC_ARMOR_PATH)
        traceback.print_exc()


def get_defence(armor_type):
    if not npc_stat_data:
        return None
    else:
        if not armor_type:
            armor_type = 'default'
        return npc_stat_data.get(armor_type, {}).get('Defence', None)


def get_health(armor_type):
    if not npc_stat_data:
        return None
    else:
        if not armor_type:
            armor_type = 'default'
        return npc_stat_data.get(armor_type, {}).get('HP', None)


def get_damage_mult(armor_type):
    if not npc_stat_data:
        return 1
    if not armor_type:
        armor_type = 'default'
    return npc_stat_data.get(armor_type, {}).get('Damage_factor', 1)


def get_exp(armor_type):
    if not npc_stat_data:
        return 0
    if not armor_type:
        armor_type = 'default'
    return npc_stat_data.get(armor_type, {}).get('exp', 0)


def load_animation_data():
    global animations_data
    try:
        if animations_data:
            return
        py_data_section = ResMgr.openSection(NPC_ANIMATIONS_PATH)
        animations_data = json.loads(py_data_section.asBinary, encoding='utf-8')
        for key, entry_list in animations_data.items():
            for entry in entry_list:
                if isinstance(entry['Animations'], (str, unicode)):
                    entry['Animations'] = str(entry['Animations'])
                else:
                    entry['Animations'] = map(str, entry['Animations'])
                if 'additional_animations' in entry:
                    clear_list = []
                    for anim in entry['additional_animations']:
                        if not isinstance(anim, int):
                            anim = str(anim)
                        clear_list.append(anim)

                    entry['additional_animations'] = clear_list

    except:
        print 'error file:', repr(NPC_ANIMATIONS_PATH)
        traceback.print_exc()


load_animation_data()
load_stat_data()

def get_anim_data(name):
    if not animations_data:
        return None
    else:
        return animations_data.get(name)