# Embedded file name: ./common/PyBudget.py
import BigWorld
_b = BigWorld.PyBudget()

def Get():
    """ 
    Format example:
    { 
            "Counters" : [
                    ( "Chunk items", (5,) ), # 5 items
            ],
    
            "Video Resources" : [
                    ( "textures/example.dds", ("RAM", 1024) ), # 1024 bytes
                    ( "textures/example2.dds", ("VIDEO", 4096) ), # 4096 bytes
            ],
    
            "Main Objects" : [
                    ( "XMLSection", (1024,) ) # 1024 bytes
            ]
    }
    
    Note: Video Resources category doesnt exists on server
    """
    return _b.getResourceDict()


def FormatDict(d, reverse = True):
    res = {}
    for k in d:
        res[k] = sorted(filter(lambda x: x[-1][-1] != 0, d[k]), lambda x, y: cmp(x[-1][-1], y[-1][-1]), reverse=reverse)

    return res


def GetFormatted(reverse = True):
    return FormatDict(Get(), reverse)


def AsStringList(key, lst):
    buf = key + '\n'
    for item in lst:
        buf += '|-> {0}: [{1}]\n'.format(item[0], item[-1][-1])

    return buf


def AsStringDict(d):
    buf = ''
    for k in d:
        buf += AsStringList(k, d[k])

    return buf


def GetAsString(formatted = True, reverse = True):
    d = Get()
    if formatted:
        d = FormatDict(d, reverse)
    return AsStringDict(d)


def Diff(d1, d2):
    """Return difference between two resource dictionaries(acquired by Get method) """

    def collectListInfo(lst):
        res = {}
        for pair in lst:
            key = (pair[0],) + tuple(pair[1][:-1])
            value = pair[1][-1]
            res[key] = value

        return res

    res = {}
    for category in set(list(d1.keys()) + list(d2.keys())):
        categoryData1 = collectListInfo(d1[category])
        categoryData2 = collectListInfo(d2.get(category, []))
        categoryRes = {}
        for k in categoryData1:
            categoryRes[k] = categoryData2.get(k, 0) - categoryData1[k]

        for k in categoryData2:
            if k in categoryRes:
                continue
            categoryRes[k] = categoryData2[k]

        categoryList = []
        for k in categoryRes:
            categoryList.append((k[0], list(k[1:]) + [categoryRes[k]]))

        res[category] = categoryList

    return res


def DiffPositive(d1, d2):
    """Return increased difference between two resource dictionaries(acquired by Get method) """
    diffed = Diff(d1, d2)
    res = {}
    for category in diffed:
        categoryList = diffed[category]
        newList = []
        for pair in categoryList:
            if pair[-1][-1] > 0:
                newList.append(pair)

        res[category] = newList

    return res


def DiffPositiveAsString(d1, d2, formatted = True, reverse = True):
    return AsStringDict(FormatDict(DiffPositive(d1, d2), reverse))