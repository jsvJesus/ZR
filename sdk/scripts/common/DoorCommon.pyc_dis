# Embedded file name: ./common/DoorCommon.py


class DoorCommon:
    CLOSE_ALL, CLOSE_RIGHT, CLOSE_LEFT, OPEN_ALL = xrange(4)

    def is_locked(self, is_right_side):
        if self.current_open == DoorCommon.CLOSE_ALL:
            return True
        elif is_right_side:
            return self.current_open == DoorCommon.CLOSE_RIGHT
        else:
            return self.current_open == DoorCommon.CLOSE_LEFT