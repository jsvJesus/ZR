# Embedded file name: ./common/CharacterCommon.py
import math_bw
import BigWorld
import CharacterUtils
from CharacterUtils import CharacterConst
from perks_system.perks_parser import MAX_EXP_VALUE

class CharacterCommon:

    def GetMaxStamina(self):
        return CharacterConst.STAMINA_BASE + (self.get_perk_action_val('STAMINA_INC') or 0)

    def getEquipTimeModifyer(self, gun_type):
        return CharacterUtils.getEquipTimeModifyer(self, gun_type)

    def getRegenValue(self):
        return CharacterConst.HP_REGENERATION_PER_SEC + (self.get_perk_action_val('HP_REGEN') or 0)

    def getStaminaRegen(self):
        return CharacterConst.STAMINA_RECOVERY + (self.get_perk_action_val('ST_REGEN') or 0)

    def getMaxHealth(self):
        return CharacterConst.HIT_POINTS_BASE + (self.get_perk_action_val('HP_MAX') or 0)

    def GetMaxSpeedModifyer(self):
        return 1

    def GetSprintSpeedModifyer(self):
        return 1 + (self.get_perk_action_val('SPEED_MOD') or 0)

    def getMaxWeight(self):
        return CharacterConst.DEFAULT_WEIGHT + (self.get_perk_action_val('MAX_WEIGHT') or 0)

    def AddExperience(self, exp_num, comment_id):
        if not exp_num:
            return
        import casandraSender
        if comment_id not in (casandraSender.EXP_CODE.ADMIN, casandraSender.EXP_CODE.MIGRATE):
            if exp_num > 0:
                exp_num *= self.premium_exp_coef
                COVID_X2 = BigWorld.globalData.get('EXP_COEFF', 0)
                if COVID_X2:
                    exp_num *= COVID_X2
            elif exp_num < 0:
                exp_num /= self.premium_exp_coef
        new_exp = math_bw.clamp(int(self.playerExperience + exp_num), 0, MAX_EXP_VALUE)
        if new_exp != self.playerExperience:
            diff = new_exp - self.playerExperience
            casandraSender.expLog(self.name, new_exp, diff, comment_id)
            self.playerExperience = new_exp