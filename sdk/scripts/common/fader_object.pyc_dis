# Embedded file name: ./common/fader_object.py
import BigWorld
import traceback

class Fader(object):
    """docstring for Fader"""

    def __init__(self, current_value = 0.0, to_value = 0.0, callback = None, tick_time = 0.05):
        super(Fader, self).__init__()
        self.__timer_id = None
        self._tick_time = tick_time
        self._current_value = current_value
        self._to_value = to_value
        self._step = 0.1
        self._callback = callback
        return

    def go(self):
        self.stop()
        self._tick()

    def blendTo(self, to_value, delta_time = 3.0):
        self._to_value = to_value
        delta = abs(self._current_value - self._to_value)
        if delta_time <= 1e-06:
            self._step = delta
        else:
            self._step = self._tick_time / delta_time
        self.go()

    def getValue(self):
        return self._current_value

    def _tick(self):
        delta = abs(self._current_value - self._to_value)
        if delta <= self._step:
            self._current_value = self._to_value
        else:
            step = self._step if self._current_value < self._to_value else -self._step
            self._current_value += step
        if self._callback:
            self._callback(self._current_value)
        if delta > 0.001:
            try:
                self.__timer_id = BigWorld.callback(self._tick_time, self._tick)
            except:
                print (self._tick_time, self._tick)
                traceback.print_exc()

    def setValue(self, value):
        self._current_value = value

    def stop(self):
        if self.__timer_id:
            BigWorld.cancelCallback(self.__timer_id)
            self.__timer_id = None
        return

    def destroy(self):
        self.stop()
        self._callback = None
        return