# Embedded file name: ./common/ChunkUtils.py
import os
import math

def get_chunk_position(name):
    base_name = os.path.basename(name)
    coord = nameToCoord(base_name)
    return (coord[0] * 100, 0, coord[1] * 100)


def position_to_coord(position):
    pos = position
    return (int(math.floor(pos[0] * 0.01)), int(math.floor(pos[2] * 0.01)))


def position_to_name(position):
    return coordToName(*position_to_coord(position))


def nameToCoord(name):

    def int16(n):
        n &= 65535
        return (n ^ 32768) - 32768

    if name[8] != 'o':
        return (999999, 999999)
    return (int16(int(name[:4], 16)), int16(int(name[4:8], 16)))


def coordToName(gridX, gridZ, singleDir = False):
    gridChunkIdentifier = ''

    def uint16(n):
        return n & 65535

    gridxs = uint16(gridX)
    gridzs = uint16(gridZ)
    if not singleDir:
        if uint16(gridxs + 4096) >= 8192 or uint16(gridzs + 4096) >= 8192:
            chunkIdentifierCStr = '%01xxxx%01xxxx/sep/' % (int(gridxs >> 12), int(gridzs >> 12))
            gridChunkIdentifier = chunkIdentifierCStr
        if uint16(gridxs + 256) >= 512 or uint16(gridzs + 256) >= 512:
            chunkIdentifierCStr = '%02xxx%02xxx/sep/' % (int(gridxs >> 8), int(gridzs >> 8))
            gridChunkIdentifier += chunkIdentifierCStr
        if uint16(gridxs + 16) >= 32 or uint16(gridzs + 16) >= 32:
            chunkIdentifierCStr = '%03xx%03xx/sep/' % (int(gridxs >> 4), int(gridzs >> 4))
            gridChunkIdentifier += chunkIdentifierCStr
    chunkIdentifierCStr = '%04x%04xo' % (int(gridxs), int(gridzs))
    gridChunkIdentifier += chunkIdentifierCStr
    return gridChunkIdentifier