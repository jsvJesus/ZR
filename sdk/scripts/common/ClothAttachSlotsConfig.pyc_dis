# Embedded file name: ./common/ClothAttachSlotsConfig.py
RADIO_SLOT = 'radio'
TEST_SLOT = 'test'
import ItemCategories as IC
from game_items import ItemsCatalog as BIC
CLOTH_ATTACH_SLOTS_CONFIG = {RADIO_SLOT: {'position': (191, 152, 0.5),
              'categories': [IC.RADIO],
              'subtypes': [BIC.RADIO, BIC.RADIO_TANGENT],
              'icon': 'soGUI/frame/equipment/radio_slot.dds',
              'hard_point': 'HP_LEFT_SHOULDER',
              'id': 1,
              'animation': ('take_radio', 'takeoff_radio')}}

def get_slot_position(slot_type):
    return CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['position']


def get_possible_categories(slot_type):
    return CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['categories']


def get_possible_subtypes(slot_type):
    return CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['subtypes']


def get_slot_icon(slot_type):
    return CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['icon']


def get_slot_id(slot_type):
    return CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['id']


def get_slot_equip_animation(slot_type):
    return CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['animation']


def get_slot_name(slot_id):
    for slot_type in CLOTH_ATTACH_SLOTS_CONFIG:
        if CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['id'] == slot_id:
            return slot_type

    import traceback
    print 'ERROR get_slot_name', slot_id
    traceback.print_stack()
    return


def get_slot_model_node_name(slot_type):
    return CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['hard_point']


def get_attach_slot_type(avatar, item_id):
    for slot_type, slot_id in avatar.EquippedVisibleAttachesIDS.items():
        if item_id == slot_id:
            return slot_type

    return None


def is_attached(avatar, item_id):
    for slot_type, slot_id in avatar.EquippedVisibleAttachesIDS.items():
        if item_id == slot_id:
            return True

    return False


def remove_visible_attach_slot(avatar, slot_type):
    if slot_type is None:
        return
    else:
        avatar.EquippedVisibleAttachesIDS[slot_type] = 0
        avatar.EquippedVisibleAttaches[slot_type] = 0
        avatar.changeVisibleAttach()
        return


def remove_visible_attach_item(avatar, item):
    if item is None:
        return False
    else:
        for slot_type, item_id in avatar.EquippedVisibleAttachesIDS.items():
            if item_id == item['complexItemID']:
                remove_visible_attach_slot(avatar, slot_type)
                return slot_type

        return False


def get_possible_slots(avatar, item, first = False):
    result = []
    if item is None:
        return
    else:
        from Items import ItemsCatalog
        item_cat = ItemsCatalog.GetItemCategory(item['complexItemType'])
        slots = get_visible_attaches_slots(avatar)
        for slot_type in slots:
            slot_cats = get_possible_categories(slot_type)
            if item_cat not in slot_cats:
                continue
            subtypes = CLOTH_ATTACH_SLOTS_CONFIG[slot_type]['subtypes']
            item_param = ItemsCatalog.GetItemParam(item['complexItemType'])
            if item_param.get('SubType') not in subtypes:
                continue
            if first:
                return slot_type
            result.append(slot_type)

        return result


def get_empty_possible_slots(avatar, item, first = False):
    slots = get_possible_slots(avatar, item, first)
    result = []
    if not isinstance(slots, list):
        return slots
    for slot_type in slots:
        if not avatar.EquippedVisibleAttachesIDS[slot_type]:
            result.append(slot_type)

    return result


def add_visible_attach_item(avatar, item, slot_type = None):
    if item is None:
        return 0.0
    else:
        if not slot_type:
            slot_type = get_possible_slots(avatar, item, True)
        if not slot_type:
            return 0.0
        duration = 1.0
        if avatar.EquippedVisibleAttachesIDS[slot_type] != 0:
            duration = 2.0
        avatar.EquippedVisibleAttachesIDS[slot_type] = item['complexItemID']
        avatar.EquippedVisibleAttaches[slot_type] = item['complexItemType']
        avatar.changeVisibleAttach()
        return duration


def check_visible_attaches(avatar):
    import ItemsUtils
    from Items import ItemsCatalog
    slots = get_visible_attaches_slots(avatar)
    for slot_type, item_id in avatar.EquippedVisibleAttachesIDS.items():
        item = ItemsUtils.GetComplexItemByID(avatar, item_id) if item_id else None
        if not item:
            remove_visible_attach_slot(avatar, slot_type)
            continue
        item_cat = ItemsCatalog.GetItemCategory(item['complexItemType'])
        avatar.EquippedVisibleAttaches[slot_type] = item['complexItemType']
        for slot in slots:
            slot_cats = get_possible_categories(slot_type)
            if item_cat in slot_cats:
                break
        else:
            remove_visible_attach_slot(avatar, slot_type)

    return


def get_visible_attaches_slots(avatar):
    from Items import ItemsCatalog
    visible_attaches_slots = []
    item_types = []
    for slot in avatar.EquippedArmor.values():
        item_type = slot['itemType']
        if item_type and item_type not in item_types:
            item_types.append(item_type)
            visible_attaches_slots.extend(ItemsCatalog.GetItemParam(item_type).get('AttachSlots', []))

    return visible_attaches_slots


def update_slots_model(avatar):
    for slot_type, item_type in avatar.EquippedVisibleAttaches.items():
        if item_type:
            avatar.changeVisibleAttachModel(slot_type)