def _getMaxRatingWithoutReward():
    for e in conf:
        if e['reward']:
            return e['rating'] - 1

    return 0


def _validate():
    prev_rating = -1
    for index, e in enumerate(conf):
        if e['rating'] <= prev_rating:
            print 'ERROR FOR', e
            raise ValueError('unsorted rating')
        prev_rating = e['rating']
        e['pos'] = index


_validate()
_ratings = [ e['rating'] - 1 for e in conf ]
rating_without_reward = _getMaxRatingWithoutReward()

def getRank(rating):
    left_index = bisect.bisect_left(_ratings, rating)
    if left_index > 0:
        left_index -= 1
    return conf[left_index]


if __name__ == '__main__':
    print getRank(100)