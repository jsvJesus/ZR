# Embedded file name: ./common/NPCMessages.py
import json
import ResMgr
import BigWorld
from NPCs import NPCs
from random import choice
from Localization import lc
NPC_MESSAGES_CONFIG_PATH = 'scripts/common/data/NPC_message_config.json'
NPC_DATA = {}
AGGRESSIVE, _, _ = xrange(3)
id_to_text = {AGGRESSIVE: 'aggressive'}

def load_data():
    global NPC_DATA
    try:
        if NPC_DATA:
            return
        py_data_section = ResMgr.openSection(NPC_MESSAGES_CONFIG_PATH)
        NPC_DATA = json.loads(py_data_section.asBinary, encoding='utf-8')
    except:
        import traceback
        traceback.print_exc()
        print 'error file:', repr(NPC_MESSAGES_CONFIG_PATH)


def getMessage(npcName, message_type):
    message_type = id_to_text[message_type]
    if not NPC_DATA:
        return None
    else:
        if not NPC_DATA.has_key(npcName):
            npcName = 'default'
        message = choice(NPC_DATA[npcName][message_type])
        return lc(message)


def getSenderNpcName(npcName, npcType, avatar = None):
    if NPCs.getName(npcName, avatar=avatar) != u'' and NPCs.getName(npcName, avatar=avatar) != '<NO DATA>':
        name = NPCs.getName(npcName)
    else:
        name = NPCs.names_by_npcType.get(npcType, u'NPC')
    return u'{0}'.format(name)


load_data()