def getSeasonInfo(time_delta = 0):
    _timestamp_season_start = time.mktime(time.strptime(season_start, '%d.%m.%Y %H:%M'))
    _timestamp_season_end = time.mktime(time.strptime(season_end, '%d.%m.%Y %H:%M'))
    cur_time = time.time() + time_delta
    rating_game = 0
    if cur_time > _timestamp_season_start and cur_time < _timestamp_season_end:
        current_season_play = cur_time - _timestamp_season_start
        rat_cycles = int(current_season_play // rating_game_lenght)
        rating_game_index = rat_cycles % len(rating_games)
        rating_game = rating_games[rating_game_index]
    res = {}
    res['season_start'] = _timestamp_season_start
    res['season_end'] = _timestamp_season_end
    res['season_time_left'] = _timestamp_season_end - cur_time
    res['season_time_start_expected'] = _timestamp_season_start - cur_time
    res['season'] = pvp_rating_config.SEASON_ID
    res['rating_game'] = rating_game
    return res


def getGeometryInfo(pvpConfID, time_delta = 0, season_start = 0):
    geometrylist = configs[pvpConfID]['geometrylist']
    info = {}
    if len(geometrylist) == 1:
        info['geometry'] = geometrylist[0][0]
        info['geometry_lc'] = geometrylist[0][1]
        info['change_delay'] = -1
    else:
        cur_time = time.time() + time_delta
        allpassed = cur_time - season_start
        passed = allpassed % (len(geometrylist) * GEOMETRY_ROTATION_TIME)
        space_index = int(passed // GEOMETRY_ROTATION_TIME)
        left = (space_index + 1) * GEOMETRY_ROTATION_TIME - passed
        info['geometry'] = geometrylist[space_index][0]
        info['geometry_lc'] = geometrylist[space_index][1]
        info['change_delay'] = left
    return info


def getGeometryInfoPrivate(pvpConfID, spaceIndex):
    geometrylist = configs[pvpConfID]['geometrylist']
    info = {}
    _index = max(min(spaceIndex, len(geometrylist) - 1), 0)
    info['geometry'] = geometrylist[_index][0]
    return info


def mergeNYConf(validate = True):
    for pvpConfID, info in events_pvp_new_year.pvp_map_settings.items():
        if pvpConfID in configs:
            raise KeyError('duplicate pvpConfID %s' % pvpConfID)
        configs[pvpConfID] = info


mergeNYConf(validate=True)
_spaces = set()
for e in configs.values():
    _spaces.update([ s[0] for s in e['geometrylist'] ])

def isPVPSpace(space_name):
    return space_name in _spaces


def isValidGame(pvpConfID):
    if pvpConfID in active_games:
        return True
    if pvpConfID in rating_games:
        return True
    if pvpConfID in events_pvp_new_year.periodSystemPVP.getCurrentGames():
        return True
    return False


