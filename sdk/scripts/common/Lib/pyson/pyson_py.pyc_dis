        if symb == '.':
            self.isflaot = True
        if symb.isdigit() or symb == '.':
            self._buf.append(symb)
            return True
        return False

    def value(self):
        val = ''.join(self._buf)
        if self.isflaot:
            return float(val)
        return int(val)


class _Text(_Elem):
    prev_symb_esc = None

    def addSymb(self, symb):
        if self.prev_symb_esc:
            if symb == 'n':
                symb = '\n'
            elif symb == '\\':
                symb = '\\'
            elif symb == '"':
                symb = '"'
            self.prev_symb_esc = False
            self._buf.append(symb)
            return True
        if symb == '"':
            return False
        if symb == '\\':
            self.prev_symb_esc = True
            return True
        self._buf.append(symb)
        return True

    def value(self):
        return ''.join(self._buf)


class _ContList:

    def __init__(self):
