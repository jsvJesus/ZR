    def add(self, obj):
        if self._key_end:
            self._key_end = False
            self._data[self._key] = obj
        else:
            self._key = obj


def loads(text):
    _root = None
    _cont = []
    _last_elem = None
    number_line = 0
    number_symb = 0
    _ignore = 0
    for number, symb in enumerate(text):
        if _ignore:
            _ignore -= 1
            continue
        try:
            end_line = False
            number_symb += 1
            if symb == '\n':
                number_line += 1
                number_symb = 0
                end_line = True
            if _last_elem:
                need_break = end_line
                if not _last_elem.addSymb(symb):
                    need_break = True
                if need_break:
                    _cont[-1].add(_last_elem.value())
                    _last_elem = None
                    if end_line:
                        continue
                if _last_elem:
                    continue
                if symb not in ':':
                    continue
            if symb == ':':
                _cont[-1].markEndKey()
            elif symb in '([':
                c = _ContList()
                if _cont:
                    _cont[-1].add(c._data)
                _cont.append(c)
            elif not (symb == 's' and text[number:number + 4] == 'set{'):
                raise AssertionError
                _ignore += 3
                c = _ContSet()
                if _cont:
                    _cont[-1].add(c._data)
                _cont.append(c)
            elif symb in '])':
                _cont.pop(-1)
            elif symb == '{':
                c = _ContDict()
                if _cont:
                    _cont[-1].add(c._data)
                _cont.append(c)
            elif symb == '}':
                _cont.pop(-1)
            elif symb == '"':
                _last_elem = _Text()
            elif symb in 'TFN':
                _last_elem = _BoolAndNone(symb)
            elif symb.isdigit() or symb == '-':
                _last_elem = _Number(symb)
            if not _root and _cont:
                _root = _cont[-1]._data
        except:
            print '\nline: %s.%s' % (number_line, number_symb)
            raise

    return _root


indent = '\t'

def _foramt_str(str_value):
    if sys.version_info.major >= 3:
        if type(str_value) == bytes:
            str_value = str_value.decode('utf-8')
    elif type(str_value) == unicode:
        str_value = str_value.encode('utf-8')
    str_value = str_value.replace('\\', '\\\\')
    str_value = str_value.replace('\n', '\\n')
    str_value = str_value.replace('"', '\\"')
    return '"%s"' % str_value


def _format_float(value):
    return '%s' % value


def _dumps(obj, level = 0, ignor_ind_simple = False):
    res = ''
    type_ = type(obj)
    if type_ == dict:
        res += '\n' + indent * level + '{' + '\n'
        for key, value in obj.items():
            if type(key) in (int, long, bool):
                res += indent * (level + 1) + str(int(key)) + ': '
            elif type(key) in (float,):
                res += indent * (level + 1) + _format_float(key) + ': '
            elif type(key) in (str, unicode):
                res += indent * (level + 1) + _foramt_str(key) + ': '
            else:
                raise TypeError('not support type for key %s' % type(key))
            res += _dumps(value, level + 1, ignor_ind_simple=True) + '\n'

        res += indent * level + '}'
    elif type_ == tuple:
        res += '\n' + indent * level + '(' + '\n'
        for sub_obj in obj:
            res += _dumps(sub_obj, level + 1) + ',' + '\n'

        res += indent * level + ')'
    elif type_ == list:
        res += '\n' + indent * level + '[' + '\n'
        for sub_obj in obj:
            res += _dumps(sub_obj, level + 1) + ',' + '\n'

        res += indent * level + ']'
    elif type_ in (set,):
        res += '\n' + indent * level + 'set{' + '\n'
        for sub_obj in obj:
            res += _dumps(sub_obj, level + 1) + ',' + '\n'

        res += indent * level + '}'
    elif type_ in (int, long, bool):
        if ignor_ind_simple:
            res += str(int(obj))
        else:
            res += indent * level + str(obj)
    elif type_ in (float,):
        if ignor_ind_simple:
            res += _format_float(obj)
        else:
            res += indent * level + _format_float(obj)
    elif obj is None:
        if ignor_ind_simple:
            res += 'None'
        else:
            res += indent * level + 'None'
    elif type_ in (str, unicode):
        if ignor_ind_simple:
            res += _foramt_str(obj)
        else:
            res += indent * level + _foramt_str(obj)
    else:
        raise TypeError('not support type %s' % type_)
    return res


def dumps(obj):
    text = _dumps(obj)
    return text


