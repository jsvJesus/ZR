def _test():
    import pprint
    t = {1: 'text',
     'txt': 2.0,
     3: [10000000000000000023L, '\xd1\x80\xd1\x83\xd1\x81 \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82', -3.0]}
    t[88] = 'esc" mee'
    t['esc \\'] = 'esc \\ mee'
    t['DropPercent'] = 'esc \n mee'
    t[55] = {22: 'adasdasd',
     55: 'asdasdasdas111'}
    t['SETHERE'] = set([1, 2])
    test_data = t
    res = dumps(test_data)
    print res
    with open('test.pyson', 'w') as f:
        f.write(res)
    decode = loads(res)
    valid = decode == test_data
    print ('valid:', valid)
    if not valid:
        with open('test_test_data.txt', 'w') as f:
            pprint.pprint(test_data, f)
        with open('test_decode.txt', 'w') as f:
            pprint.pprint(decode, f)
        print 'write debug to test_test_data.txt'
        print 'write debug to test_decode.txt'
        raise ValueError


if __name__ == '__main__':
    _test2()