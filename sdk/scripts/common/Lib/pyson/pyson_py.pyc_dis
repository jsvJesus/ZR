class _BoolAndNone(_Elem):

    def addSymb(self, symb):
        if symb in 'TrueFalseNone':
            self._buf.append(symb)
            return True
        return False

    def value(self):
        val = ''.join(self._buf)
        if val == 'True':
            return True
        elif val == 'False':
            return False
        elif val == 'None':
            return None
        else:
