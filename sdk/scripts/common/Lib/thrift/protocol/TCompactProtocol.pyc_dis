def makeZigZag(n, bits):
    return n << 1 ^ n >> bits - 1


def fromZigZag(n):
    return n >> 1 ^ -(n & 1)


def writeVarint(trans, n):
    out = []
    while True:
        if n & -128 == 0:
            out.append(n)
            break
        else:
            out.append(n & 255 | 128)
            n = n >> 7

    trans.write(''.join(map(chr, out)))


def readVarint(trans):
    result = 0
    shift = 0
    while True:
        x = trans.readAll(1)
        byte = ord(x)
        result |= (byte & 127) << shift
        if byte >> 7 == 0:
            return result
        shift += 7


