# Embedded file name: ./common/Lib/json/tests/test_float.py
import math
from unittest import TestCase
import json

class TestFloat(TestCase):

    def test_floats(self):
        for num in [1617161771.765,
         math.pi,
         math.pi ** 100,
         math.pi ** (-100)]:
            self.assertEquals(float(json.dumps(num)), num)