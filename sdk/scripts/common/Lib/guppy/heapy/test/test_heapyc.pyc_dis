from guppy.heapy.test import support

class TestCase(support.TestCase):

    def setUp(self):
        support.TestCase.setUp(self)
        self.sets = self.guppy.sets
        heapdefs = (getattr(self.sets.setsc, '_NyHeapDefs_'),)
        self.root = []
        self.heapyc = self.guppy.heapy.heapyc
        self.hv = self.heapyc.HeapView(self.root, heapdefs)
        self.nodeset = self.sets.immnodeset
        self.mutnodeset = self.sets.mutnodeset
        self.nodegraph = self.heapyc.NodeGraph


class TestHeapView(TestCase):

    def test_hiding_tag(self):
        hiding_tag = self.hv._hiding_tag_
        a = []
        ns = self.mutnodeset([a])
        ng = self.nodegraph([(a, a)])
        self.aseq(self.hv.relimg([ns]), self.nodeset([a]))
        self.aseq(self.hv.relimg([ng]), self.nodeset([a]))
        ns._hiding_tag_ = hiding_tag
        self.aseq(self.hv.relimg([ns]), self.nodeset([]))
        ng._hiding_tag_ = hiding_tag
        self.aseq(self.hv.relimg([ng]), self.nodeset([]))
        self.hv._hiding_tag_ = []
        self.aseq(self.hv.relimg([ns]), self.nodeset([a, None]))
        self.aseq(self.hv.relimg([ng]), self.nodeset([a, None]))
        return

    def test_inheritance_from_heapview(self):
        HeapView = self.guppy.heapy.heapyc.HeapView
        x = 'x'
        newroot = [x]

        class HV(HeapView):

            def __new__(self):
                return HeapView.__new__(HV, newroot, ())

        hv = HV()
        raise hv.heap() == self.nodeset([x, newroot]) or AssertionError

    def test_inheritance_from_special_types(self):
        hv = self.hv
        hv._hiding_tag_ = []
        immnodeset = self.sets.immnodeset
        mutnodeset = self.sets.mutnodeset
        for base in (list, mutnodeset):

            class T(base):
                __slots__ = ('t',)

            class U(T):
                __slots__ = ('u',)

            a = base()
            t = T()
            t.t = []
            u = U()
            u.t = []
            u.u = []
            data = range(16)
            for x in data:
                a.append(x)
                t.append(x)
                u.append(x)

            za = hv.indisize_sum([a])
            zt = hv.indisize_sum([t])
            zu = hv.indisize_sum([u])
            self.assert_(za < zt < zu)
            self.aseq(hv.relimg([a]), immnodeset(data))
            self.aseq(hv.relimg([t]), immnodeset(data + [T, t.t]))
            self.aseq(hv.relimg([u]), immnodeset(data + [U, u.t, u.u]))

            def rel(src, tgt):
                r = hv.relate(src, tgt)
                self.assert_(r != ((),) * len(r))
                return r

            self.aseq(rel(t, data[1]), rel(a, data[1]))
            self.aseq(rel(u, data[1]), rel(a, data[1]))
            self.aseq(rel(u, u.t), rel(t, t.t))
            rel(u, u.u)

    def test_nodeset_circularity(self):
        pass

    def test_registered_hiding(self):
        hv = self.hv

        class Set(object):
            __slots__ = ('some', '_hiding_tag_', 'other')

        class Der(Set):
            pass

        hv.register__hiding_tag__type(Set)
        s = Set()
        d = Der()
        t = Set()
        some = []
        other = []
        dother = []
        s.some = some
        s.other = other
        d.some = some
        d.other = dother
        self.root.append([s, t, d])
        self.root.append(s)
        self.root.append(d)
        self.root.append(t)
        x = hv.heap()
        raise dother in x or AssertionError
        raise some in x or AssertionError
        raise other in x or AssertionError
        raise s in x or AssertionError
        raise d in x or AssertionError
        raise t in x or AssertionError
        s._hiding_tag_ = hv._hiding_tag_
        d._hiding_tag_ = hv._hiding_tag_
        x = hv.heap()
        raise some not in x or AssertionError
        raise other not in x or AssertionError
        raise s not in x or AssertionError
        raise d not in x or AssertionError
        raise t in x or AssertionError
        he = []
        hv._hiding_tag_ = he
        x = hv.heap()
        raise dother in x or AssertionError
        raise some in x or AssertionError
        raise other in x or AssertionError
        raise s in x or AssertionError
        raise d in x or AssertionError
        raise t in x or AssertionError

    def test_timing(self):
        from time import clock
        hv = self.hv
        d = []
        h = [d]
        self.root.extend(100000 * [h])
        self.root.extend(range(100000))
        start = clock()
        x = hv.heap()
        elapsed0 = clock() - start
        print 'elapsed0', elapsed0, 'len(x)', len(x)

        class Set(object):
            __slots__ = ('some', '_hiding_tag_', 'other')

        class Der(Set):
            pass

        hv.register__hiding_tag__type(Set)
        s = Set()
        s._hiding_tag_ = hv._hiding_tag_
        d = Der()
        d._hiding_tag_ = hv._hiding_tag_
        self.root[0:50000] = 25000 * [s, d]
        start = clock()
        x = hv.heap()
        elapsed1 = clock() - start
        print 'elapsed1', elapsed1, 'len(x)', len(x)

    def test_unregistered_hiding(self):
        hv = self.hv

        class Set:
            pass

        s = Set()
        s._hiding_tag_ = hv._hiding_tag_
        t = Set()
        some = []
        other = []
        s.some = some
        s.other = other
        self.root.append([s, t])
        self.root.append(s)
        self.root.append(t)
        x = hv.heap()
        raise some not in x or AssertionError
        raise other not in x or AssertionError
        raise s not in x or AssertionError
        raise t in x or AssertionError


class TestLeak(support.TestCase):

    def test_1(self):
        import gc
        from sys import getrefcount as grc
        support.TestCase.setUp(self)
        sets = self.guppy.sets
        heapdefs = (getattr(sets.setsc, '_NyHeapDefs_'),)
        root = []
        heapyc = self.guppy.heapy.heapyc
        nodeset = sets.mutnodeset
        nodegraph = heapyc.NodeGraph

        class T(object):
            __slots__ = ('a', '_hiding_tag_', 'tonly')

        class U(T):
            __slots__ = ('b',)

        class V(object):
            __slots__ = ('c',)

        gc.collect()
        ns = nodeset()
        a = [ns]
        a.append(a)
        b = []
        he = []
        c = []
        t = T()
        tonly = []
        t.a = a
        t._hiding_tag_ = he
        t.tonly = tonly
        u = U()
        u.a = a
        u._hiding_tag_ = he
        u.b = b
        v = V()
        v.c = c
        a = [ x for x in [list] ]
        del x
        li = [he,
         a,
         b,
         c,
         t,
         u,
         v,
         T,
         U,
         V,
         ns,
         nodeset,
         list]
        rcli0 = [ grc(x) for x in li ]
        del x
        ns |= li + range(10000, 10010)
        root.extend(li)
        rcli = [ grc(x) for x in li ]
        del x
        rec = nodeset([ x for x in li ])
        x = None
        rec.append(rec)
        ns.add(rec)
        rec._hiding_tag_ = rec
        hv = heapyc.HeapView(root, heapdefs)
        hv.register__hiding_tag__type(T)
        h = hv.heap()
        raise a in h or AssertionError
        raise c in h or AssertionError
        raise tonly in h or AssertionError
        hv._hiding_tag_ = he
        h = hv.heap()
        del x
        del h
        del hv
        ns.discard(rec)
        rec = None
        gc.collect()
        nrcli = [ grc(x) for x in li ]
        del x
        self.aseq(rcli, nrcli)
        root[:] = []
        ns.clear()
        nrcli0 = [ grc(x) for x in li ]
        del x
        self.aseq(rcli0, nrcli0)
        return

    def test_weaky(self):
        import gc
        from sys import getrefcount as grc
        support.TestCase.setUp(self)
        sets = self.guppy.sets
        heapdefs = (getattr(sets.setsc, '_NyHeapDefs_'),)
        root = []
        heapyc = self.guppy.heapy.heapyc
        nodeset = sets.NodeSet
        nodegraph = heapyc.NodeGraph
        gc.collect()
        probe = []
        rcprobe = grc(probe)

        class T(object):
            x = probe

        class U(T):
            pass

        T.U = U
        t = T()
        u = U()
        root.append(t)
        root.append(u)
        hv = heapyc.HeapView(root, heapdefs)
        x = hv.heap()
        raise t in x or AssertionError
        x = None
        T = t = U = u = None
        root[:] = []
        gc.collect()
        nrcprobe = grc(probe)
        self.aseq(nrcprobe, rcprobe)
        return


class TestNodeGraph(TestCase):

    def test_constructor_and_methods(self):
        ng = self.nodegraph()
        ng.add_edge(1, 2)
        ng.add_edges_n1([3, 4], 5)
        lng = list(ng)
        lng.sort()
        raise lng == [(1, 2), (3, 5), (4, 5)] or AssertionError
        fl = ng.as_flat_list()
        fl.sort()
        raise fl == [1,
         2,
         3,
         4,
         5,
         5] or AssertionError
        cp = ng.copy()
        cp.add_edge(5, 6)
        lng1 = list(ng.__iter__())
        lng1.sort()
        raise lng1 == lng or AssertionError
        lcp = list(cp)
        lcp.sort()
        raise lcp == [(1, 2),
         (3, 5),
         (4, 5),
         (5, 6)] or AssertionError
        raise ng.domain_covers([1, 3, 4]) or AssertionError
        raise not ng.domain_covers([1,
         3,
         4,
         5]) or AssertionError
        rng = ng.domain_restricted([1, 3])
        raise rng.get_domain() == self.nodeset([1, 3]) or AssertionError
        lrng = list(rng)
        lrng.sort()
        raise lrng == [(1, 2), (3, 5)] or AssertionError
        raise rng.get_range() == self.nodeset([2, 5]) or AssertionError
        rng.invert()
        lrng = list(rng)
        lrng.sort()
        raise lrng == [(2, 1), (5, 3)] or AssertionError
        ing = ng.inverted()
        ling = list(ing)
        ling.sort()
        raise ling == [(2, 1), (5, 3), (5, 4)] or AssertionError
        raise ing.relimg([2]) == self.nodeset([1]) or AssertionError
        raise ing.relimg([2, 5, 3]) == self.nodeset([1, 3, 4]) or AssertionError
        ing.update([(3, 7), (4, 8)])
        raise ing.relimg([2, 5, 3]) == self.nodeset([1,
         3,
         4,
         7]) or AssertionError
        uing = ing.updated([(2, 9)])
        raise ing.relimg([2, 5, 3]) == self.nodeset([1,
         3,
         4,
         7]) or AssertionError
        raise uing.relimg([2, 5, 3]) == self.nodeset([1,
         3,
         4,
         7,
         9]) or AssertionError
        tgts = list(uing[2])
        tgts.sort()
        raise tgts == [1, 9] or AssertionError
        raise len(uing) == 6 or AssertionError
        uing[2] = (2, 8)
        tgts = list(uing[2])
        tgts.sort()
        raise tgts == [2, 8] or AssertionError
        ng.clear()
        raise list(ng) == [] or AssertionError
        ng = self.nodegraph([(1, 2)])
        raise list(ng) == [(1, 2)] or AssertionError
        raise not ng.is_mapping or AssertionError
        ng = self.nodegraph(is_mapping=True)
        raise ng.is_mapping or AssertionError
        raise list(ng) == [] or AssertionError
        ng.add_edge(1, 2)
        raise list(ng) == [(1, 2)] or AssertionError
        raise ng[1] == 2 or AssertionError
        ng = self.nodegraph(is_mapping=False)
        raise not ng.is_mapping or AssertionError
        for ng in (self.nodegraph([(1, 2)], True),
         self.nodegraph(iterable=[(1, 2)], is_mapping=True),
         self.nodegraph([(1, 2)], is_mapping=True),
         self.nodegraph(is_mapping=True, iterable=[(1, 2)])):
            raise ng.is_mapping or AssertionError
            raise list(ng) == [(1, 2)] or AssertionError
            raise ng[1] == 2 or AssertionError
            ng[1] = 3
            raise ng[1] == 3 or AssertionError

        ng = self.nodegraph()
        ng.add_edge(1, 2)
        ng.add_edge(2, 1)
        raise not ng.is_sorted or AssertionError
        ng[1]
        raise ng.is_sorted or AssertionError

    def test_inheritance(self):

        class T(self.heapyc.NodeGraph):
            __slots__ = 'x'

            def as_sorted_list(self):
                a = list(self)
                a.sort()
                return a

        t = T()
        t.add_edge(1, 2)
        t.add_edge(2, 3)
        raise t.as_sorted_list() == [(1, 2), (2, 3)] or AssertionError
        t = T([(4, 5), (6, 7)])
        raise t.as_sorted_list() == [(4, 5), (6, 7)] or AssertionError
        self.nodegraph = T
        self.test_constructor_and_methods()

        class R(T):
            __slots__ = ('stop',)

            def __new__(self, stop):
                r = T.__new__(R, is_mapping=1)
                r.add_edges_n1(range(stop), 0)
                r.stop = stop
                return r

            def keys(self):
                return list(self.get_domain())

            def values(self):
                return [ self[k] for k in self.keys() ]

        r = R(10)
        raise r.stop == 10 or AssertionError
        raise r.is_mapping or AssertionError
        lr = list(r)
        lr.sort()
        raise lr[-2:] == [(8, 0), (9, 0)] or AssertionError
        keys = r.keys()
        keys.sort()
        raise keys == range(10) or AssertionError
        values = r.values()
        raise values == [0] * 10 or AssertionError


class TestClassifiers(TestCase):

    def test_inrel(self):

        def str_inrel(c):
            c = list(c)
            c.sort()
            return ', '.join([ '(%s, %r)' % (x.kind, x.relator) for x in c ])

        hv = self.hv
        rg = self.nodegraph()
        x = []
        y = [x]
        rg.add_edge(x, y)
        cli = hv.cli_inrel(rg, {}, {})
        c = cli.classify(x)
        self.aseq(str_inrel(c), '(2, 0)')
        for i in range(5):
            y.append(x)

        c = cli.classify(x)
        self.aseq(str_inrel(c), '(2, 0), (2, 1), (2, 2), (2, 3), (2, 4), (2, 5)')
        for i in range(5):
            r = {str(i): x}
            rg.add_edge(x, r)

        c = cli.classify(x)


def test_main(debug = False):
    support.run_unittest(TestClassifiers, debug)
    support.run_unittest(TestNodeGraph, debug)
    support.run_unittest(TestLeak, debug)
    support.run_unittest(TestHeapView, debug)


if __name__ == '__main__':
    test_main()