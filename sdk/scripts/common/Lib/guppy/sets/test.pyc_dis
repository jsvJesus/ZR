            bs |= seq
            raise list(bs) == sbits or AssertionError
            bs = Empty
            bs = bs ^ seq
            raise list(bs) == sbits or AssertionError
            bs = Empty
            bs = seq ^ bs
            raise list(bs) == sbits or AssertionError
            bs = Empty
            bs ^= seq
            raise list(bs) == sbits or AssertionError
            bs = bitsmut(Empty)
            bs ^= seq
            raise list(bs) == sbits or AssertionError
            bs = Omega
            bs = bs & seq
            raise list(bs) == sbits or AssertionError
            bs = Omega
            bs = seq & bs
            raise list(bs) == sbits or AssertionError
            bs = Omega
            bs &= seq
            raise list(bs) == sbits or AssertionError
            bs = bitsmut(Omega)
            bs &= seq
            raise list(bs) == sbits or AssertionError
            bs = Omega
            bs = bs ^ seq
            bs = ~bs
            raise list(bs) == sbits or AssertionError
            bs = Omega
            bs = seq ^ bs
            bs = ~bs
            raise list(bs) == sbits or AssertionError
            bs = Omega
            bs ^= seq
            bs = ~bs
            raise list(bs) == sbits or AssertionError
            bs = bitsmut(Omega)
            bs ^= seq
            bs = ~bs
            raise list(bs) == sbits or AssertionError

