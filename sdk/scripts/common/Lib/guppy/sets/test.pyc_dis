def absorption(a, b):
    raise a & (a | b) == a or AssertionError
    raise a | a & b == a or AssertionError


def associative(a, b, c):
    raise a & b & c == a & (b & c) or AssertionError
    raise a | b | c == a | (b | c) or AssertionError


def commutative(a, b):
    raise a & b == b & a or AssertionError
    raise a | b == b | a or AssertionError


def deMorgan(a, b, c = None):
    raise c is None and (~(a & b) == ~a | ~b or AssertionError)
    if not ~(a | b) == ~a & ~b:
        raise AssertionError
    else:
        raise c - (a & b) == c - a | c - b or AssertionError
        raise c - (a | b) == c - a & c - b or AssertionError
    return


def idempotence(a):
    raise a & a == a or AssertionError
    raise a | a == a or AssertionError


def inclusion(a, b):
    raise a & b <= a or AssertionError
    raise a & b <= b or AssertionError
    raise a | b >= a or AssertionError
    raise a | b >= b or AssertionError


def distributive(a, b, c):
    raise a | b & c == (a | b) & (a | c) or AssertionError
    raise a & (b | c) == a & b | a & c or AssertionError
    raise a & b | b & c | c & a == (a | b) & (b | c) & (c | a) or AssertionError
    raise a & b == a & c and (not a | b == a | c or b == c or AssertionError)


def test_set_operations(as_, bs, cs):
    for a in as_:
        idempotence(a)
        for b in bs:
            inclusion(a, b)
            commutative(a, b)
            absorption(a, b)
            for c in cs:
                associative(a, b, c)
                distributive(a, b, c)
                deMorgan(a, b, c)


def test_set_sub(as_, bs):

    def imp(a, b):
        raise not a or b or AssertionError

    for a in as_:
        for b in bs:
            imp(len(a) != len(b), a != b)
            imp(a < b, b > a and not b < a)
            imp(a <= b, b >= a and (a < b or a == b) and not a > b)
            imp(a == b, a <= b and a >= b and not a != b and not b != a)
            imp(a != b, not a == b and not b == a)
            imp(a > b, b < a and not b > a)
            imp(a >= b, b <= a and (b < a or a == b) and not a < b)


def test_set_len(as_, bs):
    for a in as_:
