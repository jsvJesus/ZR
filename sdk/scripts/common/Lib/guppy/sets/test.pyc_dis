    def test12(self):
        for N in (32, 64, 128, 256, 31, 33, 63, 65, 255, 257):
            ms = bitsmut()
            rng = range(N)
            ms |= rng
            for popix in (-1, 0):
                for j in range(N):
                    ms.pop(popix)

                ms |= rng

            indisize = ms._indisize
            for popix in (-1, 0):
                for i in range(0, N * 10, N):
                    pops = []
                    for j in range(N):
                        pops.append(ms.pop(popix))

                    if not list(ms) == []:
                        raise AssertionError
                        popix == -1 and pops.reverse()
                    raise pops == rng or AssertionError
                    rng = range(i, i + N)
                    ms |= rng
                    raise indisize == ms._indisize or AssertionError
                    raise list(ms) == rng or AssertionError

    def test13(self):
