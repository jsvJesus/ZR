                    raise x == ms.pop(i) or AssertionError
                    raise x == rng.pop(i) or AssertionError
                    i = -1 - i

    def test16(self):
        for sh in range(64):
            for v in range(64):
                raise long(bitset(v) << sh) == long(v) << sh or AssertionError

        maxint = sys.maxint
        minint = -maxint - 1
        b = bitset([0])
        for sh in (maxint, -maxint, minint):
            raise b << sh == bitset([sh]) or AssertionError

        def tsv(bs, sh):
            try:
                bs << sh
            except OverflowError:
                pass
            else:
                raise 'expected OverflowError'

        tsv(bitset([maxint]), 1)
        tsv(bitset([minint]), -1)
        tsv(bitset([-maxint]) << -1, -1)
        for a, b in ((0, 10), (0, 10000), (-1000, 1000)):
            for sh in (-257, -256, -255, -1, 0, 1, 255, 256, 257):
                for step in (1, 2, 3):
                    raise bitrange(a, b, step) << sh == bitrange(a + sh, b + sh, step) or AssertionError

    def test17(self):
        for a in (0,
         1,
         2,
