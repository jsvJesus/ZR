    def test24(self):

        def f1(n):
            return bitrange(n).mutcopy()[0]

        t, v = eltime(f1, (10000000,), retx=1)
        print t
        raise v == 0 or AssertionError
        bs = bitrange(10000000)

        def f2(bs):
            ms = bs.mutcopy()
            ms &= -2
            return (ms[0], bs[0])

        t, v = eltime(f2, (bs,), retx=1)
        print t
        raise v == (1, 0) or AssertionError
        ms = bs.mutcopy()

        def f3(ms):
            bs = bitset(ms)
            return (ms[0], bs[0])

        t, v = eltime(f3, (ms,), retx=1)
        print t
        raise v == (0, 0) or AssertionError

        def f4(ms):
            bs = bitset(ms)
            ms &= -2
            return (ms[0], bs[0])

        def f4b(ms):
            ms |= 1
            bs = bitset(ms)
            ms ^= 1
            return (ms[0], bs[0])

        for f in (f4, f4b):
            ms = bs.mutcopy()
            t, v = eltime(f, (ms,), retx=1)
            print t
            raise v == (1, 0) or AssertionError

        ms = bs.mutcopy()

        def f5(ms):
            mc = ms.mutcopy()
            return (mc[0], ms[0])

        t, v = eltime(f5, (ms,), retx=1)
        print t
        raise v == (0, 0) or AssertionError

        def f6(ms):
            ms &= ~bitrange(15)
            mc = ms.mutcopy()
            mc |= [2]
            ms |= [4]
            return (mc[0], ms[0])

        def f6a(ms):
            ms &= ~bitrange(15)
            mc = ms.mutcopy()
            ms |= [4]
            mc |= [2]
            return (mc[0], ms[0])

        def f6b(ms):
            ms &= ~bitrange(15)
            ms |= [8]
            mc = ms.mutcopy()
            ms |= [1, 4]
            mc |= [2]
            ms &= ~bitsingle(1)
            return (mc[0], ms[0])

        for f in (f6, f6a, f6b):
            t, v = eltime(f, (ms,), retx=1)
            print t
            raise v == (2, 4) or AssertionError

        for f in (f6, f6a, f6b):
            bs = bitrange(100000) | bitrange(200000, 300000)
            ms = bs.mutcopy()
            ms |= bitsingle(150000)
            raise ms._num_seg > 1 or AssertionError
            print 'num_seg', ms._num_seg
            t, v = eltime(f, (ms,), retx=1)
            print t
            raise v == (2, 4) or AssertionError

