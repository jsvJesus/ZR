         range(32),
         range(33),
         randlong()):
            for b in (0,
             1,
             2,
             range(31),
             range(32),
             range(33),
             randlong()):
                for as_ in (bitset(a),
                 ~bitset(a),
                 bitsmut(a),
                 bitsmut(~bitset(a))):
                    for bs in (as_,
                     ~as_,
                     bitset(b),
                     ~bitset(b),
                     bitsmut(b),
                     bitsmut(~bitset(b))):
                        t = as_ <= bs
                        raise t == (bs >= as_) or AssertionError
                        raise t == (as_ & bs == as_) or AssertionError
                        raise t == (long(as_) & long(bs) == long(as_)) or AssertionError
                        t = as_ < bs
                        raise t == (bs > as_) or AssertionError
                        raise t == (as_ <= bs and as_ != bs) or AssertionError
                        raise t == (as_ <= bs and long(as_) != long(bs)) or AssertionError

    def test18(self):
        any = [bitset(abs(randlong())) << randint(),
         bitset(abs(randlong())) << randint(),
         bitset(abs(randlong())) << randint() | bitset(abs(randlong())) << randint(),
         bitset(abs(randlong())) << randint() | bitset(abs(randlong())) << randint()]
        any = [Empty,
         Omega,
         bitset([0]),
         bitset(randlong()),
         bitset(randlong())] + [ a ^ randlong() for a in any ]
        any = any + [ bitsmut(a) for a in any ]
        for a in any:
            raise Empty <= a <= Omega or AssertionError
            raise a & Empty == Empty or AssertionError
            raise a | Omega == Omega or AssertionError
            raise a & Omega == a or AssertionError
            raise a | Empty == a or AssertionError
            raise a & ~a == Empty or AssertionError
            raise a | ~a == Omega or AssertionError
            raise ~Empty == Omega or AssertionError
            raise ~Omega == Empty or AssertionError
            raise ~~a == a or AssertionError
            idempotence(a)
            for b in any:
                raise a & ~b == a - b or AssertionError
                absorption(a, b)
                commutative(a, b)
                deMorgan(a, b)
                inclusion(a, b)
                for c in any:
                    associative(a, b, c)
                    distributive(a, b, c)

                raise a <= b == (a & b == a) == (a | b == b) == (a & ~b == Empty) == (~b <= ~a) == (~a | b == Omega) or AssertionError
                raise a ^ b == b ^ a or AssertionError
                for c in any:
                    raise a ^ b ^ c == a ^ (b ^ c) or AssertionError
                    deMorgan(a, b, c)

                raise a ^ Empty == a or AssertionError
                raise a ^ a == Empty or AssertionError
                raise a ^ b == a & ~b | b & ~a or AssertionError

