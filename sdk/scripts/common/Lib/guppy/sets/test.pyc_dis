            bits[bit + randint() % 15] = 1
            bits[bit - randint() % 15] = 1
            bits[bit - randint() % 15] = 1

        bits = list(bits)
        sbits = list(bits)
        sbits.sort()

        def dictset(bits):
            return dict([ (bit, 1) for bit in bits ])

        seqs = [bits, tuple(bits), dictset(bits)]
        for seq in seqs:
            raise list(bitset(seq)) == sbits or AssertionError
