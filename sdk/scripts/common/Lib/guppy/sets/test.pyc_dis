        ns0 = ns
        a = []
        b = ()
        c = {}
        d = 0
        e = ''
        ns.add(a)
        ns.append(b)
        ns |= nodeset([c])
        raise not ns.tas(d) or AssertionError
        ns ^= [e]
        raise ns == nodeset([a,
         b,
         c,
         d,
         e]) or AssertionError
        ns ^= [e]
        raise ns == nodeset([a,
         b,
         c,
         d]) or AssertionError
        raise ns.tac(d) or AssertionError
        raise ns == nodeset([a, b, c]) or AssertionError
        ns -= nodeset([c])
        raise ns == nodeset([a, b]) or AssertionError
        ns.remove(b)
        raise ns == nodeset([a]) or AssertionError
        ns.discard(a)
        raise ns == nodeset([]) or AssertionError
        ns.add(a)
        raise ns.pop() is a or AssertionError
        try:
            ns.pop()
        except ValueError:
            pass
        else:
            raise 'expected ValueError'

        raise ns0 is ns or AssertionError
        ns = immnodeset(ns)
        ns |= nodeset([a])
        raise ns == nodeset([a]) or AssertionError
        raise ns is not ns0 or AssertionError
        ns1 = ns
        ns -= nodeset([a])
        raise ns is not ns1 or AssertionError
        raise ns == nodeset([]) or AssertionError
        ns = mutnodeset([1, 2, 3])
        raise len(ns) == 3 or AssertionError
        ns.clear()
        raise len(ns) == 0 or AssertionError
        raise list(ns) == [] or AssertionError

    def test31(self):
        H = mutnodeset
        from sys import getrefcount as grc
        e1 = []
        e2 = []
        e3 = []
        r1 = grc(e1)
        r2 = grc(e2)
        r3 = grc(e3)
        s = H()
        s.add(e1)
        raise e1 in s or AssertionError
        raise e2 not in s or AssertionError
        s.append(e2)
        raise e2 in s or AssertionError
        raise s.tas(e3) == 0 or AssertionError
        raise e3 in s or AssertionError
        raise r1 + 1 == grc(e1) or AssertionError
        raise r2 + 1 == grc(e2) or AssertionError
        raise r3 + 1 == grc(e3) or AssertionError
        raise s.tas(e3) == 1 or AssertionError
        raise s.tac(e3) == 1 or AssertionError
        raise s.tac(e3) == 0 or AssertionError
        s.discard(e3)
        s.remove(e2)
        try:
            s.append(e1)
        except ValueError:
            pass
        else:
            raise 'no exception from append'

        s.remove(e1)
        try:
            s.remove(e1)
        except ValueError:
            pass
        else:
            raise 'no exception from remove'

        raise r1 == grc(e1) or AssertionError
        raise r2 == grc(e2) or AssertionError
        raise r3 == grc(e3) or AssertionError
        s.add(e1)
        s.add(e2)
        s.add(e3)
        s = None
        raise r1 == grc(e1) or AssertionError
        raise r2 == grc(e2) or AssertionError
        raise r3 == grc(e3) or AssertionError
        import gc
        s = H()
        s.append(e1)
        s.append(s)
        raise s in s or AssertionError
        s = None
        gc.collect()
        s = H()
        s.append(e1)
        s.append(e2)
        e2.append(s)
        s = None
        e2 = None
        gc.collect()
        raise r1 == grc(e1) or AssertionError
        return

