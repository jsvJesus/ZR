MELEE_CONF_BYNAME = {}
MELEE_NAME_BYID = {}
for skill_id, e in enumerate(CONF, 1):
    e['skill_id'] = skill_id
    MELEE_CONF_BYNAME[e['name']] = e
    MELEE_NAME_BYID[skill_id] = e['name']

def getBestAttack(melee_skill_name):
    conf = MELEE_CONF_BYNAME.get(melee_skill_name)
    if not conf:
        return {}
    bestatt = {}
    for attack in conf.get('attacks', []):
        if not attack.get('powerful'):
            continue
        if not bestatt:
            bestatt = attack
            continue
        if attack['damage'][1] > bestatt['damage'][1]:
            bestatt = attack

    return bestatt


def getWorseAttack(melee_skill_name):
    conf = MELEE_CONF_BYNAME.get(melee_skill_name)
    if not conf:
        return {}
    worseatt = {}
    for attack in conf.get('attacks', []):
        if attack.get('powerful'):
            continue
        if not worseatt:
            worseatt = attack
            continue
        if attack['damage'][0] < worseatt['damage'][0]:
            worseatt = attack

    return worseatt