def get_perks_raw_data():
    return _p_data


def get_clan_perks_raw_data():
    return _clan_p_data


def set_persk_raw_data(data):
    data = deepcopy(data)
    data['nodes'].extend(_hidden_nodes.values())
    data['edges'].extend(_hidden_edges.values())
    data['nodes'] = sorted(data['nodes'], key=lambda k: k['id'])
    data['edges'] = sorted(data['edges'], key=lambda k: k['id'])
    os.getcwd()
    file_path = os.path.join(os.getcwd(), '../res/scripts/common/perks_system/perks.pyson')
    with open(file_path, 'w') as f:
        f.write(pyson.dumps(data))


section = ResMgr.openSection('scripts/common/perks_system/perks.pyson')
_p_data = pyson.loads(section.asBinary)
perks_version = _p_data.get('version', 0)
clan_section = ResMgr.openSection('scripts/common/perks_system/clan_perks.pyson')
_clan_p_data = pyson.loads(clan_section.asBinary)
_hidden_nodes = {}
_hidden_edges = {}

def filter_node(node):
    if node['params']['main'].get('visual') == PerkVisual.Hidden:
        _hidden_nodes[node['id']] = node
        return False
    return True


def filter_edge(edge):
    if not edge.get('node0') or not edge.get('node1'):
        _hidden_edges[edge['id']] = edge
        return False
    if edge['node0'] in _hidden_nodes or edge['node1'] in _hidden_nodes:
        _hidden_edges[edge['id']] = edge
        return False
    return True


_p_data['nodes'] = filter(filter_node, _p_data['nodes'])
_p_data['edges'] = filter(filter_edge, _p_data['edges'])
_clan_p_data['nodes'] = filter(filter_node, _clan_p_data['nodes'])
_clan_perk_ids = set((n['id'] for n in _clan_p_data['nodes']))
_perk_by_alias = {}
_perk_by_id = {}
_perks_by_action = defaultdict(list)
_registered_perks = set(_bit_mask_order)
raise len(_registered_perks) == len(_bit_mask_order) or AssertionError
for node in chain(_p_data['nodes'], _clan_p_data['nodes']):
    pid = node['params']['main'].get('pID')
    if pid:
        _perk_by_alias[pid] = node
    _perk_by_id[node['id']] = node
    if node['params']['main'].get('visual') == PerkVisual.Original:
        original_perk_id = node['id']
    actions = node['params'].get('actions', [])
    for action in actions:
        if node['id'] not in _perks_by_action[action['id']]:
            _perks_by_action[action['id']].append(node['id'])

    if node['id'] not in _registered_perks:
        print 'perks_parser (Warning): not registred perk', node['id']

_index_by_pid = {}
for index, pid in enumerate(_bit_mask_order):
    _index_by_pid[pid] = index
    if pid not in _perk_by_id:
        print "perks_parser (ERROR): perk doesn't exist", pid

_clan_perk_costs = list()
for p_id in _clan_perk_ids:
    _clan_perk_costs.append(get_cost(p_id))

_clan_perk_costs.sort()
section = ResMgr.openSection('scripts/common/perks_system/actions.json')
a_data = json.loads(section.asBinary)
_action_by_alias = {}
_action_by_id = {}
for branch in a_data:
    for action in branch['actions']:
        alias = action.get('alias')
        _action_by_id[action['id']] = action
        if alias:
            _action_by_alias[alias] = action

for perk in _perk_by_id.values():
    actions = perk['params'].get('actions', [])
    for action in actions:
        action_data = _action_by_id[action['id']]
        for vt in action_data.get('value_types', []):
            if vt['type'] == 'count':
                action['value'] = [1]

_filterclassname_to_filterkey = {'CreatureType': 'creatureType',
 'WeaponStateFilter': 'weapon',
 'GunTypeFilter': 'gun',
 'PlayerStateFilter': 'player',
 'ItemClassFilter': 'item_class',
 'ItemLevelFilter': 'item_level',
 'DamageTypesFilter': 'damage_type',
 'PerkNames': 'perk_name',
 'ItemCategoryFilter': 'category',
 'CreatureBodyZone': 'body_zone',
 'WorkbenchFilter': 'workbench',
 'DeviceTypeFilter': 'device_type'}
MAX_LEVEL = 150
_exp_to_level = [0]
for l in xrange(1, MAX_LEVEL + 1):
    value = int(round(pow(l + 4, 3.27) + _exp_to_level[l - 1] + 757))
    _exp_to_level.append(value)

def exp_to_level(exp):
    """ \xd0\xbf\xd1\x80\xd0\xb5\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbb\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd0\xbe \xd0\xbe\xd0\xbf\xd1\x8b\xd1\x82\xd0\xb0 \xd0\xb2 \xd1\x81\xd0\xbe\xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd1\x83\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd0\xbd\xd1\x8c
            \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd1\x80\xd1\x82\xd0\xb5\xd0\xb6:https://discord.com/channels/@me/691955492058038334
                    (\xd1\x83\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd0\xbd\xd1\x8c, \xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd0\xbe\xd0\xba \xd0\xbe\xd0\xbf\xd1\x8b\xd1\x82\xd0\xb0, \xd0\xb2\xd1\x81\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xbf\xd1\x8b\xd1\x82\xd0\xb0 \xd0\xb4\xd0\xbe \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb3\xd0\xbe \xd1\x83\xd1\x80\xd0\xbe\xd0\xb2\xd0\xbd\xd1\x8f)
    """
    if exp >= MAX_EXP_VALUE:
        return (MAX_LEVEL, exp - MAX_EXP_VALUE, None)
    else:
        exp_index = bisect.bisect_right(_exp_to_level, exp)
        level = exp_index - 1
        return (level, exp - _exp_to_level[level], _exp_to_level[exp_index] - _exp_to_level[exp_index - 1])


MAX_EXP_VALUE = _exp_to_level[-1]
_clanaura_perk_ids = set(filter(get_effect_aura, _clan_perk_ids))
_aura_effects = map(get_effect_aura, _clanaura_perk_ids)