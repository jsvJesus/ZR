def get_perk_cleaning_val_and_level(bitmask, action_name):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd1\x80\xd1\x82\xd0\xb5\xd0\xb6 (value, level) """
    action_data = _action_by_alias[action_name]
    value = 0
    level = 0
    for perk_id in _perks_by_action[action_data['id']]:
        if not _get_bitvalue(perk_id, bitmask):
            continue
        perk_data = _perk_by_id[perk_id]
        for perk_action_data in perk_data['params']['actions']:
            if perk_action_data['id'] != action_data['id']:
                continue
            value += perk_action_data['value'][0]
            level = max(level, perk_action_data['filters'][0])

    return (value, level)


def get_perk_action_val(alias, bitmask, **bit_filters):
    """ \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xbe\xd0\xb2: weapon, player, gun, item_class, item_level, damage_type, creatureType, body_zone, perk_name, category, workbench
    """
    action_data = _action_by_alias[alias]
    action_data_filters = action_data.get('filters', [])
    valid_values = []
    for perk_id in _perks_by_action[action_data['id']]:
        if not _get_bitvalue(perk_id, bitmask):
            continue
        perk_data = _perk_by_id[perk_id]
        for perk_action_data in perk_data['params']['actions']:
            if perk_action_data['id'] != action_data['id']:
                continue
            perk_action_filters = perk_action_data.get('filters', [])
            while len(perk_action_filters) < len(action_data_filters):
                perk_action_filters.append(0)

            for i, action_data_filter in enumerate(action_data_filters):
                filter_name = _filterclassname_to_filterkey[action_data_filter]
                needed_mask = perk_action_filters[i]
                player_value = bit_filters.get(filter_name)
                if player_value is None:
                    break
                if filter_name == 'item_level':
                    if player_value > needed_mask:
                        break
                else:
                    bits = getattr(actions_utils, action_data_filter).bits
                    player_mask = bits.get(player_value, 0)
                    if not needed_mask & player_mask:
                        break
            else:
                if 'value' in perk_action_data:
                    valid_values.append(perk_action_data['value'])

    value_types = action_data['value_types']
    values = []
    kv_dict = None
    for i, vt in enumerate(value_types):
        type_values = [ v[i] for v in valid_values ]
        if vt['type'] == 'float01':
            if len(type_values) == 0:
                value = 0
            elif len(type_values) == 1:
                value = type_values[0] / 100.0
            else:
                value = 1.0 - reduce(lambda x, y: x * y, [ 1.0 - v / 100.0 for v in type_values ])
        elif vt['type'] == 'float+%':
            value = sum(type_values) * 0.01
        elif vt['type'] == 'key':
            if kv_dict is None:
                kv_dict = {}
            kv_dict['keys'] = type_values
            kv_dict['index'] = i
            continue
        elif vt['type'] == 'value':
            if kv_dict is None:
                kv_dict = {}
            kv_dict['values'] = type_values
            continue
        elif vt['type'] == 'count':
            value = len(type_values)
        elif vt['type'] == 'intmax':
            value = max(type_values) if type_values else 0
        elif vt['type'] == 'gmean':
            if type_values:
                value = sqrt(sum((v * v for v in type_values)))
            else:
                value = 0
        elif vt['type'] in ('intlist', 'floatlist'):
            value = type_values
        else:
            value = sum(type_values)
        values.append(value)

    if kv_dict:
        value = {}
        for k, v in zip(kv_dict['keys'], kv_dict['values']):
            if k not in value:
                value[k] = 0
            value[k] += v

        values.insert(kv_dict['index'], value)
    if len(values) == 1:
        return values[0]
    else:
        return values


def has_perk(perk_alias, bitmask):
    perk = _perk_by_alias.get(perk_alias)
    return perk and _get_bitvalue(perk['id'], bitmask) or False


def has_perk_id(perk_id, bitmask):
    return _get_bitvalue(perk_id, bitmask)


def is_perk_valid(perk_id):
    return perk_id in _index_by_pid


def set_perk_by_alias(perk_alias, bitmask):
    perk = _perk_by_alias.get(perk_alias)
    if perk:
        _set_bitvalue(perk['id'], bitmask)


def get_perk_by_alias(perk_alias, bitmask):
    perk = _perk_by_alias.get(perk_alias)
    return _get_bitvalue(perk['id'], bitmask)


def set_perk_by_id(perk_id, bitmask):
    _set_bitvalue(perk_id, bitmask)


def del_perk_by_id(perk_id, bitmask):
    _del_bitvalue(perk_id, bitmask)


def clear_perks(bitmask):
    bitmask[:] = []


def calc_perks_count(bitmask):
    MASK_LEN = 64
    result = 0
    for n, b in enumerate(bitmask):
        i = 0
        while b:
            if bool(b & 1):
                pid = _bit_mask_order[n * MASK_LEN + i]
                result += _perk_by_id[pid]['params']['main'].get('spoints', 0)
            b >>= 1
            i += 1

    return result


def clear_clan_perks(bitmask):
    cleared = []
    for perk_id in _clan_perk_ids:
        if has_perk_id(perk_id, bitmask):
            del_perk_by_id(perk_id, bitmask)
            cleared.append(perk_id)

    return cleared


def has_any_clan_perk(bitmask):
    for perk_id in _clan_perk_ids:
        if has_perk_id(perk_id, bitmask):
            return True

    return False


def get_clanaura_perks(bitmask):
    return [ perk_id for perk_id in _clanaura_perk_ids if has_perk_id(perk_id, bitmask) and get_effect_aura(perk_id) ]


def is_perkaura(effect_id):
    return effect_id in _aura_effects


def _set_bitvalue(perk_id, bitmask):
    MASK_LEN = 64
    bit_index = _index_by_pid.get(perk_id)
    if bit_index is None:
        print 'Perk parser (ERROR): perk not found', repr(perk_id)
        traceback.print_stack()
        return
    else:
        int_index = bit_index / MASK_LEN
        while len(bitmask) <= int_index:
            bitmask.append(0)

        bit_index = bit_index % MASK_LEN
        bitmask[int_index] |= 1 << bit_index
        return


def _del_bitvalue(perk_id, bitmask):
    MASK_LEN = 64
    bit_index = _index_by_pid.get(perk_id)
    if bit_index is None:
        print 'Perk parser (ERROR): perk not found', repr(perk_id)
        traceback.print_stack()
        return
    else:
        int_index = bit_index / MASK_LEN
        if len(bitmask) <= int_index:
            return
        bit_index = bit_index % MASK_LEN
        bitmask[int_index] &= ~(1 << bit_index)
        return


def _get_bitvalue(perk_id, bitmask):
    if perk_id == original_perk_id:
        return True
    else:
        MASK_LEN = 64
        bit_index = _index_by_pid.get(perk_id)
        if bit_index is None:
            return False
        int_index = bit_index / MASK_LEN
        if len(bitmask) <= int_index:
            return False
        bit_index = bit_index % MASK_LEN
        return bool(bitmask[int_index] & 1 << bit_index)


def get_action_alias_by_id(action_id):
    action = _action_by_id.get(action_id)
    return action and action.get('alias')


def get_perk_level(perk_id):
    return get_perk_data_by_id(perk_id)['params']['main']['level']


def get_cost(perk_id):
    return get_perk_data_by_id(perk_id)['params']['main'].get('cost', 0)


def get_effect_aura(perk_id):
    return get_perk_data_by_id(perk_id)['params']['main'].get('clan_effect')


def has_clan_perks_from_cost_change(points, prev_points):
    max_points = max(points, prev_points)
    min_points = min(points, prev_points)
    for cost in _clan_perk_costs:
        if max_points >= cost and min_points < cost:
            return True

    return False


def get_diff_clan_perks_from_points(perkpath, bitmask):
    add_perks = []
    del_perks = []
    for p_id in perkpath:
        if not has_perk_id(p_id, bitmask):
            add_perks.append(p_id)

    perkpath = set(perkpath)
    for p_id in _clan_perk_ids:
        if has_perk_id(p_id, bitmask) and p_id not in perkpath:
            del_perks.append(p_id)

    return (add_perks, del_perks)


def get_perk_data_by_id(perk_id):
    return _perk_by_id[perk_id]


def get_perk_id_by_alias(alias):
    perk = _perk_by_alias.get(alias)
    if perk:
        return perk['id']
    else:
        return None


