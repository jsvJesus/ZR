# Embedded file name: ./common/perks_system/common_perk_user.py
import traceback
from perks_system import perks_parser
CLEAR_PERKS_ITEM = 901900
CLEAR_PERKS_COST = 10
FREE_RESETS = 1
RESET_COOLDOWN = 24
RELOAD_COOLDOWN = 30

class CommonPerkUser(object):

    def has_perk(self, alias):
        return perks_parser.has_perk(alias, self.perks)

    def has_perk_id(self, perk_id):
        return perks_parser.has_perk_id(perk_id, self.perks)

    def get_perk_action_val(self, alias, **bit_filters):
        if not hasattr(self, '_perks_actions_cache') or len(self._perks_actions_cache) > 20:
            self._perks_actions_cache = {}
        try:
            if bit_filters:
                key = tuple([alias] + sorted(bit_filters.items()))
            else:
                key = alias
            if key not in self._perks_actions_cache:
                self._perks_actions_cache[key] = perks_parser.get_perk_action_val(alias, self.perks, **bit_filters)
            return self._perks_actions_cache[key]
        except:
            traceback.print_exc()
            traceback.print_stack()
            return 0.0

    def get_perk_cleaning_val_and_level(self, action_name):
        return perks_parser.get_perk_cleaning_val_and_level(self.perks, action_name)

    def on_perks_updated(self):
        if hasattr(self, '_perks_actions_cache'):
            del self._perks_actions_cache

    def send_perk_message(self, alias, success):
        if not self.has_perk(alias):
            return
        perk_id = perks_parser.get_perk_id_by_alias(alias)
        self.client.send_perk_message(perk_id, success)