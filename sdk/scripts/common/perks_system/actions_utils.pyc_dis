class CreatureType:
    _mobs = {}
    for ct, cf in CommonConfig.creature_type_to_folder.items():
        _mobs[int(ct)] = cf

    bits = {}
    for m_id, m_name in _mobs.items():
        bits[m_id] = 1 << m_id

    @staticmethod
    def get_alias(bit):
        return CreatureType._mobs[bit]


class CreatureBodyZone:
    bits = {}
    for z_id, z_name in CC.ZONE_TO_BODYNAME.items():
        if z_id >= 0:
            bits[z_id] = 1 << z_id

    @staticmethod
    def get_alias(bit):
        return CC.ZONE_TO_BODYNAME[bit].lower()


