class PerkNames:
    _data = ('SEMIFINISHED', 'SIMPLE', 'ORGANS', 'SUBSTANCES', 'RAW', 'BEAR', 'BLYAK', 'BOAR', 'BRUTOR', 'DOG', 'DRAUG', 'IMP', 'IMPENETRABLE', 'JELLY', 'OUTCAST', 'RAT', 'REPEY', 'SILVAN', 'SPIDER', 'VEDUN', 'VERLIOKA')
    bits = {}
    for i in xrange(len(_data)):
        bits[i + 1] = 1 << i

    @staticmethod
    def get_alias(bit):
        return PerkNames._data[bit - 1]

    @staticmethod
    def get_index(alias):
        return PerkNames._data.index(alias) + 1


