# Embedded file name: ./clearpycs.py
import os
pyc_files = []
for path in [os.getcwd(), os.getcwd() + '../../../sys/res/scripts']:
    for root, dirs, files in os.walk(os.path.abspath(path)):
        pyc_files.extend([ os.path.join(root, file) for file in files if os.path.splitext(file)[1] == '.pyc' ])

pyc_amount = len(pyc_files)
for f in pyc_files:
    os.remove(f)

print '{0} .pyc files have been deleted'.format(pyc_amount)