<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Editor.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#82B5FF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Editor/Styles/EditorTheme.axaml" />
  </Application.Styles>
</Application>
