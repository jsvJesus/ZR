<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:characters="clr-namespace:Editor.Characters"
    xmlns:environment="clr-namespace:Editor.Environment"
    xmlns:roads="clr-namespace:Editor.Roads"
    xmlns:objects="clr-namespace:Editor.Objects"
    xmlns:terrain="clr-namespace:Editor.Terrain"
    xmlns:vegetation="clr-namespace:Editor.Vegetation"
    xmlns:viewport="clr-namespace:Editor.Viewport"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Editor.MainWindow"
    Classes="editor"
    Title="ZoneReborn — Editor"
    Width="1500"
    Height="900"
    MinWidth="1100"
    MinHeight="680"
    WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,28">
    <Border Background="{DynamicResource EditorSurface}" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="0,0,0,1">
      <Grid RowDefinitions="34,44">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0">
          <TextBlock Text="ZONE REBORN" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0" />
          <Menu Grid.Column="1" Background="Transparent">
            <MenuItem Header="Файл">
              <MenuItem x:Name="OpenLevelMenu" Header="Открыть уровень…" Click="OpenLevel_Click" />
              <MenuItem x:Name="SaveLevelMenu" Header="Сохранить уровень" InputGesture="Ctrl+S" Click="SaveLevel_Click" />
              <Separator />
              <MenuItem x:Name="ImportLevelMenu" Header="Импортировать уровень…" Click="ImportLevel_Click" />
              <MenuItem x:Name="ImportAllLevelsMenu" Header="Импортировать все уровни" Click="ImportAllLevels_Click" />
              <MenuItem x:Name="CancelImportMenu" Header="Отменить импорт" IsEnabled="False" Click="CancelImport_Click" />
              <Separator />
              <MenuItem Header="Выход" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="Разделы">
              <MenuItem x:Name="LevelEditorMenu" Header="Ландшафт">
                <MenuItem Header="Рельеф" Click="Terrain_Click" />
              </MenuItem>
              <MenuItem Header="Материалы" Click="TerrainMaterials_Click" />
              <MenuItem Header="Растительность" Click="Vegetation_Click" />
              <MenuItem x:Name="ObjectsEditorMenu" Header="Объекты">
                <MenuItem Header="Объекты сцены" Click="ObjectsInScene_Click" />
                <MenuItem Header="Размещение" Click="ObjectsPlace_Click" />
                <MenuItem Header="Импорт" Click="ObjectsImport_Click" />
                <MenuItem Header="Коллизия" Click="ObjectsCollision_Click" />
              </MenuItem>
              <MenuItem x:Name="SceneEditorMenu" Header="Окружение">
                <MenuItem Header="Освещение" Click="Lighting_Click" />
                <MenuItem Header="Тени" Click="Shadows_Click" />
                <MenuItem Header="Облака" Click="Clouds_Click" />
                <MenuItem Header="Погода" Click="Weather_Click" />
              </MenuItem>
              <MenuItem x:Name="CharacterEditorMenu" Header="Персонаж" Click="CharacterEditor_Click" />
            </MenuItem>
          </Menu>
          <TextBlock Grid.Column="2" Text="WORLD EDITOR" Classes="eyebrow" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="8,3">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="OpenToolbarButton" Classes="toolbar" Content="Открыть" Click="OpenLevel_Click" ToolTip.Tip="Открыть уровень" />
            <Button x:Name="SaveToolbarButton" Classes="primary" Content="Сохранить" Click="SaveLevel_Click" ToolTip.Tip="Сохранить уровень · Ctrl+S" />
            <Border Width="1" Background="{DynamicResource EditorBorder}" Margin="8,5" />
            <Button x:Name="UndoButton" Classes="toolbar" Content="↶" FontSize="18" Click="Undo_Click" ToolTip.Tip="Отменить в активном редакторе" />
            <Button x:Name="RedoButton" Classes="toolbar" Content="↷" FontSize="18" Click="Redo_Click" ToolTip.Tip="Повторить изменение объекта" />
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="LevelNameText" Text="Уровень не открыт" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <Button x:Name="ToggleLeftButton" Classes="toolbar" Content="◧" Click="ToggleLeftPanel_Click" ToolTip.Tip="Скрыть / показать левую панель" />
            <Button x:Name="ToggleRightButton" Classes="toolbar" Content="◨" Click="ToggleRightPanel_Click" ToolTip.Tip="Скрыть / показать свойства" />
            <Button x:Name="PlayButton" Classes="primary" Content="▶ Play" Margin="8,0,0,0" Padding="18,5" IsEnabled="False" Click="Play_Click" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnDefinitions="270,5,*,5,310">
      <Border x:Name="LeftSidebar" Background="{DynamicResource EditorSurface}" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="12,14,12,10" Spacing="10">
            <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Classes="eyebrow" />
            <Grid x:Name="WorkspaceNavigation" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,4,12,16" Spacing="12">
              <Border Height="1" Background="{DynamicResource EditorBorder}" />
              <TextBlock Text="ВЫБОР И КАТАЛОГИ" Classes="eyebrow" />
              <StackPanel x:Name="BrowserPanels" Spacing="10" />
              <StackPanel x:Name="EnvironmentBrowser" Spacing="4" IsVisible="False">
                <Button Classes="nav" Content="Освещение" Click="Lighting_Click" />
                <Button Classes="nav" Content="Тени" Click="Shadows_Click" />
                <Button Classes="nav" Content="Облака" Click="Clouds_Click" />
                <Button Classes="nav" Content="Погода" Click="Weather_Click" />
                <TextBlock Text="Параметры выбранного раздела находятся справа и применяются ко всей сцене." Classes="muted" Margin="0,10,0,0" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" MinWidth="320">
        <Border Background="{DynamicResource EditorSurface}" Padding="12,9" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="СЦЕНА" Classes="eyebrow" />
              <TextBlock x:Name="CurrentModeText" Text="Ландшафт / Рельеф" Foreground="{DynamicResource EditorAccent}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
              <ToggleButton x:Name="CameraSettingsToggle" Content="Камера" Padding="8,4" ToolTip.Tip="Настройки камеры и сетки" />
              <ToggleButton x:Name="NavigationHelpToggle" Content="?" Padding="10,4" ToolTip.Tip="Управление и подсказки" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Background="{DynamicResource EditorSurface}">
          <Border x:Name="CameraSettingsPanel" IsVisible="False" Margin="8,3">
            <StackPanel Margin="8" Spacing="6">
              <CheckBox x:Name="GridCheck" Content="Отображать сетку" IsChecked="False" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Скорость камеры" Classes="muted" />
                <TextBlock Grid.Column="1" x:Name="SpeedText" Text="8.0 м/с" />
              </Grid>
              <Slider x:Name="CameraSpeedSlider" Value="8" TickFrequency="1" />
              <TextBlock x:Name="PositionText" Text="X: 0  Y: 4  Z: -12" FontFamily="Consolas" />
              <TextBlock x:Name="RotationText" Text="Yaw: 0  Pitch: 0" FontFamily="Consolas" />
            </StackPanel>
          </Border>
          <Border x:Name="NavigationHelpPanel" IsVisible="False" Margin="8,0,8,4">
            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="8" Margin="8">
                <TextBlock x:Name="PlayHint" Text="Персонаж появится на Terrain под камерой" Classes="muted" />
                <StackPanel x:Name="FreeNavigationHints" Spacing="8">
                  <TextBlock Text="W / A / S / D — движение" FontSize="12" Classes="muted" />
                  <TextBlock Text="Space — подняться" FontSize="12" Classes="muted" />
                  <TextBlock Text="Shift — опуститься" FontSize="12" Classes="muted" />
                  <TextBlock Text="ПКМ + мышь — обзор" FontSize="12" Classes="muted" />
                  <TextBlock Text="Колёсико — скорость" FontSize="12" Classes="muted" />
                  <TextBlock Text="ЛКМ — фокус на сцене" FontSize="12" Classes="muted" />
                </StackPanel>
                <StackPanel x:Name="PlayNavigationHints" Spacing="8" IsVisible="False">
                  <TextBlock Text="W / A / S / D — бег" FontSize="12" Classes="muted" />
                  <TextBlock Text="Ctrl — присесть / встать" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="C — переключить ходьбу · Shift — спринт" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="ПКМ — прицеливание (FPS)" FontSize="12" Classes="muted" />
                  <TextBlock Text="Space — прыжок" FontSize="12" Classes="muted" />
                  <TextBlock Text="Q / E — удерживать наклон влево / вправо" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="H — достать / убрать оружие" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="Мышь — свободный обзор" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="F8 — отвязать камеру для осмотра" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="Esc / Stop — вернуться в редактор" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
                <StackPanel x:Name="InspectionNavigationHints" Spacing="8" IsVisible="False">
                  <TextBlock Text="ОСМОТР · персонаж зафиксирован" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="W / A / S / D — свободный полёт" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="Space — вверх · Shift — вниз" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="Мышь — обзор · колёсико — скорость" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="F8 — вернуться к персонажу" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="Esc / Stop — вернуться в редактор" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
                <TextBlock x:Name="AnimStateInfo" Classes="muted" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </StackPanel>
        <Border Grid.Row="2" Background="#101318">
          <viewport:DxViewportHost x:Name="Viewport" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>
      </Grid>
      <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
      <Border x:Name="RightSidebar" Grid.Column="4" Background="{DynamicResource EditorSurface}" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="14,14,14,12" Spacing="6">
            <TextBlock Text="СВОЙСТВА И ИНСТРУМЕНТЫ" Classes="eyebrow" />
            <TextBlock x:Name="ModeTitle" Text="Рельеф" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="ModeDetails" Text="Параметры активного инструмента." Classes="muted" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,0,14,16" Spacing="10">
              <vegetation:VegetationPanel x:Name="VegetationPanel" IsVisible="False" />
              <roads:RoadsPanel x:Name="RoadsPanel" IsVisible="False" />
              <objects:ObjectsPanel x:Name="ObjectsPanel" IsVisible="False" />
              <terrain:TerrainEditorPanel x:Name="TerrainEditorPanel" IsVisible="False" />
              <characters:CharacterEditorPanel x:Name="CharacterPanel" IsVisible="False" />
              <environment:EnvironmentPanel x:Name="EnvironmentPanel" IsVisible="False" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource EditorSurface}" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0">
        <TextBlock x:Name="StatusText" Text="Редактор готов" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="ZoneReborn" Classes="eyebrow" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
