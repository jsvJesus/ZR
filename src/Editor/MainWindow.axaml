<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Editor.MainWindow"
        Title="ZoneReborn — Editor"
        Width="1480"
        Height="920"
        MinWidth="1120"
        MinHeight="700"
        Background="#15191F"
        Foreground="#DDE2EB"
        FontFamily="Inter"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="54,42,*,28">
    <!-- Application title bar -->
    <Border Grid.Row="0"
            Background="#191D24"
            BorderBrush="#303640"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
          <Border Width="30"
                  Height="30"
                  CornerRadius="8"
                  Background="#2F6CA3">
            <TextBlock Text="Z"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="ZoneReborn"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FA" />
            <TextBlock Text="WORLD EDITOR  /  STARTER"
                       FontSize="9"
                       LetterSpacing="1.5"
                       Foreground="#8492A3" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
          <Border Background="#232C37"
                  CornerRadius="5"
                  Padding="11,6">
            <TextBlock Text="EMPTY PROJECT"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1"
                       Foreground="#A4B5C6" />
          </Border>
          <Border Background="#263F53"
                  CornerRadius="5"
                  Padding="11,6">
            <TextBlock Text=".NET 10"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#7BC4FF" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Visual toolbar: intentionally no commands -->
    <Border Grid.Row="1"
            Background="#222730"
            BorderBrush="#333A45"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="24"
                    VerticalAlignment="Center">
          <TextBlock Text="Файл" FontSize="12" Foreground="#C1C8D2" />
          <TextBlock Text="Правка" FontSize="12" Foreground="#C1C8D2" />
          <TextBlock Text="Вид" FontSize="12" Foreground="#C1C8D2" />
          <TextBlock Text="Инструменты" FontSize="12" Foreground="#C1C8D2" />
          <TextBlock Text="Окно" FontSize="12" Foreground="#C1C8D2" />
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="○" Foreground="#8F9BA8" FontSize="15" />
          <TextBlock Text="Без активного мира" Foreground="#8F9BA8" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="258,*,300">
      <!-- Left: content browser -->
      <Border Grid.Column="0"
              Classes="panel"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="43,*,195">
          <Border Grid.Row="0"
                  Background="#252B34"
                  BorderBrush="#323843"
                  BorderThickness="0,0,0,1">
            <Grid Margin="16,0" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Classes="panel-title"
                         Text="CONTENT BROWSER"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="▦"
                         FontSize="15"
                         Foreground="#8997A7"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="11" Margin="17,18,17,0">
              <TextBlock Text="PROJECT ROOT"
                         FontSize="10"
                         LetterSpacing="1.2"
                         FontWeight="SemiBold"
                         Foreground="#717F90" />
              <Border Background="#283542"
                      BorderBrush="#3C576E"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="11,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="▸" Foreground="#7FC3F4" FontSize="12" />
                  <TextBlock Text="Content" Foreground="#DCECF8" FontSize="12" />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="15,6,0,0">
                <TextBlock Text="◇" Foreground="#8C98A9" FontSize="12" />
                <TextBlock Text="packs" Foreground="#9FA9B7" FontSize="12" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="15,0,0,0">
                <TextBlock Text="◇" Foreground="#8C98A9" FontSize="12" />
                <TextBlock Text="Worlds" Foreground="#9FA9B7" FontSize="12" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="15,0,0,0">
                <TextBlock Text="◇" Foreground="#8C98A9" FontSize="12" />
                <TextBlock Text="Materials" Foreground="#9FA9B7" FontSize="12" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="6">
              <TextBlock Text="Нет ресурсов"
                         Foreground="#A5AEBA"
                         FontSize="12"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Папка проекта пуста"
                         Classes="muted"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="2"
                  Background="#1B2027"
                  BorderBrush="#343A43"
                  BorderThickness="0,1,0,0">
            <Grid RowDefinitions="38,*">
              <Border Grid.Row="0"
                      BorderBrush="#313844"
                      BorderThickness="0,0,0,1">
                <TextBlock Text="ASSET PREVIEW"
                           Classes="panel-title"
                           VerticalAlignment="Center"
                           Margin="16,0" />
              </Border>
              <StackPanel Grid.Row="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="10">
                <TextBlock Text="▧"
                           FontSize="26"
                           Foreground="#5F6E7F"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Выберите ресурс"
                           Classes="muted"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Center: empty viewport with an output panel -->
      <Grid Grid.Column="1" RowDefinitions="*,182">
        <Grid Grid.Row="0" RowDefinitions="42,*">
          <Border Grid.Row="0"
                  Background="#222832"
                  BorderBrush="#353D49"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0">
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          Spacing="14"
                          VerticalAlignment="Center">
                <Border Background="#2C3845"
                        BorderBrush="#3B566E"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10,6">
                  <TextBlock Text="VIEWPORT"
                             FontSize="10"
                             LetterSpacing="1"
                             FontWeight="SemiBold"
                             Foreground="#A6D5FC" />
                </Border>
                <TextBlock Text="Perspective"
                           FontSize="11"
                           Foreground="#B6C0CD"
                           VerticalAlignment="Center" />
                <TextBlock Text="Lit"
                           FontSize="11"
                           Foreground="#818E9F"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="14"
                          VerticalAlignment="Center">
                <TextBlock Text="⊞" FontSize="17" Foreground="#8A96A4" />
                <TextBlock Text="▧" FontSize="17" Foreground="#8A96A4" />
                <TextBlock Text="⋯" FontSize="18" Foreground="#8A96A4" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="#12171D">
            <Grid>
              <Border Width="320"
                      Height="238"
                      Background="#161D25"
                      BorderBrush="#29323E"
                      BorderThickness="1"
                      CornerRadius="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="11">
                  <Border Width="70"
                          Height="70"
                          Background="#223242"
                          BorderBrush="#3D5F7B"
                          BorderThickness="1"
                          CornerRadius="16"
                          HorizontalAlignment="Center">
                    <TextBlock Text="◇"
                               FontSize="42"
                               Foreground="#81C5F3"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="Пустая сцена"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#DCE5EF"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="Здесь появится игровой мир"
                             FontSize="11"
                             Foreground="#8493A2"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <StackPanel HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Orientation="Horizontal"
                          Spacing="12"
                          Margin="18,0,0,16">
                <TextBlock Text="X: 0" FontSize="10" Foreground="#71808F" />
                <TextBlock Text="Y: 0" FontSize="10" Foreground="#71808F" />
                <TextBlock Text="Z: 0" FontSize="10" Foreground="#71808F" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,18,18,0"
                          Orientation="Horizontal"
                          Spacing="6">
                <TextBlock Text="X" Foreground="#F77F7F" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Y" Foreground="#91D896" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Z" Foreground="#78BFF7" FontSize="12" FontWeight="Bold" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Border Grid.Row="1"
                Background="#1D2229"
                BorderBrush="#353C47"
                BorderThickness="0,1,0,0">
          <Grid RowDefinitions="41,*">
            <Border Grid.Row="0"
                    Background="#252B34"
                    BorderBrush="#353C47"
                    BorderThickness="0,0,0,1">
              <Grid Margin="16,0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="20"
                            VerticalAlignment="Center">
                  <TextBlock Text="OUTPUT LOG" Classes="panel-title" />
                  <TextBlock Text="CONSOLE" FontSize="10" Foreground="#6F7D8E" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="0 MESSAGES"
                           Foreground="#728294"
                           FontSize="10"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="18,19" Spacing="8">
              <TextBlock Text="[ Editor ]  Интерфейс инициализирован"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="11"
                         Foreground="#82B993" />
              <TextBlock Text="[ Project ]  Нет открытого мира"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="11"
                         Foreground="#748293" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Right: hierarchy and details -->
      <Border Grid.Column="2"
              Background="#20242C"
              BorderBrush="#323843"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="*,*">
          <Grid Grid.Row="0" RowDefinitions="43,Auto,*">
            <Border Grid.Row="0"
                    Background="#252B34"
                    BorderBrush="#323843"
                    BorderThickness="0,0,0,1">
              <Grid Margin="16,0" ColumnDefinitions="*,Auto">
                <TextBlock Text="WORLD OUTLINER"
                           Classes="panel-title"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="▤"
                           FontSize="15"
                           Foreground="#8897A9"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Grid.Row="1"
                    Background="#191F26"
                    BorderBrush="#303843"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="14,14,14,10"
                    Padding="11,9">
              <TextBlock Text="Поиск объектов..."
                         FontSize="11"
                         Foreground="#667687" />
            </Border>
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <TextBlock Text="◌"
                         FontSize="30"
                         Foreground="#63758B"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Объектов нет"
                         FontSize="12"
                         Foreground="#A8B2BE"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" RowDefinitions="43,*">
            <Border Grid.Row="0"
                    Background="#252B34"
                    BorderBrush="#323843"
                    BorderThickness="0,1,0,1">
              <TextBlock Text="DETAILS / INSPECTOR"
                         Classes="panel-title"
                         VerticalAlignment="Center"
                         Margin="16,0" />
            </Border>
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <TextBlock Text="◈"
                         FontSize="28"
                         Foreground="#63758B"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Ничего не выбрано"
                         FontSize="12"
                         Foreground="#A8B2BE"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Параметры появятся здесь"
                         FontSize="11"
                         Foreground="#718091"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom status bar -->
    <Border Grid.Row="3"
            Background="#171D24"
            BorderBrush="#313944"
            BorderThickness="0,1,0,0">
      <Grid Margin="14,0" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="9"
                    VerticalAlignment="Center">
          <TextBlock Text="●" FontSize="10" Foreground="#76BF94" />
          <TextBlock Text="Готово"
                     FontSize="10"
                     Foreground="#A8B6C6" />
          <TextBlock Text="  /  " FontSize="10" Foreground="#556578" />
          <TextBlock Text="Макет редактора"
                     FontSize="10"
                     Foreground="#7B8897" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="STARTER BUILD  •  v0.1"
                   FontSize="10"
                   Foreground="#6C7B8B"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
