<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:Editor.Viewport"
        xmlns:roads="clr-namespace:Editor.Roads"
        x:Class="Editor.MainWindow"
        Title="ZoneReborn — Editor"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="680"
        Background="#17191E"
        Foreground="#DCE1E8"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="44,*,28">

        <!-- Main menu -->
        <Border Grid.Row="0"
                Background="#202329"
                BorderBrush="#343941"
                BorderThickness="0,0,0,1">

            <Menu Background="Transparent"
                  Foreground="#E5E9EF"
                  VerticalAlignment="Center"
                  Margin="8,0">

                <MenuItem Header="File">
                    <MenuItem x:Name="ImportLevelMenu"
                              Header="Импортировать исходный уровень..."
                              Click="ImportLevel_Click" />
                    <MenuItem x:Name="ImportAllLevelsMenu"
                              Header="Импортировать все исходные уровни"
                              Click="ImportAllLevels_Click" />
                    <MenuItem x:Name="CancelImportMenu"
                              Header="Отменить импорт"
                              IsEnabled="False"
                              Click="CancelImport_Click" />
                    <Separator />
                    <MenuItem x:Name="OpenLevelMenu" Header="Открыть уровень..."
                              Click="OpenLevel_Click" />
                    <MenuItem x:Name="SaveLevelMenu" Header="Сохранить позицию камеры"
                              Click="SaveLevel_Click" />
                    <Separator />
                    <MenuItem Header="Выход"
                              Click="Exit_Click" />
                </MenuItem>

                <MenuItem Header="Level editor">
                    <MenuItem Header="Terrain"
                              Click="Terrain_Click" />
                    <MenuItem Header="Roads"
                              Click="Roads_Click" />
                    <MenuItem Header="Высоты и рельеф"
                              Click="Heights_Click" />
                    <MenuItem Header="Текстуры поверхности"
                              Click="TerrainMaterials_Click" />
                    <MenuItem Header="Растительность"
                              Click="Vegetation_Click" />
                </MenuItem>

                <MenuItem Header="Scene editor">
                    <MenuItem Header="Освещение"
                              Click="Lighting_Click" />
                    <MenuItem Header="Тени"
                              Click="Shadows_Click" />
                    <MenuItem Header="Облака"
                              Click="Clouds_Click" />
                    <MenuItem Header="Погода"
                              Click="Weather_Click" />
                </MenuItem>

                <MenuItem Header="Objects editor">
                    <MenuItem Header="Объекты сцены"
                              Click="Objects_Click" />
                    <MenuItem Header="Размещение объектов"
                              Click="Placement_Click" />
                    <MenuItem Header="Свойства объектов"
                              Click="ObjectProperties_Click" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1"
              ColumnDefinitions="260,5,*,5,310">

            <!-- Left: information -->
            <Border Grid.Column="0"
                    Background="#202329"
                    BorderBrush="#353A44"
                    BorderThickness="0,0,1,0">

                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="16">

                        <TextBlock Text="ИНФОРМАЦИЯ"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#D9E1EC" />

                        <Border Height="1" Background="#353B45" />

                        <TextBlock Text="ПРОЕКТ"
                                   FontSize="11"
                                   Foreground="#8291A4" />

                        <TextBlock Text="ZoneReborn"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Уровень: Untitled"
                                   x:Name="LevelNameText"
                                   Foreground="#9CA8B8"
                                   FontSize="12" />

                        <Border Height="1"
                                Background="#353B45"
                                Margin="0,8" />

                        <TextBlock Text="АКТИВНЫЙ РЕДАКТОР"
                                   FontSize="11"
                                   Foreground="#8291A4" />

                        <TextBlock x:Name="CurrentModeText"
                                   Text="Level editor / Terrain"
                                   FontSize="13"
                                   Foreground="#80BFFF" />

                        <Border Height="1"
                                Background="#353B45"
                                Margin="0,8" />

                        <TextBlock Text="КАМЕРА"
                                   FontSize="12"
                                   FontWeight="Bold" />

                        <TextBlock Text="Позиция"
                                   FontSize="11"
                                   Foreground="#8793A4" />

                        <TextBlock x:Name="PositionText"
                                   Text="X: 0.00  Y: 4.00  Z: -12.00"
                                   FontFamily="Consolas"
                                   FontSize="12" />

                        <TextBlock Text="Поворот"
                                   FontSize="11"
                                   Foreground="#8793A4" />

                        <TextBlock x:Name="RotationText"
                                   Text="Yaw: 0.0  Pitch: -10.3"
                                   FontFamily="Consolas"
                                   FontSize="12" />

                        <TextBlock Text="Скорость"
                                   FontSize="11"
                                   Foreground="#8793A4" />

                        <TextBlock x:Name="SpeedText"
                                   Text="8.0 м/с"
                                   FontFamily="Consolas"
                                   FontSize="12" />

                        <Border Height="1"
                                Background="#353B45"
                                Margin="0,8" />

                        <TextBlock Text="НАВИГАЦИЯ"
                                   FontSize="12"
                                   FontWeight="Bold" />

                        <StackPanel x:Name="FreeNavigationHints" Spacing="14">
                        <TextBlock Text="W / A / S / D — движение"
                                   FontSize="12"
                                   Foreground="#9DA8B7" />

                        <TextBlock Text="Space — подняться"
                                   FontSize="12"
                                   Foreground="#9DA8B7" />

                        <TextBlock Text="Shift — опуститься"
                                   FontSize="12"
                                   Foreground="#9DA8B7" />

                        <TextBlock Text="ПКМ + мышь — обзор"
                                   FontSize="12"
                                   Foreground="#9DA8B7" />

                        <TextBlock Text="Колёсико — скорость"
                                   FontSize="12"
                                   Foreground="#9DA8B7" />

                        <TextBlock Text="ЛКМ — фокус на сцене"
                                   FontSize="12"
                                   Foreground="#9DA8B7" />
                        </StackPanel>
                        <StackPanel x:Name="PlayNavigationHints" Spacing="14" IsVisible="False">
                            <TextBlock Text="W / A / S / D — бег" FontSize="12" Foreground="#9DA8B7" />
                            <TextBlock Text="Alt — ходьба · Shift — спринт" FontSize="12" Foreground="#9DA8B7" TextWrapping="Wrap" />
                            <TextBlock Text="Ctrl — присесть · C — переключить присед" FontSize="12" Foreground="#9DA8B7" TextWrapping="Wrap" />
                            <TextBlock Text="Space — прыжок" FontSize="12" Foreground="#9DA8B7" />
                            <TextBlock Text="ПКМ + мышь — вокруг персонажа" FontSize="12" Foreground="#9DA8B7" TextWrapping="Wrap" />
                            <TextBlock Text="Колёсико — дистанция камеры" FontSize="12" Foreground="#9DA8B7" TextWrapping="Wrap" />
                            <TextBlock Text="Esc / Stop — вернуться в редактор" FontSize="12" Foreground="#9DA8B7" TextWrapping="Wrap" />
                            <TextBlock x:Name="AnimStateInfo" FontSize="11" Foreground="#B9D9F7" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Background="#363C45"
                          Width="5"
                          ResizeDirection="Columns" />

            <!-- Center: renderer -->
            <Border Grid.Column="2" Background="#111820">
                <Grid RowDefinitions="38,*">

                    <Border Grid.Row="0"
                            Background="#262B33"
                            BorderBrush="#383E48"
                            BorderThickness="0,0,0,1">

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                              Margin="14,0">

                            <TextBlock Text="VIEWPORT"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="#B9D9F7" />

                            <Button Grid.Column="1" x:Name="PlayButton" Content="▶ Play"
                                    Margin="16,3,12,3" Padding="14,2" IsEnabled="False"
                                    Background="#276445" Foreground="White" Click="Play_Click" />
                            <TextBlock Grid.Column="2" x:Name="PlayHint"
                                       Text="Персонаж появится на Terrain под камерой"
                                       FontSize="11" Foreground="#9DA8B7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="DirectX 11  |  Perspective"
                                       FontSize="11"
                                       Foreground="#8593A6"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <viewport:DxViewportHost
                        x:Name="Viewport"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Background="#363C45"
                          Width="5"
                          ResizeDirection="Columns" />

            <!-- Right: editing -->
            <Border Grid.Column="4"
                    Background="#202329"
                    BorderBrush="#353A44"
                    BorderThickness="1,0,0,0">

                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="16">

                        <TextBlock Text="РЕДАКТИРОВАНИЕ"
                                   FontSize="12"
                                   FontWeight="Bold" />

                        <Border Height="1" Background="#353B45" />

                        <TextBlock x:Name="ModeTitle"
                                   Text="Terrain"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#83C4FA" />

                        <TextBlock x:Name="ModeDetails"
                                   Text="Редактор игрового ландшафта."
                                   FontSize="12"
                                   Foreground="#9BA6B5"
                                   TextWrapping="Wrap" />

                        <roads:RoadEditorPanel
                          x:Name="RoadPanel"
                          IsVisible="False" />

                        <Border Height="1"
                                Background="#353B45"
                                Margin="0,8" />

                        <TextBlock Text="НАСТРОЙКИ VIEWPORT"
                                   FontSize="12"
                                   FontWeight="Bold" />

                        <CheckBox x:Name="GridCheck"
                                  Content="Отображать сетку"
                                  IsChecked="True" />

                        <TextBlock Text="Скорость камеры"
                                   FontSize="12"
                                   Foreground="#A8B3C2" />

                        <Slider x:Name="CameraSpeedSlider"
                                Value="8"
                                TickFrequency="1" />

                        <TextBlock Text="1 — 5 000 м/с"
                                   FontSize="11"
                                   Foreground="#7C899A" />

                        <StackPanel x:Name="TerrainMaterialsPanel"
                                    Spacing="14"
                                    IsVisible="False">
                            <Border Height="1"
                                    Background="#353B45"
                                    Margin="0,8" />

                            <TextBlock Text="ТЕКСТУРЫ ПОВЕРХНОСТИ"
                                       FontSize="12"
                                       FontWeight="Bold" />

                            <TextBlock x:Name="TerrainLevelInfo"
                                       Text="Terrain не открыт"
                                       FontSize="12"
                                       Foreground="#9BA6B5" />

                            <TextBlock Text="СЛОИ TERRAIN"
                                       FontSize="12"
                                       FontWeight="Bold" />

                            <ListBox x:Name="TerrainLayersList"
                                     MaxHeight="280"
                                     Background="Transparent" />
                        </StackPanel>

                        <TextBlock Text="Инструменты выбранного раздела будут расположены здесь."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#8290A1" />

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="#1D2128"
                BorderBrush="#363B45"
                BorderThickness="0,1,0,0">

            <Grid ColumnDefinitions="*,Auto" Margin="14,0">

                <TextBlock x:Name="StatusText"
                           Text="Редактор готов"
                           FontSize="11"
                           Foreground="#A5B3C3"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="DX11  |  .NET 10"
                           FontSize="11"
                           Foreground="#7EAED3"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
