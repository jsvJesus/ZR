<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="EditorBackground">#15171C</SolidColorBrush>
    <SolidColorBrush x:Key="EditorSurface">#1D2027</SolidColorBrush>
    <SolidColorBrush x:Key="EditorRaised">#262B34</SolidColorBrush>
    <SolidColorBrush x:Key="EditorBorder">#323844</SolidColorBrush>
    <SolidColorBrush x:Key="EditorText">#DEE5EF</SolidColorBrush>
    <SolidColorBrush x:Key="EditorMuted">#95A2B6</SolidColorBrush>
    <SolidColorBrush x:Key="EditorAccent">#82B5FF</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Window.editor">
    <Setter Property="Background" Value="{DynamicResource EditorBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Window.editor Button">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Window.editor Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EditorMuted}" />
  </Style>
  <Style Selector="Window.editor Button.nav.selected">
    <Setter Property="Background" Value="#243851" />
    <Setter Property="BorderBrush" Value="#3E608B" />
    <Setter Property="Foreground" Value="#C3DDFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window.editor Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Window.editor Button.primary">
    <Setter Property="Background" Value="#2C527D" />
    <Setter Property="Foreground" Value="#F0F6FF" />
  </Style>
  <Style Selector="Window.editor Button.toolbar.selected">
    <Setter Property="Foreground" Value="{DynamicResource EditorAccent}" />
    <Setter Property="Background" Value="#243851" />
  </Style>
  <Style Selector="Window.editor TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource EditorMuted}" />
  </Style>
  <Style Selector="Window.editor TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource EditorMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Window.editor TextBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Window.editor ComboBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Window.editor ListBox">
    <Setter Property="Background" Value="{DynamicResource EditorBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Window.editor ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Window.editor Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Window.editor GridSplitter">
    <Setter Property="Background" Value="{DynamicResource EditorBackground}" />
  </Style>
  <Style Selector="Window.editor GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource EditorAccent}" />
  </Style>
</Styles>
